        | UR_RHS_END := UQ_END[UR_ES]
        | UR_RHS_NEXT := integer(RAW_TOKEN_CODE[(if (UR_INDEX + 2) >= 0 then (UR_INDEX + 2) else 0)])
        | UR_BRACE_CLOSE := if UR_RHS_NEXT = C_OPEN_BRACE then U_CLOSE_OF[UR_INDEX + 2] - 1 else -1
        | UR_CALL_PAREN := if UR_RHS_NEXT = C_OPEN then UR_INDEX + 2
                         else if UR_BRACE_CLOSE >= 0 and integer(RAW_TOKEN_CODE[(if (UR_BRACE_CLOSE + 1) >= 0 then (UR_BRACE_CLOSE + 1) else 0)]) = C_OPEN then UR_BRACE_CLOSE + 1 else -1
        | UR_WHOLE := UR_AT_DEFINE and integer(RAW_TOKEN_CODE[(if (UR_RHS) >= 0 then (UR_RHS) else 0)]) = C_NAME and UR_CALL_PAREN >= 0
                    and U_CLOSE_OF[if UR_CALL_PAREN >= 0 then UR_CALL_PAREN else 0] - 1 = UR_RHS_END
        | UR_KIND := if not UR_VALID[?] or not UR_TUPLE[?] and (not UR_LIST[?] or UR_WHOLE) then 0
                   else if UR_TUPLE[?] and UR_WHOLE then 1 else 2
        | UQ_KIND := UQ_KIND[?] next (if UR_AT_DEFINE then UR_E else -1) : UR_KIND
        | UQ_LEAVES := UQ_LEAVES[?] next (if UR_AT_DEFINE then UR_E else -1) : UR_LEAVES[?]
        | UQ_ITEMS := UQ_ITEMS[?] next (if UR_AT_DEFINE then UR_E else -1) : UR_ITEMS[?]
        | UQ_LIST := UQ_LIST[?] next (if UR_AT_DEFINE then UR_E else -1) : UR_LIST[?]
        | U_WHOLE_CALL := U_WHOLE_CALL[?] next (if UR_WHOLE then UR_CALL_PAREN else -1) : true
        | UR_ESTIMATE := UR_ESTIMATE[?] + (if UR_AT_DEFINE and UR_KIND = 2
                                    then long(UR_LEAVES[?]) * (long(UR_RHS_END - UR_INDEX + 2) * long(4 * UK_MAXLEAF + 6) + long(8))
                                    else if UR_AT_DEFINE and UR_KIND = 1 then long(2 * UR_LEAVES[?] + 4) else long(0))
        | UR_CALLEE := if UR_C /= C_OPEN then -1 else if UR_PC = C_NAME then RAW_TOKEN_NAME[(if (UR_INDEX - 1) >= 0 then (UR_INDEX - 1) else 0)] - 1
                     else if UR_PC = C_CLOSE_BRACE and U_OPEN_OF[(if UR_INDEX - 1 >= 0 then UR_INDEX - 1 else 0)] >= 2
                             and integer(RAW_TOKEN_CODE[(if (U_OPEN_OF[(if UR_INDEX - 1 >= 0 then UR_INDEX - 1 else 0)] - 2) >= 0 then (U_OPEN_OF[(if UR_INDEX - 1 >= 0 then UR_INDEX - 1 else 0)] - 2) else 0)]) = C_NAME then RAW_TOKEN_NAME[(if (U_OPEN_OF[(if UR_INDEX - 1 >= 0 then UR_INDEX - 1 else 0)] - 2) >= 0 then (U_OPEN_OF[(if UR_INDEX - 1 >= 0 then UR_INDEX - 1 else 0)] - 2) else 0)] - 1
                     else -1
        | U_CALLEE := U_CALLEE[?] next (if UR_CALLEE >= 0 then UR_INDEX else -1) : UR_CALLEE + 1
        | UR_TV := UR_C = C_OPEN and UR_CALLEE < 0 and U_COMMAS[UR_INDEX] > 0 and UR_PC /= C_INTEGER and UR_PC /= C_BOOLEAN
                 and UR_PC /= C_SHORT and UR_PC /= C_LONG and UR_PC /= C_EVENT and UR_PC /= C_ENUM
                 and UR_COMPONENTS[?] + U_COMMAS[UR_INDEX] + 2 < U_TLEAF_CAP
        | U_TV := U_TV[?] next (if UR_TV then UR_INDEX else -1) : true
        | U_TV_BASE := U_TV_BASE[?] next (if UR_TV then UR_INDEX else -1) : UR_COMPONENTS[?] + 1
        | UR_COMPONENTS := UR_COMPONENTS[?] + (if UR_TV then U_COMMAS[UR_INDEX] + 2 else 0)
        | UR_OWNER := if UR_C = C_COMMA then U_ENCLOSING[UR_INDEX] - 1 else if UR_C = C_CLOSE then U_OPEN_OF[UR_INDEX] - 1 else -1
        | UR_OWNER_TV := UR_OWNER >= 0 and U_TV[if UR_OWNER >= 0 then UR_OWNER else 0]
        | UR_OWNER_BASE := U_TV_BASE[if UR_OWNER >= 0 then UR_OWNER else 0] - 1
        | U_COMPONENT_AT := U_COMPONENT_AT[?] next (if UR_TV then UR_COMPONENTS[?]
                                                 else if UR_OWNER_TV and UR_C = C_COMMA then UR_OWNER_BASE + U_COMMA_ORD[UR_INDEX] + 1
                                                 else if UR_OWNER_TV then UR_OWNER_BASE + U_COMMAS[(if UR_OWNER >= 0 then UR_OWNER else 0)] + 1 else -1)
                          : UR_INDEX + 2
        | UR_FOUND_MESSAGE := if UR_BAD0 then T_NOT_TUPLE else if UR_NOT_TUPLE0 then T_NOT_TUPLE else if UR_NOT_TUPLE1 then T_NOT_TUPLE else if UR_NOT_TUPLE2 then T_NOT_TUPLE else if UR_NOT_TUPLE3 then T_NOT_TUPLE else if UR_NOT_TUPLE4 then T_NOT_TUPLE else if UR_UNKNOWN0 then T_FIELD_UNKNOWN else if UR_UNKNOWN1 then T_FIELD_UNKNOWN else if UR_UNKNOWN2 then T_FIELD_UNKNOWN else if UR_UNKNOWN3 then T_FIELD_UNKNOWN else if UR_UNKNOWN4 then T_FIELD_UNKNOWN else if UR_IN_TARGET and UR_HEAD and not UR_INSIDE and UI_COUNT_ALL[?] >= U_TLEAF_CAP then T_CAPACITY else 0
        | UR_FOUND_ARGUMENT0 := if UR_BAD0 then UR_N else if UR_NOT_TUPLE0 then UR_PREV0 else if UR_NOT_TUPLE1 then UR_PREV1 else if UR_NOT_TUPLE2 then UR_PREV2 else if UR_NOT_TUPLE3 then UR_PREV3 else if UR_NOT_TUPLE4 then UR_PREV4 else if UR_UNKNOWN0 then UR_PREV0 else if UR_UNKNOWN1 then UR_PREV1 else if UR_UNKNOWN2 then UR_PREV2 else if UR_UNKNOWN3 then UR_PREV3 else if UR_UNKNOWN4 then UR_PREV4 else if UR_IN_TARGET and UR_HEAD and not UR_INSIDE and UI_COUNT_ALL[?] >= U_TLEAF_CAP then F_CAP_TUPLES else 0
        | UR_FOUND_ARGUMENT1 := if UR_BAD0 then UR_FN0 else if UR_NOT_TUPLE0 then UR_FN0 else if UR_NOT_TUPLE1 then UR_FN1 else if UR_NOT_TUPLE2 then UR_FN2 else if UR_NOT_TUPLE3 then UR_FN3 else if UR_NOT_TUPLE4 then UR_FN4 else if UR_UNKNOWN0 then UR_FN0 else if UR_UNKNOWN1 then UR_FN1 else if UR_UNKNOWN2 then UR_FN2 else if UR_UNKNOWN3 then UR_FN3 else if UR_UNKNOWN4 then UR_FN4 else if UR_IN_TARGET and UR_HEAD and not UR_INSIDE and UI_COUNT_ALL[?] >= U_TLEAF_CAP then 0 else 0
        | UR_FOUND_ARGUMENT2 := if UR_BAD0 then 0 else if UR_NOT_TUPLE0 then 0 else if UR_NOT_TUPLE1 then 0 else if UR_NOT_TUPLE2 then 0 else if UR_NOT_TUPLE3 then 0 else if UR_NOT_TUPLE4 then 0 else if UR_UNKNOWN0 then 0 else if UR_UNKNOWN1 then 0 else if UR_UNKNOWN2 then 0 else if UR_UNKNOWN3 then 0 else if UR_UNKNOWN4 then 0 else if UR_IN_TARGET and UR_HEAD and not UR_INSIDE and UI_COUNT_ALL[?] >= U_TLEAF_CAP then 0 else 0
        | UR_FIRST_ERROR := UR_MESSAGE[?] = 0 and UR_FOUND_MESSAGE /= 0
        | UR_MESSAGE := if UR_FIRST_ERROR then UR_FOUND_MESSAGE else UR_MESSAGE[?]
        | UR_TOKEN := if UR_FIRST_ERROR then UR_INDEX else UR_TOKEN[?]
        | UR_ARGUMENT0 := if UR_FIRST_ERROR then UR_FOUND_ARGUMENT0 else UR_ARGUMENT0[?]
        | UR_ARGUMENT1 := if UR_FIRST_ERROR then UR_FOUND_ARGUMENT1 else UR_ARGUMENT1[?]
        | UR_ARGUMENT2 := if UR_FIRST_ERROR then UR_FOUND_ARGUMENT2 else UR_ARGUMENT2[?]
        |)
     with (| UR_ACC_E := -1 | UR_SKIP := -1 | UR_LIST := false | UR_VALID := false | UR_ITEMS := 0 | UR_LEAVES := 0
           | UR_TUPLE := false | UR_TLEAF := 0 | UI_COUNT_ALL := 0 | UR_ESTIMATE := long(0) | UR_COMPONENTS := 0
           | UR_MESSAGE := 0 | UR_TOKEN := 0 | UR_ARGUMENT0 := 0 | UR_ARGUMENT1 := 0 | UR_ARGUMENT2 := 0 |)
     end
   | UR_OK := UK_OK and UR_MESSAGE = 0
   | UF_INDEX := 0 .. (if UR_OK then UD_COUNT - 1 else -1)
   | iterate UF_INDEX of
       (| UF_TYPE := UD_TYPE_OF[UF_INDEX]
        | UF_AT := UF_AT[?] next UY_FIELD_BASE[UF_TYPE] + UD_ORD[UF_INDEX] : UF_INDEX
        | UF_NESTED := UD_NESTED[UF_INDEX]
        | UF_STRUCT_GROUP := not UY_KIND[UF_TYPE] and UD_ORD[UF_INDEX] = 0 and UY_LEAF_COUNT[UF_TYPE] >= 2
        | UF_FIELD_GROUP := UY_KIND[UF_TYPE] and UF_NESTED >= 0 and UY_LEAF_COUNT[if UF_NESTED >= 0 then UF_NESTED else 0] >= 2
        | UF_GROUPS := UF_STRUCT_GROUP or UF_FIELD_GROUP
        | UF_GROUP_NEW := UA_COUNT[?]
        | UA_COUNT := UA_COUNT[?] + integer(UF_GROUPS)
        | UF_GROUP_SLOT := if UF_GROUPS then UF_GROUP_NEW else -1
        | UA_LEAF := UA_LEAF[?] next UF_GROUP_SLOT : (if UF_STRUCT_GROUP then 0 else UD_LEAF_OFFSET[UF_INDEX])
        | UA_LEAVES := UA_LEAVES[?] next UF_GROUP_SLOT
                     : (if UF_STRUCT_GROUP then UY_LEAF_COUNT[UF_TYPE] else UY_LEAF_COUNT[if UF_NESTED >= 0 then UF_NESTED else 0])
        | UF_LAST := UY_GROUP_LAST[?][UF_TYPE] - 1
        | UA_NEXT := UA_NEXT[?] next (if UF_GROUPS and UF_LAST >= 0 then UF_LAST else -1) : UF_GROUP_NEW + 1
        | UY_GROUP_FIRST := UY_GROUP_FIRST[?] next (if UF_GROUPS and UF_LAST < 0 then UF_TYPE else -1) : UF_GROUP_NEW + 1
        | UY_GROUP_LAST := UY_GROUP_LAST[?] next (if UF_GROUPS then UF_TYPE else -1) : UF_GROUP_NEW + 1
        |)
     with UA_COUNT := 0
     end
   | UL_INDEX := 0 .. (if UR_OK then UP_LEAF_SLOTS - 1 else -1)
   | iterate UL_INDEX of
       (| UL_CTYPE := UY_CLOSE_ORDER[UL_C[?]]
        | UL_C := if UL_INDEX >= UY_LEAF_BASE[UL_CTYPE] + UY_LEAF_COUNT[UL_CTYPE] then UL_C[?] + 1 else UL_C[?]
        | UL_TYPE := UY_CLOSE_ORDER[UL_C]
        | UL_K := UL_INDEX - UY_LEAF_BASE[UL_TYPE]
        | UL_JF := UF_AT[UY_FIELD_BASE[UL_TYPE] + UL_J[?]]
        | UL_JNEST := UD_NESTED[UL_JF]
        | UL_JEND := UD_LEAF_OFFSET[UL_JF] + (if UL_JNEST >= 0 then UY_LEAF_COUNT[UL_JNEST] else 1)
        | UL_J := if UL_K = 0 then 0 else if UL_K >= UL_JEND then UL_J[?] + 1 else UL_J[?]
        | UL_F := UF_AT[UY_FIELD_BASE[UL_TYPE] + UL_J]
        | UL_FIELD := UL_FIELD[?] next UL_INDEX : UL_F
        | UL_SUB := UL_SUB[?] next UL_INDEX : UL_K - UD_LEAF_OFFSET[UL_F]
        |)
     with (| UL_C := 0 | UL_J := 0 |)
     end
   | UG_INDEX := 0 .. (if UR_OK then 5 * UR_TLEAF - 1 else -1)
   | iterate UG_INDEX of
       (| UG_G := UG_INDEX / 5
        | UG_LEVEL := UG_INDEX modulo 5
        | UG_CI := UI_SLOT[UG_C[?]] + UI_COUNT[UG_C[?]]
        | UG_C := if UG_LEVEL = 0 and UG_G >= UG_CI then UG_C[?] + 1 else UG_C[?]
        | UG_HEAD := UI_HEAD[UG_C]
        | UG_E := UI_EQ[UG_C]
        | UG_J0 := UG_G - UI_SLOT[UG_C]
        | UG_SIG := U_NODE_SIG[UG_HEAD] - 1
        | UG_NODE_T := U_NODE_TYPE[UG_HEAD] - 1
        | UG_LIST := UQ_LIST[UG_E]
        | UG_START := UG_LEVEL = 0
        | UG_FROM_T := if UG_START then UG_NODE_T else UG_T[?]
        | UG_FROM_J := if UG_START then UG_J0 else UG_J[?]
        | UG_TAKES_LIST := UG_START and UG_LIST
        | UG_D_ON := UG_FROM_T >= 0
        | UG_D_F := if UG_D_ON then UL_FIELD[UY_LEAF_BASE[(if (UG_FROM_T) >= 0 then (UG_FROM_T) else 0)] + UG_FROM_J] else 0
        | UG_D_COMP := if UG_D_ON then UD_ORD[UG_D_F] else -1
        | UG_D_COUNT := if UG_D_ON then UY_FIELD_COUNT[(if (UG_FROM_T) >= 0 then (UG_FROM_T) else 0)] else 0
        | UG_D_NT := if UG_D_ON then UD_NESTED[UG_D_F] else -1
        | UG_D_NJ := if UG_D_ON then UL_SUB[UY_LEAF_BASE[(if (UG_FROM_T) >= 0 then (UG_FROM_T) else 0)] + UG_FROM_J] else 0
        | UG_COMP_HERE := if UG_TAKES_LIST then UI_ORD[UG_C] else UG_D_COMP
        | UG_COUNT_HERE := if UG_TAKES_LIST then UQ_ITEMS[UG_E] else UG_D_COUNT
        | UG_T := if UG_TAKES_LIST then UG_FROM_T else UG_D_NT
        | UG_J := if UG_TAKES_LIST then UG_FROM_J else UG_D_NJ
        | UG_COMP := UG_COMP[?] next UG_INDEX : UG_COMP_HERE
        | UG_COUNT := UG_COUNT[?] next UG_INDEX : UG_COUNT_HERE
        | UG_LENGTH_RUN := (if UG_START then 0 else UG_LENGTH_RUN[?]) + integer(UG_COMP_HERE >= 0)
        | UG_LENGTH := UG_LENGTH[?] next (if UG_LEVEL = 4 then UG_G else -1) : UG_LENGTH_RUN
        | UG_NAME := UG_NAME[?] next (if UG_START then UG_G else -1)
                   : (if UG_SIG >= 0 then NAME_COUNT + US_HIDDEN_BASE[UG_SIG] + U_NODE_FIRST[UG_HEAD] + UG_J0 else RAW_TOKEN_NAME[UG_HEAD] - 1)
        | UG_ORIGIN := UG_ORIGIN[?] next (if UG_START then UG_G else -1) : UG_HEAD
        |)
     with (| UG_C := 0 | UG_T := -1 | UG_J := 0 | UG_LENGTH_RUN := 0 |)
     end
   | UH_INDEX := 0 .. (if UR_OK then UK_HIDDEN - 1 else -1)
   | iterate UH_INDEX of
       (| UH_SP := UK_TUPLE_SIG[UH_S[?]]
        | UH_SI := US_HIDDEN_BASE[UH_SP] + UY_LEAF_COUNT[US_TYPE[UH_SP]]
        | UH_SIG := UK_TUPLE_SIG[UH_S]
        | UH_S := if UH_INDEX >= UH_SI then UH_S[?] + 1 else UH_S[?]
        | UH_K := UH_INDEX - US_HIDDEN_BASE[UH_SIG]
        | UH_T0 := US_TYPE[UH_SIG]
        | UH_J0 := UH_K
        | UH_ON0 := UH_T0 >= 0
        | UH_F0 := if UH_ON0 then UL_FIELD[UY_LEAF_BASE[(if (UH_T0) >= 0 then (UH_T0) else 0)] + UH_J0] else -1
        | UH_T1 := if UH_ON0 then UD_NESTED[(if (UH_F0) >= 0 then (UH_F0) else 0)] else -1
        | UH_J1 := if UH_ON0 then UL_SUB[UY_LEAF_BASE[(if (UH_T0) >= 0 then (UH_T0) else 0)] + UH_J0] else 0
        | UH_LENGTH0 := if UH_ON0 then 1 + NAME_LENGTH[UD_NAME[(if (UH_F0) >= 0 then (UH_F0) else 0)]] else 0
        | UH_ON1 := UH_T1 >= 0
        | UH_F1 := if UH_ON1 then UL_FIELD[UY_LEAF_BASE[(if (UH_T1) >= 0 then (UH_T1) else 0)] + UH_J1] else -1
        | UH_T2 := if UH_ON1 then UD_NESTED[(if (UH_F1) >= 0 then (UH_F1) else 0)] else -1
        | UH_J2 := if UH_ON1 then UL_SUB[UY_LEAF_BASE[(if (UH_T1) >= 0 then (UH_T1) else 0)] + UH_J1] else 0
        | UH_LENGTH1 := if UH_ON1 then 1 + NAME_LENGTH[UD_NAME[(if (UH_F1) >= 0 then (UH_F1) else 0)]] else 0
        | UH_ON2 := UH_T2 >= 0
        | UH_F2 := if UH_ON2 then UL_FIELD[UY_LEAF_BASE[(if (UH_T2) >= 0 then (UH_T2) else 0)] + UH_J2] else -1
        | UH_T3 := if UH_ON2 then UD_NESTED[(if (UH_F2) >= 0 then (UH_F2) else 0)] else -1
        | UH_J3 := if UH_ON2 then UL_SUB[UY_LEAF_BASE[(if (UH_T2) >= 0 then (UH_T2) else 0)] + UH_J2] else 0
        | UH_LENGTH2 := if UH_ON2 then 1 + NAME_LENGTH[UD_NAME[(if (UH_F2) >= 0 then (UH_F2) else 0)]] else 0
        | UH_ON3 := UH_T3 >= 0
        | UH_F3 := if UH_ON3 then UL_FIELD[UY_LEAF_BASE[(if (UH_T3) >= 0 then (UH_T3) else 0)] + UH_J3] else -1
        | UH_T4 := if UH_ON3 then UD_NESTED[(if (UH_F3) >= 0 then (UH_F3) else 0)] else -1
        | UH_J4 := if UH_ON3 then UL_SUB[UY_LEAF_BASE[(if (UH_T3) >= 0 then (UH_T3) else 0)] + UH_J3] else 0
        | UH_LENGTH3 := if UH_ON3 then 1 + NAME_LENGTH[UD_NAME[(if (UH_F3) >= 0 then (UH_F3) else 0)]] else 0
        | UH_BASE_LENGTH := NAME_LENGTH[US_NAME[UH_SIG]]
        | UH_TOTAL_HERE := UH_BASE_LENGTH + UH_LENGTH0 + UH_LENGTH1 + UH_LENGTH2 + UH_LENGTH3
        | UH_AT := UH_AT[?] next UH_INDEX : UH_TOTAL[?]
        | UH_LENGTH := UH_LENGTH[?] next UH_INDEX : UH_TOTAL_HERE
        | UH_TOTAL := UH_TOTAL[?] + UH_TOTAL_HERE
        | UH_NAME0 := UH_NAME0[?] next UH_INDEX : US_NAME[UH_SIG]
        | UH_NAME1 := UH_NAME1[?] next UH_INDEX : (if UH_ON0 then UD_NAME[(if (UH_F0) >= 0 then (UH_F0) else 0)] else -1)
        | UH_NAME2 := UH_NAME2[?] next UH_INDEX : (if UH_ON1 then UD_NAME[(if (UH_F1) >= 0 then (UH_F1) else 0)] else -1)
        | UH_NAME3 := UH_NAME3[?] next UH_INDEX : (if UH_ON2 then UD_NAME[(if (UH_F2) >= 0 then (UH_F2) else 0)] else -1)
        | UH_NAME4 := UH_NAME4[?] next UH_INDEX : (if UH_ON3 then UD_NAME[(if (UH_F3) >= 0 then (UH_F3) else 0)] else -1)
        |)
     with (| UH_S := 0 | UH_TOTAL := 0 |)
     end
   | UX_INDEX := 0 .. (if UR_OK and UH_TOTAL <= U_TEXT_CAP then UH_TOTAL - 1 else -1)
   | iterate UX_INDEX of
       (| UX_H := if UX_INDEX >= UH_AT[UX_H[?]] + UH_LENGTH[UX_H[?]] then UX_H[?] + 1 else UX_H[?]
        | UX_O := UX_INDEX - UH_AT[UX_H]
        | UX_B0 := NAME_LENGTH[UH_NAME0[UX_H]]
        | UX_B1 := UX_B0 + (if UH_NAME1[UX_H] >= 0 then 1 + NAME_LENGTH[(if (UH_NAME1[UX_H]) >= 0 then (UH_NAME1[UX_H]) else 0)] else 0)
        | UX_B2 := UX_B1 + (if UH_NAME2[UX_H] >= 0 then 1 + NAME_LENGTH[(if (UH_NAME2[UX_H]) >= 0 then (UH_NAME2[UX_H]) else 0)] else 0)
        | UX_B3 := UX_B2 + (if UH_NAME3[UX_H] >= 0 then 1 + NAME_LENGTH[(if (UH_NAME3[UX_H]) >= 0 then (UH_NAME3[UX_H]) else 0)] else 0)
        | UX_B4 := UX_B3 + (if UH_NAME4[UX_H] >= 0 then 1 + NAME_LENGTH[(if (UH_NAME4[UX_H]) >= 0 then (UH_NAME4[UX_H]) else 0)] else 0)
        | UX_AT := if UX_O < UX_B0 then NAME_AT[UH_NAME0[UX_H]] + UX_O
                   else if UX_O = UX_B0 then -1 else if UX_O < UX_B1 then NAME_AT[(if (UH_NAME1[UX_H]) >= 0 then (UH_NAME1[UX_H]) else 0)] + UX_O - UX_B0 - 1
                   else if UX_O = UX_B1 then -1 else if UX_O < UX_B2 then NAME_AT[(if (UH_NAME2[UX_H]) >= 0 then (UH_NAME2[UX_H]) else 0)] + UX_O - UX_B1 - 1
                   else if UX_O = UX_B2 then -1 else if UX_O < UX_B3 then NAME_AT[(if (UH_NAME3[UX_H]) >= 0 then (UH_NAME3[UX_H]) else 0)] + UX_O - UX_B2 - 1
                   else if UX_O = UX_B3 then -1 else if UX_O < UX_B4 then NAME_AT[(if (UH_NAME4[UX_H]) >= 0 then (UH_NAME4[UX_H]) else 0)] + UX_O - UX_B3 - 1 else -1
        | U_HIDDEN_TEXT := U_HIDDEN_TEXT[?] next UX_INDEX
                         : (if UX_AT < 0 then ubyte(46) else if UX_AT < SEED_LENGTH then SEED[UX_AT] else SRC[(if UX_AT - SEED_LENGTH >= 0 then UX_AT - SEED_LENGTH else 0)])
        |)
     with UX_H := 0
     end
   | UE_LIMIT := if not U_SEEN then long(RAW_TOKEN_COUNT + 1)
                 else if not UR_OK or UH_TOTAL > U_TEXT_CAP then long(0)
                 else long(RAW_TOKEN_COUNT) * long(4 * UK_MAXLEAF + 8) + UK_ESTIMATE + UR_ESTIMATE + long(16)
   | UE_STEPS := if UE_LIMIT > long(U_EMIT_CAP) then U_EMIT_CAP else integer(UE_LIMIT)
   | UE_INDEX := 0 .. (if CONVERTED then UE_STEPS - 1 else -1)
   | iterate UE_INDEX of
       (| UE_MODE0 := UE_MODE[?]
        | UE_R := UE_POS[?]
        | UE_RS := if UE_R < RAW_TOKEN_COUNT then UE_R else 0
        | UE_C := integer(RAW_TOKEN_CODE[(if (UE_RS) >= 0 then (UE_RS) else 0)])
        | UE_PC := if UE_RS > 0 then integer(RAW_TOKEN_CODE[(if (UE_RS - 1) >= 0 then (UE_RS - 1) else 0)]) else 0
        | UE_EQ0 := UE_EQ[?] - 1
        | UE_ES := if UE_EQ0 >= 0 then UE_EQ0 else 0
        | UE_KIND := if UE_EQ0 >= 0 then UQ_KIND[UE_ES] else 0
        | UE_PROJ := UE_KIND = 2
        | UE_CF := UE_KIND = 1
        | UE_TOP := UE_EQ0 < 0
        | UE_LV := UE_LEVEL[?]
        | UE_PATH := UE_PATHLEN[?]
        | UE_TLS := UE_TL[?]
        | UE_WALKS := UE_MODE0 = 0
        | UE_W1 := UE_WALKS and UE_PROJ and UE_LV = 0 and UE_R > UQ_END[UE_ES]
        | UE_W1C := UE_WALKS and UE_CF and UE_R > UQ_END[UE_ES]
        | UE_LVS := if UE_LV > 0 then UE_LV - 1 else 0
        | UE_W2 := UE_WALKS and not UE_W1 and not UE_W1C and UE_LV > 0 and UE_R = UE_CEND[?][UE_LVS]
        | UE_W3 := UE_WALKS and not UE_W1 and not UE_W1C and not UE_W2 and UE_R = UE_JUMP_FROM[?]
        | UE_PRE := UE_WALKS and not UE_W1 and not UE_W1C and not UE_W2 and not UE_W3
        | UE_CFC := UE_PRE and UE_R = UE_CF_CLOSE[?]
        | UE_PRE2 := UE_PRE and not UE_CFC
        | UE_DONE_NOW := UE_PRE2 and UE_R >= RAW_TOKEN_COUNT
        | UE_LIVE := UE_PRE2 and not UE_DONE_NOW
        | UE_W4 := UE_LIVE and UE_TOP and U_REMOVE_TO[UE_RS] > 0
        | UE_W5_DECL := U_DECL_AT[UE_RS] - 1
        | UE_W5 := UE_LIVE and UE_TOP and not UE_W4 and UE_W5_DECL >= 0 and UC_FINAL[(if UE_W5_DECL >= 0 then UE_W5_DECL else 0)] >= 0
        | UE_BODY_MODEL := U_BODY_CLOSE_MODEL[UE_RS]
        | UE_W6 := UE_LIVE and UE_TOP and not UE_W4 and not UE_W5 and UE_BODY_MODEL > 0 and UE_RDONE[?] /= UE_R
                 and UM_SIG_FIRST[UE_BODY_MODEL] > 0
        | UE_EQ_HERE := U_EQ_AT[UE_RS] - 1
        | UE_EQ_HERE_KIND := if UE_EQ_HERE >= 0 then UQ_KIND[(if UE_EQ_HERE >= 0 then UE_EQ_HERE else 0)] else 0
        | UE_W7 := UE_LIVE and UE_TOP and not UE_W4 and not UE_W5 and not UE_W6 and UE_EQ_HERE_KIND > 0
        | UE_W7_SINGLE := UE_W7 and UE_EQ_HERE_KIND = 1 and not UQ_LIST[(if UE_EQ_HERE >= 0 then UE_EQ_HERE else 0)]
        | UE_REST := UE_LIVE and not UE_W4 and not UE_W5 and not UE_W6 and not UE_W7
        | UE_SIG := U_NODE_SIG[UE_RS] - 1
        | UE_CHAIN := UE_REST and UE_SIG >= 0
        | UE_SIGS := if UE_SIG >= 0 then UE_SIG else 0
        | UE_NT := U_NODE_TYPE[UE_RS] - 1
        | UE_NTS := if UE_NT >= 0 then UE_NT else 0
        | UE_FIRST := U_NODE_FIRST[UE_RS]
        | UE_CEND_HERE := U_CHAIN_END[UE_RS]
        | UE_IDX := U_NODE_INDEX[UE_RS] - 1
        | UE_HNAME := RAW_TOKEN_NAME[(if (UE_RS) >= 0 then (UE_RS) else 0)] - 1
        | UE_HBASE := NAME_COUNT + US_HIDDEN_BASE[UE_SIGS] + UE_FIRST
        | UE_LEAFCOUNT := if UE_NT >= 0 then UY_LEAF_COUNT[UE_NTS] else 1
        | UE_AFTER := integer(RAW_TOKEN_CODE[(if (UE_CEND_HERE) >= 0 then (UE_CEND_HERE) else 0)])
        | UE_CLOCK_OP := UE_PC = C_CARET or UE_PC = C_CLOCK_EQUAL or UE_PC = C_CLOCK_SHARP or UE_PC = C_CLOCK_LT or UE_PC = C_CLOCK_GT
                       or UE_PC = C_CLOCK_PLUS or UE_PC = C_CLOCK_TIMES or UE_PC = C_CLOCK_MINUS
                       or UE_AFTER = C_CLOCK_EQUAL or UE_AFTER = C_CLOCK_SHARP or UE_AFTER = C_CLOCK_LT or UE_AFTER = C_CLOCK_GT
                       or UE_AFTER = C_CLOCK_PLUS or UE_AFTER = C_CLOCK_TIMES or UE_AFTER = C_CLOCK_MINUS
        | UE_ARG_OPEN := if UE_PC = C_OPEN then UE_RS - 1 else if UE_PC = C_COMMA then U_ENCLOSING[(if UE_RS - 1 >= 0 then UE_RS - 1 else 0)] - 1 else -1
        | UE_ARG_OS := if UE_ARG_OPEN >= 0 then UE_ARG_OPEN else 0
        | UE_ARG_CALLEE := if UE_ARG_OPEN >= 0 then U_CALLEE[UE_ARG_OS] - 1 else -1
        | UE_WHOLE_ARG := UE_ARG_CALLEE >= 0 and (UE_AFTER = C_COMMA and U_ENCLOSING[UE_CEND_HERE] - 1 = UE_ARG_OPEN
                                             or U_CLOSE_OF[UE_ARG_OS] - 1 = UE_CEND_HERE)
        | UE_ARG_EFFECT := UE_ARG_CALLEE >= N_LOAD and UE_ARG_CALLEE <= N_WRITE_STRING
        | UE_ARG_MODEL := UE_ARG_CALLEE >= 0 and U_MODEL_OF_NAME[if UE_ARG_CALLEE >= 0 then UE_ARG_CALLEE else 0] > 0
        | UE_B_HEAD := UE_CEND_HERE + 1
        | UE_B_SIG := U_NODE_SIG[UE_B_HEAD] - 1
        | UE_B_T := U_NODE_TYPE[UE_B_HEAD] - 1
        | UE_B_TUPLE := UE_B_SIG >= 0 and UE_B_T >= 0
        | UE_IDENT := UE_AFTER = C_IDENTITY
        | UE_EQX_OK := (UE_AFTER = C_EQUAL_EQUAL or UE_IDENT) and UE_B_TUPLE
        | UE_BUNDLE := UE_NT >= 0 and UY_KIND[UE_NTS]
        | UE_KIND_MIX := UE_B_TUPLE and UE_NT >= 0 and UY_KIND[UE_NTS] /= UY_KIND[if UE_B_T >= 0 then UE_B_T else 0]
                       and (UE_AFTER = C_EQUAL_EQUAL or UE_IDENT or UE_AFTER = C_LESS_LESS_EQUAL)
        | UE_SHAPE_CALL := (UE_ARG_CALLEE = N_SIZE or UE_ARG_CALLEE = N_DIM) and not UE_ARG_MODEL and UE_IDX < 0 and US_ARRAY[UE_SIGS]
        | UE_A := UE_CHAIN and UE_CF and UE_R < UQ_DEFINE[UE_ES]
        | UE_B := UE_CHAIN and not UE_A and UE_NT < 0
        | UE_C1 := UE_CHAIN and not UE_A and UE_NT >= 0 and UE_CLOCK_OP
        | UE_C2 := UE_CHAIN and not UE_A and UE_NT >= 0 and not UE_CLOCK_OP and UE_PROJ and UE_LV < UE_PATH
        | UE_C_REST := UE_CHAIN and not UE_A and UE_NT >= 0 and not UE_CLOCK_OP and not UE_C2
        | UE_C3 := UE_C_REST and UE_WHOLE_ARG
        | UE_C4 := UE_C_REST and not UE_C3 and UE_EQX_OK
        | UE_C5 := UE_C_REST and not UE_C3 and not UE_C4 and UE_AFTER = C_LESS_LESS_EQUAL
        | UE_C6 := UE_C_REST and not UE_C3 and not UE_C4 and not UE_C5
        | UE_PT0 := UE_NT
        | UE_POFF0 := 0
        | UE_PSHAPE0 := false
        | UE_PON0 := UE_C2 and UE_LV + 0 < UE_PATH and UE_PT0 >= 0 and not UE_PSHAPE0
        | UE_PQ0 := if UE_PON0 then UE_TLS * 5 + UE_LV + 0 else 0
        | UE_PCOMP0 := UG_COMP[UE_PQ0]
        | UE_PCOUNT0 := UG_COUNT[UE_PQ0]
        | UE_PTS0 := if UE_PT0 >= 0 then UE_PT0 else 0
        | UE_PNF0 := UY_FIELD_COUNT[UE_PTS0]
        | UE_PBAD0 := UE_PON0 and (UE_PNF0 /= UE_PCOUNT0 or UE_PCOMP0 < 0)
        | UE_PSHAPE1 := UE_PSHAPE0 or UE_PBAD0
        | UE_PF0 := if UE_PON0 and not UE_PBAD0 then UF_AT[(if (UY_FIELD_BASE[UE_PTS0] + UE_PCOMP0) >= 0 then (UY_FIELD_BASE[UE_PTS0] + UE_PCOMP0) else 0)] else 0
        | UE_PT1 := if UE_PON0 and not UE_PBAD0 then UD_NESTED[UE_PF0] else UE_PT0
        | UE_POFF1 := if UE_PON0 and not UE_PBAD0 then UE_POFF0 + UD_LEAF_OFFSET[UE_PF0] else UE_POFF0
        | UE_PON1 := UE_C2 and UE_LV + 1 < UE_PATH and UE_PT1 >= 0 and not UE_PSHAPE1
        | UE_PQ1 := if UE_PON1 then UE_TLS * 5 + UE_LV + 1 else 0
        | UE_PCOMP1 := UG_COMP[UE_PQ1]
        | UE_PCOUNT1 := UG_COUNT[UE_PQ1]
        | UE_PTS1 := if UE_PT1 >= 0 then UE_PT1 else 0
        | UE_PNF1 := UY_FIELD_COUNT[UE_PTS1]
        | UE_PBAD1 := UE_PON1 and (UE_PNF1 /= UE_PCOUNT1 or UE_PCOMP1 < 0)
        | UE_PSHAPE2 := UE_PSHAPE1 or UE_PBAD1
        | UE_PF1 := if UE_PON1 and not UE_PBAD1 then UF_AT[(if (UY_FIELD_BASE[UE_PTS1] + UE_PCOMP1) >= 0 then (UY_FIELD_BASE[UE_PTS1] + UE_PCOMP1) else 0)] else 0
        | UE_PT2 := if UE_PON1 and not UE_PBAD1 then UD_NESTED[UE_PF1] else UE_PT1
        | UE_POFF2 := if UE_PON1 and not UE_PBAD1 then UE_POFF1 + UD_LEAF_OFFSET[UE_PF1] else UE_POFF1
        | UE_PON2 := UE_C2 and UE_LV + 2 < UE_PATH and UE_PT2 >= 0 and not UE_PSHAPE2
        | UE_PQ2 := if UE_PON2 then UE_TLS * 5 + UE_LV + 2 else 0
        | UE_PCOMP2 := UG_COMP[UE_PQ2]
        | UE_PCOUNT2 := UG_COUNT[UE_PQ2]
        | UE_PTS2 := if UE_PT2 >= 0 then UE_PT2 else 0
        | UE_PNF2 := UY_FIELD_COUNT[UE_PTS2]
        | UE_PBAD2 := UE_PON2 and (UE_PNF2 /= UE_PCOUNT2 or UE_PCOMP2 < 0)
        | UE_PSHAPE3 := UE_PSHAPE2 or UE_PBAD2
        | UE_PF2 := if UE_PON2 and not UE_PBAD2 then UF_AT[(if (UY_FIELD_BASE[UE_PTS2] + UE_PCOMP2) >= 0 then (UY_FIELD_BASE[UE_PTS2] + UE_PCOMP2) else 0)] else 0
        | UE_PT3 := if UE_PON2 and not UE_PBAD2 then UD_NESTED[UE_PF2] else UE_PT2
        | UE_POFF3 := if UE_PON2 and not UE_PBAD2 then UE_POFF2 + UD_LEAF_OFFSET[UE_PF2] else UE_POFF2
        | UE_PON3 := UE_C2 and UE_LV + 3 < UE_PATH and UE_PT3 >= 0 and not UE_PSHAPE3
        | UE_PQ3 := if UE_PON3 then UE_TLS * 5 + UE_LV + 3 else 0
        | UE_PCOMP3 := UG_COMP[UE_PQ3]
        | UE_PCOUNT3 := UG_COUNT[UE_PQ3]
        | UE_PTS3 := if UE_PT3 >= 0 then UE_PT3 else 0
        | UE_PNF3 := UY_FIELD_COUNT[UE_PTS3]
        | UE_PBAD3 := UE_PON3 and (UE_PNF3 /= UE_PCOUNT3 or UE_PCOMP3 < 0)
        | UE_PSHAPE4 := UE_PSHAPE3 or UE_PBAD3
        | UE_PF3 := if UE_PON3 and not UE_PBAD3 then UF_AT[(if (UY_FIELD_BASE[UE_PTS3] + UE_PCOMP3) >= 0 then (UY_FIELD_BASE[UE_PTS3] + UE_PCOMP3) else 0)] else 0
        | UE_PT4 := if UE_PON3 and not UE_PBAD3 then UD_NESTED[UE_PF3] else UE_PT3
        | UE_POFF4 := if UE_PON3 and not UE_PBAD3 then UE_POFF3 + UD_LEAF_OFFSET[UE_PF3] else UE_POFF3
        | UE_PON4 := UE_C2 and UE_LV + 4 < UE_PATH and UE_PT4 >= 0 and not UE_PSHAPE4
        | UE_PQ4 := if UE_PON4 then UE_TLS * 5 + UE_LV + 4 else 0
        | UE_PCOMP4 := UG_COMP[UE_PQ4]
        | UE_PCOUNT4 := UG_COUNT[UE_PQ4]
        | UE_PTS4 := if UE_PT4 >= 0 then UE_PT4 else 0
        | UE_PNF4 := UY_FIELD_COUNT[UE_PTS4]
        | UE_PBAD4 := UE_PON4 and (UE_PNF4 /= UE_PCOUNT4 or UE_PCOMP4 < 0)
        | UE_PSHAPE5 := UE_PSHAPE4 or UE_PBAD4
        | UE_PF4 := if UE_PON4 and not UE_PBAD4 then UF_AT[(if (UY_FIELD_BASE[UE_PTS4] + UE_PCOMP4) >= 0 then (UY_FIELD_BASE[UE_PTS4] + UE_PCOMP4) else 0)] else 0
        | UE_PT5 := if UE_PON4 and not UE_PBAD4 then UD_NESTED[UE_PF4] else UE_PT4
        | UE_POFF5 := if UE_PON4 and not UE_PBAD4 then UE_POFF4 + UD_LEAF_OFFSET[UE_PF4] else UE_POFF4
        | UE_SHAPE_FOUND := if UE_PBAD0 then UE_PNF0 else if UE_PBAD1 then UE_PNF1 else if UE_PBAD2 then UE_PNF2 else if UE_PBAD3 then UE_PNF3 else if UE_PBAD4 then UE_PNF4 else 0
        | UE_SHAPE_WANT := if UE_PBAD0 then UE_PCOUNT0 else if UE_PBAD1 then UE_PCOUNT1 else if UE_PBAD2 then UE_PCOUNT2 else if UE_PBAD3 then UE_PCOUNT3 else if UE_PBAD4 then UE_PCOUNT4 else 0
        | UE_C2_STILL := UE_C2 and not UE_PSHAPE5 and UE_PT5 >= 0
        | UE_TV := UE_REST and not UE_CHAIN and UE_PROJ and UE_C = C_OPEN and U_TV[UE_RS]
        | UE_TV_SELECT := UE_TV and UE_LV < UE_PATH
        | UE_TQ := UE_TLS * 5 + (if UE_LV < 5 then UE_LV else 4)
        | UE_TV_COMP := UG_COMP[UE_TQ]
        | UE_TV_WANT := UG_COUNT[UE_TQ]
        | UE_TV_HAVE := U_COMMAS[UE_RS] + 1
        | UE_TV_BAD := UE_TV_SELECT and (UE_TV_HAVE /= UE_TV_WANT or UE_TV_COMP < 0)
        | UE_TV_GO := UE_TV_SELECT and not UE_TV_BAD
        | UE_TV_BASE := (if U_TV_BASE[UE_RS] - 1 + (if UE_TV_GO then UE_TV_COMP else 0) >= 0 then U_TV_BASE[UE_RS] - 1 + (if UE_TV_GO then UE_TV_COMP else 0) else 0)
        | UE_TV_START := U_COMPONENT_AT[UE_TV_BASE] - 1
        | UE_TV_END := U_COMPONENT_AT[UE_TV_BASE + 1] - 2
        | UE_TV_BARE := UE_PC = C_INIT
        | UE_CALLEE := if UE_REST and not UE_CHAIN and UE_C = C_OPEN then U_CALLEE[UE_RS] - 1 else -1
        | UE_CALLEE_MODEL := if UE_CALLEE >= 0 then U_MODEL_OF_NAME[(if UE_CALLEE >= 0 then UE_CALLEE else 0)] else 0
        | UE_TUPLE_CALL := UE_CALLEE_MODEL > 0 and UM_TUPLE_OUT[UE_CALLEE_MODEL] and not U_WHOLE_CALL[UE_RS]
        | UE_SPREAD := not UE_TUPLE_CALL and UE_PROJ and UE_LV < UE_PATH and UE_CALLEE >= 0
                     and (UE_CALLEE_MODEL > 0 or UE_CALLEE >= N_LOAD and UE_CALLEE <= N_WRITE_STRING)
        | UE_COPY := UE_REST and not UE_CHAIN and not UE_TV and not UE_TUPLE_CALL and not UE_SPREAD
        | UE_N1 := integer(RAW_TOKEN_CODE[(if (UE_RS + 1) >= 0 then (UE_RS + 1) else 0)])
        | UE_DELAY_INIT := UE_COPY and UE_PROJ and UE_LV < UE_PATH
                          and (UE_C = C_DOLLAR or UE_C = C_NAME and RAW_TOKEN_NAME[(if (UE_RS) >= 0 then (UE_RS) else 0)] - 1 = N_WINDOW) and integer(RAW_TOKEN_CODE[(if (UE_RS + 2) >= 0 then (UE_RS + 2) else 0)]) = C_INIT
                          and not (UE_C = C_DOLLAR and UE_N1 = C_NUMBER and RAW_TOKEN_VALUE[(if (UE_RS + 1) >= 0 then (UE_RS + 1) else 0)] = long(1))
        | UE_TV_AFTER := U_CLOSE_OF[UE_RS]
        | UE_TV_ARGUMENT := UE_COPY and UE_C = C_OPEN and U_TV[UE_RS] and UE_ARG_CALLEE >= 0
                           and (integer(RAW_TOKEN_CODE[(if (UE_TV_AFTER) >= 0 then (UE_TV_AFTER) else 0)]) = C_COMMA and U_ENCLOSING[UE_TV_AFTER] - 1 = UE_ARG_OPEN
                                or U_CLOSE_OF[UE_ARG_OS] - 1 = UE_TV_AFTER)
        | UE_FLAT_STARTS := UE_A or UE_C3 and UE_ARG_MODEL and UE_IDX < 0
        | UE_EQX_STARTS := UE_C4 and not UE_KIND_MIX and (UE_IDENT or not UE_BUNDLE) and UE_IDX < 0 and U_NODE_INDEX[UE_B_HEAD] = 0
                         and UY_LEAF_COUNT[UE_NTS] = UY_LEAF_COUNT[if UE_B_T >= 0 then UE_B_T else 0]
        | UE_ERROR_HERE := if UE_TUPLE_CALL then T_TUPLE_CALL
                         else if UE_TV_ARGUMENT then T_TUPLE_ARGUMENT
                         else if UE_DELAY_INIT then T_TUPLE_DELAY_INIT
                         else if UE_SPREAD then T_TUPLE_SPREAD
                         else if UE_TV_BAD then T_TUPLE_SHAPE
                         else if UE_TV and not UE_TV_SELECT then T_TUPLE_VALUE
                         else if UE_C1 and UE_BUNDLE then T_BUNDLE_CLOCK
                         else if (UE_C2 or UE_C4 or UE_C5) and UE_KIND_MIX then T_TUPLE_KIND_MIX
                         else if UE_C2 and UE_PSHAPE5 then T_TUPLE_SHAPE
                         else if UE_C2_STILL then T_TUPLE_EXPRESSION
                         else if UE_C3 and UE_ARG_EFFECT then T_TUPLE_EFFECT
                         else if UE_C3 and not UE_ARG_MODEL and not UE_SHAPE_CALL then T_TUPLE_EXPRESSION
                         else if UE_C3 and UE_IDX >= 0 then T_TUPLE_PLACE
                         else if UE_C4 and UE_BUNDLE and not UE_IDENT then T_TUPLE_EXPRESSION
                         else if UE_C4 and not UE_EQX_STARTS and (UE_IDX >= 0 or U_NODE_INDEX[UE_B_HEAD] > 0)
                              then (if UE_IDENT then T_TUPLE_PLACE else T_STRUCT_ELEMENT_EQUAL)
                         else if UE_C4 and not UE_EQX_STARTS then T_TUPLE_SHAPE
                         else if UE_C5 and not UE_BUNDLE then T_STRUCT_ORDER
                         else if UE_C6 and UE_IDX >= 0 and (UE_AFTER = C_DEFINE or UE_AFTER = C_PARTIAL_DEFINE) then T_STRUCT_ELEMENT_TARGET
                         else if UE_C5 or UE_C6 then T_TUPLE_EXPRESSION
                         else 0
        | UE_ERROR_ARG0 := if UE_TUPLE_CALL or UE_SPREAD then UE_CALLEE
                         else if UE_TV_ARGUMENT then UE_ARG_CALLEE
                         else if (UE_C2 or UE_C4 or UE_C5) and UE_KIND_MIX then UE_HNAME
                         else if UE_TV_BAD then UE_TV_HAVE
                         else if UE_C2 and UE_PSHAPE5 then UE_SHAPE_FOUND
                         else if UE_C4 and not UE_BUNDLE and not UE_KIND_MIX then UY_LEAF_COUNT[if UE_B_T >= 0 then UE_B_T else 0]
                         else UE_HNAME
        | UE_ERROR_ARG1 := if UE_C3 and UE_ARG_EFFECT then UE_ARG_CALLEE
                         else if (UE_C2 or UE_C4 or UE_C5) and UE_KIND_MIX then RAW_TOKEN_NAME[(if (UE_B_HEAD) >= 0 then (UE_B_HEAD) else 0)] - 1
                         else if UE_C6 and UE_IDX >= 0 then UE_HNAME
                         else if UE_TV_BAD or UE_C2 and UE_PSHAPE5 or UE_C4 then UE_TARGET_NAME[?]
                         else 0
        | UE_ERROR_ARG2 := if UE_TV_BAD then UE_TV_WANT else if UE_C2 and UE_PSHAPE5 then UE_SHAPE_WANT
                         else if UE_C4 then UY_LEAF_COUNT[UE_NTS] else 0
        | UE_LEAF_EMIT := UE_ERROR_HERE = 0 and (UE_B or UE_C1 or UE_C2 or UE_C3 and UE_SHAPE_CALL)
        | UE_LEAF_ID := UE_HBASE + (if UE_C2 then UE_POFF5 else 0)
        | UE_LEAF_END := if UE_IDX >= 0 then UE_IDX else UE_CEND_HERE
        | UE_ENTER_DECL := UE_W5
        | UE_D0 := U_DECL_AT[UE_RS] - 1
        | UE_DM := UE_MODE0 = 1
        | UE_D := UE_DEC[?]
        | UE_DPREFIX := UC_TYPE_START[UE_D] - UC_START[UE_D]
        | UE_DTYPE := UC_FINAL[UE_D]
        | UE_DLEAVES := UY_LEAF_COUNT[UE_DTYPE]
        | UE_DK := UE_DLEAF[?]
        | UE_DT0 := UE_DTYPE
        | UE_DJ0 := UE_DK
        | UE_DLASTF0 := -1
        | UE_DON0 := UE_DT0 >= 0
        | UE_DF0 := if UE_DON0 then UL_FIELD[UY_LEAF_BASE[(if (UE_DT0) >= 0 then (UE_DT0) else 0)] + UE_DJ0] else 0
        | UE_DT1 := if UE_DON0 then UD_NESTED[UE_DF0] else -1
        | UE_DJ1 := if UE_DON0 then UL_SUB[UY_LEAF_BASE[(if (UE_DT0) >= 0 then (UE_DT0) else 0)] + UE_DJ0] else 0
        | UE_DLASTF1 := if UE_DON0 then UE_DF0 else UE_DLASTF0
        | UE_DON1 := UE_DT1 >= 0
        | UE_DF1 := if UE_DON1 then UL_FIELD[UY_LEAF_BASE[(if (UE_DT1) >= 0 then (UE_DT1) else 0)] + UE_DJ1] else 0
        | UE_DT2 := if UE_DON1 then UD_NESTED[UE_DF1] else -1
        | UE_DJ2 := if UE_DON1 then UL_SUB[UY_LEAF_BASE[(if (UE_DT1) >= 0 then (UE_DT1) else 0)] + UE_DJ1] else 0
        | UE_DLASTF2 := if UE_DON1 then UE_DF1 else UE_DLASTF1
        | UE_DON2 := UE_DT2 >= 0
        | UE_DF2 := if UE_DON2 then UL_FIELD[UY_LEAF_BASE[(if (UE_DT2) >= 0 then (UE_DT2) else 0)] + UE_DJ2] else 0
        | UE_DT3 := if UE_DON2 then UD_NESTED[UE_DF2] else -1
        | UE_DJ3 := if UE_DON2 then UL_SUB[UY_LEAF_BASE[(if (UE_DT2) >= 0 then (UE_DT2) else 0)] + UE_DJ2] else 0
        | UE_DLASTF3 := if UE_DON2 then UE_DF2 else UE_DLASTF2
        | UE_DON3 := UE_DT3 >= 0
        | UE_DF3 := if UE_DON3 then UL_FIELD[UY_LEAF_BASE[(if (UE_DT3) >= 0 then (UE_DT3) else 0)] + UE_DJ3] else 0
        | UE_DT4 := if UE_DON3 then UD_NESTED[UE_DF3] else -1
        | UE_DJ4 := if UE_DON3 then UL_SUB[UY_LEAF_BASE[(if (UE_DT3) >= 0 then (UE_DT3) else 0)] + UE_DJ3] else 0
        | UE_DLASTF4 := if UE_DON3 then UE_DF3 else UE_DLASTF3
        | UE_DFS := if UE_DLASTF4 >= 0 then UE_DLASTF4 else 0
        | UE_DTSTART := UD_FSTART[UE_DFS]
        | UE_DTLEN := UD_FEND[UE_DFS] - UE_DTSTART + 1
        | UE_DPART := if UE_DPART0[?] = 0 and UE_DPREFIX = 0 then 1 else UE_DPART0[?]
        | UE_DJ := UE_DNAME[?]
        | UE_DSIG := UC_SIG_FIRST[UE_D] + UE_DJ
        | UE_DNAME_AT := UC_NAMES[UE_D] + 2 * UE_DJ
        | UE_DOFF := UE_DOFFSET[?]
        | UE_DPART_DONE := UE_DPART = 0 and UE_DOFF + 1 >= UE_DPREFIX or UE_DPART = 1 and UE_DOFF + 1 >= UE_DTLEN or UE_DPART >= 2
        | UE_DLEAF_LAST := UE_DK + 1 >= UE_DLEAVES
        | UE_DNAME_LAST := UE_DJ + 1 >= UC_NAME_COUNT[UE_D]
        | UE_DFINISH := UE_DM and UE_DPART = 3 and UE_DLEAF_LAST and UE_DNAME_LAST
        | UE_RM := UE_MODE0 = 2
        | UE_RSIG := UE_RELSIG[?] - 1
        | UE_RSIGS := if UE_RSIG >= 0 then UE_RSIG else 0
        | UE_RTYPE := US_TYPE[UE_RSIGS]
        | UE_RTS := if UE_RTYPE >= 0 then UE_RTYPE else 0
        | UE_RPH := UE_RPHASE[?]
        | UE_RG := UE_RGROUP[?] - 1
        | UE_RGS := if UE_RG >= 0 then UE_RG else 0
        | UE_RJ := UE_RLEAF[?]
        | UE_RP := UE_RPART[?]
        | UE_RSPEC := if UE_RTYPE >= 0 then UY_SPEC_OPEN[UE_RTS] - 1 else -1
        | UE_RSPEC_CLOSE := if UE_RSPEC >= 0 then U_CLOSE_OF[(if UE_RSPEC >= 0 then UE_RSPEC else 0)] - 1 else -1
        | UE_RSPEC_EMPTY := UE_RSPEC < 0 or UE_RSPEC_CLOSE <= UE_RSPEC + 1
        | UE_ROFF := UE_ROFFSET[?]
        | UE_RTOKEN := UE_RSPEC + 1 + UE_ROFF
        | UE_RFIELD := if UE_RSPEC >= 0 then U_SPEC_FIELD[if UE_RTOKEN >= 0 then UE_RTOKEN else 0] - 1 else -1
        | UE_RFINISH := UE_RM and UE_RSIG < 0
        | UE_RGROUP_SKIP := UE_RM and UE_RSIG >= 0 and UE_RPH = 0 and UE_RG < 0
        | UE_RSPEC_SKIP := UE_RM and UE_RSIG >= 0 and UE_RPH = 1 and UE_RSPEC_EMPTY
        | UE_RACTIVE := UE_RM and UE_RSIG >= 0 and not UE_RGROUP_SKIP and not UE_RSPEC_SKIP
        | UE_RSEP := UE_RACTIVE and UE_RP = 0
        | UE_RSEP_EMITS := UE_RSEP and UE_RNEED[?]
        | UE_RLEAF_EMITS := UE_RACTIVE and UE_RPH = 0 and UE_RP = 1
        | UE_RCLOCK_EMITS := UE_RACTIVE and UE_RPH = 0 and UE_RP = 2
        | UE_RSPEC_EMITS := UE_RACTIVE and UE_RPH = 1 and UE_RP = 1
        | UE_RGROUP_DONE := UE_RLEAF_EMITS and UE_RJ + 1 >= UA_LEAVES[UE_RGS]
        | UE_RSPEC_DONE := UE_RSPEC_EMITS and UE_RTOKEN + 1 >= UE_RSPEC_CLOSE or UE_RSPEC_SKIP
        | UE_RNEXT_SIG := US_NEXT[UE_RSIGS]
        | UE_RNEXT_TYPE := US_TYPE[if UE_RNEXT_SIG > 0 then UE_RNEXT_SIG - 1 else 0]
        | UE_FM := UE_MODE0 = 3
        | UE_FJ := UE_FLAT_J[?]
        | UE_FLEAF := UE_FM and UE_FLAT_PART[?] = 0
        | UE_FDONE := UE_FLEAF and UE_FJ + 1 >= UE_FLAT_COUNT[?]
        | UE_XM := UE_MODE0 = 4
        | UE_XP := UE_EQX_PART[?]
        | UE_XJ := UE_EQX_J[?]
        | UE_XDONE := UE_XM and UE_XP = 4 and UE_XJ + 1 >= UE_EQX_COUNT[?]
        | UE_QOPEN := UE_MODE0 = 5
        | UE_QTARGET := UE_MODE0 = 6
        | UE_QDEFINE := UE_MODE0 = 7
        | UE_QSEP := UE_MODE0 = 8
        | UE_QTL := UQ_TLEAF_BASE[UE_ES] + UE_LEAF[?]
        | UE_QMORE := UE_LEAF[?] + 1 < UQ_LEAVES[UE_ES]
        | UE_EMITS := UE_W2 and UE_CPAREN[?][UE_LVS] or UE_CFC or UE_W7_SINGLE
                    or UE_ERROR_HERE = 0 and (UE_LEAF_EMIT or UE_TV_GO and not UE_TV_BARE or UE_COPY)
                    or UE_DM or UE_RSEP_EMITS or UE_RLEAF_EMITS or UE_RCLOCK_EMITS or UE_RSPEC_EMITS
                    or UE_FM or UE_XM or UE_QOPEN or UE_QTARGET or UE_QDEFINE or UE_QSEP
        | UE_SRC := if UE_COPY or UE_TV_GO then UE_RS
                  else if UE_DM and UE_DPART = 0 then UC_START[UE_D] + UE_DOFF
                  else if UE_DM and UE_DPART = 1 then UE_DTSTART + UE_DOFF
                  else if UE_RSPEC_EMITS and UE_RFIELD < 0 then UE_RTOKEN
                  else if UE_QDEFINE then UQ_DEFINE[UE_ES]
                  else -1
        | UE_SYN_CODE := if UE_W2 then C_CLOSE else if UE_CFC then C_CLOSE else if UE_W7_SINGLE then C_OPEN
                       else if UE_DM and UE_DPART = 3 then C_SEMICOLON
                       else if UE_RSEP_EMITS then C_BAR else if UE_RCLOCK_EMITS then C_CLOCK_EQUAL
                       else if UE_FM and not UE_FLEAF then C_COMMA
                       else if UE_XM and UE_XP = 0 then (if UE_EQX_IDENT[?] then C_OPEN_BAR else C_OPEN)
                       else if UE_XM and UE_XP = 2 then (if UE_EQX_IDENT[?] then C_IDENTITY else C_EQUAL_EQUAL)
                       else if UE_XM and UE_XP = 4 and UE_EQX_IDENT[?] then (if UE_XDONE then C_BAR_CLOSE else C_BAR)
                       else if UE_XM and UE_XP = 4 then (if UE_XDONE then C_CLOSE else C_AND)
                       else if UE_QOPEN then C_OPEN_BAR else if UE_QSEP then (if UE_QMORE then C_BAR else C_BAR_CLOSE)
                       else C_NAME
        | UE_SYN_KIND := if UE_SYN_CODE = C_NAME then KIND_NAME else if UE_SYN_CODE = C_AND then KIND_KEYWORD else KIND_SYMBOL
        | UE_SYN_NAME := if UE_LEAF_EMIT then UE_LEAF_ID + 1
                       else if UE_DM then NAME_COUNT + US_HIDDEN_BASE[UE_DSIG] + UE_DK + 1
                       else if UE_RLEAF_EMITS then NAME_COUNT + US_HIDDEN_BASE[UE_RSIGS] + UA_LEAF[UE_RGS] + UE_RJ + 1
                       else if UE_RSPEC_EMITS then NAME_COUNT + US_HIDDEN_BASE[UE_RSIGS] + UD_LEAF_OFFSET[if UE_RFIELD >= 0 then UE_RFIELD else 0] + 1
                       else if UE_FM then UE_FLAT_BASE[?] + UE_FJ + 1
                       else if UE_XM and UE_XP = 1 then UE_EQX_A[?] + UE_XJ + 1
                       else if UE_XM and UE_XP = 3 then UE_EQX_B[?] + UE_XJ + 1
                       else if UE_QTARGET then UG_NAME[UE_QTL] + 1
                       else if UE_SYN_CODE = C_AND then C_AND else 0
        | UE_ORIGIN := if UE_SRC >= 0 then UE_SRC
                     else if UE_DM then UE_DNAME_AT
                     else if UE_RM then UE_REL_ORIGIN[?]
                     else if UE_FM then UE_FLAT_ORIGIN[?]
                     else if UE_XM then UE_EQX_ORIGIN[?]
                     else if UE_QTARGET then UG_ORIGIN[UE_QTL]
                     else if UE_QOPEN or UE_QSEP then UQ_DEFINE[UE_ES]
                     else UE_RS
        | UE_ORIGIN_END := if UE_LEAF_EMIT and UE_IDX < 0 and UE_NT < 0 then UE_CEND_HERE - 1 else UE_ORIGIN
        | UE_SRCS := if UE_SRC >= 0 then UE_SRC else 0
        | UE_SLOT := if UE_EMITS and UE_COUNT[?] < TOKEN_CAP then UE_COUNT[?] else -1
        | UE_COUNT := UE_COUNT[?] + integer(UE_EMITS)
        | UE_OVERFLOW := UE_OVERFLOW[?] or UE_EMITS and UE_COUNT[?] >= TOKEN_CAP
        | UE_COPIES := UE_SRC >= 0
        | TOKEN_KIND := TOKEN_KIND[?] next UE_SLOT : (if UE_COPIES then RAW_TOKEN_KIND[UE_SRCS] else ubyte(UE_SYN_KIND))
        | TOKEN_CODE := TOKEN_CODE[?] next UE_SLOT : (if UE_COPIES then RAW_TOKEN_CODE[UE_SRCS] else ubyte(UE_SYN_CODE))
        | TOKEN_NAME := TOKEN_NAME[?] next UE_SLOT : (if UE_COPIES then RAW_TOKEN_NAME[UE_SRCS] else UE_SYN_NAME)
        | TOKEN_START := TOKEN_START[?] next UE_SLOT : RAW_TOKEN_START[UE_ORIGIN]
        | TOKEN_LENGTH := TOKEN_LENGTH[?] next UE_SLOT
                        : (if UE_COPIES then RAW_TOKEN_LENGTH[UE_SRCS]
                           else RAW_TOKEN_START[UE_ORIGIN_END] + RAW_TOKEN_LENGTH[UE_ORIGIN_END] - RAW_TOKEN_START[UE_ORIGIN])
        | TOKEN_TEXT := TOKEN_TEXT[?] next UE_SLOT : RAW_TOKEN_TEXT[UE_ORIGIN]
        | TOKEN_LINE := TOKEN_LINE[?] next UE_SLOT : RAW_TOKEN_LINE[UE_ORIGIN]
        | TOKEN_COLUMN := TOKEN_COLUMN[?] next UE_SLOT : RAW_TOKEN_COLUMN[UE_ORIGIN]
        | UE_REAL := integer(RAW_TOKEN_KIND[UE_SRCS]) = KIND_REAL or integer(RAW_TOKEN_KIND[UE_SRCS]) = KIND_DREAL
        | TOKEN_VALUE := TOKEN_VALUE[?] next UE_SLOT
                         : (if not UE_COPIES then long(0) else if UE_REAL then REAL_VALUE[UE_SRCS] else RAW_TOKEN_VALUE[UE_SRCS])
        | TOKEN_BIG := TOKEN_BIG[?] next UE_SLOT : UE_COPIES and (if UE_REAL then REAL_BIG[UE_SRCS] else RAW_TOKEN_BIG[UE_SRCS])
        | UE_REAL_TYPE := if UE_REAL then BUILTIN_REAL + integer(integer(RAW_TOKEN_KIND[UE_SRCS]) = KIND_DREAL)
                          else if integer(RAW_TOKEN_CODE[UE_SRCS]) = C_NAME
                                  and (RAW_TOKEN_NAME[UE_SRCS] - 1 = BUILTIN_REAL or RAW_TOKEN_NAME[UE_SRCS] - 1 = BUILTIN_DREAL
                                       or RAW_TOKEN_NAME[UE_SRCS] - 1 = BUILTIN_COMPLEX or RAW_TOKEN_NAME[UE_SRCS] - 1 = BUILTIN_DCOMPLEX)
                          then RAW_TOKEN_NAME[UE_SRCS] - 1 else -1
        | UE_FIRST_REAL := UE_COPIES and UE_SLOT >= 0 and UE_REAL_TYPE >= 0 and FIRST_REAL_TOKEN[?] < 0
        | FIRST_REAL_TOKEN := if UE_FIRST_REAL then UE_SLOT else FIRST_REAL_TOKEN[?]
        | FIRST_REAL_TYPE := if UE_FIRST_REAL then UE_REAL_TYPE else FIRST_REAL_TYPE[?]
        | USES_COMPLEX := USES_COMPLEX[?] or UE_COPIES and UE_SLOT >= 0
                                             and (UE_REAL_TYPE = BUILTIN_COMPLEX or UE_REAL_TYPE = BUILTIN_DCOMPLEX
                                                  or integer(RAW_TOKEN_CODE[UE_SRCS]) = C_AT)
        | UE_FINISHED := UE_FINISHED[?] or UE_DONE_NOW
        | UE_MODE := if UE_ERROR_HERE /= 0 or UE_DONE_NOW then 9
                   else if UE_W1 then 8
                   else if UE_W5 then 1
                   else if UE_W6 then 2
                   else if UE_W7 and UE_EQ_HERE_KIND = 2 then 5
                   else if UE_FLAT_STARTS then 3
                   else if UE_EQX_STARTS then 4
                   else if UE_DFINISH or UE_RFINISH or UE_FDONE or UE_XDONE then 0
                   else if UE_QOPEN then 6 else if UE_QTARGET then 7 else if UE_QDEFINE then 0
                   else if UE_QSEP then (if UE_QMORE then 6 else 0)
                   else UE_MODE0
        | UE_POS := if UE_W2 then UE_CCLOSE[?][UE_LVS] + 1
                  else if UE_W3 then UE_JUMP_TO[?]
                  else if UE_W4 then U_REMOVE_TO[UE_RS] - 1
                  else if UE_LEAF_EMIT then UE_LEAF_END
                  else if UE_TV_GO then UE_TV_START
                  else if UE_FLAT_STARTS or UE_EQX_STARTS then UE_R
                  else if UE_COPY then UE_R + 1
                  else if UE_DFINISH then UC_END[UE_D] + 1
                  else if UE_FDONE then UE_FLAT_RESUME[?]
                  else if UE_XDONE then UE_EQX_RESUME[?]
                  else if UE_QDEFINE then UQ_DEFINE[UE_ES] + 1
                  else if UE_QSEP and not UE_QMORE then UQ_END[UE_ES] + 1
                  else UE_R
        | UE_JUMP_FROM := if UE_LEAF_EMIT and UE_IDX >= 0 then U_CLOSE_OF[(if UE_IDX >= 0 then UE_IDX else 0)] else if UE_W3 then -1 else UE_JUMP_FROM[?]
        | UE_JUMP_TO := if UE_LEAF_EMIT and UE_IDX >= 0 then UE_CEND_HERE else UE_JUMP_TO[?]
        | UE_EQ := if UE_W7 then UE_EQ_HERE + 1 else if UE_W1C or UE_QSEP and not UE_QMORE then 0 else UE_EQ[?]
        | UE_CF_CLOSE := if UE_W7_SINGLE then UQ_DEFINE[UE_EQ_HERE] else if UE_CFC then -1 else UE_CF_CLOSE[?]
        | UE_LEVEL := if UE_W2 then UE_LV - 1 else if UE_TV_GO then UE_LV + 1 else if UE_QDEFINE then 0 else UE_LV
        | UE_CEND := UE_CEND[?] next (if UE_TV_GO and UE_LV < 5 then UE_LV else -1) : UE_TV_END
        | UE_CCLOSE := UE_CCLOSE[?] next (if UE_TV_GO and UE_LV < 5 then UE_LV else -1) : U_CLOSE_OF[UE_RS] - 1
        | UE_CPAREN := UE_CPAREN[?] next (if UE_TV_GO and UE_LV < 5 then UE_LV else -1) : not UE_TV_BARE
        | UE_LEAF := if UE_W7 then 0 else if UE_QSEP and UE_QMORE then UE_LEAF[?] + 1 else UE_LEAF[?]
        | UE_TL := if UE_QTARGET then UE_QTL else UE_TL[?]
        | UE_PATHLEN := if UE_QTARGET then UG_LENGTH[UE_QTL] else if UE_W7 or UE_QSEP and not UE_QMORE then 0 else UE_PATHLEN[?]
        | UE_TARGET_NAME := if UE_QTARGET then RAW_TOKEN_NAME[(if (UG_ORIGIN[UE_QTL]) >= 0 then (UG_ORIGIN[UE_QTL]) else 0)] - 1 else UE_TARGET_NAME[?]
        | UE_RDONE := if UE_RFINISH then UE_REL_CLOSE[?] else UE_RDONE[?]
        | UE_DEC := if UE_W5 then UE_D0 else UE_DEC[?]
        | UE_DPART0 := if UE_W5 then 0 else if UE_DM and UE_DPART_DONE then (if UE_DPART = 3 then 0 else UE_DPART + 1)
                     else if UE_DM then UE_DPART else UE_DPART0[?]
        | UE_DOFFSET := if UE_W5 or UE_DM and UE_DPART_DONE then 0 else if UE_DM then UE_DOFF + 1 else UE_DOFFSET[?]
        | UE_DLEAF := if UE_W5 then 0 else if UE_DM and UE_DPART = 3 then (if UE_DLEAF_LAST then 0 else UE_DK + 1) else UE_DLEAF[?]
        | UE_DNAME := if UE_W5 then 0 else if UE_DM and UE_DPART = 3 and UE_DLEAF_LAST then UE_DJ + 1 else UE_DNAME[?]
        | UE_W6_SIG := UM_SIG_FIRST[UE_BODY_MODEL]
        | UE_W6_TYPE := US_TYPE[if UE_W6_SIG > 0 then UE_W6_SIG - 1 else 0]
        | UE_RELSIG := if UE_W6 then UE_W6_SIG else if UE_RSPEC_DONE then UE_RNEXT_SIG else UE_RELSIG[?]
        | UE_RPHASE := if UE_W6 or UE_RSPEC_DONE then 0 else if UE_RGROUP_SKIP then 1 else UE_RPHASE[?]
        | UE_RGROUP := if UE_W6 then (if UE_W6_TYPE >= 0 then UY_GROUP_FIRST[UE_W6_TYPE] else 0)
                     else if UE_RSPEC_DONE then (if UE_RNEXT_TYPE >= 0 then UY_GROUP_FIRST[UE_RNEXT_TYPE] else 0)
                     else if UE_RGROUP_DONE then UA_NEXT[UE_RGS] else UE_RGROUP[?]
        | UE_RLEAF := if UE_W6 or UE_RGROUP_DONE then 0 else if UE_RLEAF_EMITS then UE_RJ + 1 else UE_RLEAF[?]
        | UE_RPART := if UE_W6 or UE_RGROUP_DONE or UE_RSPEC_DONE then 0 else if UE_RSEP then 1
                    else if UE_RLEAF_EMITS then 2 else if UE_RCLOCK_EMITS then 1 else UE_RPART[?]
        | UE_ROFFSET := if UE_W6 or UE_RSPEC_DONE then 0 else if UE_RSPEC_EMITS then UE_ROFF + 1 else UE_ROFFSET[?]
        | UE_RNEED := if UE_W6 then U_OPEN_OF[UE_RS] < UE_RS else if UE_RSEP then true else UE_RNEED[?]
        | UE_REL_CLOSE := if UE_W6 then UE_R else UE_REL_CLOSE[?]
        | UE_REL_ORIGIN := if UE_W6 then UE_R else UE_REL_ORIGIN[?]
        | UE_FLAT_BASE := if UE_FLAT_STARTS then UE_HBASE else UE_FLAT_BASE[?]
        | UE_FLAT_COUNT := if UE_FLAT_STARTS then UE_LEAFCOUNT else UE_FLAT_COUNT[?]
        | UE_FLAT_J := if UE_FLAT_STARTS then 0 else if UE_FM and not UE_FLEAF then UE_FJ + 1 else UE_FLAT_J[?]
        | UE_FLAT_PART := if UE_FLAT_STARTS then 0 else if UE_FM then 1 - UE_FLAT_PART[?] else UE_FLAT_PART[?]
        | UE_FLAT_RESUME := if UE_FLAT_STARTS then UE_CEND_HERE else UE_FLAT_RESUME[?]
        | UE_FLAT_ORIGIN := if UE_FLAT_STARTS then UE_R else UE_FLAT_ORIGIN[?]
        | UE_EQX_A := if UE_EQX_STARTS then UE_HBASE else UE_EQX_A[?]
        | UE_EQX_B := if UE_EQX_STARTS then NAME_COUNT + US_HIDDEN_BASE[if UE_B_SIG >= 0 then UE_B_SIG else 0] + U_NODE_FIRST[UE_B_HEAD]
                    else UE_EQX_B[?]
        | UE_EQX_COUNT := if UE_EQX_STARTS then UE_LEAFCOUNT else UE_EQX_COUNT[?]
        | UE_EQX_J := if UE_EQX_STARTS then 0 else if UE_XM and UE_XP = 4 then UE_XJ + 1 else UE_EQX_J[?]
        | UE_EQX_PART := if UE_EQX_STARTS then 0 else if UE_XM then (if UE_XP = 4 then 1 else UE_XP + 1) else UE_EQX_PART[?]
        | UE_EQX_RESUME := if UE_EQX_STARTS then U_CHAIN_END[UE_B_HEAD] else UE_EQX_RESUME[?]
        | UE_EQX_ORIGIN := if UE_EQX_STARTS then UE_R else UE_EQX_ORIGIN[?]
        | UE_EQX_IDENT := if UE_EQX_STARTS then UE_IDENT else UE_EQX_IDENT[?]
        | UE_FOUND_MESSAGE := if UE_ERROR_HERE /= 0 then UE_ERROR_HERE else if UE_OVERFLOW and not UE_OVERFLOW[?] then T_CAPACITY else 0
        | UE_FOUND_ARGUMENT0 := if UE_ERROR_HERE /= 0 then UE_ERROR_ARG0 else F_CAP_TOKENS
        | UE_FOUND_ARGUMENT1 := UE_ERROR_ARG1
        | UE_FOUND_ARGUMENT2 := UE_ERROR_ARG2
        | UE_FIRST_ERROR := UE_MESSAGE[?] = 0 and UE_FOUND_MESSAGE /= 0
        | UE_MESSAGE := if UE_FIRST_ERROR then UE_FOUND_MESSAGE else UE_MESSAGE[?]
        | UE_TOKEN := if UE_FIRST_ERROR then UE_RS else UE_TOKEN[?]
        | UE_ARGUMENT0 := if UE_FIRST_ERROR then UE_FOUND_ARGUMENT0 else UE_ARGUMENT0[?]
        | UE_ARGUMENT1 := if UE_FIRST_ERROR then UE_FOUND_ARGUMENT1 else UE_ARGUMENT1[?]
        | UE_ARGUMENT2 := if UE_FIRST_ERROR then UE_FOUND_ARGUMENT2 else UE_ARGUMENT2[?]
        |)
     with (| UE_MODE := 0 | UE_POS := 0 | UE_EQ := 0 | UE_LEVEL := 0 | UE_PATHLEN := 0 | UE_TL := 0 | UE_LEAF := 0
           | UE_JUMP_FROM := -1 | UE_JUMP_TO := 0 | UE_CF_CLOSE := -1 | UE_TARGET_NAME := 0 | UE_RDONE := -1
           | UE_DEC := 0 | UE_DPART0 := 0 | UE_DOFFSET := 0 | UE_DLEAF := 0 | UE_DNAME := 0
           | UE_RELSIG := 0 | UE_RPHASE := 0 | UE_RGROUP := 0 | UE_RLEAF := 0 | UE_RPART := 0 | UE_ROFFSET := 0
           | UE_RNEED := false | UE_REL_CLOSE := -1 | UE_REL_ORIGIN := 0
           | UE_FLAT_BASE := 0 | UE_FLAT_COUNT := 0 | UE_FLAT_J := 0 | UE_FLAT_PART := 0 | UE_FLAT_RESUME := 0 | UE_FLAT_ORIGIN := 0
           | UE_EQX_A := 0 | UE_EQX_B := 0 | UE_EQX_COUNT := 0 | UE_EQX_J := 0 | UE_EQX_PART := 0 | UE_EQX_RESUME := 0
           | UE_EQX_ORIGIN := 0 | UE_EQX_IDENT := false | UE_COUNT := 0 | UE_OVERFLOW := false | FIRST_REAL_TOKEN := -1 | FIRST_REAL_TYPE := 0 | USES_COMPLEX := false | UE_FINISHED := false | UE_MESSAGE := 0 | UE_TOKEN := 0 | UE_ARGUMENT0 := 0 | UE_ARGUMENT1 := 0 | UE_ARGUMENT2 := 0 |)
     end
   | U_MESSAGE := if not CONVERTED then 0
                   else if UP_MESSAGE /= 0 then UP_MESSAGE
                   else if UZ_MESSAGE /= 0 then UZ_MESSAGE
                   else if UK_MESSAGE /= 0 then UK_MESSAGE
                   else if UR_MESSAGE /= 0 then UR_MESSAGE
                   else if U_SEEN and UH_TOTAL > U_TEXT_CAP then T_CAPACITY
                   else if UE_MESSAGE /= 0 then UE_MESSAGE
                   else if not UE_FINISHED then T_CAPACITY else 0
   | U_TOKEN := if not CONVERTED then 0
                   else if UP_MESSAGE /= 0 then UP_TOKEN
                   else if UZ_MESSAGE /= 0 then UZ_TOKEN
                   else if UK_MESSAGE /= 0 then UK_TOKEN
                   else if UR_MESSAGE /= 0 then UR_TOKEN
                   else if U_SEEN and UH_TOTAL > U_TEXT_CAP then 0
                   else if UE_MESSAGE /= 0 then UE_TOKEN
                   else if not UE_FINISHED then 0 else 0
   | U_ARGUMENT0 := if not CONVERTED then 0
                   else if UP_MESSAGE /= 0 then UP_ARGUMENT0
                   else if UZ_MESSAGE /= 0 then UZ_ARGUMENT0
                   else if UK_MESSAGE /= 0 then UK_ARGUMENT0
                   else if UR_MESSAGE /= 0 then UR_ARGUMENT0
                   else if U_SEEN and UH_TOTAL > U_TEXT_CAP then F_CAP_TUPLES
                   else if UE_MESSAGE /= 0 then UE_ARGUMENT0
                   else if not UE_FINISHED then F_CAP_TOKENS else 0
   | U_ARGUMENT1 := if not CONVERTED then 0
                   else if UP_MESSAGE /= 0 then UP_ARGUMENT1
                   else if UZ_MESSAGE /= 0 then UZ_ARGUMENT1
                   else if UK_MESSAGE /= 0 then UK_ARGUMENT1
                   else if UR_MESSAGE /= 0 then UR_ARGUMENT1
                   else if U_SEEN and UH_TOTAL > U_TEXT_CAP then 0
                   else if UE_MESSAGE /= 0 then UE_ARGUMENT1
                   else if not UE_FINISHED then 0 else 0
   | U_ARGUMENT2 := if not CONVERTED then 0
                   else if UP_MESSAGE /= 0 then UP_ARGUMENT2
                   else if UZ_MESSAGE /= 0 then UZ_ARGUMENT2
                   else if UK_MESSAGE /= 0 then UK_ARGUMENT2
                   else if UR_MESSAGE /= 0 then UR_ARGUMENT2
                   else if U_SEEN and UH_TOTAL > U_TEXT_CAP then 0
                   else if UE_MESSAGE /= 0 then UE_ARGUMENT2
                   else if not UE_FINISHED then 0 else 0
   | U_READY := CONVERTED and U_MESSAGE = 0
   | TOKEN_COUNT := UE_COUNT
   | PRESCAN_INDEX := 0 .. (if U_READY then TOKEN_COUNT - 1 else -1)
   | iterate PRESCAN_INDEX of
       (| SCAN_CODE := integer(TOKEN_CODE[PRESCAN_INDEX])
        | SCAN_NAME := TOKEN_NAME[PRESCAN_INDEX] - 1
        | SCAN_PREVIOUS := SCAN_STATE[?]
        | SCAN_IS_NAME := SCAN_CODE = C_NAME
        | SCAN_CLASHES := SCAN_NAME <= N_ISIN or NAME_TYPE[?][SCAN_NAME] > 0
        | SCAN_DUPLICATE := VALUE_STAMP[?][SCAN_NAME] = USER_TYPE_COUNT[?] + 1
        | SCAN_FULL := SCAN_PREVIOUS = PRE_SEMICOLON and USER_TYPE_COUNT[?] >= TYPE_CAP - BUILTIN_TYPE_COUNT
                       or SCAN_PREVIOUS = PRE_VALUE and VALUE_COUNT[?] >= VALUE_CAP
        | SCAN_NAMES_MODEL_TYPE := SCAN_PREVIOUS = PRE_NAME and MODEL_CLASS[SCAN_CODE] = 1
        | SCAN_MESSAGE := if SCAN_NAMES_MODEL_TYPE then 0
                          else if SCAN_PREVIOUS = PRE_NAME then
                            (if not SCAN_IS_NAME then T_EXPECTED_NAME
                             else if SCAN_CLASHES then (if SCAN_NAME >= N_LOAD and SCAN_NAME <= N_ISIN then T_RESERVED else T_DECLARED_TWICE) else 0)
                          else if SCAN_PREVIOUS = PRE_EQUAL then (if SCAN_CODE /= C_EQUAL then T_EXPECTED_FOUND else 0)
                          else if SCAN_PREVIOUS = PRE_OPEN then (if SCAN_CODE /= C_OPEN then T_EXPECTED_FOUND else 0)
                          else if SCAN_PREVIOUS = PRE_VALUE then
                            (if not SCAN_IS_NAME then T_EXPECTED_NAME else if SCAN_DUPLICATE then T_ENUM_TWICE
                             else if SCAN_FULL then T_CAPACITY else 0)
                          else if SCAN_PREVIOUS = PRE_SEPARATOR then
                            (if SCAN_CODE /= C_COMMA and SCAN_CODE /= C_CLOSE then T_EXPECTED_FOUND else 0)
                          else if SCAN_PREVIOUS = PRE_SEMICOLON then
                            (if SCAN_CODE /= C_SEMICOLON then T_EXPECTED_FOUND else if SCAN_FULL then T_CAPACITY else 0)
                          else 0
        | SCAN_FAILS := SCAN_MESSAGE /= 0
        | SCAN_ARGUMENT0 := if SCAN_MESSAGE = T_EXPECTED_NAME then PRESCAN_INDEX
                            else if SCAN_MESSAGE = T_DECLARED_TWICE then F_ROLE_TYPE
                            else if SCAN_MESSAGE = T_CAPACITY then (if SCAN_PREVIOUS = PRE_VALUE then F_CAP_VALUES else F_CAP_TYPES)
                            else if SCAN_MESSAGE = T_EXPECTED_FOUND then
                              (if SCAN_PREVIOUS = PRE_EQUAL then C_EQUAL else if SCAN_PREVIOUS = PRE_KIND then C_ENUM
                               else if SCAN_PREVIOUS = PRE_OPEN then C_OPEN else if SCAN_PREVIOUS = PRE_SEPARATOR then C_CLOSE
                               else C_SEMICOLON)
                            else SCAN_NAME
        | SCAN_ARGUMENT1 := if SCAN_MESSAGE = T_EXPECTED_FOUND then PRESCAN_INDEX else SCAN_NAME
        | SCAN_STATE := if SCAN_PREVIOUS = PRE_FAILED or SCAN_FAILS then PRE_FAILED
                        else if SCAN_PREVIOUS = PRE_IDLE then (if SCAN_CODE = C_TYPE and not IN_FORMAL_SCAN[?] then PRE_NAME else PRE_IDLE)
                        else if SCAN_PREVIOUS = PRE_NAME then (if SCAN_NAMES_MODEL_TYPE then PRE_IDLE else PRE_EQUAL)
                        else if SCAN_PREVIOUS = PRE_EQUAL then PRE_KIND
                        else if SCAN_PREVIOUS = PRE_KIND then
                          (if SCAN_CODE = C_EXTERNAL then PRE_SEMICOLON else if SCAN_CODE = C_ENUM then PRE_OPEN else PRE_IDLE)
                        else if SCAN_PREVIOUS = PRE_OPEN then PRE_VALUE
                        else if SCAN_PREVIOUS = PRE_VALUE then PRE_SEPARATOR
                        else if SCAN_PREVIOUS = PRE_SEPARATOR then (if SCAN_CODE = C_COMMA then PRE_VALUE else PRE_SEMICOLON)
                        else PRE_IDLE
        | SCAN_TYPE_NAME := if SCAN_PREVIOUS = PRE_NAME then SCAN_NAME else SCAN_TYPE_NAME[?]
        | SCAN_TYPE_KIND := if SCAN_PREVIOUS = PRE_KIND then (if SCAN_CODE = C_EXTERNAL then TK_EXTERNAL else TK_ENUM) else SCAN_TYPE_KIND[?]
        | SCAN_VALUE_START := if SCAN_PREVIOUS = PRE_NAME then VALUE_COUNT[?] else SCAN_VALUE_START[?]
        | SCAN_APPENDS_VALUE := SCAN_PREVIOUS = PRE_VALUE and not SCAN_FAILS
        | VALUE_NAME := VALUE_NAME[?] next (if SCAN_APPENDS_VALUE then VALUE_COUNT[?] else -1) : SCAN_NAME
        | VALUE_STAMP := VALUE_STAMP[?] next (if SCAN_APPENDS_VALUE then SCAN_NAME else -1) : USER_TYPE_COUNT[?] + 1
        | VALUE_COUNT := VALUE_COUNT[?] + integer(SCAN_APPENDS_VALUE)
        | SCAN_REGISTERS := SCAN_PREVIOUS = PRE_SEMICOLON and not SCAN_FAILS
        | USER_TYPE_SLOT := if SCAN_REGISTERS then USER_TYPE_COUNT[?] else -1
        | USER_TYPE_NAME := USER_TYPE_NAME[?] next USER_TYPE_SLOT : SCAN_TYPE_NAME
        | USER_TYPE_KIND := USER_TYPE_KIND[?] next USER_TYPE_SLOT : SCAN_TYPE_KIND
        | USER_TYPE_VALUE_START := USER_TYPE_VALUE_START[?] next USER_TYPE_SLOT : SCAN_VALUE_START
        | USER_TYPE_VALUE_COUNT := USER_TYPE_VALUE_COUNT[?] next USER_TYPE_SLOT : VALUE_COUNT[?] - SCAN_VALUE_START
        | NAME_TYPE := NAME_TYPE[?] next (if SCAN_REGISTERS then SCAN_TYPE_NAME else -1) : BUILTIN_TYPE_COUNT + USER_TYPE_COUNT[?] + 1
        | USER_TYPE_COUNT := USER_TYPE_COUNT[?] + integer(SCAN_REGISTERS)
        | FIRST_SCAN_FAILURE := SCAN_FAILS and SCAN_PREVIOUS /= PRE_FAILED
        | PRESCAN_MESSAGE := if FIRST_SCAN_FAILURE then SCAN_MESSAGE else PRESCAN_MESSAGE[?]
        | PRESCAN_TOKEN := if FIRST_SCAN_FAILURE then PRESCAN_INDEX else PRESCAN_TOKEN[?]
        | PRESCAN_ARGUMENT0 := if FIRST_SCAN_FAILURE then SCAN_ARGUMENT0 else PRESCAN_ARGUMENT0[?]
        | PRESCAN_ARGUMENT1 := if FIRST_SCAN_FAILURE then SCAN_ARGUMENT1 else PRESCAN_ARGUMENT1[?]
        | BRACKET_COUNT := BRACKET_COUNT[?] + integer(SCAN_CODE = C_OPEN_BRACKET and integer(TOKEN_CODE[PRESCAN_INDEX + 1]) /= C_QUESTION)
        | COLONS_COUNT := COLONS_COUNT[?] + integer(SCAN_CODE = C_COLONS)
        | SET_OPENS := SCAN_CODE = C_OPEN_BRACE and SCAN_LAST_CODE[?] /= C_NAME
        | IN_SET_SCAN := if SET_OPENS then true else if SCAN_CODE = C_CLOSE_BRACE then false else IN_SET_SCAN[?]
        | IN_FORMAL_SCAN := if SCAN_CODE = C_OPEN_BRACE and SCAN_LAST_CODE[?] = C_EQUAL then true
                            else if SCAN_CODE = C_CLOSE_BRACE then false else IN_FORMAL_SCAN[?]
        | SET_NAMES := SET_NAMES[?] + integer(IN_SET_SCAN[?] and SCAN_IS_NAME)
        | SCAN_DECLARES_MODEL := SCAN_IS_NAME and MODEL_CLASS[SCAN_LAST_CODE[?]] = 1
        | USER_DIM := USER_DIM[?] or SCAN_DECLARES_MODEL and SCAN_NAME = N_DIM
        | USER_SIZE := USER_SIZE[?] or SCAN_DECLARES_MODEL and SCAN_NAME = N_SIZE
        | USER_BOUNDS := USER_BOUNDS[?] or SCAN_DECLARES_MODEL and SCAN_NAME = N_BOUNDS
        | SCAN_LAST_CODE := SCAN_CODE
        | MODEL_TYPE_WORDS := MODEL_TYPE_WORDS[?] + integer(SCAN_NAMES_MODEL_TYPE)
        | POWER_SPAN_START := if SCAN_CODE = C_DEFINE or SCAN_CODE = C_BAR or SCAN_CODE = C_OPEN_BAR or SCAN_CODE = C_SEMICOLON
                                 or SCAN_CODE = C_EQUAL then PRESCAN_INDEX else POWER_SPAN_START[?]
        | POWER_ESTIMATE := if integer(TOKEN_CODE[PRESCAN_INDEX + 1]) /= C_NUMBER then long(256)
                            else if TOKEN_VALUE[PRESCAN_INDEX + 1] < long(0) or TOKEN_VALUE[PRESCAN_INDEX + 1] > long(65536) then long(65536)
                            else TOKEN_VALUE[PRESCAN_INDEX + 1]
        | POWER_BUDGET := POWER_BUDGET[?]
                          + (if SCAN_CODE = C_STAR_STAR then (POWER_ESTIMATE + long(1)) * long(PRESCAN_INDEX - POWER_SPAN_START[?] + 2) else long(0))
        | COPY_COUNT := COPY_COUNT[?] + integer(SCAN_CODE = C_CLOCK_MINUS or SCAN_CODE = C_BACKSLASHES or SCAN_IS_NAME and SCAN_NAME = N_ABS
                                                or SCAN_CODE = C_BAR_STAR or SCAN_CODE = C_ARRAY)
        | IN_SELECTOR_SCAN := if SCAN_CODE = C_CASE then true else if SCAN_CODE = C_IN then false else IN_SELECTOR_SCAN[?]
        | SELECTOR_TOKENS := SELECTOR_TOKENS[?] + integer(IN_SELECTOR_SCAN[?])
        | BRACE_COMMAS := if SCAN_CODE = C_OPEN_BRACE then 0 else BRACE_COMMAS[?] + integer(SCAN_CODE = C_COMMA)
        | LAST_OPEN_BRACE := if SCAN_CODE = C_OPEN_BRACE then PRESCAN_INDEX else LAST_OPEN_BRACE[?]
        | CLOSES_VALUES := SCAN_CODE = C_CLOSE_BRACE and integer(TOKEN_CODE[PRESCAN_INDEX + 1]) = C_COLON
        | VALUE_BRACE := VALUE_BRACE[?] next (if CLOSES_VALUES then LAST_OPEN_BRACE[?] else -1) : true
        | SCAN_BRACKET_OPENS := SCAN_CODE = C_OPEN_BRACKET
        | SCAN_BRACKET_CLOSES := SCAN_CODE = C_CLOSE_BRACKET and BRACKET_DEPTH[?] > 0
        | SCAN_BRACKET_STARTS := SCAN_BRACKET_OPENS and SCAN_LAST_CODE[?] /= C_CLOSE_BRACKET and BRACKET_DEPTH[?] < BRACKET_NEST_CAP
        | BRACKET_DEPTH := BRACKET_DEPTH[?] + integer(SCAN_BRACKET_OPENS) - integer(SCAN_BRACKET_CLOSES)
        | BRACKET_OPEN_AT := BRACKET_OPEN_AT[?] next (if SCAN_BRACKET_STARTS then BRACKET_DEPTH[?] else -1)
                             : PRESCAN_INDEX
        | BRACKET_RANGE := BRACKET_RANGE[?]
                           next (if SCAN_BRACKET_STARTS then BRACKET_DEPTH[?]
                                 else if SCAN_CODE = C_RANGE and BRACKET_DEPTH[?] > 0 and BRACKET_DEPTH[?] <= BRACKET_NEST_CAP then BRACKET_DEPTH[?] - 1
                                 else -1)
                           : not SCAN_BRACKET_OPENS
        | SCAN_PAREN_DEPTH := SCAN_PAREN_DEPTH[?] + integer(SCAN_CODE = C_OPEN) - integer(SCAN_CODE = C_CLOSE)
        | BRACKET_PARENS := BRACKET_PARENS[?] next (if SCAN_BRACKET_STARTS then BRACKET_DEPTH[?] else -1) : SCAN_PAREN_DEPTH[?]
        | SCAN_INDEX_COMMA := SCAN_CODE = C_COMMA and BRACKET_DEPTH[?] > 0 and BRACKET_DEPTH[?] <= BRACKET_NEST_CAP
                              and SCAN_PAREN_DEPTH[?] = BRACKET_PARENS[?][BRACKET_DEPTH[?] - 1]
        | BRACKET_INDEX_SLOT := if SCAN_BRACKET_OPENS and BRACKET_DEPTH[?] < BRACKET_NEST_CAP then BRACKET_DEPTH[?]
                                else if SCAN_INDEX_COMMA then BRACKET_DEPTH[?] - 1 else -1
        | BRACKET_INDICES := BRACKET_INDICES[?] next BRACKET_INDEX_SLOT
                             : (if SCAN_BRACKET_STARTS then 1 else BRACKET_INDICES[?][BRACKET_INDEX_SLOT] + 1)
        | BRACE_DEPTH := BRACE_DEPTH[?] + integer(SCAN_CODE = C_OPEN_BRACE) - integer(SCAN_CODE = C_CLOSE_BRACE and BRACE_DEPTH[?] > 0)
        | ELEMENT_OPEN := if SCAN_BRACKET_CLOSES and BRACKET_DEPTH < BRACKET_NEST_CAP then BRACKET_OPEN_AT[BRACKET_DEPTH] else 0
        | ELEMENT_BEFORE := if ELEMENT_OPEN >= 2 then integer(TOKEN_CODE[ELEMENT_OPEN - 2]) else 0
        | ELEMENT_ENDPOINT := ELEMENT_OPEN >= 2 and BRACE_DEPTH = 0 and integer(TOKEN_CODE[ELEMENT_OPEN - 1]) = C_NAME
                              and (ELEMENT_BEFORE = C_ARROW
                                   or integer(TOKEN_CODE[PRESCAN_INDEX + 1]) = C_ARROW and (ELEMENT_BEFORE = C_BAR or ELEMENT_BEFORE = C_OPEN_BAR))
        | ELEMENT_TARGET_ENDS := ELEMENT_OPEN >= 2 and BRACE_DEPTH = 0 and integer(TOKEN_CODE[ELEMENT_OPEN - 1]) = C_NAME
                                 and (ELEMENT_BEFORE = C_BAR or ELEMENT_BEFORE = C_OPEN_BAR or ELEMENT_BEFORE = C_OF or ELEMENT_BEFORE = C_WITH)
                                 and integer(TOKEN_CODE[PRESCAN_INDEX + 1]) = C_DEFINE
        | ELEMENT_TARGET := ELEMENT_TARGET[?] next (if ELEMENT_TARGET_ENDS then ELEMENT_OPEN - 1 else -1) : true
        | ELEMENT_SKIP := ELEMENT_SKIP[?] next (if ELEMENT_ENDPOINT then ELEMENT_OPEN - 1 else -1) : PRESCAN_INDEX - ELEMENT_OPEN + 1
        | ELEMENT_INDICES := ELEMENT_INDICES[?] next (if ELEMENT_ENDPOINT then ELEMENT_OPEN - 1 else -1)
                             : BRACKET_INDICES[if ELEMENT_ENDPOINT then BRACKET_DEPTH else 0]
        | ELEMENT_RANGE := ELEMENT_RANGE[?] next (if ELEMENT_ENDPOINT then ELEMENT_OPEN - 1 else -1)
                           : BRACKET_RANGE[if ELEMENT_ENDPOINT then BRACKET_DEPTH else 0]
        | CASE_VALUES := CASE_VALUES[?]
                         + (if CLOSES_VALUES then BRACE_COMMAS[?] + 1 else 0)
        |)
     with (| BRACKET_COUNT := 0 | COLONS_COUNT := 0 | SET_NAMES := 0 | COPY_COUNT := 0 | POWER_SPAN_START := 0 | POWER_BUDGET := long(0) | MODEL_TYPE_WORDS := 0 | IN_SELECTOR_SCAN := false
           | SELECTOR_TOKENS := 0 | BRACKET_DEPTH := 0 | SCAN_PAREN_DEPTH := 0 | BRACE_DEPTH := 0 | USER_DIM := false | USER_SIZE := false | USER_BOUNDS := false | BRACE_COMMAS := 0 | CASE_VALUES := 0 | LAST_OPEN_BRACE := 0 | IN_SET_SCAN := false | IN_FORMAL_SCAN := false | SCAN_LAST_CODE := 0 | SCAN_STATE := PRE_IDLE | SCAN_TYPE_NAME := 0 | SCAN_TYPE_KIND := 0 | SCAN_VALUE_START := 0 | VALUE_COUNT := 0
           | USER_TYPE_COUNT := 0 | PRESCAN_MESSAGE := 0 | PRESCAN_TOKEN := 0 | PRESCAN_ARGUMENT0 := 0
           | PRESCAN_ARGUMENT1 := 0 |)
     end
   | PARSES := U_READY and PRESCAN_MESSAGE = 0
   | PARSE_BOUND := long(BUILTIN_TYPE_COUNT + USER_TYPE_COUNT + 16) + long(8) * long(TOKEN_COUNT)
                    + long(BRACKET_COUNT) * long(BRACKET_COUNT) + long(COLONS_COUNT) * long(COLONS_COUNT)
                    + long(SET_NAMES) * long(SET_NAMES + 2) + long(32) * long(COPY_COUNT) * long(TOKEN_COUNT)
                    + long(4) * long(MODEL_TYPE_WORDS) * long(TOKEN_COUNT)
                    + long(CASE_VALUES) * long(4 * SELECTOR_TOKENS + CASE_VALUES + 16) + long(8) * POWER_BUDGET
   | PARSE_INDEX := 0 .. (if PARSES then PARSE_BOUND else long(-1))
   | iterate PARSE_INDEX of
       (| HERE := AT[?]
        | STATE_BEFORE := PARSE_STATE[?]
        | CODE0 := integer(TOKEN_CODE[HERE])
        | CODE1 := integer(TOKEN_CODE[HERE + 1 + ELEMENT_SKIP[HERE]])
        | CODE2 := integer(TOKEN_CODE[HERE + 2 + ELEMENT_SKIP[HERE]])
        | CODE3 := integer(TOKEN_CODE[HERE + 3])
        | NAME0 := TOKEN_NAME[HERE] - 1
        | NAME1 := TOKEN_NAME[HERE + 1] - 1
        | NAME2 := TOKEN_NAME[HERE + 2] - 1
        | MODEL_NOW := CURRENT_MODEL[?]
        | FORMALS_NOW := FORMALS_OPEN[?]
        | INDEX_TOP := if INDEX_DEPTH[?] > 0 then INDEX_STACK[?][INDEX_DEPTH[?] - 1] else -1
        | DRAIN_ID := if INDEX_TOP >= 0 then INDEX_TOP else 0
        | DRAIN_ARRAY := INDEX_ID_ARRAY[?][DRAIN_ID]
        | DECLARES_INDEX := STATE_BEFORE = P_INDEX_DECLARE and DRAIN_ARRAY
        | COPY_BEFORE := STATE_BEFORE = P_MODEL_COPY
        | INTERFACE_COPY_SIZE := MODEL_CLOSE_SIGNALS[?][INTERFACE_COPY_SOURCE[?]] - MODEL_SIGNAL_START[?][INTERFACE_COPY_SOURCE[?]]
        | INTERFACE_COPY_ROW := MODEL_SIGNAL_START[?][INTERFACE_COPY_SOURCE[?]] + INTERFACE_COPY_J[?]
        | INTERFACE_COPY_LIVE := COPY_BEFORE and INTERFACE_COPY_J[?] < INTERFACE_COPY_SIZE
        | LOOKUP_KEY := if DECLARES_INDEX then INDEX_ID_NAME[?][DRAIN_ID] else if INTERFACE_COPY_LIVE then SIGNAL_NAME[?][INTERFACE_COPY_ROW]
                        else NAME0
        | LOOKS_UP := (STATE_BEFORE = P_TYPE_SIZE or STATE_BEFORE = P_DECLARE_NAME or STATE_BEFORE = P_CONSTANT_NAME
                       or STATE_BEFORE = P_LABEL_NAME or STATE_BEFORE = P_REF_NAME or STATE_BEFORE = P_TYPE_NAME
                       or STATE_BEFORE = P_PARAMETER_DECL
                       or STATE_BEFORE = P_PARAMETER or STATE_BEFORE = P_PARAMETER_MODEL_NAME) and CODE0 = C_NAME or DECLARES_INDEX
                    or INTERFACE_COPY_LIVE
        | LOCAL_TOP := if LOOKS_UP then LOCAL_HEAD[?][LOOKUP_KEY] - 1 else -1
        | LOCAL_TOP_MODEL := LOCAL_MODEL[?][LOCAL_TOP]
        | STALE := LOCAL_TOP >= 0 and MODEL_CLOSED[?][LOCAL_TOP_MODEL]
        | DRAIN_DUE := (STATE_BEFORE = P_MODEL_AFTER or STATE_BEFORE = P_END_SEMICOLON) and CODE0 = C_SEMICOLON and INDEX_TOP >= 0
                       and INDEX_ID_MODEL[?][DRAIN_ID] = MODEL_NOW
        | REPEAT_DUE := STATE_BEFORE = P_EQUATION_END and TARGET[?] >= 0 and not TUPLE_ACTIVE and LAST_ENTRY >= EXPRESSION_START[?]
                        and integer(ENTRY_OP[?][LAST_ENTRY]) = OP_REPEAT
        | STATE := if STALE then P_STALL else if DRAIN_DUE then P_INDEX_TYPE else if REPEAT_DUE then P_REPEAT_START else STATE_BEFORE
        | DECLARED := LOCAL_TOP >= 0 and LOCAL_TOP_MODEL = MODEL_NOW or NAME_CONSTANT[?][LOOKUP_KEY] > 0 or NAME_TYPE[LOOKUP_KEY] > 0
                      or NAME_ALIAS[?][LOOKUP_KEY] > 0 or NAME_MODEL[?][LOOKUP_KEY] or LOOKUP_KEY >= N_LOAD and LOOKUP_KEY <= N_ISIN
                      or NAME_MODULE[?][LOOKUP_KEY] > 0
        | GLOBALLY_USED := NAME_SIGNAL_EVER[?][NAME0] or NAME_LABEL_EVER[?][NAME0]
        | RESERVED := LOOKUP_KEY >= N_LOAD and LOOKUP_KEY <= N_ISIN
        | CLASH_MESSAGE := if RESERVED then T_RESERVED else if NAME_MODEL[?][LOOKUP_KEY] then T_NAME_OF_MODEL else T_DECLARED_TWICE
        | FORMAL_SLOT_HERE := if LOCAL_TOP >= 0 and LOCAL_TOP_MODEL = MODEL_NOW then LOCAL_FORMAL_SLOT[?][LOCAL_TOP] else -1
        | FORMAL_TYPE_HERE := FORMAL_SLOT_HERE >= 0 and RETURN_STATE[?] = P_DECLARE_NAME and not FORMALS_NOW
        | TOKEN_TYPE := if NAME0 >= 0 and NAME0 < BUILTIN_TYPE_COUNT then NAME0
                      else if FORMAL_TYPE_HERE then -FORMAL_SLOT_HERE - 2
                      else if NAME_TYPE[NAME0] > 0 then NAME_TYPE[NAME0] - 1 else NAME_ALIAS[?][NAME0] - 1
        | IN_COPY_TYPES := STATE = P_COPY_TYPES
        | IN_START := STATE = P_START
        | IN_MODEL_NAME := STATE = P_MODEL_NAME
        | IN_MODEL_EQUAL := STATE = P_MODEL_EQUAL
        | IN_MODEL_OPEN := STATE = P_MODEL_OPEN
        | IN_MODEL_QUESTION := STATE = P_MODEL_QUESTION
        | IN_INPUTS := STATE = P_INPUTS
        | IN_MODEL_BANG := STATE = P_MODEL_BANG
        | IN_OUTPUTS := STATE = P_OUTPUTS
        | IN_MODEL_CLOSE := STATE = P_MODEL_CLOSE
        | IN_MODEL_BODY := STATE = P_MODEL_BODY
        | IN_MODEL_AFTER := STATE = P_MODEL_AFTER
        | IN_PROGRAM := STATE = P_PROGRAM
        | IN_END_SEMICOLON := STATE = P_END_SEMICOLON
        | IN_END_CHECK := STATE = P_END_CHECK
        | IN_TYPE_STATEMENT := STATE = P_TYPE_STATEMENT
        | IN_TYPE_SKIP := STATE = P_TYPE_SKIP
        | IN_TYPE := STATE = P_TYPE
        | IN_TYPE_SIZE := STATE = P_TYPE_SIZE
        | IN_TYPE_CLOSE := STATE = P_TYPE_CLOSE
        | IN_TYPE_NAME := STATE = P_TYPE_NAME
        | IN_TYPE_INTERN := STATE = P_TYPE_INTERN
        | IN_DECLARE_NAME := STATE = P_DECLARE_NAME
        | IN_DECLARE_SEPARATOR := STATE = P_DECLARE_SEPARATOR
        | IN_CONSTANT_NAME := STATE = P_CONSTANT_NAME
        | IN_CONSTANT_EQUAL := STATE = P_CONSTANT_EQUAL
        | IN_CONSTANT_DEFINITION := STATE = P_CONSTANT_DEFINITION
        | IN_INTEGER_CONSTANT := STATE = P_INTEGER_CONSTANT
        | IN_CONSTANT_ELEMENT := STATE = P_CONSTANT_ELEMENT
        | IN_CONSTANT_SCALAR := STATE = P_CONSTANT_SCALAR
        | IN_CONSTANT_SEPARATOR := STATE = P_CONSTANT_SEPARATOR
        | IN_LABEL_NAME := STATE = P_LABEL_NAME
        | IN_LABEL_SEPARATOR := STATE = P_LABEL_SEPARATOR
        | IN_REF_NAME := STATE = P_REF_NAME
        | IN_REF_SEPARATOR := STATE = P_REF_SEPARATOR
        | IN_PROCESS := STATE = P_PROCESS
        | IN_PATH_COPY := STATE = P_PATH_COPY
        | IN_GUARD_COLONS := STATE = P_GUARD_COLONS
        | IN_ITERATE_NAME := STATE = P_ITERATE_NAME
        | IN_ITERATE_OF := STATE = P_ITERATE_OF
        | IN_EQUATION := STATE = P_EQUATION
        | IN_DEPENDENCE := STATE = P_DEPENDENCE
        | IN_EQUATION_END := STATE = P_EQUATION_END
        | IN_GROUP_MEMBER := STATE = P_GROUP_MEMBER
        | IN_POP := STATE = P_POP
        | IN_MODEL_COPY := STATE = P_MODEL_COPY
        | IN_PARAMETER_MODEL := STATE = P_PARAMETER_MODEL
        | IN_PARAMETER_MODEL_NAME := STATE = P_PARAMETER_MODEL_NAME
        | MODEL_SAFE := if MODEL_NOW >= 0 then MODEL_NOW else 0
        | TYPE_NOW := MODEL_NOW >= 0 and MODEL_IS_TYPE[?][MODEL_SAFE]
        | MODEL_TYPE_STATEMENT := IN_TYPE_STATEMENT and MODEL_CLASS[CODE0] = 1
        | NAMED_MODEL := if CODE0 = C_NAME then NAME_MODEL_SLOT[?][NAME0] - 1 else -1
        | NAMES_MODEL_TYPE := NAMED_MODEL >= 0 and MODEL_IS_TYPE[?][if NAMED_MODEL >= 0 then NAMED_MODEL else 0]
                              and MODEL_CLOSED[?][if NAMED_MODEL >= 0 then NAMED_MODEL else 0]
        | OPENS_COPY := IN_MODEL_OPEN and NAMES_MODEL_TYPE
        | COPY_ENDS := IN_MODEL_COPY and not INTERFACE_COPY_LIVE
        | APPENDS_MODEL_FORMAL := IN_PARAMETER_MODEL_NAME and CODE0 = C_NAME and not DECLARED
        | IN_MODULE_NAME := STATE = P_MODULE_NAME
        | IN_MODULE_EQUAL := STATE = P_MODULE_EQUAL
        | IN_MODULE_END := STATE = P_MODULE_END
        | IN_USE_NAME := STATE = P_USE_NAME
        | IN_USE_SEPARATOR := STATE = P_USE_SEPARATOR
        | MODULE_DECLARATION_WORD := MODEL_CLASS[CODE0] = 1 or CODE0 = C_END or CODE0 = C_TYPE or CODE0 = C_CONSTANT
                                     or CODE0 = C_USE or CODE0 = C_PRIVATE
        | MODULE_NAME_CLASHES := NAME_MODULE[?][NAME0] > 0 or MODEL_NAME_CLASHES
        | MODULE_NOW := MODULE_COUNT[?] - 1
        | VISIBILITY_NOW := if IN_MODULE[?] then 2 * (MODULE_NOW + 1) + integer(PRIVATE_DECLARATION) else 0
        | IN_OPERAND := STATE = P_OPERAND
        | IN_PARAMETER := STATE = P_PARAMETER
        | IN_PARAMETER_CLOSE := STATE = P_PARAMETER_CLOSE
        | IN_OPERATOR := STATE = P_OPERATOR
        | IN_BRANCH := STATE = P_BRANCH
        | IN_PRAGMA_NAME := STATE = P_PRAGMA_NAME
        | IN_PRAGMA_OPEN := STATE = P_PRAGMA_OPEN
        | IN_PRAGMA_OBJECT := STATE = P_PRAGMA_OBJECT
        | IN_PRAGMA_CLOSE := STATE = P_PRAGMA_CLOSE
        | IN_PRAGMA_STATEMENT := STATE = P_PRAGMA_STATEMENT
        | IN_PRAGMA_OTHER := STATE = P_PRAGMA_OTHER
        | IN_PRAGMA_SKIP := STATE = P_PRAGMA_SKIP
        | IN_PRAGMA_TEXT := STATE = P_PRAGMA_TEXT
        | IN_SET_NAME := STATE = P_SET_NAME
        | IN_SET_SEPARATOR := STATE = P_SET_SEPARATOR
        | IN_SET_EMIT := STATE = P_SET_EMIT
        | IN_ALIAS_END := STATE = P_ALIAS_END
        | IN_HIDE_NAME := STATE = P_HIDE_NAME
        | IN_HIDE_SEPARATOR := STATE = P_HIDE_SEPARATOR
        | IN_DECLARE_INIT := STATE = P_DECLARE_INIT
        | IN_TUPLE_NAME := STATE = P_TUPLE_NAME
        | IN_TUPLE_SEPARATOR := STATE = P_TUPLE_SEPARATOR
        | IN_TUPLE_SKIP := STATE = P_TUPLE_SKIP
        | IN_TUPLE_SEEK := STATE = P_TUPLE_SEEK
        | IN_TUPLE_EMIT := STATE = P_TUPLE_EMIT
        | IN_SYNC := STATE = P_SYNC
        | IN_REPEAT_START := STATE = P_REPEAT_START
        | IN_INDEX_EMIT := STATE = P_INDEX_EMIT
        | IN_REPEAT_EMIT := STATE = P_REPEAT_EMIT
        | IN_ARRAY_TO := STATE = P_ARRAY_TO
        | IN_SEQ_HEAD := STATE = P_SEQ_HEAD
        | IN_SEQ_EMIT := STATE = P_SEQ_EMIT
        | IN_CONSTANT_END := STATE = P_CONSTANT_END
        | IN_INIT_END := STATE = P_INIT_END
        | IN_PARAMETER_OPEN := STATE = P_PARAMETER_OPEN
        | IN_PARAMETER_DECL := STATE = P_PARAMETER_DECL
        | IN_PARAMETER_END := STATE = P_PARAMETER_END
        | MODEL_FORMALS_OPENS := IN_MODEL_OPEN and CODE0 = C_OPEN_BRACE and integer(TOKEN_CODE[HERE - 1]) = C_EQUAL
        | CONSTANT_CLOSE_OK := ENTRY_COUNT[?] - EXPRESSION_START[?] = 1 and ENTRY_OP[?][EXPRESSION_START[?]] = OP_CONST
        | IN_INDEX_TYPE := STATE = P_INDEX_TYPE
        | IN_DELAY_ELEMENT := STATE = P_DELAY_ELEMENT
        | IN_DELAY_LIST_SIZE := STATE = P_DELAY_LIST_SIZE
        | IN_DELAY_LIST_END := STATE = P_DELAY_LIST_END
        | IN_INDEX_DECLARE := STATE = P_INDEX_DECLARE
        | IN_STATE_SIGNAL := STATE = P_STATE_SIGNAL
        | IN_STATE_CALL := STATE = P_STATE_CALL
        | IN_STATE_WHEN := STATE = P_STATE_WHEN
        | IN_STATE_GUARD := STATE = P_STATE_GUARD
        | IN_CASE_IN := STATE = P_CASE_IN
        | IN_CASE_BRANCH := STATE = P_CASE_BRANCH
        | IN_CASE_COPY := STATE = P_CASE_COPY
        | IN_CASE_LITERAL := STATE = P_CASE_LITERAL
        | IN_CASE_SCAN := STATE = P_CASE_SCAN
        | IN_CASE_ELSE_VALUE := STATE = P_CASE_ELSE_VALUE
        | IN_CASE_COMPARE := STATE = P_CASE_COMPARE
        | IN_CASE_JOIN := STATE = P_CASE_JOIN
        | IN_CASE_SEPARATOR := STATE = P_CASE_SEPARATOR
        | IN_CASE_WHEN := STATE = P_CASE_WHEN
        | IN_CASE_GUARD := STATE = P_CASE_GUARD
        | PRAGMAS_HERE := IN_MODEL_BODY and CODE0 = C_NAME and NAME0 = N_PRAGMAS
        | PRAGMAS_OPEN := PRAGMAS_HERE and integer(TOKEN_CODE[HERE - 1]) = C_CLOSE
        | PRAGMAS_STARTED := PRAGMA_ITEMS[?] > 0
        | PRAGMAS_CLOSE := IN_PRAGMA_NAME and PRAGMAS_STARTED and CODE0 = C_END and CODE1 = C_NAME and NAME1 = N_PRAGMAS
        | PRAGMA_KNOWN := CODE0 = C_NAME and (NAME0 = N_INTERRUPT or NAME0 = N_BOOT or NAME0 = N_MACHINE)
        | PRAGMA_KIND := if IN_PRAGMA_NAME then NAME0 else PRAGMA_KIND[?]
        | PRAGMA_NAME_HELD := if IN_PRAGMA_OBJECT then NAME0 else PRAGMA_NAME_HELD[?]
        | PRAGMA_TOKEN_HELD := if IN_PRAGMA_OBJECT then HERE else PRAGMA_TOKEN_HELD[?]
        | INTERRUPT_HIGH := integer(SRC[TOKEN_START[HERE] + 1]) - 48
        | INTERRUPT_LOW := integer(SRC[TOKEN_START[HERE] + 2]) - 48
        | INTERRUPT_VALUE := 10 * INTERRUPT_HIGH + INTERRUPT_LOW
        | INTERRUPT_OK := TOKEN_LENGTH[HERE] = 4 and INTERRUPT_HIGH >= 0 and INTERRUPT_HIGH <= 9 and INTERRUPT_LOW >= 0
                          and INTERRUPT_LOW <= 9
        | INTERRUPT_BIT := if INTERRUPT_OK and INTERRUPT_VALUE < 64 then ulong(1) shl INTERRUPT_VALUE else ulong(0)
        | MACHINE_AT := TOKEN_START[HERE] + 1
        | MACHINE_OK := CODE0 = C_STRING and TOKEN_LENGTH[HERE] = MACHINE_TEXT_LENGTH + 2
                        and SRC[MACHINE_AT] = MACHINE_TEXT[0] and SRC[MACHINE_AT + 1] = MACHINE_TEXT[1]
                        and SRC[MACHINE_AT + 2] = MACHINE_TEXT[2] and SRC[MACHINE_AT + 3] = MACHINE_TEXT[3]
                        and SRC[MACHINE_AT + 4] = MACHINE_TEXT[4] and SRC[MACHINE_AT + 5] = MACHINE_TEXT[5]
                        and SRC[MACHINE_AT + 6] = MACHINE_TEXT[6] and SRC[MACHINE_AT + 7] = MACHINE_TEXT[7]
                        and SRC[MACHINE_AT + 8] = MACHINE_TEXT[8] and SRC[MACHINE_AT + 9] = MACHINE_TEXT[9]
        | MACHINE_STATEMENT := IN_PRAGMA_STATEMENT and PRAGMA_KIND = N_MACHINE
        | PRAGMA_MESSAGE_HERE := if IN_PRAGMA_NAME then
                                   (if PRAGMAS_CLOSE then 0
                                    else if PRAGMA_KNOWN then
                                      (if MODEL_NOW /= ROOT_MODEL[?] then T_PRAGMA_TOP_ONLY
                                       else if NAME0 = N_BOOT and PRAGMA_HAS_BOOT[?] then T_BOOT_TWICE
                                       else if NAME0 = N_MACHINE and MACHINE_TOKEN[?] >= 0 then T_MACHINE_TWICE else 0)
                                    else if CODE0 = C_NAME then 0
                                    else if PRAGMAS_STARTED then T_PRAGMAS_END else T_EXPECTED_NAME)
                                 else if IN_PRAGMA_SKIP then (if CODE0 = C_EOF then T_EXPECTED_FOUND else 0)
                                 else if IN_PRAGMA_OPEN then (if CODE0 /= C_OPEN_BRACE then T_EXPECTED_FOUND else 0)
                                 else if IN_PRAGMA_OBJECT then (if CODE0 /= C_NAME then T_EXPECTED_NAME else 0)
                                 else if IN_PRAGMA_CLOSE then (if CODE0 /= C_CLOSE_BRACE then T_EXPECTED_FOUND else 0)
                                 else if MACHINE_STATEMENT then (if MACHINE_OK then 0 else T_MACHINE_UNKNOWN)
                                 else if IN_PRAGMA_STATEMENT then
                                   (if CODE0 /= C_STRING then T_INTERRUPT_STATEMENT
                                    else if not INTERRUPT_OK then (if MACHINE_TOKEN[?] >= 0 then T_INTERRUPT_NUMBER_MPS2 else T_INTERRUPT_NUMBER)
                                    else if (PRAGMA_USED[?] and INTERRUPT_BIT) /= ulong(0) then T_INTERRUPT_TWICE else 0)
                                 else 0
        | COPIED_TYPE := TYPE_COUNT[?]
        | COPIED_USER := COPIED_TYPE - BUILTIN_TYPE_COUNT
        | COPY_IS_BUILTIN := COPIED_TYPE < BUILTIN_TYPE_COUNT
        | COPY_DONE := COPIED_TYPE + 1 >= BUILTIN_TYPE_COUNT + USER_TYPE_COUNT
        | MODEL_NAME_OK := CODE0 = C_NAME
        | MODEL_NAME_CLASHES := NAME_MODEL[?][NAME0] or GLOBALLY_USED or NAME_CONSTANT[?][NAME0] > 0 or NAME_TYPE[NAME0] > 0
                                or NAME_MODULE[?][NAME0] > 0
                                or NAME_ALIAS[?][NAME0] > 0 or NAME0 >= N_LOAD and NAME0 <= N_LEFT_TT
        | CREATES_MODEL := IN_MODEL_NAME and MODEL_NAME_OK and not MODEL_NAME_CLASHES
        | MODEL_KIND_NOW := MODEL_KIND[?][MODEL_NOW]
        | CLOSES_MODEL := (IN_MODEL_AFTER and CODE0 /= C_WHERE or IN_END_SEMICOLON) and CODE0 = C_SEMICOLON
        | MAKES_STATE_TYPE := CLOSES_MODEL and MODEL_KIND_NOW = C_AUTOMATON
        | INTERFACE_NOW := SIGNAL_COUNT[?] - MODEL_SIGNAL_START[?][MODEL_NOW]
        | NEEDS_OUTPUT := (MODEL_KIND_NOW = C_NODE or MODEL_KIND_NOW = C_FUNCTION) and INTERFACE_NOW = MODEL_INPUTS[?][MODEL_NOW]
        | IS_FUNCTION := MODEL_KIND_NOW = C_FUNCTION
        | IS_SAFE := MODEL_ATTRIBUTE[?][MODEL_NOW] = ATTRIBUTE_SAFE
        | ATTRIBUTE_WORD := ATTRIBUTE_OF_CODE[CODE0] - 1
        | IS_ATTRIBUTE_HERE := IN_MODEL_BODY and ATTRIBUTE_WORD >= 0 and ATTRIBUTE_OF_CODE[integer(TOKEN_CODE[HERE - 1])] = 0
        | ATTRIBUTE_CLASS_FAILS := MODEL_KIND_NOW = C_FUNCTION and ATTRIBUTE_WORD /= ATTRIBUTE_SAFE
                                   or MODEL_KIND_NOW = C_NODE and ATTRIBUTE_WORD = ATTRIBUTE_UNSAFE
                                   or MODEL_KIND_NOW = C_AUTOMATON and ATTRIBUTE_WORD /= ATTRIBUTE_DETERMINISTIC
        | SPEC_OPENS := IN_MODEL_BODY and not PRAGMAS_OPEN and CODE0 = C_NAME and NAME0 = N_SPEC and CODE1 = C_OPEN_BAR
        | SPEC_JOINS := IN_POP and SPEC_PENDING[?] and FRAME_DEPTH[?] = 1 and FRAME_TOP_KIND = FRAME_COMPOSE and CODE0 = C_BAR_CLOSE
                        and CODE1 = C_OPEN_BAR
        | SPEC_UNJOINED := IN_POP and SPEC_PENDING[?] and FRAME_DEPTH[?] = 1 and FRAME_TOP_KIND = FRAME_COMPOSE and CODE0 = C_BAR_CLOSE
                           and CODE1 /= C_OPEN_BAR
        | SPEC_PENDING := if SPEC_OPENS then true else if SPEC_JOINS or IN_START then false else SPEC_PENDING[?]
        | BODY_CLOSING := IN_POP and FRAME_DEPTH[?] = 1 and FRAME_TOP_KIND = FRAME_COMPOSE and CODE0 = C_BAR_CLOSE and not SPEC_JOINS
        | SYNC_PENDING := BODY_CLOSING and IS_FUNCTION and not SYNC_DONE[?] and INTERFACE_NOW >= 2
        | SYNC_LAST := SYNC_I[?] + 1 >= INTERFACE_NOW
        | SYNC_I := if IN_SYNC and not SYNC_LAST then SYNC_I[?] + 1 else 0
        | SYNC_DONE := if CREATES_MODEL then false else if IN_SYNC and SYNC_LAST then true else SYNC_DONE[?]
        | PARENT_NOW := MODEL_PARENT[?][MODEL_NOW]
        | ALIAS_STATEMENT := CODE2 /= C_EXTERNAL and CODE2 /= C_ENUM
        | TYPE_STATEMENT_CLASHES := GLOBALLY_USED or NAME_CONSTANT[?][NAME0] > 0 or NAME_MODEL[?][NAME0] or NAME_MODULE[?][NAME0] > 0
                                    or NAME_ALIAS[?][NAME0] > 0 or ALIAS_STATEMENT and NAME_TYPE[NAME0] > 0
        | SIZE_IS_NUMBER := CODE0 = C_NUMBER
        | SIZE_CONSTANT := NAME_CONSTANT[?][NAME0] - 1
        | SIZE_CONSTANT_TYPE := CONSTANT_TYPE[?][SIZE_CONSTANT]
        | SIZE_IS_CONSTANT := CODE0 = C_NAME and SIZE_CONSTANT >= 0 and TYPE_KIND[?][SIZE_CONSTANT_TYPE] = TK_INT
        | SIZE_VALUE := if SIZE_IS_NUMBER then TOKEN_VALUE[HERE] else CONSTANT_VALUE[?][SIZE_CONSTANT]
        | SIZE_POSITIVE := if SIZE_IS_CONSTANT and SIZE_CONSTANT_TYPE = BUILTIN_ULONG then SIZE_VALUE /= long(0) else SIZE_VALUE > long(0)
        | SIZE_MESSAGE := if SIZE_IS_NUMBER then (if TOKEN_BIG[HERE] then T_LITERAL_BIG else 0)
                          else if SIZE_IS_CONSTANT then 0
                          else if CODE0 = C_NAME and not DECLARED then T_CONSTANT_UNDECLARED
                          else T_EXPECTED_INTEGER_CONSTANT
        | INTERN_CANDIDATE := CANDIDATE[?]
        | INTERN_MATCHES := INTERN_CANDIDATE >= 0 and TYPE_SIZE[?][INTERN_CANDIDATE] = ARRAY_SIZE[?]
                            and TYPE_ELEMENT[?][INTERN_CANDIDATE] = ARRAY_ELEMENT[?] and TYPE_KIND[?][INTERN_CANDIDATE] = TK_ARRAY
        | ELEMENT_TYPE := TOKEN_TYPE
        | NE_SAFE := if TOKEN_TYPE >= 0 then TOKEN_TYPE else 0
        | NE_A1 := TOKEN_TYPE >= 0 and TYPE_KIND[?][NE_SAFE] = TK_ARRAY
        | NE_E1 := TYPE_ELEMENT[?][NE_SAFE]
        | NE_A2 := NE_A1 and TYPE_KIND[?][NE_E1] = TK_ARRAY
        | NE_E2 := TYPE_ELEMENT[?][NE_E1]
        | NE_A3 := NE_A2 and TYPE_KIND[?][NE_E2] = TK_ARRAY
        | NE_E3 := TYPE_ELEMENT[?][NE_E2]
        | NE_A4 := NE_A3 and TYPE_KIND[?][NE_E3] = TK_ARRAY
        | NE_RANK := integer(NE_A1) + integer(NE_A2) + integer(NE_A3) + integer(NE_A4)
        | NE_TOTAL := (if NE_A1 then TYPE_SIZE[?][NE_SAFE] else ulong(1)) * (if NE_A2 then TYPE_SIZE[?][NE_E1] else ulong(1))
                      * (if NE_A3 then TYPE_SIZE[?][NE_E2] else ulong(1)) * (if NE_A4 then TYPE_SIZE[?][NE_E3] else ulong(1))
        | TOTAL_CAP := ulong(2147483648)
        | DIM0 := if SIZE_DEPTH[?] > 0 then SIZE_STACK[?][0] else ulong(1)
        | DIM1 := if SIZE_DEPTH[?] > 1 then SIZE_STACK[?][1] else ulong(1)
        | DIM2 := if SIZE_DEPTH[?] > 2 then SIZE_STACK[?][2] else ulong(1)
        | DIM3 := if SIZE_DEPTH[?] > 3 then SIZE_STACK[?][3] else ulong(1)
        | DIM_TOO_BIG := DIM0 >= TOTAL_CAP or DIM1 >= TOTAL_CAP or DIM2 >= TOTAL_CAP or DIM3 >= TOTAL_CAP
        | PRODUCT1 := DIM0 * NE_TOTAL
        | PRODUCT2 := (if PRODUCT1 >= TOTAL_CAP then TOTAL_CAP else PRODUCT1) * DIM1
        | PRODUCT3 := (if PRODUCT2 >= TOTAL_CAP then TOTAL_CAP else PRODUCT2) * DIM2
        | PRODUCT4 := (if PRODUCT3 >= TOTAL_CAP then TOTAL_CAP else PRODUCT3) * DIM3
        | NAME_RANK := SIZE_DEPTH[?] + NE_RANK
        | NAME_TOTAL_BIG := NAME_RANK >= 2 and (DIM_TOO_BIG or PRODUCT4 >= TOTAL_CAP)
        | BUCKET_HERE := integer((ulong(ELEMENT_TYPE) * ulong(40503) + ARRAY_SIZE[?] * ulong(2654435761)) modulo ulong(BUCKET_CAP))
        | DRAIN_BOUND := INDEX_ID_BOUND[?][DRAIN_ID]
        | DRAIN_BOUND_OP := integer(ENTRY_OP[?][DRAIN_BOUND])
        | DRAIN_CONSTANT := if DRAIN_BOUND_OP = OP_SIGNAL then NAME_CONSTANT[?][ENTRY_NAME[?][DRAIN_BOUND]] - 1 else -1
        | DRAIN_TYPE := if DRAIN_BOUND_OP = OP_CONST then ENTRY_TYPE[?][DRAIN_BOUND]
                        else if DRAIN_CONSTANT >= 0 then CONSTANT_TYPE[?][DRAIN_CONSTANT] else -1
        | DRAIN_LAST := if DRAIN_BOUND_OP = OP_CONST then ENTRY_VALUE[?][DRAIN_BOUND]
                        else if DRAIN_CONSTANT >= 0 then CONSTANT_VALUE[?][DRAIN_CONSTANT] else long(0)
        | DRAIN_SEQ := INDEX_ID_SEQ[?][DRAIN_ID]
        | DRAIN_FROM_AT := if DRAIN_SEQ then DRAIN_BOUND - 1 else DRAIN_BOUND
        | DRAIN_FROM_OP := integer(ENTRY_OP[?][DRAIN_FROM_AT])
        | DRAIN_FROM_CONSTANT := if DRAIN_FROM_OP = OP_SIGNAL then NAME_CONSTANT[?][ENTRY_NAME[?][DRAIN_FROM_AT]] - 1 else -1
        | DRAIN_FROM_TYPE := if DRAIN_FROM_OP = OP_CONST then ENTRY_TYPE[?][DRAIN_FROM_AT]
                             else if DRAIN_FROM_CONSTANT >= 0 then CONSTANT_TYPE[?][DRAIN_FROM_CONSTANT] else -1
        | DRAIN_FROM_VALUE := if DRAIN_FROM_OP = OP_CONST then ENTRY_VALUE[?][DRAIN_FROM_AT]
                              else if DRAIN_FROM_CONSTANT >= 0 then CONSTANT_VALUE[?][DRAIN_FROM_CONSTANT] else long(0)
        | DRAIN_STEPPED := DRAIN_SEQ and integer(ENTRY_OP[?][DRAIN_BOUND + 1]) = OP_SPAN
        | DRAIN_BY_AT := if DRAIN_STEPPED then DRAIN_BOUND + 2 else DRAIN_BOUND
        | DRAIN_BY_OP := integer(ENTRY_OP[?][DRAIN_BY_AT])
        | DRAIN_BY_CONSTANT := if DRAIN_BY_OP = OP_SIGNAL then NAME_CONSTANT[?][ENTRY_NAME[?][DRAIN_BY_AT]] - 1 else -1
        | DRAIN_BY_TYPE := if DRAIN_BY_OP = OP_CONST then ENTRY_TYPE[?][DRAIN_BY_AT]
                           else if DRAIN_BY_CONSTANT >= 0 then CONSTANT_TYPE[?][DRAIN_BY_CONSTANT] else -1
        | DRAIN_BY := if not DRAIN_STEPPED then long(1) else if DRAIN_BY_OP = OP_CONST then ENTRY_VALUE[?][DRAIN_BY_AT]
                      else if DRAIN_BY_CONSTANT >= 0 then CONSTANT_VALUE[?][DRAIN_BY_CONSTANT] else long(0)
        | DRAIN_SEQ_OK := DRAIN_FROM_TYPE >= 0 and TYPE_KIND[?][if DRAIN_FROM_TYPE >= 0 then DRAIN_FROM_TYPE else 0] = TK_INT
                          and (not DRAIN_STEPPED or DRAIN_BY_TYPE >= 0 and TYPE_KIND[?][if DRAIN_BY_TYPE >= 0 then DRAIN_BY_TYPE else 0] = TK_INT)
                          and DRAIN_BY >= long(1) and DRAIN_LAST >= DRAIN_FROM_VALUE
        | DRAIN_VALUE := if not DRAIN_SEQ then DRAIN_LAST else if DRAIN_BY >= long(1) then (DRAIN_LAST - DRAIN_FROM_VALUE) / DRAIN_BY + long(1)
                         else long(0)
        | DRAIN_OK := INDEX_ID_BOUND_END[?][DRAIN_ID] - DRAIN_BOUND = 1 and DRAIN_TYPE >= 0
                      and TYPE_KIND[?][if DRAIN_TYPE >= 0 then DRAIN_TYPE else 0] = TK_INT and DRAIN_VALUE >= long(1)
                      and (not DRAIN_SEQ or DRAIN_SEQ_OK)
        | DRAIN_SIZE := ulong(DRAIN_VALUE + long(integer(DRAIN_ARRAY)))
        | DRAIN_BUCKET := integer((ulong(BUILTIN_INTEGER) * ulong(40503) + DRAIN_SIZE * ulong(2654435761)) modulo ulong(BUCKET_CAP))
        | CREATES_ARRAY_TYPE := IN_TYPE_INTERN and INTERN_CANDIDATE < 0
        | SIZE_CONTINUES_BRACKET := CODE0 = C_CLOSE_BRACKET and CODE1 = C_OPEN_BRACKET
        | LEVEL_FINISHED := IN_TYPE_INTERN and (INTERN_CANDIDATE < 0 or INTERN_MATCHES)
        | OUTER_LEVEL := LEVEL_FINISHED and SIZE_DEPTH[?] > 1
        | OUTER_SIZE := SIZE_STACK[?][if OUTER_LEVEL then SIZE_DEPTH[?] - 2 else 0]
        | TYPE_FINISHED := IN_TYPE_NAME and ARRAY_SIZE[?] = ulong(0) or LEVEL_FINISHED and not OUTER_LEVEL
        | FINISHED_TYPE := if IN_TYPE_NAME then TOKEN_TYPE else if INTERN_CANDIDATE < 0 then TYPE_COUNT[?] else INTERN_CANDIDATE
        | OUTER_BUCKET := integer((ulong(FINISHED_TYPE) * ulong(40503) + OUTER_SIZE * ulong(2654435761)) modulo ulong(BUCKET_CAP))
        | DECLARED_TYPE := PARSED_TYPE[?]
        | DECLARED_SAFE := if DECLARED_TYPE >= 0 then DECLARED_TYPE else 0
        | DECLARED_KIND := TYPE_KIND[?][DECLARED_SAFE]
        | DECLARED_ARRAY := DECLARED_KIND = TK_ARRAY
        | DECLARED_ELEMENT := TYPE_ELEMENT[?][DECLARED_SAFE]
        | DECLARED_BASE := if DECLARED_ARRAY then DECLARED_ELEMENT else DECLARED_SAFE
        | DECLARED_SIZE := TYPE_SIZE[?][DECLARED_SAFE]
        | DECLARED_INNER1 := if DECLARED_ARRAY then DECLARED_ELEMENT else 0
        | DECLARED_RANK2 := DECLARED_ARRAY and TYPE_KIND[?][DECLARED_INNER1] = TK_ARRAY
        | DECLARED_INNER2 := if DECLARED_RANK2 then TYPE_ELEMENT[?][DECLARED_INNER1] else 0
        | DECLARED_RANK3 := DECLARED_RANK2 and TYPE_KIND[?][DECLARED_INNER2] = TK_ARRAY
        | DECLARED_INNER3 := if DECLARED_RANK3 then TYPE_ELEMENT[?][DECLARED_INNER2] else 0
        | DECLARED_RANK4 := DECLARED_RANK3 and TYPE_KIND[?][DECLARED_INNER3] = TK_ARRAY
        | DECLARED_LEAF := if DECLARED_RANK4 then TYPE_ELEMENT[?][DECLARED_INNER3] else if DECLARED_RANK3 then DECLARED_INNER3
                           else if DECLARED_RANK2 then DECLARED_INNER2 else DECLARED_ELEMENT
        | DECLARED_GROUP4 := if DECLARED_RANK4 then TYPE_SIZE[?][DECLARED_INNER3] else ulong(1)
        | DECLARED_GROUP3 := if DECLARED_RANK3 then TYPE_SIZE[?][DECLARED_INNER2] * DECLARED_GROUP4 else ulong(1)
        | DECLARED_GROUP2 := if DECLARED_RANK2 then TYPE_SIZE[?][DECLARED_INNER1] * DECLARED_GROUP3 else ulong(1)
        | DECLARED_TOTAL := DECLARED_SIZE * DECLARED_GROUP2
        | DECLARED_INNER_LEVELS := integer(DECLARED_RANK2) + integer(DECLARED_RANK3) + integer(DECLARED_RANK4)
        | DECLARE_MESSAGE := if CODE0 /= C_NAME then T_EXPECTED_NAME else if DECLARED then CLASH_MESSAGE
                             else if FORMALS_NOW and DECLARED_ARRAY then T_ARRAYS_TO_MODELS
                             else if ROLE[?] /= ROLE_LOCAL and MODEL_NOW = ROOT_MODEL[?] and DECLARED_BASE = BUILTIN_STRING then T_STRING_INTERFACE
                             else if TYPE_KIND[?][DECLARED_BASE] = TK_EXTERNAL then T_EXTERNAL_SIGNAL
                             else 0
        | APPENDS_SIGNAL := IN_DECLARE_NAME and DECLARE_MESSAGE = 0 and not FORMALS_NOW
        | APPENDS_TYPE_FORMAL := IN_PARAMETER_DECL and CODE0 = C_NAME and not DECLARED
        | REF_PLACED_FAILS := MODEL_NOW < 0 or MODEL_COUNT[?] > MODEL_NOW + 1
        | APPENDS_REF := IN_REF_NAME and CODE0 = C_NAME and not DECLARED and not REF_PLACED_FAILS
        | APPENDS_PARAMETER := IN_DECLARE_NAME and DECLARE_MESSAGE = 0 and FORMALS_NOW or APPENDS_TYPE_FORMAL or APPENDS_MODEL_FORMAL
                               or APPENDS_REF
        | INDEX_DECLARE_MESSAGE := if DRAIN_ARRAY and DECLARED then CLASH_MESSAGE else 0
        | APPENDS_INDEX_SIGNAL := IN_INDEX_DECLARE and DRAIN_ARRAY and INDEX_DECLARE_MESSAGE = 0
        | APPENDS_LABEL := IN_LABEL_NAME and CODE0 = C_NAME and not DECLARED
        | PUSHES_LOCAL := APPENDS_SIGNAL or APPENDS_LABEL or APPENDS_PARAMETER or INTERFACE_COPY_LIVE
        | CONSTANT_NAME_MESSAGE := if CODE0 /= C_NAME then T_EXPECTED_NAME
                                   else if DECLARED or GLOBALLY_USED then CLASH_MESSAGE else 0
        | DEFINITION_IS_STRING := CODE0 = C_STRING
        | STRING_BYTES := TOKEN_TEXT[HERE + 1] - TOKEN_TEXT[HERE]
        | DEFINITION_MESSAGE := if DEFINITION_IS_STRING then
                                  (if DECLARED_TYPE = BUILTIN_STRING then (if STRING_BYTES > STRING_LENGTH_AT then T_STRING_LONG else 0)
                                   else if not DECLARED_ARRAY or DECLARED_ELEMENT /= BUILTIN_UBYTE then T_CONSTANT_STRING
                                   else if ulong(STRING_BYTES) /= DECLARED_SIZE then T_CONSTANT_COUNT else 0)
                                else if CODE0 = C_OPEN_BRACKET and not DECLARED_ARRAY then T_CONSTANT_LIST
                                else if CODE0 = C_OPEN_BRACKET and not LIST_OPENS_OK then T_CONSTANT_SHAPE
                                else 0
        | LIST_OPENS_OK := (not DECLARED_RANK2 or CODE1 = C_OPEN_BRACKET) and (not DECLARED_RANK3 or CODE2 = C_OPEN_BRACKET)
                           and (not DECLARED_RANK4 or CODE3 = C_OPEN_BRACKET)
        | CONVERTS := CODE1 = C_OPEN and CODE0 /= C_MINUS
        | CONVERSION_OK := TOKEN_TYPE >= 0 and TYPE_KIND[?][TOKEN_TYPE] = TK_INT
        | SIGN_AT := HERE + 2 * integer(CONVERTS)
        | NEGATES := integer(TOKEN_CODE[SIGN_AT]) = C_MINUS
        | NUMBER_AT := SIGN_AT + integer(NEGATES)
        | CONSTANT_LITERAL := TOKEN_VALUE[NUMBER_AT]
        | CONSTANT_LITERAL_TYPE := if TOKEN_KIND[NUMBER_AT] = ubyte(KIND_CHARACTER) then BUILTIN_CHAR
                                   else if TOKEN_KIND[NUMBER_AT] = ubyte(KIND_REAL) then BUILTIN_REAL
                                   else if TOKEN_KIND[NUMBER_AT] = ubyte(KIND_DREAL) then BUILTIN_DREAL
                                   else if CONSTANT_LITERAL < long(32768) then BUILTIN_SHORT
                                   else if CONSTANT_LITERAL < long(2147483648) then BUILTIN_INTEGER else BUILTIN_LONG
        | CONSTANT_REAL := integer(TOKEN_CODE[NUMBER_AT]) = C_REAL
        | SIGNED_LITERAL := if not NEGATES then CONSTANT_LITERAL
                            else if CONSTANT_REAL then
                              long(ulong(CONSTANT_LITERAL) xor (ulong(1) shl (if TOKEN_KIND[NUMBER_AT] = ubyte(KIND_REAL) then 31 else 63)))
                            else -CONSTANT_LITERAL
        | ELEMENT_PAIRS := IN_INTEGER_CONSTANT and not CONVERTS and integer(TOKEN_CODE[NUMBER_AT + 1]) = C_AT
        | NEGATES2 := integer(TOKEN_CODE[NUMBER_AT + 2]) = C_MINUS
        | NUMBER2_AT := NUMBER_AT + 2 + integer(NEGATES2)
        | CONSTANT_LITERAL2 := TOKEN_VALUE[NUMBER2_AT]
        | CONSTANT_REAL2 := integer(TOKEN_CODE[NUMBER2_AT]) = C_REAL
        | LITERAL2_TYPE := if TOKEN_KIND[NUMBER2_AT] = ubyte(KIND_CHARACTER) then BUILTIN_CHAR
                           else if TOKEN_KIND[NUMBER2_AT] = ubyte(KIND_REAL) then BUILTIN_REAL
                           else if TOKEN_KIND[NUMBER2_AT] = ubyte(KIND_DREAL) then BUILTIN_DREAL
                           else if CONSTANT_LITERAL2 < long(32768) then BUILTIN_SHORT
                           else if CONSTANT_LITERAL2 < long(2147483648) then BUILTIN_INTEGER else BUILTIN_LONG
        | SIGNED_LITERAL2 := if not NEGATES2 then CONSTANT_LITERAL2
                             else if CONSTANT_REAL2 then
                               long(ulong(CONSTANT_LITERAL2) xor (ulong(1) shl (if TOKEN_KIND[NUMBER2_AT] = ubyte(KIND_REAL) then 31 else 63)))
                             else -CONSTANT_LITERAL2
        | PAIR_TYPE := if not CONSTANT_REAL then CONSTANT_LITERAL_TYPE else if not CONSTANT_REAL2 then LITERAL2_TYPE
                       else if CONSTANT_LITERAL_TYPE = BUILTIN_REAL and LITERAL2_TYPE = BUILTIN_REAL then BUILTIN_COMPLEX else BUILTIN_DCOMPLEX
        | TARGET_BYTES := BUILTIN_BYTES[TOKEN_TYPE]
        | TARGET_MASK := if TARGET_BYTES = 1 then ulong(255) else if TARGET_BYTES = 2 then ulong(65535) else ulong(4294967295)
        | MASKED := long(ulong(SIGNED_LITERAL) and TARGET_MASK)
        | HALF_RANGE := long(TARGET_MASK / ulong(2)) + long(1)
        | WRAPPED := if TARGET_BYTES = 8 then SIGNED_LITERAL
                     else if BUILTIN_SIGNED[TOKEN_TYPE] = 1 and MASKED >= HALF_RANGE then MASKED - long(TARGET_MASK) - long(1)
                     else MASKED
        | INTEGER_CONSTANT_MESSAGE := if CONVERTS and not CONVERSION_OK then T_CONVERSION
                                      else if integer(TOKEN_CODE[NUMBER_AT]) /= C_NUMBER and not (CONSTANT_REAL and not CONVERTS) then T_CONSTANT_LITERAL
                                      else if TOKEN_BIG[NUMBER_AT] then (if CONSTANT_REAL then T_REAL_BIG else T_LITERAL_BIG)
                                      else if ELEMENT_PAIRS and integer(TOKEN_CODE[NUMBER2_AT]) /= C_NUMBER and not CONSTANT_REAL2 then T_CONSTANT_LITERAL
                                      else if ELEMENT_PAIRS and TOKEN_BIG[NUMBER2_AT] then (if CONSTANT_REAL2 then T_REAL_BIG else T_LITERAL_BIG)
                                      else if CONVERTS and integer(TOKEN_CODE[NUMBER_AT + 1]) /= C_CLOSE then T_EXPECTED_FOUND
                                      else 0
        | INTEGER_CONSTANT_TOKEN := if CONVERTS and not CONVERSION_OK then HERE
                                    else if INTEGER_CONSTANT_MESSAGE = T_EXPECTED_FOUND then NUMBER_AT + 1
                                    else if ELEMENT_PAIRS and INTEGER_CONSTANT_MESSAGE /= 0 and not TOKEN_BIG[NUMBER_AT] then NUMBER2_AT else NUMBER_AT
        | VALUE_TYPE := CONSTANT_VALUE_TYPE[?]
        | SUBTYPE_TARGET := if IN_CONSTANT_ELEMENT then DECLARED_LEAF else DECLARED_TYPE
        | IS_SUBTYPE := VALUE_TYPE = SUBTYPE_TARGET or VALUE_TYPE = BUILTIN_REAL and SUBTYPE_TARGET = BUILTIN_DREAL
                        or VALUE_TYPE = BUILTIN_COMPLEX and SUBTYPE_TARGET = BUILTIN_DCOMPLEX
                        or TYPE_KIND[?][SUBTYPE_TARGET] = TK_INT and TYPE_KIND[?][VALUE_TYPE] = TK_INT
                           and (BUILTIN_SIGNED[VALUE_TYPE] = BUILTIN_SIGNED[SUBTYPE_TARGET]
                                and BUILTIN_BYTES[VALUE_TYPE] <= BUILTIN_BYTES[SUBTYPE_TARGET]
                                or BUILTIN_SIGNED[VALUE_TYPE] = 0 and BUILTIN_SIGNED[SUBTYPE_TARGET] = 1
                                   and BUILTIN_BYTES[SUBTYPE_TARGET] > BUILTIN_BYTES[VALUE_TYPE])
        | ELEMENT_COUNT := LIST_COUNT[?] + 1
        | ELEMENT_CLOSES := integer(DECLARED_RANK2 and ulong(ELEMENT_COUNT) modulo DECLARED_GROUP2 = ulong(0))
                            + integer(DECLARED_RANK3 and ulong(ELEMENT_COUNT) modulo DECLARED_GROUP3 = ulong(0))
                            + integer(DECLARED_RANK4 and ulong(ELEMENT_COUNT) modulo DECLARED_GROUP4 = ulong(0))
        | ELEMENT_SEPARATOR := integer(TOKEN_CODE[HERE + ELEMENT_CLOSES])
        | ELEMENT_CLOSES_OK := (ELEMENT_CLOSES < 1 or CODE0 = C_CLOSE_BRACKET) and (ELEMENT_CLOSES < 2 or CODE1 = C_CLOSE_BRACKET)
                               and (ELEMENT_CLOSES < 3 or CODE2 = C_CLOSE_BRACKET)
        | ELEMENT_OPENS_OK := (ELEMENT_CLOSES < 1 or integer(TOKEN_CODE[HERE + ELEMENT_CLOSES + 1]) = C_OPEN_BRACKET)
                              and (ELEMENT_CLOSES < 2 or integer(TOKEN_CODE[HERE + ELEMENT_CLOSES + 2]) = C_OPEN_BRACKET)
                              and (ELEMENT_CLOSES < 3 or integer(TOKEN_CODE[HERE + ELEMENT_CLOSES + 3]) = C_OPEN_BRACKET)
        | ELEMENT_MESSAGE := if not IS_SUBTYPE then T_CONSTANT_ELEMENT
                             else if DECLARED_RANK2 then
                               (if not ELEMENT_CLOSES_OK then T_CONSTANT_SHAPE
                                else if ELEMENT_SEPARATOR = C_COMMA then
                                  (if ELEMENT_OPENS_OK and ulong(ELEMENT_COUNT) < DECLARED_TOTAL then 0 else T_CONSTANT_SHAPE)
                                else if ELEMENT_SEPARATOR /= C_CLOSE_BRACKET or ulong(ELEMENT_COUNT) /= DECLARED_TOTAL then T_CONSTANT_SHAPE
                                else 0)
                             else if CODE0 = C_COMMA then 0
                             else if CODE0 /= C_CLOSE_BRACKET then T_EXPECTED_FOUND
                             else if ulong(ELEMENT_COUNT) /= DECLARED_SIZE then T_CONSTANT_COUNT else 0
        | SCALAR_MESSAGE := if DECLARED_ARRAY or not IS_SUBTYPE then T_CONSTANT_TYPE else 0
        | STORES_STRING := IN_CONSTANT_DEFINITION and DEFINITION_IS_STRING and DEFINITION_MESSAGE = 0
        | STORES_LIST := IN_CONSTANT_ELEMENT and ELEMENT_MESSAGE = 0 and ELEMENT_SEPARATOR = C_CLOSE_BRACKET
        | STORES_SCALAR := IN_CONSTANT_SCALAR and SCALAR_MESSAGE = 0
        | STORES_CONSTANT := STORES_STRING or STORES_LIST and not LIST_FOR_DECLARE[?] or STORES_SCALAR
        | DECLARE_LIST_OPENS := IN_DECLARE_INIT and CODE0 = C_OPEN_BRACKET
        | DECLARE_LIST_STORES := STORES_LIST and LIST_FOR_DECLARE[?]
        | STORES_TABLE := STORES_STRING or STORES_LIST or IN_DELAY_LIST_END
        | APPENDS_POOL := IN_CONSTANT_ELEMENT and IS_SUBTYPE or IN_DELAY_ELEMENT
        | WIDEN_BITS := ulong(if CX_FOLDS then FOLD_VL else if ELEMENT_PAIRS then SIGNED_LITERAL else CONSTANT_VALUE_HELD[?]) and ulong(4294967295)
        | WIDEN_SIGN := (WIDEN_BITS shr 31) shl 63
        | WIDEN_EXPONENT := integer((WIDEN_BITS shr 23) and ulong(255))
        | WIDEN_FRACTION := WIDEN_BITS and ulong(8388607)
        | WIDEN_A16 := WIDEN_FRACTION >= ulong(65536)
        | WIDEN_A1 := if WIDEN_A16 then WIDEN_FRACTION shr 16 else WIDEN_FRACTION
        | WIDEN_A8 := WIDEN_A1 >= ulong(256)
        | WIDEN_A2 := if WIDEN_A8 then WIDEN_A1 shr 8 else WIDEN_A1
        | WIDEN_A4 := WIDEN_A2 >= ulong(16)
        | WIDEN_A3 := if WIDEN_A4 then WIDEN_A2 shr 4 else WIDEN_A2
        | WIDEN_A2B := WIDEN_A3 >= ulong(4)
        | WIDEN_A5 := if WIDEN_A2B then WIDEN_A3 shr 2 else WIDEN_A3
        | WIDEN_LENGTH := 16 * integer(WIDEN_A16) + 8 * integer(WIDEN_A8) + 4 * integer(WIDEN_A4) + 2 * integer(WIDEN_A2B)
                          + integer(WIDEN_A5 >= ulong(2)) + integer(WIDEN_A5 >= ulong(1))
        | WIDEN_SUBNORMAL := (WIDEN_FRACTION shl (53 - WIDEN_LENGTH)) and ulong(4503599627370495)
        | WIDENED := long(WIDEN_SIGN
                          or (if WIDEN_EXPONENT = 255 then (ulong(2047) shl 52) or (WIDEN_FRACTION shl 29)
                              else if WIDEN_EXPONENT > 0 then (ulong(WIDEN_EXPONENT + 896) shl 52) or (WIDEN_FRACTION shl 29)
                              else if WIDEN_FRACTION = ulong(0) then ulong(0)
                              else (ulong(WIDEN_LENGTH + 873) shl 52) or WIDEN_SUBNORMAL))
        | WIDER_BITS := ulong(if ELEMENT_PAIRS then SIGNED_LITERAL2 else FOLD_VR) and ulong(4294967295)
        | WIDER_SIGN := (WIDER_BITS shr 31) shl 63
        | WIDER_EXPONENT := integer((WIDER_BITS shr 23) and ulong(255))
        | WIDER_FRACTION := WIDER_BITS and ulong(8388607)
        | WIDER_A16 := WIDER_FRACTION >= ulong(65536)
        | WIDER_A1 := if WIDER_A16 then WIDER_FRACTION shr 16 else WIDER_FRACTION
        | WIDER_A8 := WIDER_A1 >= ulong(256)
        | WIDER_A2 := if WIDER_A8 then WIDER_A1 shr 8 else WIDER_A1
        | WIDER_A4 := WIDER_A2 >= ulong(16)
        | WIDER_A3 := if WIDER_A4 then WIDER_A2 shr 4 else WIDER_A2
        | WIDER_A2B := WIDER_A3 >= ulong(4)
        | WIDER_A5 := if WIDER_A2B then WIDER_A3 shr 2 else WIDER_A3
        | WIDER_LENGTH := 16 * integer(WIDER_A16) + 8 * integer(WIDER_A8) + 4 * integer(WIDER_A4) + 2 * integer(WIDER_A2B)
                          + integer(WIDER_A5 >= ulong(2)) + integer(WIDER_A5 >= ulong(1))
        | WIDER_SUBNORMAL := (WIDER_FRACTION shl (53 - WIDER_LENGTH)) and ulong(4503599627370495)
        | WIDER := long(WIDER_SIGN
                          or (if WIDER_EXPONENT = 255 then (ulong(2047) shl 52) or (WIDER_FRACTION shl 29)
                              else if WIDER_EXPONENT > 0 then (ulong(WIDER_EXPONENT + 896) shl 52) or (WIDER_FRACTION shl 29)
                              else if WIDER_FRACTION = ulong(0) then ulong(0)
                              else (ulong(WIDER_LENGTH + 873) shl 52) or WIDER_SUBNORMAL))
        | CONSTANT_WIDENS := SUBTYPE_TARGET = BUILTIN_DREAL and VALUE_TYPE = BUILTIN_REAL
        | CONSTANT_VALUE_NOW := if STORES_TABLE then long(TABLE_COUNT[?]) else if CONSTANT_WIDENS then WIDENED else CONSTANT_VALUE_HELD[?]
        | FRAME_TOP := FRAME_DEPTH[?] - 1
        | FRAME_TOP_KIND := FRAME_KIND[?][FRAME_TOP]
        | FRAME_TOP_VALUE := FRAME_VALUE[?][FRAME_TOP]
        | IN_LOOP := LOOP_NOW[?] >= 0
        | LABEL_FOLLOWS := CODE0 = C_NAME and CODE1 = C_COLONS
        | PROCESS_MESSAGE := if CODE0 = C_OPEN_BAR then 0
                             else if LABEL_FOLLOWS or CODE0 = C_ON or CODE0 = C_CASE or CODE0 = C_OPEN_BRACE then (if IN_LOOP then T_ONLY_DEFINITIONS else 0)
                             else if CODE0 = C_ITERATE or CODE0 = C_ARRAY then
                               (if IN_LOOP then (if FRAME_TOP_KIND = FRAME_ITERATE and integer(TOKEN_CODE[HERE - 1]) = C_OF then 0 else T_ITERATE_PLACED)
                                else if GUARD_NODE[?] >= 0 then T_ITERATE_GUARDED else 0)
                             else 0
        | STATE_ACTION_OPENS := IN_PROCESS and LABEL_FOLLOWS and PROCESS_MESSAGE = 0 and MODEL_KIND_NOW = C_AUTOMATON
                                and not STATE_GUARDED[?]
        | STATE_GUARDED := if IN_STATE_GUARD then true else if CREATES_USE then false else STATE_GUARDED[?]
        | CREATES_USE := IN_PROCESS and CODE0 /= C_OPEN_BAR and LABEL_FOLLOWS and PROCESS_MESSAGE = 0 and not STATE_ACTION_OPENS
        | CREATES_GUARD := IN_GUARD_COLONS and CODE0 = C_COLONS or IN_CASE_GUARD and CASE_GUARD_MESSAGE = 0 or IN_STATE_GUARD
        | CASE_TOP_START := FRAME_CASE_START[?][FRAME_TOP]
        | CASE_TOP_END := FRAME_CASE_END[?][FRAME_TOP]
        | CASE_LAST_TOP := FRAME_CASE_LAST[?][FRAME_TOP]
        | CASE_AFTER_ELSE := FRAME_TOP_VALUE = 1
        | CASE_BRANCH_EXPECTED := if CASE_AFTER_ELSE then C_END else C_OPEN_BRACE
        | CASE_BRANCH_MESSAGE := if CODE0 = C_OPEN_BRACE then (if CASE_AFTER_ELSE then T_EXPECTED_FOUND else 0)
                                 else if CODE0 = C_ELSE then (if CASE_AFTER_ELSE or CASE_LAST_TOP < 0 then T_EXPECTED_FOUND else 0)
                                 else if CODE0 = C_END then (if CASE_LAST_TOP < 0 then T_EXPECTED_FOUND else 0)
                                 else T_EXPECTED_FOUND
        | CASE_BRANCH_STARTS := IN_CASE_BRANCH and (CODE0 = C_OPEN_BRACE or CODE0 = C_ELSE) and CASE_BRANCH_MESSAGE = 0
        | CASE_ENDS := IN_CASE_BRANCH and CODE0 = C_END and CASE_BRANCH_MESSAGE = 0
        | CASE_OPENS := IN_CASE_IN and CODE0 = C_IN
        | CASE_ELSE_BRANCH := if CASE_BRANCH_STARTS then CODE0 = C_ELSE else CASE_ELSE_BRANCH[?]
        | CASE_GUARD_MESSAGE := if not CASE_ELSE_BRANCH[?] and CODE0 /= C_COLON then T_EXPECTED_FOUND else 0
        | CASE_VALUE_MESSAGE := if LITERAL_IS_STRING then T_CASE_STRING else if LITERAL_IS then LITERAL_MESSAGE else if CODE0 = C_NAME then 0 else T_CASE_VALUE
        | CASE_COPYING := IN_CASE_COPY or IN_CASE_ELSE_VALUE
        | CASE_DUPLICATE := IN_CASE_SCAN and ENTRY_OP[?][CASE_VALUE_ENTRY[?][CASE_SCAN_AT[?]]] = ENTRY_OP[?][ENTRY_COUNT[?] - 1]
                            and ENTRY_VALUE[?][CASE_VALUE_ENTRY[?][CASE_SCAN_AT[?]]] = ENTRY_VALUE[?][ENTRY_COUNT[?] - 1]
                            and ENTRY_NAME[?][CASE_VALUE_ENTRY[?][CASE_SCAN_AT[?]]] = ENTRY_NAME[?][ENTRY_COUNT[?] - 1]
        | CASE_ITEM_DONE := IN_CASE_COMPARE and CASE_BRANCH_ITEMS[?] = 0 or IN_CASE_JOIN
        | CASE_ITEM_NEXT := if CASE_ELSE_BRANCH[?] then (if CASE_VALUE_PREV[?][CASE_WALK[?]] >= 0 then P_CASE_COPY else P_CASE_WHEN)
                            else P_CASE_SEPARATOR
        | CASE_BRANCH_ITEMS := if CASE_BRANCH_STARTS then 0 else CASE_BRANCH_ITEMS[?] + integer(CASE_ITEM_DONE)
        | CASE_WALK := if CASE_BRANCH_STARTS then CASE_LAST_TOP
                       else if CASE_ITEM_DONE and CASE_ELSE_BRANCH[?] then CASE_VALUE_PREV[?][CASE_WALK[?]] else CASE_WALK[?]
        | CASE_SCAN_AT := if IN_CASE_LITERAL then CASE_LAST_TOP else if IN_CASE_SCAN then CASE_VALUE_PREV[?][CASE_SCAN_AT[?]]
                          else CASE_SCAN_AT[?]
        | CASE_LITERAL_TOKEN := if IN_CASE_LITERAL then LITERAL_MESSAGE_TOKEN else CASE_LITERAL_TOKEN[?]
        | CASE_OP_TOKEN := if CASE_ELSE_BRANCH[?] then GUARD_START_TOKEN[?] else CASE_LITERAL_TOKEN[?]
        | CASE_VALUE_SLOT := if GO and IN_CASE_LITERAL then CASE_VALUE_COUNT[?] else -1
        | CASE_VALUE_ENTRY := CASE_VALUE_ENTRY[?] next CASE_VALUE_SLOT : ENTRY_COUNT[?]
        | CASE_VALUE_PREV := CASE_VALUE_PREV[?] next CASE_VALUE_SLOT : CASE_LAST_TOP
        | CASE_VALUE_COUNT := CASE_VALUE_COUNT[?] + integer(CASE_VALUE_SLOT >= 0)
        | CASE_FRAME_SLOT := if GO and CASE_OPENS then FRAME_DEPTH[?] else -1
        | FRAME_CASE_START := FRAME_CASE_START[?] next CASE_FRAME_SLOT : EXPRESSION_START[?]
        | FRAME_CASE_END := FRAME_CASE_END[?] next CASE_FRAME_SLOT : ENTRY_COUNT[?]
        | FRAME_CASE_LAST := FRAME_CASE_LAST[?] next (if CASE_FRAME_SLOT >= 0 then CASE_FRAME_SLOT else if CASE_VALUE_SLOT >= 0 then FRAME_TOP else -1)
                             : (if CASE_FRAME_SLOT >= 0 then -1 else CASE_VALUE_COUNT[?])
        | CASE_DEPTH := CASE_DEPTH[?] + integer(GO and CASE_OPENS) - integer(GO and CASE_ENDS)
        | PATH_PARENT_START := if CREATES_USE then USE_PATH_START[?][LABEL_NODE[?]] else GUARD_PATH_START[?][GUARD_NODE[?]]
        | PATH_PARENT_LENGTH := if CREATES_USE then (if LABEL_NODE[?] >= 0 then USE_PATH_LENGTH[?][LABEL_NODE[?]] else 0)
                                else if GUARD_NODE[?] >= 0 then GUARD_PATH_LENGTH[?][GUARD_NODE[?]] else 0
        | STARTS_PATH := CREATES_USE or CREATES_GUARD
        | PATH_FROM := if STARTS_PATH then PATH_PARENT_START else if IN_PATH_COPY then PATH_FROM[?] + 1 else PATH_FROM[?]
        | PATH_LEFT := if STARTS_PATH then PATH_PARENT_LENGTH else if IN_PATH_COPY then PATH_LEFT[?] - 1 else PATH_LEFT[?]
        | PATH_APPEND := if CREATES_USE then NAME0 else if CREATES_GUARD then GUARD_COUNT[?] else PATH_APPEND[?]
        | PATH_VALUE := PATH_VALUE[?] next (if IN_PATH_COPY then PATH_COUNT[?] else -1)
                        : (if PATH_LEFT[?] > 0 then PATH_VALUE[?][PATH_FROM[?]] else PATH_APPEND[?])
        | PATH_COUNT := PATH_COUNT[?] + integer(IN_PATH_COPY)
        | FOLLOWER := if CODE0 = C_NAME then (if ELEMENT_TARGET[HERE] then C_DEFINE else CODE1) else -1
        | EQUATION_MESSAGE := if IN_LOOP and FOLLOWER /= C_DEFINE
                                 and not (not LOOP_SEED[?] and (FOLLOWER = C_OPEN_BRACE or FOLLOWER = C_OPEN))
                              then T_ONLY_DEFINITIONS else 0
        | TUPLE_OPENS := IN_PROCESS and CODE0 = C_OPEN and CODE1 = C_NAME
                         and (CODE2 = C_COMMA or CODE2 = C_OPEN_BRACKET or CODE2 = C_CLOSE and (CODE3 = C_DEFINE or CODE3 = C_PARTIAL_DEFINE))
                         and PROCESS_MESSAGE = 0
        | TUPLE_SEPARATOR_MESSAGE := if CODE0 = C_COMMA then 0
                                     else if CODE0 = C_CLOSE and CODE1 = C_PARTIAL_DEFINE then T_PARTIAL_TUPLE
                                     else if CODE0 /= C_CLOSE or CODE1 /= C_DEFINE then T_EXPECTED_FOUND
                                     else if TUPLE_ELEMENTS[?] > 0
                                             and not (IN_LOOP and not LOOP_SEED[?] and CODE2 = C_NAME and CODE3 = C_OPEN and not AXIS_FORM)
                                     then T_TUPLE_ELEMENT
                                     else if CODE2 = C_OPEN or CODE2 = C_NAME and (CODE3 = C_OPEN or CODE3 = C_OPEN_BRACE) or AXIS_FORM then 0
                                     else T_EXPECTED_FOUND
        | AXIS_FORM := CODE2 = C_NAME and NAME2 = N_INDICES and CODE3 = C_OPEN or CODE2 = C_LESS and CODE3 = C_LESS
        | TUPLE_SEPARATOR_EXPECTED := if CODE0 /= C_CLOSE then C_CLOSE else if CODE1 /= C_DEFINE then C_DEFINE else C_OPEN
        | TUPLE_DEFINES := IN_TUPLE_SEPARATOR and CODE0 = C_CLOSE and TUPLE_SEPARATOR_MESSAGE = 0
        | TUPLE_ACTIVE := TUPLE_INDEX[?] >= 0
        | TUPLE_EXTRA := TUPLE_ACTIVE and TUPLE_INDEX[?] >= TUPLE_ARITY[?]
        | TUPLE_CONTINUES := IN_EQUATION_END and TUPLE_ACTIVE and CODE0 = C_COMMA and not TUPLE_CALL[?]
        | TUPLE_CALL := if TUPLE_OPENS then false else if TUPLE_DEFINES then CODE2 = C_NAME and not AXIS_FORM else TUPLE_CALL[?]
        | TUPLE_AXIS := if TUPLE_OPENS then false else if TUPLE_DEFINES then AXIS_FORM else TUPLE_AXIS[?]
        | AXIS_ANGLE_ENDS := TUPLE_ACTIVE and TUPLE_AXIS[?] and CODE0 = C_GREATER and CODE1 = C_GREATER
        | TUPLE_CALL_ENDS := IN_EQUATION_END and TUPLE_ACTIVE and TUPLE_CALL[?]
        | TUPLE_STARTS := TUPLE_DEFINES or TUPLE_CONTINUES
        | TUPLE_NEXT := if TUPLE_DEFINES then 0 else TUPLE_INDEX[?] + 1
        | TUPLE_POSITION := TUPLE_BASE[?] + TUPLE_NEXT
        | TUPLE_SLOT := if IN_TUPLE_NAME and CODE0 = C_NAME and GO then TUPLE_COUNT[?] else -1
        | TUPLE_NAME_ROW := TUPLE_NAME_ROW[?] next TUPLE_SLOT : NAME0
        | TUPLE_ELEMENT_ROW := TUPLE_ELEMENT_ROW[?] next TUPLE_SLOT : CODE1 = C_OPEN_BRACKET
        | TUPLE_TOKEN_ROW := TUPLE_TOKEN_ROW[?] next TUPLE_SLOT : HERE
        | TUPLE_COUNT := TUPLE_COUNT[?] + integer(TUPLE_SLOT >= 0)
        | TUPLE_BASE := if TUPLE_OPENS then TUPLE_COUNT[?] else TUPLE_BASE[?]
        | TUPLE_ELEMENTS := if TUPLE_OPENS then 0 else TUPLE_ELEMENTS[?] + integer(TUPLE_SLOT >= 0 and CODE1 = C_OPEN_BRACKET)
        | TUPLE_DEPTH := if IN_TUPLE_SKIP then TUPLE_DEPTH[?] + integer(CODE0 = C_OPEN_BRACKET) - integer(CODE0 = C_CLOSE_BRACKET) else 0
        | TUPLE_SKIP_ENDS := IN_TUPLE_SKIP and CODE0 = C_CLOSE_BRACKET and TUPLE_DEPTH[?] = 1
        | TUPLE_EXTRAS_START := TUPLE_CALL_ENDS and TUPLE_ELEMENTS[?] > 0 and APPENDS_EQUATION and EQUATION_END_MESSAGE = 0
        | TUPLE_RESUME_AT := if TUPLE_EXTRAS_START then HERE else TUPLE_RESUME_AT[?]
        | TUPLE_SEEK_DONE := IN_TUPLE_SEEK and TUPLE_SEEK_SLOT[?] >= TUPLE_BASE[?] + TUPLE_ARITY[?]
        | TUPLE_SEEK_FOUND := IN_TUPLE_SEEK and not TUPLE_SEEK_DONE and TUPLE_ELEMENT_ROW[?][TUPLE_SEEK_SLOT[?]]
        | TUPLE_HEAD_DONE := IN_TUPLE_EMIT and TUPLE_PHASE[?] = 0 and STAGE_DONE
        | TUPLE_APPENDS := IN_TUPLE_EMIT and TUPLE_PHASE[?] = 1 and STAGE_DONE
        | TUPLE_SEEK_SLOT := if TUPLE_EXTRAS_START then TUPLE_BASE[?]
                             else if IN_TUPLE_SEEK and not TUPLE_SEEK_FOUND or TUPLE_APPENDS then TUPLE_SEEK_SLOT[?] + 1
                             else TUPLE_SEEK_SLOT[?]
        | TUPLE_PHASE := if IN_TUPLE_SEEK then 0 else if IN_TUPLE_EMIT and STAGE_DONE then 1 - TUPLE_PHASE[?] else TUPLE_PHASE[?]
        | TUPLE_LIST_ON := if TUPLE_EXTRAS_START then true else if TUPLE_SEEK_DONE then false else TUPLE_LIST_ON[?]
        | TUPLE_EQ_START := if IN_TUPLE_EMIT and TUPLE_PHASE[?] = 0 and INDEX_FRESH then ENTRY_COUNT[?] else TUPLE_EQ_START[?]
        | TUPLE_MAIN_KEY := N_TUPLE_MARK + NAME_CAP
        | TUPLE_OUTPUT_KEY := N_TUPLE_MARK + (TUPLE_SEEK_SLOT[?] - TUPLE_BASE[?] + 2) * NAME_CAP
        | OPERAND_LIST_ON := SEQ_ON[?] or TUPLE_LIST_ON[?]
        | OPERAND_LIST_AT := if IN_SEQ_EMIT and SEQ_PHASE[?] = 0 and CODE0 = C_OPEN_BRACKET then HERE
                     else if TUPLE_HEAD_DONE then HERE + 1 else OPERAND_LIST_AT[?]
        | OPERAND_LIST_TOP := OPERAND_LIST_ON and TOP_OP = OP_OPEN_PAREN and TOP_TOKEN = OPERAND_LIST_AT[?]
        | TUPLE_NAMES_TARGET := TUPLE_STARTS and TUPLE_NEXT < TUPLE_ARITY[?]
        | TUPLE_FIRST_NAME := TOKEN_NAME[TUPLE_TOKEN[?] + 1] - 1
        | TUPLE_END_MESSAGE := if CODE0 /= C_COMMA and CODE0 /= C_CLOSE and not AXIS_ANGLE_ENDS then T_EXPECTED_FOUND
                               else if CODE0 = C_CLOSE and TUPLE_INDEX[?] + 1 /= TUPLE_ARITY[?] then T_WRONG_ARGUMENTS else 0
        | TUPLE_TOKEN := if TUPLE_OPENS then HERE else TUPLE_TOKEN[?]
        | TUPLE_ARITY := if TUPLE_OPENS then 0 else if IN_TUPLE_NAME then TUPLE_ARITY[?] + 1 else TUPLE_ARITY[?]
        | TUPLE_INDEX := if TUPLE_DEFINES then 0 else if TUPLE_CONTINUES then TUPLE_INDEX[?] + 1
                         else if IN_EQUATION_END and TUPLE_ACTIVE then -1 else TUPLE_INDEX[?]
        | STARTS_EXPRESSION := IN_PROCESS and (CODE0 = C_ON or CODE0 = C_CASE) and PROCESS_MESSAGE = 0
                               or IN_CONSTANT_DEFINITION and not DEFINITION_IS_STRING and CODE0 /= C_OPEN_BRACKET
                               or IN_DECLARE_INIT and CODE0 = C_OPEN
                               or IN_ARRAY_TO and CODE0 = C_TO
                               or TUPLE_STARTS or CASE_BRANCH_STARTS or STATE_ACTION_OPENS
                               or IN_EQUATION and EQUATION_MESSAGE = 0 and FOLLOWER /= C_ARROW
                               or CONTINUES_GROUP
        | LAST_ENTRY := ENTRY_COUNT[?] - 1
        | LAST_IS_CALL := (ENTRY_OP[?][LAST_ENTRY] = OP_CALL or ENTRY_OP[?][LAST_ENTRY] = OP_AFFINE_RELATION) and LAST_ENTRY >= EXPRESSION_START[?]
        | LAST_ENTRY_SAFE := if LAST_ENTRY >= 0 then LAST_ENTRY else 0
        | TUPLE_CALL_MESSAGE := if not LAST_IS_CALL or CODE0 = C_COMMA then T_EXPECTED_FOUND
                              else if TUPLE_ARITY[?] > 1 and GUARD_NODE[?] >= 0 then T_TUPLE_CALL_PLACED else 0
        | TUPLE_COST := if TUPLE_CALL_ENDS then TUPLE_ARITY[?] * (integer(ENTRY_VALUE[?][LAST_ENTRY_SAFE]) + 2) else 0
        | TUPLE_COST_MAX := if TUPLE_COST > TUPLE_COST_MAX[?] then TUPLE_COST else TUPLE_COST_MAX[?]
        | IS_RELATION_CODE := CODE0 = C_CLOCK_EQUAL or CODE0 = C_CLOCK_LT or CODE0 = C_CLOCK_GT or CODE0 = C_CLOCK_SHARP or CODE0 = C_IDENTITY
        | MAKES_GROUP := TARGET[?] < 0 and (IS_RELATION_CODE or not LAST_IS_CALL)
        | EQUATION_END_MESSAGE := if IN_EQUATION_END and TUPLE_ACTIVE then (if TUPLE_CALL[?] then TUPLE_CALL_MESSAGE else TUPLE_END_MESSAGE)
                                else if IN_EQUATION_END and MAKES_GROUP and not IS_RELATION_CODE and not CONDITION_ENDS then T_EXPECTED_DEFINITION
                                else if IN_EQUATION_END and ASSERTING and not MAKES_GROUP then T_ASSERT_MEMBER else 0
        | OPENS_GROUP := IN_EQUATION_END and MAKES_GROUP and IS_RELATION_CODE and not CONDITION_ENDS
        | CALL_STATEMENT_ENDS := IN_EQUATION_END and TARGET[?] < 0 and LAST_IS_CALL and CALL_STATEMENT_NAME_FITS and not TUPLE_ACTIVE
        | CALL_STATEMENT_NAME := ENTRY_NAME[?][LAST_ENTRY]
        | CALL_STATEMENT_NAME_FITS := CALL_STATEMENT_NAME = N_ASSERT or CALL_STATEMENT_NAME = N_MIN_CLOCK
        | ASSERTING := ASSERT_FRAME[?] >= 0
        | ASSERT_OPENS := IN_PROCESS and PROCESS_MESSAGE = 0 and CODE0 = C_NAME and NAME0 = N_ASSERT and CODE1 = C_OPEN_BAR
        | ASSERT_FRAME := if ASSERT_OPENS and not ASSERTING then FRAME_DEPTH[?]
                          else if POPS_FRAME and FRAME_DEPTH[?] - 1 = ASSERT_FRAME[?] then -1 else ASSERT_FRAME[?]
        | CONTINUES_GROUP := OPENS_GROUP or IN_GROUP_MEMBER and CODE0 = GROUP_RELATION_NOW[?]
        | GROUP_MEMBER_MESSAGE := if IN_GROUP_MEMBER and IS_RELATION_CODE and CODE0 /= GROUP_RELATION_NOW[?] then T_EXPECTED_FOUND else 0
        | GROUP_RELATION_NOW := if OPENS_GROUP then CODE0 else GROUP_RELATION_NOW[?]
        | GROUP_OPERATOR_NOW := if OPENS_GROUP then HERE else GROUP_OPERATOR_NOW[?]
        | APPENDS_EQUATION := IN_EQUATION_END and not MAKES_GROUP and not TUPLE_EXTRA and not CALL_STATEMENT_ENDS and not CONDITION_ENDS
        | STANDALONE_MEMBER := CALL_STATEMENT_ENDS or CONDITION_ENDS
        | APPENDS_MEMBER := OPENS_GROUP and not CONDITION_ENDS or IN_GROUP_MEMBER or IN_SYNC or STANDALONE_MEMBER
        | APPENDS_GROUP := IN_GROUP_MEMBER and CODE0 /= GROUP_RELATION_NOW[?] or IN_SYNC and SYNC_LAST or STANDALONE_MEMBER
        | IS_STATEMENT := TARGET[?] < 0 and LAST_IS_CALL
                          and (ENTRY_NAME[?][LAST_ENTRY] = N_INITIAL or ENTRY_NAME[?][LAST_ENTRY] = N_TRANSITION
                               or ENTRY_NAME[?][LAST_ENTRY] = N_SET_CLOCK or ENTRY_NAME[?][LAST_ENTRY] = N_SET_CURRENT_STATE_ID)
        | DEPENDENCE_MESSAGE := if CODE0 = C_ARROW then (if CODE1 /= C_NAME and CODE1 /= C_OPEN_BRACE then T_ARROW_NAMES else 0)
                                else if not SET_ARROWED[?] then T_EXPECTED_FOUND
                                else if CODE0 /= C_BAR and CODE0 /= C_BAR_CLOSE and not (CODE0 = C_CLOSE_BRACE and CONDITION_STAGE[?] = 1)
                                then (if CODE0 = C_COMMA and CONDITION_STAGE[?] = 1 then T_CONDITION_LIST else T_ARROW_NAMES) else 0
        | EMIT_LAST_J := EMIT_J[?] + 1 >= SET_RIGHT_COUNT[?]
        | EMIT_LAST := EMIT_LAST_J and EMIT_I[?] + 1 >= SET_LEFT_COUNT[?]
        | EMIT_FROM_TOKEN := SET_LEFT_START[?] + 2 * EMIT_I[?]
        | EMIT_TO_TOKEN := SET_RIGHT_START[?] + 2 * EMIT_J[?]
        | APPENDS_DEPENDENCE := IN_SET_EMIT
        | SET_MESSAGE := if IN_SET_NAME then (if CODE0 /= C_NAME then T_EXPECTED_NAME else 0)
                         else if IN_SET_SEPARATOR then
                           (if CODE0 = C_ARROW then T_CONDITION_LIST else if CODE0 /= C_COMMA and CODE0 /= C_CLOSE_BRACE then T_EXPECTED_FOUND else 0)
                         else 0
        | HIDE_OPENS := (IN_POP or IN_MODEL_AFTER) and CODE0 = C_SLASH
        | INNER_WHERE_OPENS := IN_POP and CODE0 = C_WHERE
        | HIDE_MESSAGE := if IN_HIDE_NAME and CODE0 /= C_NAME then T_EXPECTED_NAME else 0
        | APPENDS_HIDE := IN_HIDE_NAME and CODE0 = C_NAME
        | EMPTY_COMPOSITION := CODE0 = C_BAR_CLOSE and integer(TOKEN_CODE[HERE - 1]) = C_OPEN_BAR
        | POP_COMPOSE_BREAKS := FRAME_TOP_KIND = FRAME_COMPOSE and CODE0 = C_BAR and CODE1 /= C_BAR_CLOSE
        | POP_ITERATE_SEEDS := FRAME_TOP_KIND = FRAME_ITERATE and not LOOP_SEED[?] and CODE0 = C_WITH
        | POP_MESSAGE := if HIDE_OPENS or INNER_WHERE_OPENS then 0
                         else if FRAME_TOP_KIND = FRAME_COMPOSE then
                           (if CODE0 /= C_BAR and CODE0 /= C_BAR_CLOSE then T_EXPECTED_FOUND else 0)
                         else if FRAME_TOP_KIND = FRAME_ITERATE and not POP_ITERATE_SEEDS and CODE0 /= C_END then T_EXPECTED_FOUND
                         else 0
        | POPS_FRAME := CASE_ENDS or IN_POP and not CONDITION_CLOSES and not CONDITION_WHEN and not SPEC_JOINS and FRAME_TOP_KIND /= FRAME_CASE and not SYNC_PENDING and not POP_COMPOSE_BREAKS and not POP_ITERATE_SEEDS and not HIDE_OPENS and not INNER_WHERE_OPENS
                      and POP_MESSAGE = 0
        | PUSHES_FRAME := IN_PROCESS and PROCESS_MESSAGE = 0 and (CODE0 = C_OPEN_BAR or ASSERT_OPENS or LABEL_FOLLOWS and not STATE_ACTION_OPENS)
                          or CREATES_GUARD or IN_ITERATE_OF and CODE0 = C_OF or CASE_OPENS
        | PUSHED_FRAME_KIND := if IN_PROCESS then (if CODE0 = C_OPEN_BAR or ASSERT_OPENS then FRAME_COMPOSE else FRAME_LABEL)
                               else if IN_GUARD_COLONS or IN_CASE_GUARD or IN_STATE_GUARD then FRAME_GUARD else if IN_CASE_IN then FRAME_CASE else FRAME_ITERATE
        | PUSHED_FRAME_VALUE := if IN_PROCESS then USE_COUNT[?] else if IN_GUARD_COLONS or IN_CASE_GUARD or IN_STATE_GUARD then GUARD_COUNT[?]
                                else if IN_CASE_IN then 0 else LOOP_COUNT[?] - 1
        | CASE_ELSE_MARKS := CASE_BRANCH_STARTS and CODE0 = C_ELSE
        | FRAME_KIND := FRAME_KIND[?] next (if PUSHES_FRAME then FRAME_DEPTH[?] else -1) : PUSHED_FRAME_KIND
        | FRAME_VALUE := FRAME_VALUE[?] next (if PUSHES_FRAME then FRAME_DEPTH[?] else if CASE_ELSE_MARKS then FRAME_TOP else -1)
                         : (if CASE_ELSE_MARKS then 1 else PUSHED_FRAME_VALUE)
        | FRAME_DEPTH := FRAME_DEPTH[?] + integer(PUSHES_FRAME) - integer(POPS_FRAME)
        | PENDING_TOP := PENDING_DEPTH[?] - 1
        | HAS_PENDING := PENDING_TOP >= 0
        | TOP_OP := PENDING_OP[?][PENDING_TOP]
        | TOP_PRECEDENCE := PENDING_PRECEDENCE[?][PENDING_TOP]
        | TOP_TOKEN := PENDING_TOKEN[?][PENDING_TOP]
        | TOP_IS_OPENER := HAS_PENDING and OP_IS_OPENER[TOP_OP] = 1
        | TOP_REDUCIBLE := HAS_PENDING and not TOP_IS_OPENER
        | OPENER_NOW := OPENER_TOP[?]
        | OPENER_OP := PENDING_OP[?][OPENER_NOW]
        | TOP_CALLEE := TOKEN_NAME[TOP_TOKEN] - 1
        | CONSTANT_PARSE := EXPRESSION_RETURN[?] = P_CONSTANT_END or EXPRESSION_RETURN[?] = P_INIT_END
                            or HAS_PENDING and PENDING_FOLDS[?][PENDING_TOP]
        | NAME_CONSTANT_ROW := if CODE0 = C_NAME then NAME_CONSTANT[?][NAME0] - 1 else -1
        | NAMED_CONSTANT := if NAME_CONSTANT_ROW >= 0 then NAME_CONSTANT_ROW else 0
        | NAME_IS_SCALAR_CONSTANT := NAME_CONSTANT_ROW >= 0 and TYPE_KIND[?][CONSTANT_TYPE[?][NAMED_CONSTANT]] /= TK_ARRAY
        | FOLD_RIGHT := ENTRY_COUNT[?] - 1
        | FOLD_LEFT := ENTRY_COUNT[?] - 2
        | FOLD_R := if FOLD_RIGHT >= 0 then FOLD_RIGHT else 0
        | FOLD_L := if FOLD_LEFT >= 0 then FOLD_LEFT else 0
        | RIGHT_IS_CONST := FOLD_RIGHT >= 0 and ENTRY_OP[?][FOLD_R] = OP_CONST
        | LEFT_IS_CONST := FOLD_LEFT >= 0 and ENTRY_OP[?][FOLD_L] = OP_CONST
        | FOLD_VR := ENTRY_VALUE[?][FOLD_R]
        | FOLD_VL := ENTRY_VALUE[?][FOLD_L]
        | FOLD_TR := ENTRY_TYPE[?][FOLD_R]
        | FOLD_TL := ENTRY_TYPE[?][FOLD_L]
        | FOLD_R_INT := FOLD_TR >= BUILTIN_SHORT and FOLD_TR <= BUILTIN_ULONG
        | FOLD_L_INT := FOLD_TL >= BUILTIN_SHORT and FOLD_TL <= BUILTIN_ULONG
        | FOLD_R_REAL := FOLD_TR = BUILTIN_REAL or FOLD_TR = BUILTIN_DREAL
        | FOLD_L_REAL := FOLD_TL = BUILTIN_REAL or FOLD_TL = BUILTIN_DREAL
        | FOLD_TR_SAFE := if FOLD_R_INT then FOLD_TR else BUILTIN_SHORT
        | FOLD_TL_SAFE := if FOLD_L_INT then FOLD_TL else BUILTIN_SHORT
        | FOLD_R_SIGNED := BUILTIN_SIGNED[FOLD_TR_SAFE] = 1
        | FOLD_L_SIGNED := BUILTIN_SIGNED[FOLD_TL_SAFE] = 1
        | FOLD_UNSIGNED_BYTES := if FOLD_L_SIGNED then BUILTIN_BYTES[FOLD_TR_SAFE] else BUILTIN_BYTES[FOLD_TL_SAFE]
        | FOLD_SIGNED_BYTES := if FOLD_L_SIGNED then BUILTIN_BYTES[FOLD_TL_SAFE] else BUILTIN_BYTES[FOLD_TR_SAFE]
        | FOLD_LUB := if FOLD_TL = FOLD_TR then FOLD_TL
                      else if not (FOLD_L_INT and FOLD_R_INT) then -1
                      else if FOLD_L_SIGNED = FOLD_R_SIGNED then
                        (if BUILTIN_BYTES[FOLD_TL_SAFE] > BUILTIN_BYTES[FOLD_TR_SAFE] then FOLD_TL else FOLD_TR)
                      else if FOLD_SIGNED_BYTES > FOLD_UNSIGNED_BYTES then (if FOLD_L_SIGNED then FOLD_TL else FOLD_TR)
                      else if FOLD_UNSIGNED_BYTES = 1 then BUILTIN_SHORT else if FOLD_UNSIGNED_BYTES = 2 then BUILTIN_INTEGER
                      else if FOLD_UNSIGNED_BYTES = 4 then BUILTIN_LONG else -1
        | FOLD_ARITHMETIC := TOP_OP = OP_ADD or TOP_OP = OP_SUB or TOP_OP = OP_MUL or TOP_OP = OP_DIV or TOP_OP = OP_MOD
        | FOLD_COMPARE := TOP_OP = OP_EQ or TOP_OP = OP_NE or TOP_OP = OP_LT or TOP_OP = OP_LE or TOP_OP = OP_GT or TOP_OP = OP_GE
        | FOLD_LOGIC := TOP_OP = OP_AND or TOP_OP = OP_OR or TOP_OP = OP_XOR
        | FOLD_SHIFT := TOP_OP = OP_SHL or TOP_OP = OP_SHR
        | FOLD_UNARY := TOP_OP = OP_NEG or TOP_OP = OP_NOT
        | FOLD_BINARY_TYPE := if FOLD_ARITHMETIC then
                                (if FOLD_LUB >= 0 and FOLD_L_INT and FOLD_R_INT then (if TOP_OP = OP_MOD then FOLD_TR else FOLD_LUB) else -1)
                              else if FOLD_COMPARE then
                                (if FOLD_LUB >= 0 and FOLD_LUB /= BUILTIN_STRING and FOLD_LUB /= BUILTIN_REAL and FOLD_LUB /= BUILTIN_DREAL
                                 then BUILTIN_BOOLEAN else -1)
                              else if FOLD_LOGIC then
                                (if FOLD_TL = BUILTIN_BOOLEAN and FOLD_TR = BUILTIN_BOOLEAN then BUILTIN_BOOLEAN
                                 else if FOLD_LUB >= 0 and FOLD_L_INT and FOLD_R_INT and not FOLD_L_SIGNED and not FOLD_R_SIGNED then FOLD_LUB
                                 else -1)
                              else if FOLD_SHIFT then (if FOLD_L_INT and not FOLD_L_SIGNED and FOLD_R_INT then FOLD_TL else -1)
                              else if TOP_OP = OP_POW then (if FOLD_L_INT and FOLD_R_INT and FOLD_VR >= long(1) then FOLD_TL else -1)
                              else if TOP_OP = OP_CPAIR then
                                (if not FOLD_L_REAL or not FOLD_R_REAL then -1
                                 else if FOLD_TL = BUILTIN_DREAL or FOLD_TR = BUILTIN_DREAL then BUILTIN_DCOMPLEX else BUILTIN_COMPLEX)
                              else -1
        | FOLD_UNARY_TYPE := if TOP_OP = OP_NEG then (if FOLD_R_INT or FOLD_R_REAL then FOLD_TR else -1)
                             else if FOLD_TR = BUILTIN_BOOLEAN or FOLD_R_INT and not FOLD_R_SIGNED then FOLD_TR else -1
        | FOLD_CALLEE_TYPE := if TOP_CALLEE < 0 then -1 else if TOP_CALLEE < BUILTIN_TYPE_COUNT then TOP_CALLEE
                              else if NAME_TYPE[TOP_CALLEE] > 0 then NAME_TYPE[TOP_CALLEE] - 1 else NAME_ALIAS[?][TOP_CALLEE] - 1
        | FOLD_CONVERT_TYPE := if FOLD_CALLEE_TYPE >= BUILTIN_SHORT and FOLD_CALLEE_TYPE <= BUILTIN_ULONG
                                  and (FOLD_R_INT or FOLD_TR = BUILTIN_BOOLEAN) then FOLD_CALLEE_TYPE else -1
        | CALL_CLOSES := IN_OPERATOR and OPERATOR_CASE = X_CLOSE and TOP_OP = OP_CALL and STAGE_LENGTH = 0 and CONSTANT_PARSE
                         and PENDING_COUNT[?][PENDING_TOP] = 0 and PENDING_PARAMETERS[?][PENDING_TOP] < 0
        | CONVERT_NOT_INTEGER := CALL_CLOSES and FOLD_CALLEE_TYPE >= 0
                                 and (FOLD_CALLEE_TYPE < BUILTIN_SHORT or FOLD_CALLEE_TYPE > BUILTIN_ULONG)
        | POW_TOP := IN_OPERATOR and OPERATOR_CASE = X_REDUCE and TOP_OP = OP_POW
        | POW_RIGHT_START := PENDING_RIGHT_START[?][PENDING_TOP]
        | POW_RIGHT_SINGLE := FOLD_RIGHT = POW_RIGHT_START
        | POW_RIGHT_NEGATED := FOLD_RIGHT = POW_RIGHT_START + 1 and integer(ENTRY_OP[?][FOLD_R]) = OP_NEG
        | POW_RIGHT_AT := if POW_RIGHT_NEGATED then FOLD_L else FOLD_R
        | POW_RIGHT_OP := integer(ENTRY_OP[?][POW_RIGHT_AT])
        | POW_RIGHT_NAME := ENTRY_NAME[?][POW_RIGHT_AT]
        | POW_RIGHT_CONSTANT := if POW_RIGHT_OP = OP_SIGNAL and POW_RIGHT_NAME >= 0 then NAME_CONSTANT[?][POW_RIGHT_NAME] - 1 else -1
        | POW_EXPONENT_TYPE := if POW_RIGHT_OP = OP_CONST then ENTRY_TYPE[?][POW_RIGHT_AT]
                               else if POW_RIGHT_CONSTANT >= 0 then CONSTANT_TYPE[?][POW_RIGHT_CONSTANT] else -1
        | POW_MAGNITUDE := if POW_RIGHT_OP = OP_CONST then ENTRY_VALUE[?][POW_RIGHT_AT]
                           else if POW_RIGHT_CONSTANT >= 0 then CONSTANT_VALUE[?][POW_RIGHT_CONSTANT] else long(0)
        | POW_EXPONENT := if POW_RIGHT_NEGATED then -POW_MAGNITUDE else POW_MAGNITUDE
        | POW_RIGHT_OK := (POW_RIGHT_SINGLE or POW_RIGHT_NEGATED) and POW_EXPONENT_TYPE >= 0
                          and TYPE_KIND[?][if POW_EXPONENT_TYPE >= 0 then POW_EXPONENT_TYPE else 0] = TK_INT
        | POW_FIRST := POW_TOP and POWER_ROUND[?] = long(0) and STAGE_INDEX[?] = 0 and COPY_I[?] = 0
        | POW_MESSAGE := if not POW_FIRST then 0 else if CODE0 = C_STAR_STAR then T_POWER_CHAIN else if CODE0 = C_AT then T_AT_CHAIN
                         else if not POW_RIGHT_OK then T_POWER_CONSTANT
                         else if POW_EXPONENT < long(1) then T_POWER_RANGE else 0
        | AT_CHAINS := IN_OPERATOR and OPERATOR_CASE = X_REDUCE and TOP_OP = OP_CPAIR and (CODE0 = C_AT or CODE0 = C_STAR_STAR)
        | POW_EXPONENT_HELD := if POW_FIRST then POW_EXPONENT else POW_EXPONENT_HELD[?]
        | POW_FOLDS_HELD := if POW_FIRST then CONSTANT_PARSE and LEFT_IS_CONST and POW_RIGHT_SINGLE else POW_FOLDS_HELD[?]
        | POW_FOLDING := POW_TOP and POW_MESSAGE = 0 and POW_FOLDS_HELD
        | POW_STAGES := POW_TOP and POW_MESSAGE = 0 and not POW_FOLDS_HELD and POW_EXPONENT_HELD > long(1)
        | POW_DROPS := POW_TOP and POW_MESSAGE = 0 and not POW_FOLDS_HELD and POW_EXPONENT_HELD = long(1)
        | POW_ROUNDS := if POW_EXPONENT_HELD > long(1) then POW_EXPONENT_HELD - long(1) else long(1)
        | POW_MORE := POW_TOP and POW_MESSAGE = 0 and POWER_ROUND[?] < POW_ROUNDS - long(1)
        | POW_ROUND_ENDS := POW_TOP and (not POW_STAGES or STAGE_INDEX[?] = STAGE_LENGTH - 1 and STAGE_ADVANCES)
        | POWER_ROUND := if POW_ROUND_ENDS and POW_MORE then POWER_ROUND[?] + long(1)
                         else if POW_TOP and not POW_ROUND_ENDS then POWER_ROUND[?] else long(0)
        | POW_PRODUCT := (if POWER_ROUND[?] = long(0) then FOLD_VL else POW_ACCUMULATOR[?]) * FOLD_VL
        | POW_ACCUMULATOR := if POW_FOLDING then POW_PRODUCT else long(0)
        | POW_OVERWRITES := POW_STAGES and POW_FIRST
        | POW_HOLDS := POW_FOLDING and POW_MORE or POW_DROPS
        | REDUCE_FOLDS := IN_OPERATOR and OPERATOR_CASE = X_REDUCE and STAGE_LENGTH = 0 and CONSTANT_PARSE and RIGHT_IS_CONST and not POW_MORE
                          and (if FOLD_UNARY then FOLD_UNARY_TYPE >= 0 else LEFT_IS_CONST and FOLD_BINARY_TYPE >= 0)
        | CONVERT_FOLDS := CALL_CLOSES and RIGHT_IS_CONST and FOLD_RIGHT >= PENDING_RIGHT_START[?][PENDING_TOP]
                           and FOLD_CONVERT_TYPE >= 0
        | FOLDS_NOW := REDUCE_FOLDS or CONVERT_FOLDS
        | CX_FOLDS := REDUCE_FOLDS and TOP_OP = OP_CPAIR
        | FOLD_ARITY := if CONVERT_FOLDS or FOLD_UNARY then 1 else 2
        | FOLD_TYPE := if CONVERT_FOLDS then FOLD_CONVERT_TYPE else if FOLD_UNARY then FOLD_UNARY_TYPE else FOLD_BINARY_TYPE
        | FOLD_DIVIDES_ZERO := REDUCE_FOLDS and (TOP_OP = OP_DIV or TOP_OP = OP_MOD) and FOLD_VR = long(0)
        | FOLD_UNSIGNED64 := FOLD_LUB = BUILTIN_ULONG
        | FOLD_DIVISOR := if FOLD_VR = long(0) then long(1) else FOLD_VR
        | FOLD_LESS := if FOLD_UNSIGNED64 then ulong(FOLD_VL) < ulong(FOLD_VR) else FOLD_VL < FOLD_VR
        | FOLD_HOLDS := if TOP_OP = OP_EQ then FOLD_VL = FOLD_VR else if TOP_OP = OP_NE then FOLD_VL /= FOLD_VR
                        else if TOP_OP = OP_LT then FOLD_LESS else if TOP_OP = OP_GE then not FOLD_LESS
                        else if TOP_OP = OP_GT then not FOLD_LESS and FOLD_VL /= FOLD_VR else FOLD_LESS or FOLD_VL = FOLD_VR
        | FOLD_SHIFT_COUNT := if FOLD_VR >= long(0) and FOLD_VR < long(64) then integer(FOLD_VR) else 0
        | FOLD_RAW := if CONVERT_FOLDS then FOLD_VR
                      else if TOP_OP = OP_NEG and FOLD_R_REAL then
                        long(ulong(FOLD_VR) xor (ulong(1) shl (if FOLD_TR = BUILTIN_REAL then 31 else 63)))
                      else if TOP_OP = OP_NEG then -FOLD_VR
                      else if TOP_OP = OP_NOT then
                        (if FOLD_TR = BUILTIN_BOOLEAN then long(1) - FOLD_VR else long(not ulong(FOLD_VR)))
                      else if TOP_OP = OP_CPAIR then long(CX_COUNT[?] + 1)
                      else if TOP_OP = OP_ADD then FOLD_VL + FOLD_VR
                      else if TOP_OP = OP_SUB then FOLD_VL - FOLD_VR
                      else if TOP_OP = OP_MUL then FOLD_VL * FOLD_VR
                      else if TOP_OP = OP_POW then (if FOLD_VR = long(1) then FOLD_VL else POW_PRODUCT)
                      else if TOP_OP = OP_DIV then
                        (if FOLD_UNSIGNED64 then long(ulong(FOLD_VL) / ulong(FOLD_DIVISOR))
                         else if FOLD_DIVISOR = long(-1) then -FOLD_VL else FOLD_VL / FOLD_DIVISOR)
                      else if TOP_OP = OP_MOD then
                        (if FOLD_UNSIGNED64 then long(ulong(FOLD_VL) modulo ulong(FOLD_DIVISOR))
                         else if FOLD_DIVISOR = long(-1) then long(0) else FOLD_VL modulo FOLD_DIVISOR)
                      else if FOLD_COMPARE then long(integer(FOLD_HOLDS))
                      else if TOP_OP = OP_AND then long(ulong(FOLD_VL) and ulong(FOLD_VR))
                      else if TOP_OP = OP_OR then long(ulong(FOLD_VL) or ulong(FOLD_VR))
                      else if TOP_OP = OP_XOR then long(ulong(FOLD_VL) xor ulong(FOLD_VR))
                      else if FOLD_VR < long(0) or FOLD_VR >= long(64) then long(0)
                      else if TOP_OP = OP_SHL then long(ulong(FOLD_VL) shl FOLD_SHIFT_COUNT)
                      else long(ulong(FOLD_VL) shr FOLD_SHIFT_COUNT)
        | FOLD_TYPE_SAFE := if FOLD_TYPE >= 0 and FOLD_TYPE < BUILTIN_TYPE_COUNT then FOLD_TYPE else BUILTIN_SHORT
        | FOLD_BYTES := BUILTIN_BYTES[FOLD_TYPE_SAFE]
        | FOLD_MASK := if FOLD_BYTES = 1 then ulong(255) else if FOLD_BYTES = 2 then ulong(65535) else ulong(4294967295)
        | FOLD_MASKED := long(ulong(FOLD_RAW) and FOLD_MASK)
        | FOLD_HALF := long(FOLD_MASK / ulong(2)) + long(1)
        | FOLD_VALUE := if FOLD_BYTES = 8 or FOLD_TYPE = BUILTIN_BOOLEAN then FOLD_RAW
                        else if BUILTIN_SIGNED[FOLD_TYPE_SAFE] = 1 and FOLD_MASKED >= FOLD_HALF then FOLD_MASKED - long(FOLD_MASK) - long(1)
                        else FOLD_MASKED
        | POST_KEY := if not HAS_PENDING then OP_CONST
                      else if TOP_OP = OP_CALL and TOP_CALLEE = N_LEFT_TT then OP_LEFT_TT
                      else if TOP_OP = OP_CALL and TOP_CALLEE = N_ABS then OP_ABS
                      else if TOP_OP = OP_CALL and (TOP_CALLEE = N_CONJ or TOP_CALLEE = N_CONJD) then OP_CONJ_CALL
                      else if TOP_OP = OP_CALL and (TOP_CALLEE = N_RPART or TOP_CALLEE = N_RPARTD) then OP_RPART_CALL
                      else if TOP_OP = OP_CALL and (TOP_CALLEE = N_IPART or TOP_CALLEE = N_IPARTD) then OP_IPART_CALL
                      else if TOP_OP = OP_CALL and (TOP_CALLEE = N_MODU or TOP_CALLEE = N_MODUD) then OP_MODU_CALL
                      else if TOP_OP = OP_CALL and TOP_CALLEE = N_AFFINE_SAMPLE then OP_AFFINE_SAMPLE
                      else if TOP_OP = OP_CALL and TOP_CALLEE = N_AFFINE_RELATION then OP_AFFINE_RELATION
                      else if TOP_OP = OP_CALL and TOP_CALLEE = N_AFFINE_UNSAMPLE then OP_AFFINE_UNSAMPLE
                      else if TOP_OP = OP_CALL and TOP_CALLEE = N_DIM and not USER_DIM then OP_DIM_CALL
                      else if TOP_OP = OP_CALL and TOP_CALLEE = N_SIZE and not USER_SIZE then (if ARGUMENTS_FOUND = 1 then OP_SIZE_ONE_CALL else OP_SIZE_CALL)
                      else if TOP_OP = OP_CALL and TOP_CALLEE = N_BOUNDS and not USER_BOUNDS then OP_BOUNDS_CALL
                      else if SQUARE_HAS_COMMA then (if CODE1 = C_BACKSLASHES then OP_RECOVER_SQUARE_FLAT else if CODE1 = C_DEFINE then (if LOOP_TARGET[?] then OP_SQUARE_FLAT_NEXT else OP_SQUARE_FLAT_TARGET) else OP_SQUARE_FLAT)
                      else if TOP_OP = OP_OPEN_SQUARE and CODE1 = C_BACKSLASHES then OP_RECOVER_SQUARE else TOP_OP
        | SQUARE_HAS_COMMA := HAS_PENDING and TOP_OP = OP_OPEN_SQUARE and PENDING_COUNT[?][PENDING_TOP] >= 1
        | SQUARE_COMMA_FLATTENS := IN_OPERATOR and OPERATOR_CASE = X_COMMA and SQUARE_HAS_COMMA
        | AFFINE_KEY := POST_KEY = OP_AFFINE_SAMPLE or POST_KEY = OP_AFFINE_RELATION or POST_KEY = OP_AFFINE_UNSAMPLE
        | COMPLEX_CALL := POST_KEY = OP_CONJ_CALL or POST_KEY = OP_RPART_CALL or POST_KEY = OP_IPART_CALL or POST_KEY = OP_MODU_CALL
        | INTRINSIC_CALL := POST_KEY = OP_LEFT_TT or POST_KEY = OP_ABS or AFFINE_KEY or POST_KEY = OP_DIM_CALL or COMPLEX_CALL
                            or POST_KEY = OP_SIZE_CALL or POST_KEY = OP_SIZE_ONE_CALL or POST_KEY = OP_BOUNDS_CALL
        | ARGUMENTS_EXPECTED := if POST_KEY = OP_ABS or POST_KEY = OP_AFFINE_SAMPLE or POST_KEY = OP_DIM_CALL or COMPLEX_CALL
                                   or POST_KEY = OP_SIZE_ONE_CALL then 1
                                else if POST_KEY = OP_BOUNDS_CALL then 3 else 2
        | MISSING_MESSAGE := if TOP_OP = OP_IF_MARK then T_EXPECTED_THEN else if TOP_OP = OP_THEN_MARK then T_EXPECTED_ELSE
                             else T_UNBALANCED
        | INIT_LITERAL_BASE := HERE + 1 + integer(CODE0 /= C_INIT)
        | LITERAL_AT := if IN_OPERATOR then
                          INIT_LITERAL_BASE + integer(integer(TOKEN_CODE[INIT_LITERAL_BASE]) = C_MINUS
                                                      and (integer(TOKEN_CODE[INIT_LITERAL_BASE + 1]) = C_NUMBER
                                                           or integer(TOKEN_CODE[INIT_LITERAL_BASE + 1]) = C_REAL))
                        else HERE + integer((IN_DECLARE_INIT or IN_CASE_COPY or IN_CASE_LITERAL) and CODE0 = C_MINUS and (CODE1 = C_NUMBER or CODE1 = C_REAL))
        | LITERAL_CODE := integer(TOKEN_CODE[LITERAL_AT])
        | LITERAL_NEXT_CODE := integer(TOKEN_CODE[LITERAL_AT + 1])
        | LITERAL_NEGATED := IN_OPERATOR and LITERAL_AT = INIT_LITERAL_BASE + 1 or (IN_DECLARE_INIT or IN_CASE_LITERAL) and LITERAL_AT = HERE + 1
        | LITERAL_IS_REAL := LITERAL_CODE = C_REAL
        | LITERAL_IS_NUMBER := LITERAL_CODE = C_NUMBER or LITERAL_IS_REAL
        | LITERAL_IS_BOOLEAN := LITERAL_CODE = C_TRUE or LITERAL_CODE = C_FALSE
        | LITERAL_IS_TYPED_ENUM := LITERAL_CODE = C_NAME and LITERAL_NEXT_CODE = C_HASH
        | LITERAL_IS_ENUM := LITERAL_IS_TYPED_ENUM or LITERAL_CODE = C_HASH
        | DL_USES := IN_OPERATOR and DL_READY[?]
        | LITERAL_IS_STRING := LITERAL_CODE = C_STRING and not IN_CASE_LITERAL
        | LITERAL_STRING_BYTES := TOKEN_TEXT[LITERAL_AT + 1] - TOKEN_TEXT[LITERAL_AT]
        | LITERAL_IS := DL_USES or LITERAL_IS_NUMBER or LITERAL_IS_BOOLEAN or LITERAL_IS_ENUM or LITERAL_IS_STRING
        | LITERAL_TABLE_STORES := LITERAL_IS_STRING and not DL_USES
                                  and (IN_OPERAND and OPERAND_CASE = X_LITERAL or IN_DECLARE_INIT and CODE0 /= C_OPEN
                                       or IN_OPERATOR and (OPERATOR_CASE = X_DELAY and DELAY_HAS_INIT and not DELAY_PAREN
                                                           or OPERATOR_CASE = X_INIT))
        | LITERAL_VALUE_NAME_AT := if LITERAL_IS_TYPED_ENUM then LITERAL_AT + 2 else LITERAL_AT + 1
        | LITERAL_MESSAGE := if DL_USES then 0 else if LITERAL_IS_NUMBER and TOKEN_BIG[LITERAL_AT] then (if LITERAL_IS_REAL then T_REAL_BIG else T_LITERAL_BIG)
                             else if LITERAL_IS_STRING and LITERAL_STRING_BYTES > STRING_LENGTH_AT then T_STRING_LONG
                             else if LITERAL_IS_ENUM and integer(TOKEN_CODE[LITERAL_VALUE_NAME_AT]) /= C_NAME then T_EXPECTED_NAME
                             else 0
        | LITERAL_MESSAGE_TOKEN := if LITERAL_IS_ENUM then LITERAL_VALUE_NAME_AT else LITERAL_AT
        | LITERAL_NUMBER := TOKEN_VALUE[LITERAL_AT]
        | LITERAL_REAL_SIGN := ulong(1) shl (if TOKEN_KIND[LITERAL_AT] = ubyte(KIND_REAL) then 31 else 63)
        | LITERAL_VALUE := if DL_USES then long(DL_TABLE[?])
                           else if LITERAL_IS_REAL then (if LITERAL_NEGATED then long(ulong(LITERAL_NUMBER) xor LITERAL_REAL_SIGN) else LITERAL_NUMBER)
                           else if LITERAL_IS_NUMBER then (if LITERAL_NEGATED then -LITERAL_NUMBER else LITERAL_NUMBER)
                           else if LITERAL_IS_BOOLEAN then long(integer(LITERAL_CODE = C_TRUE))
                           else if LITERAL_IS_STRING then long(TABLE_COUNT[?])
                           else long(TOKEN_NAME[LITERAL_VALUE_NAME_AT] - 1)
        | LITERAL_TYPE := if DL_USES then DL_TYPE[?] else if LITERAL_IS_BOOLEAN then BUILTIN_BOOLEAN
                          else if LITERAL_IS_STRING then BUILTIN_STRING
                          else if LITERAL_IS_ENUM then (if LITERAL_IS_TYPED_ENUM then NAME_AT_LITERAL else -1)
                          else if TOKEN_KIND[LITERAL_AT] = ubyte(KIND_CHARACTER) then BUILTIN_CHAR
                          else if TOKEN_KIND[LITERAL_AT] = ubyte(KIND_REAL) then BUILTIN_REAL
                          else if TOKEN_KIND[LITERAL_AT] = ubyte(KIND_DREAL) then BUILTIN_DREAL
                          else if LITERAL_NUMBER < long(32768) then BUILTIN_SHORT
                          else if LITERAL_NUMBER < long(2147483648) then BUILTIN_INTEGER else BUILTIN_LONG
        | NAME_AT_LITERAL := TOKEN_NAME[LITERAL_AT] - 1
        | LITERAL_END := if DL_USES then DL_END_AT[?] else if LITERAL_IS_TYPED_ENUM then LITERAL_AT + 3 else if LITERAL_IS_ENUM then LITERAL_AT + 2 else LITERAL_AT + 1
        | DELAY_HAS_INIT := CODE1 = C_INIT
        | DELAY_PAREN := CODE1 = C_INIT and CODE2 = C_OPEN
        | DL_OPEN_AT := HERE + 1 + integer(CODE0 = C_DOLLAR)
        | DELAY_LIST_HERE := IN_OPERATOR and not DL_READY[?]
                             and (CODE0 = C_DOLLAR and CODE1 = C_INIT and CODE2 = C_OPEN_BRACKET
                                  and not (TOP_REDUCIBLE and TOP_PRECEDENCE > DELAY_PRECEDENCE)
                                  or CODE0 = C_INIT and CODE1 = C_OPEN_BRACKET and HAS_PENDING
                                     and (TOP_OP = OP_CELL or TOP_OP = OP_VAR or TOP_OP = OP_GDELAY or TOP_OP = OP_WINDOW))
        | DL_B1 := integer(TOKEN_CODE[DL_OPEN_AT + 1]) = C_OPEN_BRACKET
        | DL_B2 := DL_B1 and integer(TOKEN_CODE[DL_OPEN_AT + 2]) = C_OPEN_BRACKET
        | DL_B3 := DL_B2 and integer(TOKEN_CODE[DL_OPEN_AT + 3]) = C_OPEN_BRACKET
        | DL_B4 := DL_B3 and integer(TOKEN_CODE[DL_OPEN_AT + 4]) = C_OPEN_BRACKET
        | DL_RANK_HERE := 1 + integer(DL_B1) + integer(DL_B2) + integer(DL_B3)
        | DL_OPENS := DELAY_LIST_HERE
        | DL_C1 := CODE0 = C_CLOSE_BRACKET
        | DL_C2 := DL_C1 and CODE1 = C_CLOSE_BRACKET
        | DL_C3 := DL_C2 and CODE2 = C_CLOSE_BRACKET
        | DL_C4 := DL_C3 and CODE3 = C_CLOSE_BRACKET
        | DL_CLOSES_FOUND := integer(DL_C1) + integer(DL_C2) + integer(DL_C3) + integer(DL_C4)
        | DL_CLOSES := if DL_CLOSES_FOUND > DL_RANK[?] then DL_RANK[?] else DL_CLOSES_FOUND
        | DL_ENDS := DL_CLOSES = DL_RANK[?]
        | DL_SEPARATOR := integer(TOKEN_CODE[HERE + DL_CLOSES])
        | DL_COMMA := not DL_ENDS and DL_SEPARATOR = C_COMMA
        | DL_O1 := integer(TOKEN_CODE[HERE + DL_CLOSES + 1]) = C_OPEN_BRACKET
        | DL_O2 := DL_O1 and integer(TOKEN_CODE[HERE + DL_CLOSES + 2]) = C_OPEN_BRACKET
        | DL_O3 := DL_O2 and integer(TOKEN_CODE[HERE + DL_CLOSES + 3]) = C_OPEN_BRACKET
        | DL_O4 := DL_O3 and integer(TOKEN_CODE[HERE + DL_CLOSES + 4]) = C_OPEN_BRACKET
        | DL_OPENS_AFTER := integer(DL_O1) + integer(DL_O2) + integer(DL_O3) + integer(DL_O4)
        | DL_CLOSED4 := DL_RANK[?] >= 4 and DL_CLOSES >= DL_RANK[?] - 3
        | DL_CLOSED3 := DL_RANK[?] >= 3 and DL_CLOSES >= DL_RANK[?] - 2
        | DL_CLOSED2 := DL_RANK[?] >= 2 and DL_CLOSES >= DL_RANK[?] - 1
        | DL_CLOSED1 := DL_CLOSES >= DL_RANK[?]
        | DL_GROUP4 := DL_N4[?] + integer(DL_RANK[?] = 4)
        | DL_GROUP3 := DL_N3[?] + integer(DL_RANK[?] = 3 or DL_CLOSED4)
        | DL_GROUP2 := DL_N2[?] + integer(DL_RANK[?] = 2 or DL_CLOSED3)
        | DL_GROUP1 := DL_N1[?] + integer(DL_RANK[?] = 1 or DL_CLOSED2)
        | DL_RAGGED := DL_CLOSED1 and DL_S1[?] > 0 and DL_S1[?] /= DL_GROUP1 or DL_CLOSED2 and DL_S2[?] > 0 and DL_S2[?] /= DL_GROUP2
                       or DL_CLOSED3 and DL_S3[?] > 0 and DL_S3[?] /= DL_GROUP3 or DL_CLOSED4 and DL_S4[?] > 0 and DL_S4[?] /= DL_GROUP4
        | DL_ELEMENT_MESSAGE := if DL_RAGGED then T_DELAY_INIT_LIST else if DL_ENDS then 0
                                else if not DL_COMMA then T_EXPECTED_FOUND
                                else if DL_OPENS_AFTER /= DL_CLOSES then T_DELAY_INIT_LIST else 0
        | DL_NEW := CONSTANT_VALUE_TYPE[?]
        | DL_OLD := DL_LEAF[?]
        | DL_OLD_SAFE := if DL_OLD >= 0 then DL_OLD else 0
        | DL_NEW_FITS := DL_OLD >= 0
                         and (DL_NEW = DL_OLD
                              or BUILTIN_SIGNED[DL_NEW] = BUILTIN_SIGNED[DL_OLD_SAFE] and BUILTIN_BYTES[DL_NEW] <= BUILTIN_BYTES[DL_OLD_SAFE]
                              or BUILTIN_SIGNED[DL_NEW] = 0 and BUILTIN_SIGNED[DL_OLD_SAFE] = 1
                                 and BUILTIN_BYTES[DL_OLD_SAFE] > BUILTIN_BYTES[DL_NEW])
        | DL_OLD_FITS := DL_OLD < 0
                         or BUILTIN_SIGNED[DL_OLD_SAFE] = BUILTIN_SIGNED[DL_NEW] and BUILTIN_BYTES[DL_OLD_SAFE] <= BUILTIN_BYTES[DL_NEW]
                         or BUILTIN_SIGNED[DL_OLD_SAFE] = 0 and BUILTIN_SIGNED[DL_NEW] = 1
                            and BUILTIN_BYTES[DL_NEW] > BUILTIN_BYTES[DL_OLD_SAFE]
        | DL_SIZE_NOW := ulong(if SIZE_DEPTH[?] = 0 then DL_S1[?] else if SIZE_DEPTH[?] = 1 then DL_S2[?]
                               else if SIZE_DEPTH[?] = 2 then DL_S3[?] else DL_S4[?])
        | DL_SIZES_DONE := SIZE_DEPTH[?] + 1 >= DL_RANK[?]
        | DL_BUCKET := integer((ulong(DL_LEAF[?]) * ulong(40503) + DL_SIZE_NOW * ulong(2654435761)) modulo ulong(BUCKET_CAP))
        | DL_RANK := if DL_OPENS then DL_RANK_HERE else DL_RANK[?]
        | DL_OPERATOR := if DL_OPENS then HERE else DL_OPERATOR[?]
        | DL_ACTIVE := if DL_OPENS then true else if IN_DELAY_LIST_END then false else DL_ACTIVE[?]
        | DL_READY := if IN_DELAY_LIST_END then true else if DL_USES then false else DL_READY[?]
        | DL_N1 := if DL_OPENS or IN_DELAY_ELEMENT and DL_CLOSED1 then 0 else if IN_DELAY_ELEMENT then DL_GROUP1 else DL_N1[?]
        | DL_N2 := if DL_OPENS or IN_DELAY_ELEMENT and DL_CLOSED2 then 0 else if IN_DELAY_ELEMENT then DL_GROUP2 else DL_N2[?]
        | DL_N3 := if DL_OPENS or IN_DELAY_ELEMENT and DL_CLOSED3 then 0 else if IN_DELAY_ELEMENT then DL_GROUP3 else DL_N3[?]
        | DL_N4 := if DL_OPENS or IN_DELAY_ELEMENT and DL_CLOSED4 then 0 else if IN_DELAY_ELEMENT then DL_GROUP4 else DL_N4[?]
        | DL_S1 := if DL_OPENS then 0 else if IN_DELAY_ELEMENT and DL_CLOSED1 and DL_S1[?] = 0 then DL_GROUP1 else DL_S1[?]
        | DL_S2 := if DL_OPENS then 0 else if IN_DELAY_ELEMENT and DL_CLOSED2 and DL_S2[?] = 0 then DL_GROUP2 else DL_S2[?]
        | DL_S3 := if DL_OPENS then 0 else if IN_DELAY_ELEMENT and DL_CLOSED3 and DL_S3[?] = 0 then DL_GROUP3 else DL_S3[?]
        | DL_S4 := if DL_OPENS then 0 else if IN_DELAY_ELEMENT and DL_CLOSED4 and DL_S4[?] = 0 then DL_GROUP4 else DL_S4[?]
        | DL_LEAF := if DL_OPENS then -1
                     else if IN_DELAY_ELEMENT then (if DL_NEW_FITS then DL_OLD else if DL_OLD_FITS then DL_NEW else BUILTIN_LONG)
                     else DL_LEAF[?]
        | DL_END_AT := if IN_DELAY_ELEMENT and DL_ENDS then HERE + DL_CLOSES else DL_END_AT[?]
        | DL_TABLE := if IN_DELAY_LIST_END then TABLE_COUNT[?] else DL_TABLE[?]
        | DL_TYPE := if IN_DELAY_LIST_END then PARSED_TYPE[?] else DL_TYPE[?]
        | INIT_IS_NAME := not LITERAL_IS and LITERAL_CODE = C_NAME
        | DELAY_NAME_INIT := DELAY_HAS_INIT and INIT_IS_NAME
        | DECLARE_INIT_MESSAGE := if CODE0 = C_OPEN then 0
                                else if CODE0 = C_OPEN_BRACKET then (if not DECLARED_ARRAY then T_CONSTANT_LIST else if not LIST_OPENS_OK then T_CONSTANT_SHAPE else 0)
                                else if LITERAL_IS then LITERAL_MESSAGE else if INIT_IS_NAME then 0 else T_DELAY_INITIAL
        | CALL_HEAD_HERE := (CODE0 = C_NAME or CODE0 >= C_EVENT and CODE0 <= C_LONG)
                            and (CODE1 = C_OPEN or CODE1 = C_OPEN_BRACE and not VALUE_BRACE[HERE + 1])
        | EMPTY_CALL := CODE0 = C_CLOSE and HAS_PENDING and TOP_OP = OP_CALL and integer(TOKEN_CODE[HERE - 1]) = C_OPEN
        | OPERAND_CASE := if EMPTY_CALL then X_EMPTY_CALL
                          else if LITERAL_IS then X_LITERAL
                          else if CALL_HEAD_HERE then (if CODE1 = C_OPEN then X_CALL else X_PARAMETERS)
                          else if CODE0 = C_NAME then X_SIGNAL
                          else if CODE0 = C_OPEN or CODE0 = C_OPEN_BRACKET and OPERAND_LIST_ON and HERE = OPERAND_LIST_AT[?] then X_OPEN_PAREN
                          else if CODE0 = C_IF then X_IF
                          else if PREFIX_PRECEDENCE[CODE0] > 0 then X_PREFIX
                          else if CODE0 = C_PLUS then X_PLUS
                          else if CODE0 = C_OPEN_BRACKET then X_ENUM
                          else X_FAIL
        | OPERAND_MESSAGE := if OPERAND_CASE = X_LITERAL then LITERAL_MESSAGE
                             else if OPERAND_CASE = X_PREFIX and IS_SAFE and OP_TEMPLATE_KIND[PREFIX_OP[CODE0]] > 0 then T_FUNCTION_MEMORY
                             else if OPERAND_CASE = X_EMPTY_CALL and INTRINSIC_CALL then T_WRONG_ARGUMENTS
                             else if OPERAND_CASE = X_ENUM and ENUM_DEPTH[?] >= 4 then T_RANK
                             else if OPERAND_CASE = X_FAIL then T_EXPECTED_EXPRESSION else 0
        | STEP_HERE := CODE0 = C_NAME and NAME0 = N_STEP
        | DEFINE_PAIR_HERE := CODE0 = C_DEFINE and HERE > 0 and integer(TOKEN_CODE[HERE - 1]) = C_CLOSE_BRACKET
        | WINDOW_HERE := CODE0 = C_NAME and NAME0 = N_WINDOW
        | GDELAY_HERE := CODE0 = C_DOLLAR and (CODE1 = C_NUMBER or CODE1 = C_OPEN or CODE1 = C_NAME and NAME1 /= N_STEP and NAME1 /= N_WINDOW)
        | NEXT_TUPLE_COMMA := CODE0 = C_COMMA and OPENER_NOW >= 0 and OPENER_OP = OP_OPEN_PAREN and PENDING_TOKEN[?][OPENER_NOW] > 0
                              and (integer(TOKEN_CODE[PENDING_TOKEN[?][OPENER_NOW] - 1]) = C_NEXT or OPERAND_LIST_ON and PENDING_TOKEN[?][OPENER_NOW] = OPERAND_LIST_AT[?])
        | BINARY_HERE := if AXIS_ANGLE_ENDS and OPENER_NOW < 0 then 0 else if STEP_HERE or DEFINE_PAIR_HERE or NEXT_TUPLE_COMMA then 1 else if WINDOW_HERE or GDELAY_HERE then DELAY_PRECEDENCE else BINARY_PRECEDENCE[CODE0]
        | HERE_BINARY_OP := if STEP_HERE then OP_STEP else if DEFINE_PAIR_HERE then (if LOOP_TARGET[?] then OP_ELEMENT_PAIR else OP_PAIR)
                            else if NEXT_TUPLE_COMMA then OP_FLAT else if WINDOW_HERE then OP_WINDOW
                            else if GDELAY_HERE then OP_GDELAY else BINARY_OP[CODE0]
        | IS_TERMINATOR := CODE0 = C_BAR or CODE0 = C_BAR_CLOSE or CODE0 = C_SEMICOLON or IS_RELATION_CODE or CODE0 = C_OF
                           or CODE0 = C_WITH or CODE0 = C_END or CODE0 = C_COLONS or CODE0 = C_CLOSE
                           or CODE0 = C_COMMA and TUPLE_ACTIVE and OPENER_NOW < 0 or CODE0 = C_IN or AXIS_ANGLE_ENDS and OPENER_NOW < 0
                           or SEQ_ON[?] and OPENER_NOW < 0 and (CODE0 = C_COMMA or CODE0 = C_CLOSE_BRACKET)
                           or TUPLE_LIST_ON[?] and OPENER_NOW < 0 and (CODE0 = C_COMMA or CODE0 = C_CLOSE)
                           or CODE0 = C_COMMA and OPENER_NOW < 0 and (EXPRESSION_RETURN[?] = P_CONSTANT_END or EXPRESSION_RETURN[?] = P_INIT_END)
                           or (CODE0 = C_OPEN_BRACE or CODE0 = C_ELSE) and CASE_DEPTH[?] > 0
        | INDEX_CHAINS := CODE0 = C_CLOSE_BRACKET and CODE1 = C_OPEN_BRACKET and CODE2 /= C_QUESTION
                          and OPENER_NOW >= 0 and OPENER_OP = OP_OPEN_SQUARE
        | OPERATOR_CASE := if DELAY_LIST_HERE then X_INIT_LIST
                           else if BINARY_HERE > 0 then (if TOP_REDUCIBLE and TOP_PRECEDENCE >= BINARY_HERE then X_REDUCE else X_BINARY)
                           else if (CODE0 = C_THEN or CODE0 = C_ELSE) and OPENER_NOW >= 0 then
                             (if TOP_REDUCIBLE then X_REDUCE
                              else if CODE0 = C_THEN then (if TOP_OP = OP_IF_MARK then X_THEN else X_FAIL)
                              else if TOP_OP = OP_THEN_MARK then X_ELSE else X_FAIL)
                           else if CODE0 = C_DOLLAR then (if TOP_REDUCIBLE and TOP_PRECEDENCE > DELAY_PRECEDENCE then X_REDUCE else X_DELAY)
                           else if CODE0 = C_INIT and HAS_PENDING then
                             (if TOP_OP = OP_CELL or TOP_OP = OP_VAR or TOP_OP = OP_GDELAY or TOP_OP = OP_WINDOW then X_INIT
                              else if TOP_REDUCIBLE and TOP_PRECEDENCE > DELAY_PRECEDENCE then X_REDUCE else X_FAIL)
                           else if CODE0 = C_OPEN_BRACKET and CODE1 = C_QUESTION then X_PREVIOUS
                           else if CODE0 = C_QUESTION and ENTRY_COUNT[?] > EXPRESSION_START[?]
                                   and integer(ENTRY_OP[?][ENTRY_COUNT[?] - 1]) = OP_SIGNAL then X_STATE
                           else if CODE0 = C_OPEN_BRACKET then X_OPEN_SQUARE
                           else if INDEX_CHAINS then (if PENDING_TOP /= OPENER_NOW then X_REDUCE else X_COMMA)
                           else if (CODE0 = C_CLOSE or CODE0 = C_CLOSE_BRACKET) and OPENER_NOW >= 0 then
                             (if TOP_REDUCIBLE then X_REDUCE
                              else if TOP_OP = OP_IF_MARK or TOP_OP = OP_THEN_MARK or (OP_BRACKETED[TOP_OP] = 1 or OPERAND_LIST_TOP) /= (CODE0 = C_CLOSE_BRACKET)
                              then X_FAIL else X_CLOSE)
                           else if CODE0 = C_COMMA and OPENER_NOW >= 0 and (OPENER_OP = OP_CALL or OPENER_OP = OP_OPEN_SQUARE or OPENER_OP = OP_ENUM) then
                             (if PENDING_TOP /= OPENER_NOW then X_REDUCE else X_COMMA)
                           else if IS_TERMINATOR then
                             (if not HAS_PENDING then X_RETURN else if TOP_IS_OPENER then X_FAIL else X_REDUCE)
                           else X_FAIL
        | DELAY_MESSAGE := if not DELAY_HAS_INIT or DELAY_NAME_INIT or DELAY_PAREN then 0 else if not LITERAL_IS then T_DELAY_INITIAL else LITERAL_MESSAGE
        | OPERATOR_FAIL_MESSAGE := if (CODE0 = C_THEN or CODE0 = C_ELSE) and OPENER_NOW >= 0
                                      or (CODE0 = C_CLOSE or CODE0 = C_CLOSE_BRACKET) and OPENER_NOW >= 0
                                      or IS_TERMINATOR then MISSING_MESSAGE
                                   else if OPENER_NOW >= 0 and OPENER_OP = OP_IF_MARK then T_EXPECTED_THEN
                                   else if OPENER_NOW >= 0 and OPENER_OP = OP_THEN_MARK then T_EXPECTED_ELSE
                                   else T_EXPECTED_OPERATOR
        | TEMPLATE_INIT := IN_OPERATOR and OPERATOR_CASE = X_INIT
        | INIT_MESSAGE := if INIT_IS_NAME then 0 else if not LITERAL_IS then T_DELAY_INITIAL else LITERAL_MESSAGE
        | VAR_OPERAND_BAD := REDUCES and TOP_OP = OP_VAR
                             and (ENTRY_COUNT[?] - PENDING_RIGHT_START[?][PENDING_TOP] /= 1
                                  or integer(ENTRY_OP[?][ENTRY_COUNT[?] - 1]) /= OP_SIGNAL)
        | REPEAT_WHOLE := EXPRESSION_RETURN[?] = P_EQUATION_END and REPEAT_SEEN[?] = 1 and TARGET[?] >= 0 and not TUPLE_ACTIVE
                          and LAST_ENTRY >= EXPRESSION_START[?] and integer(ENTRY_OP[?][LAST_ENTRY]) = OP_REPEAT
        | REPEAT_MISPLACED := IN_OPERATOR and OPERATOR_CASE = X_RETURN and REPEAT_SEEN[?] > 0 and not REPEAT_WHOLE
        | OPERATOR_MESSAGE := if OPERATOR_CASE = X_INIT_LIST then (if DL_B4 then T_RANK else 0)
                              else if OPERATOR_CASE = X_FAIL then OPERATOR_FAIL_MESSAGE
                              else if FOLD_DIVIDES_ZERO then T_CONSTANT_DIVIDE
                              else if POW_MESSAGE /= 0 then POW_MESSAGE
                              else if AT_CHAINS then T_AT_CHAIN
                              else if INIT_PAREN_FAILS then T_INIT_EXPRESSION
                              else if CONVERT_NOT_INTEGER then T_CONVERSION
                              else if REPEAT_MISPLACED then T_WHOLE_DEFINITION
                              else if VAR_OPERAND_BAD then T_VAR_NAME
                              else if OPERATOR_CASE = X_INIT then INIT_MESSAGE
                              else if OPERATOR_CASE = X_BINARY and IS_SAFE
                                      and (OP_TEMPLATE_KIND[HERE_BINARY_OP] > 0 or HERE_BINARY_OP = OP_GDELAY or HERE_BINARY_OP = OP_WINDOW) then T_FUNCTION_MEMORY
                              else if OPERATOR_CASE = X_DELAY then (if IS_SAFE then T_FUNCTION_MEMORY else DELAY_MESSAGE)
                              else if OPERATOR_CASE = X_PREVIOUS and CODE2 /= C_CLOSE_BRACKET then T_EXPECTED_FOUND
                              else if OPERATOR_CASE = X_CLOSE and INTRINSIC_CALL and ARGUMENTS_FOUND /= ARGUMENTS_EXPECTED then T_WRONG_ARGUMENTS
                              else if OPERATOR_CASE = X_CLOSE and RECOVER_KEY then RECOVER_ARRAY_MESSAGE
                              else if OPERATOR_CASE = X_BINARY and HERE_BINARY_OP = OP_RECOVER and not RECOVER_READY[?] then T_RECOVERY_ACCESS
                              else 0
        | PARAMETER_MESSAGE := if NEGATIVE_PARAMETER or CODE0 = C_NAME or CODE0 = C_NUMBER or CODE0 >= 1 and CODE0 < C_SYMBOL_BASE then 0
                               else T_STATIC_PARAMETER
        | CALL_HEAD_NAME := TOKEN_NAME[CALL_HEAD[?]] - 1
        | NEGATIVE_PARAMETER := IN_PARAMETER and CODE0 = C_MINUS and CODE1 = C_NUMBER
                                and (CALL_HEAD_NAME = N_AFFINE_SAMPLE or CALL_HEAD_NAME = N_AFFINE_RELATION or CALL_HEAD_NAME = N_AFFINE_UNSAMPLE)
        | PARAMETER_CLOSE_MESSAGE := if CODE0 /= C_CLOSE_BRACE or CODE1 /= C_OPEN then T_EXPECTED_FOUND else 0
        | REDUCES := IN_OPERATOR and (OPERATOR_CASE = X_REDUCE or OPERATOR_CASE = X_INIT)
        | INIT_PAREN_PUSH := IN_OPERAND and OPERAND_CASE = X_OPEN_PAREN
                             and integer(TOKEN_CODE[HERE - 1]) = C_INIT and integer(TOKEN_CODE[HERE - 2]) = C_DOLLAR
        | INIT_PAREN_CLOSE := IN_OPERATOR and OPERATOR_CASE = X_CLOSE and TOP_OP = OP_OPEN_PAREN
                              and integer(TOKEN_CODE[TOP_TOKEN - 1]) = C_INIT and integer(TOKEN_CODE[TOP_TOKEN - 2]) = C_DOLLAR
        | INIT_PAREN_OK := RIGHT_IS_CONST and FOLD_RIGHT = PENDING_RIGHT_START[?][PENDING_TOP] and ENTRY_OP[?][FOLD_L] = OP_DELAY
        | INIT_PATCH := INIT_PAREN_CLOSE and INIT_PAREN_OK
        | INIT_PAREN_FAILS := INIT_PAREN_CLOSE and not INIT_PAREN_OK
        | CLOSES_OPENER := IN_OPERATOR and OPERATOR_CASE = X_CLOSE or IN_OPERAND and OPERAND_CASE = X_EMPTY_CALL
        | PUSHES_PENDING := IN_OPERAND and (OPERAND_CASE = X_CALL or OPERAND_CASE = X_OPEN_PAREN or OPERAND_CASE = X_IF
                                            or OPERAND_CASE = X_PREFIX or OPERAND_CASE = X_ENUM)
                            or IN_PARAMETER_CLOSE and PARAMETER_CLOSE_MESSAGE = 0
                            or IN_OPERATOR and (OPERATOR_CASE = X_BINARY and STAGE_DONE or OPERATOR_CASE = X_OPEN_SQUARE)
                            or IN_BRANCH
        | UPDATES_PENDING := IN_OPERATOR and (OPERATOR_CASE = X_THEN or OPERATOR_CASE = X_ELSE or OPERATOR_CASE = X_COMMA)
        | POPS_PENDING := (REDUCES or CLOSES_OPENER) and STAGE_DONE
        | PRE_STAGING := IN_OPERATOR and OPERATOR_CASE = X_BINARY
        | INDEX_STAGING := IN_INDEX_EMIT or IN_REPEAT_EMIT or IN_SEQ_EMIT or IN_TUPLE_EMIT
        | STAGE_KEY := if PRE_STAGING then HERE_BINARY_OP
                       else if IN_INDEX_EMIT then (if INDEX_IS_ARRAY[?] then OP_ARRAY_RANGE else if SEQ_ON[?] then SEQ_RANGE_KEY else OP_REPEAT_RANGE)
                       else if IN_REPEAT_EMIT then OP_REPEAT_BODY else if IN_SEQ_EMIT then SEQ_STAGE_KEY
                       else if IN_TUPLE_EMIT then (if TUPLE_PHASE[?] = 0 then OP_TUPLE_HEAD else OP_TUPLE_TAIL) else POST_KEY
        | STAGE_LENGTH := if POW_TOP and not POW_STAGES then 0 else if PRE_STAGING then OP_PRE_LENGTH[STAGE_KEY] else OP_POST_LENGTH[STAGE_KEY]
        | STAGE_START := if PRE_STAGING then OP_PRE_START[STAGE_KEY] else OP_POST_START[STAGE_KEY]
        | STAGING := (PRE_STAGING or REDUCES or CLOSES_OPENER or INDEX_STAGING) and STAGE_LENGTH > 0
        | STAGE_ITEM := STAGE_OP[STAGE_START + STAGE_INDEX[?]]
        | COPIES_INDEX := STAGE_ITEM = OP_INDEX_OPERAND
        | COPYING := STAGING and (STAGE_ITEM = OP_OPERAND or COPIES_INDEX or STAGE_ITEM = OP_RIGHT_OPERAND) or CASE_COPYING
        | INDEX_FRESH := STAGE_INDEX[?] = 0 and COPY_I[?] = 0
        | INDEX_BOUND_AT := if IN_REPEAT_START then ENTRY_SPLIT[?][LAST_ENTRY]
                            else if IN_INDEX_EMIT and INDEX_IS_ARRAY[?] and INDEX_FRESH then EXPRESSION_START[?]
                            else if SEQ_INDEX_FRESH then ENTRY_COUNT[?] + 1 else INDEX_BOUND_AT[?]
        | INDEX_BOUND_END := if IN_REPEAT_START then LAST_ENTRY
                             else if IN_INDEX_EMIT and INDEX_IS_ARRAY[?] and INDEX_FRESH then ENTRY_COUNT[?]
                             else if SEQ_INDEX_FRESH then ENTRY_COUNT[?] + 2 else INDEX_BOUND_END[?]
        | COPY_BASE := if IN_INDEX_EMIT then INDEX_BOUND_AT else if IN_REPEAT_EMIT then REPEAT_E_START[?]
                       else if IN_CASE_COPY then CASE_TOP_START else if IN_CASE_ELSE_VALUE then CASE_VALUE_ENTRY[?][CASE_WALK[?]]
                       else if COPIES_INDEX then (if PRE_STAGING then RECOVER_INDEX_START[?] else PENDING_INDEX_START[?][PENDING_TOP])
                       else if TOP_IS_OPENER or STAGE_ITEM = OP_RIGHT_OPERAND then PENDING_RIGHT_START[?][PENDING_TOP]
                       else if PENDING_TOP >= 1 then PENDING_RIGHT_START[?][PENDING_TOP - 1] else EXPRESSION_START[?]
        | STAGE_BASE := if STAGE_INDEX[?] = 0 and COPY_I[?] = 0 then ENTRY_COUNT[?] else STAGE_BASE[?]
        | COPY_END := if IN_INDEX_EMIT then INDEX_BOUND_END else if IN_REPEAT_EMIT then INDEX_BOUND_AT
                      else if IN_CASE_COPY then CASE_TOP_END else if IN_CASE_ELSE_VALUE then COPY_BASE + 1
                      else if COPIES_INDEX then (if PRE_STAGING then RECOVER_INDEX_END[?] else PENDING_INDEX_END[?][PENDING_TOP])
                      else if TOP_IS_OPENER or STAGE_ITEM = OP_RIGHT_OPERAND then STAGE_BASE
                      else PENDING_LEFT_END[?][PENDING_TOP]
        | COPY_FROM := COPY_BASE + COPY_I[?]
        | STAGE_ADVANCES := not COPYING or COPY_FROM + 1 >= COPY_END
        | STAGE_DONE := (STAGE_LENGTH = 0 or STAGE_INDEX[?] = STAGE_LENGTH - 1 and STAGE_ADVANCES) and not POW_MORE
        | STAGE_INDEX := if STAGING and not STAGE_DONE then (if POW_ROUND_ENDS then 0 else STAGE_INDEX[?] + integer(STAGE_ADVANCES)) else 0
        | COPY_I := if COPYING and not STAGE_ADVANCES then COPY_I[?] + 1 else 0
        | RECOVER_KEY := POST_KEY = OP_RECOVER_SQUARE or POST_KEY = OP_RECOVER_SQUARE_FLAT
        | RECOVERED_CLOSE := CLOSES_OPENER and RECOVER_KEY
        | RECOVER_LATCH := RECOVERED_CLOSE and STAGE_INDEX[?] = 0
        | RECOVER_LEVELS := if RECOVER_LATCH then (if POST_KEY = OP_RECOVER_SQUARE_FLAT then PENDING_COUNT[?][PENDING_TOP] + 1 else 1)
                          else RECOVER_LEVELS[?]
        | RECOVER_ARRAY_AT := PENDING_OPEN_AT[?][PENDING_TOP] - 1
        | RECOVER_INDEX_START := if RECOVER_LATCH then RECOVER_ARRAY_AT + 1 else RECOVER_INDEX_START[?]
        | RECOVER_INDEX_END := if RECOVER_LATCH then ENTRY_COUNT[?] + integer(POST_KEY = OP_RECOVER_SQUARE_FLAT) else RECOVER_INDEX_END[?]
        | RECOVER_ARRAY := if RECOVER_LATCH then ENTRY_NAME[?][RECOVER_ARRAY_AT] else RECOVER_ARRAY[?]
        | RECOVER_ARRAY_TOKEN := if RECOVER_LATCH then ENTRY_TOKEN[?][RECOVER_ARRAY_AT] else RECOVER_ARRAY_TOKEN[?]
        | RECOVER_READY := if RECOVERED_CLOSE and STAGE_DONE then true else if IN_OPERAND or REDUCES then false else RECOVER_READY[?]
        | RECOVER_ARRAY_MESSAGE := if RECOVER_ARRAY_AT < EXPRESSION_START[?] or integer(ENTRY_OP[?][RECOVER_ARRAY_AT]) /= OP_SIGNAL
                                   then T_RECOVERY_ACCESS else 0
        | EMITS_SIZE := STAGING and (STAGE_ITEM = OP_SIZE or STAGE_ITEM = OP_SIZE_LESS)
        | COPY_OFFSET := ENTRY_COUNT[?] - COPY_FROM - integer(POW_OVERWRITES)
        | ARGUMENTS_FOUND := if IN_OPERAND then 0 else PENDING_COUNT[?][PENDING_TOP] + 1
        | LEFT_TT_FALSE := IN_OPERATOR and OPERATOR_CASE = X_COMMA and POST_KEY = OP_LEFT_TT
        | EMITS_ZERO := LEFT_TT_FALSE or STAGING and STAGE_ITEM = OP_ZERO
        | EMITS_ONE := STAGING and STAGE_ITEM = OP_ONE
        | EMITS_NAMED := STAGING and (STAGE_ITEM = OP_TARGET_SIGNAL or STAGE_ITEM = OP_INDEX_SIGNAL or STAGE_ITEM = OP_SEQ_HIDDEN
                                      or STAGE_ITEM = OP_SEQ_PREVIOUS or STAGE_ITEM = OP_SEQ_INDEX or STAGE_ITEM = OP_TUPLE_TARGET
                                      or STAGE_ITEM = OP_TUPLE_OUTPUT)
        | STAGE_KIND := if COPYING then integer(ENTRY_OP[?][COPY_FROM]) else if EMITS_ZERO or EMITS_SIZE or EMITS_ONE then OP_CONST
                        else if SEQ_EMITS_FIELD then (if SEQ_FIELD_NAME >= 0 then OP_SIGNAL else OP_CONST)
                        else if EMITS_NAMED then OP_SIGNAL else STAGE_ITEM
        | PUSHED_OP := if IN_OPERAND then
                         (if OPERAND_CASE = X_CALL then OP_CALL else if OPERAND_CASE = X_OPEN_PAREN then OP_OPEN_PAREN
                          else if OPERAND_CASE = X_IF then OP_IF_MARK else if OPERAND_CASE = X_ENUM then OP_ENUM else PREFIX_OP[CODE0])
                       else if IN_PARAMETER_CLOSE then OP_CALL
                       else if IN_BRANCH then OP_BRANCH
                       else if OPERATOR_CASE = X_OPEN_SQUARE then OP_OPEN_SQUARE
                       else if OPERATOR_CASE = X_BINARY then HERE_BINARY_OP
                       else if OPERATOR_CASE = X_THEN then OP_THEN_MARK
                       else if OPERATOR_CASE = X_ELSE then OP_IF
                       else TOP_OP
        | PUSHED_PRECEDENCE := if IN_OPERAND then (if OPERAND_CASE = X_PREFIX then PREFIX_PRECEDENCE[CODE0] else 0)
                               else if IN_BRANCH or OPERATOR_CASE = X_ELSE then CONDITION_PRECEDENCE
                               else if OPERATOR_CASE = X_BINARY then BINARY_HERE
                               else if OPERATOR_CASE = X_OPEN_SQUARE then 0
                               else TOP_PRECEDENCE
        | PUSHED_TOKEN := if IN_PARAMETER_CLOSE then CALL_HEAD[?] else if IN_BRANCH or UPDATES_PENDING then TOP_TOKEN else HERE
        | PUSHED_COUNT := if OPERATOR_CASE = X_COMMA and IN_OPERATOR then PENDING_COUNT[?][PENDING_TOP] + 1
                          else if UPDATES_PENDING then PENDING_COUNT[?][PENDING_TOP] else 0
        | PUSHED_PARAMETERS := if IN_PARAMETER_CLOSE then PARAMETER_START[?] else if UPDATES_PENDING then PENDING_PARAMETERS[?][PENDING_TOP] else -1
        | PUSHED_PARAMETER_COUNT := if IN_PARAMETER_CLOSE then PARAMETER_COUNT[?]
                                    else if UPDATES_PENDING then PENDING_PARAMETER_COUNT[?][PENDING_TOP] else 0
        | PUSHED_OPENER := OP_IS_OPENER[PUSHED_OP] = 1
        | PENDING_SLOT := if PUSHES_PENDING then PENDING_DEPTH[?] else if UPDATES_PENDING then PENDING_TOP else -1
        | PENDING_OP := PENDING_OP[?] next PENDING_SLOT : PUSHED_OP
        | PENDING_PRECEDENCE := PENDING_PRECEDENCE[?] next PENDING_SLOT : PUSHED_PRECEDENCE
        | PENDING_TOKEN := PENDING_TOKEN[?] next PENDING_SLOT : PUSHED_TOKEN
        | PENDING_COUNT := PENDING_COUNT[?] next PENDING_SLOT : PUSHED_COUNT
        | PENDING_PARAMETERS := PENDING_PARAMETERS[?] next PENDING_SLOT : PUSHED_PARAMETERS
        | PENDING_PARAMETER_COUNT := PENDING_PARAMETER_COUNT[?] next PENDING_SLOT : PUSHED_PARAMETER_COUNT
        | PUSHED_FOLDS := INIT_PAREN_PUSH or HAS_PENDING and PENDING_FOLDS[?][PENDING_TOP]
        | PENDING_FOLDS := PENDING_FOLDS[?] next PENDING_SLOT : PUSHED_FOLDS
        | PUSHED_SPLIT := if IN_OPERATOR and OPERATOR_CASE = X_COMMA and PENDING_COUNT[?][PENDING_TOP] = 1 then ENTRY_COUNT[?]
                          else if UPDATES_PENDING then PENDING_SPLIT[?][PENDING_TOP] else -1
        | PENDING_SPLIT := PENDING_SPLIT[?] next PENDING_SLOT : PUSHED_SPLIT
        | PENDING_RIGHT_START := PENDING_RIGHT_START[?] next PENDING_SLOT : ENTRY_COUNT[?] + integer(APPENDS_ENTRY)
        | PENDING_LEFT_END := PENDING_LEFT_END[?] next PENDING_SLOT : STAGE_BASE
        | PENDING_INDEX_START := PENDING_INDEX_START[?] next PENDING_SLOT : RECOVER_INDEX_START[?]
        | PENDING_INDEX_END := PENDING_INDEX_END[?] next PENDING_SLOT : RECOVER_INDEX_END[?]
        | PENDING_OPENER_BELOW := PENDING_OPENER_BELOW[?] next (if PUSHES_PENDING then PENDING_DEPTH[?] else -1) : OPENER_NOW
        | PENDING_OPEN_AT := PENDING_OPEN_AT[?] next (if PUSHES_PENDING then PENDING_DEPTH[?] else -1) : ENTRY_COUNT[?] + integer(APPENDS_ENTRY)
        | PENDING_DEPTH := PENDING_DEPTH[?] + integer(PUSHES_PENDING) - integer(POPS_PENDING)
        | OPENER_TOP := if PUSHES_PENDING and PUSHED_OPENER then PENDING_DEPTH[?]
                        else if CLOSES_OPENER and STAGE_DONE or IN_OPERATOR and OPERATOR_CASE = X_ELSE then PENDING_OPENER_BELOW[?][PENDING_TOP]
                        else OPENER_NOW
        | CONSTANT_LEAF := IN_OPERAND and OPERAND_CASE = X_SIGNAL and CONSTANT_PARSE and NAME_IS_SCALAR_CONSTANT
                           or IN_CASE_LITERAL and not LITERAL_IS and NAME_IS_SCALAR_CONSTANT
        | ENTRY_KIND := if FOLDS_NOW then OP_CONST else if INIT_PATCH then OP_DELAY else if POW_HOLDS then -1
                        else if IN_OPERAND then
                          (if OPERAND_CASE = X_EMPTY_CALL then OP_CALL
                           else if OPERAND_CASE = X_LITERAL then (if LITERAL_IS_ENUM then OP_ENUMCONST else OP_CONST)
                           else if OPERAND_CASE = X_SIGNAL then (if CONSTANT_LEAF then OP_CONST else OP_SIGNAL)
                           else if OPERAND_CASE = X_ENUM and ENUM_DEPTH[?] = 0 then OP_DEFAULTS else -1)
                        else if IN_OPERATOR then
                          (if OPERATOR_CASE = X_REDUCE or OPERATOR_CASE = X_INIT then
                             (if STAGE_LENGTH > 0 then STAGE_KIND else if TOP_OP = OP_RANGE and STEP_HERE then OP_SPAN
                              else if TOP_OP = OP_RANGE and OPENER_NOW >= 0 and OPENER_OP = OP_OPEN_SQUARE then OP_RANGE_TABLE else TOP_OP)
                           else if OPERATOR_CASE = X_CLOSE then
                             (if STAGE_LENGTH > 0 then STAGE_KIND else if TOP_OP = OP_CALL then (if AFFINE_KEY then POST_KEY else OP_CALL)
                              else if TOP_OP = OP_OPEN_SQUARE then
                                (if integer(TOKEN_CODE[HERE + 1]) = C_DEFINE then (if LOOP_TARGET[?] then -1 else OP_TARGET_INDEX) else OP_INDEX)
                              else if ENUM_PUTS then OP_PUT else -1)
                           else if OPERATOR_CASE = X_BINARY then (if STAGE_LENGTH > 0 then STAGE_KIND else -1)
                           else if LEFT_TT_FALSE then OP_CONST
                           else if SQUARE_COMMA_FLATTENS then OP_FLAT
                           else if ENUM_PUTS then OP_PUT
                           else if OPERATOR_CASE = X_DELAY then OP_DELAY
                           else if LOOP_TARGET_OPENS or OPERATOR_CASE = X_PREVIOUS then OP_PREV
                           else if OPERATOR_CASE = X_STATE then OP_STATE
                           else if OPERATOR_CASE = X_RETURN and TUPLE_AXIS[?] and TUPLE_ACTIVE then OP_AXIS else -1)
                        else if CASE_COPYING or INDEX_STAGING then STAGE_KIND
                        else if IN_CASE_LITERAL then
                          (if LITERAL_IS_ENUM then OP_ENUMCONST else if LITERAL_IS or CONSTANT_LEAF then OP_CONST else OP_SIGNAL)
                        else if IN_CASE_COMPARE then (if CASE_ELSE_BRANCH[?] then OP_NE else OP_EQ)
                        else if IN_CASE_JOIN then (if CASE_ELSE_BRANCH[?] then OP_AND else OP_OR)
                        else if IN_CASE_WHEN or IN_STATE_WHEN then OP_UWHEN
                        else if IN_STATE_SIGNAL or IN_SYNC then OP_SIGNAL
                        else if IN_STATE_CALL then OP_CALL
                        else -1
        | APPENDS_ENTRY := ENTRY_KIND >= 0
        | ENUM_OPENS := IN_OPERAND and OPERAND_CASE = X_ENUM
        | ENUM_COMMA := IN_OPERATOR and OPERATOR_CASE = X_COMMA and TOP_OP = OP_ENUM
        | ENUM_CLOSE := IN_OPERATOR and OPERATOR_CASE = X_CLOSE and TOP_OP = OP_ENUM
        | ENUM_PUTS := (ENUM_COMMA or ENUM_CLOSE) and ENUM_CLOSED_AT[?] /= HERE - 1
        | ENUM_UNIT := long(ulong(1) shl (15 * (ENUM_DEPTH[?] - 1)))
        | ENUM_COMPONENT := ENUM_PATH[?] / ENUM_UNIT modulo long(32768)
        | ENUM_DEPTH := ENUM_DEPTH[?] + integer(ENUM_OPENS) - integer(ENUM_CLOSE)
        | ENUM_PATH := if ENUM_COMMA then ENUM_PATH[?] + ENUM_UNIT else if ENUM_CLOSE then ENUM_PATH[?] modulo ENUM_UNIT else ENUM_PATH[?]
        | ENUM_CLOSED_AT := if ENUM_CLOSE then HERE else ENUM_CLOSED_AT[?]
        | CALL_LIKE := ENTRY_KIND = OP_CALL or ENTRY_KIND = OP_AFFINE_SAMPLE or ENTRY_KIND = OP_AFFINE_RELATION or ENTRY_KIND = OP_AFFINE_UNSAMPLE
        | ENTRY_FROM_TOP := REDUCES or CLOSES_OPENER
        | ENTRY_SLOT := if FOLDS_NOW then ENTRY_COUNT[?] - FOLD_ARITY else if INIT_PATCH then FOLD_LEFT else if POW_OVERWRITES then ENTRY_COUNT[?] - 1
                        else if APPENDS_ENTRY then ENTRY_COUNT[?] else -1
        | ENTRY_OP := ENTRY_OP[?] next ENTRY_SLOT : ENTRY_KIND
        | PARSED_ENTRY_TOKEN := if INIT_PATCH then ENTRY_TOKEN[?][FOLD_L]
                                else if COPYING then ENTRY_TOKEN[?][COPY_FROM] else if EMITS_SIZE then RECOVER_ARRAY_TOKEN
                                else if ENTRY_FROM_TOP then TOP_TOKEN
                                else if IN_SEQ_EMIT or IN_TUPLE_EMIT then HERE else if INDEX_STAGING then INDEX_TOKEN[?]
                                else if IN_CASE_COMPARE or IN_CASE_JOIN or IN_CASE_WHEN then CASE_OP_TOKEN
                                else if IN_SYNC then MODEL_TOKEN[?][MODEL_NOW] else HERE
        | ENTRY_TOKEN := ENTRY_TOKEN[?] next ENTRY_SLOT : PARSED_ENTRY_TOKEN
        | NONCONST_TOKEN := if STARTS_EXPRESSION or INIT_PAREN_PUSH then -1
                            else if NONCONST_TOKEN[?] < 0 and CONSTANT_PARSE and APPENDS_ENTRY and not FOLDS_NOW and not INIT_PATCH
                                    and ENTRY_KIND /= OP_CONST then PARSED_ENTRY_TOKEN
                            else NONCONST_TOKEN[?]
        | PARSED_ENTRY_NAME := if FOLDS_NOW or INIT_PATCH then -1
                            else if COPIES_FLAT_SUBJECT then ENTRY_NAME[?][COPY_BASE - 1]
                            else if COPYING then ENTRY_NAME[?][COPY_FROM]
                            else if EMITS_SIZE then RECOVER_ARRAY
                            else if SEQ_EMITS_FIELD then SEQ_FIELD_NAME
                            else if EMITS_NAMED then
                              (if STAGE_ITEM = OP_TARGET_SIGNAL then TARGET[?] else if STAGE_ITEM = OP_SEQ_HIDDEN then SEQ_HIDDEN_KEY[?]
                               else if STAGE_ITEM = OP_SEQ_PREVIOUS then SEQ_PREVIOUS_KEY[?]
                               else if STAGE_ITEM = OP_SEQ_INDEX then SEQ_INDEX_KEY[?][SEQ_INDEX_LEVEL]
                               else if STAGE_ITEM = OP_TUPLE_TARGET then TUPLE_NAME_ROW[?][TUPLE_SEEK_SLOT[?]]
                               else if STAGE_ITEM = OP_TUPLE_OUTPUT then TUPLE_OUTPUT_KEY else INDEX_NAME[?])
                            else if IN_STATE_CALL then N_ISIN
                            else if IN_SYNC then SIGNAL_NAME[?][MODEL_SIGNAL_START[?][MODEL_NOW] + SYNC_I[?]]
                            else if CALL_LIKE then TOP_CALLEE
                            else if ENTRY_KIND = OP_SIGNAL then (if SEQ_NAME_MATCH >= 0 then SEQ_INDEX_KEY[?][SEQ_NAME_MATCH] else NAME0)
                            else if ENTRY_KIND = OP_ENUMCONST then integer(LITERAL_VALUE)
                            else if CARRIES_INIT and INIT_GIVEN and INIT_IS_NAME then NAME_AT_LITERAL else -1
        | COPIES_FLAT_SUBJECT := COPIES_INDEX and integer(ENTRY_OP[?][COPY_FROM]) = OP_FLAT and ENTRY_AUX2[?][COPY_FROM] = COPY_BASE - 1
        | CARRIES_INIT := ENTRY_KIND = OP_DELAY or ENTRY_KIND = OP_CELL or ENTRY_KIND = OP_VAR or ENTRY_KIND = OP_GDELAY or ENTRY_KIND = OP_WINDOW
        | INIT_GIVEN := if ENTRY_KIND = OP_DELAY then DELAY_HAS_INIT else TEMPLATE_INIT
        | ENTRY_NAME := ENTRY_NAME[?] next ENTRY_SLOT : PARSED_ENTRY_NAME
        | ENTRY_VALUE := ENTRY_VALUE[?] next ENTRY_SLOT
                         : (if FOLDS_NOW then FOLD_VALUE else if INIT_PATCH then FOLD_VR
                            else if COPYING then ENTRY_VALUE[?][COPY_FROM]
                            else if IN_STATE_CALL then long(1)
                            else if CALL_LIKE then long(PENDING_COUNT[?][PENDING_TOP] + integer(OPERATOR_CASE = X_CLOSE and IN_OPERATOR))
                            else if SEQ_EMITS_FIELD then SEQ_FIELD_VALUE
                            else if EMITS_ZERO then long(0) else if EMITS_ONE then long(1) else if EMITS_SIZE then long(-integer(STAGE_ITEM = OP_SIZE_LESS))
                            else if SQUARE_HAS_COMMA and (ENTRY_KIND = OP_FLAT or ENTRY_KIND = OP_INDEX or ENTRY_KIND = OP_TARGET_INDEX) then long(PENDING_COUNT[?][PENDING_TOP] + 1)
                            else if ENTRY_KIND = OP_FLAT then long(0)
                            else if ENTRY_KIND = OP_AXIS then long(TUPLE_INDEX[?])
                            else if ENTRY_KIND = OP_PUT then ENUM_PATH[?] * long(8) + long(ENUM_DEPTH[?])
                            else if CONSTANT_LEAF then CONSTANT_VALUE[?][NAMED_CONSTANT]
                            else LITERAL_VALUE)
        | ENTRY_TYPE := ENTRY_TYPE[?] next ENTRY_SLOT
                        : (if FOLDS_NOW then FOLD_TYPE else if INIT_PATCH then FOLD_TR
                           else if COPYING then ENTRY_TYPE[?][COPY_FROM]
                           else if CARRIES_INIT and (not INIT_GIVEN or INIT_IS_NAME) then -1
                           else if LEFT_TT_FALSE then BUILTIN_BOOLEAN else if EMITS_ZERO or EMITS_ONE then BUILTIN_SHORT
                           else if SEQ_EMITS_FIELD then SEQ_FIELD_TYPE
                           else if EMITS_SIZE then -1 else if CONSTANT_LEAF then CONSTANT_TYPE[?][NAMED_CONSTANT] else LITERAL_TYPE)
        | ENTRY_AUX := ENTRY_AUX[?] next ENTRY_SLOT
                       : (if INIT_PATCH then INIT_CONST else if COPYING then ENTRY_AUX[?][COPY_FROM]
                          else if EMITS_SIZE then
                            (if RECOVER_LEVELS = 4 then INIT_SIZE4 else if RECOVER_LEVELS = 3 then INIT_SIZE3
                             else if RECOVER_LEVELS = 2 then INIT_SIZE2 else INIT_SIZE)
                          else if IN_STATE_CALL then -1
                          else if IN_INDEX_EMIT and (STAGE_ITEM = OP_RANGE or STAGE_ITEM = OP_STEP) and not INDEX_IS_ARRAY[?] then INDEX_TOTAL[?]
                          else if IN_SEQ_EMIT and STAGE_ITEM = OP_NEXT then SEQ_TARGET[?]
                          else if CALL_LIKE then PENDING_PARAMETERS[?][PENDING_TOP]
                          else if ENTRY_KIND = OP_AXIS then TUPLE_ARITY[?]
                          else if CARRIES_INIT then
                            (if not INIT_GIVEN then INIT_NONE else if INIT_IS_NAME then INIT_NAME
                             else if LITERAL_IS_ENUM then INIT_ENUMCONST else INIT_CONST)
                          else -1)
        | ENTRY_AUX2 := ENTRY_AUX2[?] next ENTRY_SLOT
                        : (if INIT_PATCH then TOP_TOKEN + 1 else if COPYING then ENTRY_AUX2[?][COPY_FROM]
                           else if IN_STATE_CALL then 0
                           else if CALL_LIKE then PENDING_PARAMETER_COUNT[?][PENDING_TOP]
                           else if LEFT_TT_FALSE then HERE else if INDEX_STAGING then INDEX_TOKEN[?] else if EMITS_ZERO then TOP_TOKEN
                           else if EMITS_SIZE then RECOVER_ARRAY_TOKEN else if ENTRY_KIND = OP_FLAT then RECOVER_ARRAY_AT else LITERAL_AT)
        | COPIED_SPLIT := ENTRY_SPLIT[?][COPY_FROM]
        | ENTRY_SPLIT := ENTRY_SPLIT[?] next ENTRY_SLOT
                         : (if INIT_PATCH then ENTRY_SPLIT[?][FOLD_L] else if COPYING then (if COPIED_SPLIT >= 0 then COPIED_SPLIT + COPY_OFFSET else -1)
                            else if CALL_LIKE and not IN_STATE_CALL then PENDING_SPLIT[?][PENDING_TOP]
                            else if ENTRY_FROM_TOP and (OP_TEMPLATE_KIND[ENTRY_KIND] > 0 or ENTRY_KIND = OP_REPEAT)
                            then PENDING_RIGHT_START[?][PENDING_TOP] else -1)
        | TEMPLATE_ENTRIES := TEMPLATE_ENTRIES[?] + integer(APPENDS_ENTRY and not INIT_PATCH and OP_TEMPLATE_KIND[ENTRY_KIND] > 0)
        | ENTRY_COUNT := if IN_CONSTANT_END or IN_INIT_END then EXPRESSION_START[?]
                         else ENTRY_COUNT[?] + integer(APPENDS_ENTRY)
                              - (if FOLDS_NOW then FOLD_ARITY else 2 * integer(INIT_PATCH) + integer(POW_OVERWRITES or POW_DROPS))
        | COUNTS_REPEAT := APPENDS_ENTRY and ENTRY_KIND = OP_REPEAT and not COPYING
        | REPEAT_SEEN := if STARTS_EXPRESSION then 0 else REPEAT_SEEN[?] + integer(COUNTS_REPEAT)
        | REPEAT_FIRST_TOKEN := if COUNTS_REPEAT and REPEAT_SEEN[?] = 0 then TOP_TOKEN else REPEAT_FIRST_TOKEN[?]
        | COUNTS_INTRINSIC := ENTRY_KIND = OP_CALL and PARSED_ENTRY_NAME >= N_INITIAL and PARSED_ENTRY_NAME <= N_ISIN
        | STARTS_BODY := IN_MODEL_BODY and CODE0 = C_OPEN_BAR or TYPE_NOW and (IN_MODEL_CLOSE or COPY_ENDS)
        | BODY_INTRINSICS := if STARTS_BODY then 0 else BODY_INTRINSICS[?] + integer(COUNTS_INTRINSIC)
        | BODY_STATEMENTS := if STARTS_BODY then 0 else BODY_STATEMENTS[?] + integer(APPENDS_EQUATION and IS_STATEMENT)
        | STATEMENT_TOTAL := STATEMENT_TOTAL[?] + integer(APPENDS_EQUATION and IS_STATEMENT)
        | BODY_EQUATION_START := if STARTS_BODY then EQUATION_COUNT[?] else BODY_EQUATION_START[?]
        | BODY_GROUP_START := if STARTS_BODY then GROUP_COUNT[?] else BODY_GROUP_START[?]
        | BODY_DEPENDENCE_START := if STARTS_BODY then DEPENDENCE_COUNT[?] else BODY_DEPENDENCE_START[?]
        | BODY_GUARD_START := if STARTS_BODY then GUARD_COUNT[?] else BODY_GUARD_START[?]
        | BODY_USE_START := if STARTS_BODY then USE_COUNT[?] else BODY_USE_START[?]
        | BODY_MEMBER_START := if STARTS_BODY then MEMBER_COUNT[?] else BODY_MEMBER_START[?]
        | BODY_HIDE_START := if STARTS_BODY then HIDE_COUNT[?] else BODY_HIDE_START[?]
        | MODEL_MESSAGE := if IN_START then (if MODEL_CLASS[CODE0] /= 1 and CODE0 /= C_MODULE then T_EXPECTED_FOUND else 0)
                           else if IN_MODULE_NAME then (if not MODEL_NAME_OK then T_EXPECTED_NAME else if MODULE_NAME_CLASHES then
                                                          (if RESERVED then T_RESERVED else T_DECLARED_TWICE) else 0)
                           else if IN_MODULE_EQUAL then (if CODE0 /= C_EQUAL then T_EXPECTED_FOUND else 0)
                           else if IN_MODULE_END or IN_USE_SEPARATOR then
                             (if CODE0 /= C_SEMICOLON and not (IN_USE_SEPARATOR and CODE0 = C_COMMA) then T_EXPECTED_FOUND else 0)
                           else if IN_USE_NAME then (if CODE0 /= C_NAME then T_EXPECTED_NAME else 0)
                           else if IN_MODEL_NAME then (if not MODEL_NAME_OK then T_EXPECTED_NAME else if MODEL_NAME_CLASHES then
                                                         (if RESERVED then T_RESERVED else T_DECLARED_TWICE) else 0)
                           else if IN_MODEL_EQUAL then (if CODE0 /= C_EQUAL then T_EXPECTED_FOUND else 0)
                           else if IN_MODEL_OPEN then
                             (if CODE0 /= C_OPEN and not MODEL_FORMALS_OPENS and not OPENS_COPY or TYPE_NOW and MODEL_FORMALS_OPENS
                              then T_EXPECTED_FOUND else 0)
                           else if IN_MODEL_CLOSE then (if CODE0 /= C_CLOSE then T_EXPECTED_FOUND else if NEEDS_OUTPUT then T_CLASS_NEEDS_OUTPUT else 0)
                           else if IN_MODEL_BODY then
                             (if PRAGMAS_OPEN or SPEC_OPENS then 0 else if IS_ATTRIBUTE_HERE then (if ATTRIBUTE_CLASS_FAILS then T_ATTRIBUTE_CLASS else 0)
                              else if CODE0 /= C_OPEN_BAR then T_EXPECTED_FOUND else 0)
                           else if IN_MODEL_AFTER then
                             (if CODE0 /= C_WHERE and CODE0 /= C_SEMICOLON and CODE0 /= C_SLASH then T_EXPECTED_FOUND else 0)
                           else if IN_PROGRAM then (if INNER_WHERE[?] and MODEL_CLASS[CODE0] = 1 then T_MODEL_IN_INNER_WHERE
                                                    else if CODE0 = C_MODULE then T_MODULE_NESTED
                                                    else if CODE0 = C_PRIVATE and not IN_MODULE[?] then T_PRIVATE_OUTSIDE
                                                    else if PRIVATE_PENDING[?] and CODE0 /= C_CONSTANT and CODE0 /= C_TYPE
                                                            and MODEL_CLASS[CODE0] /= 1 then T_PRIVATE_TARGET
                                                    else if MODEL_NOW < 0 and not MODULE_DECLARATION_WORD then T_EXPECTED_FOUND else 0)
                           else if IN_END_SEMICOLON then (if CODE0 /= C_SEMICOLON then T_EXPECTED_FOUND else 0)
                           else if IN_END_CHECK then (if CODE0 /= C_EOF then T_UNEXPECTED_AFTER else 0)
                           else if IN_TYPE_STATEMENT then (if MODEL_TYPE_STATEMENT then 0 else if TYPE_STATEMENT_CLASHES then CLASH_MESSAGE else 0)
                           else if IN_PARAMETER_MODEL then (if CODE0 /= C_NAME then T_EXPECTED_NAME else if not NAMES_MODEL_TYPE then T_MODEL_TYPE_EXPECTED else 0)
                           else if IN_PARAMETER_MODEL_NAME then (if CODE0 /= C_NAME then T_EXPECTED_NAME else if DECLARED then CLASH_MESSAGE else 0)
                           else if IN_TYPE_SKIP then (if CODE0 = C_EOF then T_EXPECTED_FOUND else 0)
                           else if IN_PARAMETER_DECL then (if CODE0 /= C_NAME then T_EXPECTED_NAME else if DECLARED then CLASH_MESSAGE else 0)
                           else if IN_PARAMETER_END then (if CODE0 /= C_SEMICOLON then T_EXPECTED_FOUND else 0)
                           else 0
        | EXPECTED_CODE := if IN_START then C_PROCESS else if IN_MODEL_EQUAL or IN_CONSTANT_EQUAL or IN_MODULE_EQUAL then C_EQUAL
                           else if IN_PROGRAM then C_END
                           else if IN_MODEL_OPEN then C_OPEN else if IN_MODEL_CLOSE then C_CLOSE
                           else if IN_MODEL_BODY then C_OPEN_BAR else if IN_TYPE_CLOSE then C_CLOSE_BRACKET
                           else if IN_PRAGMA_OPEN then C_OPEN_BRACE
                           else if IN_PRAGMA_CLOSE or IN_PRAGMA_SKIP or IN_SET_SEPARATOR then C_CLOSE_BRACE
                           else if IN_DEPENDENCE then C_ARROW
                           else if IN_CASE_IN then C_IN else if IN_CASE_BRANCH then CASE_BRANCH_EXPECTED
                           else if IN_CASE_SEPARATOR then C_CLOSE_BRACE else if IN_CASE_GUARD then C_COLON
                           else if IN_EQUATION_END then (if TUPLE_CALL_ENDS then C_BAR else C_CLOSE)
                           else if IN_GROUP_MEMBER then GROUP_RELATION_NOW[?]
                           else if IN_TUPLE_SEPARATOR then TUPLE_SEPARATOR_EXPECTED
                           else if IN_GUARD_COLONS then C_COLONS else if IN_ITERATE_OF then C_OF else if IN_ARRAY_TO then C_TO
                           else if IN_POP then (if CONDITION_WHEN then C_WHEN else if FRAME_TOP_KIND = FRAME_COMPOSE then C_BAR_CLOSE else C_END)
                           else if IN_PARAMETER_CLOSE then (if CODE0 /= C_CLOSE_BRACE then C_CLOSE_BRACE else C_OPEN)
                           else if IN_SEQ_HEAD then (if SEQ_EXPECT[?] = 4 then C_COLON else C_CLOSE_BRACE)
                           else if IN_OPERATOR or IN_SEQ_EMIT or IN_TUPLE_SKIP then C_CLOSE_BRACKET
                           else if IN_INTEGER_CONSTANT then C_CLOSE
                           else if IN_CONSTANT_ELEMENT or IN_DELAY_ELEMENT then C_CLOSE_BRACKET
                           else C_SEMICOLON
        | TYPE_MESSAGE := if IN_TYPE_SIZE then (if SIZE_MESSAGE /= 0 then SIZE_MESSAGE else if not SIZE_POSITIVE then T_CAPACITY_POSITIVE
                                                 else if SIZE_DEPTH[?] >= RANK_CAP then T_RANK else 0)
                          else if IN_TYPE_CLOSE then (if CODE0 /= C_CLOSE_BRACKET and CODE0 /= C_COMMA then T_EXPECTED_FOUND else 0)
                          else if IN_TYPE_NAME then
                            (if TOKEN_TYPE = -1 then T_EXPECTED_TYPE else if TOKEN_TYPE < -1 and ARRAY_SIZE[?] /= ulong(0) then T_FORMAL_ARRAY
                             else if ARRAY_SIZE[?] = ulong(0) then 0 else if TOKEN_TYPE = BUILTIN_STRING then T_STRING_ELEMENT else if NAME_RANK > RANK_CAP then T_RANK
                             else if NAME_TOTAL_BIG then T_ARRAY_TOTAL else 0)
                          else 0
        | SEPARATOR_MESSAGE := if CODE0 /= C_COMMA and CODE0 /= C_SEMICOLON
                                    and not (IN_DECLARE_SEPARATOR and CODE0 = C_INIT and not DECLARE_INITED[?] and not FORMALS_NOW)
                                 then T_EXPECTED_FOUND else 0
        | LIST_MESSAGE := if IN_DECLARE_INIT then DECLARE_INIT_MESSAGE else ELEMENT_MESSAGE
        | DECLARE_LIST_MESSAGE := if LIST_MESSAGE = T_CONSTANT_LIST then T_SIGNAL_INIT_LIST
                                  else if LIST_MESSAGE = T_CONSTANT_ELEMENT then T_SIGNAL_INIT_ELEMENT
                                  else if LIST_MESSAGE = T_CONSTANT_COUNT then T_SIGNAL_INIT_COUNT
                                  else if LIST_MESSAGE = T_CONSTANT_SHAPE then T_SIGNAL_INIT_SHAPE else LIST_MESSAGE
        | STATEMENT_MESSAGE := if IN_DECLARE_NAME then DECLARE_MESSAGE
                               else if IN_DECLARE_INIT then DECLARE_LIST_MESSAGE
                               else if IN_DECLARE_SEPARATOR or IN_LABEL_SEPARATOR or IN_REF_SEPARATOR or IN_CONSTANT_SEPARATOR
                               then SEPARATOR_MESSAGE
                               else if IN_CONSTANT_NAME then CONSTANT_NAME_MESSAGE
                               else if IN_CONSTANT_EQUAL then (if CODE0 /= C_EQUAL then T_EXPECTED_FOUND else 0)
                               else if IN_CONSTANT_DEFINITION then DEFINITION_MESSAGE
                               else if IN_INTEGER_CONSTANT then
                                 (if DL_ACTIVE[?] and INTEGER_CONSTANT_MESSAGE = T_CONSTANT_LITERAL then T_INIT_EXPRESSION
                                  else INTEGER_CONSTANT_MESSAGE)
                               else if IN_DELAY_ELEMENT then DL_ELEMENT_MESSAGE
                               else if IN_CONSTANT_ELEMENT then (if LIST_FOR_DECLARE[?] then DECLARE_LIST_MESSAGE else ELEMENT_MESSAGE)
                               else if IN_CONSTANT_SCALAR then SCALAR_MESSAGE
                               else if IN_CONSTANT_END then (if CONSTANT_CLOSE_OK then 0 else T_CONSTANT_EXPRESSION)
                               else if IN_INIT_END then (if CONSTANT_CLOSE_OK then 0 else T_INIT_EXPRESSION)
                               else if IN_LABEL_NAME then (if CODE0 /= C_NAME then T_EXPECTED_NAME else if DECLARED then CLASH_MESSAGE else 0)
                               else if IN_REF_NAME then
                                 (if CODE0 /= C_NAME then T_EXPECTED_NAME else if DECLARED then CLASH_MESSAGE
                                  else if REF_PLACED_FAILS then T_REF_PLACED else 0)
                               else 0
        | BODY_MESSAGE := if IN_PROCESS then PROCESS_MESSAGE
                          else if IN_GUARD_COLONS then (if CODE0 /= C_COLONS then T_EXPECTED_FOUND else 0)
                          else if IN_ITERATE_NAME then
                            (if not ANGLE_ACCEPTS then T_EXPECTED_NAME else if LEVEL_NAME_TWICE then T_ITERATE_INDEX_TWICE
                             else if LEVEL_RANK_FULL then T_ITERATE_RANK else 0)
                          else if IN_ITERATE_OF then (if CODE0 /= C_OF then T_EXPECTED_FOUND else 0)
                          else if IN_ARRAY_TO then (if CODE0 /= C_TO then T_EXPECTED_FOUND else 0)
                          else if IN_REPEAT_START then
                            (if IN_LOOP then T_ITERATE_NESTED else if GUARD_NODE[?] >= 0 or LABEL_NODE[?] >= 0 then T_TEMPLATE_GUARDED else 0)
                          else if IN_INDEX_TYPE then (if DRAIN_OK then 0 else if DRAIN_SEQ then T_SEQ_RANGE else T_CONSTANT_BOUND)
                          else if IN_SEQ_HEAD then SEQ_HEAD_MESSAGE
                          else if IN_SEQ_EMIT then (if SEQ_DISPATCH and not SEQ_DISPATCH_OK then T_EXPECTED_FOUND else 0)
                          else if IN_INDEX_DECLARE then INDEX_DECLARE_MESSAGE
                          else if IN_EQUATION then EQUATION_MESSAGE
                          else if IN_DEPENDENCE then DEPENDENCE_MESSAGE
                          else if IN_SET_NAME or IN_SET_SEPARATOR then SET_MESSAGE
                          else if IN_HIDE_NAME then HIDE_MESSAGE
                          else if IN_TUPLE_NAME then (if CODE0 /= C_NAME then T_EXPECTED_NAME else 0)
                          else if IN_TUPLE_SEPARATOR then TUPLE_SEPARATOR_MESSAGE
                          else if IN_TUPLE_SKIP then (if CODE0 = C_EOF then T_EXPECTED_FOUND else 0)
                          else if IN_CASE_IN then (if CODE0 /= C_IN then T_EXPECTED_FOUND else 0)
                          else if IN_CASE_BRANCH then CASE_BRANCH_MESSAGE
                          else if IN_CASE_COPY and not CASE_ELSE_BRANCH[?] then CASE_VALUE_MESSAGE
                          else if IN_CASE_SCAN then (if CASE_DUPLICATE then T_CASE_DUPLICATE else 0)
                          else if IN_CASE_SEPARATOR then (if CODE0 /= C_COMMA and CODE0 /= C_CLOSE_BRACE then T_EXPECTED_FOUND else 0)
                          else if IN_CASE_GUARD then CASE_GUARD_MESSAGE
                          else if IN_EQUATION_END then EQUATION_END_MESSAGE
                          else if IN_GROUP_MEMBER then GROUP_MEMBER_MESSAGE
                          else if CONDITION_WHEN then (if CODE0 /= C_WHEN then T_EXPECTED_FOUND else 0)
                          else if SPEC_UNJOINED then T_SPEC_BODY
                          else if IN_POP and not CONDITION_CLOSES then POP_MESSAGE
                          else if IN_OPERAND then OPERAND_MESSAGE
                          else if IN_PARAMETER then PARAMETER_MESSAGE
                          else if IN_PARAMETER_CLOSE then PARAMETER_CLOSE_MESSAGE
                          else if IN_OPERATOR then OPERATOR_MESSAGE
                          else 0
        | FULL_TABLE := if CREATES_MODEL and MODEL_COUNT[?] >= MODEL_CAP then F_CAP_MODELS
                        else if IN_MODULE_NAME and MODULE_COUNT[?] >= MODEL_CAP or IN_USE_NAME and IMPORT_COUNT[?] >= MODEL_CAP
                        then F_CAP_MODELS
                        else if (IN_COPY_TYPES or CREATES_ARRAY_TYPE or MAKES_STATE_TYPE) and TYPE_COUNT[?] >= TYPE_CAP then F_CAP_TYPES
                        else if (APPENDS_SIGNAL or APPENDS_INDEX_SIGNAL or INTERFACE_COPY_LIVE) and SIGNAL_COUNT[?] >= SIGNAL_CAP then F_CAP_SIGNALS
                        else if PUSHES_LOCAL and LOCAL_COUNT[?] >= LOCAL_CAP then F_CAP_LOCALS
                        else if STORES_CONSTANT and CONSTANT_COUNT[?] >= CONSTANT_CAP then F_CAP_CONSTANTS
                        else if (STORES_TABLE and TABLE_COUNT[?] >= TABLE_CAP or APPENDS_POOL and POOL_COUNT[?] >= POOL_CAP
                              or (CX_FOLDS or ELEMENT_PAIRS) and CX_COUNT[?] >= CX_CAP) then F_CAP_TABLES
                        else if (APPENDS_LABEL and LABEL_COUNT[?] >= LABEL_CAP or CREATES_USE and USE_COUNT[?] >= LABEL_CAP) then F_CAP_LABELS
                        else if CREATES_GUARD and GUARD_COUNT[?] >= GUARD_CAP then F_CAP_GUARDS
                        else if OPENS_LOOP_NAME and LOOP_COUNT[?] >= LOOP_CAP then F_CAP_LOOPS
                        else if INDEX_EQUATION and (LOOP_COUNT[?] >= LOOP_CAP or INDEX_TOTAL[?] + 1 >= GUARD_CAP) then F_CAP_LOOPS
                        else if (APPENDS_EQUATION or INDEX_EQUATION or SEQ_APPENDS or TUPLE_APPENDS) and EQUATION_COUNT[?] >= EQUATION_CAP
                                or IN_TUPLE_NAME and CODE0 = C_NAME and TUPLE_COUNT[?] >= EQUATION_CAP then F_CAP_EQUATIONS
                        else if APPENDS_ENTRY and ENTRY_COUNT[?] >= ENTRY_CAP or ENUM_COMMA and ENUM_COMPONENT >= long(32766) then F_CAP_ENTRIES
                        else if (APPENDS_GROUP and GROUP_COUNT[?] >= GROUP_CAP or APPENDS_MEMBER and MEMBER_COUNT[?] >= MEMBER_CAP) then F_CAP_GROUPS
                        else if APPENDS_DEPENDENCE and DEPENDENCE_COUNT[?] >= DEPENDENCE_CAP then F_CAP_DEPENDENCES
                        else if APPENDS_HIDE and HIDE_COUNT[?] >= SIGNAL_CAP then F_CAP_SIGNALS
                        else if APPENDS_PARAMETER and PARAMETER_ROWS[?] >= SIGNAL_CAP then F_CAP_SIGNALS
                        else if (PUSHES_FRAME and FRAME_DEPTH[?] >= STACK_CAP or PUSHES_PENDING and PENDING_DEPTH[?] >= STACK_CAP) then F_CAP_STACK
                        else if IN_PATH_COPY and PATH_COUNT[?] >= PATH_CAP then F_CAP_PATHS
                        else 0
        | STEP_MESSAGE := if STATE = P_STALL then 0
                          else if FULL_TABLE /= 0 then T_CAPACITY
                          else if MODEL_MESSAGE /= 0 then MODEL_MESSAGE
                          else if PRAGMA_MESSAGE_HERE /= 0 then PRAGMA_MESSAGE_HERE
                          else if TYPE_MESSAGE /= 0 then TYPE_MESSAGE
                          else if STATEMENT_MESSAGE /= 0 then STATEMENT_MESSAGE
                          else BODY_MESSAGE
        | STEP_TOKEN := if STEP_MESSAGE = T_FUNCTION_MEMORY then HERE
                        else if TUPLE_CALL_ENDS and STEP_MESSAGE = T_TUPLE_CALL_PLACED then TUPLE_TOKEN[?] + 2 * TUPLE_ARITY[?] + 2
                        else if TUPLE_CALL_ENDS and STEP_MESSAGE = T_EXPECTED_FOUND and CODE0 /= C_COMMA then ENTRY_TOKEN[?][LAST_ENTRY_SAFE]
                        else if STEP_MESSAGE = T_CONSTANT_EXPRESSION or STEP_MESSAGE = T_INIT_EXPRESSION then
                          (if NONCONST_TOKEN[?] >= 0 then NONCONST_TOKEN[?] else HERE)
                        else if STEP_MESSAGE = T_CONSTANT_DIVIDE or STEP_MESSAGE = T_CONVERSION and IN_OPERATOR
                                or STEP_MESSAGE = T_POWER_CONSTANT or STEP_MESSAGE = T_POWER_RANGE then TOP_TOKEN
                        else if IN_REPEAT_START then ENTRY_TOKEN[?][LAST_ENTRY]
                        else if IN_INDEX_TYPE then ENTRY_TOKEN[?][DRAIN_BOUND]
                        else if IN_INDEX_DECLARE then INDEX_ID_TOKEN[?][DRAIN_ID]
                        else if REPEAT_MISPLACED then REPEAT_FIRST_TOKEN[?]
                        else if STEP_MESSAGE = T_VAR_NAME then TOP_TOKEN
                        else if IN_OPERATOR and OPERATOR_CASE = X_INIT then (if LITERAL_IS then LITERAL_MESSAGE_TOKEN else LITERAL_AT)
                        else if STEP_MESSAGE = T_CLASS_NEEDS_OUTPUT then MODEL_TOKEN[?][MODEL_NOW]
                        else if IN_OPERAND and OPERAND_CASE = X_LITERAL or IN_OPERATOR and OPERATOR_CASE = X_DELAY and DELAY_HAS_INIT and LITERAL_IS
                        then LITERAL_MESSAGE_TOKEN
                        else if IN_OPERATOR and OPERATOR_CASE = X_DELAY then LITERAL_AT
                        else if IN_DECLARE_INIT then (if LITERAL_IS then LITERAL_MESSAGE_TOKEN else LITERAL_AT)
                        else if IN_CASE_COPY then (if LITERAL_IS then LITERAL_MESSAGE_TOKEN else HERE)
                        else if IN_CASE_SCAN then CASE_LITERAL_TOKEN[?]
                        else if IN_OPERATOR and OPERATOR_CASE = X_PREVIOUS then HERE + 2
                        else if IN_DEPENDENCE and CODE0 = C_ARROW then HERE + 1
                        else if IN_PARAMETER_CLOSE and CODE0 = C_CLOSE_BRACE then HERE + 1
                        else if STEP_MESSAGE = T_PRAGMAS_END and CODE0 = C_END then HERE + 1
                        else if STEP_MESSAGE = T_WRONG_ARGUMENTS then (if IN_EQUATION_END then TUPLE_TOKEN[?] else TOP_TOKEN)
                        else if IN_TUPLE_SEPARATOR and CODE0 = C_CLOSE
                        then HERE + 1 + integer(CODE1 = C_DEFINE) + integer(CODE1 = C_DEFINE and CODE2 = C_NAME)
                        else if STEP_MESSAGE = T_RECOVERY_ACCESS and OPERATOR_CASE = X_CLOSE then HERE + 1
                        else if IN_INTEGER_CONSTANT then INTEGER_CONSTANT_TOKEN
                        else if IN_CONSTANT_DEFINITION or IN_CONSTANT_ELEMENT and STEP_MESSAGE /= T_EXPECTED_FOUND or IN_CONSTANT_SCALAR
                        then DECLARE_TOKEN[?]
                        else if IN_DELAY_ELEMENT and STEP_MESSAGE = T_EXPECTED_FOUND then HERE + DL_CLOSES
                        else HERE
        | STEP_ARGUMENT0 := if STEP_MESSAGE = T_CAPACITY then FULL_TABLE
                            else if STEP_MESSAGE = T_EXPECTED_FOUND then EXPECTED_CODE
                            else if IN_INDEX_TYPE then INDEX_ID_OP_TOKEN[?][DRAIN_ID]
                            else if STEP_MESSAGE = T_DECLARED_TWICE then
                              (if IN_MODULE_NAME then F_ROLE_MODULE else if IN_MODEL_NAME then F_ROLE_MODEL else if IN_TYPE_STATEMENT then F_ROLE_TYPE
                               else if IN_CONSTANT_NAME then F_ROLE_CONSTANT else if IN_LABEL_NAME then F_ROLE_LABEL
                               else if FORMALS_NOW then F_ROLE_PARAMETER else F_ROLE_SIGNAL)
                            else if STEP_MESSAGE = T_EXTERNAL_SIGNAL then DECLARED_BASE
                            else if STEP_MESSAGE = T_CONSTANT_STRING or STEP_MESSAGE = T_CONSTANT_LIST or STEP_MESSAGE = T_CONSTANT_ELEMENT
                                    or STEP_MESSAGE = T_CONSTANT_TYPE or STEP_MESSAGE = T_CONSTANT_COUNT or STEP_MESSAGE = T_CONSTANT_SHAPE
                                    or STEP_MESSAGE = T_CONSTANT_EXPRESSION or STEP_MESSAGE = T_SIGNAL_INIT_LIST or STEP_MESSAGE = T_SIGNAL_INIT_ELEMENT
                                    or STEP_MESSAGE = T_SIGNAL_INIT_COUNT or STEP_MESSAGE = T_SIGNAL_INIT_SHAPE then DECLARE_NAME[?]
                            else if STEP_MESSAGE = T_RESERVED or STEP_MESSAGE = T_NAME_OF_MODEL or STEP_MESSAGE = T_CONSTANT_UNDECLARED
                                    or STEP_MESSAGE = T_PRAGMA_TOP_ONLY then LOOKUP_KEY
                            else if STEP_MESSAGE = T_INTERRUPT_TWICE then INTERRUPT_VALUE
                            else if STEP_MESSAGE = T_MODEL_TYPE_EXPECTED or STEP_MESSAGE = T_ITERATE_INDEX_TWICE or STEP_MESSAGE = T_STRING_INTERFACE then NAME0
                            else if STEP_MESSAGE = T_CLASS_NEEDS_OUTPUT then MODEL_KIND_NOW
                            else if STEP_MESSAGE = T_FUNCTION_MEMORY then MODEL_NOW
                            else if STEP_MESSAGE = T_ATTRIBUTE_CLASS then MODEL_KIND_NOW
                            else if STEP_MESSAGE = T_WRONG_ARGUMENTS then (if IN_EQUATION_END then TUPLE_FIRST_NAME else TOP_CALLEE)
                            else STEP_TOKEN
        | STEP_ARGUMENT1 := if STEP_MESSAGE = T_EXPECTED_FOUND or STEP_MESSAGE = T_FUNCTION_MEMORY then STEP_TOKEN
                            else if STEP_MESSAGE = T_CLASS_NEEDS_OUTPUT then MODEL_NAME[?][MODEL_NOW]
                            else if STEP_MESSAGE = T_ATTRIBUTE_CLASS then CODE0
                            else if STEP_MESSAGE = T_DECLARED_TWICE then LOOKUP_KEY
                            else if STEP_MESSAGE = T_WRONG_ARGUMENTS then (if IN_EQUATION_END then TUPLE_ARITY[?] else ARGUMENTS_EXPECTED)
                            else if STEP_MESSAGE = T_REAL_BIG then BUILTIN_REAL + integer(TOKEN_KIND[STEP_TOKEN] = ubyte(KIND_DREAL))
                            else DECLARED_TYPE
        | STEP_ARGUMENT2 := if STEP_MESSAGE = T_CONSTANT_COUNT then (if IN_CONSTANT_DEFINITION then STRING_BYTES else ELEMENT_COUNT)
                            else if STEP_MESSAGE = T_SIGNAL_INIT_COUNT then ELEMENT_COUNT
                            else if STEP_MESSAGE = T_WRONG_ARGUMENTS then (if IN_EQUATION_END then TUPLE_INDEX[?] + 1 else ARGUMENTS_FOUND)
                            else VALUE_TYPE
        | FAILS := STEP_MESSAGE /= 0
        | GO := not FAILS
        | NEXT_AT := if not GO then HERE
                     else if OPENS_COPY or IN_MODEL_COPY and not COPY_ENDS then HERE
                     else if COPY_ENDS or IN_PARAMETER_MODEL or IN_PARAMETER_MODEL_NAME then HERE + 1
                     else if IN_START or IN_MODEL_NAME or IN_MODEL_EQUAL or IN_MODEL_OPEN or IN_MODEL_CLOSE or IN_END_SEMICOLON
                             or IN_TYPE_SKIP or IN_TYPE_NAME or IN_DECLARE_NAME
                             or IN_DECLARE_SEPARATOR or IN_CONSTANT_NAME or IN_CONSTANT_EQUAL or IN_CONSTANT_SEPARATOR
                             or IN_LABEL_NAME or IN_LABEL_SEPARATOR or IN_GUARD_COLONS or IN_ITERATE_NAME or IN_ITERATE_OF or IN_ARRAY_TO
                             or IN_REF_NAME or IN_REF_SEPARATOR
                             or PRAGMAS_OPEN or IN_PRAGMA_OPEN or IN_PRAGMA_OBJECT or IN_PRAGMA_CLOSE or IN_PRAGMA_STATEMENT
                             or IN_PRAGMA_SKIP or IN_SET_NAME or IN_SET_SEPARATOR or IN_ALIAS_END or IN_HIDE_NAME or IN_TUPLE_NAME
                     then HERE + 1
                     else if IS_ATTRIBUTE_HERE or SPEC_OPENS then HERE + 1
                     else if IN_TUPLE_SKIP then HERE + 1
                     else if IN_TUPLE_SEEK then (if TUPLE_SEEK_DONE then TUPLE_RESUME_AT[?] else if TUPLE_SEEK_FOUND then TUPLE_TOKEN_ROW[?][TUPLE_SEEK_SLOT[?]] else HERE)
                     else if IN_TUPLE_EMIT then HERE + integer(TUPLE_HEAD_DONE)
                     else if IN_TUPLE_SEPARATOR then HERE + 1 + integer(CODE0 = C_CLOSE) * (if AXIS_FORM then 3 else 2 - integer(CODE2 = C_NAME))
                     else if IN_CASE_IN or IN_CASE_BRANCH or IN_CASE_SEPARATOR then HERE + 1
                     else if IN_CASE_LITERAL then LITERAL_END
                     else if IN_CASE_GUARD then HERE + integer(not CASE_ELSE_BRANCH[?])
                     else if IN_PRAGMA_OTHER then HERE + integer(CODE0 = C_OPEN_BRACE or CODE0 = C_STRING)
                     else if IN_PRAGMA_TEXT then HERE + integer(CODE0 = C_STRING)
                     else if IN_HIDE_SEPARATOR then HERE + integer(CODE0 = C_COMMA or CODE0 = C_SLASH)
                     else if IN_PRAGMA_NAME then HERE + 1 + integer(PRAGMAS_CLOSE)
                     else if IN_TYPE_STATEMENT then HERE + 1 + integer(ALIAS_STATEMENT and not MODEL_TYPE_STATEMENT)
                     else if IN_DECLARE_INIT then (if CODE0 = C_OPEN then HERE else if CODE0 = C_OPEN_BRACKET then HERE + 1 + DECLARED_INNER_LEVELS
                                                   else LITERAL_END)
                     else if IN_MODEL_QUESTION then HERE + integer(CODE0 = C_QUESTION)
                     else if IN_PARAMETER_OPEN then HERE + integer(CODE0 = C_CLOSE_BRACE or CODE0 = C_TYPE or MODEL_CLASS[CODE0] = 1)
                     else if IN_PARAMETER_DECL or IN_PARAMETER_END then HERE + 1
                     else if IN_MODEL_BANG then HERE + integer(CODE0 = C_BANG)
                     else if IN_MODEL_AFTER then HERE + 1
                     else if IN_PROGRAM then HERE + integer(MODEL_CLASS[CODE0] = 1 or CODE0 = C_END or CODE0 = C_TYPE or CODE0 = C_CONSTANT
                                                           or CODE0 = C_LABEL or CODE0 = C_REF or CODE0 = C_USE or CODE0 = C_PRIVATE
                                                           or CODE0 = C_SHARED or CODE0 = C_STATEVAR)
                     else if IN_MODULE_NAME or IN_MODULE_EQUAL or IN_MODULE_END or IN_USE_NAME or IN_USE_SEPARATOR then HERE + 1
                     else if IN_TYPE then HERE + integer(CODE0 = C_OPEN_BRACKET)
                     else if IN_TYPE_SIZE then HERE + 1
                     else if IN_TYPE_CLOSE then HERE + 1 + integer(SIZE_CONTINUES_BRACKET)
                     else if IN_CONSTANT_DEFINITION then HERE + integer(DEFINITION_IS_STRING or CODE0 = C_OPEN_BRACKET)
                                                          + integer(CODE0 = C_OPEN_BRACKET) * DECLARED_INNER_LEVELS
                     else if IN_INTEGER_CONSTANT then (if ELEMENT_PAIRS then NUMBER2_AT + 1 else NUMBER_AT + 1 + integer(CONVERTS))
                     else if IN_CONSTANT_ELEMENT then HERE + 1 + ELEMENT_CLOSES * (1 + integer(ELEMENT_SEPARATOR = C_COMMA))
                     else if IN_DELAY_ELEMENT then (if DL_ENDS then HERE else HERE + 1 + 2 * DL_CLOSES)
                     else if IN_DELAY_LIST_SIZE then HERE
                     else if IN_DELAY_LIST_END then DL_OPERATOR[?]
                     else if IN_PROCESS then
                       (if CODE0 = C_OPEN_BAR or CODE0 = C_ON or CODE0 = C_CASE or CODE0 = C_ITERATE or CODE0 = C_ARRAY or CODE0 = C_OPEN_BRACE
                           or TUPLE_OPENS
                        then HERE + 1
                        else if ASSERT_OPENS or LABEL_FOLLOWS and not STATE_ACTION_OPENS then HERE + 2 else HERE)
                     else if IN_EQUATION then
                       (if FOLLOWER = C_ARROW then HERE + 1 + ELEMENT_SKIP[HERE] else if FOLLOWER = C_DEFINE then HERE + (if ELEMENT_TARGET[HERE] then 0 else if SEQ_OPENS then 3 else 2)
                        else if FOLLOWER = C_PARTIAL_DEFINE then HERE + 2 + integer(CODE2 = C_DEFAULTVALUE) else HERE)
                     else if IN_DEPENDENCE then HERE + integer(CODE0 = C_ARROW) * (2 + ELEMENT_SKIP[HERE + 1])
                     else if IN_SEQ_HEAD then HERE + 1 + integer(SEQ_VALUE_HERE and SEQ_NEGATIVE)
                     else if IN_SEQ_EMIT then HERE + integer(STAGE_DONE and SEQ_PHASE[?] = 3 or SEQ_DISPATCH and CODE0 = C_COMMA)
                     else if IN_EQUATION_END or IN_GROUP_MEMBER then HERE + integer(CONTINUES_GROUP or IN_EQUATION_END and TUPLE_ACTIVE and not TUPLE_CALL[?])
                                                                   + integer(IN_EQUATION_END and AXIS_ANGLE_ENDS)
                     else if IN_POP then
                       (if CONDITION_CLOSES or CONDITION_WHEN then HERE + 1 else if SPEC_JOINS then HERE + 2 else if SYNC_PENDING then HERE
                        else if HIDE_OPENS or INNER_WHERE_OPENS then HERE + 1
                        else if FRAME_TOP_KIND = FRAME_COMPOSE then (if POP_COMPOSE_BREAKS or CODE0 = C_BAR_CLOSE then HERE + 1 else HERE + 2)
                        else if FRAME_TOP_KIND = FRAME_ITERATE then HERE + 1 else HERE)
                     else if IN_OPERAND then
                       (if OPERAND_CASE = X_LITERAL then LITERAL_END
                        else if OPERAND_CASE = X_CALL or OPERAND_CASE = X_PARAMETERS then HERE + 2 else HERE + 1)
                     else if IN_PARAMETER then (if NEGATIVE_PARAMETER then HERE + 2 + integer(CODE2 = C_COMMA) else HERE + 1 + integer(CODE1 = C_COMMA))
                     else if IN_PARAMETER_CLOSE then HERE + 2
                     else if IN_OPERATOR then
                       (if OPERATOR_CASE = X_REDUCE or OPERATOR_CASE = X_RETURN then HERE
                        else if OPERATOR_CASE = X_CLOSE or OPERATOR_CASE = X_BINARY then HERE + integer(STAGE_DONE)
                        else if OPERATOR_CASE = X_DELAY then (if DELAY_PAREN then HERE + 2 else if DELAY_HAS_INIT then LITERAL_END else HERE + 1)
                        else if OPERATOR_CASE = X_INIT then LITERAL_END
                        else if OPERATOR_CASE = X_INIT_LIST then DL_OPEN_AT + DL_RANK_HERE
                        else if OPERATOR_CASE = X_PREVIOUS then HERE + 3
                        else if OPERATOR_CASE = X_COMMA and INDEX_CHAINS then HERE + 2 else HERE + 1)
                     else HERE
        | AT := NEXT_AT
        | NEXT_STATE := if FAILS then P_FAILED
                        else if STATE = P_STALL then STATE_BEFORE
                        else if IN_COPY_TYPES then (if COPY_DONE then P_START else P_COPY_TYPES)
                        else if IN_START then (if CODE0 = C_MODULE then P_MODULE_NAME else P_MODEL_NAME)
                        else if IN_MODULE_NAME then P_MODULE_EQUAL
                        else if IN_MODULE_EQUAL then P_PROGRAM
                        else if IN_MODULE_END then P_START
                        else if IN_USE_NAME then P_USE_SEPARATOR
                        else if IN_USE_SEPARATOR then (if CODE0 = C_COMMA then P_USE_NAME else P_PROGRAM)
                        else if IN_MODEL_NAME then P_MODEL_EQUAL
                        else if IN_MODEL_EQUAL then P_MODEL_OPEN
                        else if IN_MODEL_OPEN then (if MODEL_FORMALS_OPENS then P_PARAMETER_OPEN else if OPENS_COPY then P_MODEL_COPY else P_MODEL_QUESTION)
                        else if IN_MODEL_COPY then (if not COPY_ENDS then P_MODEL_COPY else if TYPE_NOW then P_END_SEMICOLON else P_MODEL_BODY)
                        else if IN_PARAMETER_MODEL then P_PARAMETER_MODEL_NAME
                        else if IN_PARAMETER_MODEL_NAME then P_PARAMETER_END
                        else if IN_PARAMETER_OPEN then
                          (if CODE0 = C_CLOSE_BRACE then P_MODEL_OPEN else if CODE0 = C_TYPE then P_PARAMETER_DECL
                           else if MODEL_CLASS[CODE0] = 1 then P_PARAMETER_MODEL else P_TYPE)
                        else if IN_PARAMETER_DECL then P_PARAMETER_END
                        else if IN_PARAMETER_END then P_PARAMETER_OPEN
                        else if IN_MODEL_QUESTION then (if CODE0 = C_QUESTION then P_INPUTS else P_MODEL_BANG)
                        else if IN_INPUTS then (if CODE0 = C_BANG or CODE0 = C_CLOSE then P_MODEL_BANG else P_TYPE)
                        else if IN_MODEL_BANG then (if CODE0 = C_BANG then P_OUTPUTS else P_MODEL_CLOSE)
                        else if IN_OUTPUTS then (if CODE0 = C_CLOSE then P_MODEL_CLOSE else P_TYPE)
                        else if IN_MODEL_CLOSE then (if TYPE_NOW then P_END_SEMICOLON else P_MODEL_BODY)
                        else if IN_MODEL_BODY then (if IS_ATTRIBUTE_HERE then P_MODEL_BODY else if PRAGMAS_OPEN then P_PRAGMA_NAME else P_PROCESS)
                        else if IN_PRAGMA_NAME then
                          (if PRAGMAS_CLOSE then P_MODEL_BODY else if not PRAGMA_KNOWN then P_PRAGMA_OTHER
                           else if NAME0 = N_MACHINE then P_PRAGMA_STATEMENT else P_PRAGMA_OPEN)
                        else if IN_PRAGMA_OTHER then (if CODE0 = C_OPEN_BRACE then P_PRAGMA_SKIP else P_PRAGMA_NAME)
                        else if IN_PRAGMA_SKIP then (if CODE0 = C_CLOSE_BRACE then P_PRAGMA_TEXT else P_PRAGMA_SKIP)
                        else if IN_PRAGMA_TEXT then P_PRAGMA_NAME
                        else if IN_PRAGMA_OPEN then P_PRAGMA_OBJECT
                        else if IN_PRAGMA_OBJECT then P_PRAGMA_CLOSE
                        else if IN_PRAGMA_CLOSE then (if PRAGMA_KIND = N_INTERRUPT then P_PRAGMA_STATEMENT else P_PRAGMA_NAME)
                        else if IN_PRAGMA_STATEMENT then P_PRAGMA_NAME
                        else if IN_MODEL_AFTER or IN_END_SEMICOLON then
                          (if IN_MODEL_AFTER and CODE0 = C_SLASH then P_HIDE_NAME
                           else if IN_MODEL_AFTER and CODE0 = C_WHERE then P_PROGRAM
                           else if PARENT_NOW < 0 and not IN_MODULE[?] then P_END_CHECK else P_PROGRAM)
                        else if IN_PROGRAM then
                          (if MODEL_CLASS[CODE0] = 1 then P_MODEL_NAME
                           else if CODE0 = C_END then (if INNER_WHERE[?] then P_POP else if MODEL_NOW < 0 then P_MODULE_END else P_END_SEMICOLON)
                           else if CODE0 = C_USE then P_USE_NAME
                           else if CODE0 = C_PRIVATE or CODE0 = C_SHARED or CODE0 = C_STATEVAR then P_PROGRAM
                           else if CODE0 = C_TYPE then P_TYPE_STATEMENT else if CODE0 = C_LABEL then P_LABEL_NAME
                           else if CODE0 = C_REF then P_REF_NAME else P_TYPE)
                        else if IN_END_CHECK then P_DONE
                        else if IN_TYPE_STATEMENT then (if MODEL_TYPE_STATEMENT then P_MODEL_NAME else if ALIAS_STATEMENT then P_TYPE else P_TYPE_SKIP)
                        else if IN_ALIAS_END then P_PROGRAM
                        else if IN_TYPE_SKIP then (if CODE0 = C_SEMICOLON then P_PROGRAM else P_TYPE_SKIP)
                        else if IN_TYPE then (if CODE0 = C_OPEN_BRACKET then P_TYPE_SIZE else P_TYPE_NAME)
                        else if IN_TYPE_SIZE then P_TYPE_CLOSE
                        else if IN_TYPE_CLOSE then (if CODE0 = C_COMMA or SIZE_CONTINUES_BRACKET then P_TYPE_SIZE else P_TYPE_NAME)
                        else if IN_INDEX_TYPE then P_TYPE_INTERN
                        else if IN_DELAY_ELEMENT then (if DL_ENDS then P_DELAY_LIST_SIZE else P_INTEGER_CONSTANT)
                        else if IN_DELAY_LIST_SIZE then (if DL_SIZES_DONE then P_TYPE_INTERN else P_DELAY_LIST_SIZE)
                        else if IN_DELAY_LIST_END then P_OPERATOR
                        else if IN_INDEX_DECLARE then INDEX_RETURN[?]
                        else if TYPE_FINISHED then RETURN_STATE[?]
                        else if IN_TYPE_NAME or IN_TYPE_INTERN then P_TYPE_INTERN
                        else if IN_DECLARE_NAME then P_DECLARE_SEPARATOR
                        else if IN_DECLARE_INIT then (if CODE0 = C_OPEN then P_OPERAND else if CODE0 = C_OPEN_BRACKET then P_INTEGER_CONSTANT
                                                      else P_DECLARE_SEPARATOR)
                        else if IN_INIT_END then P_DECLARE_SEPARATOR
                        else if IN_CONSTANT_END then P_CONSTANT_SCALAR
                        else if IN_DECLARE_SEPARATOR then
                          (if CODE0 = C_INIT then P_DECLARE_INIT else if CODE0 = C_COMMA then P_DECLARE_NAME
                           else if FORMALS_NOW then P_PARAMETER_OPEN else if ROLE[?] = ROLE_INPUT then P_INPUTS
                           else if ROLE[?] = ROLE_OUTPUT then P_OUTPUTS else P_PROGRAM)
                        else if IN_CONSTANT_NAME then P_CONSTANT_EQUAL
                        else if IN_CONSTANT_EQUAL then P_CONSTANT_DEFINITION
                        else if IN_CONSTANT_DEFINITION then
                          (if DEFINITION_IS_STRING then P_CONSTANT_SEPARATOR else if CODE0 = C_OPEN_BRACKET then P_INTEGER_CONSTANT
                           else P_OPERAND)
                        else if IN_INTEGER_CONSTANT then CONSTANT_RETURN[?]
                        else if IN_CONSTANT_ELEMENT then (if ELEMENT_SEPARATOR = C_COMMA then P_INTEGER_CONSTANT
                                                          else if LIST_FOR_DECLARE[?] then P_DECLARE_SEPARATOR else P_CONSTANT_SEPARATOR)
                        else if IN_CONSTANT_SCALAR then P_CONSTANT_SEPARATOR
                        else if IN_CONSTANT_SEPARATOR then (if CODE0 = C_COMMA then P_CONSTANT_NAME else P_PROGRAM)
                        else if IN_LABEL_NAME then P_LABEL_SEPARATOR
                        else if IN_LABEL_SEPARATOR then (if CODE0 = C_COMMA then P_LABEL_NAME else P_PROGRAM)
                        else if IN_REF_NAME then P_REF_SEPARATOR
                        else if IN_REF_SEPARATOR then (if CODE0 = C_COMMA then P_REF_NAME else P_PROGRAM)
                        else if IN_PROCESS then
                          (if CODE0 = C_OPEN_BAR or ASSERT_OPENS then P_PROCESS else if EMPTY_COMPOSITION then P_POP else if TUPLE_OPENS then P_TUPLE_NAME
                           else if CONDITION_OPENS then P_PROCESS
                           else if CODE0 = C_OPEN_BRACE then P_SET_NAME else if STATE_ACTION_OPENS then P_STATE_SIGNAL
                           else if LABEL_FOLLOWS then P_PATH_COPY
                           else if CODE0 = C_ON or CODE0 = C_CASE then P_OPERAND else if CODE0 = C_ITERATE or CODE0 = C_ARRAY then P_ITERATE_NAME
                           else P_EQUATION)
                        else if IN_PATH_COPY then (if PATH_LEFT[?] > 0 then P_PATH_COPY else P_PROCESS)
                        else if IN_GUARD_COLONS then P_PATH_COPY
                        else if IN_ITERATE_NAME then (if ANGLE_STEP /= 0 then P_ITERATE_NAME else if INDEX_IS_ARRAY[?] then P_ARRAY_TO else P_ITERATE_OF)
                        else if IN_ARRAY_TO then P_OPERAND
                        else if IN_REPEAT_START then P_INDEX_EMIT
                        else if IN_INDEX_EMIT then (if not STAGE_DONE then P_INDEX_EMIT else if INDEX_IS_ARRAY[?] then P_ITERATE_OF
                                                    else if SEQ_ON[?] then (if SEQ_J[?] + 1 < SEQ_LEVELS[?] then P_INDEX_EMIT else P_SEQ_EMIT)
                                                    else P_REPEAT_EMIT)
                        else if IN_SEQ_HEAD then (if SEQ_HEAD_CLOSES then P_INDEX_EMIT else P_SEQ_HEAD)
                        else if IN_SEQ_EMIT then
                          (if not STAGE_DONE then P_SEQ_EMIT else if SEQ_PHASE[?] = 0 then P_OPERAND else if SEQ_PHASE[?] = 3 then P_EQUATION_END
                           else if SEQ_DISPATCH and CODE0 = C_COMMA and CODE1 = C_OPEN_BRACE then P_SEQ_HEAD else P_SEQ_EMIT)
                        else if IN_REPEAT_EMIT then (if not STAGE_DONE then P_REPEAT_EMIT else P_EQUATION_END)
                        else if IN_TUPLE_NAME then (if CODE1 = C_OPEN_BRACKET then P_TUPLE_SKIP else P_TUPLE_SEPARATOR)
                        else if IN_TUPLE_SKIP then (if TUPLE_SKIP_ENDS then P_TUPLE_SEPARATOR else P_TUPLE_SKIP)
                        else if IN_TUPLE_SEEK then (if TUPLE_SEEK_DONE then P_POP else if TUPLE_SEEK_FOUND then P_TUPLE_EMIT else P_TUPLE_SEEK)
                        else if IN_TUPLE_EMIT then (if not STAGE_DONE then P_TUPLE_EMIT else if TUPLE_PHASE[?] = 0 then P_OPERAND else P_TUPLE_SEEK)
                        else if IN_TUPLE_SEPARATOR then (if CODE0 = C_COMMA then P_TUPLE_NAME else P_OPERAND)
                        else if IN_CASE_IN then P_CASE_BRANCH
                        else if IN_CASE_BRANCH then (if CODE0 = C_END then P_POP else P_CASE_COPY)
                        else if IN_CASE_COPY then
                          (if not STAGE_ADVANCES then P_CASE_COPY else if CASE_ELSE_BRANCH[?] then P_CASE_ELSE_VALUE else P_CASE_LITERAL)
                        else if IN_CASE_LITERAL then (if CASE_LAST_TOP >= 0 then P_CASE_SCAN else P_CASE_COMPARE)
                        else if IN_CASE_SCAN then (if CASE_VALUE_PREV[?][CASE_SCAN_AT[?]] >= 0 then P_CASE_SCAN else P_CASE_COMPARE)
                        else if IN_CASE_ELSE_VALUE then P_CASE_COMPARE
                        else if IN_CASE_COMPARE then (if CASE_BRANCH_ITEMS[?] > 0 then P_CASE_JOIN else CASE_ITEM_NEXT)
                        else if IN_CASE_JOIN then CASE_ITEM_NEXT
                        else if IN_CASE_SEPARATOR then (if CODE0 = C_COMMA then P_CASE_COPY else P_CASE_WHEN)
                        else if IN_CASE_WHEN then P_CASE_GUARD
                        else if IN_CASE_GUARD or IN_STATE_GUARD then P_PATH_COPY
                        else if IN_STATE_SIGNAL then P_STATE_CALL
                        else if IN_SYNC then (if SYNC_LAST then P_POP else P_SYNC)
                        else if IN_STATE_CALL then P_STATE_WHEN
                        else if IN_STATE_WHEN then P_STATE_GUARD
                        else if IN_ITERATE_OF then P_PROCESS
                        else if IN_EQUATION then (if FOLLOWER = C_ARROW then P_DEPENDENCE else if SEQ_OPENS then P_SEQ_HEAD else P_OPERAND)
                        else if IN_DEPENDENCE then (if CODE0 /= C_ARROW then P_POP else if CODE1 = C_OPEN_BRACE then P_SET_NAME else P_SET_EMIT)
                        else if IN_SET_NAME then P_SET_SEPARATOR
                        else if IN_SET_SEPARATOR then
                          (if CODE0 = C_COMMA then P_SET_NAME else if SET_READING_RIGHT[?] then P_SET_EMIT else P_DEPENDENCE)
                        else if IN_SET_EMIT then (if EMIT_LAST then P_DEPENDENCE else P_SET_EMIT)
                        else if IN_HIDE_NAME then P_HIDE_SEPARATOR
                        else if IN_HIDE_SEPARATOR then (if CODE0 = C_COMMA or CODE0 = C_SLASH then P_HIDE_NAME else HIDE_RETURN[?])
                        else if IN_EQUATION_END or IN_GROUP_MEMBER then
                          (if CONTINUES_GROUP or TUPLE_CONTINUES then P_OPERAND else if TUPLE_EXTRAS_START then P_TUPLE_SEEK else P_POP)
                        else if IN_POP then
                          (if CONDITION_CLOSES then P_POP else if CONDITION_WHEN or SPEC_JOINS then P_PROCESS else if HIDE_OPENS then P_HIDE_NAME else if INNER_WHERE_OPENS then P_PROGRAM
                           else if POP_COMPOSE_BREAKS or POP_ITERATE_SEEDS then P_PROCESS
                           else if FRAME_TOP_KIND = FRAME_CASE then P_CASE_BRANCH
                           else if SYNC_PENDING then P_SYNC
                           else if FRAME_DEPTH[?] = 1 then P_MODEL_AFTER else P_POP)
                        else if IN_OPERAND then
                          (if OPERAND_CASE = X_EMPTY_CALL or OPERAND_CASE = X_LITERAL or OPERAND_CASE = X_SIGNAL then P_OPERATOR
                           else if OPERAND_CASE = X_PARAMETERS then P_PARAMETER else P_OPERAND)
                        else if IN_PARAMETER then (if (if NEGATIVE_PARAMETER then CODE2 else CODE1) = C_COMMA then P_PARAMETER else P_PARAMETER_CLOSE)
                        else if IN_PARAMETER_CLOSE then P_OPERAND
                        else if IN_OPERATOR then
                          (if OPERATOR_CASE = X_RETURN then EXPRESSION_RETURN[?]
                           else if OPERATOR_CASE = X_DELAY and DELAY_PAREN then P_OPERAND
                           else if OPERATOR_CASE = X_INIT_LIST then P_INTEGER_CONSTANT
                           else if OPERATOR_CASE = X_ELSE then P_BRANCH
                           else if OPERATOR_CASE = X_BINARY and STAGE_DONE or OPERATOR_CASE = X_THEN or OPERATOR_CASE = X_OPEN_SQUARE
                                   or OPERATOR_CASE = X_COMMA then P_OPERAND
                           else P_OPERATOR)
                        else if IN_BRANCH then P_OPERAND
                        else STATE_BEFORE
        | PARSE_STATE := NEXT_STATE
        | RETURN_STATE := if IN_INPUTS or IN_OUTPUTS or IN_PARAMETER_OPEN or IN_PROGRAM and CODE0 /= C_CONSTANT then P_DECLARE_NAME
                          else if IN_PROGRAM then P_CONSTANT_NAME else if IN_TYPE_STATEMENT then P_ALIAS_END
                          else if IN_INDEX_TYPE then P_INDEX_DECLARE else if IN_DELAY_LIST_SIZE then P_DELAY_LIST_END else RETURN_STATE[?]
        | INDEX_RETURN := if IN_INDEX_TYPE then STATE_BEFORE else INDEX_RETURN[?]
        | INDEX_IS_ARRAY := if IN_PROCESS and (CODE0 = C_ITERATE or CODE0 = C_ARRAY) then CODE0 = C_ARRAY
                            else if IN_REPEAT_START or SEQ_OPENS then false else INDEX_IS_ARRAY[?]
        | SEQ_INDEX_FRESH := IN_INDEX_EMIT and SEQ_ON[?] and INDEX_FRESH
        | INDEX_NAME := if IN_REPEAT_START or SEQ_INDEX_FRESH then N_REPEAT_MARK + (INDEX_TOTAL[?] + 1) * NAME_CAP
                        else if ITERATE_HEAD_NAME then NAME0 else INDEX_NAME[?]
        | INDEX_TOKEN := if IN_REPEAT_START then ENTRY_TOKEN[?][LAST_ENTRY] else if SEQ_INDEX_FRESH then SEQ_HEAD_TOKEN[?][SEQ_J[?]]
                         else if ITERATE_HEAD_NAME then HERE else INDEX_TOKEN[?]
        | ITERATE_KEYWORD := IN_PROCESS and (CODE0 = C_ITERATE or CODE0 = C_ARRAY)
        | NEST_LEVEL := if ITERATE_KEYWORD then IN_LOOP else NEST_LEVEL[?]
        | ANGLE_ACCEPTS := if ANGLE_STEP[?] = 0 then CODE0 = C_NAME or CODE0 = C_LESS and not INDEX_IS_ARRAY[?]
                           else if ANGLE_STEP[?] = 1 then CODE0 = C_LESS
                           else if ANGLE_STEP[?] = 2 then CODE0 = C_NAME
                           else if ANGLE_STEP[?] = 3 then CODE0 = C_COMMA or CODE0 = C_GREATER
                           else CODE0 = C_GREATER
        | ANGLE_STEP := if not IN_ITERATE_NAME then ANGLE_STEP[?]
                        else if ANGLE_STEP[?] = 0 and CODE0 = C_LESS then 1
                        else if ANGLE_STEP[?] = 1 then 2
                        else if ANGLE_STEP[?] = 2 then 3
                        else if ANGLE_STEP[?] = 3 and CODE0 = C_COMMA then 2
                        else if ANGLE_STEP[?] = 3 then 4 else 0
        | ITERATE_HEAD_NAME := IN_ITERATE_NAME and CODE0 = C_NAME and (ANGLE_STEP[?] = 0 or ANGLE_STEP[?] = 2)
        | HEAD_NAMES := if ITERATE_KEYWORD then 0 else if ITERATE_HEAD_NAME then HEAD_NAMES[?] + 1 else HEAD_NAMES[?]
        | OPENS_LOOP_NAME := ITERATE_HEAD_NAME and HEAD_NAMES[?] = 0 and not NEST_LEVEL[?]
        | ADDS_LEVEL_NAME := ITERATE_HEAD_NAME and not OPENS_LOOP_NAME
        | LEVEL_LOOP := if NEST_LEVEL[?] and not SEQ_LEVEL_ADDS then LOOP_NOW[?] else LOOP_COUNT[?] - 1
        | LEVEL_LOOP_SAFE := if LEVEL_LOOP >= 0 then LEVEL_LOOP else 0
        | LEVEL_RANK_NOW := LOOP_RANK[?][LEVEL_LOOP_SAFE]
        | LEVEL_NAME_TWICE := ADDS_LEVEL_NAME
                              and (LOOP_LEVEL_NAME[?][4 * LEVEL_LOOP_SAFE] = NAME0
                                   or LEVEL_RANK_NOW > 1 and LOOP_LEVEL_NAME[?][4 * LEVEL_LOOP_SAFE + 1] = NAME0
                                   or LEVEL_RANK_NOW > 2 and LOOP_LEVEL_NAME[?][4 * LEVEL_LOOP_SAFE + 2] = NAME0
                                   or LEVEL_RANK_NOW > 3 and LOOP_LEVEL_NAME[?][4 * LEVEL_LOOP_SAFE + 3] = NAME0)
        | LEVEL_RANK_FULL := ADDS_LEVEL_NAME and LEVEL_RANK_NOW >= 4
        | REPEAT_E_START := if IN_REPEAT_START then EXPRESSION_START[?] else REPEAT_E_START[?]
        | INDEX_EQUATION := IN_INDEX_EMIT and STAGE_DONE
        | REPEAT_LOOP := if INDEX_EQUATION and not INDEX_IS_ARRAY[?] and not SEQ_ON[?] then LOOP_COUNT[?] else if IN_EQUATION_END then -1 else REPEAT_LOOP[?]
        | SEQ_LEVEL_ADDS := INDEX_EQUATION and SEQ_ON[?] and SEQ_J[?] > 0
        | SEQ_LOOP := if INDEX_EQUATION and SEQ_ON[?] and SEQ_J[?] = 0 then LOOP_COUNT[?] else SEQ_LOOP[?]
        | SEQ_J := if SEQ_HEAD_CLOSES then 0 else if INDEX_EQUATION and SEQ_ON[?] then SEQ_J[?] + 1 else SEQ_J[?]
        | SEQ_INDEX_KEY := SEQ_INDEX_KEY[?] next (if SEQ_INDEX_FRESH then SEQ_J[?] else -1) : INDEX_NAME
        | SEQ_OPENS := IN_EQUATION and EQUATION_MESSAGE = 0 and FOLLOWER = C_DEFINE and not ELEMENT_TARGET[HERE] and CODE2 = C_OPEN_BRACKET
                       and CODE3 = C_OPEN_BRACE
        | SEQ_TARGET := if SEQ_OPENS then NAME0 else SEQ_TARGET[?]
        | SEQ_OPEN_HEAD := IN_SEQ_HEAD and SEQ_EXPECT[?] = 5
        | SEQ_VALUE_HERE := IN_SEQ_HEAD and SEQ_EXPECT[?] >= 1 and SEQ_EXPECT[?] <= 3
        | SEQ_ITEM_HERE := IN_SEQ_HEAD and not SEQ_OPEN_HEAD and SEQ_EXPECT[?] = 0
        | SEQ_KEYWORD := if not SEQ_ITEM_HERE then 0 else if CODE0 = C_IN then 1 else if CODE0 = C_TO then 2
                         else if CODE0 = C_NAME and NAME0 = N_STEP then 3 else 0
        | SEQ_NAMES_ITEM := SEQ_ITEM_HERE and CODE0 = C_NAME and NAME0 /= N_STEP
        | SEQ_ITEM_ENDS := SEQ_ITEM_HERE and (CODE0 = C_COMMA or CODE0 = C_CLOSE_BRACE)
        | SEQ_ITEM_OPENS := SEQ_OPEN_HEAD or SEQ_ITEM_HERE and CODE0 = C_COMMA
        | SEQ_HEAD_CLOSES := IN_SEQ_HEAD and SEQ_EXPECT[?] = 4 and CODE0 = C_COLON
        | SEQ_EXPECT := if SEQ_OPENS or SEQ_DISPATCH and CODE0 = C_COMMA and CODE1 = C_OPEN_BRACE then 5
                        else if SEQ_KEYWORD > 0 then SEQ_KEYWORD else if SEQ_VALUE_HERE or SEQ_HEAD_CLOSES or SEQ_OPEN_HEAD then 0
                        else if SEQ_ITEM_HERE and CODE0 = C_CLOSE_BRACE then 4 else SEQ_EXPECT[?]
        | SEQ_ITEM := SEQ_LEVELS[?] - 1
        | SEQ_ITEM_SAFE := if SEQ_ITEM >= 0 and SEQ_ITEM < 4 then SEQ_ITEM else 0
        | SEQ_LEVELS := if SEQ_OPEN_HEAD then 1 else if SEQ_ITEM_OPENS then SEQ_LEVELS[?] + 1 else SEQ_LEVELS[?]
        | SEQ_NEGATIVE := CODE0 = C_MINUS and CODE1 = C_NUMBER
        | SEQ_VALUE_NAME := if CODE0 = C_NAME then NAME0 else -1
        | SEQ_VALUE_LITERAL := if CODE0 = C_NUMBER then TOKEN_VALUE[HERE] else if SEQ_NEGATIVE then -TOKEN_VALUE[HERE + 1] else long(0)
        | SEQ_SLOT_OPEN := if SEQ_ITEM_OPENS and GO then (if SEQ_OPEN_HEAD then 0 else SEQ_LEVELS[?]) else -1
        | SEQ_FIELD_SLOT := if SEQ_VALUE_HERE and GO then SEQ_ITEM_SAFE else -1
        | SEQ_HEAD_NAME := SEQ_HEAD_NAME[?] next (if SEQ_SLOT_OPEN >= 0 then SEQ_SLOT_OPEN else if SEQ_NAMES_ITEM and GO then SEQ_ITEM_SAFE else -1)
                           : (if SEQ_NAMES_ITEM then NAME0 else -1)
        | SEQ_HEAD_TOKEN := SEQ_HEAD_TOKEN[?] next SEQ_SLOT_OPEN : HERE + 1
        | SEQ_FROM_NAME := SEQ_FROM_NAME[?] next (if SEQ_SLOT_OPEN >= 0 then SEQ_SLOT_OPEN else if SEQ_EXPECT[?] = 1 then SEQ_FIELD_SLOT else -1)
                           : (if SEQ_SLOT_OPEN >= 0 then -1 else SEQ_VALUE_NAME)
        | SEQ_FROM_VALUE := SEQ_FROM_VALUE[?] next (if SEQ_SLOT_OPEN >= 0 then SEQ_SLOT_OPEN else if SEQ_EXPECT[?] = 1 then SEQ_FIELD_SLOT else -1)
                            : (if SEQ_SLOT_OPEN >= 0 then long(0) else SEQ_VALUE_LITERAL)
        | SEQ_TO_NAME := SEQ_TO_NAME[?] next (if SEQ_SLOT_OPEN >= 0 then SEQ_SLOT_OPEN else if SEQ_EXPECT[?] = 2 then SEQ_FIELD_SLOT else -1)
                         : (if SEQ_SLOT_OPEN >= 0 then -2 else SEQ_VALUE_NAME)
        | SEQ_TO_VALUE := SEQ_TO_VALUE[?] next (if SEQ_SLOT_OPEN >= 0 then SEQ_SLOT_OPEN else if SEQ_EXPECT[?] = 2 then SEQ_FIELD_SLOT else -1)
                          : (if SEQ_SLOT_OPEN >= 0 then long(0) else SEQ_VALUE_LITERAL)
        | SEQ_BY_NAME := SEQ_BY_NAME[?] next (if SEQ_SLOT_OPEN >= 0 then SEQ_SLOT_OPEN else if SEQ_EXPECT[?] = 3 then SEQ_FIELD_SLOT else -1)
                         : (if SEQ_SLOT_OPEN >= 0 then -1 else SEQ_VALUE_NAME)
        | SEQ_BY_VALUE := SEQ_BY_VALUE[?] next (if SEQ_SLOT_OPEN >= 0 then SEQ_SLOT_OPEN else if SEQ_EXPECT[?] = 3 then SEQ_FIELD_SLOT else -1)
                          : (if SEQ_SLOT_OPEN >= 0 then long(1) else SEQ_VALUE_LITERAL)
        | SEQ_HEAD_MESSAGE := if SEQ_OPEN_HEAD then (if IN_LOOP or GUARD_NODE[?] >= 0 or LABEL_NODE[?] >= 0 then T_SEQ_PLACED else 0)
                              else if SEQ_VALUE_HERE then (if CODE0 = C_NUMBER or SEQ_NEGATIVE or CODE0 = C_NAME then 0 else T_SEQ_RANGE)
                              else if SEQ_EXPECT[?] = 4 then (if CODE0 = C_COLON then 0 else T_EXPECTED_FOUND)
                              else if SEQ_ITEM_ENDS and SEQ_TO_NAME[?][SEQ_ITEM_SAFE] = -2 then T_SEQ_RANGE
                              else if SEQ_ITEM_OPENS and SEQ_LEVELS[?] >= 4 then T_RANK
                              else if SEQ_KEYWORD > 0 or SEQ_NAMES_ITEM or SEQ_ITEM_ENDS then 0 else T_EXPECTED_FOUND
        | SEQ_SEEDS := SEQ_ITERATION[?] and SEQ_PREVIOUS_KEY[?] >= 0
        | SEQ_DISPATCH := IN_SEQ_EMIT and STAGE_DONE and (SEQ_PHASE[?] = 2 or SEQ_PHASE[?] = 1 and not SEQ_SEEDS)
        | SEQ_DISPATCH_OK := CODE0 = C_CLOSE_BRACKET or CODE0 = C_COMMA and (CODE1 = C_OPEN_BRACE or CODE1 = C_OPEN_BRACKET)
        | SEQ_ELEMENT_STARTS := SEQ_DISPATCH and CODE0 = C_COMMA and CODE1 = C_OPEN_BRACKET
        | SEQ_PART_STARTS := SEQ_OPEN_HEAD or SEQ_ELEMENT_STARTS
        | SEQ_HIDDEN_KEY := if SEQ_OPENS then -1 else if SEQ_PART_STARTS then N_SEQ_MARK + (SEQ_TOTAL[?] + 1) * NAME_CAP else SEQ_HIDDEN_KEY[?]
        | SEQ_PREVIOUS_KEY := if SEQ_PART_STARTS then SEQ_HIDDEN_KEY[?] else SEQ_PREVIOUS_KEY[?]
        | SEQ_TOTAL := SEQ_TOTAL[?] + integer(SEQ_PART_STARTS and GO)
        | SEQ_ITERATION := if SEQ_OPEN_HEAD then true else if SEQ_ELEMENT_STARTS then false else SEQ_ITERATION[?]
        | SEQ_HEAD_DONE := IN_SEQ_EMIT and SEQ_PHASE[?] = 0 and STAGE_DONE
        | SEQ_FINAL_EMITS := IN_SEQ_EMIT and SEQ_PHASE[?] = 3
        | SEQ_APPENDS := IN_SEQ_EMIT and STAGE_DONE and (SEQ_PHASE[?] = 1 or SEQ_PHASE[?] = 2)
        | SEQ_PHASE := if IN_INDEX_EMIT or IN_SEQ_HEAD then 0
                       else if IN_SEQ_EMIT and STAGE_DONE then
                         (if SEQ_PHASE[?] = 0 then 1 else if SEQ_PHASE[?] = 1 and SEQ_SEEDS then 2 else if SEQ_DISPATCH and CODE0 = C_CLOSE_BRACKET then 3 else 0)
                       else SEQ_PHASE[?]
        | SEQ_LISTED := if IN_SEQ_EMIT and SEQ_PHASE[?] = 0 then CODE0 = C_OPEN_BRACKET else SEQ_LISTED[?]
        | SEQ_EQ_START := if IN_SEQ_EMIT and SEQ_PHASE[?] = 0 and INDEX_FRESH then ENTRY_COUNT[?] else SEQ_EQ_START[?]
        | SEQ_ON := if SEQ_OPENS then true else if SEQ_FINAL_EMITS then false else SEQ_ON[?]
        | SEQ_STAGE_KEY := if SEQ_PHASE[?] = 0 then
                             (if not SEQ_ITERATION[?] then OP_SEQ_ELEMENT else if CODE0 = C_OPEN_BRACKET then OP_SEQ_LIST
                              else if SEQ_LEVELS[?] = 1 then OP_SEQ_HEAD1 else if SEQ_LEVELS[?] = 2 then OP_SEQ_HEAD2
                              else if SEQ_LEVELS[?] = 3 then OP_SEQ_HEAD3 else OP_SEQ_HEAD4)
                           else if SEQ_PHASE[?] = 1 then (if SEQ_LISTED[?] then OP_SEQ_TAIL else OP_SEQ_TAIL_PAIR)
                           else if SEQ_PHASE[?] = 2 then OP_SEQ_ELEMENT else OP_SEQ_FINAL
        | SEQ_RANGE_KEY := if SEQ_BY_NAME[?][SEQ_J[?]] < 0 and SEQ_BY_VALUE[?][SEQ_J[?]] = long(1) then OP_SEQ_RANGE else OP_SEQ_SPAN
        | SEQ_EMITS_FIELD := STAGING and (STAGE_ITEM = OP_SEQ_FROM or STAGE_ITEM = OP_SEQ_TO or STAGE_ITEM = OP_SEQ_BY)
        | SEQ_FIELD_NAME := if STAGE_ITEM = OP_SEQ_FROM then SEQ_FROM_NAME[?][SEQ_J[?]] else if STAGE_ITEM = OP_SEQ_TO then SEQ_TO_NAME[?][SEQ_J[?]]
                            else SEQ_BY_NAME[?][SEQ_J[?]]
        | SEQ_FIELD_VALUE := if STAGE_ITEM = OP_SEQ_FROM then SEQ_FROM_VALUE[?][SEQ_J[?]] else if STAGE_ITEM = OP_SEQ_TO then SEQ_TO_VALUE[?][SEQ_J[?]]
                             else SEQ_BY_VALUE[?][SEQ_J[?]]
        | SEQ_FIELD_SIZE := if SEQ_FIELD_VALUE < long(0) then -SEQ_FIELD_VALUE else SEQ_FIELD_VALUE
        | SEQ_FIELD_TYPE := if SEQ_FIELD_SIZE < long(32768) then BUILTIN_SHORT else if SEQ_FIELD_SIZE < long(2147483648) then BUILTIN_INTEGER
                            else BUILTIN_LONG
        | SEQ_INDEX_LEVEL := if STAGE_INDEX[?] <= 2 then 0 else (STAGE_INDEX[?] - 1) / 2
        | SEQ_NAME_MATCH := if not SEQ_ON[?] or not SEQ_ITERATION[?] or CODE0 /= C_NAME then -1
                            else if SEQ_HEAD_NAME[?][0] = NAME0 then 0
                            else if SEQ_LEVELS[?] > 1 and SEQ_HEAD_NAME[?][1] = NAME0 then 1
                            else if SEQ_LEVELS[?] > 2 and SEQ_HEAD_NAME[?][2] = NAME0 then 2
                            else if SEQ_LEVELS[?] > 3 and SEQ_HEAD_NAME[?][3] = NAME0 then 3 else -1
        | INDEX_SLOT := if GO and INDEX_EQUATION then INDEX_TOTAL[?] else -1
        | INDEX_ID_NAME := INDEX_ID_NAME[?] next INDEX_SLOT : INDEX_NAME[?]
        | INDEX_ID_BOUND := INDEX_ID_BOUND[?] next INDEX_SLOT : INDEX_BOUND_AT
        | INDEX_ID_BOUND_END := INDEX_ID_BOUND_END[?] next INDEX_SLOT : INDEX_BOUND_END
        | INDEX_ID_TOKEN := INDEX_ID_TOKEN[?] next INDEX_SLOT : INDEX_TOKEN[?]
        | INDEX_ID_OP_TOKEN := INDEX_ID_OP_TOKEN[?] next INDEX_SLOT : INDEX_TOKEN[?] - integer(INDEX_IS_ARRAY[?])
        | INDEX_ID_ARRAY := INDEX_ID_ARRAY[?] next INDEX_SLOT : INDEX_IS_ARRAY[?]
        | INDEX_ID_SEQ := INDEX_ID_SEQ[?] next INDEX_SLOT : SEQ_ON[?]
        | INDEX_ID_MODEL := INDEX_ID_MODEL[?] next INDEX_SLOT : MODEL_NOW
        | INDEX_ID_TYPE := INDEX_ID_TYPE[?] next (if GO and IN_INDEX_DECLARE then DRAIN_ID else -1) : PARSED_TYPE[?]
        | INDEX_STACK := INDEX_STACK[?] next (if INDEX_SLOT >= 0 then INDEX_DEPTH[?] else -1) : INDEX_TOTAL[?]
        | INDEX_DEPTH := INDEX_DEPTH[?] + integer(INDEX_SLOT >= 0) - integer(GO and IN_INDEX_DECLARE)
        | INDEX_TOTAL := INDEX_TOTAL[?] + integer(INDEX_SLOT >= 0)
        | ALIAS_NAME := if IN_TYPE_STATEMENT then NAME0 else ALIAS_NAME[?]
        | NAME_ALIAS := NAME_ALIAS[?] next (if GO and IN_ALIAS_END then ALIAS_NAME[?] else -1) : PARSED_TYPE[?] + 1
        | INNER_WHERE := if INNER_WHERE_OPENS then true else if IN_PROGRAM and CODE0 = C_END then false else INNER_WHERE[?]
        | PRAGMA_ITEMS := if PRAGMAS_OPEN then 0 else if IN_PRAGMA_NAME and not PRAGMAS_CLOSE then PRAGMA_ITEMS[?] + 1 else PRAGMA_ITEMS[?]
        | SET_STARTS := IN_PROCESS and CODE0 = C_OPEN_BRACE and not CONDITION_OPENS
        | CONDITION_OPENS := IN_PROCESS and PROCESS_MESSAGE = 0 and CODE0 = C_OPEN_BRACE and CODE1 = C_NAME and CODE2 = C_ARROW
        | CONDITION_CLOSES := IN_POP and CONDITION_STAGE[?] = 1 and CODE0 = C_CLOSE_BRACE
        | CONDITION_WHEN := IN_POP and CONDITION_STAGE[?] = 2
        | CONDITION_ENDS := IN_EQUATION_END and CONDITION_STAGE[?] = 3 and TARGET[?] < 0 and not TUPLE_ACTIVE
        | CONDITION_STAGE := if CONDITION_OPENS then 1 else if CONDITION_CLOSES then 2 else if CONDITION_WHEN and CODE0 = C_WHEN then 3
                             else if CONDITION_ENDS then 0 else CONDITION_STAGE[?]
        | CONDITION_TOKEN := if CONDITION_WHEN then HERE else CONDITION_TOKEN[?]
        | SET_FROM_NAME := IN_EQUATION and FOLLOWER = C_ARROW
        | SET_RIGHT_OPENS := IN_DEPENDENCE and CODE0 = C_ARROW
        | SET_LEFT_START := if SET_STARTS then HERE + 1 else if SET_FROM_NAME then HERE
                            else if IN_SET_EMIT and EMIT_LAST then SET_RIGHT_START[?] else SET_LEFT_START[?]
        | SET_LEFT_COUNT := if SET_STARTS then 0 else if SET_FROM_NAME then 1
                            else if IN_SET_NAME and not SET_READING_RIGHT[?] then SET_LEFT_COUNT[?] + 1
                            else if IN_SET_EMIT and EMIT_LAST then SET_RIGHT_COUNT[?] else SET_LEFT_COUNT[?]
        | SET_RIGHT_START := if SET_RIGHT_OPENS then HERE + 1 + integer(CODE1 = C_OPEN_BRACE) else SET_RIGHT_START[?]
        | SET_RIGHT_COUNT := if SET_RIGHT_OPENS then integer(CODE1 /= C_OPEN_BRACE)
                             else if IN_SET_NAME and SET_READING_RIGHT[?] then SET_RIGHT_COUNT[?] + 1 else SET_RIGHT_COUNT[?]
        | SET_READING_RIGHT := if SET_STARTS then false else if SET_RIGHT_OPENS then true else SET_READING_RIGHT[?]
        | SET_ARROWED := if SET_STARTS or SET_FROM_NAME then false else if IN_SET_EMIT then true else SET_ARROWED[?]
        | EMIT_J := if IN_SET_EMIT and not EMIT_LAST_J then EMIT_J[?] + 1 else 0
        | EMIT_I := if IN_SET_EMIT then (if EMIT_LAST then 0 else EMIT_I[?] + integer(EMIT_LAST_J)) else 0
        | HIDE_RETURN := if HIDE_OPENS then STATE else HIDE_RETURN[?]
        | DECLARE_INITED := if IN_DECLARE_NAME then false else if IN_DECLARE_INIT then true else DECLARE_INITED[?]
        | INIT_SLOT := if GO and (IN_DECLARE_INIT and CODE0 /= C_OPEN and CODE0 /= C_OPEN_BRACKET or IN_INIT_END or DECLARE_LIST_STORES)
                       then SIGNAL_COUNT[?] - 1 else -1
        | SIGNAL_INIT_KIND := SIGNAL_INIT_KIND[?] next INIT_SLOT
                              : (if IN_INIT_END or DECLARE_LIST_STORES then INIT_CONST else if INIT_IS_NAME then INIT_NAME else if LITERAL_IS_ENUM then INIT_ENUMCONST
                                 else INIT_CONST)
        | SIGNAL_INIT_VALUE := SIGNAL_INIT_VALUE[?] next INIT_SLOT
                               : (if DECLARE_LIST_STORES then long(TABLE_COUNT[?]) else if IN_INIT_END then ENTRY_VALUE[?][EXPRESSION_START[?]] else LITERAL_VALUE)
        | SIGNAL_INIT_TYPE := SIGNAL_INIT_TYPE[?] next INIT_SLOT : (if DECLARE_LIST_STORES then DECLARED_TYPE else if IN_INIT_END then ENTRY_TYPE[?][EXPRESSION_START[?]] else LITERAL_TYPE)
        | SIGNAL_INIT_NAME := SIGNAL_INIT_NAME[?] next INIT_SLOT : (if DECLARE_LIST_STORES then -1 else NAME_AT_LITERAL)
        | SIGNAL_INIT_TOKEN := SIGNAL_INIT_TOKEN[?] next INIT_SLOT
                               : (if DECLARE_LIST_STORES then HERE else if IN_INIT_END then ENTRY_TOKEN[?][EXPRESSION_START[?]] else LITERAL_AT)
        | ROLE := if IN_MODEL_QUESTION then ROLE_INPUT else if IN_MODEL_BANG then ROLE_OUTPUT else if IN_PROGRAM then ROLE_LOCAL else ROLE[?]
        | PENDING_MODEL_KIND := if IN_START or IN_PROGRAM or MODEL_TYPE_STATEMENT then CODE0 else PENDING_MODEL_KIND[?]
        | TYPE_PENDING := if GO and MODEL_TYPE_STATEMENT then true else if CREATES_MODEL then false else TYPE_PENDING[?]
        | INTERFACE_COPY_SOURCE := if OPENS_COPY then NAMED_MODEL else INTERFACE_COPY_SOURCE[?]
        | INTERFACE_COPY_J := if OPENS_COPY then 0 else if INTERFACE_COPY_LIVE and GO then INTERFACE_COPY_J[?] + 1 else INTERFACE_COPY_J[?]
        | FORMAL_MODEL_TYPE := if IN_PARAMETER_MODEL then NAMED_MODEL else FORMAL_MODEL_TYPE[?]
        | MODEL_FORMAL_ROWS := MODEL_FORMAL_ROWS[?] + integer(PARAMETER_SLOT >= 0 and APPENDS_MODEL_FORMAL)
        | REF_ROWS := REF_ROWS[?] + integer(PARAMETER_SLOT >= 0 and APPENDS_REF)
        | ARRAY_SIZE := if IN_TYPE then ulong(0) else if IN_TYPE_SIZE then ulong(SIZE_VALUE) else if IN_INDEX_TYPE then DRAIN_SIZE
                      else if IN_DELAY_LIST_SIZE then DL_SIZE_NOW
                      else if OUTER_LEVEL then OUTER_SIZE else ARRAY_SIZE[?]
        | SIZE_DEPTH := if IN_TYPE or IN_INDEX_TYPE or IN_DELAY_ELEMENT and DL_ENDS then 0
                      else if IN_TYPE_SIZE or IN_DELAY_LIST_SIZE then SIZE_DEPTH[?] + 1
                      else if OUTER_LEVEL then SIZE_DEPTH[?] - 1 else SIZE_DEPTH[?]
        | SIZE_STACK := SIZE_STACK[?] next (if (IN_TYPE_SIZE or IN_DELAY_LIST_SIZE) and SIZE_DEPTH[?] < RANK_CAP then SIZE_DEPTH[?] else -1)
                      : (if IN_DELAY_LIST_SIZE then DL_SIZE_NOW else ulong(SIZE_VALUE))
        | ARRAY_BUCKET := if IN_TYPE_NAME then BUCKET_HERE else if IN_INDEX_TYPE then DRAIN_BUCKET else if IN_DELAY_LIST_SIZE then DL_BUCKET
                        else if OUTER_LEVEL then OUTER_BUCKET
                        else ARRAY_BUCKET[?]
        | CANDIDATE := if IN_TYPE_NAME then ARRAY_HEAD[?][BUCKET_HERE] - 1 else if IN_INDEX_TYPE then ARRAY_HEAD[?][DRAIN_BUCKET] - 1
                       else if IN_DELAY_LIST_SIZE then ARRAY_HEAD[?][DL_BUCKET] - 1
                       else if OUTER_LEVEL then ARRAY_HEAD[?][OUTER_BUCKET] - 1
                       else if IN_TYPE_INTERN then ARRAY_NEXT[?][INTERN_CANDIDATE] - 1 else CANDIDATE[?]
        | ARRAY_ELEMENT := if IN_TYPE_NAME then ELEMENT_TYPE else if IN_INDEX_TYPE then BUILTIN_INTEGER else if IN_DELAY_LIST_SIZE then DL_LEAF[?]
                         else if OUTER_LEVEL then FINISHED_TYPE
                         else ARRAY_ELEMENT[?]
        | PARSED_TYPE := if TYPE_FINISHED then FINISHED_TYPE else PARSED_TYPE[?]
        | DECLARE_NAME := if IN_CONSTANT_NAME or IN_DECLARE_NAME then NAME0 else DECLARE_NAME[?]
        | DECLARE_TOKEN := if IN_CONSTANT_NAME or DECLARE_LIST_OPENS then HERE else DECLARE_TOKEN[?]
        | CONSTANT_RETURN := if IN_CONSTANT_DEFINITION then (if CODE0 = C_OPEN_BRACKET then P_CONSTANT_ELEMENT else P_CONSTANT_SCALAR)
                             else if DECLARE_LIST_OPENS then P_CONSTANT_ELEMENT else if DL_OPENS then P_DELAY_ELEMENT
                             else CONSTANT_RETURN[?]
        | CONSTANT_VALUE_HELD := if IN_INTEGER_CONSTANT then (if CONVERTS then WRAPPED else if ELEMENT_PAIRS then long(CX_COUNT[?] + 1) else SIGNED_LITERAL)
                               else if IN_CONSTANT_END then ENTRY_VALUE[?][EXPRESSION_START[?]] else CONSTANT_VALUE_HELD[?]
        | CONSTANT_VALUE_TYPE := if IN_INTEGER_CONSTANT then (if CONVERTS then TOKEN_TYPE else if ELEMENT_PAIRS then PAIR_TYPE else CONSTANT_LITERAL_TYPE)
                                 else if IN_CONSTANT_END then ENTRY_TYPE[?][EXPRESSION_START[?]]
                                 else CONSTANT_VALUE_TYPE[?]
        | LIST_FOR_DECLARE := if IN_CONSTANT_DEFINITION then false else if DECLARE_LIST_OPENS then true else LIST_FOR_DECLARE[?]
        | LIST_COUNT := if IN_CONSTANT_DEFINITION or DECLARE_LIST_OPENS or DL_OPENS then 0 else if APPENDS_POOL then LIST_COUNT[?] + 1 else LIST_COUNT[?]
        | LIST_START := if IN_CONSTANT_DEFINITION or DECLARE_LIST_OPENS or DL_OPENS then POOL_COUNT[?] else LIST_START[?]
        | POPS_LEVEL := POPS_FRAME and FRAME_TOP_KIND = FRAME_ITERATE
        | POPS_INNER_LEVEL := POPS_LEVEL and FRAME_TOP >= 1 and FRAME_KIND[?][FRAME_TOP - 1] = FRAME_ITERATE
        | LOOP_NOW := if IN_ITERATE_OF then (if NEST_LEVEL[?] then LOOP_NOW[?] else LOOP_COUNT[?] - 1)
                      else if POPS_LEVEL and not POPS_INNER_LEVEL then -1 else LOOP_NOW[?]
        | LOOP_TARGET_OPENS := IN_OPERATOR and OPERATOR_CASE = X_OPEN_SQUARE and HERE > 0 and ELEMENT_TARGET[HERE - 1] and LOOP_NOW[?] >= 0
                               and not LOOP_SEED[?]
        | LOOP_TARGET := if LOOP_TARGET_OPENS then true else if DEFINE_PAIR_HERE and IN_OPERATOR and OPERATOR_CASE = X_BINARY then false
                         else LOOP_TARGET[?]
        | LOOP_SEED := if IN_ITERATE_OF then false else if IN_POP and POP_ITERATE_SEEDS then true else if POPS_LEVEL then false else LOOP_SEED[?]
        | LABEL_NODE := if CREATES_USE then USE_COUNT[?]
                        else if POPS_FRAME and FRAME_TOP_KIND = FRAME_LABEL then USE_PARENT[?][FRAME_TOP_VALUE] else LABEL_NODE[?]
        | GUARD_NODE := if CREATES_GUARD then GUARD_COUNT[?]
                        else if POPS_FRAME and FRAME_TOP_KIND = FRAME_GUARD then GUARD_CONTEXT[?][FRAME_TOP_VALUE] else GUARD_NODE[?]
        | GUARD_START_TOKEN := if IN_PROCESS and CODE0 = C_ON or CASE_BRANCH_STARTS or STATE_ACTION_OPENS then HERE else GUARD_START_TOKEN[?]
        | EXPRESSION_START := if STARTS_EXPRESSION or IN_REPEAT_EMIT and INDEX_FRESH or SEQ_FINAL_EMITS then ENTRY_COUNT[?]
                              else if SEQ_HEAD_DONE or TUPLE_HEAD_DONE then ENTRY_COUNT[?] + 1 else EXPRESSION_START[?]
        | EXPRESSION_RETURN := if SEQ_HEAD_DONE then P_SEQ_EMIT else if TUPLE_HEAD_DONE then P_TUPLE_EMIT else if SEQ_FINAL_EMITS then P_EQUATION_END
                               else if not STARTS_EXPRESSION then EXPRESSION_RETURN[?]
                               else if TUPLE_STARTS then P_EQUATION_END else if IN_PROCESS and CODE0 = C_CASE then P_CASE_IN
                               else if IN_PROCESS then P_GUARD_COLONS else if IN_EQUATION then P_EQUATION_END
                               else if IN_ARRAY_TO then P_INDEX_EMIT else if IN_CONSTANT_DEFINITION then P_CONSTANT_END
                               else if IN_DECLARE_INIT then P_INIT_END else P_GROUP_MEMBER
        | TARGET := if IN_EQUATION then (if FOLLOWER = C_DEFINE or FOLLOWER = C_PARTIAL_DEFINE then NAME0 else -1)
                    else if TUPLE_NAMES_TARGET then (if TUPLE_ELEMENT_ROW[?][TUPLE_POSITION] then TUPLE_MAIN_KEY else TUPLE_NAME_ROW[?][TUPLE_POSITION])
                    else TARGET[?]
        | PARTIAL_NOW := if IN_EQUATION then (if FOLLOWER = C_PARTIAL_DEFINE then 1 + integer(CODE2 = C_DEFAULTVALUE) else 0)
                         else if TUPLE_DEFINES then 0 else PARTIAL_NOW[?]
        | EQUATION_TOKEN := if IN_EQUATION or SET_STARTS then HERE else if TUPLE_NAMES_TARGET then TUPLE_TOKEN_ROW[?][TUPLE_POSITION] else EQUATION_TOKEN[?]
        | GROUP_MEMBER_START := if IN_EQUATION_END or IN_SYNC and SYNC_I[?] = 0 then MEMBER_COUNT[?] else GROUP_MEMBER_START[?]
        | CALL_HEAD := if IN_OPERAND then HERE else CALL_HEAD[?]
        | PARAMETER_START := if IN_OPERAND then HERE + 2 else PARAMETER_START[?]
        | PARAMETER_COUNT := if IN_OPERAND then 0 else if IN_PARAMETER then PARAMETER_COUNT[?] + 1 else PARAMETER_COUNT[?]
        | CURRENT_MODEL := if CREATES_MODEL then MODEL_COUNT[?] else if CLOSES_MODEL then PARENT_NOW else MODEL_NOW
        | TYPE_SLOT := if GO and (IN_COPY_TYPES or CREATES_ARRAY_TYPE or MAKES_STATE_TYPE) then TYPE_COUNT[?] else -1
        | TYPE_KIND := TYPE_KIND[?] next TYPE_SLOT
                       : (if IN_COPY_TYPES then (if COPY_IS_BUILTIN then BUILTIN_KIND[COPIED_TYPE] else USER_TYPE_KIND[COPIED_USER])
                          else if CREATES_ARRAY_TYPE then TK_ARRAY else TK_ENUM)
        | TYPE_BYTES := TYPE_BYTES[?] next (if GO and MACHINE_STATEMENT then BUILTIN_POINTER else TYPE_SLOT)
                        : (if MACHINE_STATEMENT then 4 else if IN_COPY_TYPES then
                             (if COPY_IS_BUILTIN then BUILTIN_BYTES[COPIED_TYPE] else if USER_TYPE_KIND[COPIED_USER] = TK_ENUM then 4 else 0)
                           else if CREATES_ARRAY_TYPE then 8 else 4)
        | TYPE_SIGNED := TYPE_SIGNED[?] next TYPE_SLOT : IN_COPY_TYPES and COPY_IS_BUILTIN and BUILTIN_SIGNED[COPIED_TYPE] = 1
        | TYPE_NAME := TYPE_NAME[?] next TYPE_SLOT
                       : (if IN_COPY_TYPES then (if COPY_IS_BUILTIN then COPIED_TYPE else USER_TYPE_NAME[COPIED_USER])
                          else if CREATES_ARRAY_TYPE then -1 else MODEL_NOW)
        | TYPE_STATE := TYPE_STATE[?] next TYPE_SLOT : MAKES_STATE_TYPE
        | TYPE_VALUE_START := TYPE_VALUE_START[?] next TYPE_SLOT
                              : (if IN_COPY_TYPES and not COPY_IS_BUILTIN then USER_TYPE_VALUE_START[COPIED_USER] else 0)
        | TYPE_VALUE_COUNT := TYPE_VALUE_COUNT[?] next TYPE_SLOT
                              : (if IN_COPY_TYPES and not COPY_IS_BUILTIN then USER_TYPE_VALUE_COUNT[COPIED_USER] else 0)
        | TYPE_ELEMENT := TYPE_ELEMENT[?] next TYPE_SLOT
                          : (if CREATES_ARRAY_TYPE then ARRAY_ELEMENT[?] else if IN_COPY_TYPES and COPIED_TYPE = BUILTIN_STRING then BUILTIN_UBYTE else -1)
        | TYPE_SIZE := TYPE_SIZE[?] next TYPE_SLOT
                       : (if CREATES_ARRAY_TYPE then ARRAY_SIZE[?] else if IN_COPY_TYPES and COPIED_TYPE = BUILTIN_STRING then ulong(STRING_SIZE) else ulong(0))
        | ARRAY_NEXT := ARRAY_NEXT[?] next TYPE_SLOT : (if CREATES_ARRAY_TYPE then ARRAY_HEAD[?][ARRAY_BUCKET[?]] else 0)
        | ARRAY_HEAD := ARRAY_HEAD[?] next (if GO and CREATES_ARRAY_TYPE then ARRAY_BUCKET[?] else -1) : TYPE_COUNT[?] + 1
        | TYPE_COUNT := TYPE_COUNT[?] + integer(TYPE_SLOT >= 0)
        | MODEL_SLOT := if GO and CREATES_MODEL then MODEL_COUNT[?] else -1
        | MODEL_NAME := MODEL_NAME[?] next MODEL_SLOT : NAME0
        | MODEL_KIND := MODEL_KIND[?] next MODEL_SLOT : PENDING_MODEL_KIND[?]
        | ATTRIBUTE_SLOT := if MODEL_SLOT >= 0 then MODEL_SLOT else if GO and IS_ATTRIBUTE_HERE then MODEL_NOW else -1
        | CLASS_ATTRIBUTE := if PENDING_MODEL_KIND[?] = C_FUNCTION then ATTRIBUTE_SAFE
                             else if PENDING_MODEL_KIND[?] = C_NODE or PENDING_MODEL_KIND[?] = C_AUTOMATON then ATTRIBUTE_DETERMINISTIC
                             else ATTRIBUTE_UNSAFE
        | MODEL_ATTRIBUTE := MODEL_ATTRIBUTE[?] next ATTRIBUTE_SLOT : (if MODEL_SLOT >= 0 then CLASS_ATTRIBUTE else ATTRIBUTE_WORD)
        | MODEL_IS_TYPE := MODEL_IS_TYPE[?] next MODEL_SLOT : TYPE_PENDING[?]
        | NAME_MODEL_SLOT := NAME_MODEL_SLOT[?] next (if MODEL_SLOT >= 0 then NAME0 else -1) : MODEL_SLOT + 1
        | MODEL_PARENT := MODEL_PARENT[?] next MODEL_SLOT : MODEL_NOW
        | MODEL_TOKEN := MODEL_TOKEN[?] next MODEL_SLOT : HERE
        | ROOT_MODEL := if MODEL_SLOT >= 0 and MODEL_NOW < 0 and not IN_MODULE[?] then MODEL_SLOT else ROOT_MODEL[?]
        | PRIVATE_PENDING := if GO and IN_PROGRAM then CODE0 = C_PRIVATE else PRIVATE_PENDING[?]
        | PRIVATE_DECLARATION := if GO and IN_PROGRAM then PRIVATE_PENDING[?] else PRIVATE_DECLARATION[?]
        | STATEVAR_PENDING := if GO and IN_PROGRAM then CODE0 = C_STATEVAR else STATEVAR_PENDING[?]
        | STATEVAR_DECLARATION := if GO and IN_PROGRAM then STATEVAR_PENDING[?] else STATEVAR_DECLARATION[?]
        | SHARED_PENDING := if GO and IN_PROGRAM then CODE0 = C_SHARED else SHARED_PENDING[?]
        | SHARED_DECLARATION := if GO and IN_PROGRAM then SHARED_PENDING[?] else SHARED_DECLARATION[?]
        | IN_MODULE := if GO and IN_MODULE_NAME then true else if GO and IN_MODULE_END then false else IN_MODULE[?]
        | MODULE_SLOT := if GO and IN_MODULE_NAME then MODULE_COUNT[?] else -1
        | MODULE_NAME := MODULE_NAME[?] next MODULE_SLOT : NAME0
        | MODULE_TOKEN := MODULE_TOKEN[?] next MODULE_SLOT : HERE
        | NAME_MODULE := NAME_MODULE[?] next (if MODULE_SLOT >= 0 then NAME0 else -1) : MODULE_SLOT + 1
        | MODULE_COUNT := MODULE_COUNT[?] + integer(MODULE_SLOT >= 0)
        | MODULE_END_TOKEN := MODULE_END_TOKEN[?] next (if GO and IN_MODULE_END then MODULE_NOW else -1) : HERE
        | IMPORT_SLOT := if GO and IN_USE_NAME then IMPORT_COUNT[?] else -1
        | IMPORT_NAME := IMPORT_NAME[?] next IMPORT_SLOT : NAME0
        | IMPORT_TOKEN := IMPORT_TOKEN[?] next IMPORT_SLOT : HERE
        | IMPORT_MODEL := IMPORT_MODEL[?] next IMPORT_SLOT : MODEL_NOW
        | IMPORT_OWNER_MODULE := IMPORT_OWNER_MODULE[?] next IMPORT_SLOT : MODULE_NOW
        | IMPORT_COUNT := IMPORT_COUNT[?] + integer(IMPORT_SLOT >= 0)
        | MODEL_SIGNAL_START := MODEL_SIGNAL_START[?] next MODEL_SLOT : SIGNAL_COUNT[?]
        | MODEL_LABEL_START := MODEL_LABEL_START[?] next MODEL_SLOT : LABEL_COUNT[?]
        | MODEL_PARAMETER_START := MODEL_PARAMETER_START[?] next MODEL_SLOT : PARAMETER_ROWS[?]
        | MODEL_FORMAL_END := MODEL_FORMAL_END[?] next (if GO and IN_MODEL_OPEN and not MODEL_FORMALS_OPENS then MODEL_NOW else -1)
                            : PARAMETER_ROWS[?]
        | FORMALS_OPEN := if MODEL_FORMALS_OPENS then true else if IN_PARAMETER_OPEN and CODE0 = C_CLOSE_BRACE then false else FORMALS_NOW
        | NAME_MODEL := NAME_MODEL[?] next (if GO and CREATES_MODEL then NAME0 else -1) : true
        | MODEL_COUNT := MODEL_COUNT[?] + integer(MODEL_SLOT >= 0)
        | MODEL_INPUTS := MODEL_INPUTS[?] next (if IN_MODEL_BANG or COPY_ENDS then MODEL_NOW else -1)
                          : (if COPY_ENDS then MODEL_INPUTS[?][INTERFACE_COPY_SOURCE[?]] else SIGNAL_COUNT[?] - MODEL_SIGNAL_START[?][MODEL_NOW])
        | ENDS_BODY := IN_POP and POPS_FRAME and FRAME_DEPTH[?] = 1 or TYPE_NOW and CLOSES_MODEL
        | BODY_SLOT := if ENDS_BODY then MODEL_NOW else -1
        | MODEL_EQUATION_START := MODEL_EQUATION_START[?] next BODY_SLOT : BODY_EQUATION_START[?]
        | MODEL_EQUATION_END := MODEL_EQUATION_END[?] next BODY_SLOT : EQUATION_COUNT[?]
        | MODEL_GROUP_START := MODEL_GROUP_START[?] next BODY_SLOT : BODY_GROUP_START[?]
        | MODEL_GROUP_END := MODEL_GROUP_END[?] next BODY_SLOT : GROUP_COUNT[?]
        | MODEL_DEPENDENCE_START := MODEL_DEPENDENCE_START[?] next BODY_SLOT : BODY_DEPENDENCE_START[?]
        | MODEL_DEPENDENCE_END := MODEL_DEPENDENCE_END[?] next BODY_SLOT : DEPENDENCE_COUNT[?]
        | MODEL_GUARD_START := MODEL_GUARD_START[?] next BODY_SLOT : BODY_GUARD_START[?]
        | MODEL_GUARD_END := MODEL_GUARD_END[?] next BODY_SLOT : GUARD_COUNT[?]
        | MODEL_USE_START := MODEL_USE_START[?] next BODY_SLOT : BODY_USE_START[?]
        | MODEL_USE_END := MODEL_USE_END[?] next BODY_SLOT : USE_COUNT[?]
        | MODEL_MEMBER_START := MODEL_MEMBER_START[?] next BODY_SLOT : BODY_MEMBER_START[?]
        | MODEL_MEMBER_END := MODEL_MEMBER_END[?] next BODY_SLOT : MEMBER_COUNT[?]
        | MODEL_INTRINSICS := MODEL_INTRINSICS[?] next BODY_SLOT : BODY_INTRINSICS[?]
        | MODEL_STATEMENTS := MODEL_STATEMENTS[?] next BODY_SLOT : BODY_STATEMENTS[?]
        | MODEL_PARAMETER_END := MODEL_PARAMETER_END[?] next (if BODY_SLOT >= 0 then BODY_SLOT else if GO and APPENDS_REF then MODEL_NOW else -1)
                                 : PARAMETER_ROWS[?] + integer(BODY_SLOT < 0)
        | CLOSE_SLOT := if GO and CLOSES_MODEL then MODEL_NOW else -1
        | MODEL_CLOSED := MODEL_CLOSED[?] next CLOSE_SLOT : true
        | MODEL_END_TOKEN := MODEL_END_TOKEN[?] next CLOSE_SLOT : HERE
        | MODEL_CLOSE_SIGNALS := MODEL_CLOSE_SIGNALS[?] next CLOSE_SLOT : SIGNAL_COUNT[?]
        | MODEL_CLOSE_EQUATIONS := MODEL_CLOSE_EQUATIONS[?] next CLOSE_SLOT : EQUATION_COUNT[?]
        | MODEL_CLOSE_GROUPS := MODEL_CLOSE_GROUPS[?] next CLOSE_SLOT : GROUP_COUNT[?]
        | MODEL_CLOSE_LABELS := MODEL_CLOSE_LABELS[?] next CLOSE_SLOT : LABEL_COUNT[?]
        | MODEL_STATE_TYPE := MODEL_STATE_TYPE[?] next CLOSE_SLOT : (if MAKES_STATE_TYPE then TYPE_COUNT[?] else -1)
        | CLOSE_ORDER := CLOSE_ORDER[?] next (if CLOSE_SLOT >= 0 then CLOSED_COUNT[?] else -1) : MODEL_NOW
        | CLOSED_COUNT := CLOSED_COUNT[?] + integer(CLOSE_SLOT >= 0)
        | LOCAL_SLOT := if GO and PUSHES_LOCAL then LOCAL_COUNT[?] else -1
        | LOCAL_MODEL := LOCAL_MODEL[?] next LOCAL_SLOT : MODEL_NOW
        | LOCAL_PREVIOUS := LOCAL_PREVIOUS[?] next LOCAL_SLOT : LOCAL_TOP + 1
        | LOCAL_FORMAL_SLOT := LOCAL_FORMAL_SLOT[?] next LOCAL_SLOT
                               : (if APPENDS_TYPE_FORMAL then PARAMETER_ROWS[?] - MODEL_PARAMETER_START[?][MODEL_NOW] else -1)
        | TOKEN_FORMAL_SLOT := TOKEN_FORMAL_SLOT[?] next (if GO and IN_PARAMETER and FORMAL_SLOT_HERE >= 0 then HERE else -1)
                               : FORMAL_SLOT_HERE + 1
        | LOCAL_HEAD := LOCAL_HEAD[?] next (if STALE then LOOKUP_KEY else if LOCAL_SLOT >= 0 then LOOKUP_KEY else -1)
                        : (if STALE then LOCAL_PREVIOUS[?][LOCAL_TOP] else LOCAL_COUNT[?] + 1)
        | LOCAL_COUNT := LOCAL_COUNT[?] + integer(LOCAL_SLOT >= 0)
        | SIGNAL_SLOT := if GO and (APPENDS_SIGNAL or APPENDS_INDEX_SIGNAL or INTERFACE_COPY_LIVE) then SIGNAL_COUNT[?] else -1
        | SIGNAL_NAME := SIGNAL_NAME[?] next SIGNAL_SLOT : LOOKUP_KEY
        | SIGNAL_ROLE := SIGNAL_ROLE[?] next SIGNAL_SLOT
                         : (if APPENDS_INDEX_SIGNAL then ROLE_LOCAL else if INTERFACE_COPY_LIVE then SIGNAL_ROLE[?][INTERFACE_COPY_ROW] else ROLE[?])
        | SIGNAL_TYPE := SIGNAL_TYPE[?] next SIGNAL_SLOT : (if INTERFACE_COPY_LIVE then SIGNAL_TYPE[?][INTERFACE_COPY_ROW] else DECLARED_TYPE)
        | SIGNAL_MODEL := SIGNAL_MODEL[?] next SIGNAL_SLOT : MODEL_NOW
        | SIGNAL_STATEVAR := SIGNAL_STATEVAR[?] next SIGNAL_SLOT : APPENDS_SIGNAL and STATEVAR_DECLARATION
        | SIGNAL_SHARED := SIGNAL_SHARED[?] next SIGNAL_SLOT : APPENDS_SIGNAL and SHARED_DECLARATION
        | SIGNAL_TOKEN := SIGNAL_TOKEN[?] next SIGNAL_SLOT : (if APPENDS_INDEX_SIGNAL then INDEX_ID_TOKEN[?][DRAIN_ID] else HERE)
        | NAME_SIGNAL_EVER := NAME_SIGNAL_EVER[?] next (if SIGNAL_SLOT >= 0 then LOOKUP_KEY else if PARAMETER_SLOT >= 0 then NAME0 else -1)
                              : true
        | PARAMETER_SLOT := if GO and APPENDS_PARAMETER then PARAMETER_ROWS[?] else -1
        | PARAMETER_NAME := PARAMETER_NAME[?] next PARAMETER_SLOT : NAME0
        | PARAMETER_KIND := PARAMETER_KIND[?] next PARAMETER_SLOT
                            : (if APPENDS_TYPE_FORMAL then PK_TYPE else if APPENDS_MODEL_FORMAL then PK_MODEL else if APPENDS_REF then PK_SIGNAL
                               else PK_VALUE)
        | PARAMETER_TYPE := PARAMETER_TYPE[?] next PARAMETER_SLOT
                            : (if APPENDS_TYPE_FORMAL or APPENDS_MODEL_FORMAL or APPENDS_REF then -1 else DECLARED_TYPE)
        | PARAMETER_MODEL := PARAMETER_MODEL[?] next PARAMETER_SLOT : (if APPENDS_MODEL_FORMAL then FORMAL_MODEL_TYPE[?] else -1)
        | NAME_MODEL_FORMAL_EVER := NAME_MODEL_FORMAL_EVER[?] next (if PARAMETER_SLOT >= 0 and APPENDS_MODEL_FORMAL then NAME0 else -1) : true
        | PARAMETER_POSITION := PARAMETER_POSITION[?] next PARAMETER_SLOT : HERE
        | PARAMETER_ROWS := PARAMETER_ROWS[?] + integer(PARAMETER_SLOT >= 0)
        | MODEL_HAS_SIGNAL := MODEL_LAST_SIGNAL[?][MODEL_NOW] > 0
        | MODEL_FIRST_SIGNAL := MODEL_FIRST_SIGNAL[?] next (if SIGNAL_SLOT >= 0 and not MODEL_HAS_SIGNAL then MODEL_NOW else -1)
                                : SIGNAL_COUNT[?] + 1
        | SIGNAL_NEXT := SIGNAL_NEXT[?] next (if SIGNAL_SLOT >= 0 and MODEL_HAS_SIGNAL then MODEL_LAST_SIGNAL[?][MODEL_NOW] - 1 else -1)
                         : SIGNAL_COUNT[?] + 1
        | MODEL_LAST_SIGNAL := MODEL_LAST_SIGNAL[?] next SIGNAL_SLOT_MODEL : SIGNAL_COUNT[?] + 1
        | SIGNAL_SLOT_MODEL := if SIGNAL_SLOT >= 0 then MODEL_NOW else -1
        | SIGNAL_COUNT := SIGNAL_COUNT[?] + integer(SIGNAL_SLOT >= 0)
        | LABEL_SLOT := if GO and APPENDS_LABEL then LABEL_COUNT[?] else -1
        | LABEL_NAME := LABEL_NAME[?] next LABEL_SLOT : NAME0
        | LABEL_MODEL := LABEL_MODEL[?] next LABEL_SLOT : MODEL_NOW
        | NAME_LABEL_EVER := NAME_LABEL_EVER[?] next (if LABEL_SLOT >= 0 then NAME0 else -1) : true
        | MODEL_HAS_LABEL := MODEL_LAST_LABEL[?][MODEL_NOW] > 0
        | MODEL_FIRST_LABEL := MODEL_FIRST_LABEL[?] next (if LABEL_SLOT >= 0 and not MODEL_HAS_LABEL then MODEL_NOW else -1)
                               : LABEL_COUNT[?] + 1
        | LABEL_NEXT := LABEL_NEXT[?] next (if LABEL_SLOT >= 0 and MODEL_HAS_LABEL then MODEL_LAST_LABEL[?][MODEL_NOW] - 1 else -1)
                        : LABEL_COUNT[?] + 1
        | MODEL_LAST_LABEL := MODEL_LAST_LABEL[?] next (if LABEL_SLOT >= 0 then MODEL_NOW else -1) : LABEL_COUNT[?] + 1
        | LABEL_COUNT := LABEL_COUNT[?] + integer(LABEL_SLOT >= 0)
        | CONSTANT_SLOT := if GO and STORES_CONSTANT then CONSTANT_COUNT[?] else -1
        | VISIBILITY_KEY := if not IN_MODULE[?] then -1 else if MODEL_SLOT >= 0 then NAME0
                            else if CONSTANT_SLOT >= 0 then DECLARE_NAME[?]
                            else if GO and IN_ALIAS_END then ALIAS_NAME[?]
                            else if GO and IN_TYPE_STATEMENT and not ALIAS_STATEMENT then NAME0 else -1
        | NAME_VISIBILITY := NAME_VISIBILITY[?] next VISIBILITY_KEY : VISIBILITY_NOW
        | CONSTANT_NAME := CONSTANT_NAME[?] next CONSTANT_SLOT : DECLARE_NAME[?]
        | CONSTANT_TYPE := CONSTANT_TYPE[?] next CONSTANT_SLOT : DECLARED_TYPE
        | CONSTANT_VALUE := CONSTANT_VALUE[?] next CONSTANT_SLOT : CONSTANT_VALUE_NOW
        | NAME_CONSTANT := NAME_CONSTANT[?] next (if CONSTANT_SLOT >= 0 then DECLARE_NAME[?] else -1) : CONSTANT_COUNT[?] + 1
        | CONSTANT_COUNT := CONSTANT_COUNT[?] + integer(CONSTANT_SLOT >= 0)
        | TABLE_SLOT := if GO and (STORES_TABLE or LITERAL_TABLE_STORES) then TABLE_COUNT[?] else -1
        | TABLE_TYPE := TABLE_TYPE[?] next TABLE_SLOT : (if LITERAL_TABLE_STORES then BUILTIN_STRING else DECLARED_TYPE)
        | TABLE_FROM_STRING := TABLE_FROM_STRING[?] next TABLE_SLOT : STORES_STRING or LITERAL_TABLE_STORES
        | TABLE_START := TABLE_START[?] next TABLE_SLOT
                       : (if STORES_STRING then TOKEN_TEXT[HERE] else if LITERAL_TABLE_STORES then TOKEN_TEXT[LITERAL_AT] else LIST_START[?])
        | TABLE_LENGTH := TABLE_LENGTH[?] next TABLE_SLOT
                        : (if STORES_STRING then STRING_BYTES else if LITERAL_TABLE_STORES then LITERAL_STRING_BYTES
                           else if IN_DELAY_LIST_END then LIST_COUNT[?] else ELEMENT_COUNT)
        | TABLE_COUNT := TABLE_COUNT[?] + integer(TABLE_SLOT >= 0)
        | POOL_VALUE := POOL_VALUE[?] next (if GO and APPENDS_POOL then POOL_COUNT[?] else -1) : (if CONSTANT_WIDENS then WIDENED else CONSTANT_VALUE_HELD[?])
        | POOL_COUNT := POOL_COUNT[?] + integer(GO and APPENDS_POOL)
        | CX_SLOT := if GO and (CX_FOLDS or ELEMENT_PAIRS) then CX_COUNT[?] else -1
        | CX_RE32 := CX_RE32[?] next CX_SLOT : (if ELEMENT_PAIRS then SIGNED_LITERAL else FOLD_VL)
        | CX_IM32 := CX_IM32[?] next CX_SLOT : (if ELEMENT_PAIRS then SIGNED_LITERAL2 else FOLD_VR)
        | CX_RE64 := CX_RE64[?] next CX_SLOT
                     : (if (if ELEMENT_PAIRS then CONSTANT_LITERAL_TYPE else FOLD_TL) = BUILTIN_REAL then WIDENED else if ELEMENT_PAIRS then SIGNED_LITERAL else FOLD_VL)
        | CX_IM64 := CX_IM64[?] next CX_SLOT
                     : (if (if ELEMENT_PAIRS then LITERAL2_TYPE else FOLD_TR) = BUILTIN_REAL then WIDER else if ELEMENT_PAIRS then SIGNED_LITERAL2 else FOLD_VR)
        | CX_COUNT := CX_COUNT[?] + integer(CX_SLOT >= 0)
        | USE_SLOT := if GO and CREATES_USE then USE_COUNT[?] else -1
        | USE_MODEL := USE_MODEL[?] next USE_SLOT : MODEL_NOW
        | USE_NAME := USE_NAME[?] next USE_SLOT : NAME0
        | USE_TOKEN := USE_TOKEN[?] next USE_SLOT : HERE
        | USE_PARENT := USE_PARENT[?] next USE_SLOT : LABEL_NODE[?]
        | USE_PATH_START := USE_PATH_START[?] next USE_SLOT : PATH_COUNT[?]
        | USE_PATH_LENGTH := USE_PATH_LENGTH[?] next USE_SLOT : PATH_PARENT_LENGTH + 1
        | USE_EQUATION_FIRST := USE_EQUATION_FIRST[?] next USE_SLOT : EQUATION_COUNT[?]
        | USE_CLOSE_SLOT := if POPS_FRAME and FRAME_TOP_KIND = FRAME_LABEL then FRAME_TOP_VALUE else -1
        | USE_EQUATION_LAST := USE_EQUATION_LAST[?] next USE_CLOSE_SLOT : EQUATION_COUNT[?]
        | USE_COUNT := USE_COUNT[?] + integer(USE_SLOT >= 0)
        | GUARD_SLOT := if GO and CREATES_GUARD then GUARD_COUNT[?] else -1
        | GUARD_MODEL := GUARD_MODEL[?] next GUARD_SLOT : MODEL_NOW
        | GUARD_ENTRY_START := GUARD_ENTRY_START[?] next GUARD_SLOT : EXPRESSION_START[?]
        | GUARD_ENTRY_COUNT := GUARD_ENTRY_COUNT[?] next GUARD_SLOT : ENTRY_COUNT[?] - EXPRESSION_START[?]
        | GUARD_TOKEN := GUARD_TOKEN[?] next GUARD_SLOT : GUARD_START_TOKEN[?]
        | GUARD_CONTEXT := GUARD_CONTEXT[?] next GUARD_SLOT : GUARD_NODE[?]
        | GUARD_CASE := GUARD_CASE[?] next GUARD_SLOT : (if IN_CASE_GUARD then FRAME_CASE_START[?][FRAME_TOP] + 1 else 0)
        | GUARD_BRANCH := GUARD_BRANCH[?] next GUARD_SLOT
                          : (if IN_CASE_GUARD then GUARD_SLOT else if GUARD_NODE[?] >= 0 then GUARD_BRANCH[?][GUARD_NODE[?]] else -1)
        | GUARD_LABELS := GUARD_LABELS[?] next GUARD_SLOT : LABEL_NODE[?]
        | GUARD_PATH_START := GUARD_PATH_START[?] next GUARD_SLOT : PATH_COUNT[?]
        | GUARD_PATH_LENGTH := GUARD_PATH_LENGTH[?] next GUARD_SLOT : PATH_PARENT_LENGTH + 1
        | GUARD_EQUATION_FIRST := GUARD_EQUATION_FIRST[?] next GUARD_SLOT : EQUATION_COUNT[?]
        | GUARD_GROUP_FIRST := GUARD_GROUP_FIRST[?] next GUARD_SLOT : GROUP_COUNT[?]
        | GUARD_DEPENDENCE_FIRST := GUARD_DEPENDENCE_FIRST[?] next GUARD_SLOT : DEPENDENCE_COUNT[?]
        | GUARD_CLOSE_SLOT := if POPS_FRAME and FRAME_TOP_KIND = FRAME_GUARD then FRAME_TOP_VALUE else -1
        | GUARD_END := GUARD_END[?] next GUARD_CLOSE_SLOT : GUARD_COUNT[?]
        | GUARD_EQUATION_LAST := GUARD_EQUATION_LAST[?] next GUARD_CLOSE_SLOT : EQUATION_COUNT[?]
        | GUARD_GROUP_LAST := GUARD_GROUP_LAST[?] next GUARD_CLOSE_SLOT : GROUP_COUNT[?]
        | GUARD_DEPENDENCE_LAST := GUARD_DEPENDENCE_LAST[?] next GUARD_CLOSE_SLOT : DEPENDENCE_COUNT[?]
        | GUARD_COUNT := GUARD_COUNT[?] + integer(GUARD_SLOT >= 0)
        | GUARD_DEPTH_MAX := if GUARD_SLOT >= 0 and PATH_PARENT_LENGTH + 1 > GUARD_DEPTH_MAX[?] then PATH_PARENT_LENGTH + 1
                             else GUARD_DEPTH_MAX[?]
        | LOOP_SLOT := if GO and (OPENS_LOOP_NAME or INDEX_EQUATION and not INDEX_IS_ARRAY[?] and not SEQ_LEVEL_ADDS) then LOOP_COUNT[?] else -1
        | LOOP_LEVEL_SLOT := if GO and (ADDS_LEVEL_NAME or SEQ_LEVEL_ADDS) then LEVEL_LOOP_SAFE else -1
        | LOOP_RANK := LOOP_RANK[?] next (if LOOP_SLOT >= 0 then LOOP_SLOT else LOOP_LEVEL_SLOT)
                       : (if LOOP_SLOT >= 0 then 1 else LEVEL_RANK_NOW + 1)
        | LOOP_LEVEL_NAME := LOOP_LEVEL_NAME[?] next (if LOOP_SLOT >= 0 then 4 * LOOP_SLOT else if LOOP_LEVEL_SLOT >= 0 then 4 * LOOP_LEVEL_SLOT + LEVEL_RANK_NOW else -1)
                             : INDEX_NAME
        | LOOP_LEVEL_TOKEN := LOOP_LEVEL_TOKEN[?] next (if LOOP_SLOT >= 0 then 4 * LOOP_SLOT else if LOOP_LEVEL_SLOT >= 0 then 4 * LOOP_LEVEL_SLOT + LEVEL_RANK_NOW else -1)
                              : INDEX_TOKEN
        | LOOP_NAME := LOOP_NAME[?] next LOOP_SLOT : INDEX_NAME
        | LOOP_TOKEN := LOOP_TOKEN[?] next LOOP_SLOT : INDEX_TOKEN
        | LOOP_MODEL := LOOP_MODEL[?] next LOOP_SLOT : MODEL_NOW
        | LOOP_COUNT := LOOP_COUNT[?] + integer(LOOP_SLOT >= 0)
        | EQUATION_SLOT := if GO and (APPENDS_EQUATION or INDEX_EQUATION or SEQ_APPENDS or TUPLE_APPENDS) then EQUATION_COUNT[?] else -1
        | SEQ_EQUATION_START := if SEQ_PHASE[?] = 1 then SEQ_EQ_START[?] else STAGE_BASE
        | EQUATION_TARGET := EQUATION_TARGET[?] next EQUATION_SLOT
                             : (if INDEX_EQUATION then INDEX_NAME[?] else if SEQ_APPENDS then SEQ_HIDDEN_KEY[?]
                                else if TUPLE_APPENDS then TUPLE_NAME_ROW[?][TUPLE_SEEK_SLOT[?]] else TARGET[?])
        | EQUATION_ENTRY_START := EQUATION_ENTRY_START[?] next EQUATION_SLOT
                                  : (if INDEX_EQUATION then STAGE_BASE else if SEQ_APPENDS then SEQ_EQUATION_START
                                     else if TUPLE_APPENDS then TUPLE_EQ_START[?] else EXPRESSION_START[?])
        | EQUATION_ENTRY_COUNT := EQUATION_ENTRY_COUNT[?] next EQUATION_SLOT
                                  : (if INDEX_EQUATION then ENTRY_COUNT[?] + 1 - STAGE_BASE else if SEQ_APPENDS then ENTRY_COUNT[?] + 1 - SEQ_EQUATION_START
                                     else if TUPLE_APPENDS then ENTRY_COUNT[?] + 1 - TUPLE_EQ_START[?]
                                     else ENTRY_COUNT[?] - EXPRESSION_START[?])
        | EQUATION_POSITION := EQUATION_POSITION[?] next EQUATION_SLOT
                               : (if INDEX_EQUATION then INDEX_TOKEN[?] else if TUPLE_APPENDS then TUPLE_TOKEN_ROW[?][TUPLE_SEEK_SLOT[?]]
                                  else EQUATION_TOKEN[?])
        | EQUATION_LOOP := EQUATION_LOOP[?] next EQUATION_SLOT
                           : (if INDEX_EQUATION then -1 else if SEQ_APPENDS then (if SEQ_ITERATION[?] then SEQ_LOOP[?] else -1)
                              else if REPEAT_LOOP[?] >= 0 then REPEAT_LOOP[?] else LOOP_NOW[?])
        | EQUATION_SEED := EQUATION_SEED[?] next EQUATION_SLOT
                           : (if SEQ_APPENDS then SEQ_PHASE[?] = 2 else not INDEX_EQUATION and LOOP_SEED[?] and LOOP_NOW[?] >= 0)
        | EQUATION_MODEL := EQUATION_MODEL[?] next EQUATION_SLOT : MODEL_NOW
        | EQUATION_LABELS := EQUATION_LABELS[?] next EQUATION_SLOT : LABEL_NODE[?]
        | EQUATION_GUARDS := EQUATION_GUARDS[?] next EQUATION_SLOT : GUARD_NODE[?]
        | EQUATION_TUPLE_TOKEN := EQUATION_TUPLE_TOKEN[?] next EQUATION_SLOT : (if TUPLE_CALL_ENDS then TUPLE_TOKEN[?] else 0)
        | EQUATION_TUPLE_ARITY := EQUATION_TUPLE_ARITY[?] next EQUATION_SLOT : (if TUPLE_CALL_ENDS then TUPLE_ARITY[?] else 0)
        | EQUATION_TUPLE_START := EQUATION_TUPLE_START[?] next EQUATION_SLOT : TUPLE_BASE[?]
        | EQUATION_STATEMENT := EQUATION_STATEMENT[?] next EQUATION_SLOT
                                : IS_STATEMENT and not INDEX_EQUATION and not SEQ_APPENDS and not TUPLE_APPENDS
        | EQUATION_PARTIAL := EQUATION_PARTIAL[?] next EQUATION_SLOT : (if INDEX_EQUATION or SEQ_APPENDS then 0 else PARTIAL_NOW[?])
        | EQUATION_COUNT := EQUATION_COUNT[?] + integer(EQUATION_SLOT >= 0)
        | MEMBER_SLOT := if GO and APPENDS_MEMBER then MEMBER_COUNT[?] else -1
        | MEMBER_ENTRY_START := MEMBER_ENTRY_START[?] next MEMBER_SLOT : (if IN_SYNC then ENTRY_COUNT[?] else EXPRESSION_START[?])
        | MEMBER_ENTRY_COUNT := MEMBER_ENTRY_COUNT[?] next MEMBER_SLOT
                              : (if IN_SYNC then 1 else ENTRY_COUNT[?] - EXPRESSION_START[?] - integer(CALL_STATEMENT_ENDS))
        | MEMBER_COUNT := MEMBER_COUNT[?] + integer(MEMBER_SLOT >= 0)
        | GROUP_SLOT := if GO and APPENDS_GROUP then GROUP_COUNT[?] else -1
        | GROUP_POSITION := GROUP_POSITION[?] next GROUP_SLOT : (if IN_SYNC then MODEL_TOKEN[?][MODEL_NOW] else EQUATION_TOKEN[?])
        | GROUP_MODEL := GROUP_MODEL[?] next GROUP_SLOT : MODEL_NOW
        | GROUP_GUARDS := GROUP_GUARDS[?] next GROUP_SLOT : GUARD_NODE[?]
        | GROUP_RELATION := GROUP_RELATION[?] next GROUP_SLOT
                            : (if IN_SYNC then C_CLOCK_EQUAL else if CONDITION_ENDS then RELATION_CONDITION else if CALL_STATEMENT_ENDS then
                                (if CALL_STATEMENT_NAME = N_MIN_CLOCK then RELATION_MIN else RELATION_ASSERT)
                               else GROUP_RELATION_NOW[?])
        | GROUP_OPERATOR := GROUP_OPERATOR[?] next GROUP_SLOT
                            : (if IN_SYNC then MODEL_TOKEN[?][MODEL_NOW] else if CONDITION_ENDS then CONDITION_TOKEN[?]
                               else if CALL_STATEMENT_ENDS then ENTRY_TOKEN[?][LAST_ENTRY]
                               else GROUP_OPERATOR_NOW[?])
        | GROUP_ASSUMED := GROUP_ASSUMED[?] next GROUP_SLOT : not IN_SYNC and (ASSERTING or CALL_STATEMENT_ENDS and CALL_STATEMENT_NAME = N_ASSERT)
        | GROUP_MEMBER_FIRST := GROUP_MEMBER_FIRST[?] next GROUP_SLOT : (if STANDALONE_MEMBER then MEMBER_COUNT[?] else GROUP_MEMBER_START[?])
        | GROUP_MEMBER_TOTAL := GROUP_MEMBER_TOTAL[?] next GROUP_SLOT
                                : (if STANDALONE_MEMBER then 1 else MEMBER_COUNT[?] + 1 - GROUP_MEMBER_START[?])
        | GROUP_COUNT := GROUP_COUNT[?] + integer(GROUP_SLOT >= 0)
        | DEPENDENCE_SLOT := if GO and APPENDS_DEPENDENCE then DEPENDENCE_COUNT[?] else -1
        | DEPENDENCE_FROM_NAME := DEPENDENCE_FROM_NAME[?] next DEPENDENCE_SLOT : TOKEN_NAME[EMIT_FROM_TOKEN] - 1
        | DEPENDENCE_FROM_TOKEN := DEPENDENCE_FROM_TOKEN[?] next DEPENDENCE_SLOT : EMIT_FROM_TOKEN
        | DEPENDENCE_TO_NAME := DEPENDENCE_TO_NAME[?] next DEPENDENCE_SLOT : TOKEN_NAME[EMIT_TO_TOKEN] - 1
        | DEPENDENCE_TO_TOKEN := DEPENDENCE_TO_TOKEN[?] next DEPENDENCE_SLOT : EMIT_TO_TOKEN
        | DEPENDENCE_POSITION := DEPENDENCE_POSITION[?] next DEPENDENCE_SLOT : EQUATION_TOKEN[?]
        | DEPENDENCE_MODEL := DEPENDENCE_MODEL[?] next DEPENDENCE_SLOT : MODEL_NOW
        | DEPENDENCE_GUARDS := DEPENDENCE_GUARDS[?] next DEPENDENCE_SLOT : GUARD_NODE[?]
        | DEPENDENCE_CONDITION := DEPENDENCE_CONDITION[?] next DEPENDENCE_SLOT : (if CONDITION_STAGE[?] = 1 then GROUP_COUNT[?] else -1)
        | DEPENDENCE_COUNT := DEPENDENCE_COUNT[?] + integer(DEPENDENCE_SLOT >= 0)
        | HIDE_SLOT := if GO and APPENDS_HIDE then HIDE_COUNT[?] else -1
        | HIDE_NAME := HIDE_NAME[?] next HIDE_SLOT : NAME0
        | HIDE_TOKEN := HIDE_TOKEN[?] next HIDE_SLOT : HERE
        | HIDE_COUNT := HIDE_COUNT[?] + integer(HIDE_SLOT >= 0)
        | HIDE_RANGE_SLOT := if GO and IN_MODEL_AFTER and CODE0 /= C_SLASH then MODEL_NOW else -1
        | MODEL_HIDE_START := MODEL_HIDE_START[?] next HIDE_RANGE_SLOT : BODY_HIDE_START[?]
        | MODEL_HIDE_END := MODEL_HIDE_END[?] next HIDE_RANGE_SLOT : HIDE_COUNT[?]
        | PRAGMA_SLOT := if GO and (IN_PRAGMA_STATEMENT and PRAGMA_KIND = N_INTERRUPT or IN_PRAGMA_CLOSE and PRAGMA_KIND = N_BOOT)
                         then PRAGMA_COUNT[?] else -1
        | MACHINE_TOKEN := if GO and MACHINE_STATEMENT then HERE - 1 else MACHINE_TOKEN[?]
        | PRAGMA_IRQ := PRAGMA_IRQ[?] next PRAGMA_SLOT : (if IN_PRAGMA_STATEMENT then INTERRUPT_VALUE else BOOT_ID)
        | PRAGMA_OBJECT := PRAGMA_OBJECT[?] next PRAGMA_SLOT : PRAGMA_NAME_HELD
        | PRAGMA_TOKEN := PRAGMA_TOKEN[?] next PRAGMA_SLOT : PRAGMA_TOKEN_HELD
        | PRAGMA_COUNT := PRAGMA_COUNT[?] + integer(PRAGMA_SLOT >= 0)
        | PRAGMA_HAS_BOOT := PRAGMA_HAS_BOOT[?] or PRAGMA_SLOT >= 0 and IN_PRAGMA_CLOSE
        | PRAGMA_USED := if PRAGMA_SLOT >= 0 then PRAGMA_USED[?] or INTERRUPT_BIT else PRAGMA_USED[?]
        | FIRST_PARSE_FAILURE := FAILS and STATE_BEFORE /= P_FAILED
        | PARSE_MESSAGE := if FIRST_PARSE_FAILURE then STEP_MESSAGE else PARSE_MESSAGE[?]
        | PARSE_TOKEN := if FIRST_PARSE_FAILURE then STEP_TOKEN else PARSE_TOKEN[?]
        | PARSE_ARGUMENT0 := if FIRST_PARSE_FAILURE then STEP_ARGUMENT0 else PARSE_ARGUMENT0[?]
        | PARSE_ARGUMENT1 := if FIRST_PARSE_FAILURE then STEP_ARGUMENT1 else PARSE_ARGUMENT1[?]
        | PARSE_ARGUMENT2 := if FIRST_PARSE_FAILURE then STEP_ARGUMENT2 else PARSE_ARGUMENT2[?]
        |)
     with (| AT := 0 | PARSE_STATE := P_COPY_TYPES | CURRENT_MODEL := -1 | RETURN_STATE := 0 | ROLE := 0
           | PENDING_MODEL_KIND := 0 | ARRAY_SIZE := ulong(0) | SIZE_DEPTH := 0 | CANDIDATE := -1 | ARRAY_ELEMENT := 0 | ARRAY_BUCKET := 0 | PARSED_TYPE := 0
           | DECLARE_NAME := 0 | DECLARE_TOKEN := 0 | CONSTANT_RETURN := 0 | LIST_FOR_DECLARE := false | CONSTANT_VALUE_HELD := long(0)
           | CONSTANT_VALUE_TYPE := 0 | LIST_COUNT := 0 | LIST_START := 0
           | DL_RANK := 0 | DL_OPERATOR := 0 | DL_ACTIVE := false | DL_READY := false | DL_N1 := 0 | DL_N2 := 0 | DL_N3 := 0 | DL_N4 := 0
           | DL_S1 := 0 | DL_S2 := 0 | DL_S3 := 0 | DL_S4 := 0 | DL_LEAF := -1 | DL_END_AT := 0 | DL_TABLE := 0 | DL_TYPE := 0
           | LOOP_NOW := -1 | LOOP_SEED := false | LOOP_TARGET := false | NEST_LEVEL := false | ANGLE_STEP := 0 | HEAD_NAMES := 0
           | LABEL_NODE := -1 | GUARD_NODE := -1 | GUARD_START_TOKEN := 0 | EXPRESSION_START := 0 | EXPRESSION_RETURN := 0
           | TARGET := -1 | PARTIAL_NOW := 0 | EQUATION_TOKEN := 0 | ALIAS_NAME := 0 | INNER_WHERE := false | PRAGMA_ITEMS := 0
           | ROOT_MODEL := -1 | PRIVATE_PENDING := false | PRIVATE_DECLARATION := false | STATEVAR_PENDING := false | STATEVAR_DECLARATION := false | SHARED_PENDING := false | SHARED_DECLARATION := false | IN_MODULE := false
           | MODULE_COUNT := 0 | IMPORT_COUNT := 0 | TYPE_PENDING := false | INTERFACE_COPY_SOURCE := 0 | INTERFACE_COPY_J := 0
           | FORMAL_MODEL_TYPE := 0 | MODEL_FORMAL_ROWS := 0 | REF_ROWS := 0
           | SET_LEFT_START := 0 | SET_LEFT_COUNT := 0 | SET_RIGHT_START := 0 | SET_RIGHT_COUNT := 0
           | SET_READING_RIGHT := false | SET_ARROWED := false | EMIT_I := 0 | EMIT_J := 0 | HIDE_RETURN := 0 | STAGE_INDEX := 0 | COPY_I := 0 | POWER_ROUND := long(0) | POW_ACCUMULATOR := long(0) | POW_EXPONENT_HELD := long(0) | POW_FOLDS_HELD := false
           | STAGE_BASE := 0 | RECOVER_INDEX_START := 0 | RECOVER_INDEX_END := 0 | RECOVER_ARRAY := 0 | RECOVER_ARRAY_TOKEN := 0
           | RECOVER_READY := false | TUPLE_TOKEN := 0 | TUPLE_ARITY := 0 | TUPLE_INDEX := -1 | TUPLE_CALL := false | TUPLE_AXIS := false
           | TUPLE_COST_MAX := 0
           | CASE_ELSE_BRANCH := false | CASE_BRANCH_ITEMS := 0 | CASE_WALK := -1 | CASE_SCAN_AT := -1 | CASE_LITERAL_TOKEN := 0
           | CASE_VALUE_COUNT := 0 | CASE_DEPTH := 0 | STATE_GUARDED := false | SYNC_I := 0 | SYNC_DONE := false
           | HIDE_COUNT := 0 | BODY_HIDE_START := 0 | DECLARE_INITED := false | GROUP_MEMBER_START := 0 | CALL_HEAD := 0
           | GROUP_RELATION_NOW := 0 | GROUP_OPERATOR_NOW := 0 | ASSERT_FRAME := -1 | SPEC_PENDING := false | CONDITION_STAGE := 0 | CONDITION_TOKEN := 0
           | PARAMETER_START := 0 | PARAMETER_COUNT := 0 | PATH_FROM := 0 | PATH_LEFT := 0 | PATH_APPEND := 0
           | PATH_COUNT := 0 | FRAME_DEPTH := 0 | PENDING_DEPTH := 0 | ENUM_DEPTH := 0 | ENUM_PATH := long(0) | ENUM_CLOSED_AT := -1 | OPENER_TOP := -1 | ENTRY_COUNT := 0 | TEMPLATE_ENTRIES := 0
           | BODY_INTRINSICS := 0 | BODY_STATEMENTS := 0 | STATEMENT_TOTAL := 0 | BODY_EQUATION_START := 0 | BODY_GROUP_START := 0
           | BODY_DEPENDENCE_START := 0 | BODY_GUARD_START := 0 | BODY_USE_START := 0 | BODY_MEMBER_START := 0 | GUARD_DEPTH_MAX := 0
           | TYPE_COUNT := 0 | MODEL_COUNT := 0
           | CLOSED_COUNT := 0 | LOCAL_COUNT := 0 | SIGNAL_COUNT := 0 | LABEL_COUNT := 0 | CONSTANT_COUNT := 0
           | TABLE_COUNT := 0 | POOL_COUNT := 0 | CX_COUNT := 0 | USE_COUNT := 0 | GUARD_COUNT := 0 | LOOP_COUNT := 0 | EQUATION_COUNT := 0
           | MEMBER_COUNT := 0 | GROUP_COUNT := 0 | DEPENDENCE_COUNT := 0 | PARSE_MESSAGE := 0 | PARSE_TOKEN := 0
           | PARSE_ARGUMENT0 := 0 | PARSE_ARGUMENT1 := 0 | PARSE_ARGUMENT2 := 0 | PRAGMA_KIND := 0 | PRAGMA_NAME_HELD := 0
           | PRAGMA_TOKEN_HELD := 0 | PRAGMA_COUNT := 0 | PRAGMA_HAS_BOOT := false | PRAGMA_USED := ulong(0)
           | MACHINE_TOKEN := -1 | INDEX_IS_ARRAY := false | INDEX_NAME := 0 | INDEX_TOKEN := 0 | INDEX_BOUND_AT := 0
           | INDEX_BOUND_END := 0 | REPEAT_E_START := 0 | REPEAT_LOOP := -1 | SEQ_LOOP := -1 | SEQ_J := 0 | SEQ_TARGET := -1 | SEQ_EXPECT := 0
           | SEQ_LEVELS := 0 | SEQ_HIDDEN_KEY := -1 | SEQ_PREVIOUS_KEY := -1 | SEQ_TOTAL := 0 | SEQ_PHASE := 0 | OPERAND_LIST_AT := -1
           | TUPLE_COUNT := 0 | TUPLE_BASE := 0 | TUPLE_ELEMENTS := 0 | TUPLE_DEPTH := 0 | TUPLE_RESUME_AT := 0 | TUPLE_SEEK_SLOT := 0
           | TUPLE_PHASE := 0 | TUPLE_LIST_ON := false | TUPLE_EQ_START := 0
           | SEQ_EQ_START := 0 | SEQ_ITERATION := false | SEQ_LISTED := false | SEQ_ON := false | INDEX_TOTAL := 0 | INDEX_DEPTH := 0 | INDEX_RETURN := 0
           | REPEAT_SEEN := 0 | REPEAT_FIRST_TOKEN := 0 | NONCONST_TOKEN := -1 | PARAMETER_ROWS := 0
           | FORMALS_OPEN := false |)
     end
   | PLATFORM := if MACHINE_TOKEN >= 0 then PLATFORM_MPS2 else if PRAGMA_COUNT > 0 then PLATFORM_VIRT else PLATFORM_MACOS
   | ROOT := if ROOT_MODEL >= 0 then ROOT_MODEL else 0
   | PRAGMA_CHECKS := PARSES and PARSE_MESSAGE = 0 and PARSE_STATE = P_DONE and PLATFORM /= PLATFORM_MACOS
   | INTERRUPT_LOWEST := if PLATFORM = PLATFORM_MPS2 then 15 else 16
   | INTERRUPT_HIGHEST := if PLATFORM = PLATFORM_MPS2 then 47 else 31
   | PC_INDEX := 0 .. (if PRAGMA_CHECKS then (PRAGMA_COUNT + 1) * SIGNAL_COUNT - 1 else -1)
   | iterate PC_INDEX of
       (| PC_PRAGMA := PC_INDEX / SIGNAL_COUNT
        | PC_SIGNAL := PC_INDEX modulo SIGNAL_COUNT
        | PC_NAMING := PC_PRAGMA < PRAGMA_COUNT
        | PC_TOP_INPUT := SIGNAL_MODEL[PC_SIGNAL] = ROOT and SIGNAL_ROLE[PC_SIGNAL] = ROLE_INPUT
        | PC_MATCHES := PC_NAMING and SIGNAL_MODEL[PC_SIGNAL] = ROOT and SIGNAL_NAME[PC_SIGNAL] = PRAGMA_OBJECT[PC_PRAGMA]
        | PC_FOUND := PC_MATCHES or PC_SIGNAL > 0 and PC_FOUND[?]
        | PC_IRQ := PRAGMA_IRQ[if PC_NAMING then PC_PRAGMA else 0]
        | PC_OUT_OF_RANGE := PC_NAMING and PC_SIGNAL = 0 and PC_IRQ /= BOOT_ID
                             and (PC_IRQ < INTERRUPT_LOWEST or PC_IRQ > INTERRUPT_HIGHEST)
        | PC_STEP_MESSAGE := if PC_OUT_OF_RANGE then
                               (if PLATFORM = PLATFORM_MPS2 then T_INTERRUPT_NUMBER_MPS2 else T_INTERRUPT_NUMBER)
                             else if PC_MATCHES then
                               (if SIGNAL_ROLE[PC_SIGNAL] /= ROLE_INPUT then T_PRAGMA_INPUT
                                else if SIGNAL_TYPE[PC_SIGNAL] /= BUILTIN_EVENT then T_PRAGMA_EVENT
                                else if SIGNAL_IRQ1[?][PC_SIGNAL] > 0 then T_PRAGMA_TWICE else 0)
                             else if PC_NAMING and PC_SIGNAL = SIGNAL_COUNT - 1 and not PC_FOUND then T_PRAGMA_INPUT
                             else if not PC_NAMING and PC_TOP_INPUT and SIGNAL_IRQ1[?][PC_SIGNAL] = 0 then T_INPUT_UNNAMED
                             else if not PC_NAMING and PC_SIGNAL = SIGNAL_COUNT - 1 and PRAGMA_COUNT > 0 and not PRAGMA_HAS_BOOT
                             then T_BOOT_MISSING
                             else 0
        | SIGNAL_IRQ1 := SIGNAL_IRQ1[?] next (if PC_MATCHES and PC_STEP_MESSAGE = 0 then PC_SIGNAL else -1) : PRAGMA_IRQ[PC_PRAGMA] + 1
        | PC_FIRST := PC_STEP_MESSAGE /= 0 and PRAGMA_MESSAGE[?] = 0
        | PRAGMA_MESSAGE := if PC_FIRST then PC_STEP_MESSAGE else PRAGMA_MESSAGE[?]
        | PRAGMA_MESSAGE_TOKEN := if not PC_FIRST then PRAGMA_MESSAGE_TOKEN[?] else if PC_OUT_OF_RANGE then PRAGMA_TOKEN[PC_PRAGMA] + 2
                                  else if PC_NAMING then PRAGMA_TOKEN[PC_PRAGMA]
                                  else if PC_STEP_MESSAGE = T_BOOT_MISSING then PRAGMA_TOKEN[0] - 2 else SIGNAL_TOKEN[PC_SIGNAL]
        | PRAGMA_ARGUMENT0 := if not PC_FIRST then PRAGMA_ARGUMENT0[?] else if PC_OUT_OF_RANGE then PRAGMA_TOKEN[PC_PRAGMA] + 2
                              else if PC_NAMING then PRAGMA_OBJECT[PC_PRAGMA]
                              else SIGNAL_NAME[PC_SIGNAL]
        |)
     with (| PC_FOUND := false | PRAGMA_MESSAGE := 0 | PRAGMA_MESSAGE_TOKEN := 0 | PRAGMA_ARGUMENT0 := 0 |)
     end
   | PRAGMA_FAILED := PRAGMA_CHECKS and PRAGMA_MESSAGE /= 0
   | REAL_MPS2 := PARSES and PARSE_MESSAGE = 0 and PARSE_STATE = P_DONE and PLATFORM = PLATFORM_MPS2 and FIRST_REAL_TOKEN >= 0
   | VIS_CHECKS := PARSES and PARSE_MESSAGE = 0 and PARSE_STATE = P_DONE and MODULE_COUNT > 0
   | VIS_WIDTH := IMPORT_COUNT + 1
   | VIS_INDEX := 0 .. (if VIS_CHECKS then TOKEN_COUNT * VIS_WIDTH - 1 else -1)
   | iterate VIS_INDEX of
       (| VIS_T := VIS_INDEX / VIS_WIDTH
        | VIS_I := VIS_INDEX modulo VIS_WIDTH
        | VIS_SCANNING := VIS_I < IMPORT_COUNT
        | VIS_IMPORT := if VIS_SCANNING then VIS_I else 0
        | VIS_IMPORT_MODULE := NAME_MODULE[IMPORT_NAME[VIS_IMPORT]] - 1
        | VIS_IMPORT_UNDECLARED := VIS_SCANNING and VIS_T = 0 and VIS_IMPORT_MODULE < 0
        | VIS_KEY := TOKEN_NAME[VIS_T] - 1
        | VIS_PREVIOUS_CODE := if VIS_T > 0 then integer(TOKEN_CODE[VIS_T - 1]) else 0
        | VIS_ENUM_LIST := if VIS_PREVIOUS_CODE = C_OPEN and integer(TOKEN_CODE[if VIS_T > 1 then VIS_T - 2 else 0]) = C_ENUM then true
                           else if integer(TOKEN_CODE[VIS_T]) = C_CLOSE then false else VIS_ENUM_LIST[?]
        | VIS_ENUM_VALUE := VIS_ENUM_LIST or VIS_PREVIOUS_CODE = C_HASH
        | VIS_KEY_SAFE := if VIS_KEY >= 0 then VIS_KEY else 0
        | VIS_NAMED := VIS_KEY >= 0 and not VIS_ENUM_VALUE and (NAME_MODEL[VIS_KEY_SAFE] or NAME_TYPE[VIS_KEY_SAFE] > 0 or NAME_ALIAS[VIS_KEY_SAFE] > 0
                                         or NAME_CONSTANT[VIS_KEY_SAFE] > 0)
        | VIS_VALUE := if VIS_NAMED then NAME_VISIBILITY[VIS_KEY_SAFE] else 0
        | VIS_HOME := VIS_VALUE / 2 - 1
        | VIS_HOME_SAFE := if VIS_HOME >= 0 then VIS_HOME else 0
        | VIS_INSIDE_HOME := VIS_T >= MODULE_TOKEN[VIS_HOME_SAFE] and VIS_T <= MODULE_END_TOKEN[VIS_HOME_SAFE]
        | VIS_GUARDED := VIS_HOME >= 0 and not VIS_INSIDE_HOME
        | VIS_OWNER_MODEL := IMPORT_MODEL[VIS_IMPORT]
        | VIS_OWNER_MODULE := IMPORT_OWNER_MODULE[VIS_IMPORT]
        | VIS_OWNER_FROM := if VIS_OWNER_MODEL >= 0 then MODEL_TOKEN[VIS_OWNER_MODEL]
                            else MODULE_TOKEN[if VIS_OWNER_MODULE >= 0 then VIS_OWNER_MODULE else 0]
        | VIS_OWNER_TO := if VIS_OWNER_MODEL >= 0 then MODEL_END_TOKEN[VIS_OWNER_MODEL]
                          else MODULE_END_TOKEN[if VIS_OWNER_MODULE >= 0 then VIS_OWNER_MODULE else 0]
        | VIS_IMPORT_HITS := VIS_SCANNING and VIS_IMPORT_MODULE = VIS_HOME and VIS_T >= VIS_OWNER_FROM and VIS_T <= VIS_OWNER_TO
        | VIS_IMPORTED := VIS_IMPORT_HITS or VIS_I > 0 and VIS_IMPORTED[?]
        | VIS_STEP_MESSAGE := if VIS_IMPORT_UNDECLARED then T_MODULE_UNDECLARED
                              else if not VIS_SCANNING and VIS_GUARDED then
                                (if VIS_VALUE modulo 2 = 1 then T_PRIVATE_NAME else if not VIS_IMPORTED[?] then T_NOT_IMPORTED else 0)
                              else 0
        | VIS_FIRST := VIS_STEP_MESSAGE /= 0 and VIS_MESSAGE[?] = 0
        | VIS_MESSAGE := if VIS_FIRST then VIS_STEP_MESSAGE else VIS_MESSAGE[?]
        | VIS_MESSAGE_TOKEN := if not VIS_FIRST then VIS_MESSAGE_TOKEN[?] else if VIS_IMPORT_UNDECLARED then IMPORT_TOKEN[VIS_IMPORT] else VIS_T
        | VIS_ARGUMENT0 := if not VIS_FIRST then VIS_ARGUMENT0[?] else if VIS_IMPORT_UNDECLARED then IMPORT_NAME[VIS_IMPORT] else VIS_KEY
        | VIS_ARGUMENT1 := if VIS_FIRST then MODULE_NAME[VIS_HOME_SAFE] else VIS_ARGUMENT1[?]
        |)
     with (| VIS_IMPORTED := false | VIS_ENUM_LIST := false | VIS_MESSAGE := 0 | VIS_MESSAGE_TOKEN := 0 | VIS_ARGUMENT0 := 0 | VIS_ARGUMENT1 := 0 |)
     end
   | VIS_FAILED := VIS_CHECKS and VIS_MESSAGE /= 0
   | FINISH_BOUND := long(64) + long(24) * long(MODEL_COUNT) + long(LABEL_COUNT) + long(2) * long(USE_COUNT)
                     + long(4) * long(SIGNAL_COUNT) + long(16) * long(EQUATION_COUNT) + long(2) * long(MEMBER_COUNT)
                     + long(16) * long(GUARD_COUNT) + long(GUARD_COUNT) * long(GROUP_COUNT) + long(6) * long(ENTRY_COUNT) + long(2) * long(DEPENDENCE_COUNT)
                     + long(HIDE_COUNT) + long(SIGNAL_COUNT) + long(2) * long(MODEL_COUNT)
                     + long(64) * long(TEMPLATE_ENTRIES) + (if TEMPLATE_ENTRIES > 0 then long(4) * long(ENTRY_COUNT) else long(0))
                     + long(4) * long(ENTRY_COUNT) + long(LABEL_COUNT) * long(USE_COUNT + 2)
                     + long(USE_COUNT) * (long(8) * long(EQUATION_COUNT) + long(4) * long(ENTRY_COUNT) + long(64) * long(TEMPLATE_ENTRIES))
                     + long(STATEMENT_TOTAL + 1) * long(STATEMENT_TOTAL + 1) + long(2) * long(ENTRY_COUNT)
                     + long(GUARD_DEPTH_MAX + 1) * (long(4) * long(ENTRY_COUNT) + long(4) * long(EQUATION_COUNT)
                                                   + long(2) * long(MEMBER_COUNT) + long(2) * long(DEPENDENCE_COUNT)
                                                   + long(8) * long(GUARD_COUNT) * long(SIGNAL_COUNT + 4))
   | FINISH_INDEX := 0 .. (if PARSES and CLOSED_COUNT > 0 then FINISH_BOUND else long(-1))
   | iterate FINISH_INDEX of
       (| PHASE := FINISH_PHASE[?]
        | CLOSE_RANK := FINISH_MODEL_ORDINAL[?]
        | MODEL_HERE := CLOSE_ORDER[CLOSE_RANK]
        | MODEL_STAMP := CLOSE_RANK + 1
        | WORK_ROW := FINISH_ROW[?]
        | STEP := FINISH_SUB[?]
        | AUTOMATON_NOW := MODEL_KIND[MODEL_HERE] = C_AUTOMATON
        | STATE_TYPE_NOW := MODEL_STATE_TYPE[MODEL_HERE]
        | MODEL_AT := MODEL_TOKEN[MODEL_HERE]
        | MODEL_KEY := MODEL_NAME[MODEL_HERE]
        | GUARD_NOW := MODEL_GUARD_START[MODEL_HERE] + GUARD_NUMBER[?] - 1
        | GUARD_SUFFIX := GUARD_NUMBER[?] * NAME_CAP
        | GUARD_AT := GUARD_TOKEN[GUARD_NOW]
        | AT_START := PHASE = PHASE_START
        | AT_LABEL := PHASE = PHASE_LABEL
        | AT_USE := PHASE = PHASE_USE
        | AT_SIGNAL := PHASE = PHASE_SIGNAL
        | AT_HIDE := PHASE = PHASE_HIDE
        | AT_INITS := PHASE = PHASE_INITS
        | AT_STATEMENT := PHASE = PHASE_STATEMENT
        | AT_REWRITE := PHASE >= PHASE_REWRITE_EQ and PHASE <= PHASE_REWRITE_TRIGGER
        | AT_CLOCK := PHASE = PHASE_CLOCK
        | AT_STATE := PHASE = PHASE_STATE
        | AT_CUR := PHASE = PHASE_CUR
        | AT_PICK := PHASE = PHASE_PICK
        | AT_CUR_TAIL := PHASE = PHASE_CUR_TAIL
        | AT_GROUP := PHASE = PHASE_GROUP
        | AT_TICK := PHASE = PHASE_TICK
        | AT_GUARD_START := PHASE = PHASE_GUARD_START
        | AT_DEFINE_PARSE := PHASE = PHASE_DEFINE_PARSE
        | AT_DEFINE_FINISH := PHASE = PHASE_DEFINE_FINISH
        | AT_DEFINE_GROUP := PHASE = PHASE_DEFINE_GROUP
        | AT_READ := PHASE >= PHASE_READ_PARSE and PHASE <= PHASE_READ_MEMBERS
        | AT_READ_DEPS := PHASE = PHASE_READ_DEPS
        | AT_ON := PHASE = PHASE_ON
        | AT_FILTER := PHASE = PHASE_FILTER
        | ALL_CLOSED := CLOSE_RANK >= CLOSED_COUNT
        | LABELS_DONE := WORK_ROW < 0
        | USES_DONE := WORK_ROW >= MODEL_USE_END[MODEL_HERE]
        | USE_UNDECLARED := LABEL_STAMP[?][USE_NAME[WORK_ROW]] /= MODEL_STAMP
        | SIGNALS_DONE := WORK_ROW < 0
        | INITS_DONE := WORK_ROW < 0
        | INIT_UNUSED_HERE := not INITS_DONE and SIGNAL_INIT_KIND[WORK_ROW] /= INIT_NONE
                              and not SIGNAL_STATEVAR[if WORK_ROW >= 0 then WORK_ROW else 0]
                              and not SIGNAL_SHARED[if WORK_ROW >= 0 then WORK_ROW else 0]
                              and INIT_USED[?][SIGNAL_NAME[WORK_ROW]] /= MODEL_STAMP
        | HIDES_DONE := WORK_ROW >= MODEL_HIDE_END[MODEL_HERE]
        | HIDE_KEY := HIDE_NAME[WORK_ROW]
        | HIDE_ROLE := OWN_ROLE[?][HIDE_KEY]
        | HIDE_FINISH_MESSAGE := if HIDES_DONE then 0 else if OWN_STAMP[?][HIDE_KEY] /= MODEL_STAMP then T_SIGNAL_UNDECLARED
                                 else if HIDE_ROLE /= ROLE_LOCAL then T_HIDES_OUTPUT else 0
        | STATEMENTS_DONE := WORK_ROW >= MODEL_EQUATION_END[MODEL_HERE]
        | ST_START := EQUATION_ENTRY_START[WORK_ROW]
        | ST_COUNT := EQUATION_ENTRY_COUNT[WORK_ROW]
        | ST_CALL := ST_START + ST_COUNT - 1
        | ST_NAME := ENTRY_NAME[ST_CALL]
        | ST_ARGUMENTS := integer(ENTRY_VALUE[ST_CALL])
        | ST_TOKEN := ENTRY_TOKEN[ST_CALL]
        | ST_INITIAL := ST_NAME = N_INITIAL
        | ST_TRANSITION := ST_NAME = N_TRANSITION
        | ST_SET_CLOCK := ST_NAME = N_SET_CLOCK
        | ST_NAMES_STATE := ST_INITIAL or ST_TRANSITION
        | ST_EXPECTED := if not ST_TRANSITION then 1 else if ST_ARGUMENTS = 4 then 4 else 3
        | ST_LAST_ARGUMENT := if ST_CALL > 0 then ST_CALL - 1 else 0
        | ST_PRIORITY_NEGATED := ST_ARGUMENTS = 4 and ST_CALL > 1 and ENTRY_OP[ST_LAST_ARGUMENT] = OP_NEG
        | ST_PRIORITY_LEAF := if ST_PRIORITY_NEGATED then ST_CALL - 2 else ST_LAST_ARGUMENT
        | ST_PRIORITY_OP := ENTRY_OP[ST_PRIORITY_LEAF]
        | ST_PRIORITY_NAME := ENTRY_NAME[ST_PRIORITY_LEAF]
        | ST_PRIORITY_CONSTANT := if ST_PRIORITY_OP = OP_SIGNAL and ST_PRIORITY_NAME >= 0 then NAME_CONSTANT[ST_PRIORITY_NAME] - 1 else -1
        | ST_PRIORITY_TYPE := if ST_PRIORITY_OP = OP_CONST then ENTRY_TYPE[ST_PRIORITY_LEAF]
                              else if ST_PRIORITY_CONSTANT >= 0 then CONSTANT_TYPE[ST_PRIORITY_CONSTANT] else -1
        | ST_PRIORITY_MAGNITUDE := if ST_PRIORITY_OP = OP_CONST then ENTRY_VALUE[ST_PRIORITY_LEAF]
                                   else if ST_PRIORITY_CONSTANT >= 0 then CONSTANT_VALUE[ST_PRIORITY_CONSTANT] else long(0)
        | ST_PRIORITY := if ST_ARGUMENTS < 4 then long(0) else if ST_PRIORITY_NEGATED then -ST_PRIORITY_MAGNITUDE else ST_PRIORITY_MAGNITUDE
        | ST_PRIORITY_OK := ST_PRIORITY_TYPE >= 0 and TYPE_KIND[if ST_PRIORITY_TYPE >= 0 then ST_PRIORITY_TYPE else 0] = TK_INT
        | ST_PRIORITY_LENGTH := if ST_ARGUMENTS < 4 then 0 else if ST_PRIORITY_NEGATED then 2 else 1
        | ST_SHAPE_OK := ENTRY_OP[ST_START] = OP_SIGNAL
                         and (if ST_INITIAL then ST_COUNT = 2
                              else ENTRY_SPLIT[ST_CALL] = ST_START + 2 and ENTRY_OP[ST_START + 1] = OP_SIGNAL)
        | ST_STATE := ENTRY_NAME[ST_START + STEP]
        | ST_STATE_TOKEN := ENTRY_TOKEN[ST_START + STEP]
        | ST_KNOWN := STATE_STAMP[?][ST_STATE] = MODEL_STAMP
        | ST_ORDINAL := if ST_KNOWN then STATE_ORDINAL[?][ST_STATE] else STATE_COUNT[?]
        | ST_IS_STATEMENT := not STATEMENTS_DONE and EQUATION_STATEMENT[WORK_ROW]
        | AUTOMATON_STATEMENT_MESSAGE := if not ST_IS_STATEMENT then 0
                               else if STEP = 0 and ST_ARGUMENTS /= ST_EXPECTED then T_WRONG_ARGUMENTS
                               else if STEP = 0 and EQUATION_LABELS[WORK_ROW] >= 0 then T_LABEL_PLACED
                               else if STEP = 0 and (ST_INITIAL or ST_SET_CLOCK) and EQUATION_GUARDS[WORK_ROW] >= 0 then T_CANNOT_GUARD
                               else if STEP = 0 and ST_NAMES_STATE and not ST_SHAPE_OK then T_EXPECTS_STATE
                               else if ST_NAMES_STATE and LABEL_STAMP[?][ST_STATE] /= MODEL_STAMP then T_NOT_LABEL_OF
                               else if STEP = 0 and ST_INITIAL and HAS_INITIAL[?] then T_ONE_INITIAL
                               else if STEP = 0 and ST_SET_CLOCK and HAS_SETCLOCK[?] then T_ONE_SETCLOCK
                               else if STEP = 0 and ST_TRANSITION and ST_ARGUMENTS = 4 and not ST_PRIORITY_OK then T_PRIORITY_CONSTANT
                               else 0
        | REGISTERS_STATE := AT_STATEMENT and ST_IS_STATEMENT and AUTOMATON_STATEMENT_MESSAGE = 0 and ST_NAMES_STATE and not ST_KNOWN
        | RECORDS_SETCLOCK := AT_STATEMENT and ST_IS_STATEMENT and AUTOMATON_STATEMENT_MESSAGE = 0 and ST_SET_CLOCK
        | RECORDS_INITIAL := AT_STATEMENT and ST_IS_STATEMENT and AUTOMATON_STATEMENT_MESSAGE = 0 and ST_INITIAL
        | RECORDS_TRANSITION := AT_STATEMENT and ST_IS_STATEMENT and AUTOMATON_STATEMENT_MESSAGE = 0 and STEP = 1
        | RW_HEADER := AT_REWRITE and STEP < 0
        | RW_ITEMS_END := if PHASE = PHASE_REWRITE_EQ then MODEL_EQUATION_END[MODEL_HERE] else if PHASE = PHASE_REWRITE_MEMBER then MODEL_MEMBER_END[MODEL_HERE]
                          else if PHASE = PHASE_REWRITE_GUARD then MODEL_GUARD_END[MODEL_HERE] else TRANSITION_COUNT[?]
        | RW_PHASE_DONE := RW_HEADER and WORK_ROW >= RW_ITEMS_END
        | TRIGGER_GUARDED := TRANSITION_GUARD[?][WORK_ROW] > 0
        | RW_ITEM_START := if PHASE = PHASE_REWRITE_EQ then EQUATION_ENTRY_START[WORK_ROW] else if PHASE = PHASE_REWRITE_MEMBER then MEMBER_ENTRY_START[WORK_ROW]
                           else if PHASE = PHASE_REWRITE_GUARD then GUARD_ENTRY_START[WORK_ROW] else TRANSITION_TRIGGER_START[?][WORK_ROW]
        | RW_ITEM_COUNT := if PHASE = PHASE_REWRITE_EQ then (if AUTOMATON_NOW and EQUATION_STATEMENT[WORK_ROW] then
                                                                  (if HAS_SETCLOCK[?] and WORK_ROW = SETCLOCK_ROW[?] then EQUATION_ENTRY_COUNT[WORK_ROW] - 1 else 0)
                                                                else EQUATION_ENTRY_COUNT[WORK_ROW])
                           else if PHASE = PHASE_REWRITE_MEMBER then MEMBER_ENTRY_COUNT[WORK_ROW]
                           else if PHASE = PHASE_REWRITE_GUARD then GUARD_ENTRY_COUNT[WORK_ROW]
                           else TRANSITION_TRIGGER_END[?][WORK_ROW] - TRANSITION_TRIGGER_START[?][WORK_ROW] + 2 * integer(TRIGGER_GUARDED)
        | RW_REAL_END := if PHASE = PHASE_REWRITE_TRIGGER then TRANSITION_TRIGGER_END[?][WORK_ROW] else RW_LAST[?]
        | REST := TEMPLATE_PC[?] >= 0
        | REST_ROW := if REST then TEMPLATE_PC[?] else 0
        | REST_KIND := if REST then TEMPLATE_ROW_KIND[REST_ROW] else -1
        | REST_COPY := REST_KIND = TPK_LEFT or REST_KIND = TPK_RIGHT
        | TR_INIT_ROW := REST_KIND = TPK_EMIT and (TEMPLATE_ROW_REF[REST_ROW] = TPV_INIT or TEMPLATE_ROW_REF[REST_ROW] = TPV_INIT_DECL)
        | TEMPLATE_AT_HELD := TEMPLATE_AT[?]
        | RW_ENTRY := if TR_INIT_ROW then TEMPLATE_AT_HELD else RW_AT[?]
        | ITEM_LAST_ENTRY := RW_ITEM_START + RW_ITEM_COUNT - 1
        | WHOLE_HERE := RW_HEADER and PHASE = PHASE_REWRITE_EQ and not RW_PHASE_DONE and RW_ITEM_COUNT > 0
                        and OP_TEMPLATE_KIND[ENTRY_OP[ITEM_LAST_ENTRY]] = 1
                        and (EQUATION_TARGET[WORK_ROW] >= 0 or ENTRY_OP[ITEM_LAST_ENTRY] = OP_AFFINE_RELATION)
        | SKIPPED := AT_REWRITE and STEP >= 0 and not REST and not RW_IS_EXTENSION
                     and (TEMPLATE_AT_HELD >= 0 and RW_ENTRY >= SKIP_FROM[?] and RW_ENTRY < TEMPLATE_AT_HELD
                          or RW_ENTRY + 1 < RW_LAST[?] and ENTRY_OP[RW_ENTRY + 1] = OP_VAR)
        | TR_OP_KIND := if RW_IS_EXTENSION or RW_HEADER then 0 else OP_TEMPLATE_KIND[RW_OP]
        | AT_CONSTRUCT := AT_REWRITE and STEP >= 0 and not REST and not SKIPPED and TR_OP_KIND > 0
        | RW_LIVE := AT_REWRITE and STEP >= 0 and not SKIPPED and not AT_CONSTRUCT and (not REST or REST_COPY)
        | CONSTRUCT := if REST then TEMPLATE_AT_HELD else RW_ENTRY
        | CONSTRUCT_SPLIT := ENTRY_SPLIT[CONSTRUCT]
        | CONSTRUCT_TOKEN := ENTRY_TOKEN[CONSTRUCT]
        | OPERAND_NAME := ENTRY_NAME[CONSTRUCT - 1]
        | BOUND_OP := ENTRY_OP[CONSTRUCT_SPLIT]
        | BOUND_CONSTANT := if BOUND_OP = OP_SIGNAL then NAME_CONSTANT[ENTRY_NAME[CONSTRUCT_SPLIT]] - 1 else -1
        | BOUND_TYPE := if BOUND_OP = OP_CONST then ENTRY_TYPE[CONSTRUCT_SPLIT]
                        else if BOUND_CONSTANT >= 0 then CONSTANT_TYPE[BOUND_CONSTANT] else -1
        | BOUND_VALUE := if BOUND_OP = OP_CONST then ENTRY_VALUE[CONSTRUCT_SPLIT]
                         else if BOUND_CONSTANT >= 0 then CONSTANT_VALUE[BOUND_CONSTANT] else long(0)
        | BOUND_OK := CONSTRUCT - CONSTRUCT_SPLIT = 1 and BOUND_TYPE >= 0
                      and TYPE_KIND[if BOUND_TYPE >= 0 then BOUND_TYPE else 0] = TK_INT and BOUND_VALUE >= long(1)
        | GUARDED_ITEM := EQUATION_GUARDS[WORK_ROW] >= 0 or EQUATION_LABELS[WORK_ROW] >= 0
        | AFFINE_OP := ENTRY_OP[CONSTRUCT]
        | AFFINE_SAMPLE := AFFINE_OP = OP_AFFINE_SAMPLE
        | AFFINE_RELATION := AFFINE_OP = OP_AFFINE_RELATION
        | AFFINE_HERE := AFFINE_SAMPLE or AFFINE_RELATION or AFFINE_OP = OP_AFFINE_UNSAMPLE
        | AFFINE_AT0 := if ENTRY_AUX[CONSTRUCT] >= 0 then ENTRY_AUX[CONSTRUCT] else 0
        | AFFINE_MINUS0 := integer(integer(TOKEN_CODE[AFFINE_AT0]) = C_MINUS)
        | AFFINE_NAMED0 := AFFINE_MINUS0 = 0 and integer(TOKEN_CODE[AFFINE_AT0]) = C_NAME
        | AFFINE_CONSTANT0 := if AFFINE_NAMED0 and TOKEN_NAME[AFFINE_AT0] > 0 then NAME_CONSTANT[TOKEN_NAME[AFFINE_AT0] - 1] - 1 else -1
        | AFFINE_INTEGER0 := integer(TOKEN_CODE[AFFINE_AT0 + AFFINE_MINUS0]) = C_NUMBER
                             or AFFINE_CONSTANT0 >= 0
                                and TYPE_KIND[CONSTANT_TYPE[if AFFINE_CONSTANT0 >= 0 then AFFINE_CONSTANT0 else 0]] = TK_INT
        | AFFINE_VALUE0 := if AFFINE_CONSTANT0 >= 0 then CONSTANT_VALUE[AFFINE_CONSTANT0]
                           else if AFFINE_MINUS0 = 1 then -TOKEN_VALUE[AFFINE_AT0 + 1] else TOKEN_VALUE[AFFINE_AT0]
        | AFFINE_AT1 := AFFINE_AT0 + 2 + AFFINE_MINUS0
        | AFFINE_MINUS1 := integer(integer(TOKEN_CODE[AFFINE_AT1]) = C_MINUS)
        | AFFINE_NAMED1 := AFFINE_MINUS1 = 0 and integer(TOKEN_CODE[AFFINE_AT1]) = C_NAME
        | AFFINE_CONSTANT1 := if AFFINE_NAMED1 and TOKEN_NAME[AFFINE_AT1] > 0 then NAME_CONSTANT[TOKEN_NAME[AFFINE_AT1] - 1] - 1 else -1
        | AFFINE_INTEGER1 := integer(TOKEN_CODE[AFFINE_AT1 + AFFINE_MINUS1]) = C_NUMBER
                             or AFFINE_CONSTANT1 >= 0
                                and TYPE_KIND[CONSTANT_TYPE[if AFFINE_CONSTANT1 >= 0 then AFFINE_CONSTANT1 else 0]] = TK_INT
        | AFFINE_VALUE1 := if AFFINE_CONSTANT1 >= 0 then CONSTANT_VALUE[AFFINE_CONSTANT1]
                           else if AFFINE_MINUS1 = 1 then -TOKEN_VALUE[AFFINE_AT1 + 1] else TOKEN_VALUE[AFFINE_AT1]
        | AFFINE_AT2 := AFFINE_AT1 + 2 + AFFINE_MINUS1
        | AFFINE_MINUS2 := integer(integer(TOKEN_CODE[AFFINE_AT2]) = C_MINUS)
        | AFFINE_NAMED2 := AFFINE_MINUS2 = 0 and integer(TOKEN_CODE[AFFINE_AT2]) = C_NAME
        | AFFINE_CONSTANT2 := if AFFINE_NAMED2 and TOKEN_NAME[AFFINE_AT2] > 0 then NAME_CONSTANT[TOKEN_NAME[AFFINE_AT2] - 1] - 1 else -1
        | AFFINE_INTEGER2 := integer(TOKEN_CODE[AFFINE_AT2 + AFFINE_MINUS2]) = C_NUMBER
                             or AFFINE_CONSTANT2 >= 0
                                and TYPE_KIND[CONSTANT_TYPE[if AFFINE_CONSTANT2 >= 0 then AFFINE_CONSTANT2 else 0]] = TK_INT
        | AFFINE_VALUE2 := if AFFINE_CONSTANT2 >= 0 then CONSTANT_VALUE[AFFINE_CONSTANT2]
                           else if AFFINE_MINUS2 = 1 then -TOKEN_VALUE[AFFINE_AT2 + 1] else TOKEN_VALUE[AFFINE_AT2]
        | AFFINE_PARAMETERS := if AFFINE_RELATION then 3 else 2
        | AFFINE_OPERANDS := if AFFINE_SAMPLE then 1 else 2
        | AFFINE_NUMBERS := ENTRY_AUX[CONSTRUCT] >= 0 and ENTRY_AUX2[CONSTRUCT] = AFFINE_PARAMETERS
                            and AFFINE_INTEGER0 and AFFINE_INTEGER1 and (not AFFINE_RELATION or AFFINE_INTEGER2)
        | AFFINE_SHAPE := CONSTRUCT - RW_ITEM_START = AFFINE_OPERANDS and ENTRY_OP[CONSTRUCT - 1] = OP_SIGNAL
                          and (AFFINE_SAMPLE or ENTRY_OP[CONSTRUCT - 2] = OP_SIGNAL)
                          and (EQUATION_TARGET[WORK_ROW] < 0) = AFFINE_RELATION
        | AFFINE_PERIOD_A := if AFFINE_SAMPLE then AFFINE_VALUE1 else AFFINE_VALUE0
        | AFFINE_PERIOD_B := if AFFINE_RELATION then AFFINE_VALUE2 else long(1)
        | AFFINE_MESSAGE := if MODEL_HERE /= ROOT then T_AFFINE_TOP
                            else if not AFFINE_NUMBERS or not AFFINE_SHAPE then T_AFFINE_FORM
                            else if AFFINE_SAMPLE and AFFINE_VALUE0 < long(0) then T_AFFINE_PHASE
                            else if AFFINE_PERIOD_A < long(1) or AFFINE_PERIOD_B < long(1) then T_AFFINE_PERIOD else 0
        | AFFINE_PHASE_A := if AFFINE_SAMPLE then AFFINE_VALUE0 else if AFFINE_VALUE1 < long(0) then -AFFINE_VALUE1 else long(0)
        | AFFINE_PHASE_B := if AFFINE_VALUE1 > long(0) then AFFINE_VALUE1 else long(0)
        | CONSTRUCT_MESSAGE := if TR_OP_KIND = 0 or STEP /= 0 or not (AT_CONSTRUCT or RW_LIVE) then 0
                               else if TR_OP_KIND = 1 then
                                 (if REST or RW_ENTRY /= TEMPLATE_AT_HELD then T_WHOLE_DEFINITION
                                  else if GUARDED_ITEM then T_TEMPLATE_GUARDED
                                  else if RW_OP = OP_COUNT and not BOUND_OK then T_CONSTANT_BOUND
                                  else if AFFINE_HERE then AFFINE_MESSAGE else 0)
                               else if REST or PHASE /= PHASE_REWRITE_EQ or RW_TARGET < 0 or TEMPLATE_AT_HELD >= 0 then T_VAR_CONTEXT
                               else if GUARDED_ITEM then T_TEMPLATE_GUARDED
                               else if OWN_STAMP[?][OPERAND_NAME] /= MODEL_STAMP then T_SIGNAL_UNDECLARED else 0
        | NONMONO_HERE := RW_LIVE and not REST and STEP = 0 and OP_ARITY[RW_OP] > 0 and OP_MONOCHRONOUS[RW_OP] = 0
        | ITEM_NONMONO := if RW_HEADER then false else ITEM_NONMONO[?] or NONMONO_HERE
        | TEMPLATE_NOW := if RW_HEADER then (if WHOLE_HERE then ITEM_LAST_ENTRY else -1)
                          else if AT_CONSTRUCT and TR_OP_KIND = 2 then RW_ENTRY else TEMPLATE_AT_HELD
        | TEMPLATE_SAFE := if TEMPLATE_NOW >= 0 then TEMPLATE_NOW else 0
        | REST_DUE := AT_REWRITE and STEP >= 0 and not REST and RW_ITEM_DONE and TEMPLATE_NOW >= 0
        | VAR_MONO_MESSAGE := if REST_DUE and ENTRY_OP[TEMPLATE_SAFE] = OP_VAR and ITEM_NONMONO then T_VAR_CONTEXT else 0
        | TEMPLATE_MESSAGE := if CONSTRUCT_MESSAGE /= 0 then CONSTRUCT_MESSAGE else VAR_MONO_MESSAGE
        | ENTERS_REST := REST_DUE and GOES
        | REST_ROW_DONE := not REST_COPY or RW_ENTRY_DONE and RW_ENTRY + 1 >= RW_LAST[?]
        | REST_ENDS := REST_KIND = TPK_END
        | NEXT_TEMPLATE_PC := if ENTERS_REST then OP_TEMPLATE_REST_START[ENTRY_OP[TEMPLATE_SAFE]]
                              else if REST and not REST_ENDS then REST_ROW + integer(REST_ROW_DONE) else -1
        | TEMPLATE_PC := NEXT_TEMPLATE_PC
        | TEMPLATE_AT := if REST_ENDS then -1 else TEMPLATE_NOW
        | SKIP_FROM := if WHOLE_HERE then
                         (if OP_TEMPLATE_SKIPS_LEFT[ENTRY_OP[ITEM_LAST_ENTRY]] = 1 then RW_ITEM_START else ENTRY_SPLIT[ITEM_LAST_ENTRY])
                       else SKIP_FROM[?]
        | NEXT_ROW_KIND := TEMPLATE_ROW_KIND[if NEXT_TEMPLATE_PC >= 0 then NEXT_TEMPLATE_PC else 0]
        | MOVES_TO_COPY := (ENTERS_REST or REST and REST_ROW_DONE and not REST_ENDS)
                           and (NEXT_ROW_KIND = TPK_LEFT or NEXT_ROW_KIND = TPK_RIGHT)
        | COPY_RANGE_START := if NEXT_ROW_KIND = TPK_LEFT then RW_ITEM_START else ENTRY_SPLIT[TEMPLATE_SAFE]
        | COPY_RANGE_END := if NEXT_ROW_KIND = TPK_LEFT then ENTRY_SPLIT[TEMPLATE_SAFE] else TEMPLATE_SAFE
        | TEMPLATE_ORDINAL := if PHASE /= PHASE_REWRITE_EQ and NEXT_PHASE = PHASE_REWRITE_EQ then 1
                              else TEMPLATE_ORDINAL[?] + integer(REST_ENDS)
        | TR_ROW := if REST then REST_ROW else OP_TEMPLATE_INLINE_START[RW_OP] + STEP
        | TR_EMITTING := AT_CONSTRUCT and OP_TEMPLATE_INLINE_LENGTH[RW_OP] > 0 or REST_KIND = TPK_EMIT
        | TR_REF := TEMPLATE_ROW_REF[TR_ROW]
        | TR_OP := TEMPLATE_ROW_OP[TR_ROW]
        | TR_ROW_NAME := TEMPLATE_ROW_NAME[TR_ROW]
        | TR_NAME := if TR_ROW_NAME = TPR_TARGET then RW_TARGET else if TR_ROW_NAME = TPR_OPERAND then OPERAND_NAME
                     else if TR_ROW_NAME = TPR_FIRST_OPERAND then ENTRY_NAME[CONSTRUCT - 2]
                     else if TR_ROW_NAME >= 0 then TR_ROW_NAME + TEMPLATE_ORDINAL[?] * NAME_CAP else -1
        | TR_ROW_TYPE := TEMPLATE_ROW_TYPE[TR_ROW]
        | TR_TYPE := if TR_ROW_TYPE = TPR_TARGET then OWN_TYPE[?][RW_TARGET]
                     else if TR_ROW_TYPE = TPR_OPERAND then OWN_TYPE[?][OPERAND_NAME]
                     else if TR_ROW_TYPE = TPR_BOUND then BOUND_TYPE else TR_ROW_TYPE
        | TR_VALUE := if TR_REF = TPV_BOUND then BOUND_VALUE - long(1)
                      else if TR_REF = TPV_PHASE_A then AFFINE_PHASE_A else if TR_REF = TPV_PERIOD_A then AFFINE_PERIOD_A - long(1)
                      else if TR_REF = TPV_PHASE_B then AFFINE_PHASE_B else if TR_REF = TPV_PERIOD_B then AFFINE_PERIOD_B - long(1)
                      else long(TEMPLATE_ROW_VALUE[TR_ROW])
        | TEMPLATE_DEFINES := REST_KIND = TPK_DEFINE
        | TEMPLATE_GROUPS := REST_KIND = TPK_GROUP
        | TEMPLATE_INPUTS := REST_KIND = TPK_INPUT
        | SEGMENT_BEGIN := if ENTERS_REST then ITEM_END_VALUE else if TEMPLATE_DEFINES or TEMPLATE_GROUPS then FINAL_COUNT[?]
                           else SEGMENT_BEGIN[?]
        | RW_EXTENSION := RW_ENTRY - RW_REAL_END
        | RW_IS_EXTENSION := PHASE = PHASE_REWRITE_TRIGGER and RW_EXTENSION >= 0
        | RW_OP := ENTRY_OP[RW_ENTRY]
        | RW_NAME := ENTRY_NAME[RW_ENTRY]
        | RW_INTRINSIC := RW_LIVE and not RW_IS_EXTENSION and RW_OP = OP_CALL and RW_NAME >= N_INITIAL and RW_NAME <= N_ISIN
        | RW_ARGUMENTS := integer(ENTRY_VALUE[RW_ENTRY])
        | RW_NAME_SAFE := if RW_NAME >= 0 and RW_NAME < NAME_CAP then RW_NAME else 0
        | RW_LABEL_HERE := RW_LIVE and not RW_IS_EXTENSION and RW_OP = OP_SIGNAL and RW_NAME >= 0 and RW_NAME < NAME_CAP
                           and LABEL_STAMP[?][RW_NAME_SAFE] = MODEL_STAMP
                           and (RW_ENTRY + 1 < RW_LAST[?] and ENTRY_OP[RW_ENTRY + 1] = OP_CLOCK
                                or PHASE = PHASE_REWRITE_GUARD and not REST and RW_ITEM_COUNT = 1)
        | RW_STATE_LABEL := RW_LABEL_HERE and STATE_STAMP[?][RW_NAME_SAFE] = MODEL_STAMP
        | RW_TICKS := RW_LABEL_HERE and not RW_STATE_LABEL
        | RW_TICK_KEY := N_TICK_MARK + (LABEL_ORDINAL[?][RW_NAME_SAFE] + 1) * NAME_CAP
        | RW_IS_DELAY := not RW_IS_EXTENSION and ((RW_OP = OP_DELAY or RW_OP = OP_GDELAY or RW_OP = OP_WINDOW) and RW_LIVE or TR_INIT_ROW)
        | RW_TARGET := EQUATION_TARGET[WORK_ROW]
        | RW_DECL_SITE := (PHASE = PHASE_REWRITE_EQ and RW_IS_DELAY and (RW_OP = OP_DELAY or RW_OP = OP_GDELAY) and not REST and RW_ENTRY = RW_LAST[?] - 1 and RW_TARGET >= 0
                           or TR_INIT_ROW and TEMPLATE_ROW_REF[REST_ROW] = TPV_INIT_DECL and TEMPLATE_AT_HELD = ITEM_LAST_ENTRY)
                          and OWN_STAMP[?][RW_TARGET] = MODEL_STAMP
        | RW_DECL_ROW := if RW_DECL_SITE and ENTRY_AUX[RW_ENTRY] = INIT_NONE then OWN_INIT[?][RW_TARGET] - 1 else -1
        | RW_FILLS_DECL := RW_DECL_ROW >= 0
        | RW_INIT_KIND := if RW_FILLS_DECL then SIGNAL_INIT_KIND[RW_DECL_ROW] else ENTRY_AUX[RW_ENTRY]
        | RW_INIT_NAMED := RW_IS_DELAY and RW_INIT_KIND = INIT_NAME
        | RW_INIT_CONSTANT := NAME_CONSTANT[if RW_FILLS_DECL then SIGNAL_INIT_NAME[RW_DECL_ROW] else RW_NAME] - 1
        | RW_INIT_TOKEN := if RW_FILLS_DECL then SIGNAL_INIT_TOKEN[RW_DECL_ROW] else ENTRY_AUX2[RW_ENTRY]
        | RW_SIZE_LEVELS := if ENTRY_AUX[RW_ENTRY] = INIT_SIZE then 1 else if ENTRY_AUX[RW_ENTRY] = INIT_SIZE2 then 2
                            else if ENTRY_AUX[RW_ENTRY] = INIT_SIZE3 then 3 else if ENTRY_AUX[RW_ENTRY] = INIT_SIZE4 then 4 else 0
        | RW_IS_SIZE := RW_LIVE and not RW_IS_EXTENSION and RW_OP = OP_CONST and RW_SIZE_LEVELS > 0
        | RW_SIZE_CONSTANT := NAME_CONSTANT[RW_NAME] - 1
        | RW_SIZE_TYPE := if OWN_STAMP[?][RW_NAME] = MODEL_STAMP then OWN_TYPE[?][RW_NAME]
                          else if RW_SIZE_CONSTANT >= 0 then CONSTANT_TYPE[RW_SIZE_CONSTANT] else -1
        | RW_LEVEL1 := if RW_SIZE_TYPE >= 0 then RW_SIZE_TYPE else 0
        | RW_LEVEL2 := if TYPE_KIND[RW_LEVEL1] = TK_ARRAY then TYPE_ELEMENT[RW_LEVEL1] else RW_LEVEL1
        | RW_LEVEL3 := if TYPE_KIND[RW_LEVEL2] = TK_ARRAY then TYPE_ELEMENT[RW_LEVEL2] else RW_LEVEL2
        | RW_LEVEL4 := if TYPE_KIND[RW_LEVEL3] = TK_ARRAY then TYPE_ELEMENT[RW_LEVEL3] else RW_LEVEL3
        | RW_FACTOR2 := if RW_SIZE_LEVELS < 2 then ulong(1) else if TYPE_KIND[RW_LEVEL2] = TK_ARRAY then TYPE_SIZE[RW_LEVEL2] else ulong(0)
        | RW_FACTOR3 := if RW_SIZE_LEVELS < 3 then ulong(1) else if TYPE_KIND[RW_LEVEL3] = TK_ARRAY then TYPE_SIZE[RW_LEVEL3] else ulong(0)
        | RW_FACTOR4 := if RW_SIZE_LEVELS < 4 then ulong(1) else if TYPE_KIND[RW_LEVEL4] = TK_ARRAY then TYPE_SIZE[RW_LEVEL4] else ulong(0)
        | RW_SIZE := if RW_SIZE_TYPE >= 0 then long(TYPE_SIZE[RW_SIZE_TYPE] * RW_FACTOR2 * RW_FACTOR3 * RW_FACTOR4) else long(1)
        | RW_SIZE_VALUE := RW_SIZE + ENTRY_VALUE[RW_ENTRY]
        | RW_INIT_MESSAGE := if STEP = 0 and RW_INIT_NAMED and RW_INIT_CONSTANT < 0 then T_DELAY_INITIAL
                             else if STEP = 0 and RW_IS_SIZE and RW_SIZE = long(0) then T_NOT_ARRAY else 0
        | RW_PREVIOUS_NAME := ENTRY_NAME[RW_ENTRY - 1]
        | RW_NEXT_IS_ISIN := RW_LIVE and AUTOMATON_NOW and RW_ENTRY + 1 < RW_REAL_END and ENTRY_OP[RW_ENTRY + 1] = OP_CALL
                             and ENTRY_NAME[RW_ENTRY + 1] = N_ISIN
        | RW_MESSAGE := if not RW_INTRINSIC or STEP /= 0 then 0
                        else if not AUTOMATON_NOW then T_ONLY_AUTOMATON
                        else if RW_NAME /= N_ISIN and RW_NAME /= N_AUTOMATON_CLOCK then T_NO_OUTPUT
                        else if PHASE = PHASE_REWRITE_EQ and EQUATION_TARGET[WORK_ROW] < 0 and RW_ENTRY = RW_LAST[?] - 1 then T_HAS_OUTPUT
                        else if RW_NAME = N_AUTOMATON_CLOCK then (if RW_ARGUMENTS /= 0 then T_WRONG_ARGUMENTS else 0)
                        else if RW_ARGUMENTS /= 1 then T_WRONG_ARGUMENTS
                        else if RW_ENTRY = RW_ITEM_FIRST[?] or ENTRY_OP[RW_ENTRY - 1] /= OP_SIGNAL then T_EXPECTS_STATE
                        else if STATE_STAMP[?][RW_PREVIOUS_NAME] /= MODEL_STAMP then T_NOT_STATE
                        else 0
        | RW_ENTRY_DONE := if AT_CONSTRUCT then STEP + 1 >= OP_TEMPLATE_INLINE_LENGTH[RW_OP]
                           else if RW_STATE_LABEL then STEP = 3 else not RW_INTRINSIC or STEP = 1 or RW_NAME = N_AUTOMATON_CLOCK
        | RW_ITEM_DONE := RW_ENTRY_DONE and RW_ENTRY + 1 >= RW_LAST[?]
        | RW_EMITS := AT_REWRITE and STEP >= 0 and (RW_LIVE or TR_EMITTING)
        | CLOCK_DONE := if HAS_SETCLOCK[?] then STEP = 2 else SYNTH_COUNT[?] >= MODEL_INPUTS[MODEL_HERE]
        | CLOCK_COPYING := AT_CLOCK and HAS_SETCLOCK[?] and STEP = 0
        | CLOCK_LAST_SUB := if SYNTH_COUNT[?] > 0 then 2 else 1
        | PICK_DONE := WORK_ROW >= TRANSITION_COUNT[?]
        | PICK_ROW_SAFE := if PICK_DONE then 0 else WORK_ROW
        | CUR_BEST_SAFE := if CUR_BEST[?] >= 0 then CUR_BEST[?] else 0
        | PICK_TAKES := AT_PICK and not PICK_DONE and not TRANSITION_EMITTED[?][PICK_ROW_SAFE]
                        and (CUR_BEST[?] < 0 or TRANSITION_PRIORITY[?][PICK_ROW_SAFE] > TRANSITION_PRIORITY[?][CUR_BEST_SAFE])
        | CUR_GUARD_NUMBER := TRANSITION_GUARD[?][WORK_ROW]
        | CUR_TOKEN := TRANSITION_TOKEN[?][WORK_ROW]
        | CUR_LAST_SUB := if CUR_RANK[?] > 0 then 7 else 6
        | HAS_TRANSITIONS := TRANSITION_COUNT[?] > TRANSITION_FIRST[?]
        | GUARD_LAST_EQUATION := GUARD_EQUATION_LAST[GUARD_NOW]
        | CHAIN_START_NOW := if GUARD_END[GUARD_NOW] - 1 > GUARD_NOW then FILTER_ROW_START[?][GUARD_END[GUARD_NOW] - 1]
                             else FINISH_EQUATION_COUNT[?]
        | DEFINE_PARSE_DONE := WORK_ROW >= GUARD_LAST_EQUATION
        | DEFINE_FINISH_DONE := WORK_ROW >= FINISH_EQUATION_COUNT[?]
        | DEFINE_GROUP_DONE := WORK_ROW > GUARD_LAST_GROUP
        | DEFINE_GROUP_ROW := if DEFINE_GROUP_DONE then 0 else WORK_ROW
        | DEFINE_GROUP_MEMBER := GROUP_MEMBER_FIRST[DEFINE_GROUP_ROW]
        | DEFINE_GROUP_ENTRY := MEMBER_FINAL_START[?][DEFINE_GROUP_MEMBER]
        | DEFINE_GROUP_IDENTITY := GROUP_RELATION[DEFINE_GROUP_ROW] = C_IDENTITY and not GROUP_ASSUMED[DEFINE_GROUP_ROW]
                                 and MEMBER_FINAL_END[?][DEFINE_GROUP_MEMBER] - DEFINE_GROUP_ENTRY = 1
                                 and FINAL_OP[?][DEFINE_GROUP_ENTRY] = OP_SIGNAL
        | DEFINED_KEY := if AT_DEFINE_PARSE then EQUATION_TARGET[WORK_ROW]
                       else if AT_DEFINE_GROUP then (if DEFINE_GROUP_IDENTITY then FINAL_NAME[?][DEFINE_GROUP_ENTRY] else -1)
                       else FINISH_EQUATION_TARGET[?][WORK_ROW]
        | DEFINES := (AT_DEFINE_PARSE and not DEFINE_PARSE_DONE or AT_DEFINE_FINISH and not DEFINE_FINISH_DONE
                      or AT_DEFINE_GROUP and not DEFINE_GROUP_DONE)
                     and DEFINED_KEY >= 0 and DEFINED_KEY < NAME_CAP
        | GUARD_FIRST_GROUP := GUARD_GROUP_FIRST[GUARD_NOW]
        | GUARD_LAST_GROUP := GUARD_GROUP_LAST[GUARD_NOW] - 1
        | READ_START := if PHASE = PHASE_READ_PARSE then
                          (if GUARD_EQUATION_FIRST[GUARD_NOW] < GUARD_LAST_EQUATION then EQUATION_FINAL_START[?][GUARD_EQUATION_FIRST[GUARD_NOW]] else 0)
                        else if PHASE = PHASE_READ_FINISH then
                          (if CHAIN_START[?] < FINISH_EQUATION_COUNT[?] then FINISH_EQUATION_FINAL_START[?][CHAIN_START[?]] else 0)
                        else if GUARD_FIRST_GROUP <= GUARD_LAST_GROUP then MEMBER_FINAL_START[?][GROUP_MEMBER_FIRST[GUARD_FIRST_GROUP]]
                        else 0
        | READ_END := if PHASE = PHASE_READ_PARSE then
                        (if GUARD_EQUATION_FIRST[GUARD_NOW] < GUARD_LAST_EQUATION then EQUATION_FINAL_END[?][GUARD_LAST_EQUATION - 1] else 0)
                      else if PHASE = PHASE_READ_FINISH then
                        (if CHAIN_START[?] < FINISH_EQUATION_COUNT[?] then FINAL_COUNT[?] else 0)
                      else if GUARD_FIRST_GROUP <= GUARD_LAST_GROUP then
                        MEMBER_FINAL_END[?][GROUP_MEMBER_FIRST[GUARD_LAST_GROUP] + GROUP_MEMBER_TOTAL[GUARD_LAST_GROUP] - 1]
                      else 0
        | READ_HEADER := AT_READ and STEP < 0
        | READ_ENTRY := RW_AT[?]
        | READ_ENTRY_DONE := READ_ENTRY >= RW_LAST[?]
        | READ_KEY := if AT_READ_DEPS then
                        (if STEP = 0 then (if DEPENDENCE_RENAMED_FROM[?][WORK_ROW] > 0 then DEPENDENCE_RENAMED_FROM[?][WORK_ROW] - 1 else DEPENDENCE_FROM_NAME[WORK_ROW])
                         else if DEPENDENCE_RENAMED_TO[?][WORK_ROW] > 0 then DEPENDENCE_RENAMED_TO[?][WORK_ROW] - 1 else DEPENDENCE_TO_NAME[WORK_ROW])
                      else FINAL_NAME[?][READ_ENTRY]
        | DEPS_DONE := WORK_ROW >= GUARD_DEPENDENCE_LAST[GUARD_NOW]
        | READS := AT_READ and STEP >= 0 and not READ_ENTRY_DONE and FINAL_OP[?][READ_ENTRY] = OP_SIGNAL
                   or AT_READ_DEPS and not DEPS_DONE
        | IS_INPUT := READS and READ_KEY >= 0 and READ_KEY < NAME_CAP and OWN_STAMP[?][READ_KEY] = MODEL_STAMP
                      and DEFINED_STAMP[?][READ_KEY] /= GUARD_STAMP[?]
        | NEW_INPUT := IS_INPUT and INPUT_STAMP[?][READ_KEY] /= GUARD_STAMP[?]
        | RENAMED_KEY := READ_KEY + GUARD_SUFFIX
        | ON_HEADER := AT_ON and STEP < 0
        | ON_COPYING := AT_ON and STEP = 0
        | ON_ROWS := AT_ON and STEP = 1
        | FILTER_DONE := WORK_ROW >= INPUT_COUNT[?]
        | FILTER_KEY := INPUT_LIST[?][WORK_ROW]
        | TICK_LABEL_ROW := if WORK_ROW >= 0 then WORK_ROW else 0
        | TICK_LABEL_KEY := LABEL_NAME[TICK_LABEL_ROW]
        | TICK_LABELS_DONE := WORK_ROW < 0
        | TICKED := not TICK_LABELS_DONE and LABEL_TICKED[?][TICK_LABEL_KEY] = MODEL_STAMP
        | TICK_KEY := N_TICK_MARK + (LABEL_ORDINAL[?][TICK_LABEL_KEY] + 1) * NAME_CAP
        | TICK_TOKEN := LABEL_TICK_TOKEN[?][TICK_LABEL_KEY]
        | TICK_USE_NOW := TICK_USE[?]
        | TICK_USES_DONE := TICK_USE_NOW >= MODEL_USE_END[MODEL_HERE]
        | TICK_USE_MATCHES := not TICK_USES_DONE and USE_NAME[TICK_USE_NOW] = TICK_LABEL_KEY
        | TICK_E := TICK_EQUATION[?]
        | TICK_EQUATIONS_DONE := TICK_E >= USE_EQUATION_LAST[TICK_USE_NOW]
        | TICK_FINAL_START := EQUATION_FINAL_START[?][TICK_E]
        | TICK_CALL_AT := EQUATION_FINAL_END[?][TICK_E] - 1
        | TICK_CALLS := TICK_CALL_AT >= TICK_FINAL_START and FINAL_OP[?][TICK_CALL_AT] = OP_CALL
        | TICK_ARGS := if TICK_CALLS then integer(FINAL_VALUE[?][TICK_CALL_AT]) else 0
        | TICK_TARGETS := if EQUATION_TARGET[TICK_E] < 0 then 0 else if EQUATION_TUPLE_ARITY[TICK_E] > 1 then EQUATION_TUPLE_ARITY[TICK_E] else 1
        | TICK_K_NOW := TICK_K[?]
        | TICK_PARTS_DONE := TICK_K_NOW >= TICK_TARGETS + TICK_ARGS
        | TICK_TARGET_PART := TICK_K_NOW < TICK_TARGETS
        | TICK_TARGET_NAME := if TICK_K_NOW = 0 and EQUATION_TUPLE_ARITY[TICK_E] <= 1 then EQUATION_TARGET[TICK_E]
                              else TUPLE_NAME_ROW[EQUATION_TUPLE_START[TICK_E] + TICK_K_NOW]
        | TICK_ARG := if TICK_TARGET_PART then 0 else TICK_K_NOW - TICK_TARGETS
        | TICK_ARG_FROM := TICK_START[?][TICK_ARG]
        | TICK_ARG_TO := if TICK_ARG + 1 < TICK_ARGS then TICK_START[?][TICK_ARG + 1] else TICK_CALL_AT
        | TICK_ARG_CONSTANT := not TICK_PARTS_DONE and not TICK_TARGET_PART and TICK_ARG_TO - TICK_ARG_FROM = 1
                               and (FINAL_OP[?][TICK_ARG_FROM] = OP_CONST or FINAL_OP[?][TICK_ARG_FROM] = OP_ENUMCONST)
        | TICK_SCAN_OP := FINAL_OP[?][RW_AT[?]]
        | TICK_SCAN_ARITY := if TICK_SCAN_OP = OP_CALL then integer(FINAL_VALUE[?][RW_AT[?]]) else OP_ARITY[TICK_SCAN_OP]
        | TICK_EMITS := AT_TICK and (STEP = TS_PART and not TICK_PARTS_DONE and TICK_TARGET_PART or STEP = TS_COPY
                                     or STEP = TS_CLOCK or STEP = TS_DEFAULT)
        | TICK_ROWS := AT_TICK and STEP = TS_END and TICK_PARTS[?] > 0
        | TICK_NEXT_STEP := if STEP = TS_LABEL then (if TICKED then TS_USE else TS_LABEL)
                            else if STEP = TS_USE then (if TICK_USES_DONE then TS_END else if TICK_USE_MATCHES then TS_EQUATION else TS_USE)
                            else if STEP = TS_EQUATION then (if TICK_EQUATIONS_DONE then TS_USE else if TICK_ARGS > 0 then TS_SCAN else TS_PART)
                            else if STEP = TS_SCAN then (if RW_AT[?] + 1 >= RW_LAST[?] then TS_PART else TS_SCAN)
                            else if STEP = TS_PART then
                              (if TICK_PARTS_DONE then TS_EQUATION else if TICK_TARGET_PART then TS_CLOCK else if TICK_ARG_CONSTANT then TS_PART else TS_COPY)
                            else if STEP = TS_COPY then (if RW_AT[?] + 1 >= RW_LAST[?] then TS_CLOCK else TS_COPY)
                            else if STEP = TS_CLOCK then (if TICK_PARTS[?] > 0 then TS_DEFAULT else TS_PART)
                            else if STEP = TS_DEFAULT then TS_PART
                            else TS_LABEL
        | TICK_USE := if not AT_TICK then TICK_USE[?] else if STEP = TS_LABEL then MODEL_USE_START[MODEL_HERE]
                      else if STEP = TS_USE and not TICK_USES_DONE and not TICK_USE_MATCHES or STEP = TS_EQUATION and TICK_EQUATIONS_DONE
                      then TICK_USE_NOW + 1 else TICK_USE_NOW
        | TICK_EQUATION := if AT_TICK and STEP = TS_USE and TICK_USE_MATCHES then USE_EQUATION_FIRST[TICK_USE_NOW]
                           else if AT_TICK and STEP = TS_PART and TICK_PARTS_DONE then TICK_E + 1 else TICK_E
        | TICK_K := if AT_TICK and STEP = TS_EQUATION then 0
                    else if AT_TICK and (STEP = TS_CLOCK or STEP = TS_PART and TICK_ARG_CONSTANT) then TICK_K_NOW + 1 else TICK_K_NOW
        | TICK_PARTS := if AT_TICK and STEP = TS_LABEL then 0 else if AT_TICK and STEP = TS_CLOCK then TICK_PARTS[?] + 1 else TICK_PARTS[?]
        | TICK_HEIGHT := if AT_TICK and STEP = TS_EQUATION then 0
                         else if AT_TICK and STEP = TS_SCAN then TICK_HEIGHT[?] - TICK_SCAN_ARITY + 1 else TICK_HEIGHT[?]
        | TICK_START := TICK_START[?] next (if AT_TICK and STEP = TS_SCAN then TICK_HEIGHT[?] else -1) : RW_AT[?]
        | COPIES_FINAL := ON_COPYING or AT_CUR and STEP = 5 or AT_TICK and STEP = TS_COPY or CLOCK_COPYING
        | COPY_SOURCE := RW_AT[?]
        | EMITS := RW_EMITS and not (RW_INTRINSIC and STEP = 0 and RW_MESSAGE /= 0)
                   or AT_CLOCK and not CLOCK_DONE and STEP >= 0
                   or AT_STATE and STEP < 2
                   or AT_CUR
                   or AT_CUR_TAIL and (STEP = 0 or STEP = 1 and HAS_TRANSITIONS)
                   or AT_GROUP and STEP < 2
                   or TICK_EMITS
                   or ON_COPYING
                   or AT_FILTER and not FILTER_DONE and STEP < 3
        | EMIT_OP := if COPIES_FINAL then FINAL_OP[?][COPY_SOURCE]
                     else if AT_REWRITE then
                       (if TR_INIT_ROW then OP_DELAY else if TR_EMITTING then TR_OP
                        else if RW_IS_EXTENSION then (if RW_EXTENSION = 0 then OP_SIGNAL else OP_WHEN)
                        else if RW_INTRINSIC then (if RW_NAME = N_AUTOMATON_CLOCK then OP_SIGNAL else if STEP = 0 then OP_CONST else OP_EQ)
                        else if RW_STATE_LABEL then (if STEP = 0 then OP_SIGNAL else if STEP = 1 then OP_CONST else if STEP = 2 then OP_EQ else OP_UWHEN)
                        else RW_OP)
                     else if AT_TICK then (if STEP = TS_PART then OP_SIGNAL else if STEP = TS_CLOCK then OP_CLOCK else OP_DEFAULT)
                     else if AT_CLOCK then (if HAS_SETCLOCK[?] then OP_UWHEN else if STEP = 0 then OP_SIGNAL else if STEP = 1 then OP_CLOCK else OP_DEFAULT)
                     else if AT_STATE then (if STEP = 0 then OP_SIGNAL else OP_DELAY)
                     else if AT_CUR then
                       (if STEP = 0 or STEP = 2 then OP_CONST else if STEP = 1 then OP_SIGNAL else if STEP = 3 then OP_EQ
                        else if STEP = 4 or STEP = 6 then OP_WHEN else OP_DEFAULT)
                     else if AT_CUR_TAIL then (if STEP = 0 then OP_SIGNAL else OP_DEFAULT)
                     else if AT_GROUP then OP_SIGNAL
                     else if STEP = 2 then OP_WHEN else OP_SIGNAL
        | EMIT_NAME := if COPIES_FINAL then FINAL_NAME[?][COPY_SOURCE]
                       else if AT_REWRITE then
                         (if TR_EMITTING and not TR_INIT_ROW then TR_NAME
                          else if RW_IS_EXTENSION then N_ON_MARK + TRANSITION_GUARD[?][WORK_ROW] * NAME_CAP
                          else if RW_INTRINSIC and RW_NAME = N_AUTOMATON_CLOCK then N_CLOCK_MARK
                          else if RW_NEXT_IS_ISIN or RW_STATE_LABEL then N_STATE_MARK else if RW_TICKS then RW_TICK_KEY
                          else if RW_INIT_NAMED then -1 else RW_NAME)
                       else if AT_TICK then (if STEP = TS_PART then TICK_TARGET_NAME else TICK_KEY)
                       else if AT_CLOCK then (if HAS_SETCLOCK[?] then -1 else SIGNAL_NAME[WORK_ROW])
                       else if AT_STATE then N_CURRENT_MARK
                       else if AT_CUR or AT_CUR_TAIL then N_STATE_MARK
                       else if AT_GROUP then (if STEP = 0 then N_CURRENT_MARK else N_CLOCK_MARK)
                       else if STEP = 0 then FILTER_KEY else N_ON_MARK + GUARD_SUFFIX
        | EMIT_TOKEN := if COPIES_FINAL then FINAL_TOKEN[?][COPY_SOURCE]
                        else if AT_REWRITE then
                          (if TR_EMITTING then CONSTRUCT_TOKEN
                           else if RW_IS_EXTENSION then TRANSITION_TOKEN[?][WORK_ROW]
                           else if RW_NEXT_IS_ISIN then ENTRY_TOKEN[RW_ENTRY + 1] else ENTRY_TOKEN[RW_ENTRY])
                        else if AT_CUR then CUR_TOKEN
                        else if AT_TICK then TICK_TOKEN
                        else if AT_CLOCK and HAS_SETCLOCK[?] then SETCLOCK_TOKEN[?]
                        else if AT_FILTER then GUARD_AT
                        else MODEL_AT
        | EMIT_VALUE := if COPIES_FINAL then FINAL_VALUE[?][COPY_SOURCE]
                        else if AT_REWRITE then
                          (if TR_EMITTING and not TR_INIT_ROW then TR_VALUE
                           else if RW_INTRINSIC then (if RW_NAME = N_AUTOMATON_CLOCK then long(0) else long(STATE_ORDINAL[?][RW_PREVIOUS_NAME]))
                           else if RW_STATE_LABEL then (if STEP = 1 then long(STATE_ORDINAL[?][RW_NAME_SAFE]) else long(0))
                           else if RW_INIT_NAMED then CONSTANT_VALUE[RW_INIT_CONSTANT]
                           else if RW_IS_SIZE then RW_SIZE_VALUE
                           else if RW_FILLS_DECL then SIGNAL_INIT_VALUE[RW_DECL_ROW] else ENTRY_VALUE[RW_ENTRY])
                        else if AT_STATE then long(INITIAL_ORDINAL[?])
                        else if AT_CUR then long(if STEP = 0 then TRANSITION_TARGET[?][WORK_ROW] else TRANSITION_SOURCE[?][WORK_ROW])
                        else long(0)
        | EMIT_TYPE := if COPIES_FINAL then FINAL_TYPE[?][COPY_SOURCE]
                       else if AT_REWRITE then
                         (if TR_EMITTING and not TR_INIT_ROW then (if TR_OP = OP_CONST or TR_OP = OP_DELAY then TR_TYPE else -1)
                          else if RW_INTRINSIC then (if RW_NAME = N_AUTOMATON_CLOCK then -1 else STATE_TYPE_NOW)
                          else if RW_STATE_LABEL then (if STEP = 1 or STEP = 2 then STATE_TYPE_NOW else -1)
                          else if RW_INIT_NAMED then CONSTANT_TYPE[RW_INIT_CONSTANT]
                          else if RW_IS_SIZE then (if RW_SIZE_VALUE < long(32768) then BUILTIN_SHORT else BUILTIN_INTEGER)
                          else if RW_OP = OP_FLAT then (if RW_NAME >= 0 then RW_SIZE_TYPE else -1)
                          else if RW_FILLS_DECL then SIGNAL_INIT_TYPE[RW_DECL_ROW] else ENTRY_TYPE[RW_ENTRY])
                       else if AT_TICK or AT_CLOCK and HAS_SETCLOCK[?] then -1
                       else STATE_TYPE_NOW
        | EMIT_AUX := if COPIES_FINAL then FINAL_AUX[?][COPY_SOURCE]
                      else if AT_REWRITE then
                        (if TR_EMITTING and not TR_INIT_ROW then (if TR_OP = OP_DELAY then INIT_CONST else -1)
                         else if RW_INTRINSIC or RW_STATE_LABEL or RW_IS_EXTENSION or RW_IS_SIZE or INDEX_DECLARES then -1
                         else if RW_INIT_NAMED then INIT_CONST
                         else if RW_FILLS_DECL then RW_INIT_KIND else ENTRY_AUX[RW_ENTRY])
                      else if AT_STATE then INIT_CONST
                      else -1
        | EMIT_AUX2 := if COPIES_FINAL then FINAL_AUX2[?][COPY_SOURCE]
                       else if AT_REWRITE then
                         (if TR_EMITTING and not TR_INIT_ROW then CONSTRUCT_TOKEN
                          else if RW_INTRINSIC or RW_STATE_LABEL or RW_IS_EXTENSION then 0
                          else if RW_FILLS_DECL then RW_INIT_TOKEN else ENTRY_AUX2[RW_ENTRY])
                       else 0
        | WRITES_FINAL_NAME := EMITS or IS_INPUT and AT_READ
        | FINAL_SLOT := if EMITS then FINAL_COUNT[?] else -1
        | FINAL_NAME_SLOT := if EMITS then FINAL_COUNT[?] else if IS_INPUT and AT_READ then READ_ENTRY else -1
        | FINAL_OP := FINAL_OP[?] next FINAL_SLOT : EMIT_OP
        | FINAL_MODEL := FINAL_MODEL[?] next FINAL_SLOT : MODEL_HERE
        | FINAL_NAME := FINAL_NAME[?] next FINAL_NAME_SLOT : (if EMITS then EMIT_NAME else RENAMED_KEY)
        | FINAL_TOKEN := FINAL_TOKEN[?] next FINAL_SLOT : EMIT_TOKEN
        | FINAL_VALUE := FINAL_VALUE[?] next FINAL_SLOT : EMIT_VALUE
        | FINAL_TYPE := FINAL_TYPE[?] next FINAL_SLOT : EMIT_TYPE
        | FINAL_AUX := FINAL_AUX[?] next FINAL_SLOT : EMIT_AUX
        | FINAL_AUX2 := FINAL_AUX2[?] next FINAL_SLOT : EMIT_AUX2
        | FINAL_COUNT := FINAL_COUNT[?] + integer(EMITS)
        | CLOCK_ROWS := AT_CLOCK and CLOCK_DONE
        | STATE_ROWS := AT_STATE and STEP = 2
        | CUR_ROWS := AT_CUR_TAIL and STEP = 2
        | FILTER_ROWS := AT_FILTER and not FILTER_DONE and STEP = 3
        | WRITES_ROWS := CLOCK_ROWS or STATE_ROWS or CUR_ROWS or ON_ROWS or FILTER_ROWS or TEMPLATE_DEFINES or TICK_ROWS or TEMPLATE_INPUTS
        | INDEX_DECLARES := PHASE = PHASE_REWRITE_EQ and RW_LIVE and not REST and (RW_OP = OP_RANGE or RW_OP = OP_STEP or RW_OP = OP_NEXT)
                            and ENTRY_AUX[RW_ENTRY] >= 0
        | ROW_KEY := if INDEX_DECLARES then RW_TARGET else if TEMPLATE_DEFINES or TEMPLATE_INPUTS then TR_NAME else if CLOCK_ROWS then N_CLOCK_MARK else if STATE_ROWS then N_STATE_MARK else if CUR_ROWS then N_CURRENT_MARK
                     else if ON_ROWS then N_ON_MARK + GUARD_SUFFIX else if TICK_ROWS then TICK_KEY else FILTER_KEY + GUARD_SUFFIX
        | ROW_TYPE := if INDEX_DECLARES then (if RW_OP = OP_NEXT then OWN_TYPE[?][ENTRY_AUX[RW_ENTRY]] else INDEX_ID_TYPE[ENTRY_AUX[RW_ENTRY]]) else if TEMPLATE_DEFINES or TEMPLATE_INPUTS then TR_TYPE else if CLOCK_ROWS or ON_ROWS or TICK_ROWS then BUILTIN_EVENT else if FILTER_ROWS then OWN_TYPE[?][FILTER_KEY] else STATE_TYPE_NOW
        | ROW_TOKEN := if INDEX_DECLARES then ENTRY_TOKEN[RW_ENTRY] else if TEMPLATE_DEFINES or TEMPLATE_INPUTS then CONSTRUCT_TOKEN else if ON_ROWS or FILTER_ROWS then GUARD_AT else if TICK_ROWS then TICK_TOKEN else MODEL_AT
        | FULL := EMITS and FINAL_COUNT[?] >= FINAL_CAP
                  or WRITES_ROWS and (FINISH_SIGNAL_COUNT[?] >= SIGNAL_CAP or FINISH_EQUATION_COUNT[?] >= EQUATION_CAP)
                  or INDEX_DECLARES and FINISH_SIGNAL_COUNT[?] >= SIGNAL_CAP
                  or (AT_GROUP and STEP = 2 or TEMPLATE_GROUPS) and FINISH_GROUP_COUNT[?] >= GROUP_CAP
                  or REST_DUE and TEMPLATE_ORDINAL[?] >= GUARD_CAP
                  or NEW_INPUT and INPUT_COUNT[?] >= SIGNAL_CAP
                  or REGISTERS_STATE and STATE_COUNT[?] >= SIGNAL_CAP
                  or RECORDS_TRANSITION and TRANSITION_COUNT[?] >= EQUATION_CAP
        | STEP_FINISH_MESSAGE := if PHASE = PHASE_DONE or PHASE = PHASE_FAILED then 0
                                 else if FULL then T_CAPACITY
                                 else if AT_USE and not USES_DONE and USE_UNDECLARED then T_LABEL_UNDECLARED
                                 else if AT_SIGNAL and SIGNALS_DONE and AUTOMATON_NOW and MODEL_INPUTS[MODEL_HERE] = 0 then T_NO_INPUT
                                 else if AT_HIDE then HIDE_FINISH_MESSAGE
                                 else if AT_STATEMENT and STATEMENTS_DONE and not HAS_INITIAL[?] then T_ONE_INITIAL
                                 else if AT_STATEMENT then AUTOMATON_STATEMENT_MESSAGE
                                 else if AT_REWRITE and STEP >= 0 then
                                   (if TEMPLATE_MESSAGE /= 0 then TEMPLATE_MESSAGE else if RW_MESSAGE /= 0 then RW_MESSAGE else RW_INIT_MESSAGE)
                                 else if AT_INITS and INIT_UNUSED_HERE then T_INIT_UNUSED
                                 else if AT_TICK and STEP = TS_END and TICK_PARTS[?] = 0 then T_LABEL_NO_TICK
                                 else 0
        | FINISH_FAILS := STEP_FINISH_MESSAGE /= 0
        | FINISH_STEP_TOKEN := if FULL then MODEL_AT
                               else if AT_USE then USE_TOKEN[WORK_ROW]
                               else if AT_HIDE then HIDE_TOKEN[WORK_ROW]
                               else if AT_STATEMENT and not STATEMENTS_DONE then
                                 (if AUTOMATON_STATEMENT_MESSAGE = T_NOT_LABEL_OF then ST_STATE_TOKEN
                                  else if AUTOMATON_STATEMENT_MESSAGE = T_PRIORITY_CONSTANT then ENTRY_TOKEN[ST_LAST_ARGUMENT] else ST_TOKEN)
                               else if AT_REWRITE then
                                 (if CONSTRUCT_MESSAGE = T_CONSTANT_BOUND then ENTRY_TOKEN[CONSTRUCT_SPLIT]
                                  else if CONSTRUCT_MESSAGE = T_SIGNAL_UNDECLARED then ENTRY_TOKEN[RW_ENTRY - 1]
                                  else if CONSTRUCT_MESSAGE /= 0 then ENTRY_TOKEN[RW_ENTRY]
                                  else if TEMPLATE_MESSAGE /= 0 then ENTRY_TOKEN[TEMPLATE_SAFE]
                                  else if RW_MESSAGE = T_NOT_STATE then ENTRY_TOKEN[RW_ENTRY - 1]
                                  else if RW_MESSAGE = 0 and RW_INIT_MESSAGE /= 0 and not RW_IS_SIZE then RW_INIT_TOKEN
                                  else ENTRY_TOKEN[RW_ENTRY])
                               else if AT_INITS then SIGNAL_TOKEN[WORK_ROW]
                               else if AT_TICK then TICK_TOKEN
                               else MODEL_AT
        | FINISH_STEP_ARGUMENT0 := if FULL then F_CAP_FINISH
                                   else if AT_USE then USE_NAME[WORK_ROW]
                                   else if AT_HIDE then HIDE_KEY
                                   else if AT_INITS then SIGNAL_NAME[WORK_ROW]
                                   else if AT_TICK then TICK_LABEL_KEY
                                   else if AT_REWRITE and TEMPLATE_MESSAGE /= 0 then
                                     (if TEMPLATE_MESSAGE = T_SIGNAL_UNDECLARED then OPERAND_NAME else ENTRY_TOKEN[RW_ENTRY])
                                   else if STEP_FINISH_MESSAGE = T_NO_INPUT or STEP_FINISH_MESSAGE = T_ONE_INITIAL then MODEL_KEY
                                   else if STEP_FINISH_MESSAGE = T_LABEL_PLACED then USE_NAME[EQUATION_LABELS[WORK_ROW]]
                                   else if STEP_FINISH_MESSAGE = T_NOT_LABEL_OF then ST_STATE
                                   else if AT_STATEMENT then ST_NAME
                                   else if STEP_FINISH_MESSAGE = T_NOT_STATE then RW_PREVIOUS_NAME
                                   else RW_NAME
        | FINISH_STEP_ARGUMENT1 := if STEP_FINISH_MESSAGE = T_WRONG_ARGUMENTS then (if AT_STATEMENT then ST_EXPECTED else if RW_NAME = N_AUTOMATON_CLOCK then 0 else 1)
                                   else if STEP_FINISH_MESSAGE = T_LABEL_PLACED then ST_NAME
                                   else if AT_HIDE then ROLE_FRAGMENT[HIDE_ROLE]
                                   else if AT_INITS then SIGNAL_NAME[WORK_ROW]
                                   else MODEL_KEY
        | FINISH_STEP_ARGUMENT2 := if AT_HIDE then MODEL_KEY else if AT_STATEMENT then ST_ARGUMENTS else RW_ARGUMENTS
        | FIRST_FINISH_FAILURE := FINISH_FAILS
        | FINISH_MESSAGE := if FIRST_FINISH_FAILURE then STEP_FINISH_MESSAGE else FINISH_MESSAGE[?]
        | FINISH_TOKEN := if FIRST_FINISH_FAILURE then FINISH_STEP_TOKEN else FINISH_TOKEN[?]
        | FINISH_ARGUMENT0 := if FIRST_FINISH_FAILURE then FINISH_STEP_ARGUMENT0 else FINISH_ARGUMENT0[?]
        | FINISH_ARGUMENT1 := if FIRST_FINISH_FAILURE then FINISH_STEP_ARGUMENT1 else FINISH_ARGUMENT1[?]
        | FINISH_ARGUMENT2 := if FIRST_FINISH_FAILURE then FINISH_STEP_ARGUMENT2 else FINISH_ARGUMENT2[?]
        | GOES := not FINISH_FAILS
        | NEXT_PHASE := if FINISH_FAILS then PHASE_FAILED
                        else if AT_START then (if ALL_CLOSED then PHASE_DONE else PHASE_LABEL)
                        else if AT_LABEL then (if LABELS_DONE then PHASE_USE else PHASE_LABEL)
                        else if AT_USE then (if USES_DONE then PHASE_SIGNAL else PHASE_USE)
                        else if AT_SIGNAL then (if not SIGNALS_DONE then PHASE_SIGNAL else PHASE_HIDE)
                        else if AT_HIDE then (if not HIDES_DONE then PHASE_HIDE else if AUTOMATON_NOW then PHASE_STATEMENT else PHASE_REWRITE_EQ)
                        else if AT_STATEMENT then (if STATEMENTS_DONE then PHASE_REWRITE_EQ else PHASE_STATEMENT)
                        else if RW_PHASE_DONE then
                          (if PHASE = PHASE_REWRITE_EQ then PHASE_REWRITE_MEMBER else if PHASE = PHASE_REWRITE_MEMBER then PHASE_REWRITE_GUARD
                           else if PHASE = PHASE_REWRITE_GUARD then PHASE_INITS
                           else PHASE_CLOCK)
                        else if AT_REWRITE then PHASE
                        else if AT_INITS then
                          (if not INITS_DONE then PHASE_INITS else if AUTOMATON_NOW then PHASE_REWRITE_TRIGGER else PHASE_TICK)
                        else if AT_CLOCK then (if CLOCK_DONE then PHASE_STATE else PHASE_CLOCK)
                        else if AT_STATE then (if STEP = 2 then PHASE_PICK else PHASE_STATE)
                        else if AT_PICK then (if not PICK_DONE then PHASE_PICK else if CUR_BEST[?] >= 0 then PHASE_CUR else PHASE_CUR_TAIL)
                        else if AT_CUR then (if STEP = CUR_LAST_SUB then PHASE_PICK else PHASE_CUR)
                        else if AT_CUR_TAIL then (if STEP = 2 then PHASE_GROUP else PHASE_CUR_TAIL)
                        else if AT_GROUP then (if STEP = 2 then PHASE_TICK else PHASE_GROUP)
                        else if AT_TICK then (if STEP = TS_LABEL and TICK_LABELS_DONE then PHASE_GUARD_START else PHASE_TICK)
                        else if AT_GUARD_START then (if GUARD_NUMBER[?] = 0 then PHASE_START else PHASE_DEFINE_PARSE)
                        else if AT_DEFINE_PARSE then (if DEFINE_PARSE_DONE then PHASE_DEFINE_FINISH else PHASE_DEFINE_PARSE)
                        else if AT_DEFINE_FINISH then (if DEFINE_FINISH_DONE then PHASE_DEFINE_GROUP else PHASE_DEFINE_FINISH)
                        else if AT_DEFINE_GROUP then (if DEFINE_GROUP_DONE then PHASE_READ_PARSE else PHASE_DEFINE_GROUP)
                        else if AT_READ then
                          (if STEP >= 0 and READ_ENTRY_DONE then (if PHASE = PHASE_READ_MEMBERS then PHASE_READ_DEPS else PHASE + 1) else PHASE)
                        else if AT_READ_DEPS then (if DEPS_DONE then PHASE_ON else PHASE_READ_DEPS)
                        else if AT_ON then (if ON_ROWS then PHASE_FILTER else PHASE_ON)
                        else if AT_FILTER then (if FILTER_DONE then PHASE_GUARD_START else PHASE_FILTER)
                        else PHASE
        | FINISH_PHASE := NEXT_PHASE
        | PHASE_CHANGES := NEXT_PHASE /= PHASE
        | ENTRY_ROW := if NEXT_PHASE = PHASE_LABEL or NEXT_PHASE = PHASE_TICK then MODEL_FIRST_LABEL[MODEL_HERE] - 1
                       else if NEXT_PHASE = PHASE_USE then MODEL_USE_START[MODEL_HERE]
                       else if NEXT_PHASE = PHASE_HIDE then MODEL_HIDE_START[MODEL_HERE]
                       else if NEXT_PHASE = PHASE_SIGNAL or NEXT_PHASE = PHASE_CLOCK or NEXT_PHASE = PHASE_INITS
                       then MODEL_FIRST_SIGNAL[MODEL_HERE] - 1
                       else if NEXT_PHASE = PHASE_STATEMENT or NEXT_PHASE = PHASE_REWRITE_EQ then MODEL_EQUATION_START[MODEL_HERE]
                       else if NEXT_PHASE = PHASE_REWRITE_MEMBER then MODEL_MEMBER_START[MODEL_HERE]
                       else if NEXT_PHASE = PHASE_REWRITE_GUARD then MODEL_GUARD_START[MODEL_HERE]
                       else if NEXT_PHASE = PHASE_REWRITE_TRIGGER or NEXT_PHASE = PHASE_PICK then TRANSITION_FIRST[?]
                       else if NEXT_PHASE = PHASE_CUR then CUR_BEST[?]
                       else if NEXT_PHASE = PHASE_DEFINE_PARSE then GUARD_EQUATION_FIRST[GUARD_NOW]
                       else if NEXT_PHASE = PHASE_DEFINE_FINISH then CHAIN_START[?]
                       else if NEXT_PHASE = PHASE_DEFINE_GROUP then GUARD_FIRST_GROUP
                       else if NEXT_PHASE = PHASE_READ_DEPS then GUARD_DEPENDENCE_FIRST[GUARD_NOW]
                       else if NEXT_PHASE = PHASE_FILTER then GUARD_INPUT_START[?]
                       else 0
        | NEXT_ROW := if PHASE_CHANGES then ENTRY_ROW
                      else if AT_LABEL then LABEL_NEXT[WORK_ROW] - 1
                      else if AT_USE or AT_HIDE then WORK_ROW + 1
                      else if AT_SIGNAL or AT_INITS then SIGNAL_NEXT[WORK_ROW] - 1
                      else if AT_STATEMENT then (if ST_IS_STATEMENT and STEP = 0 and ST_TRANSITION then WORK_ROW else WORK_ROW + 1)
                      else if AT_REWRITE then
                        (if RW_HEADER then (if RW_ITEM_COUNT = 0 then WORK_ROW + 1 else WORK_ROW)
                         else if REST then (if REST_ENDS then WORK_ROW + 1 else WORK_ROW)
                         else if RW_ITEM_DONE and not ENTERS_REST then WORK_ROW + 1 else WORK_ROW)
                      else if AT_CLOCK then (if HAS_SETCLOCK[?] then WORK_ROW else if STEP = CLOCK_LAST_SUB then SIGNAL_NEXT[WORK_ROW] - 1 else WORK_ROW)
                      else if AT_PICK then WORK_ROW + 1
                      else if AT_CUR then (if STEP = CUR_LAST_SUB then WORK_ROW + 1 else WORK_ROW)
                      else if AT_DEFINE_PARSE or AT_DEFINE_FINISH or AT_DEFINE_GROUP then WORK_ROW + 1
                      else if AT_READ_DEPS then (if STEP = 1 then WORK_ROW + 1 else WORK_ROW)
                      else if AT_FILTER then (if STEP = 3 then WORK_ROW + 1 else WORK_ROW)
                      else if AT_TICK then (if STEP = TS_LABEL and not TICKED or STEP = TS_END then LABEL_NEXT[TICK_LABEL_ROW] - 1 else WORK_ROW)
                      else WORK_ROW
        | FINISH_ROW := NEXT_ROW
        | NEXT_SUB := if PHASE_CHANGES then
                        (if NEXT_PHASE >= PHASE_REWRITE_EQ and NEXT_PHASE <= PHASE_REWRITE_TRIGGER
                            or NEXT_PHASE >= PHASE_READ_PARSE and NEXT_PHASE <= PHASE_READ_MEMBERS or NEXT_PHASE = PHASE_ON
                            or NEXT_PHASE = PHASE_CLOCK and HAS_SETCLOCK[?] then -1 else 0)
                      else if AT_REWRITE then
                        (if RW_HEADER then (if RW_ITEM_COUNT = 0 then -1 else 0)
                         else if REST then (if REST_ENDS then -1 else if REST_COPY and not RW_ENTRY_DONE then STEP + 1 else 0)
                         else if ENTERS_REST then 0
                         else if RW_ITEM_DONE then -1 else if RW_ENTRY_DONE then 0 else STEP + 1)
                      else if AT_READ then 0
                      else if AT_STATEMENT then (if ST_IS_STATEMENT and STEP = 0 and ST_TRANSITION then 1 else 0)
                      else if AT_CLOCK then
                        (if HAS_SETCLOCK[?] then (if STEP = 0 and RW_AT[?] + 1 < RW_LAST[?] then 0 else STEP + 1)
                         else if STEP = CLOCK_LAST_SUB then 0 else STEP + 1)
                      else if AT_CUR then
                        (if STEP = CUR_LAST_SUB then 0
                         else if STEP = 5 then (if RW_AT[?] + 1 >= RW_LAST[?] then 6 else 5) else STEP + 1)
                      else if AT_STATE or AT_CUR_TAIL or AT_GROUP then STEP + 1
                      else if AT_READ_DEPS then 1 - STEP
                      else if AT_ON then (if STEP < 0 then 0 else if RW_AT[?] + 1 >= RW_LAST[?] then 1 else 0)
                      else if AT_FILTER then (if STEP = 3 then 0 else STEP + 1)
                      else if AT_TICK then TICK_NEXT_STEP
                      else 0
        | FINISH_SUB := NEXT_SUB
        | RW_AT := if RW_HEADER then RW_ITEM_START
                   else if AT_CLOCK and HAS_SETCLOCK[?] then
                     (if STEP < 0 then EQUATION_FINAL_START[?][SETCLOCK_ROW[?]] else if STEP = 0 then RW_AT[?] + 1 else RW_AT[?])
                   else if MOVES_TO_COPY then COPY_RANGE_START
                   else if REST and not REST_COPY then RW_AT[?]
                   else if AT_REWRITE then (if RW_ENTRY_DONE then RW_ENTRY + 1 else RW_ENTRY)
                   else if AT_CUR and STEP = 4 then TRANSITION_FINAL_START[?][WORK_ROW]
                   else if AT_CUR and STEP = 5 then RW_AT[?] + 1
                   else if READ_HEADER then READ_START
                   else if AT_READ then RW_AT[?] + 1
                   else if ON_HEADER then GUARD_FINAL_START[?][GUARD_NOW]
                   else if ON_COPYING then RW_AT[?] + 1
                   else if AT_TICK then
                     (if STEP = TS_EQUATION then TICK_FINAL_START else if STEP = TS_SCAN or STEP = TS_COPY then RW_AT[?] + 1
                      else if STEP = TS_PART and not TICK_TARGET_PART then TICK_ARG_FROM else RW_AT[?])
                   else RW_AT[?]
        | RW_LAST := if RW_HEADER then RW_ITEM_START + RW_ITEM_COUNT
                     else if AT_CLOCK and HAS_SETCLOCK[?] and STEP < 0 then EQUATION_FINAL_END[?][SETCLOCK_ROW[?]]
                     else if MOVES_TO_COPY then COPY_RANGE_END
                     else if AT_CUR and STEP = 4 then TRANSITION_FINAL_END[?][WORK_ROW]
                     else if READ_HEADER then READ_END
                     else if ON_HEADER then GUARD_FINAL_END[?][GUARD_NOW]
                     else if AT_TICK and STEP = TS_EQUATION then TICK_CALL_AT
                     else if AT_TICK and STEP = TS_PART and not TICK_TARGET_PART then TICK_ARG_TO
                     else RW_LAST[?]
        | RW_ITEM_FIRST := if RW_HEADER then RW_ITEM_START else if MOVES_TO_COPY then COPY_RANGE_START else RW_ITEM_FIRST[?]
        | ITEM_BEGIN := if RW_HEADER or ON_HEADER or AT_GROUP and STEP = 0 or AT_FILTER and STEP = 0 or AT_TICK and STEP = TS_LABEL
                           or NEXT_PHASE /= PHASE and (NEXT_PHASE = PHASE_CLOCK or NEXT_PHASE = PHASE_STATE or NEXT_PHASE = PHASE_PICK and AT_STATE)
                        then FINAL_COUNT[?] else ITEM_BEGIN[?]
        | ITEM_ENDS := AT_REWRITE and (RW_HEADER and RW_ITEM_COUNT = 0 or not RW_HEADER and not REST and RW_ITEM_DONE and GOES)
        | ITEM_END_VALUE := FINAL_COUNT[?] + integer(EMITS)
        | ITEM_SLOT_EQUATION := if ITEM_ENDS and PHASE = PHASE_REWRITE_EQ then WORK_ROW else -1
        | ITEM_SLOT_MEMBER := if ITEM_ENDS and PHASE = PHASE_REWRITE_MEMBER then WORK_ROW else -1
        | ITEM_SLOT_GUARD := if ITEM_ENDS and PHASE = PHASE_REWRITE_GUARD then WORK_ROW else -1
        | ITEM_SLOT_TRIGGER := if ITEM_ENDS and PHASE = PHASE_REWRITE_TRIGGER then WORK_ROW else -1
        | ITEM_START_VALUE := if RW_HEADER then FINAL_COUNT[?] else ITEM_BEGIN[?]
        | EQUATION_FINAL_START := EQUATION_FINAL_START[?] next ITEM_SLOT_EQUATION : ITEM_START_VALUE
        | EQUATION_FINAL_END := EQUATION_FINAL_END[?] next ITEM_SLOT_EQUATION : ITEM_END_VALUE
        | MEMBER_FINAL_START := MEMBER_FINAL_START[?] next ITEM_SLOT_MEMBER : ITEM_START_VALUE
        | MEMBER_FINAL_END := MEMBER_FINAL_END[?] next ITEM_SLOT_MEMBER : ITEM_END_VALUE
        | GUARD_FINAL_START := GUARD_FINAL_START[?] next ITEM_SLOT_GUARD : ITEM_START_VALUE
        | GUARD_FINAL_END := GUARD_FINAL_END[?] next ITEM_SLOT_GUARD : ITEM_END_VALUE
        | TRANSITION_FINAL_START := TRANSITION_FINAL_START[?] next ITEM_SLOT_TRIGGER : ITEM_START_VALUE
        | TRANSITION_FINAL_END := TRANSITION_FINAL_END[?] next ITEM_SLOT_TRIGGER : ITEM_END_VALUE
        | LABEL_STAMP := LABEL_STAMP[?] next (if AT_LABEL and not LABELS_DONE then LABEL_NAME[WORK_ROW] else -1) : MODEL_STAMP
        | LABEL_RANK := if AT_START then 0 else if AT_LABEL and not LABELS_DONE then LABEL_RANK[?] + 1 else LABEL_RANK[?]
        | LABEL_ORDINAL := LABEL_ORDINAL[?] next (if AT_LABEL and not LABELS_DONE then LABEL_NAME[WORK_ROW] else -1) : LABEL_RANK[?]
        | LABEL_TICKED := LABEL_TICKED[?] next (if RW_TICKS then RW_NAME_SAFE else -1) : MODEL_STAMP
        | LABEL_TICK_TOKEN := LABEL_TICK_TOKEN[?] next (if RW_TICKS and LABEL_TICKED[?][RW_NAME_SAFE] /= MODEL_STAMP then RW_NAME_SAFE else -1)
                              : ENTRY_TOKEN[RW_ENTRY]
        | OWN_SLOT := if AT_SIGNAL and not SIGNALS_DONE then SIGNAL_NAME[WORK_ROW] else if STATE_ROWS then N_STATE_MARK else -1
        | OWN_STAMP := OWN_STAMP[?] next OWN_SLOT : MODEL_STAMP
        | OWN_TYPE := OWN_TYPE[?] next OWN_SLOT : (if STATE_ROWS then STATE_TYPE_NOW else SIGNAL_TYPE[WORK_ROW])
        | OWN_ROLE := OWN_ROLE[?] next OWN_SLOT : (if STATE_ROWS then ROLE_LOCAL else SIGNAL_ROLE[WORK_ROW])
        | OWN_INIT := OWN_INIT[?] next OWN_SLOT
                      : (if STATE_ROWS or SIGNAL_INIT_KIND[WORK_ROW] = INIT_NONE then 0 else WORK_ROW + 1)
        | INIT_USED := INIT_USED[?] next (if AT_REWRITE and STEP = 0 and RW_DECL_SITE then RW_TARGET else -1) : MODEL_STAMP
        | STATE_SLOT := if REGISTERS_STATE and GOES then ST_STATE else -1
        | STATE_STAMP := STATE_STAMP[?] next STATE_SLOT : MODEL_STAMP
        | STATE_ORDINAL := STATE_ORDINAL[?] next STATE_SLOT : STATE_COUNT[?]
        | STATE_COUNT := if AT_SIGNAL then 0 else STATE_COUNT[?] + integer(STATE_SLOT >= 0)
        | HAS_INITIAL := if AT_SIGNAL then false else HAS_INITIAL[?] or RECORDS_INITIAL
        | HAS_SETCLOCK := if AT_SIGNAL then false else HAS_SETCLOCK[?] or RECORDS_SETCLOCK and GOES
        | SETCLOCK_ROW := if RECORDS_SETCLOCK then WORK_ROW else SETCLOCK_ROW[?]
        | SETCLOCK_TOKEN := if RECORDS_SETCLOCK then ST_TOKEN else SETCLOCK_TOKEN[?]
        | INITIAL_ORDINAL := if RECORDS_INITIAL then ST_ORDINAL else INITIAL_ORDINAL[?]
        | TRANSITION_SOURCE_HELD := if AT_STATEMENT and STEP = 0 then ST_ORDINAL else TRANSITION_SOURCE_HELD[?]
        | TRANSITION_FIRST := if AT_SIGNAL then TRANSITION_COUNT[?] else TRANSITION_FIRST[?]
        | TRANSITION_SLOT := if RECORDS_TRANSITION and GOES then TRANSITION_COUNT[?] else -1
        | TRANSITION_SOURCE := TRANSITION_SOURCE[?] next TRANSITION_SLOT : TRANSITION_SOURCE_HELD[?]
        | TRANSITION_TARGET := TRANSITION_TARGET[?] next TRANSITION_SLOT : ST_ORDINAL
        | TRANSITION_TRIGGER_START := TRANSITION_TRIGGER_START[?] next TRANSITION_SLOT : ST_START + 2
        | TRANSITION_TRIGGER_END := TRANSITION_TRIGGER_END[?] next TRANSITION_SLOT : ST_CALL - ST_PRIORITY_LENGTH
        | TRANSITION_PRIORITY := TRANSITION_PRIORITY[?] next TRANSITION_SLOT : ST_PRIORITY
        | TRANSITION_EMITTED := TRANSITION_EMITTED[?] next (if AT_CUR and STEP = CUR_LAST_SUB then WORK_ROW else -1) : true
        | CUR_BEST := if PICK_TAKES then WORK_ROW else if AT_PICK then CUR_BEST[?] else -1
        | CUR_RANK := if AT_STATE then 0 else if AT_CUR and STEP = CUR_LAST_SUB then CUR_RANK[?] + 1 else CUR_RANK[?]
        | TRANSITION_GUARD := TRANSITION_GUARD[?] next TRANSITION_SLOT
                              : (if EQUATION_GUARDS[WORK_ROW] >= 0 then EQUATION_GUARDS[WORK_ROW] - MODEL_GUARD_START[MODEL_HERE] + 1 else 0)
        | TRANSITION_TOKEN := TRANSITION_TOKEN[?] next TRANSITION_SLOT : ST_TOKEN
        | TRANSITION_COUNT := TRANSITION_COUNT[?] + integer(TRANSITION_SLOT >= 0)
        | SYNTH_COUNT := if NEXT_PHASE = PHASE_CLOCK and PHASE /= PHASE_CLOCK then 0
                         else if AT_CLOCK and not HAS_SETCLOCK[?] and STEP = CLOCK_LAST_SUB then SYNTH_COUNT[?] + 1 else SYNTH_COUNT[?]
        | GUARD_NUMBER := if NEXT_PHASE = PHASE_GUARD_START and PHASE /= PHASE_GUARD_START and PHASE /= PHASE_FILTER
                          then MODEL_GUARD_END[MODEL_HERE] - MODEL_GUARD_START[MODEL_HERE]
                          else if AT_FILTER and FILTER_DONE then GUARD_NUMBER[?] - 1 else GUARD_NUMBER[?]
        | STARTS_GUARD := AT_GUARD_START and GUARD_NUMBER[?] > 0
        | GUARD_STAMP := if STARTS_GUARD then GUARD_STAMP[?] + 1 else GUARD_STAMP[?]
        | CHAIN_START := if STARTS_GUARD then CHAIN_START_NOW else CHAIN_START[?]
        | GUARD_INPUT_START := if STARTS_GUARD then INPUT_COUNT[?] else GUARD_INPUT_START[?]
        | FILTER_ROW_START := FILTER_ROW_START[?] next (if STARTS_GUARD then GUARD_NOW else -1) : FINISH_EQUATION_COUNT[?]
        | DEFINED_STAMP := DEFINED_STAMP[?] next (if DEFINES then DEFINED_KEY else -1) : GUARD_STAMP[?]
        | INPUT_STAMP := INPUT_STAMP[?] next (if NEW_INPUT then READ_KEY else -1) : GUARD_STAMP[?]
        | INPUT_LIST := INPUT_LIST[?] next (if NEW_INPUT and GOES then INPUT_COUNT[?] else -1) : READ_KEY
        | INPUT_COUNT := INPUT_COUNT[?] + integer(NEW_INPUT and GOES)
        | DEPENDENCE_RENAMED_FROM := DEPENDENCE_RENAMED_FROM[?] next (if IS_INPUT and AT_READ_DEPS and STEP = 0 then WORK_ROW else -1)
                                     : RENAMED_KEY + 1
        | DEPENDENCE_RENAMED_TO := DEPENDENCE_RENAMED_TO[?] next (if IS_INPUT and AT_READ_DEPS and STEP = 1 then WORK_ROW else -1)
                                   : RENAMED_KEY + 1
        | FINISH_SIGNAL_SLOT := if (WRITES_ROWS or INDEX_DECLARES) and GOES then FINISH_SIGNAL_COUNT[?] else -1
        | FINISH_SIGNAL_NAME := FINISH_SIGNAL_NAME[?] next FINISH_SIGNAL_SLOT : ROW_KEY
        | FINISH_SIGNAL_TYPE := FINISH_SIGNAL_TYPE[?] next FINISH_SIGNAL_SLOT : ROW_TYPE
        | FINISH_SIGNAL_MODEL := FINISH_SIGNAL_MODEL[?] next FINISH_SIGNAL_SLOT : MODEL_HERE
        | FINISH_SIGNAL_TOKEN := FINISH_SIGNAL_TOKEN[?] next FINISH_SIGNAL_SLOT : ROW_TOKEN
        | FINISH_SIGNAL_ROLE := FINISH_SIGNAL_ROLE[?] next FINISH_SIGNAL_SLOT : (if TEMPLATE_INPUTS then ROLE_INPUT else ROLE_LOCAL)
        | FINISH_SIGNAL_COUNT := FINISH_SIGNAL_COUNT[?] + integer(FINISH_SIGNAL_SLOT >= 0)
        | FINISH_EQUATION_SLOT := if WRITES_ROWS and not TEMPLATE_INPUTS and GOES then FINISH_EQUATION_COUNT[?] else -1
        | FINISH_EQUATION_TARGET := FINISH_EQUATION_TARGET[?] next FINISH_EQUATION_SLOT : ROW_KEY
        | FINISH_EQUATION_FINAL_START := FINISH_EQUATION_FINAL_START[?] next FINISH_EQUATION_SLOT
                                         : (if TEMPLATE_DEFINES then SEGMENT_BEGIN[?] else ITEM_BEGIN[?])
        | FINISH_EQUATION_FINAL_END := FINISH_EQUATION_FINAL_END[?] next FINISH_EQUATION_SLOT : FINAL_COUNT[?]
        | FINISH_EQUATION_TOKEN := FINISH_EQUATION_TOKEN[?] next FINISH_EQUATION_SLOT : ROW_TOKEN
        | FINISH_EQUATION_MODEL := FINISH_EQUATION_MODEL[?] next FINISH_EQUATION_SLOT : MODEL_HERE
        | FINISH_EQUATION_LABELS := FINISH_EQUATION_LABELS[?] next FINISH_EQUATION_SLOT
                                    : (if ON_ROWS or FILTER_ROWS then GUARD_LABELS[GUARD_NOW] else -1)
        | FINISH_EQUATION_GUARDS := FINISH_EQUATION_GUARDS[?] next FINISH_EQUATION_SLOT
                                    : (if ON_ROWS or FILTER_ROWS then GUARD_CONTEXT[GUARD_NOW] else -1)
        | FINISH_EQUATION_COUNT := FINISH_EQUATION_COUNT[?] + integer(FINISH_EQUATION_SLOT >= 0)
        | FINISH_GROUP_SLOT := if (AT_GROUP and STEP = 2 or TEMPLATE_GROUPS) and GOES then FINISH_GROUP_COUNT[?] else -1
        | FINISH_GROUP_MODEL := FINISH_GROUP_MODEL[?] next FINISH_GROUP_SLOT : MODEL_HERE
        | FINISH_GROUP_FINAL := FINISH_GROUP_FINAL[?] next FINISH_GROUP_SLOT : (if TEMPLATE_GROUPS then SEGMENT_BEGIN[?] else ITEM_BEGIN[?])
        | FINISH_GROUP_COUNT := FINISH_GROUP_COUNT[?] + integer(FINISH_GROUP_SLOT >= 0)
        | FINISH_MODEL_ORDINAL := if AT_GUARD_START and GUARD_NUMBER[?] = 0 then CLOSE_RANK + 1 else CLOSE_RANK
        |)
     with (| FINISH_PHASE := PHASE_START | FINISH_MODEL_ORDINAL := 0 | FINISH_ROW := 0 | FINISH_SUB := 0 | GUARD_NUMBER := 0
           | FINAL_COUNT := 0 | RW_AT := 0 | RW_LAST := 0 | RW_ITEM_FIRST := 0 | ITEM_BEGIN := 0 | STATE_COUNT := 0
           | HAS_INITIAL := false | INITIAL_ORDINAL := 0 | TRANSITION_SOURCE_HELD := 0 | TRANSITION_FIRST := 0
           | TRANSITION_COUNT := 0 | SYNTH_COUNT := 0 | GUARD_STAMP := 0 | CHAIN_START := 0 | GUARD_INPUT_START := 0
           | INPUT_COUNT := 0 | FINISH_SIGNAL_COUNT := 0 | FINISH_EQUATION_COUNT := 0 | FINISH_GROUP_COUNT := 0
           | TEMPLATE_PC := -1 | TEMPLATE_AT := -1 | SKIP_FROM := 0 | SEGMENT_BEGIN := 0 | TEMPLATE_ORDINAL := 1
           | ITEM_NONMONO := false | LABEL_RANK := 0 | TICK_USE := 0 | TICK_EQUATION := 0 | TICK_K := 0 | TICK_PARTS := 0
           | TICK_HEIGHT := 0 | HAS_SETCLOCK := false | SETCLOCK_ROW := 0 | SETCLOCK_TOKEN := 0 | CUR_BEST := -1 | CUR_RANK := 0
           | FINISH_MESSAGE := 0 | FINISH_TOKEN := 0 | FINISH_ARGUMENT0 := 0 | FINISH_ARGUMENT1 := 0 | FINISH_ARGUMENT2 := 0 |)
     end
   | SOURCE_TOO_BIG := BUFFER_OK and ERRNO = 0 and not SOURCE_FITS
   | ERROR := if SOURCE_TOO_BIG then ERROR_SRC else LEX_ERROR
   | ERROR_LEAD := SRC[LEX_ERROR_AT]
   | ERROR_MULTIBYTE := ERROR_LEAD >= ubyte(192)
   | ERROR_FIRST_CONTINUES := ERROR_MULTIBYTE and SRC[LEX_ERROR_AT + 1] >= ubyte(128) and SRC[LEX_ERROR_AT + 1] < ubyte(192)
   | ERROR_SECOND_CONTINUES := ERROR_FIRST_CONTINUES and SRC[LEX_ERROR_AT + 2] >= ubyte(128) and SRC[LEX_ERROR_AT + 2] < ubyte(192)
   | ERROR_THIRD_CONTINUES := ERROR_SECOND_CONTINUES and SRC[LEX_ERROR_AT + 3] >= ubyte(128) and SRC[LEX_ERROR_AT + 3] < ubyte(192)
   | ERROR_CHARACTER_LENGTH := 1 + integer(ERROR_FIRST_CONTINUES) + integer(ERROR_SECOND_CONTINUES) + integer(ERROR_THIRD_CONTINUES)
   | FINISHES := PARSES and CLOSED_COUNT > 0 and not PRAGMA_FAILED and not REAL_MPS2 and not VIS_FAILED
   | FINISH_FAILED := FINISHES and FINISH_MESSAGE /= 0
   | FINISH_INCOMPLETE := FINISHES and not FINISH_FAILED and FINISH_PHASE /= PHASE_DONE
   | PARSE_FAILED := PARSES and PARSE_MESSAGE /= 0
   | PARSE_INCOMPLETE := PARSES and not PARSE_FAILED and PARSE_STATE /= P_DONE
   | PASS_MESSAGE := if ERROR = ERROR_UNEXPECTED then T_UNEXPECTED_CHARACTER else if ERROR = ERROR_ESCAPE then T_ESCAPE
                else if ERROR = ERROR_ESCAPE_RANGE then T_ESCAPE_RANGE else if ERROR = ERROR_CHARACTER_COUNT then T_CHARACTER_COUNT
                else if ERROR = ERROR_CHARACTER_RANGE then T_CHARACTER_RANGE else if ERROR /= ERROR_NONE then T_CAPACITY
                else if not TEXT_OK then 0 else if INTERN_ERROR_TOKEN >= 0 or REALS_UNFINISHED then T_CAPACITY else if U_MESSAGE /= 0 then U_MESSAGE
                else if PRESCAN_MESSAGE /= 0 then PRESCAN_MESSAGE else if PRAGMA_FAILED then PRAGMA_MESSAGE
                else if REAL_MPS2 then T_SYSCALL_MPS2
                else if VIS_FAILED then VIS_MESSAGE
                else if FINISH_FAILED then FINISH_MESSAGE
                else if FINISH_INCOMPLETE then T_CAPACITY else if PARSE_FAILED then PARSE_MESSAGE
                else if PARSE_INCOMPLETE then T_CAPACITY else 0
   | MESSAGE_TOKEN := if INTERN_ERROR_TOKEN >= 0 then INTERN_ERROR_TOKEN else if REALS_UNFINISHED then -1 else if U_MESSAGE /= 0 then U_TOKEN
                      else if PRESCAN_MESSAGE /= 0 then PRESCAN_TOKEN
                      else if PRAGMA_FAILED then PRAGMA_MESSAGE_TOKEN else if REAL_MPS2 then FIRST_REAL_TOKEN
                      else if VIS_FAILED then VIS_MESSAGE_TOKEN
                      else if FINISH_FAILED then FINISH_TOKEN else if PARSE_FAILED then PARSE_TOKEN
                      else if INSTANTIATE_FAILED then INSTANTIATE_TOKEN else if LOWER_FAILED then LW_TOKEN
                      else if POST_FAILED then PO_TOKEN else if CLOCK_MESSAGE /= 0 then CLOCK_TOKEN else 0
   | MESSAGE_LINE := if SOURCE_TOO_BIG or MESSAGE_TOKEN < 0 then 1 else if ERROR /= ERROR_NONE then LEX_ERROR_LINE
                     else if INTERN_ERROR_TOKEN >= 0 or U_MESSAGE /= 0 then RAW_TOKEN_LINE[MESSAGE_TOKEN] else TOKEN_LINE[MESSAGE_TOKEN]
   | MESSAGE_COLUMN := if SOURCE_TOO_BIG or MESSAGE_TOKEN < 0 then 1 else if ERROR /= ERROR_NONE then LEX_ERROR_COLUMN
                       else if INTERN_ERROR_TOKEN >= 0 or U_MESSAGE /= 0 then RAW_TOKEN_COLUMN[MESSAGE_TOKEN] else TOKEN_COLUMN[MESSAGE_TOKEN]
   | PASS_ARGUMENT0 := if ERROR = ERROR_UNEXPECTED or ERROR = ERROR_ESCAPE then LEX_ERROR_AT
                          else if ERROR = ERROR_ESCAPE_RANGE then LEX_ERROR_VALUE else if ERROR = ERROR_SRC then F_CAP_SRC
                          else if ERROR = ERROR_TOKENS then F_CAP_TOKENS else if INTERN_ERROR_TOKEN >= 0 then F_CAP_NAMES else if REALS_UNFINISHED then F_CAP_REALS
                          else if U_MESSAGE /= 0 then U_ARGUMENT0
                          else if PRESCAN_MESSAGE /= 0 then PRESCAN_ARGUMENT0 else if PRAGMA_FAILED then PRAGMA_ARGUMENT0
                          else if REAL_MPS2 then FIRST_REAL_TYPE
                          else if VIS_FAILED then VIS_ARGUMENT0
                          else if FINISH_FAILED then FINISH_ARGUMENT0
                          else if FINISH_INCOMPLETE then F_CAP_FINISH else if PARSE_FAILED then PARSE_ARGUMENT0
                          else if PARSE_INCOMPLETE then F_CAP_PARSE else if INSTANTIATE_FAILED then INSTANTIATE_ARGUMENT0
                          else if INSTANTIATE_INCOMPLETE then F_CAP_INSTANTIATE else if LOWER_FAILED then LW_ARGUMENT0
                          else if POST_FAILED then PO_ARGUMENT0 else if EXPAND_FAILED then F_CAP_ROW_DEPENDENCES
                          else if CLOCK_MESSAGE /= 0 then CLOCK_ARGUMENT0 else F_CAP_LOWER
   | MESSAGE_ARGUMENT1 := if U_MESSAGE /= 0 then U_ARGUMENT1 else if PRESCAN_MESSAGE /= 0 then PRESCAN_ARGUMENT1 else if VIS_FAILED then VIS_ARGUMENT1
                          else if FINISH_FAILED then FINISH_ARGUMENT1
                          else if PARSE_FAILED then PARSE_ARGUMENT1 else if LOWER_FAILED then LW_ARGUMENT1
                          else if CLOCK_MESSAGE /= 0 then
                            (if CLOCK_MESSAGE = T_INPUT_SHARED then SIGNAL_NAME[CF_SIGNAL_SOURCE] else 0)
                          else INSTANTIATE_ARGUMENT1
   | MESSAGE_ARGUMENT2 := if U_MESSAGE /= 0 then U_ARGUMENT2 else if FINISH_FAILED then FINISH_ARGUMENT2 else if PARSE_FAILED then PARSE_ARGUMENT2
                          else if LOWER_FAILED then LW_ARGUMENT2 else if CLOCK_MESSAGE /= 0 then SCHEDULE_ARGUMENT2 else INSTANTIATE_ARGUMENT2
   | MESSAGE_INSTANCE := if LOWER_FAILED then LW_INSTANCE else if CLOCK_MESSAGE /= 0 then 0 else PO_INSTANCE
   | INSTANTIATES := (DUMP_PASS = 0 or DUMP_PASS = 3 or DUMP_PASS = 4 or DUMP_PASS = 5 or DUMP_PASS = 6 or DUMP_PASS = 7) and FINISHES and PASS_MESSAGE = 0
   | SPAN_BOUND := long(SIGNAL_COUNT) + long(FINISH_SIGNAL_COUNT) + long(FINISH_EQUATION_COUNT) + long(FINISH_GROUP_COUNT)
                   + long(LOOP_COUNT) + long(MODEL_COUNT) + long(LABEL_COUNT) + long(USE_COUNT) + long(GUARD_COUNT)
                   + long(FINAL_COUNT)
   | SPAN_INDEX := 0 .. (if INSTANTIATES then SPAN_BOUND else long(-1))
   | iterate SPAN_INDEX of
       (| SPAN_SIGNAL_MODEL := SIGNAL_MODEL[SPAN_INDEX]
        | SPAN_ROLE := if SPAN_INDEX < SIGNAL_COUNT then SIGNAL_ROLE[SPAN_INDEX] else ROLE_LOCAL
        | MODEL_INPUT_TOTAL := MODEL_INPUT_TOTAL[?] next (if SPAN_ROLE = ROLE_INPUT then SPAN_SIGNAL_MODEL else -1)
                               : MODEL_INPUT_TOTAL[?][SPAN_SIGNAL_MODEL] + 1
        | MODEL_OUTPUT_TOTAL := MODEL_OUTPUT_TOTAL[?] next (if SPAN_ROLE = ROLE_OUTPUT then SPAN_SIGNAL_MODEL else -1)
                                : MODEL_OUTPUT_TOTAL[?][SPAN_SIGNAL_MODEL] + 1
        | SPAN_FINISH_SIGNAL_MODEL := FINISH_SIGNAL_MODEL[SPAN_INDEX]
        | SPAN_FINISH_SIGNAL_SLOT := if SPAN_INDEX < FINISH_SIGNAL_COUNT then SPAN_FINISH_SIGNAL_MODEL else -1
        | MODEL_FINISH_SIGNAL_START := MODEL_FINISH_SIGNAL_START[?]
                                       next (if SPAN_INDEX = 0 or FINISH_SIGNAL_MODEL[SPAN_INDEX - 1] /= SPAN_FINISH_SIGNAL_MODEL
                                             then SPAN_FINISH_SIGNAL_SLOT else -1)
                                       : SPAN_INDEX
        | MODEL_FINISH_SIGNAL_END := MODEL_FINISH_SIGNAL_END[?] next SPAN_FINISH_SIGNAL_SLOT : SPAN_INDEX + 1
        | SPAN_FINISH_EQUATION_MODEL := FINISH_EQUATION_MODEL[SPAN_INDEX]
        | SPAN_FINISH_EQUATION_SLOT := if SPAN_INDEX < FINISH_EQUATION_COUNT then SPAN_FINISH_EQUATION_MODEL else -1
        | MODEL_FINISH_EQUATION_START := MODEL_FINISH_EQUATION_START[?]
                                         next (if SPAN_INDEX = 0 or FINISH_EQUATION_MODEL[SPAN_INDEX - 1] /= SPAN_FINISH_EQUATION_MODEL
                                               then SPAN_FINISH_EQUATION_SLOT else -1)
                                         : SPAN_INDEX
        | MODEL_FINISH_EQUATION_END := MODEL_FINISH_EQUATION_END[?] next SPAN_FINISH_EQUATION_SLOT : SPAN_INDEX + 1
        | SPAN_FINISH_GROUP_MODEL := FINISH_GROUP_MODEL[SPAN_INDEX]
        | SPAN_FINISH_GROUP_SLOT := if SPAN_INDEX < FINISH_GROUP_COUNT then SPAN_FINISH_GROUP_MODEL else -1
        | MODEL_FINISH_GROUP_START := MODEL_FINISH_GROUP_START[?]
                                      next (if SPAN_INDEX = 0 or FINISH_GROUP_MODEL[SPAN_INDEX - 1] /= SPAN_FINISH_GROUP_MODEL
                                            then SPAN_FINISH_GROUP_SLOT else -1)
                                      : SPAN_INDEX
        | MODEL_FINISH_GROUP_END := MODEL_FINISH_GROUP_END[?] next SPAN_FINISH_GROUP_SLOT : SPAN_INDEX + 1
        | SPAN_LOOP_MODEL := LOOP_MODEL[SPAN_INDEX]
        | SPAN_LOOP_SLOT := if SPAN_INDEX < LOOP_COUNT then SPAN_LOOP_MODEL else -1
        | MODEL_LOOP_START := MODEL_LOOP_START[?]
                              next (if SPAN_INDEX = 0 or LOOP_MODEL[SPAN_INDEX - 1] /= SPAN_LOOP_MODEL then SPAN_LOOP_SLOT else -1)
                              : SPAN_INDEX
        | MODEL_LOOP_END := MODEL_LOOP_END[?] next SPAN_LOOP_SLOT : SPAN_INDEX + 1
        | SPAN_MODEL_NAME := MODEL_NAME[SPAN_INDEX]
        | MODEL_OF_NAME := MODEL_OF_NAME[?]
                           next (if SPAN_INDEX < MODEL_COUNT and MODEL_OF_NAME[?][SPAN_MODEL_NAME] = 0 then SPAN_MODEL_NAME else -1)
                           : SPAN_INDEX + 1
        | SPAN_SIGNAL_SLOT := if SPAN_INDEX < SIGNAL_COUNT then SPAN_SIGNAL_MODEL else -1
        | MODEL_SIGNAL_TOTAL := MODEL_SIGNAL_TOTAL[?] next SPAN_SIGNAL_SLOT : MODEL_SIGNAL_TOTAL[?][SPAN_SIGNAL_MODEL] + 1
        | SPAN_LABEL_MODEL := LABEL_MODEL[SPAN_INDEX]
        | SPAN_LABEL_SLOT := if SPAN_INDEX < LABEL_COUNT then SPAN_LABEL_MODEL else -1
        | MODEL_LABEL_TOTAL := MODEL_LABEL_TOTAL[?] next SPAN_LABEL_SLOT : MODEL_LABEL_TOTAL[?][SPAN_LABEL_MODEL] + 1
        | SPAN_ENTRY_MODEL := FINAL_MODEL[SPAN_INDEX]
        | SPAN_ENTRY_SLOT := if SPAN_INDEX < FINAL_COUNT then SPAN_ENTRY_MODEL else -1
        | MODEL_ENTRY_TOTAL := MODEL_ENTRY_TOTAL[?] next SPAN_ENTRY_SLOT : MODEL_ENTRY_TOTAL[?][SPAN_ENTRY_MODEL] + 1
        | SPAN_CALLS := SPAN_ENTRY_SLOT >= 0 and FINAL_OP[SPAN_INDEX] = OP_CALL
                      and (NAME_MODEL[FINAL_NAME[SPAN_INDEX]] or NAME_MODEL_FORMAL_EVER[FINAL_NAME[SPAN_INDEX]])
        | MODEL_CALL_TOTAL := MODEL_CALL_TOTAL[?] next (if SPAN_CALLS then SPAN_ENTRY_MODEL else -1)
                              : MODEL_CALL_TOTAL[?][SPAN_ENTRY_MODEL] + 1
        | SITE_SLOT := if SPAN_CALLS then SITE_COUNT[?] else -1
        | SITE_CALLER := SITE_CALLER[?] next SITE_SLOT : SPAN_ENTRY_MODEL
        | SITE_NAME := SITE_NAME[?] next SITE_SLOT : FINAL_NAME[SPAN_INDEX]
        | SITE_ANY := SITE_ANY[?] next SITE_SLOT : not NAME_MODEL[FINAL_NAME[SPAN_INDEX]]
        | SITE_COUNT := SITE_COUNT[?] + integer(SITE_SLOT >= 0)
        | USE_PATH_LIMIT := if SPAN_INDEX < USE_COUNT and USE_PATH_LENGTH[SPAN_INDEX] > USE_PATH_LIMIT[?]
                            then USE_PATH_LENGTH[SPAN_INDEX] else USE_PATH_LIMIT[?]
        | GUARD_PATH_LIMIT := if SPAN_INDEX < GUARD_COUNT and GUARD_PATH_LENGTH[SPAN_INDEX] > GUARD_PATH_LIMIT[?]
                              then GUARD_PATH_LENGTH[SPAN_INDEX] else GUARD_PATH_LIMIT[?]
        |)
     with (| SITE_COUNT := 0 | USE_PATH_LIMIT := 0 | GUARD_PATH_LIMIT := 0 |)
     end
   | PATH_LIMIT := USE_PATH_LIMIT + GUARD_PATH_LIMIT + 1
   | RELAX_ROUND_LENGTH := SITE_COUNT + MODEL_COUNT
   | RELAX_BOUND := long(MODEL_COUNT) * long(RELAX_ROUND_LENGTH) - long(1)
   | RELAX_INDEX := 0 .. (if INSTANTIATES then RELAX_BOUND else long(-1))
   | iterate RELAX_INDEX of
       (| RELAX_POSITION := RELAX_AT[?]
        | RELAX_DEPTH := RELAX_ROUND[?]
        | RELAX_SITE_PHASE := RELAX_POSITION < SITE_COUNT
        | RELAX_CALLER := SITE_CALLER[RELAX_POSITION]
        | RELAX_ANY := RELAX_SITE_PHASE and SITE_ANY[RELAX_POSITION]
        | RELAX_CALLEE := if RELAX_ANY then -1 else MODEL_OF_NAME[SITE_NAME[RELAX_POSITION]] - 1
        | CALLER_LEVEL := if RELAX_DEPTH = 0 then integer(RELAX_CALLER = ROOT) else LEVEL_NOW[?][RELAX_CALLER]
        | LEVEL_SUM := LEVEL_NEXT[?][if RELAX_CALLEE >= 0 then RELAX_CALLEE else 0] + CALLER_LEVEL
        | ANY_SUM := (if RELAX_POSITION = 0 then 0 else ANY_LEVEL[?]) + (if RELAX_ANY then CALLER_LEVEL else 0)
        | ANY_LEVEL := if ANY_SUM > INSTANCE_CAP then INSTANCE_CAP else ANY_SUM
        | ANY_NOW := if RELAX_SITE_PHASE or MODEL_IS_TYPE[if RELAX_M >= 0 then RELAX_M else 0] then 0 else ANY_LEVEL[?]
        | RELAX_M := RELAX_POSITION - SITE_COUNT
        | LEVEL_SLOT := if RELAX_SITE_PHASE then RELAX_CALLEE else RELAX_M
        | LEVEL_ARRIVING := LEVEL_NEXT[?][if RELAX_M >= 0 then RELAX_M else 0] + ANY_NOW
        | LEVEL_NEXT := LEVEL_NEXT[?] next LEVEL_SLOT
                        : (if not RELAX_SITE_PHASE then 0 else if LEVEL_SUM > INSTANCE_CAP then INSTANCE_CAP else LEVEL_SUM)
        | MODEL_LEVEL := if RELAX_DEPTH = 0 then integer(RELAX_M = ROOT) else LEVEL_NOW[?][RELAX_M]
        | LEVEL_NOW := LEVEL_NOW[?] next (if RELAX_SITE_PHASE then -1 else RELAX_M)
                       : (if LEVEL_ARRIVING > INSTANCE_CAP then INSTANCE_CAP else LEVEL_ARRIVING)
        | MODEL_ROW_COUNT := MODEL_LABEL_TOTAL[RELAX_M] + MODEL_SIGNAL_TOTAL[RELAX_M]
                             + MODEL_FINISH_SIGNAL_END[RELAX_M] - MODEL_FINISH_SIGNAL_START[RELAX_M]
                             + MODEL_LOOP_END[RELAX_M] - MODEL_LOOP_START[RELAX_M]
                             + MODEL_EQUATION_END[RELAX_M] - MODEL_EQUATION_START[RELAX_M]
                             + MODEL_FINISH_EQUATION_END[RELAX_M] - MODEL_FINISH_EQUATION_START[RELAX_M]
                             + MODEL_GROUP_END[RELAX_M] - MODEL_GROUP_START[RELAX_M]
                             + MODEL_MEMBER_END[RELAX_M] - MODEL_MEMBER_START[RELAX_M]
                             + 3 * (MODEL_FINISH_GROUP_END[RELAX_M] - MODEL_FINISH_GROUP_START[RELAX_M])
                             + MODEL_DEPENDENCE_END[RELAX_M] - MODEL_DEPENDENCE_START[RELAX_M]
                             + MODEL_PARAMETER_END[RELAX_M] - MODEL_PARAMETER_START[RELAX_M] + 1
        | RELAX_CALL_COST := long(RELAX_DEPTH + 2) * long(PATH_LIMIT + 2) + long(9) + long(PARAMETER_ROWS)
                             + long(MODEL_FORMAL_ROWS) * long(SIGNAL_COUNT) + long(TUPLE_COST_MAX)
                             + long(REF_ROWS) * long(SIGNAL_COUNT + RELAX_DEPTH + 2)
        | MODEL_STEP_COST := long(16) + long(3) * long(MODEL_ROW_COUNT) + long(4) * long(MODEL_ENTRY_TOTAL[RELAX_M])
                             + long(MODEL_CALL_TOTAL[RELAX_M]) * RELAX_CALL_COST
        | WORK_BOUND := WORK_BOUND[?] + (if RELAX_SITE_PHASE then long(0) else long(MODEL_LEVEL) * MODEL_STEP_COST)
        | RELAX_ENDS_ROUND := RELAX_POSITION + 1 = RELAX_ROUND_LENGTH
        | RELAX_AT := if RELAX_ENDS_ROUND then 0 else RELAX_POSITION + 1
        | RELAX_ROUND := RELAX_DEPTH + integer(RELAX_ENDS_ROUND)
        |)
     with (| RELAX_AT := 0 | RELAX_ROUND := 0 | WORK_BOUND := long(0) | ANY_LEVEL := 0 |)
     end
   | INSTANTIATE_BOUND := long(64) + WORK_BOUND
   | INSTANTIATE_INDEX := 0 .. (if INSTANTIATES then INSTANTIATE_BOUND else long(-1))
   | iterate INSTANTIATE_INDEX of
       (| IP_NOW := IP_STATE[?]
        | INST := INSTANCE_AT[?]
        | INST_MODEL := INSTANCE_MODEL[?][INST]
        | INST_MARK := INST + 1
        | ROW_NOW := ROW_CURSOR[?]
        | MEMBER_ORDINAL := MEMBER_CURSOR[?]
        | AT_IP_ROOT := IP_NOW = IP_ROOT
        | AT_IP_INSTANCE := IP_NOW = IP_INSTANCE
        | AT_IP_LABEL := IP_NOW = IP_LABEL
        | AT_IP_SIGNAL := IP_NOW = IP_SIGNAL
        | AT_IP_FINISH_SIGNAL := IP_NOW = IP_FINISH_SIGNAL
        | AT_IP_LOOP := IP_NOW = IP_LOOP
        | AT_IP_EQUATION := IP_NOW = IP_EQUATION
        | AT_IP_FINISH_EQUATION := IP_NOW = IP_FINISH_EQUATION
        | AT_IP_GROUP := IP_NOW = IP_GROUP
        | AT_IP_FINISH_GROUP := IP_NOW = IP_FINISH_GROUP
        | AT_IP_DEPENDENCE := IP_NOW = IP_DEPENDENCE
        | AT_IP_ENTRY := IP_NOW = IP_ENTRY
        | AT_IP_ANCESTRY := IP_NOW = IP_ANCESTRY
        | AT_IP_PATH := IP_NOW = IP_PATH
        | AT_IP_INPUT := IP_NOW = IP_INPUT
        | AT_IP_EMIT := IP_NOW = IP_EMIT
        | AT_IP_SLOT := IP_NOW = IP_SLOT
        | AT_IP_BIND := IP_NOW = IP_BIND
        | AT_IP_OUTPUTS := IP_NOW = IP_OUTPUTS
        | SLOT_LIVE := AT_IP_SLOT and ROW_NOW < MODEL_PARAMETER_END[INST_MODEL]
        | INSTANCES_DONE := INST >= INSTANCE_TOTAL[?]
        | LABEL_LIVE := AT_IP_LABEL and ROW_NOW >= 0
        | PARSE_SIGNAL_LIVE := AT_IP_SIGNAL and ROW_NOW >= 0
        | FINISH_SIGNAL_LIVE := AT_IP_FINISH_SIGNAL and ROW_NOW < MODEL_FINISH_SIGNAL_END[INST_MODEL]
        | SIGNAL_WANTED := PARSE_SIGNAL_LIVE or FINISH_SIGNAL_LIVE
        | SIGNAL_KEY_NOW := if PARSE_SIGNAL_LIVE then SIGNAL_NAME[ROW_NOW] else FINISH_SIGNAL_NAME[ROW_NOW]
        | LOOP_LIVE := AT_IP_LOOP and ROW_NOW < MODEL_LOOP_END[INST_MODEL]
        | EQUATION_LIVE := AT_IP_EQUATION and ROW_NOW < MODEL_EQUATION_END[INST_MODEL]
        | EQUATION_SKIPS := EQUATION_LIVE and EQUATION_STATEMENT[ROW_NOW]
        | SELECTS_PARSE_EQUATION := EQUATION_LIVE and not EQUATION_STATEMENT[ROW_NOW]
        | SELECTS_FINISH_EQUATION := AT_IP_FINISH_EQUATION and ROW_NOW < MODEL_FINISH_EQUATION_END[INST_MODEL]
        | SELECTS_EQUATION := SELECTS_PARSE_EQUATION or SELECTS_FINISH_EQUATION
        | PARSE_GROUP_LIVE := AT_IP_GROUP and ROW_NOW < MODEL_GROUP_END[INST_MODEL]
        | FINISH_GROUP_LIVE := AT_IP_FINISH_GROUP and ROW_NOW < MODEL_FINISH_GROUP_END[INST_MODEL]
        | GROUP_MEMBER_COUNT := if AT_IP_GROUP then GROUP_MEMBER_TOTAL[ROW_NOW] else 2
        | SELECTS_MEMBER := (PARSE_GROUP_LIVE or FINISH_GROUP_LIVE) and MEMBER_ORDINAL < GROUP_MEMBER_COUNT
        | GROUP_ADVANCES := (PARSE_GROUP_LIVE or FINISH_GROUP_LIVE) and not SELECTS_MEMBER
        | SELECTS := SELECTS_EQUATION or SELECTS_MEMBER
        | SELECT_TARGET := if SELECTS_PARSE_EQUATION then EQUATION_TARGET[ROW_NOW] else FINISH_EQUATION_TARGET[ROW_NOW]
        | SELECT_SEED := SELECTS_PARSE_EQUATION and EQUATION_SEED[ROW_NOW]
        | SELECT_TOKEN := if SELECTS_PARSE_EQUATION then EQUATION_POSITION[ROW_NOW] else FINISH_EQUATION_TOKEN[ROW_NOW]
        | SELECT_MEMBER_ROW := GROUP_MEMBER_FIRST[ROW_NOW] + MEMBER_ORDINAL
        | DEPENDENCE_LIVE := AT_IP_DEPENDENCE and ROW_NOW < MODEL_DEPENDENCE_END[INST_MODEL]
        | FROM_KEY := if DEPENDENCE_RENAMED_FROM[ROW_NOW] > 0 then DEPENDENCE_RENAMED_FROM[ROW_NOW] - 1 else DEPENDENCE_FROM_NAME[ROW_NOW]
        | TO_KEY := if DEPENDENCE_RENAMED_TO[ROW_NOW] > 0 then DEPENDENCE_RENAMED_TO[ROW_NOW] - 1 else DEPENDENCE_TO_NAME[ROW_NOW]
        | E := ENTRY_CURSOR[?]
        | POSTFIX_END_NOW := POSTFIX_END[?]
        | ENTRY_LIVE := AT_IP_ENTRY and E < POSTFIX_END_NOW
        | E_OP := FINAL_OP[E]
        | E_NAME := FINAL_NAME[E]
        | E_TOKEN := FINAL_TOKEN[E]
        | E_COUNT := integer(FINAL_VALUE[E])
        | E_PARAMS := FINAL_AUX2[E]
        | E_IS_LEAF := E_OP = OP_SIGNAL or E_OP = OP_CONST or E_OP = OP_ENUMCONST
        | E_IS_CALL := E_OP = OP_CALL
        | E_ARITY := if E_IS_CALL then E_COUNT else OP_ARITY[E_OP]
        | CHECK_KEY := if AT_IP_LOOP then LOOP_NAME[ROW_NOW] else if AT_IP_DEPENDENCE then FROM_KEY
                       else if SELECTS_EQUATION then SELECT_TARGET else if OUTPUT_ROW then OUTPUT_TARGET else E_NAME
        | CHECK_OWNED := CHECK_KEY >= NAME_CAP or OWNED_MARK[?][CHECK_KEY] = INST_MARK
        | CHECK_LABELED := LABELED_MARK[?][CHECK_KEY] = INST_MARK
        | TO_OWNED := TO_KEY >= NAME_CAP or OWNED_MARK[?][TO_KEY] = INST_MARK
        | TO_LABELED := LABELED_MARK[?][TO_KEY] = INST_MARK
        | LOOP_FAILS := LOOP_LIVE and not CHECK_OWNED
        | TARGET_DEFINED := SELECTS_EQUATION and SELECT_TARGET >= 0 and not SELECT_SEED or OUTPUT_ROW
        | TARGET_FAILS := TARGET_DEFINED and not CHECK_OWNED
        | CHECK_SLOT := if CHECK_KEY >= 0 and CHECK_KEY < NAME_CAP and CHECK_OWNED then SLOT_MARK[?][CHECK_KEY] else 0
        | SLOT_TARGET_FAILS := TARGET_DEFINED and CHECK_SLOT > 0
        | SIGNAL_CHECKED := ENTRY_LIVE and E_OP = OP_SIGNAL
        | SIGNAL_LABEL_FAILS := SIGNAL_CHECKED and not CHECK_OWNED and CHECK_LABELED
        | SIGNAL_UNDECLARED_FAILS := SIGNAL_CHECKED and not CHECK_OWNED and not CHECK_LABELED and NAME_CONSTANT[E_NAME] <= 0
        | E_IS_CASE_VALUE := (FINAL_OP[E + 1] = OP_EQ or FINAL_OP[E + 1] = OP_NE) and FINAL_TOKEN[E + 1] = E_TOKEN
        | CASE_VALUE_FAILS := SIGNAL_CHECKED and CHECK_OWNED and CHECK_SLOT = 0 and E_IS_CASE_VALUE
        | E_IS_SLOT := SIGNAL_CHECKED and CHECK_SLOT > 0
        | E_SLOT_KIND := if E_IS_SLOT then PARAMETER_KIND[MODEL_PARAMETER_START[INST_MODEL] + CHECK_SLOT - 1] else PK_VALUE
        | E_IS_REF := E_IS_SLOT and E_SLOT_KIND = PK_SIGNAL
        | SLOT_VALUE_FAILS := E_IS_SLOT and E_SLOT_KIND /= PK_VALUE and not E_IS_REF
        | CALL_LIVE := ENTRY_LIVE and E_IS_CALL
        | AS_PROCESS := POSTFIX_TARGET[?] < 0 and not POSTFIX_IS_MEMBER[?] and E = POSTFIX_END_NOW - 1
        | CALLS_TYPE := E_NAME < BUILTIN_TYPE_COUNT or NAME_TYPE[E_NAME] > 0 or NAME_ALIAS[E_NAME] > 0 or E_NAME = N_INDICES
        | CALLS_BUILTIN := not CALLS_TYPE and E_NAME >= N_LOAD and E_NAME <= N_WRITE_STRING
        | TYPE_CALL_LIVE := CALL_LIVE and CALLS_TYPE
        | TYPE_PROCESS_FAILS := TYPE_CALL_LIVE and AS_PROCESS
        | TYPE_SHAPE_FAILS := TYPE_CALL_LIVE and (E_COUNT /= 1 or E_PARAMS /= 0)
        | BUILTIN_LIVE := CALL_LIVE and CALLS_BUILTIN
        | BUILTIN_INPUTS := if E_NAME = N_STORE or E_NAME = N_WRITE then 2 else if E_NAME = N_SYSCALL then 7 else 1
        | BUILTIN_HAS_OUTPUT := E_NAME /= N_STORE and E_NAME /= N_WRITE and E_NAME /= N_WRITE_STRING
        | CALL_FLAT_LOOP := if POSTFIX_LOOP[?] >= 0 then FLAT_LOOP_OF[?][POSTFIX_LOOP[?]] else INSTANCE_LOOP[?][INST]
        | BUILTIN_ITERATE_FAILS := BUILTIN_LIVE and CALL_FLAT_LOOP >= 0
                                   and (POSTFIX_SEED[?] or E_NAME /= N_LOAD and E_NAME /= N_STORE)
        | BUILTIN_COUNT_FAILS := BUILTIN_LIVE and E_COUNT /= BUILTIN_INPUTS
        | BUILTIN_PROCESS_FAILS := BUILTIN_LIVE and AS_PROCESS and BUILTIN_HAS_OUTPUT
        | BUILTIN_EXPRESSION_FAILS := BUILTIN_LIVE and not AS_PROCESS and not BUILTIN_HAS_OUTPUT
        | PURE_INSTANCE := INSTANCE_PURE[?][INST]
        | PURE_MODEL := INSTANCE_MODEL[?][PURE_INSTANCE]
        | BUILTIN_UNSAFE_FAILS := BUILTIN_LIVE and PURE_INSTANCE >= 0
        | MODEL_CALL_LIVE := CALL_LIVE and not CALLS_TYPE and not CALLS_BUILTIN
        | CALL_SLOT := if E_IS_CALL and E_NAME >= 0 and E_NAME < NAME_CAP and OWNED_MARK[?][E_NAME] = INST_MARK
                       then SLOT_MARK[?][E_NAME] else 0
        | CALLEE := if CALL_SLOT > 0 then BIND_MODEL[?][INSTANCE_BIND_START[?][INST] + CALL_SLOT - 1] else MODEL_OF_NAME[E_NAME] - 1
        | CALLEE_UNDECLARED_FAILS := MODEL_CALL_LIVE and CALLEE < 0
        | MODEL_TYPE_CALL_FAILS := MODEL_CALL_LIVE and CALLEE >= 0 and MODEL_IS_TYPE[if CALLEE >= 0 then CALLEE else 0]
        | CALLEE_SAFE := if CALLEE >= 0 then CALLEE else 0
        | CALLEE_FORMALS := MODEL_FORMAL_END[CALLEE_SAFE] - MODEL_PARAMETER_START[CALLEE_SAFE]
        | CALLEE_PARAMS_FAILS := MODEL_CALL_LIVE and CALLEE >= 0 and E_PARAMS /= CALLEE_FORMALS
        | ROOT_FORMALS := MODEL_FORMAL_END[ROOT] - MODEL_PARAMETER_START[ROOT]
        | ROOT_PARAMS_FAILS := AT_IP_ROOT and ROOT_FORMALS > 0
        | ROOT_REFS_FAILS := AT_IP_ROOT and MODEL_PARAMETER_END[ROOT] > MODEL_FORMAL_END[ROOT]
        | CALLEE_SLOTS := MODEL_PARAMETER_END[CALLEE_SAFE] - MODEL_PARAMETER_START[CALLEE_SAFE]
        | BIND_K := BIND_CURSOR[?]
        | BIND_LIVE := AT_IP_BIND and BIND_K < CALLEE_FORMALS
        | BIND_REF_LIVE := AT_IP_BIND and BIND_K >= CALLEE_FORMALS and BIND_K < CALLEE_SLOTS
        | REF_AT := REF_ANCESTOR[?]
        | REF_ROW_NOW := REF_ROW[?]
        | REF_ROW_SAFE := if REF_ROW_NOW >= 0 then REF_ROW_NOW else 0
        | REF_NAME_NOW := PARAMETER_NAME[MODEL_PARAMETER_START[CALLEE_SAFE] + BIND_K]
        | REF_UNDECLARED_FAILS := BIND_REF_LIVE and REF_AT < 0
        | REF_FOUND := BIND_REF_LIVE and REF_AT >= 0 and REF_ROW_NOW >= 0 and SIGNAL_NAME[REF_ROW_SAFE] = REF_NAME_NOW
        | REF_PARENT := if REF_AT >= 0 then INSTANCE_PARENT[?][if REF_AT >= 0 then REF_AT else 0] else -1
        | REF_PARENT_FIRST := if REF_PARENT >= 0 then MODEL_FIRST_SIGNAL[INSTANCE_MODEL[?][if REF_PARENT >= 0 then REF_PARENT else 0]] - 1 else -1
        | BIND_AT := FINAL_AUX[E] + 2 * BIND_K
        | BIND_KEY := TOKEN_NAME[BIND_AT] - 1
        | BIND_KEY_SAFE := if BIND_KEY >= 0 then BIND_KEY else 0
        | BIND_IS_NUMBER := integer(TOKEN_CODE[BIND_AT]) = C_NUMBER
        | BIND_IS_FORMAL := BIND_KEY >= 0 and OWNED_MARK[?][BIND_KEY_SAFE] = INST_MARK and SLOT_MARK[?][BIND_KEY_SAFE] > 0
        | BIND_FROM := INSTANCE_BIND_START[?][INST] + SLOT_MARK[?][BIND_KEY_SAFE] - 1
        | BIND_FROM_SAFE := if BIND_IS_FORMAL then BIND_FROM else 0
        | BIND_CONSTANT := if BIND_KEY >= 0 then NAME_CONSTANT[BIND_KEY_SAFE] - 1 else -1
        | BIND_CONSTANT_SAFE := if BIND_CONSTANT >= 0 then BIND_CONSTANT else 0
        | BIND_TYPE_KEY := if BIND_KEY < 0 then -1 else if BIND_KEY < BUILTIN_TYPE_COUNT then BIND_KEY
                           else if NAME_TYPE[BIND_KEY_SAFE] > 0 then NAME_TYPE[BIND_KEY_SAFE] - 1 else NAME_ALIAS[BIND_KEY_SAFE] - 1
        | BIND_MODEL_KEY := if BIND_KEY >= 0 then MODEL_OF_NAME[BIND_KEY_SAFE] - 1 else -1
        | BIND_MODEL_SAFE := if BIND_MODEL_KEY >= 0 then BIND_MODEL_KEY else 0
        | BIND_FOUND_KIND := if BIND_IS_FORMAL then BIND_KIND[?][BIND_FROM_SAFE]
                             else if BIND_IS_NUMBER or BIND_CONSTANT >= 0 then PK_VALUE
                             else if BIND_TYPE_KEY >= 0 then PK_TYPE
                             else if BIND_MODEL_KEY >= 0 then (if MODEL_IS_TYPE[BIND_MODEL_SAFE] then PK_TYPE else PK_MODEL) else -1
        | BIND_MODEL_NOW := if BIND_IS_FORMAL then BIND_MODEL[?][BIND_FROM_SAFE] else BIND_MODEL_KEY
        | BIND_ACTUAL_MODEL := if BIND_MODEL_NOW >= 0 then BIND_MODEL_NOW else 0
        | BIND_TYPE_MODEL := if BIND_LIVE and PARAMETER_MODEL[BIND_SLOT_ROW] >= 0 then PARAMETER_MODEL[BIND_SLOT_ROW] else 0
        | BIND_IS_MODEL := BIND_LIVE and BIND_EXPECTED = PK_MODEL and BIND_FOUND_KIND = PK_MODEL
        | BIND_MODEL_FORMALS_FAILS := BIND_IS_MODEL
                                      and MODEL_FORMAL_END[BIND_ACTUAL_MODEL] > MODEL_PARAMETER_START[BIND_ACTUAL_MODEL]
        | BIND_TYPE_KIND := MODEL_KIND[BIND_TYPE_MODEL]
        | BIND_ACTUAL_KIND := MODEL_KIND[BIND_ACTUAL_MODEL]
        | BIND_CLASS_OK := BIND_ACTUAL_KIND = BIND_TYPE_KIND or BIND_TYPE_KIND = C_PROCESS
                           or BIND_TYPE_KIND = C_NODE and BIND_ACTUAL_KIND = C_FUNCTION
        | BIND_TYPE_SIZE := MODEL_INPUT_TOTAL[BIND_TYPE_MODEL] + MODEL_OUTPUT_TOTAL[BIND_TYPE_MODEL]
        | BIND_SHAPE_FAILS := BIND_IS_MODEL and not BIND_MODEL_FORMALS_FAILS
                              and (not BIND_CLASS_OK or MODEL_INPUT_TOTAL[BIND_ACTUAL_MODEL] /= MODEL_INPUT_TOTAL[BIND_TYPE_MODEL]
                                   or MODEL_OUTPUT_TOTAL[BIND_ACTUAL_MODEL] /= MODEL_OUTPUT_TOTAL[BIND_TYPE_MODEL])
        | BIND_SIG := BIND_SIG_CURSOR[?]
        | BIND_SIG_LIVE := BIND_IS_MODEL and not BIND_MODEL_FORMALS_FAILS and not BIND_SHAPE_FAILS and BIND_SIG < BIND_TYPE_SIZE
        | BIND_SIG_FAILS := BIND_SIG_LIVE and SIGNAL_TYPE[MODEL_SIGNAL_START[BIND_ACTUAL_MODEL] + BIND_SIG]
                                              /= SIGNAL_TYPE[MODEL_SIGNAL_START[BIND_TYPE_MODEL] + BIND_SIG]
        | BIND_INTERFACE_FAILS := BIND_SHAPE_FAILS or BIND_SIG_FAILS
        | BIND_SLOT_ROW := MODEL_PARAMETER_START[CALLEE_SAFE] + BIND_K
        | BIND_EXPECTED := PARAMETER_KIND[BIND_SLOT_ROW]
        | BIND_NUMBER := TOKEN_VALUE[BIND_AT]
        | BIND_VALUE_TYPE := if BIND_IS_FORMAL then BIND_TYPE[?][BIND_FROM_SAFE]
                             else if BIND_IS_NUMBER then
                               (if BIND_NUMBER < long(32768) then BUILTIN_SHORT
                                else if BIND_NUMBER < long(2147483648) then BUILTIN_INTEGER else BUILTIN_LONG)
                             else if BIND_CONSTANT >= 0 then CONSTANT_TYPE[BIND_CONSTANT_SAFE] else BIND_TYPE_KEY
        | BIND_VALUE_NOW := if BIND_IS_FORMAL then BIND_VALUE[?][BIND_FROM_SAFE] else if BIND_IS_NUMBER then BIND_NUMBER
                            else if BIND_CONSTANT >= 0 then CONSTANT_VALUE[BIND_CONSTANT_SAFE] else long(0)
        | BIND_FORMAL_TYPE := PARAMETER_TYPE[BIND_SLOT_ROW]
        | BIND_ACTUAL_INT := BIND_VALUE_TYPE >= BUILTIN_SHORT and BIND_VALUE_TYPE <= BUILTIN_ULONG
        | BIND_FORMAL_INT := BIND_FORMAL_TYPE >= BUILTIN_SHORT and BIND_FORMAL_TYPE <= BUILTIN_ULONG
        | BIND_ACTUAL_SAFE := if BIND_ACTUAL_INT then BIND_VALUE_TYPE else BUILTIN_SHORT
        | BIND_FORMAL_SAFE := if BIND_FORMAL_INT then BIND_FORMAL_TYPE else BUILTIN_SHORT
        | BIND_SUBTYPE := BIND_VALUE_TYPE = BIND_FORMAL_TYPE
                          or BIND_ACTUAL_INT and BIND_FORMAL_INT
                             and (BUILTIN_SIGNED[BIND_ACTUAL_SAFE] = BUILTIN_SIGNED[BIND_FORMAL_SAFE]
                                  and BUILTIN_BYTES[BIND_ACTUAL_SAFE] <= BUILTIN_BYTES[BIND_FORMAL_SAFE]
                                  or BUILTIN_SIGNED[BIND_ACTUAL_SAFE] = 0 and BUILTIN_SIGNED[BIND_FORMAL_SAFE] = 1
                                     and BUILTIN_BYTES[BIND_FORMAL_SAFE] > BUILTIN_BYTES[BIND_ACTUAL_SAFE])
        | BIND_BIG_FAILS := BIND_LIVE and BIND_IS_NUMBER and TOKEN_BIG[BIND_AT]
        | BIND_UNDECLARED_FAILS := BIND_LIVE and BIND_FOUND_KIND < 0
        | BIND_KIND_FAILS := BIND_LIVE and BIND_FOUND_KIND >= 0 and BIND_FOUND_KIND /= BIND_EXPECTED
        | BIND_TYPE_FAILS := BIND_LIVE and BIND_FOUND_KIND = PK_VALUE and BIND_EXPECTED = PK_VALUE and not BIND_SUBTYPE
        | BIND_ARRAY_FAILS := BIND_LIVE and BIND_FOUND_KIND = PK_TYPE and BIND_EXPECTED = PK_TYPE and not BIND_IS_FORMAL
                            and TYPE_KIND[if BIND_TYPE_KEY >= 0 then BIND_TYPE_KEY else 0] = TK_ARRAY
        | BIND_FAILS := BIND_BIG_FAILS or BIND_UNDECLARED_FAILS or BIND_KIND_FAILS or BIND_TYPE_FAILS or BIND_ARRAY_FAILS
                        or BIND_MODEL_FORMALS_FAILS or BIND_INTERFACE_FAILS
        | CALLEE_SEED_FAILS := MODEL_CALL_LIVE and CALL_FLAT_LOOP >= 0 and POSTFIX_SEED[?]
        | CALLEE_STATE_FAILS := MODEL_CALL_LIVE and CALL_FLAT_LOOP >= 0 and not POSTFIX_SEED[?]
                                and (CALLEE_KIND /= C_FUNCTION or MODEL_LOOP_END[CALLEE] > MODEL_LOOP_START[CALLEE])
        | CALLEE_ITERATE_FAILS := CALLEE_SEED_FAILS or CALLEE_STATE_FAILS
        | STARTS_ANCESTRY := MODEL_CALL_LIVE and not CALLEE_UNDECLARED_FAILS and not CALLEE_PARAMS_FAILS and not MODEL_TYPE_CALL_FAILS
                             and not CALLEE_ITERATE_FAILS
        | WALKER := ANCESTOR_CURSOR[?]
        | ANCESTRY_PASSES := AT_IP_ANCESTRY and WALKER < 0
        | SELF_CALL_FAILS := AT_IP_ANCESTRY and WALKER >= 0 and INSTANCE_MODEL[?][WALKER] = CALLEE
        | CALLEE_INPUTS := MODEL_INPUT_TOTAL[CALLEE]
        | CALLEE_OUTPUTS := MODEL_OUTPUT_TOTAL[CALLEE]
        | CALLEE_FIRST_SIGNAL := MODEL_SIGNAL_START[CALLEE]
        | CALLEE_OUTPUT_KEY := SIGNAL_NAME[CALLEE_FIRST_SIGNAL + CALLEE_INPUTS]
        | CALLEE_KIND := MODEL_KIND[CALLEE]
        | CALLEE_COUNT_FAILS := ANCESTRY_PASSES and E_COUNT /= CALLEE_INPUTS
        | CALL_NAMES := if E = POSTFIX_END_NOW - 1 and POSTFIX_TUPLE_ARITY[?] > 1 then POSTFIX_TUPLE_ARITY[?] else 1
        | CALLEE_OUTPUTS_FAILS := ANCESTRY_PASSES and (CALLEE_OUTPUTS >= 2 or CALL_NAMES >= 2) and CALL_NAMES /= CALLEE_OUTPUTS
        | BUILTIN_NAMES_FAILS := (TYPE_CALL_LIVE or BUILTIN_LIVE) and CALL_NAMES >= 2
        | OUTPUT_K := OUTPUT_CURSOR[?]
        | OUTPUT_I := OUTPUT_INPUT_CURSOR[?]
        | OUTPUT_DEPENDENCES := if CALLEE_ORDERED then CALLEE_INPUTS else 0
        | OUTPUTS_LIVE := AT_IP_OUTPUTS and OUTPUT_K < CALL_NAMES
        | OUTPUT_ELEMENT := TUPLE_ELEMENT_ROW[POSTFIX_TUPLE_START[?] + OUTPUT_K]
        | OUTPUT_ROW := OUTPUTS_LIVE and OUTPUT_I = 0 and not OUTPUT_ELEMENT
        | OUTPUT_DEPENDENCE := OUTPUTS_LIVE and OUTPUT_I > 0 and not OUTPUT_ELEMENT
        | OUTPUT_TARGET_TOKEN := TUPLE_TOKEN_ROW[POSTFIX_TUPLE_START[?] + OUTPUT_K]
        | OUTPUT_TARGET := TUPLE_NAME_ROW[POSTFIX_TUPLE_START[?] + OUTPUT_K]
        | OUTPUT_KEY := SIGNAL_NAME[CALLEE_FIRST_SIGNAL + CALLEE_INPUTS + OUTPUT_K]
        | OUTPUT_INPUT_KEY := SIGNAL_NAME[CALLEE_FIRST_SIGNAL + (if OUTPUT_I > 0 then OUTPUT_I - 1 else 0)]
        | CALLEE_PROCESS_FAILS := ANCESTRY_PASSES and AS_PROCESS and CALLEE_OUTPUTS > 0
        | CALLEE_EXPRESSION_FAILS := ANCESTRY_PASSES and not AS_PROCESS and CALLEE_OUTPUTS = 0
        | FUNCTION_CALL_FAILS := ANCESTRY_PASSES and MODEL_KIND[INST_MODEL] = C_FUNCTION and CALLEE_KIND /= C_FUNCTION
        | ATTRIBUTE_CALL_FAILS := ANCESTRY_PASSES and MODEL_ATTRIBUTE[CALLEE] > MODEL_ATTRIBUTE[INST_MODEL]
        | ACTION_UNLABELLED_FAILS := ANCESTRY_PASSES and CALLEE_KIND = C_ACTION and POSTFIX_LABEL_LENGTH = 0 and CALLER_LABEL_LENGTH = 0
        | FROM_FAILS := DEPENDENCE_LIVE and not CHECK_OWNED and not CHECK_LABELED
        | TO_FAILS := DEPENDENCE_LIVE and not TO_OWNED and not TO_LABELED
        | CALL_LABEL_ADDED := not POSTFIX_IS_MEMBER[?] and POSTFIX_TARGET[?] >= 0 and not POSTFIX_SEED[?]
        | CALLER_LABEL_START := INSTANCE_LABEL_START[?][INST]
        | CALLER_LABEL_LENGTH := INSTANCE_LABEL_LENGTH[?][INST]
        | CALLER_GUARD_START := INSTANCE_GUARD_START[?][INST]
        | CALLER_GUARD_LENGTH := INSTANCE_GUARD_LENGTH[?][INST]
        | POSTFIX_LABEL_NODE := POSTFIX_LABELS[?]
        | POSTFIX_GUARD_NODE := POSTFIX_GUARDS[?]
        | POSTFIX_LABEL_LENGTH := if POSTFIX_LABEL_NODE < 0 then 0 else USE_PATH_LENGTH[POSTFIX_LABEL_NODE]
        | POSTFIX_GUARD_LENGTH := if POSTFIX_GUARD_NODE < 0 then 0 else GUARD_PATH_LENGTH[POSTFIX_GUARD_NODE]
        | NEW_LABEL_LENGTH := CALLER_LABEL_LENGTH + POSTFIX_LABEL_LENGTH + integer(CALL_LABEL_ADDED)
        | NEW_GUARD_LENGTH := CALLER_GUARD_LENGTH + POSTFIX_GUARD_LENGTH
        | PATH_K := PATH_STEP[?]
        | PATH_NEW := CALL_INSTANCE[?]
        | PATH_LABEL_TOTAL := INSTANCE_LABEL_LENGTH[?][PATH_NEW]
        | PATH_LIVE := AT_IP_PATH and PATH_K < PATH_LABEL_TOTAL + INSTANCE_GUARD_LENGTH[?][PATH_NEW]
        | IN_LABEL_PART := PATH_K < PATH_LABEL_TOTAL
        | PART_K := if IN_LABEL_PART then PATH_K else PATH_K - PATH_LABEL_TOTAL
        | PART_INHERITED := if IN_LABEL_PART then CALLER_LABEL_LENGTH else CALLER_GUARD_LENGTH
        | PART_INHERITED_AT := (if IN_LABEL_PART then CALLER_LABEL_START else CALLER_GUARD_START) + PART_K
        | PART_NODE_LENGTH := if IN_LABEL_PART then POSTFIX_LABEL_LENGTH else POSTFIX_GUARD_LENGTH
        | FROM_INHERITED := PART_K < PART_INHERITED
        | FROM_NODE := not FROM_INHERITED and PART_K < PART_INHERITED + PART_NODE_LENGTH
        | NODE_VALUE := PATH_VALUE[(if IN_LABEL_PART then USE_PATH_START[POSTFIX_LABEL_NODE] else GUARD_PATH_START[POSTFIX_GUARD_NODE])
                                   + PART_K - PART_INHERITED]
        | NODE_GUARD_KEY := N_ON_MARK + (NODE_VALUE - MODEL_GUARD_START[GUARD_MODEL[NODE_VALUE]] + 1) * NAME_CAP
        | PATH_KEY_NOW := if FROM_INHERITED then FLAT_PATH_KEY[?][PART_INHERITED_AT]
                          else if FROM_NODE then (if IN_LABEL_PART then NODE_VALUE else NODE_GUARD_KEY) else POSTFIX_TARGET[?]
        | PATH_INSTANCE_NOW := if FROM_INHERITED then FLAT_PATH_INSTANCE[?][PART_INHERITED_AT] else INST
        | PATH_CALL_NOW := if FROM_INHERITED then FLAT_PATH_CALL[?][PART_INHERITED_AT] else not FROM_NODE
        | INPUT_I := INPUT_CURSOR[?]
        | OPERAND_BASE := START_TOP[?] - E_ARITY
        | SEGMENT_FROM := START_STACK[?][OPERAND_BASE + INPUT_I]
        | SEGMENT_TO := if INPUT_I + 1 < E_ARITY then START_STACK[?][OPERAND_BASE + INPUT_I + 1] else WORK_TOP[?]
        | INPUT_LIVE := AT_IP_INPUT and INPUT_I < E_ARITY
        | COPY_NOW := COPY_CURSOR[?]
        | INPUT_COPIES := INPUT_LIVE and COPY_NOW < SEGMENT_TO
        | INPUT_CLOSES := INPUT_LIVE and COPY_NOW >= SEGMENT_TO
        | CALL_FINISHES := AT_IP_INPUT and INPUT_I >= E_ARITY
        | INPUT_KEY := SIGNAL_NAME[CALLEE_FIRST_SIGNAL + INPUT_I]
        | CALLEE_ORDERED := CALLEE_KIND /= C_PROCESS and CALLEE_KIND /= C_ACTION
        | EMIT_COPIES := AT_IP_EMIT and COPY_NOW < WORK_TOP[?]
        | EMIT_CLOSES := AT_IP_EMIT and COPY_NOW >= WORK_TOP[?]
        | EQUATION_ROW_WANTED := INPUT_CLOSES or OUTPUT_ROW
                                 or EMIT_CLOSES and not POSTFIX_IS_MEMBER[?] and WORK_TOP[?] > 0 and POSTFIX_TARGET[?] /= N_TUPLE_MARK + NAME_CAP
        | MEMBER_ROW_WANTED := EMIT_CLOSES and POSTFIX_IS_MEMBER[?]
        | DEPENDENCE_ROW_WANTED := DEPENDENCE_LIVE or INPUT_CLOSES and CALLEE_ORDERED and CALLEE_OUTPUTS > 0 or OUTPUT_DEPENDENCE
        | ENTRY_COPY_WANTED := INPUT_COPIES or EMIT_COPIES or OUTPUT_ROW
        | PLAIN_ENTRY := ENTRY_LIVE and not MODEL_CALL_LIVE
        | LABEL_ROW_WANTED := LABEL_LIVE or ANCESTRY_PASSES and CALL_LABEL_ADDED
        | GROUP_ROW_WANTED := SELECTS_MEMBER and MEMBER_ORDINAL = 0
        | OVERFLOW_FRAGMENT := if SIGNAL_WANTED and FLAT_SIGNAL_COUNT[?] >= SIGNAL_CAP then F_CAP_SIGNALS
                               else if LABEL_ROW_WANTED and FLAT_LABEL_COUNT[?] >= LABEL_CAP then F_CAP_LABELS
                               else if LOOP_LIVE and FLAT_LOOP_COUNT[?] >= LOOP_CAP then F_CAP_LOOPS
                               else if EQUATION_ROW_WANTED and FLAT_EQUATION_COUNT[?] >= EQUATION_CAP then F_CAP_EQUATIONS
                               else if ENTRY_COPY_WANTED and FLAT_ENTRY_COUNT[?] >= FINAL_CAP then F_CAP_ENTRIES
                               else if ANCESTRY_PASSES and INSTANCE_TOTAL[?] >= INSTANCE_CAP then F_CAP_INSTANCES
                               else if PATH_LIVE and FLAT_PATH_COUNT[?] >= FLAT_PATH_CAP then F_CAP_PATHS
                               else if GROUP_ROW_WANTED and FLAT_GROUP_COUNT[?] >= GROUP_CAP then F_CAP_GROUPS
                               else if MEMBER_ROW_WANTED and FLAT_MEMBER_COUNT[?] >= MEMBER_CAP then F_CAP_GROUPS
                               else if DEPENDENCE_ROW_WANTED and FLAT_DEPENDENCE_COUNT[?] >= DEPENDENCE_CAP then F_CAP_DEPENDENCES
                               else if (BIND_LIVE or REF_FOUND) and BIND_COUNT[?] >= SIGNAL_CAP then F_CAP_SIGNALS
                               else 0
        | FAULT_MESSAGE := if LOOP_FAILS or TARGET_FAILS then T_SIGNAL_UNDECLARED
                          else if SLOT_TARGET_FAILS then T_SLOT_DEFINED
                          else if ROOT_PARAMS_FAILS then T_WRONG_ARGUMENTS
                          else if ROOT_REFS_FAILS or REF_UNDECLARED_FAILS then T_REF_UNDECLARED
                          else if BIND_BIG_FAILS then T_LITERAL_BIG
                          else if BIND_UNDECLARED_FAILS then T_PARAMETER_UNDECLARED
                          else if BIND_KIND_FAILS then T_PARAMETER_KIND
                          else if BIND_TYPE_FAILS then T_PARAMETER_TYPE
                          else if BIND_ARRAY_FAILS then T_FORMAL_ARRAY
                          else if BIND_MODEL_FORMALS_FAILS then T_PARAMETER_MODEL_FORMALS
                          else if BIND_INTERFACE_FAILS then T_PARAMETER_INTERFACE
                          else if SLOT_VALUE_FAILS then T_PARAMETER_KIND
                          else if SIGNAL_LABEL_FAILS then T_LABEL_AS_SIGNAL
                          else if SIGNAL_UNDECLARED_FAILS then T_SIGNAL_UNDECLARED
                          else if CASE_VALUE_FAILS then T_CASE_VALUE
                          else if TYPE_PROCESS_FAILS then T_HAS_OUTPUT
                          else if TYPE_SHAPE_FAILS then (if E_NAME = N_INDICES then T_INDICES_CONSTANT else T_CONVERSION_ONE)
                          else if BUILTIN_NAMES_FAILS then T_OUTPUT_COUNT
                          else if BUILTIN_ITERATE_FAILS then T_CALLS_IN_ITERATE
                          else if BUILTIN_COUNT_FAILS then T_WRONG_ARGUMENTS
                          else if BUILTIN_PROCESS_FAILS then T_HAS_OUTPUT
                          else if BUILTIN_EXPRESSION_FAILS then T_NO_OUTPUT
                          else if BUILTIN_UNSAFE_FAILS then T_UNSAFE_CALL
                          else if CALLEE_UNDECLARED_FAILS then T_MODEL_UNDECLARED
                          else if MODEL_TYPE_CALL_FAILS then T_MODEL_TYPE_CALL
                          else if CALLEE_PARAMS_FAILS then T_WRONG_ARGUMENTS
                          else if CALLEE_SEED_FAILS then T_SEED_CALL
                          else if CALLEE_STATE_FAILS then T_CALL_IN_ITERATE_STATE
                          else if SELF_CALL_FAILS then T_CALLS_ITSELF
                          else if FUNCTION_CALL_FAILS then T_FUNCTION_CALL
                          else if ATTRIBUTE_CALL_FAILS then T_ATTRIBUTE_CALL
                          else if ACTION_UNLABELLED_FAILS then T_ACTION_UNLABELLED
                          else if CALLEE_COUNT_FAILS then T_WRONG_ARGUMENTS
                          else if CALLEE_OUTPUTS_FAILS then T_OUTPUT_COUNT
                          else if CALLEE_PROCESS_FAILS then T_HAS_OUTPUT
                          else if CALLEE_EXPRESSION_FAILS then T_NO_OUTPUT
                          else if FROM_FAILS or TO_FAILS then T_SIGNAL_UNDECLARED
                          else if OVERFLOW_FRAGMENT /= 0 then T_CAPACITY else 0
        | FAILS_NOW := FAULT_MESSAGE /= 0
        | FAULT_TOKEN := if LOOP_FAILS then LOOP_TOKEN[ROW_NOW]
                        else if TARGET_FAILS or SLOT_TARGET_FAILS then (if OUTPUT_ROW then OUTPUT_TARGET_TOKEN else SELECT_TOKEN)
                        else if ROOT_PARAMS_FAILS then MODEL_TOKEN[ROOT] else if ROOT_REFS_FAILS then PARAMETER_POSITION[MODEL_FORMAL_END[ROOT]]
                        else if REF_UNDECLARED_FAILS then PARAMETER_POSITION[MODEL_PARAMETER_START[CALLEE_SAFE] + BIND_K]
                        else if BIND_FAILS then BIND_AT
                        else if FROM_FAILS then DEPENDENCE_FROM_TOKEN[ROW_NOW] else if TO_FAILS then DEPENDENCE_TO_TOKEN[ROW_NOW]
                        else if OVERFLOW_FRAGMENT /= 0 then 0 else E_TOKEN
        | FAULT_ARGUMENT0 := if OVERFLOW_FRAGMENT /= 0 and FAULT_MESSAGE = T_CAPACITY then OVERFLOW_FRAGMENT
                           else if SLOT_TARGET_FAILS then CHECK_KEY
                           else if ROOT_PARAMS_FAILS then MODEL_NAME[ROOT]
                           else if ROOT_REFS_FAILS then PARAMETER_NAME[MODEL_FORMAL_END[ROOT]]
                           else if REF_UNDECLARED_FAILS then REF_NAME_NOW
                           else if BIND_BIG_FAILS then BIND_AT else if BIND_UNDECLARED_FAILS then BIND_KEY
                           else if BIND_KIND_FAILS or BIND_TYPE_FAILS or BIND_INTERFACE_FAILS then PARAMETER_NAME[BIND_SLOT_ROW]
                           else if BIND_MODEL_FORMALS_FAILS then MODEL_NAME[BIND_ACTUAL_MODEL]
                           else if SLOT_VALUE_FAILS then E_NAME
                           else if FROM_FAILS then FROM_KEY else if TO_FAILS then TO_KEY
                           else if LOOP_FAILS or TARGET_FAILS then CHECK_KEY
                           else if FAULT_MESSAGE = T_FUNCTION_CALL then MODEL_NAME[INST_MODEL]
                           else if FAULT_MESSAGE = T_ATTRIBUTE_CALL then INST_MODEL
                           else if FAULT_MESSAGE = T_CASE_VALUE then E_TOKEN else E_NAME
        | FAULT_ARGUMENT1 := if FAULT_MESSAGE = T_UNSAFE_CALL then MODEL_KIND[PURE_MODEL]
                           else if SLOT_TARGET_FAILS then MODEL_NAME[INST_MODEL]
                           else if ROOT_PARAMS_FAILS then ROOT_FORMALS
                           else if BIND_KIND_FAILS then MODEL_NAME[CALLEE_SAFE]
                           else if BIND_TYPE_FAILS then BIND_FORMAL_TYPE
                           else if BIND_INTERFACE_FAILS then MODEL_NAME[BIND_TYPE_MODEL]
                           else if SLOT_VALUE_FAILS then MODEL_NAME[INST_MODEL]
                           else if CALLEE_PARAMS_FAILS then CALLEE_FORMALS
                           else if FAULT_MESSAGE = T_FUNCTION_CALL then CALLEE_KIND
                           else if FAULT_MESSAGE = T_ATTRIBUTE_CALL then CALLEE
                           else if FAULT_MESSAGE = T_OUTPUT_COUNT then (if BUILTIN_NAMES_FAILS then integer(TYPE_CALL_LIVE or BUILTIN_HAS_OUTPUT)
                                                                         else CALLEE_OUTPUTS)
                           else if BUILTIN_LIVE then BUILTIN_INPUTS else CALLEE_INPUTS
        | FAULT_ARGUMENT2 := if FAULT_MESSAGE = T_UNSAFE_CALL then MODEL_NAME[PURE_MODEL]
                           else if ROOT_PARAMS_FAILS then 0
                           else if BIND_KIND_FAILS then PARAMETER_KIND_FRAGMENT[BIND_EXPECTED * PARAMETER_KIND_COUNT + BIND_FOUND_KIND]
                           else if BIND_TYPE_FAILS then BIND_VALUE_TYPE
                           else if BIND_INTERFACE_FAILS then MODEL_NAME[BIND_ACTUAL_MODEL]
                           else if SLOT_VALUE_FAILS then PARAMETER_KIND_FRAGMENT[PK_VALUE * PARAMETER_KIND_COUNT + E_SLOT_KIND]
                           else if CALLEE_PARAMS_FAILS then E_PARAMS
                           else if FAULT_MESSAGE = T_OUTPUT_COUNT then CALL_NAMES
                           else if FAULT_MESSAGE = T_FUNCTION_CALL then MODEL_NAME[CALLEE] else E_COUNT
        | INSTANTIATE_MESSAGE := if FAILS_NOW then FAULT_MESSAGE else INSTANTIATE_MESSAGE[?]
        | INSTANTIATE_TOKEN := if FAILS_NOW then FAULT_TOKEN else INSTANTIATE_TOKEN[?]
        | INSTANTIATE_ARGUMENT0 := if FAILS_NOW then FAULT_ARGUMENT0 else INSTANTIATE_ARGUMENT0[?]
        | INSTANTIATE_ARGUMENT1 := if FAILS_NOW then FAULT_ARGUMENT1 else INSTANTIATE_ARGUMENT1[?]
        | INSTANTIATE_ARGUMENT2 := if FAILS_NOW then FAULT_ARGUMENT2 else INSTANTIATE_ARGUMENT2[?]
        | GOES_ON := not FAILS_NOW
        | OWNED_KEY := if SLOT_LIVE then PARAMETER_NAME[ROW_NOW] else SIGNAL_KEY_NOW
        | OWNED_SLOT := if (SIGNAL_WANTED or SLOT_LIVE) and GOES_ON and OWNED_KEY < NAME_CAP then OWNED_KEY else -1
        | SLOT_MARK := SLOT_MARK[?] next OWNED_SLOT : (if SLOT_LIVE then ROW_NOW - MODEL_PARAMETER_START[INST_MODEL] + 1 else 0)
        | BIND_ADVANCES := BIND_LIVE and not BIND_SIG_LIVE or REF_FOUND
        | BIND_ROW_SLOT := if BIND_ADVANCES and GOES_ON then BIND_COUNT[?] else -1
        | REF_ANCESTOR := if CREATES_INSTANCE or BIND_ADVANCES then INST
                          else if BIND_REF_LIVE and REF_AT >= 0 and REF_ROW_NOW < 0 then REF_PARENT else REF_AT
        | REF_ROW := if CREATES_INSTANCE or BIND_ADVANCES then MODEL_FIRST_SIGNAL[INST_MODEL] - 1
                     else if BIND_REF_LIVE and REF_AT >= 0 then (if REF_ROW_NOW < 0 then REF_PARENT_FIRST else SIGNAL_NEXT[REF_ROW_SAFE] - 1)
                     else REF_ROW_NOW
        | BIND_INSTANCE := BIND_INSTANCE[?] next BIND_ROW_SLOT : REF_AT
        | BIND_SIG_CURSOR := if BIND_SIG_LIVE then BIND_SIG + 1 else 0
        | BIND_KIND := BIND_KIND[?] next BIND_ROW_SLOT : (if REF_FOUND then PK_SIGNAL else BIND_FOUND_KIND)
        | BIND_TYPE := BIND_TYPE[?] next BIND_ROW_SLOT : (if REF_FOUND then SIGNAL_TYPE[REF_ROW_SAFE] else BIND_VALUE_TYPE)
        | BIND_VALUE := BIND_VALUE[?] next BIND_ROW_SLOT : (if REF_FOUND then long(0) else BIND_VALUE_NOW)
        | BIND_MODEL := BIND_MODEL[?] next BIND_ROW_SLOT : (if REF_FOUND then -1 else BIND_MODEL_NOW)
        | BIND_COUNT := BIND_COUNT[?] + integer(BIND_ROW_SLOT >= 0)
        | BIND_CURSOR := if CREATES_INSTANCE then 0 else BIND_K + integer(BIND_ADVANCES)
        | OWNED_MARK := OWNED_MARK[?] next OWNED_SLOT : INST_MARK
        | LABELED_MARK := LABELED_MARK[?] next (if LABEL_LIVE and GOES_ON then LABEL_NAME[ROW_NOW] else -1) : INST_MARK
        | SIGNAL_ROW_SLOT := if SIGNAL_WANTED and GOES_ON then FLAT_SIGNAL_COUNT[?] else -1
        | FLAT_SIGNAL_SOURCE := FLAT_SIGNAL_SOURCE[?] next SIGNAL_ROW_SLOT : (if PARSE_SIGNAL_LIVE then ROW_NOW else -ROW_NOW - 1)
        | FLAT_SIGNAL_INSTANCE := FLAT_SIGNAL_INSTANCE[?] next SIGNAL_ROW_SLOT : INST
        | FLAT_SIGNAL_COUNT := FLAT_SIGNAL_COUNT[?] + integer(SIGNAL_ROW_SLOT >= 0)
        | LABEL_ROW_SLOT := if LABEL_ROW_WANTED and GOES_ON then FLAT_LABEL_COUNT[?] else -1
        | FLAT_LABEL_KEY := FLAT_LABEL_KEY[?] next LABEL_ROW_SLOT : (if LABEL_LIVE then LABEL_NAME[ROW_NOW] else POSTFIX_TARGET[?])
        | FLAT_LABEL_INSTANCE := FLAT_LABEL_INSTANCE[?] next LABEL_ROW_SLOT : INST
        | FLAT_LABEL_CALL := FLAT_LABEL_CALL[?] next LABEL_ROW_SLOT : not LABEL_LIVE
        | FLAT_LABEL_COUNT := FLAT_LABEL_COUNT[?] + integer(LABEL_ROW_SLOT >= 0)
        | LOOP_ROW_SLOT := if LOOP_LIVE and GOES_ON then FLAT_LOOP_COUNT[?] else -1
        | FLAT_LOOP_SOURCE := FLAT_LOOP_SOURCE[?] next LOOP_ROW_SLOT : ROW_NOW
        | FLAT_LOOP_INSTANCE := FLAT_LOOP_INSTANCE[?] next LOOP_ROW_SLOT : INST
        | FLAT_LOOP_OF := FLAT_LOOP_OF[?] next (if LOOP_ROW_SLOT >= 0 then ROW_NOW else -1) : LOOP_ROW_SLOT
        | FLAT_LOOP_COUNT := FLAT_LOOP_COUNT[?] + integer(LOOP_ROW_SLOT >= 0)
        | POSTFIX_START := if SELECTS_PARSE_EQUATION then EQUATION_FINAL_START[ROW_NOW]
                           else if SELECTS_FINISH_EQUATION then FINISH_EQUATION_FINAL_START[ROW_NOW]
                           else if SELECTS_MEMBER and AT_IP_GROUP then MEMBER_FINAL_START[SELECT_MEMBER_ROW]
                           else if SELECTS_MEMBER then FINISH_GROUP_FINAL[ROW_NOW] + MEMBER_ORDINAL else POSTFIX_START[?]
        | POSTFIX_END := if SELECTS_PARSE_EQUATION then EQUATION_FINAL_END[ROW_NOW]
                         else if SELECTS_FINISH_EQUATION then FINISH_EQUATION_FINAL_END[ROW_NOW]
                         else if SELECTS_MEMBER and AT_IP_GROUP then MEMBER_FINAL_END[SELECT_MEMBER_ROW]
                         else if SELECTS_MEMBER then FINISH_GROUP_FINAL[ROW_NOW] + MEMBER_ORDINAL + 1 else POSTFIX_END_NOW
        | POSTFIX_TARGET := if SELECTS then (if SELECTS_EQUATION then SELECT_TARGET else -1) else POSTFIX_TARGET[?]
        | POSTFIX_IS_MEMBER := if SELECTS then SELECTS_MEMBER else POSTFIX_IS_MEMBER[?]
        | POSTFIX_SEED := if SELECTS then SELECT_SEED else POSTFIX_SEED[?]
        | POSTFIX_LOOP := if SELECTS then (if SELECTS_PARSE_EQUATION then EQUATION_LOOP[ROW_NOW] else -1) else POSTFIX_LOOP[?]
        | POSTFIX_TOKEN := if SELECTS_EQUATION then SELECT_TOKEN else POSTFIX_TOKEN[?]
        | POSTFIX_PARTIAL := if SELECTS then (if SELECTS_PARSE_EQUATION then EQUATION_PARTIAL[ROW_NOW] else 0) else POSTFIX_PARTIAL[?]
        | POSTFIX_TUPLE_TOKEN := if SELECTS then (if SELECTS_PARSE_EQUATION then EQUATION_TUPLE_TOKEN[ROW_NOW] else 0) else POSTFIX_TUPLE_TOKEN[?]
        | POSTFIX_TUPLE_START := if SELECTS then (if SELECTS_PARSE_EQUATION then EQUATION_TUPLE_START[ROW_NOW] else 0) else POSTFIX_TUPLE_START[?]
        | POSTFIX_TUPLE_ARITY := if SELECTS then (if SELECTS_PARSE_EQUATION then EQUATION_TUPLE_ARITY[ROW_NOW] else 0) else POSTFIX_TUPLE_ARITY[?]
        | POSTFIX_LABELS := if SELECTS then
                              (if SELECTS_PARSE_EQUATION then EQUATION_LABELS[ROW_NOW]
                               else if SELECTS_FINISH_EQUATION then FINISH_EQUATION_LABELS[ROW_NOW] else -1)
                            else POSTFIX_LABEL_NODE
        | POSTFIX_GUARDS := if SELECTS then
                              (if SELECTS_PARSE_EQUATION then EQUATION_GUARDS[ROW_NOW]
                               else if SELECTS_FINISH_EQUATION then FINISH_EQUATION_GUARDS[ROW_NOW]
                               else if AT_IP_GROUP then GROUP_GUARDS[ROW_NOW] else -1)
                            else POSTFIX_GUARD_NODE
        | POSTFIX_RETURN := if SELECTS then IP_NOW else POSTFIX_RETURN[?]
        | GROUP_ROW_SLOT := if GROUP_ROW_WANTED and GOES_ON then FLAT_GROUP_COUNT[?] else -1
        | FLAT_GROUP_TOKEN := FLAT_GROUP_TOKEN[?] next GROUP_ROW_SLOT
                              : (if AT_IP_GROUP then GROUP_POSITION[ROW_NOW] else MODEL_TOKEN[FINISH_GROUP_MODEL[ROW_NOW]])
        | FLAT_GROUP_GUARDS := FLAT_GROUP_GUARDS[?] next GROUP_ROW_SLOT : (if AT_IP_GROUP then GROUP_GUARDS[ROW_NOW] else -1)
        | FLAT_GROUP_RELATION := FLAT_GROUP_RELATION[?] next GROUP_ROW_SLOT : (if AT_IP_GROUP then GROUP_RELATION[ROW_NOW] else C_CLOCK_EQUAL)
        | FLAT_GROUP_OPERATOR := FLAT_GROUP_OPERATOR[?] next GROUP_ROW_SLOT
                                 : (if AT_IP_GROUP then GROUP_OPERATOR[ROW_NOW] else MODEL_TOKEN[FINISH_GROUP_MODEL[ROW_NOW]])
        | FLAT_RELATION_STEPS := FLAT_RELATION_STEPS[?]
                                 + (if GROUP_ROW_SLOT >= 0 and AT_IP_GROUP and (GROUP_RELATION[ROW_NOW] /= C_CLOCK_EQUAL or GROUP_ASSUMED[ROW_NOW])
                                    then GROUP_MEMBER_COUNT * GROUP_MEMBER_COUNT else 0)
        | FLAT_GROUP_ASSUMED := FLAT_GROUP_ASSUMED[?] next GROUP_ROW_SLOT : AT_IP_GROUP and GROUP_ASSUMED[ROW_NOW]
        | FLAT_ASSUMPTIONS := FLAT_ASSUMPTIONS[?] + integer(GROUP_ROW_SLOT >= 0 and AT_IP_GROUP and GROUP_ASSUMED[ROW_NOW])
        | FLAT_GROUP_INSTANCE := FLAT_GROUP_INSTANCE[?] next GROUP_ROW_SLOT : INST
        | FLAT_GROUP_PARSE := FLAT_GROUP_PARSE[?] next GROUP_ROW_SLOT : (if AT_IP_GROUP then ROW_NOW else -1)
        | FLAT_GROUP_MEMBER_FIRST := FLAT_GROUP_MEMBER_FIRST[?] next GROUP_ROW_SLOT : FLAT_MEMBER_COUNT[?]
        | FLAT_GROUP_MEMBER_TOTAL := FLAT_GROUP_MEMBER_TOTAL[?] next GROUP_ROW_SLOT : GROUP_MEMBER_COUNT
        | FLAT_GROUP_COUNT := FLAT_GROUP_COUNT[?] + integer(GROUP_ROW_SLOT >= 0)
        | ENTRY_START_VALUE := if PLAIN_ENTRY or CALL_FINISHES then (if E_ARITY > 0 then START_STACK[?][OPERAND_BASE] else WORK_TOP[?])
                               else 0
        | CALL_HAS_OUTPUT := CALLEE_OUTPUTS > 0
        | WORK_SLOT := if PLAIN_ENTRY and GOES_ON then WORK_TOP[?]
                       else if CALL_FINISHES and CALL_HAS_OUTPUT then ENTRY_START_VALUE else -1
        | WORK_SOURCE := WORK_SOURCE[?] next WORK_SLOT : E
        | E_TUPLE_K := if E_OP = OP_SIGNAL and E_NAME >= N_TUPLE_MARK + 2 * NAME_CAP and (E_NAME - N_TUPLE_MARK) modulo NAME_CAP = 0
                       then (E_NAME - N_TUPLE_MARK) / NAME_CAP - 2 else -1
        | TUPLE_CALL_MODEL := INSTANCE_MODEL[?][CALL_INSTANCE[?]]
        | WORK_OP := WORK_OP[?] next WORK_SLOT
                     : (if CALL_FINISHES then OP_SIGNAL else if BUILTIN_LIVE then OP_EFFECT else if E_IS_SLOT and not E_IS_REF then OP_SLOT else E_OP)
        | WORK_NAME := WORK_NAME[?] next WORK_SLOT
                       : (if CALL_FINISHES then CALLEE_OUTPUT_KEY else if E_IS_SLOT and not E_IS_REF then CHECK_SLOT - 1
                          else if E_TUPLE_K >= 0 then SIGNAL_NAME[MODEL_SIGNAL_START[TUPLE_CALL_MODEL] + MODEL_INPUT_TOTAL[TUPLE_CALL_MODEL] + E_TUPLE_K]
                          else E_NAME)
        | WORK_INSTANCE := WORK_INSTANCE[?] next WORK_SLOT
                           : (if CALL_FINISHES or E_TUPLE_K >= 0 then CALL_INSTANCE[?] else if E_IS_REF then BIND_INSTANCE[?][INSTANCE_BIND_START[?][INST] + (if CHECK_SLOT > 0 then CHECK_SLOT - 1 else 0)]
                              else if SIGNAL_CHECKED and CHECK_OWNED or BUILTIN_LIVE then INST else 0)
        | START_SLOT := if E_ARITY = 0 and (PLAIN_ENTRY and GOES_ON or CALL_FINISHES and CALL_HAS_OUTPUT) then START_TOP[?] else -1
        | START_STACK := START_STACK[?] next START_SLOT : WORK_TOP[?]
        | WORK_TOP := if SELECTS then 0 else if PLAIN_ENTRY then WORK_TOP[?] + 1
                      else if CALL_FINISHES then ENTRY_START_VALUE + integer(CALL_HAS_OUTPUT) else WORK_TOP[?]
        | START_TOP := if SELECTS then 0 else if PLAIN_ENTRY then START_TOP[?] - E_ARITY + 1
                       else if CALL_FINISHES then START_TOP[?] - E_ARITY + integer(CALL_HAS_OUTPUT) else START_TOP[?]
        | ENTRY_CURSOR := if SELECTS then POSTFIX_START
                          else if PLAIN_ENTRY or CALL_FINISHES and CALL_NAMES <= 1 or AT_IP_OUTPUTS and not OUTPUTS_LIVE then E + 1 else E
        | OUTPUT_CURSOR := if CALL_FINISHES then 1 else OUTPUT_K + integer(OUTPUTS_LIVE and OUTPUT_I >= OUTPUT_DEPENDENCES)
        | OUTPUT_INPUT_CURSOR := if CALL_FINISHES or OUTPUTS_LIVE and OUTPUT_I >= OUTPUT_DEPENDENCES then 0
                                 else OUTPUT_I + integer(OUTPUTS_LIVE)
        | CREATES_INSTANCE := ANCESTRY_PASSES and GOES_ON
        | NEW_INSTANCE := INSTANCE_TOTAL[?]
        | INSTANCE_SLOT := if CREATES_INSTANCE then NEW_INSTANCE else if AT_IP_ROOT then 0 else -1
        | NEW_MODEL := if AT_IP_ROOT then ROOT else CALLEE
        | NEW_KIND := MODEL_KIND[NEW_MODEL]
        | NEW_PURE := MODEL_ATTRIBUTE[NEW_MODEL] /= ATTRIBUTE_UNSAFE
        | CALLEE_TALLY := MODEL_INSTANCE_TALLY[?][CALLEE] + 1
        | MODEL_INSTANCE_TALLY := MODEL_INSTANCE_TALLY[?] next (if CREATES_INSTANCE then CALLEE else -1) : CALLEE_TALLY
        | INSTANCE_MODEL := INSTANCE_MODEL[?] next INSTANCE_SLOT : NEW_MODEL
        | INSTANCE_PARENT := INSTANCE_PARENT[?] next INSTANCE_SLOT : (if AT_IP_ROOT then -1 else INST)
        | INSTANCE_LOOP := INSTANCE_LOOP[?] next INSTANCE_SLOT : (if AT_IP_ROOT then -1 else CALL_FLAT_LOOP)
        | INSTANCE_ORDINAL := INSTANCE_ORDINAL[?] next INSTANCE_SLOT : (if AT_IP_ROOT then 0 else CALLEE_TALLY)
        | INSTANCE_PURE := INSTANCE_PURE[?] next INSTANCE_SLOT
                           : (if NEW_PURE then INSTANCE_SLOT else if AT_IP_ROOT then -1 else PURE_INSTANCE)
        | INSTANCE_LABEL_START := INSTANCE_LABEL_START[?] next INSTANCE_SLOT : FLAT_PATH_COUNT[?]
        | INSTANCE_LABEL_LENGTH := INSTANCE_LABEL_LENGTH[?] next INSTANCE_SLOT : (if AT_IP_ROOT then 0 else NEW_LABEL_LENGTH)
        | INSTANCE_GUARD_START := INSTANCE_GUARD_START[?] next INSTANCE_SLOT
                                  : FLAT_PATH_COUNT[?] + (if AT_IP_ROOT then 0 else NEW_LABEL_LENGTH)
        | INSTANCE_GUARD_LENGTH := INSTANCE_GUARD_LENGTH[?] next INSTANCE_SLOT : (if AT_IP_ROOT then 0 else NEW_GUARD_LENGTH)
        | INSTANCE_TOTAL := INSTANCE_TOTAL[?] + integer(INSTANCE_SLOT >= 0)
        | INSTANCE_BIND_START := INSTANCE_BIND_START[?] next INSTANCE_SLOT : BIND_COUNT[?]
        | CALL_INSTANCE := if CREATES_INSTANCE then NEW_INSTANCE else CALL_INSTANCE[?]
        | PATH_SLOT := if PATH_LIVE and GOES_ON then FLAT_PATH_COUNT[?] else -1
        | FLAT_PATH_KEY := FLAT_PATH_KEY[?] next PATH_SLOT : PATH_KEY_NOW
        | FLAT_PATH_INSTANCE := FLAT_PATH_INSTANCE[?] next PATH_SLOT : PATH_INSTANCE_NOW
        | FLAT_PATH_CALL := FLAT_PATH_CALL[?] next PATH_SLOT : PATH_CALL_NOW
        | FLAT_PATH_COUNT := FLAT_PATH_COUNT[?] + integer(PATH_SLOT >= 0)
        | PATH_STEP := if CREATES_INSTANCE then 0 else PATH_K + integer(PATH_LIVE)
        | ENTRY_SLOT_FLAT := if ENTRY_COPY_WANTED and GOES_ON then FLAT_ENTRY_COUNT[?] else -1
        | COPIED_SOURCE := if OUTPUT_ROW then E else WORK_SOURCE[?][COPY_NOW]
        | COPIED_OP := if OUTPUT_ROW then OP_SIGNAL else WORK_OP[?][COPY_NOW]
        | FLAT_ENTRY_SOURCE := FLAT_ENTRY_SOURCE[?] next ENTRY_SLOT_FLAT : COPIED_SOURCE
        | FLAT_ENTRY_OP := FLAT_ENTRY_OP[?] next ENTRY_SLOT_FLAT : COPIED_OP
        | FLAT_ENTRY_NAME := FLAT_ENTRY_NAME[?] next ENTRY_SLOT_FLAT : (if OUTPUT_ROW then OUTPUT_KEY else WORK_NAME[?][COPY_NOW])
        | FLAT_ENTRY_INSTANCE := FLAT_ENTRY_INSTANCE[?] next ENTRY_SLOT_FLAT
                                 : (if OUTPUT_ROW then CALL_INSTANCE[?] else WORK_INSTANCE[?][COPY_NOW])
        | FLAT_ENTRY_COUNT := FLAT_ENTRY_COUNT[?] + integer(ENTRY_SLOT_FLAT >= 0)
        | FLAT_PARAMETER_TOTAL := FLAT_PARAMETER_TOTAL[?]
                                  + (if ENTRY_SLOT_FLAT >= 0 and (COPIED_OP = OP_CALL or COPIED_OP = OP_EFFECT)
                                     then FINAL_AUX2[COPIED_SOURCE] else 0)
        | COPY_CURSOR := if AT_IP_PATH and not PATH_LIVE then (if E_ARITY > 0 then START_STACK[?][OPERAND_BASE] else 0)
                         else if AT_IP_ENTRY and not ENTRY_LIVE then 0
                         else COPY_NOW + integer(INPUT_COPIES or EMIT_COPIES)
        | INPUT_CURSOR := if AT_IP_PATH then 0 else INPUT_I + integer(INPUT_CLOSES)
        | EQUATION_ROW_SLOT := if EQUATION_ROW_WANTED and GOES_ON then FLAT_EQUATION_COUNT[?] else -1
        | ROW_LENGTH := if INPUT_CLOSES then SEGMENT_TO - SEGMENT_FROM else if OUTPUT_ROW then 1 else WORK_TOP[?]
        | FLAT_EQUATION_TARGET := FLAT_EQUATION_TARGET[?] next EQUATION_ROW_SLOT
                                  : (if INPUT_CLOSES then INPUT_KEY else if OUTPUT_ROW then OUTPUT_TARGET else POSTFIX_TARGET[?])
        | FLAT_EQUATION_TARGET_INSTANCE := FLAT_EQUATION_TARGET_INSTANCE[?] next EQUATION_ROW_SLOT
                                           : (if INPUT_CLOSES then CALL_INSTANCE[?] else INST)
        | FLAT_EQUATION_START := FLAT_EQUATION_START[?] next EQUATION_ROW_SLOT : FLAT_ENTRY_COUNT - ROW_LENGTH
        | FLAT_EQUATION_END := FLAT_EQUATION_END[?] next EQUATION_ROW_SLOT : FLAT_ENTRY_COUNT
        | FLAT_EQUATION_TOKEN := FLAT_EQUATION_TOKEN[?] next EQUATION_ROW_SLOT
                                 : (if INPUT_CLOSES then E_TOKEN else if OUTPUT_ROW then OUTPUT_TARGET_TOKEN else POSTFIX_TOKEN[?])
        | FLAT_EQUATION_LOOP := FLAT_EQUATION_LOOP[?] next EQUATION_ROW_SLOT
                                : CALL_FLAT_LOOP
        | FLAT_EQUATION_SEED := FLAT_EQUATION_SEED[?] next EQUATION_ROW_SLOT : not INPUT_CLOSES and not OUTPUT_ROW and POSTFIX_SEED[?]
        | FLAT_EQUATION_CONTEXT := FLAT_EQUATION_CONTEXT[?] next EQUATION_ROW_SLOT : INST
        | FLAT_EQUATION_LABELS := FLAT_EQUATION_LABELS[?] next EQUATION_ROW_SLOT : POSTFIX_LABEL_NODE
        | FLAT_EQUATION_GUARDS := FLAT_EQUATION_GUARDS[?] next EQUATION_ROW_SLOT : POSTFIX_GUARD_NODE
        | FLAT_EQUATION_PARTIAL := FLAT_EQUATION_PARTIAL[?] next EQUATION_ROW_SLOT
                                   : (if INPUT_CLOSES or OUTPUT_ROW then 0 else POSTFIX_PARTIAL[?])
        | FLAT_PARTIAL_COUNT := FLAT_PARTIAL_COUNT[?] + integer(EQUATION_ROW_SLOT >= 0 and not INPUT_CLOSES and not OUTPUT_ROW and POSTFIX_PARTIAL[?] > 0)
        | FLAT_EQUATION_COUNT := FLAT_EQUATION_COUNT[?] + integer(EQUATION_ROW_SLOT >= 0)
        | FLAT_LIST_TOTAL := FLAT_LIST_TOTAL[?]
                             + (if EQUATION_ROW_SLOT >= 0 then CALLER_LABEL_LENGTH + POSTFIX_LABEL_LENGTH + CALLER_GUARD_LENGTH
                                                               + POSTFIX_GUARD_LENGTH
                                else 0)
                             + (if GROUP_ROW_SLOT >= 0 then CALLER_GUARD_LENGTH + POSTFIX_GUARD_LENGTH else 0)
        | MEMBER_ROW_SLOT := if MEMBER_ROW_WANTED and GOES_ON then FLAT_MEMBER_COUNT[?] else -1
        | FLAT_MEMBER_START := FLAT_MEMBER_START[?] next MEMBER_ROW_SLOT : FLAT_ENTRY_COUNT[?] - WORK_TOP[?]
        | FLAT_MEMBER_END := FLAT_MEMBER_END[?] next MEMBER_ROW_SLOT : FLAT_ENTRY_COUNT[?]
        | FLAT_MEMBER_COUNT := FLAT_MEMBER_COUNT[?] + integer(MEMBER_ROW_SLOT >= 0)
        | DEPENDENCE_ROW_SLOT := if DEPENDENCE_ROW_WANTED and GOES_ON then FLAT_DEPENDENCE_COUNT[?] else -1
        | FLAT_DEPENDENCE_INSTANCE := FLAT_DEPENDENCE_INSTANCE[?] next DEPENDENCE_ROW_SLOT
                                      : (if INPUT_CLOSES or OUTPUT_DEPENDENCE then CALL_INSTANCE[?] else INST)
        | FLAT_DEPENDENCE_FROM_KEY := FLAT_DEPENDENCE_FROM_KEY[?] next DEPENDENCE_ROW_SLOT
                                      : (if INPUT_CLOSES then INPUT_KEY else if OUTPUT_DEPENDENCE then OUTPUT_INPUT_KEY else FROM_KEY)
        | FLAT_DEPENDENCE_TO_KEY := FLAT_DEPENDENCE_TO_KEY[?] next DEPENDENCE_ROW_SLOT
                                    : (if INPUT_CLOSES then CALLEE_OUTPUT_KEY else if OUTPUT_DEPENDENCE then OUTPUT_KEY else TO_KEY)
        | FLAT_DEPENDENCE_FROM_TOKEN := FLAT_DEPENDENCE_FROM_TOKEN[?] next DEPENDENCE_ROW_SLOT
                                        : (if INPUT_CLOSES or OUTPUT_DEPENDENCE then E_TOKEN else DEPENDENCE_FROM_TOKEN[ROW_NOW])
        | FLAT_DEPENDENCE_TO_TOKEN := FLAT_DEPENDENCE_TO_TOKEN[?] next DEPENDENCE_ROW_SLOT
                                      : (if INPUT_CLOSES or OUTPUT_DEPENDENCE then E_TOKEN else DEPENDENCE_TO_TOKEN[ROW_NOW])
        | FLAT_DEPENDENCE_TOKEN := FLAT_DEPENDENCE_TOKEN[?] next DEPENDENCE_ROW_SLOT
                                   : (if INPUT_CLOSES or OUTPUT_DEPENDENCE then E_TOKEN else DEPENDENCE_POSITION[ROW_NOW])
        | FLAT_DEPENDENCE_CONDITION := FLAT_DEPENDENCE_CONDITION[?] next DEPENDENCE_ROW_SLOT
                                       : (if INPUT_CLOSES or OUTPUT_DEPENDENCE then -1 else DEPENDENCE_CONDITION[ROW_NOW])
        | FLAT_DEPENDENCE_COUNT := FLAT_DEPENDENCE_COUNT[?] + integer(DEPENDENCE_ROW_SLOT >= 0)
        | ANCESTOR_CURSOR := if STARTS_ANCESTRY then INST else if AT_IP_ANCESTRY then INSTANCE_PARENT[?][WALKER] else WALKER
        | IP_STATE := if FAILS_NOW then IP_FAILED
                      else if AT_IP_ROOT then IP_INSTANCE
                      else if AT_IP_INSTANCE then (if INSTANCES_DONE then IP_DONE else IP_LABEL)
                      else if AT_IP_LABEL then (if LABEL_LIVE then IP_LABEL else IP_SIGNAL)
                      else if AT_IP_SIGNAL then (if PARSE_SIGNAL_LIVE then IP_SIGNAL else IP_FINISH_SIGNAL)
                      else if AT_IP_FINISH_SIGNAL then (if FINISH_SIGNAL_LIVE then IP_FINISH_SIGNAL else IP_SLOT)
                      else if AT_IP_SLOT then (if SLOT_LIVE then IP_SLOT else IP_LOOP)
                      else if AT_IP_LOOP then (if LOOP_LIVE then IP_LOOP else IP_EQUATION)
                      else if AT_IP_EQUATION then
                        (if SELECTS_PARSE_EQUATION then IP_ENTRY else if EQUATION_LIVE then IP_EQUATION else IP_FINISH_EQUATION)
                      else if AT_IP_FINISH_EQUATION then (if SELECTS_FINISH_EQUATION then IP_ENTRY else IP_GROUP)
                      else if AT_IP_GROUP then
                        (if SELECTS_MEMBER then IP_ENTRY else if PARSE_GROUP_LIVE then IP_GROUP else IP_FINISH_GROUP)
                      else if AT_IP_FINISH_GROUP then
                        (if SELECTS_MEMBER then IP_ENTRY else if FINISH_GROUP_LIVE then IP_FINISH_GROUP else IP_DEPENDENCE)
                      else if AT_IP_DEPENDENCE then (if DEPENDENCE_LIVE then IP_DEPENDENCE else IP_INSTANCE)
                      else if AT_IP_ENTRY then (if not ENTRY_LIVE then IP_EMIT else if STARTS_ANCESTRY then IP_ANCESTRY else IP_ENTRY)
                      else if AT_IP_ANCESTRY then (if ANCESTRY_PASSES then IP_BIND else IP_ANCESTRY)
                      else if AT_IP_BIND then (if BIND_LIVE or BIND_REF_LIVE then IP_BIND else IP_PATH)
                      else if AT_IP_PATH then (if PATH_LIVE then IP_PATH else IP_INPUT)
                      else if AT_IP_INPUT then (if not CALL_FINISHES then IP_INPUT else if CALL_NAMES > 1 then IP_OUTPUTS else IP_ENTRY)
                      else if AT_IP_OUTPUTS then (if OUTPUTS_LIVE then IP_OUTPUTS else IP_ENTRY)
                      else if AT_IP_EMIT then (if EMIT_CLOSES then POSTFIX_RETURN[?] else IP_EMIT)
                      else IP_NOW
        | ROW_CURSOR := if AT_IP_INSTANCE then MODEL_FIRST_LABEL[INST_MODEL] - 1
                        else if AT_IP_LABEL then (if LABEL_LIVE then LABEL_NEXT[ROW_NOW] - 1 else MODEL_FIRST_SIGNAL[INST_MODEL] - 1)
                        else if AT_IP_SIGNAL then
                          (if PARSE_SIGNAL_LIVE then SIGNAL_NEXT[ROW_NOW] - 1 else MODEL_FINISH_SIGNAL_START[INST_MODEL])
                        else if AT_IP_FINISH_SIGNAL then (if FINISH_SIGNAL_LIVE then ROW_NOW + 1 else MODEL_PARAMETER_START[INST_MODEL])
                        else if AT_IP_SLOT then (if SLOT_LIVE then ROW_NOW + 1 else MODEL_LOOP_START[INST_MODEL])
                        else if AT_IP_LOOP then (if LOOP_LIVE then ROW_NOW + 1 else MODEL_EQUATION_START[INST_MODEL])
                        else if AT_IP_EQUATION then
                          (if EQUATION_LIVE then ROW_NOW + integer(EQUATION_SKIPS) else MODEL_FINISH_EQUATION_START[INST_MODEL])
                        else if AT_IP_FINISH_EQUATION then (if SELECTS_FINISH_EQUATION then ROW_NOW else MODEL_GROUP_START[INST_MODEL])
                        else if AT_IP_GROUP then
                          (if PARSE_GROUP_LIVE then ROW_NOW + integer(GROUP_ADVANCES) else MODEL_FINISH_GROUP_START[INST_MODEL])
                        else if AT_IP_FINISH_GROUP then
                          (if FINISH_GROUP_LIVE then ROW_NOW + integer(GROUP_ADVANCES) else MODEL_DEPENDENCE_START[INST_MODEL])
                        else if AT_IP_DEPENDENCE then ROW_NOW + 1
                        else ROW_NOW + integer(EMIT_CLOSES and not POSTFIX_IS_MEMBER[?])
        | MEMBER_CURSOR := if GROUP_ADVANCES then 0 else MEMBER_ORDINAL + integer(EMIT_CLOSES and POSTFIX_IS_MEMBER[?])
        | INSTANCE_AT := INST + integer(AT_IP_DEPENDENCE and not DEPENDENCE_LIVE)
        |)
     with (| IP_STATE := IP_ROOT | INSTANCE_AT := 0 | ROW_CURSOR := 0 | MEMBER_CURSOR := 0 | ENTRY_CURSOR := 0
           | WORK_TOP := 0 | START_TOP := 0 | ANCESTOR_CURSOR := -1 | PATH_STEP := 0 | INPUT_CURSOR := 0 | COPY_CURSOR := 0
           | CALL_INSTANCE := 0 | INSTANCE_TOTAL := 0 | POSTFIX_START := 0 | POSTFIX_END := 0 | POSTFIX_TARGET := -1
           | POSTFIX_IS_MEMBER := false | POSTFIX_SEED := false | POSTFIX_LOOP := -1 | POSTFIX_TOKEN := 0 | POSTFIX_PARTIAL := 0
           | POSTFIX_LABELS := -1 | POSTFIX_GUARDS := -1 | POSTFIX_RETURN := IP_EQUATION | FLAT_SIGNAL_COUNT := 0
           | FLAT_LABEL_COUNT := 0 | FLAT_LOOP_COUNT := 0 | FLAT_GROUP_COUNT := 0 | FLAT_MEMBER_COUNT := 0 | FLAT_RELATION_STEPS := 0 | FLAT_ASSUMPTIONS := 0 | FLAT_PARTIAL_COUNT := 0
           | FLAT_ENTRY_COUNT := 0 | FLAT_PATH_COUNT := 0 | FLAT_EQUATION_COUNT := 0 | FLAT_DEPENDENCE_COUNT := 0
           | FLAT_PARAMETER_TOTAL := 0 | FLAT_LIST_TOTAL := 0 | INSTANTIATE_MESSAGE := 0 | INSTANTIATE_TOKEN := 0
           | INSTANTIATE_ARGUMENT0 := 0 | INSTANTIATE_ARGUMENT1 := 0 | INSTANTIATE_ARGUMENT2 := 0 | BIND_COUNT := 0
           | BIND_CURSOR := 0 | BIND_SIG_CURSOR := 0 | REF_ANCESTOR := -1 | REF_ROW := -1 | POSTFIX_TUPLE_TOKEN := 0 | POSTFIX_TUPLE_ARITY := 0 | POSTFIX_TUPLE_START := 0
           | OUTPUT_CURSOR := 1 | OUTPUT_INPUT_CURSOR := 0 |)
     end
   | INSTANTIATE_FAILED := INSTANTIATES and IP_STATE = IP_FAILED
   | INSTANTIATE_INCOMPLETE := INSTANTIATES and IP_STATE /= IP_DONE and IP_STATE /= IP_FAILED
   | FLAT_READY := INSTANTIATES and IP_STATE = IP_DONE
   | DUMP_RUNS := DUMP_PASS = 2 and FINISHES and PASS_MESSAGE = 0 or DUMP_PASS = 3 and FLAT_READY or ROWS_DUMP and ROWS_READY or CLOCKS_DUMP and CLOCKS_READY or SCHEDULE_DUMP and SCHEDULE_READY
   | FLAT_DUMP := DUMP_PASS = 3
   | ROWS_DUMP := DUMP_PASS = 4
   | LOWERS := FLAT_READY and (DUMP_PASS = 0 or DUMP_PASS = 4 or DUMP_PASS = 5 or DUMP_PASS = 6 or DUMP_PASS = 7)
   | LOWER_BASE_BOUND := long(64) + long(2) * long(FLAT_SIGNAL_COUNT) + long(FLAT_LABEL_COUNT) + long(2) * long(TYPE_COUNT)
                         + long(VALUE_COUNT) + long(TABLE_COUNT) + long(POOL_COUNT) + long(FLAT_LOOP_COUNT)
                         + long(6) * long(FLAT_EQUATION_COUNT) + long(2) * long(FLAT_GROUP_COUNT) + long(2) * long(FLAT_MEMBER_COUNT)
                         + long(4) * long(FLAT_ENTRY_COUNT) + long(6) * long(FLAT_PARTIAL_COUNT)
   | LOWER_BOUND := LOWER_BASE_BOUND + (if USES_COMPLEX then long(8) * LOWER_BASE_BOUND + long(CX_STEP_LIMIT) * long(FLAT_ENTRY_COUNT) else long(0))
   | LOWER_INDEX := 0 .. (if LOWERS then LOWER_BOUND else long(-1))
   | iterate LOWER_INDEX of
       (| LW_NOW := LW_STATE[?]
        | LW_I := LW_CURSOR[?]
        | LW_K := LW_SUB[?]
        | AT_LS_SIGNAL := LW_NOW = LS_SIGNAL
        | AT_LS_STATEVAR := LW_NOW = LS_STATEVAR
        | AT_LS_LABEL := LW_NOW = LS_LABEL
        | AT_LS_VALUE := LW_NOW = LS_VALUE
        | AT_LS_ARRAY := LW_NOW = LS_ARRAY
        | AT_LS_TABLE := LW_NOW = LS_TABLE
        | AT_LS_LOOP := LW_NOW = LS_LOOP
        | AT_LS_EQUATION := LW_NOW = LS_EQUATION
        | AT_LS_GROUP := LW_NOW = LS_GROUP
        | AT_LS_START := LW_NOW = LS_START
        | AT_LS_SCAN := LW_NOW = LS_SCAN
        | AT_LS_ENTRY := LW_NOW = LS_ENTRY
        | AT_LS_NEVER := LW_NOW = LS_NEVER
        | AT_LS_CXTYPE := LW_NOW = LS_CXTYPE
        | CXT_LIVE := AT_LS_CXTYPE and LW_I < TYPE_COUNT + NEW_TYPE_COUNT[?]
        | CXT_NEW := LW_I >= TYPE_COUNT
        | CXT_OLD := if CXT_NEW or LW_I < 0 then 0 else LW_I
        | CXT_ARRAY := CXT_NEW or TYPE_KIND[CXT_OLD] = TK_ARRAY
        | CXT_SCALAR := not CXT_NEW and TYPE_KIND[CXT_OLD] = TK_COMPLEX
        | CXT_ELEMENT := if not CXT_LIVE or not CXT_ARRAY then 0 else if CXT_NEW then NEW_TYPE_ELEMENT[?][LW_I - TYPE_COUNT] else TYPE_ELEMENT[CXT_OLD]
        | CXT_SIZE := if not CXT_LIVE or not CXT_ARRAY then ulong(0) else if CXT_NEW then NEW_TYPE_SIZE[?][LW_I - TYPE_COUNT] else TYPE_SIZE[CXT_OLD]
        | CXT_ELEMENT_TWIN := CX_TWIN[?][CXT_ELEMENT]
        | CXT_LOOKS := CXT_LIVE and CXT_ARRAY and CXT_ELEMENT_TWIN /= CXT_ELEMENT
        | CX_TWIN := CX_TWIN[?] next (if CXT_LIVE then LW_I else -1)
                     : (if CXT_SCALAR then (if LW_I = BUILTIN_COMPLEX then BUILTIN_REAL else BUILTIN_DREAL) else if CXT_LOOKS then LW_INTERNED else LW_I)
        | AT_LS_CXTABLE := LW_NOW = LS_CXTABLE
        | CXB_LIVE := AT_LS_CXTABLE and LW_I < TABLE_COUNT + NEW_TABLE_COUNT[?]
        | CXB_NEW := LW_I >= TABLE_COUNT
        | CXB_NEW_AT := if CXB_LIVE and CXB_NEW then LW_I - TABLE_COUNT else 0
        | CXB_OLD_AT := if CXB_LIVE and not CXB_NEW then LW_I else 0
        | CXB_TYPE := if CXB_NEW then NEW_TABLE_TYPE[?][CXB_NEW_AT] else TABLE_TYPE[CXB_OLD_AT]
        | CXB_FILL := NEW_TABLE_STEP[?][CXB_NEW_AT] = long(0) and NEW_TABLE_START[?][CXB_NEW_AT] > long(0)
        | CXB_CREATES := CXB_LIVE and (if CXB_NEW then CXB_FILL else not TABLE_FROM_STRING[CXB_OLD_AT]) and CX_TWIN[?][CXB_TYPE] /= CXB_TYPE
        | CXB_LENGTH := if not CXB_NEW then long(TABLE_LENGTH[CXB_OLD_AT]) else if CXB_TYPE >= TYPE_COUNT then long(NEW_TYPE_SIZE[?][CXB_TYPE - TYPE_COUNT])
                        else long(TYPE_SIZE[CXB_TYPE])
        | CX_TABLE_IM := CX_TABLE_IM[?] next (if CXB_CREATES and LW_GOES then LW_I else -1) : TABLE_COUNT + NEW_TABLE_COUNT[?] + 1
        | AT_LS_CXMAP := LW_NOW = LS_CXMAP
        | AT_LS_CXEXPAND := LW_NOW = LS_CXEXPAND
        | CXM_LIVE := AT_LS_CXMAP and LW_I < ROW_COUNT[?]
        | CXM_TYPE := ROWS_TYPE[?][LW_I]
        | CXM_COMPLEX := CXM_TYPE >= 0 and CX_TWIN[?][if CXM_TYPE >= 0 then CXM_TYPE else 0] /= CXM_TYPE
        | CXM_PROGRAM := CX_TYPED_PROGRAM[ROWS_OP[?][LW_I]]
        | CXM_IMAG := CXM_LIVE and CXM_COMPLEX and CXM_PROGRAM >= 0 and CXP_IMAG[if CXM_PROGRAM >= 0 then CXM_PROGRAM else 0] = 1
        | CX_IMAG := CX_IMAG[?] next (if CXM_IMAG then LW_I else -1) : ROW_COUNT[?] + CX_IMAG_COUNT[?] + 1
        | CX_IMAG_COUNT := CX_IMAG_COUNT[?] + integer(CXM_IMAG)
        | CXM_ENDS := AT_LS_CXMAP and not CXM_LIVE
        | CX_BASE := if CXM_ENDS then ROW_COUNT[?] else CX_BASE[?]
        | CXE_LIVE := AT_LS_CXEXPAND and LW_I < CX_BASE[?]
        | CXE_FIRST := LW_K = 0
        | CXE_OP := if CXE_FIRST then ROWS_OP[?][LW_I] else CXH_OP[?]
        | CXE_L := if CXE_FIRST then ROWS_LEFT[?][LW_I] else CXH_L[?]
        | CXE_R := if CXE_FIRST then ROWS_RIGHT[?][LW_I] else CXH_R[?]
        | CXE_TYPE := if CXE_FIRST then ROWS_TYPE[?][LW_I] else CXH_TYPE[?]
        | CXE_VALUE := if CXE_FIRST then ROWS_VALUE[?][LW_I] else CXH_VALUE[?]
        | CXH_OP := CXE_OP
        | CXH_L := CXE_L
        | CXH_R := CXE_R
        | CXH_TYPE := CXE_TYPE
        | CXH_VALUE := CXE_VALUE
        | CXE_IS_CX := CXE_TYPE >= 0 and CX_TWIN[?][if CXE_TYPE >= 0 then CXE_TYPE else 0] /= CXE_TYPE
        | CXE_L_IMAG := if CXE_L >= 0 then CX_IMAG[?][CXE_L] - 1 else -1
        | CXE_R_IMAG := if CXE_R >= 0 then CX_IMAG[?][CXE_R] - 1 else -1
        | CXE_PROGRAM := if not CXE_LIVE then -1 else if CXE_IS_CX then CX_TYPED_PROGRAM[CXE_OP]
                         else if CXE_L_IMAG >= 0 then CX_OPERAND_PROGRAM[CXE_OP] else -1
        | CXE_PROGRAM_SAFE := if CXE_PROGRAM >= 0 then CXE_PROGRAM else 0
        | CXE_STEPS := if CXE_PROGRAM >= 0 then CXP_LENGTH[CXE_PROGRAM_SAFE] else 0
        | CXE_FAILS := CXE_LIVE and CXE_FIRST and CXE_IS_CX and CXE_PROGRAM < 0
        | CXE_STEP_LIVE := CXE_LIVE and LW_K < CXE_STEPS and not CXE_FAILS
        | CXE_AT := CXP_START[CXE_PROGRAM_SAFE] + (if CXE_STEP_LIVE then LW_K else 0)
        | CXE_DEST := CXS_DEST[CXE_AT]
        | CXE_TARGET := if not CXE_STEP_LIVE then -1 else if CXE_DEST = CXD_RE then LW_I
                        else if CXE_DEST = CXD_IM then CX_IMAG[?][LW_I] - 1 else ROW_COUNT[?]
        | CXE_FULL := CXE_TARGET >= ROWS_CAP
        | CXE_SLOT := if CXE_FULL then -1 else CXE_TARGET
        | CXE_APPENDS := CXE_SLOT >= 0 and CXE_DEST /= CXD_RE
        | CXE_LEFT_REF := CXS_LEFT[CXE_AT]
        | CXE_RIGHT_REF := CXS_RIGHT[CXE_AT]
        | CXE_ROW_LEFT := if CXE_LEFT_REF = CXR_NONE then -1 else if CXE_LEFT_REF = CXR_AR or CXE_LEFT_REF = CXR_L then CXE_L
                          else if CXE_LEFT_REF = CXR_AI then CXE_L_IMAG else if CXE_LEFT_REF = CXR_BR or CXE_LEFT_REF = CXR_R then CXE_R
                          else if CXE_LEFT_REF = CXR_BI then CXE_R_IMAG else if CXE_LEFT_REF = CXR_SELF then LW_I
                          else if CXE_LEFT_REF = CXR_IMR then CX_IMAG[?][LW_I] - 1 else CX_TEMP[?][CXE_LEFT_REF - CX_TEMP_BASE]
        | CXE_ROW_RIGHT := if CXE_RIGHT_REF = CXR_NONE then -1 else if CXE_RIGHT_REF = CXR_AR or CXE_RIGHT_REF = CXR_L then CXE_L
                           else if CXE_RIGHT_REF = CXR_AI then CXE_L_IMAG else if CXE_RIGHT_REF = CXR_BR or CXE_RIGHT_REF = CXR_R then CXE_R
                           else if CXE_RIGHT_REF = CXR_BI then CXE_R_IMAG else if CXE_RIGHT_REF = CXR_SELF then LW_I
                           else if CXE_RIGHT_REF = CXR_IMR then CX_IMAG[?][LW_I] - 1 else CX_TEMP[?][CXE_RIGHT_REF - CX_TEMP_BASE]
        | CXE_LEFT_CTX_ROW := if CXE_LEFT_REF = CXR_AI then CXE_L else if CXE_LEFT_REF = CXR_BI then CXE_R
                              else if CXE_LEFT_REF = CXR_IMR then LW_I else CXE_ROW_LEFT
        | CXE_RIGHT_CTX_ROW := if CXE_RIGHT_REF = CXR_AI then CXE_L else if CXE_RIGHT_REF = CXR_BI then CXE_R
                               else if CXE_RIGHT_REF = CXR_IMR then LW_I else CXE_ROW_RIGHT
        | CXE_ROW_OP := if CXS_OP[CXE_AT] < 0 then CXE_OP else CXS_OP[CXE_AT]
        | CXE_COMPONENT := CX_TWIN[?][if CXE_TYPE >= 0 then CXE_TYPE else 0]
        | CXE_ROW_TYPE := if CXS_TYPE[CXE_AT] = CXT_C then CXE_COMPONENT else if CXS_TYPE[CXE_AT] = CXT_B then BUILTIN_BOOLEAN else CXE_TYPE
        | CXE_NARROW := CXE_ROW_TYPE = BUILTIN_REAL
        | CXE_ROW_ARRAY := CXE_ROW_TYPE >= TYPE_COUNT or CXE_ROW_TYPE >= 0 and TYPE_KIND[if CXE_ROW_TYPE >= 0 and CXE_ROW_TYPE < TYPE_COUNT then CXE_ROW_TYPE else 0] = TK_ARRAY
        | CXE_OWNER := if CXE_STEP_LIVE then ROWS_OWNER[?][LW_I] else -1
        | CXE_OWNER_IMAG := CXE_DEST = CXD_IM and CXE_ROW_OP /= OP_IMAG and CXE_ROW_ARRAY and CXE_OWNER >= 0 and CX_IMAG[?][if CXE_OWNER >= 0 then CXE_OWNER else 0] > 0
        | CXE_INIT := if CXE_STEP_LIVE then ROWS_INIT[?][LW_I] else 0
        | CXE_POOL := integer(CXE_VALUE) - 1
        | CXE_POOL_SAFE := if CXE_POOL >= 0 then CXE_POOL else 0
        | CXE_VALUE_CODE := CXS_VALUE[CXE_AT]
        | CXE_ROW_VALUE := if CXE_VALUE_CODE = CXV_KEEP then CXE_VALUE
                           else if CXE_VALUE_CODE = CXV_PRE then
                             (if CXE_POOL < 0 then long(0) else if CXE_NARROW then CX_RE32[CXE_POOL_SAFE] else CX_RE64[CXE_POOL_SAFE])
                           else if CXE_VALUE_CODE = CXV_PIM then
                             (if CXE_POOL < 0 then long(0) else if CXE_NARROW then CX_IM32[CXE_POOL_SAFE] else CX_IM64[CXE_POOL_SAFE])
                           else if CXE_VALUE_CODE = CXV_ONE then (if CXE_NARROW then long(1065353216) else long(4607182418800017408))
                           else if CXE_VALUE_CODE = CXV_INF then (if CXE_NARROW then long(2139095040) else long(9218868437227405312))
                           else if CXE_VALUE_CODE = CXV_NAN then (if CXE_NARROW then long(2143289344) else long(9221120237041090560))
                           else if CXE_VALUE_CODE = CXV_STATE_IM then long(CX_IMAG[?][integer(CXE_VALUE)] - 1)
                           else if CXE_VALUE_CODE = CXV_TABLE_IM then
                             (if CX_TABLE_IM[?][integer(CXE_VALUE)] > 0 then long(CX_TABLE_IM[?][integer(CXE_VALUE)] - 1) else CXE_VALUE)
                           else long(0)
        | CXE_ROW_CTX := if CXE_ROW_OP = OP_CONST then true
                         else if OP_MONOCHRONOUS[CXE_ROW_OP] = 1 then
                           ROWS_CTX[?][if CXE_LEFT_CTX_ROW >= 0 then CXE_LEFT_CTX_ROW else LW_I]
                           and (CXE_RIGHT_CTX_ROW < 0 or ROWS_CTX[?][if CXE_RIGHT_CTX_ROW >= 0 then CXE_RIGHT_CTX_ROW else 0])
                         else if CXE_ROW_OP = OP_DEFAULT then ROWS_CTX[?][if CXE_LEFT_CTX_ROW >= 0 then CXE_LEFT_CTX_ROW else LW_I]
                         else ROWS_CTX[?][LW_I]
        | CX_TEMP := CX_TEMP[?] next (if CXE_STEP_LIVE and CXE_DEST = CXD_TEMP then LW_K else -1) : ROW_COUNT[?]
        | CXE_ENDS := CXE_LIVE and (CXE_FAILS or LW_K + 1 >= CXE_STEPS)
        | AT_LS_MEMBERS := LW_NOW = LS_MEMBERS
        | AT_LS_PARTIAL := LW_NOW = LS_PARTIAL
        | LW_SIGNAL_LIVE := AT_LS_SIGNAL and LW_I < FLAT_SIGNAL_COUNT
        | LW_SIGNAL_SOURCE := FLAT_SIGNAL_SOURCE[LW_I]
        | LW_SIGNAL_KEY_NOW := if LW_SIGNAL_SOURCE >= 0 then SIGNAL_NAME[LW_SIGNAL_SOURCE] else FINISH_SIGNAL_NAME[-LW_SIGNAL_SOURCE - 1]
        | LW_SIGNAL_TYPE_RAW := if LW_SIGNAL_SOURCE >= 0 then SIGNAL_TYPE[LW_SIGNAL_SOURCE] else FINISH_SIGNAL_TYPE[-LW_SIGNAL_SOURCE - 1]
        | LW_SIGNAL_TYPE_NOW := if LW_SIGNAL_TYPE_RAW < -1 then BIND_TYPE[INSTANCE_BIND_START[FLAT_SIGNAL_INSTANCE[LW_I]] - LW_SIGNAL_TYPE_RAW - 2]
                              else LW_SIGNAL_TYPE_RAW
        | LW_SIGNAL_INPUT := FLAT_SIGNAL_INSTANCE[LW_I] = 0
                             and (if LW_SIGNAL_SOURCE >= 0 then SIGNAL_ROLE[LW_SIGNAL_SOURCE] else FINISH_SIGNAL_ROLE[-LW_SIGNAL_SOURCE - 1]) = ROLE_INPUT
        | LW_STATEVAR_LIVE := AT_LS_STATEVAR and LW_I < FLAT_SIGNAL_COUNT
        | LW_STATEVAR_SOURCE := if LW_STATEVAR_LIVE then FLAT_SIGNAL_SOURCE[LW_I] else -1
        | LW_STATEVAR_CREATES := LW_STATEVAR_SOURCE >= 0 and SIGNAL_STATEVAR[if LW_STATEVAR_SOURCE >= 0 then LW_STATEVAR_SOURCE else 0]
        | LW_STATEVAR_DECL := if LW_STATEVAR_SOURCE >= 0 then LW_STATEVAR_SOURCE else 0
        | LW_STATEVAR_INIT_KIND := SIGNAL_INIT_KIND[LW_STATEVAR_DECL]
        | LW_STATEVAR_CONSTANT := NAME_CONSTANT[SIGNAL_INIT_NAME[LW_STATEVAR_DECL]] - 1
        | LW_STATEVAR_HOLDS := LW_STATEVAR_SOURCE >= 0 and (SIGNAL_STATEVAR[LW_STATEVAR_DECL] or SIGNAL_SHARED[LW_STATEVAR_DECL])
                               and LW_STATEVAR_INIT_KIND /= INIT_NONE
        | LW_STATEVAR_ENUM := LW_STATEVAR_HOLDS and LW_STATEVAR_INIT_KIND = INIT_ENUMCONST
        | LW_STATEVAR_INIT := if LW_STATEVAR_INIT_KIND = INIT_NONE then long(0)
                              else if LW_STATEVAR_INIT_KIND = INIT_NAME then CONSTANT_VALUE[if LW_STATEVAR_CONSTANT >= 0 then LW_STATEVAR_CONSTANT else 0]
                              else if LW_STATEVAR_ENUM then long(LK_VALUE)
                              else SIGNAL_INIT_VALUE[LW_STATEVAR_DECL]
        | LW_LABEL_LIVE := AT_LS_LABEL and LW_I < FLAT_LABEL_COUNT
        | LW_VALUE_TYPE_LIVE := AT_LS_VALUE and LW_I < TYPE_COUNT
        | LW_VALUE_LIVE := LW_VALUE_TYPE_LIVE and LW_K < TYPE_VALUE_COUNT[LW_I]
        | LW_VALUE_KEY := VALUE_NAME[TYPE_VALUE_START[LW_I] + LW_K]
        | LW_ARRAY_LIVE := AT_LS_ARRAY and LW_I < TYPE_COUNT and TYPE_KIND[LW_I] = TK_ARRAY
        | LW_TABLE_LIVE := AT_LS_TABLE and LW_I < TABLE_COUNT
        | LW_TABLE_TYPE := TABLE_TYPE[LW_I]
        | LW_TABLE_CANDIDATE := LW_TABLE_LIVE and not TABLE_FROM_STRING[LW_I] and TYPE_KIND[LW_TABLE_TYPE] = TK_ARRAY
                                and TYPE_ELEMENT[LW_TABLE_TYPE] = BUILTIN_INTEGER
                                and TYPE_SIZE[LW_TABLE_TYPE] = ulong(TABLE_LENGTH[LW_I]) and LW_IOTA[?][LW_TABLE_TYPE] = 0
        | LW_TABLE_WALKS := LW_TABLE_LIVE and not TABLE_FROM_STRING[LW_I] and LW_K < TABLE_LENGTH[LW_I]
        | LW_TABLE_ELEMENT := POOL_VALUE[TABLE_START[LW_I] + LW_K]
        | LW_TABLE_MATCHES := LW_TABLE_ELEMENT = long(LW_K)
        | LW_TABLE_LOW := if LW_K = 0 or LW_TABLE_ELEMENT < LW_TABLE_LOW[?] then LW_TABLE_ELEMENT else LW_TABLE_LOW[?]
        | LW_TABLE_HIGH := if LW_K = 0 or LW_TABLE_ELEMENT > LW_TABLE_HIGH[?] then LW_TABLE_ELEMENT else LW_TABLE_HIGH[?]
        | TABLE_LOW := TABLE_LOW[?] next (if LW_TABLE_WALKS then LW_I else -1) : LW_TABLE_LOW
        | TABLE_HIGH := TABLE_HIGH[?] next (if LW_TABLE_WALKS then LW_I else -1) : LW_TABLE_HIGH
        | LW_TABLE_OK := if LW_K = 0 then LW_TABLE_MATCHES else LW_TABLE_OK[?] and LW_TABLE_MATCHES
        | LW_TABLE_IOTA := LW_TABLE_CANDIDATE and not LW_TABLE_WALKS and (LW_K = 0 or LW_TABLE_OK[?])
        | LW_LOOP_LIVE := AT_LS_LOOP and LW_I < FLAT_LOOP_COUNT
        | LW_LOOP_SOURCE := FLAT_LOOP_SOURCE[LW_I]
        | LW_LOOP_RANK := if LW_LOOP_LIVE then LOOP_RANK[LW_LOOP_SOURCE] else 1
        | LW_LOOP_NAME := if LW_K = 0 then LOOP_NAME[LW_LOOP_SOURCE] else LOOP_LEVEL_NAME[4 * LW_LOOP_SOURCE + LW_K]
        | LW_LOOP_TOKEN := if LW_K = 0 then LOOP_TOKEN[LW_LOOP_SOURCE] else LOOP_LEVEL_TOKEN[4 * LW_LOOP_SOURCE + LW_K]
        | LW_LEVEL_ROW := LW_LOOP_LIVE and LW_K > 0
        | LW_LOOP_MORE := LW_LOOP_LIVE and LW_K + 1 < LW_LOOP_RANK
        | LW_EQUATION_LIVE := AT_LS_EQUATION and LW_I < FLAT_EQUATION_COUNT
        | LW_EQ_TARGET := FLAT_EQUATION_TARGET[LW_I]
        | LW_EQ_TARGET_INSTANCE := FLAT_EQUATION_TARGET_INSTANCE[LW_I]
        | LW_EQ_SEED := FLAT_EQUATION_SEED[LW_I]
        | LW_EQ_LOOP := FLAT_EQUATION_LOOP[LW_I]
        | LW_EQ_TOKEN := FLAT_EQUATION_TOKEN[LW_I]
        | LW_EQ_LOOP_NAME := LOOP_NAME[FLAT_LOOP_SOURCE[LW_EQ_LOOP]]
        | LW_EQ_LOOP_INSTANCE := FLAT_LOOP_INSTANCE[LW_EQ_LOOP]
        | LW_LOOP_DEFINES := LW_EQ_LOOP >= 0 and not LW_EQ_SEED and LW_EQ_TARGET >= 0
        | LW_GUARD_NODE := if AT_LS_GROUP then FLAT_GROUP_GUARDS[LW_I] else FLAT_EQUATION_GUARDS[LW_I]
        | LW_GUARD_CONTEXT := if AT_LS_GROUP then FLAT_GROUP_INSTANCE[LW_I] else FLAT_EQUATION_CONTEXT[LW_I]
        | LW_GUARD_NODE_LENGTH := if LW_GUARD_NODE < 0 then 0 else GUARD_PATH_LENGTH[LW_GUARD_NODE]
        | LW_GUARD_INHERITED := INSTANCE_GUARD_LENGTH[LW_GUARD_CONTEXT]
        | LW_GUARD_LAST := PATH_VALUE[GUARD_PATH_START[LW_GUARD_NODE] + LW_GUARD_NODE_LENGTH - 1]
        | LW_GUARD_AT := INSTANCE_GUARD_START[LW_GUARD_CONTEXT] + LW_GUARD_INHERITED - 1
        | LW_GUARD_KEY := if LW_GUARD_NODE_LENGTH > 0
                          then N_ON_MARK + (LW_GUARD_LAST - MODEL_GUARD_START[GUARD_MODEL[LW_GUARD_LAST]] + 1) * NAME_CAP
                          else FLAT_PATH_KEY[LW_GUARD_AT]
        | LW_GUARD_INSTANCE := if LW_GUARD_NODE_LENGTH > 0 then LW_GUARD_CONTEXT else FLAT_PATH_INSTANCE[LW_GUARD_AT]
        | LW_HAS_GUARD := LW_GUARD_NODE_LENGTH > 0 or LW_GUARD_INHERITED > 0
        | LW_EQ_STEP := if not LW_EQUATION_LIVE then 3
                        else if LW_K <= 0 and LW_EQ_TARGET >= 0 then 0
                        else if LW_K <= 1 and LW_LOOP_DEFINES then 1
                        else if LW_K <= 2 and LW_HAS_GUARD then 2 else 3
        | LW_EQ_MORE := LW_EQ_STEP < 1 and LW_LOOP_DEFINES or LW_EQ_STEP < 2 and LW_HAS_GUARD
        | LW_GROUP_LIVE := AT_LS_GROUP and LW_I < FLAT_GROUP_COUNT
        | LW_START_LIVE := AT_LS_START and LW_I < FLAT_EQUATION_COUNT
        | LW_START_SIGNAL := LW_EQ_SIGNAL[?][LW_I] - 1
        | LW_E := LW_ENTRY[?]
        | LW_END_NOW := LW_FL_END[?]
        | LW_SCAN_LIVE := AT_LS_SCAN and LW_E < LW_END_NOW
        | LW_ENTRY_LIVE := AT_LS_ENTRY and LW_E < LW_END_NOW
        | LW_FINISHING_RAW := AT_LS_ENTRY and LW_E >= LW_END_NOW
        | LW_FINISHING := LW_FINISHING_RAW and not PW_STORES
        | LW_SRC := FLAT_ENTRY_SOURCE[LW_E]
        | LW_OP := FLAT_ENTRY_OP[LW_E]
        | LW_NAME := FLAT_ENTRY_NAME[LW_E]
        | LW_INST := FLAT_ENTRY_INSTANCE[LW_E]
        | LW_ENTRY_TOKEN := FINAL_TOKEN[LW_SRC]
        | LW_LOOP_NOW := LW_FL_LOOP[?]
        | LW_TOP_NOW := LW_TOP[?]
        | LW_SCAN_READS := LW_SCAN_LIVE and LW_OP = OP_SIGNAL
        | LW_IS_SIGNAL := LW_ENTRY_LIVE and LW_OP = OP_SIGNAL
        | LW_SEED_TARGET_AT := if not LW_EQ_SEED then -1
                             else if LW_FL_START[?] + 2 < LW_END_NOW and FLAT_ENTRY_OP[LW_FL_START[?] + 2] = OP_TARGET_INDEX then LW_FL_START[?] + 2
                             else if LW_FL_START[?] + 4 < LW_END_NOW and FLAT_ENTRY_OP[LW_FL_START[?] + 4] = OP_TARGET_INDEX then LW_FL_START[?] + 4
                             else if LW_FL_START[?] + 6 < LW_END_NOW and FLAT_ENTRY_OP[LW_FL_START[?] + 6] = OP_TARGET_INDEX then LW_FL_START[?] + 6
                             else -1
        | LW_SEED_INDEXING := LW_E > LW_FL_START[?] and LW_E < LW_SEED_TARGET_AT
        | LW_ITER_CONTEXT := if LW_LOOP_NOW >= 0 and LW_LOOP_NOW < FLAT_LOOP_COUNT then LW_LOOP_NOW
                             else if LW_SEED_INDEXING and LW_EQ_LOOP >= 0 and LW_EQ_LOOP < FLAT_LOOP_COUNT then LW_EQ_LOOP else -1
        | LW_ITER_LOOP := if LW_ITER_CONTEXT >= 0 then LW_ITER_CONTEXT else 0
        | LW_ITER_SOURCE := FLAT_LOOP_SOURCE[LW_ITER_LOOP]
        | LW_ITER_RANK := LOOP_RANK[LW_ITER_SOURCE]
        | LW_ITER_LEVEL := if LW_NAME = LOOP_NAME[LW_ITER_SOURCE] then 0
                           else if LW_ITER_RANK > 1 and LW_NAME = LOOP_LEVEL_NAME[4 * LW_ITER_SOURCE + 1] then 1
                           else if LW_ITER_RANK > 2 and LW_NAME = LOOP_LEVEL_NAME[4 * LW_ITER_SOURCE + 2] then 2
                           else if LW_ITER_RANK > 3 and LW_NAME = LOOP_LEVEL_NAME[4 * LW_ITER_SOURCE + 3] then 3 else -1
        | LW_IS_ITER := LW_IS_SIGNAL and LW_ITER_CONTEXT >= 0 and LW_ITER_LEVEL >= 0 and LW_INST = FLAT_LOOP_INSTANCE[LW_ITER_LOOP]
        | LW_ITER_ROW := if LW_ITER_LEVEL <= 0 then LOOP_INDEX[?][LW_ITER_LOOP] else LEVEL_SIGNAL[?][4 * LW_ITER_LOOP + LW_ITER_LEVEL]
        | LW_LOOKS_SIGNAL := LW_IS_SIGNAL and not LW_IS_ITER
        | LW_IS_SLOT := LW_OP = OP_SLOT
        | LW_IS_CONST := LW_ENTRY_LIVE and (LW_OP = OP_CONST or LW_IS_SLOT)
        | LW_BIND_ROW := if LW_IS_SLOT then INSTANCE_BIND_START[LW_INST] + LW_NAME else 0
        | LW_IS_EFFECT := LW_ENTRY_LIVE and LW_OP = OP_EFFECT
        | LW_INITIAL := FINAL_AUX[LW_SRC]
        | LW_COUNT := if LW_RIGHT >= 0 then ROWS_VALUE[?][LW_RIGHT] else long(1)
        | LW_COUNT_OK := LW_RIGHT >= 0 and LW_RIGHT_OP = OP_CONST and RT_INT and LW_COUNT >= long(1)
        | LW_INIT_TYPE := FINAL_TYPE[LW_SRC]
        | LW_INIT_TABLE := LW_INITIAL = 1 and LW_INIT_TYPE >= 0 and LW_INIT_TYPE < TYPE_COUNT
                           and (TYPE_KIND[LW_INIT_TYPE] = TK_ARRAY or TYPE_KIND[LW_INIT_TYPE] = TK_STRING)
        | LW_GD_PLAIN := LW_OP = OP_GDELAY and LW_COUNT_OK and LW_COUNT = long(1) and not LT_BLOCK and not LW_INIT_TABLE
        | LW_IS_DELAY := LW_ENTRY_LIVE and (LW_OP = OP_DELAY and not LT_BLOCK or LW_GD_PLAIN)
        | LW_IS_LAG := LW_OPERATOR and (LW_OP = OP_DELAY and LT_BLOCK or LW_OP = OP_GDELAY and not LW_GD_PLAIN)
        | LW_IS_WINDOW := LW_OPERATOR and LW_OP = OP_WINDOW
        | LW_LAG_COUNT := if LW_OP = OP_DELAY then long(1) else LW_COUNT
        | LG_E1 := LT_ELEMENT
        | LG_E1_NEW := LG_E1 >= TYPE_COUNT
        | LG_A2 := LT_BLOCK and (LG_E1_NEW or TYPE_KIND[LG_E1] = TK_ARRAY)
        | LG_S2 := if not LG_A2 then ulong(1) else if LG_E1_NEW then NEW_TYPE_SIZE[?][LG_E1 - TYPE_COUNT] else TYPE_SIZE[LG_E1]
        | LG_E2 := if not LG_A2 then LG_E1 else if LG_E1_NEW then NEW_TYPE_ELEMENT[?][LG_E1 - TYPE_COUNT] else TYPE_ELEMENT[LG_E1]
        | LG_E2_SAFE := if LG_E2 < TYPE_COUNT then LG_E2 else 0
        | LG_A3 := LG_A2 and TYPE_KIND[LG_E2_SAFE] = TK_ARRAY
        | LG_E3 := if LG_A3 then TYPE_ELEMENT[LG_E2_SAFE] else LG_E2
        | LG_A4 := LG_A3 and TYPE_KIND[LG_E3] = TK_ARRAY
        | LG_LEAF := if not LT_BLOCK then LT else if LG_A4 then TYPE_ELEMENT[LG_E3] else LG_E3
        | LI_TYPE := if LW_INIT_TABLE then LW_INIT_TYPE else 0
        | LI_E1 := TYPE_ELEMENT[LI_TYPE]
        | LI_A2 := TYPE_KIND[LI_E1] = TK_ARRAY
        | LI_E2 := if LI_A2 then TYPE_ELEMENT[LI_E1] else LI_E1
        | LI_A3 := LI_A2 and TYPE_KIND[LI_E2] = TK_ARRAY
        | LI_E3 := if LI_A3 then TYPE_ELEMENT[LI_E2] else LI_E2
        | LI_A4 := LI_A3 and TYPE_KIND[LI_E3] = TK_ARRAY
        | LI_LEAF := if not LW_INIT_TABLE then (if LW_INIT_TYPE >= 0 and LW_INIT_TYPE < TYPE_COUNT then LW_INIT_TYPE else 0)
                     else if LI_A4 then TYPE_ELEMENT[LI_E3] else LI_E3
        | LI_FITS := LI_LEAF = LG_LEAF
                     or TYPE_KIND[LI_LEAF] = TK_INT and TYPE_KIND[LG_LEAF] = TK_INT
                        and (if TYPE_SIGNED[LI_LEAF] = TYPE_SIGNED[LG_LEAF] then TYPE_BYTES[LI_LEAF] <= TYPE_BYTES[LG_LEAF]
                             else TYPE_SIGNED[LG_LEAF] and TYPE_BYTES[LG_LEAF] > TYPE_BYTES[LI_LEAF])
        | LW_NEEDED := if LW_IS_WINDOW then LW_COUNT - long(1) else LW_LAG_COUNT
        | LG_RANK := if not LT_BLOCK then 0 else 1 + integer(LG_A2) + integer(LG_A3) + integer(LG_A4)
        | LG_D3 := TYPE_SIZE[LG_E2_SAFE]
        | LI_RANK := 1 + integer(LI_A2) + integer(LI_A3) + integer(LI_A4)
        | LI_D1 := TYPE_SIZE[LI_TYPE]
        | LI_D2 := TYPE_SIZE[LI_E1]
        | LI_D3 := TYPE_SIZE[LI_E2]
        | LI_D4 := TYPE_SIZE[LI_E3]
        | LI_BLOCKS_OK := LI_RANK = LG_RANK + 1 and (LG_RANK < 1 or LI_D2 = LT_SIZE) and (LG_RANK < 2 or LI_D3 = LG_S2)
                          and (LG_RANK < 3 or LI_D4 = LG_D3) and long(LI_D1) >= LW_NEEDED
        | LI_SINGLE_OK := LG_RANK >= 1 and LG_RANK <= 3 and LW_NEEDED = long(1) and LI_RANK = LG_RANK and LI_D1 = LT_SIZE
                          and (LG_RANK < 2 or LI_D2 = LG_S2) and (LG_RANK < 3 or LI_D3 = LG_D3)
        | LI_SCALAR_OK := LW_IS_WINDOW and LW_INITIAL = 1 and not LW_INIT_TABLE and LG_RANK = 0 and LW_NEEDED = long(1)
        | LW_INIT_SHAPE_FAILS := not (LW_INIT_TABLE and (LI_BLOCKS_OK or LI_SINGLE_OK) or LI_SCALAR_OK) or not LI_FITS
                                 or LW_INIT_TABLE and (TYPE_KIND[LW_INIT_TYPE] = TK_STRING) /= (LT_KIND = TK_STRING)
        | LW_IS_ENUM := LW_ENTRY_LIVE and LW_OP = OP_ENUMCONST
        | LW_ENUM_LIVE := LW_IS_ENUM or LW_IS_DELAY and LW_INITIAL = 2
        | LW_IS_DEFAULTS := LW_ENTRY_LIVE and LW_OP = OP_DEFAULTS
        | LW_IS_LEAF := LW_IS_SIGNAL or LW_IS_CONST or LW_IS_ENUM or LW_IS_DEFAULTS
        | OW_TYPE := if LW_SIGNAL_NOW >= 0 then ROWS_TYPE[?][LW_SIGNAL_NOW] else BUILTIN_INTEGER
        | OW_ARRAY := OW_TYPE < TYPE_COUNT and TYPE_KIND[OW_TYPE] = TK_ARRAY
        | OW_E1 := if OW_ARRAY then TYPE_ELEMENT[OW_TYPE] else OW_TYPE
        | OW_E2 := if TYPE_KIND[OW_E1] = TK_ARRAY then TYPE_ELEMENT[OW_E1] else OW_E1
        | OW_E3 := if TYPE_KIND[OW_E2] = TK_ARRAY then TYPE_ELEMENT[OW_E2] else OW_E2
        | OW_LEAF := if TYPE_KIND[OW_E3] = TK_ARRAY then TYPE_ELEMENT[OW_E3] else OW_E3
        | OW_RANK_ONE := OW_ARRAY and TYPE_KIND[OW_E1] /= TK_ARRAY
        | LW_IS_TARGET_INDEX := LW_OPERATOR and LW_OP = OP_TARGET_INDEX
        | LW_IS_RESTRUCTURE := LW_OPERATOR and LW_OP = OP_PAIR and LW_NEXT_OP < 0 and LW_LOOP_NOW < 0 and LW_SIGNAL_NOW >= 0
                               and not LW_MEMBER_NOW and not LW_EQ_SEED and LW_EQ_PARTIAL = 0
        | LW_IS_CONCAT := LW_OPERATOR and LW_OP = OP_CONCAT
        | LW_ARRAY_EQ := LW_OPERATOR and LW_OP = OP_EQ and integer(TOKEN_CODE[LW_ENTRY_TOKEN]) = C_EQUAL_EQUAL
                         and (LT_KIND = TK_ARRAY or RT_KIND = TK_ARRAY)
        | RS_SCATTER := LT_KIND = TK_ARRAY
        | RS_SHAPE_FAILS := TYPE_KIND[LT_ELEMENT] /= TK_INT or RT_KIND /= TK_ARRAY or RT_SIZE /= LT_SIZE or RT_ELEMENT /= OW_E1
        | OW_TOTAL := long(TYPE_SIZE[OW_TYPE]) * (if TYPE_KIND[OW_E1] = TK_ARRAY then long(TYPE_SIZE[OW_E1]) else long(1))
                      * (if TYPE_KIND[OW_E2] = TK_ARRAY then long(TYPE_SIZE[OW_E2]) else long(1))
                      * (if TYPE_KIND[OW_E3] = TK_ARRAY then long(TYPE_SIZE[OW_E3]) else long(1))
        | LW_IS_RANGE_TABLE := LW_OPERATOR and LW_OP = OP_RANGE_TABLE
        | LW_IS_STEP := LW_OPERATOR and LW_OP = OP_STEP or LW_IS_RANGE_TABLE
        | SP_A := if LW_IS_RANGE_TABLE then LW_LEFT else ROWS_LEFT[?][LW_LEFT]
        | SP_B := if LW_IS_RANGE_TABLE then LW_RIGHT else ROWS_RIGHT[?][LW_LEFT]
        | SP_A_OP := ROWS_OP[?][SP_A]
        | SP_B_OP := ROWS_OP[?][SP_B]
        | SP_A_INNER := ROWS_LEFT[?][SP_A]
        | SP_B_INNER := ROWS_LEFT[?][SP_B]
        | SP_C_INNER := ROWS_LEFT[?][LW_RIGHT]
        | SP_A_CONST := (SP_A_OP = OP_CONST or SP_A_OP = OP_NEG and ROWS_OP[?][SP_A_INNER] = OP_CONST) and TYPE_KIND[ROWS_TYPE[?][SP_A]] = TK_INT
        | SP_B_CONST := (SP_B_OP = OP_CONST or SP_B_OP = OP_NEG and ROWS_OP[?][SP_B_INNER] = OP_CONST) and TYPE_KIND[ROWS_TYPE[?][SP_B]] = TK_INT
        | SP_C_CONST := LW_IS_RANGE_TABLE or (LW_RIGHT_OP = OP_CONST or LW_RIGHT_OP = OP_NEG and ROWS_OP[?][SP_C_INNER] = OP_CONST) and RT_INT
        | SP_START := if SP_A_OP = OP_CONST then ROWS_VALUE[?][SP_A] else -ROWS_VALUE[?][SP_A_INNER]
        | SP_END := if SP_B_OP = OP_CONST then ROWS_VALUE[?][SP_B] else -ROWS_VALUE[?][SP_B_INNER]
        | SP_STEP := if LW_IS_RANGE_TABLE then long(1) else if LW_RIGHT_OP = OP_CONST then ROWS_VALUE[?][LW_RIGHT] else -ROWS_VALUE[?][SP_C_INNER]
        | SP_FAILS := not LW_IS_RANGE_TABLE and LW_LEFT_OP /= OP_SPAN or not SP_A_CONST or not SP_B_CONST or not SP_C_CONST
        | SP_COUNT := if SP_STEP > long(0) and SP_END >= SP_START then (SP_END - SP_START) / SP_STEP + long(1)
                      else if SP_STEP < long(0) and SP_START >= SP_END then (SP_START - SP_END) / -SP_STEP + long(1) else long(0)
        | SP_EMPTY := SP_COUNT <= long(0) or SP_COUNT >= long(2147483648)
        | PUT_DEPTH := integer(FINAL_VALUE[LW_SRC] modulo long(8))
        | PUT_PATH := FINAL_VALUE[LW_SRC] / long(8)
        | PUT_P1 := PUT_PATH modulo long(32768)
        | PUT_P2 := PUT_PATH / long(32768) modulo long(32768)
        | PUT_P3 := PUT_PATH / long(1073741824) modulo long(32768)
        | PUT_P4 := PUT_PATH / long(35184372088832) modulo long(32768)
        | PUT_S1 := long(LT_SIZE)
        | PUT_S2 := if SB_A2 then long(TYPE_SIZE[SB_E1]) else long(1)
        | PUT_S3 := if SB_A3 then long(TYPE_SIZE[SB_E2]) else long(1)
        | PUT_S4 := if SB_A4 then long(TYPE_SIZE[SB_E3]) else long(1)
        | PUT_OFFSET := ((PUT_P1 * PUT_S2 + (if SB_A2 then PUT_P2 else long(0))) * PUT_S3 + (if SB_A3 then PUT_P3 else long(0))) * PUT_S4
                        + (if SB_A4 then PUT_P4 else long(0))
        | PUT_BEFORE := if LW_LEFT_OP = OP_PUT then ROWS_VALUE[?][LW_LEFT] else long(-1)
        | PUT_ENDS := LW_E + 1 >= LW_END_NOW
        | PUT_SHAPE_FAILS := SB_KIND /= TK_ARRAY or LW_LEFT_OP /= OP_PUT and LW_LEFT_OP /= OP_TABLE or PUT_DEPTH /= SB_RANK
                             or PUT_P1 >= PUT_S1 or PUT_P2 >= PUT_S2 or PUT_P3 >= PUT_S3 or PUT_P4 >= PUT_S4
                             or PUT_OFFSET /= PUT_BEFORE + long(1)
                             or PUT_ENDS and PUT_OFFSET /= PUT_S1 * PUT_S2 * PUT_S3 * PUT_S4 - long(1)
        | LW_OPERATOR_ENTRY := LW_ENTRY_LIVE and not LW_IS_LEAF and not LW_IS_EFFECT
        | LW_OPERATOR := LW_OPERATOR_ENTRY and not PW_EACH
        | LW_UNARY := LW_OP = OP_CALL or OP_ARITY[LW_OP] = 1
        | PW_NOW := LW_FL_EW[?]
        | PW_CODE := integer(TOKEN_CODE[LW_ENTRY_TOKEN])
        | PW_POINTWISE := OP_POINTWISE[LW_OP] = 1 and PW_CODE /= C_EQUAL_EQUAL and PW_CODE /= C_LESS_LESS_EQUAL
                          or LW_OP = OP_CALL and LW_NAME /= N_INDICES
        | PW_EACH := LW_OPERATOR_ENTRY and PW_NOW and PW_POINTWISE and (LT_KIND = TK_ARRAY or LW_RIGHT >= 0 and RT_KIND = TK_ARRAY)
        | PW_ON_LEFT := LT_KIND = TK_ARRAY
        | PW_SUBJECT := if PW_ON_LEFT then LW_LEFT else LW_RIGHT
        | PW_SLOT := if PW_ON_LEFT then LW_TOP_NOW - (if LW_UNARY then 1 else 2) else LW_TOP_NOW - 1
        | PW_TYPE := ROWS_TYPE[?][PW_SUBJECT]
        | PW_NEW := PW_TYPE >= TYPE_COUNT
        | PW_S1 := if PW_NEW then NEW_TYPE_SIZE[?][PW_TYPE - TYPE_COUNT] else TYPE_SIZE[PW_TYPE]
        | PW_E1 := if PW_NEW then NEW_TYPE_ELEMENT[?][PW_TYPE - TYPE_COUNT] else TYPE_ELEMENT[PW_TYPE]
        | PW_A2 := TYPE_KIND[PW_E1] = TK_ARRAY
        | PW_E2 := if PW_A2 then TYPE_ELEMENT[PW_E1] else PW_E1
        | PW_A3 := TYPE_KIND[PW_E2] = TK_ARRAY
        | PW_E3 := if PW_A3 then TYPE_ELEMENT[PW_E2] else PW_E2
        | PW_A4 := TYPE_KIND[PW_E3] = TK_ARRAY
        | PW_LEAF := if PW_A4 then TYPE_ELEMENT[PW_E3] else PW_E3
        | PW_RANK := 1 + integer(PW_A2) + integer(PW_A3) + integer(PW_A4)
        | OW_RANK := integer(OW_ARRAY) + integer(TYPE_KIND[OW_E1] = TK_ARRAY) + integer(TYPE_KIND[OW_E2] = TK_ARRAY)
                     + integer(TYPE_KIND[OW_E3] = TK_ARRAY)
        | LW_IS_TRANSPOSE := LW_OPERATOR and LW_OP = OP_TRANSPOSE
        | LW_IS_MATPROD := LW_OPERATOR and LW_OP = OP_MATPROD
        | MX_L_E1 := if LT_KIND = TK_ARRAY and not LT_NEW then LT_ELEMENT else -1
        | MX_L_E1S := if MX_L_E1 >= 0 then MX_L_E1 else 0
        | MX_L_E2 := if TYPE_KIND[MX_L_E1S] = TK_ARRAY then TYPE_ELEMENT[MX_L_E1S] else MX_L_E1S
        | MX_L_RANK := if MX_L_E1 < 0 then 0 else if TYPE_KIND[MX_L_E1S] /= TK_ARRAY then 1 else if TYPE_KIND[MX_L_E2] /= TK_ARRAY then 2 else 3
        | MX_L_LEAF := if MX_L_RANK = 2 then MX_L_E2 else MX_L_E1
        | MX_L_ROWS := if MX_L_RANK = 2 then LT_SIZE else ulong(1)
        | MX_L_COLS := if MX_L_RANK = 2 then TYPE_SIZE[MX_L_E1S] else LT_SIZE
        | MX_R_E1 := if LW_RIGHT >= 0 and RT_KIND = TK_ARRAY and not RT_NEW then RT_ELEMENT else -1
        | MX_R_E1S := if MX_R_E1 >= 0 then MX_R_E1 else 0
        | MX_R_E2 := if TYPE_KIND[MX_R_E1S] = TK_ARRAY then TYPE_ELEMENT[MX_R_E1S] else MX_R_E1S
        | MX_R_RANK := if MX_R_E1 < 0 then 0 else if TYPE_KIND[MX_R_E1S] /= TK_ARRAY then 1 else if TYPE_KIND[MX_R_E2] /= TK_ARRAY then 2 else 3
        | MX_R_LEAF := if MX_R_RANK = 2 then MX_R_E2 else MX_R_E1
        | MX_R_COLS := if MX_R_RANK = 2 then TYPE_SIZE[MX_R_E1S] else ulong(1)
        | MX_DOT := MX_L_RANK = 1 and MX_R_RANK = 1
        | MX_WHOLE := LW_NEXT_OP < 0 and LW_LOOP_NOW < 0 and LW_SIGNAL_NOW >= 0 and not LW_MEMBER_NOW and not LW_EQ_SEED
                      and LW_EQ_PARTIAL = 0 and OW_ARRAY
        | MX_OPERANDS_FAIL := MX_L_RANK < 1 or MX_L_RANK > 2 or MX_R_RANK < 1 or MX_R_RANK > 2 or MX_L_LEAF /= MX_R_LEAF
                              or MX_L_COLS /= RT_SIZE
        | MX_TRANSPOSE_FAILS := OW_RANK /= 2 or TYPE_SIZE[OW_TYPE] /= MX_L_COLS or TYPE_SIZE[OW_E1] /= MX_L_ROWS or OW_LEAF /= MX_L_LEAF
        | MX_PRODUCT_FAILS := OW_LEAF /= MX_L_LEAF
                              or (if MX_L_RANK = 2 and MX_R_RANK = 2
                                  then OW_RANK /= 2 or TYPE_SIZE[OW_TYPE] /= MX_L_ROWS or TYPE_SIZE[OW_E1] /= MX_R_COLS
                                  else OW_RANK /= 1 or TYPE_SIZE[OW_TYPE] /= MX_L_ROWS * MX_R_COLS)
        | PW_SHAPE_FAILS := PW_RANK /= OW_RANK or PW_S1 /= TYPE_SIZE[OW_TYPE] or PW_A2 and TYPE_SIZE[PW_E1] /= TYPE_SIZE[OW_E1]
                            or PW_A3 and TYPE_SIZE[PW_E2] /= TYPE_SIZE[OW_E2] or PW_A4 and TYPE_SIZE[PW_E3] /= TYPE_SIZE[OW_E3]
        | PW_MESSAGE := if PW_SUBJECT >= FLAT_SIGNAL_COUNT and ROWS_OP[?][PW_SUBJECT] /= OP_TABLE then T_ARRAY_VALUE
                        else if PW_SHAPE_FAILS then T_EXTENSION_SHAPE else 0
        | PW_STORE_CANDIDATE := LW_FINISHING_RAW and PW_NOW and PW_SEEN[?] and not PW_STORED[?]
        | PW_VALUE_TYPE := LW_END_TOP_TYPE
        | PW_FITS := PW_VALUE_TYPE = OW_LEAF
                     or TYPE_KIND[OW_LEAF] = TK_BOOLEAN and TYPE_KIND[PW_VALUE_TYPE] = TK_EVENT
                     or TYPE_KIND[PW_VALUE_TYPE] = TK_INT and TYPE_KIND[OW_LEAF] = TK_INT
                        and (if TYPE_SIGNED[PW_VALUE_TYPE] = TYPE_SIGNED[OW_LEAF] then TYPE_BYTES[PW_VALUE_TYPE] <= TYPE_BYTES[OW_LEAF]
                             else TYPE_SIGNED[OW_LEAF] and TYPE_BYTES[OW_LEAF] > TYPE_BYTES[PW_VALUE_TYPE])
        | PW_STORES := PW_STORE_CANDIDATE and PW_FITS
        | PW_TOP_ENTRY := if FLAT_EQUATION_END[LW_I] > 0 then FLAT_EQUATION_END[LW_I] - 1 else 0
        | PW_TOP_OP := FLAT_ENTRY_OP[PW_TOP_ENTRY]
        | PW_TOP_CODE := integer(TOKEN_CODE[FINAL_TOKEN[FLAT_ENTRY_SOURCE[PW_TOP_ENTRY]]])
        | PW_TOP_POINTWISE := OP_POINTWISE[PW_TOP_OP] = 1 and PW_TOP_CODE /= C_EQUAL_EQUAL and PW_TOP_CODE /= C_LESS_LESS_EQUAL
                              or PW_TOP_OP = OP_CALL and FLAT_ENTRY_NAME[PW_TOP_ENTRY] /= N_INDICES
        | PW_START_TYPE := ROWS_TYPE[?][if LW_START_SIGNAL >= 0 then LW_START_SIGNAL else 0]
        | PW_START := LW_START_DEFINES and LW_START_SIGNAL >= 0 and LW_EQ_LOOP < 0 and LW_EQ_PARTIAL = 0
                      and FLAT_EQUATION_END[LW_I] > FLAT_EQUATION_START[LW_I]
                      and PW_START_TYPE < TYPE_COUNT and TYPE_KIND[PW_START_TYPE] = TK_ARRAY and PW_TOP_POINTWISE
        | PW_LOOP_ID := FLAT_LOOP_COUNT + PW_COUNT[?]
        | LW_LEFT := if LW_UNARY then LW_STACK[?][LW_TOP_NOW - 1] else LW_STACK[?][LW_TOP_NOW - 2]
        | LW_RIGHT := if LW_UNARY then -1 else LW_STACK[?][LW_TOP_NOW - 1]
        | LW_LEFT_OP := ROWS_OP[?][LW_LEFT]
        | LW_RIGHT_OP := ROWS_OP[?][LW_RIGHT]
        | LT := ROWS_TYPE[?][LW_LEFT]
        | RT := if LW_RIGHT >= 0 then ROWS_TYPE[?][LW_RIGHT] else LT
        | LT_NEW := LT >= TYPE_COUNT
        | LT_KIND := if LT_NEW then TK_ARRAY else TYPE_KIND[LT]
        | LT_BLOCK := LT_KIND = TK_ARRAY or LT_KIND = TK_STRING
        | LT_ELEMENT := if LT_NEW then NEW_TYPE_ELEMENT[?][LT - TYPE_COUNT] else TYPE_ELEMENT[LT]
        | LT_SIZE := if LT_NEW then NEW_TYPE_SIZE[?][LT - TYPE_COUNT] else TYPE_SIZE[LT]
        | LW_IS_FLAT := LW_OPERATOR and LW_OP = OP_FLAT
        | LW_FLAT_LEVEL := if FINAL_VALUE[LW_SRC] > long(0) then integer(FINAL_VALUE[LW_SRC])
                           else 2 + integer(LW_LEFT_OP = OP_FLAT) + integer(LW_LEFT_OP = OP_FLAT and ROWS_OP[?][ROWS_LEFT[?][LW_LEFT]] = OP_FLAT)
        | LW_SUBJECT := if LW_OP = OP_FLAT then (if FINAL_TYPE[LW_SRC] >= 0 then FINAL_TYPE[LW_SRC] else ROWS_TYPE[?][LW_STACK[?][LW_TOP_NOW - 3]])
                        else LT
        | SB_NEW := LW_SUBJECT >= TYPE_COUNT
        | SB_KIND := if SB_NEW then TK_ARRAY else TYPE_KIND[LW_SUBJECT]
        | SB_E1 := if SB_NEW then NEW_TYPE_ELEMENT[?][LW_SUBJECT - TYPE_COUNT] else TYPE_ELEMENT[LW_SUBJECT]
        | SB_A2 := SB_KIND = TK_ARRAY and TYPE_KIND[SB_E1] = TK_ARRAY
        | SB_E2 := TYPE_ELEMENT[SB_E1]
        | SB_A3 := SB_A2 and TYPE_KIND[SB_E2] = TK_ARRAY
        | SB_E3 := TYPE_ELEMENT[SB_E2]
        | SB_A4 := SB_A3 and TYPE_KIND[SB_E3] = TK_ARRAY
        | SB_RANK := 1 + integer(SB_A2) + integer(SB_A3) + integer(SB_A4)
        | SB_LEAF := if SB_A4 then TYPE_ELEMENT[SB_E3] else if SB_A3 then SB_E3 else if SB_A2 then SB_E2 else SB_E1
        | SB_LEVEL_SIZE := if LW_FLAT_LEVEL = 2 then TYPE_SIZE[SB_E1] else if LW_FLAT_LEVEL = 3 then TYPE_SIZE[SB_E2]
                           else TYPE_SIZE[SB_E3]
        | LW_IS_FLATV := LW_IS_FLAT and (LT_KIND = TK_ARRAY or RT_KIND = TK_ARRAY)
        | LW_INDEX_K := if LW_IS_NEXT then 1 + integer(LW_NEXT_FLAT) + integer(LW_NEXT_FLAT and ROWS_OP[?][ROWS_LEFT[?][LW_INDEX_ROW]] = OP_FLAT)
                                           + integer(LW_NEXT_FLAT and ROWS_OP[?][ROWS_LEFT[?][LW_INDEX_ROW]] = OP_FLAT
                                                     and ROWS_OP[?][ROWS_LEFT[?][ROWS_LEFT[?][LW_INDEX_ROW]]] = OP_FLAT)
                        else if LW_RIGHT_OP = OP_FLAT or LW_RIGHT_OP = OP_FLATV then integer(FINAL_VALUE[LW_SRC]) else 1
        | LW_NEXT_FLAT := ROWS_OP[?][LW_INDEX_ROW] = OP_FLAT
        | LW_IS_DIM := LW_OPERATOR and LW_OP = OP_DIM
        | LW_IS_DIM_SIZE := LW_OPERATOR and LW_OP = OP_DIM_SIZE
        | LW_FOLDS := LW_IS_DIM or LW_IS_DIM_SIZE
        | LW_FOLD_DETACHES := LW_FOLDS and not ROWS_CTX[?][LW_LEFT]
        | LW_DIM_DETACHES := LW_FOLD_DETACHES and LW_IS_DIM
        | SB_AXIS := ROWS_VALUE[?][LW_RIGHT]
        | SB_AXIS_FAILS := SB_KIND /= TK_ARRAY or LW_RIGHT_OP /= OP_CONST or not RT_INT or SB_AXIS < long(1) or SB_AXIS > long(SB_RANK)
        | SB_AXIS_SIZE := if SB_AXIS = long(1) then LT_SIZE else if SB_AXIS = long(2) then TYPE_SIZE[SB_E1]
                          else if SB_AXIS = long(3) then TYPE_SIZE[SB_E2] else TYPE_SIZE[SB_E3]
        | LW_FOLD_VALUE := if LW_IS_DIM then long(if SB_KIND = TK_ARRAY then SB_RANK else 0) else long(SB_AXIS_SIZE)
        | LW_IS_SLICE := LW_OPERATOR and LW_OP = OP_INDEX and RT_KIND /= TK_ARRAY and SB_RANK > LW_INDEX_K
        | SB_SLICE_TYPE := if LW_INDEX_K = 1 then SB_E1 else if LW_INDEX_K = 2 then SB_E2 else SB_E3
        | SB_BLOCKS := LT_SIZE * (if LW_INDEX_K >= 2 then TYPE_SIZE[SB_E1] else ulong(1)) * (if LW_INDEX_K >= 3 then TYPE_SIZE[SB_E2] else ulong(1))
        | LT_INT := LT_KIND = TK_INT
        | LT_REAL := LT_KIND = TK_REAL
        | LT_CX := LT_KIND = TK_COMPLEX
        | LT_LOGICAL := LT_KIND = TK_EVENT or LT_KIND = TK_BOOLEAN
        | RT_NEW := RT >= TYPE_COUNT
        | RT_KIND := if RT_NEW then TK_ARRAY else TYPE_KIND[RT]
        | RT_BLOCK := RT_KIND = TK_ARRAY or RT_KIND = TK_STRING
        | RT_ELEMENT := if RT_NEW then NEW_TYPE_ELEMENT[?][RT - TYPE_COUNT] else TYPE_ELEMENT[RT]
        | RT_SIZE := if RT_NEW then NEW_TYPE_SIZE[?][RT - TYPE_COUNT] else TYPE_SIZE[RT]
        | RT_INT := RT_KIND = TK_INT
        | RT_REAL := RT_KIND = TK_REAL
        | RT_CX := RT_KIND = TK_COMPLEX
        | RT_LOGICAL := RT_KIND = TK_EVENT or RT_KIND = TK_BOOLEAN
        | LW_ARRAY_OPERAND := LT_KIND = TK_ARRAY or RT_KIND = TK_ARRAY
        | LW_LEFT_VALUE := ROWS_VALUE[?][LW_LEFT]
        | LW_IS_INDICES := LW_OPERATOR and LW_OP = OP_CALL and LW_NAME = N_INDICES
        | LW_IS_AXIS := LW_OPERATOR and LW_OP = OP_AXIS
        | RG_START_CONST := LW_LEFT_OP = OP_CONST or LW_LEFT_OP = OP_NEG and ROWS_OP[?][ROWS_LEFT[?][LW_LEFT]] = OP_CONST
        | RG_END_CONST := LW_RIGHT_OP = OP_CONST or LW_RIGHT_OP = OP_NEG and ROWS_OP[?][ROWS_LEFT[?][LW_RIGHT]] = OP_CONST
        | RG_START_VALUE := if LW_LEFT_OP = OP_NEG then -ROWS_VALUE[?][ROWS_LEFT[?][LW_LEFT]] else LW_LEFT_VALUE
        | LW_TABLE_REWRITE := LW_IS_INDICES or LW_IS_AXIS
        | AX_RANGE := LW_LEFT_OP = OP_RANGE
        | AX_A := if AX_RANGE then ROWS_LEFT[?][LW_LEFT] else LW_LEFT
        | AX_B := if AX_RANGE then ROWS_RIGHT[?][LW_LEFT] else LW_LEFT
        | AX_A_NEG := ROWS_OP[?][AX_A] = OP_NEG
        | AX_B_NEG := ROWS_OP[?][AX_B] = OP_NEG
        | AX_A_LEAF := if AX_A_NEG then ROWS_LEFT[?][AX_A] else AX_A
        | AX_B_LEAF := if AX_B_NEG then ROWS_LEFT[?][AX_B] else AX_B
        | AX_CONSTANT_FAILS := ROWS_OP[?][AX_A_LEAF] /= OP_CONST or ROWS_OP[?][AX_B_LEAF] /= OP_CONST
                               or TYPE_KIND[ROWS_TYPE[?][AX_A]] /= TK_INT or TYPE_KIND[ROWS_TYPE[?][AX_B]] /= TK_INT
        | AX_A_VALUE := if AX_A_NEG then -ROWS_VALUE[?][AX_A_LEAF] else ROWS_VALUE[?][AX_A_LEAF]
        | AX_B_VALUE := if AX_B_NEG then -ROWS_VALUE[?][AX_B_LEAF] else ROWS_VALUE[?][AX_B_LEAF]
        | AX_START := if AX_RANGE then AX_A_VALUE else long(0)
        | AX_SPAN := if AX_RANGE then AX_B_VALUE - AX_A_VALUE + long(1) else AX_B_VALUE
        | AX_K := integer(FINAL_VALUE[LW_SRC])
        | AX_DIM := long(TYPE_SIZE[if AX_K = 0 then OW_TYPE else if AX_K = 1 then OW_E1 else if AX_K = 2 then OW_E2 else OW_E3])
        | AX_OUTER := long(TYPE_SIZE[OW_TYPE]) * (if AX_K >= 1 then long(TYPE_SIZE[OW_E1]) else long(1))
                      * (if AX_K >= 2 then long(TYPE_SIZE[OW_E2]) else long(1)) * (if AX_K >= 3 then long(TYPE_SIZE[OW_E3]) else long(1))
        | AX_STRIDE := OW_TOTAL / AX_OUTER
        | AX_SHAPE_FAILS := not OW_ARRAY or OW_RANK /= FINAL_AUX[LW_SRC] or TYPE_KIND[OW_LEAF] /= TK_INT or AX_SPAN /= AX_DIM
        | LW_INDICES_COUNT := if LT = BUILTIN_ULONG then (if LW_LEFT_VALUE = long(0) then long(0) else long(1)) else LW_LEFT_VALUE
        | LW_IS_GATHER := LW_OPERATOR and LW_OP = OP_INDEX and RT_KIND = TK_ARRAY
        | LW_IS_PREV := LW_OPERATOR and LW_OP = OP_PREV
        | LW_PREV_INSTANCE := FLAT_SIGNAL_INSTANCE[LW_LEFT]
        | LW_ENUM_TYPE_KEY := FINAL_TYPE[LW_SRC]
        | LW_ENUM_VALUE_KEY := integer(FINAL_VALUE[LW_SRC])
        | LW_ENUM_TOKEN := if LW_IS_DELAY then FINAL_AUX2[LW_SRC] else LW_ENTRY_TOKEN
        | LW_ENUM_NAMED := LW_ENUM_TYPE_KEY >= 0
        | LW_ENUM_NAMED_TYPE := if LW_ENUM_TYPE_KEY < BUILTIN_TYPE_COUNT then LW_ENUM_TYPE_KEY else if NAME_TYPE[LW_ENUM_TYPE_KEY] > 0 then NAME_TYPE[LW_ENUM_TYPE_KEY] - 1 else NAME_ALIAS[LW_ENUM_TYPE_KEY] - 1
        | LW_ENUM_HOLDERS := HOLDER_COUNT[?][LW_ENUM_VALUE_KEY]
        | LW_ENUM_TYPE := if LW_ENUM_NAMED then LW_ENUM_NAMED_TYPE else HOLDER_TYPE[?][LW_ENUM_VALUE_KEY]
        | LW_START_LOOKS := LW_START_LIVE and LW_EQ_SEED
        | LW_PAIR_KEY_NAME := if LW_IS_PREV then LW_SIGNAL_KEY[?][LW_LEFT] else if LW_SCAN_READS then LW_NAME else LW_EQ_TARGET
        | LW_PAIR_KEY_INSTANCE := if LW_IS_PREV then LW_PREV_INSTANCE else if LW_SCAN_READS then LW_INST else LW_EQ_TARGET_INSTANCE
        | LW_PAIR_KEY_LOOP := if LW_IS_PREV then LW_LOOP_NOW else LW_EQ_LOOP
        | LW_LOOKS_PAIR := LW_IS_PREV or LW_SCAN_READS or LW_START_LOOKS or LW_EQ_STEP = 1
        | LW_LOOKS_ARRAY := LW_IS_INDICES or LW_IS_GATHER or LW_IS_STEP or LW_IS_CONCAT or LW_IS_WINDOW and LW_COUNT_OK or CXT_LOOKS
        | LW_ARRAY_ELEMENT := if CXT_LOOKS then CXT_ELEMENT_TWIN else if LW_IS_INDICES or LW_IS_STEP then BUILTIN_INTEGER else if LW_IS_WINDOW then LT
                              else if LW_IS_GATHER and LW_RIGHT_OP = OP_FLATV then SB_LEAF else LT_ELEMENT
        | LW_ARRAY_SIZE := if CXT_LOOKS then CXT_SIZE else if LW_IS_INDICES then ulong(LW_LEFT_VALUE) else if LW_IS_STEP then ulong(SP_COUNT) else if LW_IS_WINDOW then ulong(LW_COUNT)
                           else if LW_IS_CONCAT then LT_SIZE + RT_SIZE else RT_SIZE
        | LW_LOOKS_GUARD := LW_EQ_STEP = 2 or LW_GROUP_LIVE and LW_HAS_GUARD
        | LK_LIVE := LW_SIGNAL_LIVE or LW_LABEL_LIVE or LW_VALUE_LIVE or LW_ARRAY_LIVE or LW_LOOP_LIVE or LW_EQ_STEP < 3
                     or LW_GROUP_LIVE and LW_HAS_GUARD or LW_START_LOOKS or LW_SCAN_READS or LW_LOOKS_SIGNAL or LW_ENUM_LIVE
                     or LW_IS_PREV or LW_LOOKS_ARRAY or LW_STATEVAR_ENUM
        | LK_A := if LW_SIGNAL_LIVE then long(LW_SIGNAL_KEY_NOW)
                  else if LW_STATEVAR_ENUM then SIGNAL_INIT_VALUE[LW_STATEVAR_DECL]
                  else if LW_LABEL_LIVE then long(FLAT_LABEL_KEY[LW_I])
                  else if LW_VALUE_LIVE then long(LW_VALUE_KEY)
                  else if LW_ARRAY_LIVE then long(TYPE_SIZE[LW_I])
                  else if LW_LOOP_LIVE then long(LW_LOOP_NAME)
                  else if LW_LOOKS_PAIR then long(LW_PAIR_KEY_NAME)
                  else if LW_LOOKS_GUARD then long(LW_GUARD_KEY)
                  else if LW_EQ_STEP = 0 then long(LW_EQ_TARGET)
                  else if LW_LOOKS_SIGNAL then long(LW_NAME)
                  else if LW_ENUM_LIVE then long(LW_ENUM_VALUE_KEY)
                  else long(LW_ARRAY_SIZE)
        | LK_B := if LW_SIGNAL_LIVE then long(FLAT_SIGNAL_INSTANCE[LW_I]) * long(KEY_STRIDE) + long(KEY_SIGNAL)
                  else if LW_STATEVAR_ENUM then long(ROWS_TYPE[?][LW_I]) * long(KEY_STRIDE) + long(KEY_VALUE)
                  else if LW_LABEL_LIVE then long(FLAT_LABEL_INSTANCE[LW_I]) * long(KEY_STRIDE)
                                             + long(if FLAT_LABEL_CALL[LW_I] then KEY_CALL_LABEL else KEY_LABEL)
                  else if LW_VALUE_LIVE then long(LW_I) * long(KEY_STRIDE) + long(KEY_VALUE)
                  else if LW_ARRAY_LIVE then long(TYPE_ELEMENT[LW_I]) * long(KEY_STRIDE) + long(KEY_ARRAY)
                  else if LW_LOOP_LIVE then long(FLAT_LOOP_INSTANCE[LW_I]) * long(KEY_STRIDE) + long(KEY_SIGNAL)
                  else if LW_LOOKS_PAIR then (long(LW_PAIR_KEY_INSTANCE) * long(LOOP_CAP + 1) + long(LW_PAIR_KEY_LOOP + 1)) * long(KEY_STRIDE)
                                             + long(KEY_PAIR)
                  else if LW_LOOKS_GUARD then long(LW_GUARD_INSTANCE) * long(KEY_STRIDE) + long(KEY_SIGNAL)
                  else if LW_EQ_STEP = 0 then long(LW_EQ_TARGET_INSTANCE) * long(KEY_STRIDE) + long(KEY_SIGNAL)
                  else if LW_LOOKS_SIGNAL then long(LW_INST) * long(KEY_STRIDE) + long(KEY_SIGNAL)
                  else if LW_ENUM_LIVE then long(LW_ENUM_TYPE) * long(KEY_STRIDE) + long(KEY_VALUE)
                  else long(LW_ARRAY_ELEMENT) * long(KEY_STRIDE) + long(KEY_ARRAY)
        | LK_WANTS_INSERT := LW_SIGNAL_LIVE or LW_LABEL_LIVE or LW_VALUE_LIVE or LW_ARRAY_LIVE or LW_EQ_STEP = 1 or LW_LOOKS_ARRAY
        | LK_HASH := integer((ulong(LK_A) * HASH_K1 + ulong(LK_B) * HASH_K2) shr HASH_SHIFT)
        | LK_N0 := HASH_HEAD[?][LK_HASH] - 1
        | LK_M0 := LK_N0 >= 0 and HN_A[?][LK_N0] = LK_A and HN_B[?][LK_N0] = LK_B
        | LK_N1 := if LK_N0 >= 0 then HN_NEXT[?][LK_N0] - 1 else -1
        | LK_M1 := LK_N1 >= 0 and HN_A[?][LK_N1] = LK_A and HN_B[?][LK_N1] = LK_B
        | LK_N2 := if LK_N1 >= 0 then HN_NEXT[?][LK_N1] - 1 else -1
        | LK_M2 := LK_N2 >= 0 and HN_A[?][LK_N2] = LK_A and HN_B[?][LK_N2] = LK_B
        | LK_N3 := if LK_N2 >= 0 then HN_NEXT[?][LK_N2] - 1 else -1
        | LK_M3 := LK_N3 >= 0 and HN_A[?][LK_N3] = LK_A and HN_B[?][LK_N3] = LK_B
        | LK_N4 := if LK_N3 >= 0 then HN_NEXT[?][LK_N3] - 1 else -1
        | LK_M4 := LK_N4 >= 0 and HN_A[?][LK_N4] = LK_A and HN_B[?][LK_N4] = LK_B
        | LK_N5 := if LK_N4 >= 0 then HN_NEXT[?][LK_N4] - 1 else -1
        | LK_M5 := LK_N5 >= 0 and HN_A[?][LK_N5] = LK_A and HN_B[?][LK_N5] = LK_B
        | LK_N6 := if LK_N5 >= 0 then HN_NEXT[?][LK_N5] - 1 else -1
        | LK_M6 := LK_N6 >= 0 and HN_A[?][LK_N6] = LK_A and HN_B[?][LK_N6] = LK_B
        | LK_N7 := if LK_N6 >= 0 then HN_NEXT[?][LK_N6] - 1 else -1
        | LK_M7 := LK_N7 >= 0 and HN_A[?][LK_N7] = LK_A and HN_B[?][LK_N7] = LK_B
        | LK_NODE := if LK_M0 then LK_N0 else if LK_M1 then LK_N1 else if LK_M2 then LK_N2 else if LK_M3 then LK_N3
                     else if LK_M4 then LK_N4 else if LK_M5 then LK_N5 else if LK_M6 then LK_N6 else if LK_M7 then LK_N7 else -1
        | LK_FOUND := LK_NODE >= 0
        | LK_VALUE := if LK_FOUND then HN_VALUE[?][LK_NODE] else -1
        | LK_UNSURE := LK_LIVE and not LK_FOUND and LK_N7 >= 0 and HN_NEXT[?][LK_N7] > 0
        | LK_INSERTS := LK_LIVE and LK_WANTS_INSERT and not LK_FOUND and not LK_UNSURE
        | LK_NEW := HN_COUNT[?]
        | LK_FULL := LK_INSERTS and LK_NEW >= HASH_NODE_CAP
        | LW_NEW_TYPE := TYPE_COUNT + NEW_TYPE_COUNT[?]
        | LW_TYPE_FULL := LW_LOOKS_ARRAY and LK_INSERTS and NEW_TYPE_COUNT[?] >= NEW_TYPE_CAP
        | LK_INSERT_VALUE := if LW_VALUE_LIVE then LW_K else if LW_LOOKS_ARRAY then LW_NEW_TYPE else LW_I
        | HN_SLOT := if LK_INSERTS and not LK_FULL then LK_NEW else -1
        | HN_A := HN_A[?] next HN_SLOT : LK_A
        | HN_B := HN_B[?] next HN_SLOT : LK_B
        | HN_VALUE := HN_VALUE[?] next HN_SLOT : LK_INSERT_VALUE
        | HN_NEXT := HN_NEXT[?] next HN_SLOT : LK_N0 + 1
        | HASH_HEAD := HASH_HEAD[?] next (if HN_SLOT >= 0 then LK_HASH else -1) : HN_SLOT + 1
        | HN_COUNT := HN_COUNT[?] + integer(HN_SLOT >= 0)
        | LW_HOLDER_SLOT := if LW_VALUE_LIVE and LK_INSERTS then LW_VALUE_KEY else -1
        | HOLDER_COUNT := HOLDER_COUNT[?] next LW_HOLDER_SLOT : HOLDER_COUNT[?][LW_VALUE_KEY] + 1
        | HOLDER_TYPE := HOLDER_TYPE[?] next (if HOLDER_COUNT[?][LW_VALUE_KEY] = 0 then LW_HOLDER_SLOT else -1) : LW_I
        | LW_NEW_TYPE_SLOT := if LW_LOOKS_ARRAY and HN_SLOT >= 0 and not LW_TYPE_FULL then NEW_TYPE_COUNT[?] else -1
        | NEW_TYPE_ELEMENT := NEW_TYPE_ELEMENT[?] next LW_NEW_TYPE_SLOT : LW_ARRAY_ELEMENT
        | NEW_TYPE_SIZE := NEW_TYPE_SIZE[?] next LW_NEW_TYPE_SLOT : LW_ARRAY_SIZE
        | NEW_TYPE_COUNT := NEW_TYPE_COUNT[?] + integer(LW_NEW_TYPE_SLOT >= 0)
        | LW_INTERNED := if LK_FOUND then LK_VALUE else LW_NEW_TYPE
        | LW_IOTA_TABLE := LW_IOTA[?][LW_INTERNED] - 1
        | LW_NEW_TABLE := TABLE_COUNT + NEW_TABLE_COUNT[?]
        | LW_TABLE_FULL := (LW_IS_INDICES and LW_IOTA_TABLE < 0 or LW_IS_AXIS or LW_IS_DEFAULTS or LW_IS_STEP or LW_IS_WINDOW and LI_SCALAR_OK or CXB_CREATES) and NEW_TABLE_COUNT[?] >= NEW_TABLE_CAP
        | LW_LOOP_SIGNAL := LK_VALUE
        | LW_LOOP_TYPE := ROWS_TYPE[?][LW_LOOP_SIGNAL]
        | LW_LOOP_UNDECLARED := LW_LOOP_LIVE and not LK_FOUND
        | LW_LOOP_NOT_INDEX := LW_LOOP_LIVE and not (TYPE_KIND[LW_LOOP_TYPE] = TK_ARRAY and TYPE_KIND[TYPE_ELEMENT[LW_LOOP_TYPE]] = TK_INT)
        | LW_LEVEL_PRODUCT := if LW_K = 0 then TYPE_SIZE[LW_LOOP_TYPE] else LOOP_SIZE[?][LW_I] * TYPE_SIZE[LW_LOOP_TYPE]
        | LW_LOOP_PRODUCT_FAILS := LW_LEVEL_ROW and LW_LEVEL_PRODUCT > ulong(2147483647)
        | LW_EQ_SOURCE := FLAT_LOOP_SOURCE[if LW_EQ_LOOP >= 0 then LW_EQ_LOOP else 0]
        | LW_EQ_RANK := LOOP_RANK[LW_EQ_SOURCE]
        | LW_INDEX_DEFINED := LW_EQ_STEP = 0 and LW_LOOP_DEFINES and LW_EQ_TARGET_INSTANCE = LW_EQ_LOOP_INSTANCE
                              and (LW_EQ_TARGET = LW_EQ_LOOP_NAME
                                   or LW_EQ_RANK > 1 and LW_EQ_TARGET = LOOP_LEVEL_NAME[4 * LW_EQ_SOURCE + 1]
                                   or LW_EQ_RANK > 2 and LW_EQ_TARGET = LOOP_LEVEL_NAME[4 * LW_EQ_SOURCE + 2]
                                   or LW_EQ_RANK > 3 and LW_EQ_TARGET = LOOP_LEVEL_NAME[4 * LW_EQ_SOURCE + 3])
        | LW_TARGET_UNDECLARED := LW_EQ_STEP = 0 and LW_LOOP_DEFINES and not LK_FOUND
        | LW_START_SEED_FAILS := LW_START_LOOKS and not LK_FOUND
        | LW_START_DEFINES := LW_START_LIVE and not LW_EQ_SEED and LW_EQ_TARGET >= 0
        | LW_START_UNDECLARED := LW_START_DEFINES and LW_START_SIGNAL < 0
        | LW_START_INPUT := LW_START_DEFINES and ROWS_OP[?][LW_START_SIGNAL] = OP_INPUT
        | LW_EQ_PARTIAL := FLAT_EQUATION_PARTIAL[LW_I]
        | LW_START_DEFINED := LW_START_DEFINES and SIGNAL_TOP[?][LW_START_SIGNAL] > 0
        | LW_START_MIXED := LW_START_DEFINES
                            and (if LW_EQ_PARTIAL > 0 then LW_START_DEFINED and not SIGNAL_PARTIAL[?][LW_START_SIGNAL]
                                 else SIGNAL_PARTIAL[?][LW_START_SIGNAL])
        | LW_START_TWICE := LW_START_DEFINED and LW_EQ_PARTIAL = 0
        | LW_START_STATEVAR := STATE_ROW[?][if LW_START_SIGNAL >= 0 then LW_START_SIGNAL else 0] > 0
        | LW_START_ASSIGNED := LW_START_DEFINES and LW_EQ_PARTIAL = 0 and LW_START_STATEVAR
        | LW_START_STATE_DEFAULT := LW_START_DEFINES and LW_EQ_PARTIAL = 2 and LW_START_STATEVAR
        | LW_START_OUTPUT_SOURCE := if LW_START_SIGNAL >= 0 and LW_START_SIGNAL < FLAT_SIGNAL_COUNT then FLAT_SIGNAL_SOURCE[LW_START_SIGNAL] else -1
        | LW_START_OUTPUT := LW_START_DEFINES and LW_EQ_PARTIAL > 0 and LW_START_OUTPUT_SOURCE >= 0
                             and FLAT_SIGNAL_INSTANCE[if LW_START_OUTPUT_SOURCE >= 0 then LW_START_SIGNAL else 0] = 0
                             and SIGNAL_ROLE[if LW_START_OUTPUT_SOURCE >= 0 then LW_START_OUTPUT_SOURCE else 0] = ROLE_OUTPUT
        | LW_START_TWO_DEFAULTS := LW_START_DEFINES and LW_EQ_PARTIAL = 2 and SIGNAL_DEFAULTED[?][LW_START_SIGNAL]
        | LW_SCAN_FAILS := LW_SCAN_READS and LK_FOUND and not (LW_E = LW_FL_START[?] and LW_NAME = LW_EQ_TARGET and LW_SEED_TARGET_AT >= 0)
        | LW_SIGNAL_FOUND := LW_LOOKS_SIGNAL and LK_FOUND
        | LW_NEXT_OP := if LW_E + 1 < LW_END_NOW then FLAT_ENTRY_OP[LW_E + 1] else -1
        | LW_STATE_DIRECT := LW_SIGNAL_FOUND and STATE_ROW[?][if LK_VALUE >= 0 then LK_VALUE else 0] > 0 and LW_NEXT_OP /= OP_STATE
        | LW_IS_STATE := LW_OPERATOR and LW_OP = OP_STATE
        | LW_STATE_ROW := STATE_ROW[?][if LW_LEFT >= 0 and LW_LEFT < FLAT_SIGNAL_COUNT then LW_LEFT else 0] - 1
        | LW_STATE_NOT := LW_IS_STATE and (LW_LEFT < 0 or LW_LEFT >= FLAT_SIGNAL_COUNT or LW_STATE_ROW < 0)
        | LW_CONSTANT := NAME_CONSTANT[LW_NAME] - 1
        | LW_FROM_CONSTANT := LW_LOOKS_SIGNAL and not LK_FOUND and LW_INST = 0 and LW_CONSTANT >= 0
        | LW_SIGNAL_UNDECLARED := LW_LOOKS_SIGNAL and not LK_FOUND and not LW_FROM_CONSTANT
        | LW_ENUM_UNDECLARED := LW_ENUM_LIVE and not LW_ENUM_NAMED and LW_ENUM_HOLDERS = 0
        | LW_ENUM_AMBIGUOUS := LW_ENUM_LIVE and not LW_ENUM_NAMED and LW_ENUM_HOLDERS > 1
        | LW_ENUM_TYPE_UNDECLARED := LW_ENUM_LIVE and LW_ENUM_NAMED and LW_ENUM_NAMED_TYPE < 0
        | LW_ENUM_NO_VALUE := LW_ENUM_LIVE and not LK_FOUND
        | LW_ENUM_ARGUMENT0 := if LW_ENUM_MESSAGE = T_ENUM_UNDECLARED or LW_ENUM_MESSAGE = T_ENUM_AMBIGUOUS then LW_ENUM_VALUE_KEY
                               else LW_ENUM_TYPE_KEY
        | LW_ENUM_MESSAGE := if LW_ENUM_UNDECLARED then T_ENUM_UNDECLARED else if LW_ENUM_AMBIGUOUS then T_ENUM_AMBIGUOUS
                             else if LW_ENUM_TYPE_UNDECLARED then T_TYPE_UNDECLARED else if LW_ENUM_NO_VALUE then T_NO_VALUE else 0
        | FX_STEP := LW_FX_STEP[?]
        | FX_COUNT := integer(FINAL_VALUE[LW_SRC])
        | FX_PARAMS := FINAL_AUX2[LW_SRC]
        | FX_P0 := FINAL_AUX[LW_SRC]
        | FX_P1 := FX_P0 + 2
        | FX_KEY0 := TOKEN_NAME[FX_P0] - 1
        | FX_KEY1 := TOKEN_NAME[FX_P1] - 1
        | FX_SLOT0 := TOKEN_FORMAL_SLOT[FX_P0] - 1
        | FX_SLOT1 := TOKEN_FORMAL_SLOT[FX_P1] - 1
        | FX_TYPE0 := if FX_SLOT0 >= 0 then BIND_TYPE[INSTANCE_BIND_START[LW_INST] + FX_SLOT0] else if FX_KEY0 < 0 then -1 else if FX_KEY0 < BUILTIN_TYPE_COUNT then FX_KEY0 else if NAME_TYPE[FX_KEY0] > 0 then NAME_TYPE[FX_KEY0] - 1 else NAME_ALIAS[FX_KEY0] - 1
        | FX_TYPE1 := if FX_SLOT1 >= 0 then BIND_TYPE[INSTANCE_BIND_START[LW_INST] + FX_SLOT1] else if FX_KEY1 < 0 then -1 else if FX_KEY1 < BUILTIN_TYPE_COUNT then FX_KEY1 else if NAME_TYPE[FX_KEY1] > 0 then NAME_TYPE[FX_KEY1] - 1 else NAME_ALIAS[FX_KEY1] - 1
        | FX_IS_LOAD := LW_NAME = N_LOAD
        | FX_IS_STORE := LW_NAME = N_STORE
        | FX_IS_SYSCALL := LW_NAME = N_SYSCALL
        | FX_IS_INSTRUCTION := LW_NAME = N_INSTRUCTION
        | FX_IS_READ := LW_NAME = N_READ
        | FX_IS_IO := FX_IS_READ or LW_NAME = N_WRITE or LW_NAME = N_WRITE_STRING
        | FX_EXPECTED := if FX_IS_SYSCALL then 1 else if FX_IS_IO then 0 else 2
        | FX_CONSTANT1 := NAME_CONSTANT[FX_KEY1] - 1
        | FX_NUMBER1 := TOKEN_KIND[FX_P1] = ubyte(KIND_NUMBER)
        | FX_WORD_CONSTANT := FX_CONSTANT1 >= 0 and TYPE_KIND[CONSTANT_TYPE[FX_CONSTANT1]] = TK_INT
        | FX_WORD := if FX_NUMBER1 then TOKEN_VALUE[FX_P1] else CONSTANT_VALUE[FX_CONSTANT1]
        | FX_WORD_BIG := FX_NUMBER1 and TOKEN_BIG[FX_P1] or FX_WORD < long(0) or FX_WORD >= long(4294967296)
        | FX_CHECKS := LW_IS_EFFECT and FX_STEP = 0
        | FX_BASE := LW_TOP_NOW - FX_COUNT
        | FX_O0 := LW_STACK[?][FX_BASE]
        | FX_O1 := LW_STACK[?][FX_BASE + 1]
        | FX_O2 := LW_STACK[?][FX_BASE + 2]
        | FX_O3 := LW_STACK[?][FX_BASE + 3]
        | FX_O4 := LW_STACK[?][FX_BASE + 4]
        | FX_O5 := LW_STACK[?][FX_BASE + 5]
        | FX_O6 := LW_STACK[?][FX_BASE + 6]
        | FX_PAIR_AT := if FX_COUNT > 0 and ROWS_OP[?][FX_O0] = OP_PAIR then FX_O0
                        else if FX_COUNT > 1 and ROWS_OP[?][FX_O1] = OP_PAIR then FX_O1
                        else if FX_COUNT > 2 and ROWS_OP[?][FX_O2] = OP_PAIR then FX_O2
                        else if FX_COUNT > 3 and ROWS_OP[?][FX_O3] = OP_PAIR then FX_O3
                        else if FX_COUNT > 4 and ROWS_OP[?][FX_O4] = OP_PAIR then FX_O4
                        else if FX_COUNT > 5 and ROWS_OP[?][FX_O5] = OP_PAIR then FX_O5
                        else if FX_COUNT > 6 and ROWS_OP[?][FX_O6] = OP_PAIR then FX_O6 else -1
        | FX_T0 := ROWS_TYPE[?][FX_O0]
        | FX_T1 := ROWS_TYPE[?][FX_O1]
        | FX_T2 := ROWS_TYPE[?][FX_O2]
        | FX_T3 := ROWS_TYPE[?][FX_O3]
        | FX_T4 := ROWS_TYPE[?][FX_O4]
        | FX_T5 := ROWS_TYPE[?][FX_O5]
        | FX_T6 := ROWS_TYPE[?][FX_O6]
        | FX_K0 := if FX_T0 >= TYPE_COUNT then TK_ARRAY else TYPE_KIND[FX_T0]
        | FX_K1 := if FX_T1 >= TYPE_COUNT then TK_ARRAY else TYPE_KIND[FX_T1]
        | FX_K2 := if FX_T2 >= TYPE_COUNT then TK_ARRAY else TYPE_KIND[FX_T2]
        | FX_K3 := if FX_T3 >= TYPE_COUNT then TK_ARRAY else TYPE_KIND[FX_T3]
        | FX_K4 := if FX_T4 >= TYPE_COUNT then TK_ARRAY else TYPE_KIND[FX_T4]
        | FX_K5 := if FX_T5 >= TYPE_COUNT then TK_ARRAY else TYPE_KIND[FX_T5]
        | FX_K6 := if FX_T6 >= TYPE_COUNT then TK_ARRAY else TYPE_KIND[FX_T6]
        | FX_SYSCALL_AT := if FX_K0 /= TK_INT and FX_K0 /= TK_POINTER then 0
                           else if FX_K1 /= TK_INT and FX_K1 /= TK_POINTER then 1
                           else if FX_K2 /= TK_INT and FX_K2 /= TK_POINTER then 2
                           else if FX_K3 /= TK_INT and FX_K3 /= TK_POINTER then 3
                           else if FX_K4 /= TK_INT and FX_K4 /= TK_POINTER then 4
                           else if FX_K5 /= TK_INT and FX_K5 /= TK_POINTER then 5
                           else if FX_K6 /= TK_INT and FX_K6 /= TK_POINTER then 6 else -1
        | FX_SYSCALL_TYPE := if FX_SYSCALL_AT = 0 then FX_T0 else if FX_SYSCALL_AT = 1 then FX_T1 else if FX_SYSCALL_AT = 2 then FX_T2
                             else if FX_SYSCALL_AT = 3 then FX_T3 else if FX_SYSCALL_AT = 4 then FX_T4
                             else if FX_SYSCALL_AT = 5 then FX_T5 else FX_T6
        | FX_WRITES_VALUE := LW_NAME = N_WRITE and FX_COUNT > 1
        | FX_WRITABLE1 := FX_K1 = TK_INT or FX_K1 = TK_BOOLEAN or FX_K1 = TK_CHAR or FX_K1 = TK_REAL or FX_K1 = TK_COMPLEX or FX_K1 = TK_STRING
        | FX_OW_KIND := TYPE_KIND[if OW_TYPE < TYPE_COUNT then OW_TYPE else 0]
        | FX_READABLE := OW_TYPE < TYPE_COUNT and (FX_OW_KIND = TK_INT or FX_OW_KIND = TK_BOOLEAN or FX_OW_KIND = TK_CHAR or FX_OW_KIND = TK_REAL or FX_OW_KIND = TK_COMPLEX or FX_OW_KIND = TK_STRING)
        | FX_BUILT0 := (ROWS_OP[?][FX_O0] = OP_IF or ROWS_OP[?][FX_O0] = OP_DEFAULT) and FX_K0 = TK_STRING
        | FX_BUILT1 := FX_COUNT > 1 and (ROWS_OP[?][FX_O1] = OP_IF or ROWS_OP[?][FX_O1] = OP_DEFAULT) and FX_K1 = TK_STRING
        | FX_ROW_TYPE := if FX_IS_READ then OW_TYPE else if FX_IS_IO then BUILTIN_EVENT
                         else if FX_IS_LOAD then FX_TYPE1 else if FX_IS_STORE then BUILTIN_EVENT
                         else if FX_IS_SYSCALL then BUILTIN_LONG else BUILTIN_ULONG
        | FX_MESSAGE := if (FX_IS_SYSCALL or FX_IS_INSTRUCTION) and LW_LOOP_NOW >= FLAT_LOOP_COUNT then T_EFFECT_IN_EXTENSION
                        else if (FX_IS_SYSCALL or FX_IS_READ) and PLATFORM = PLATFORM_VIRT then T_SYSCALL_VIRT
                        else if (FX_IS_SYSCALL or FX_IS_READ) and PLATFORM = PLATFORM_MPS2 then T_SYSCALL_MPS2
                        else if FX_PARAMS /= FX_EXPECTED then T_STATIC_COUNT
                        else if FX_IS_IO then
                          (if FX_PAIR_AT >= 0 then T_PAIR_OPERAND else if FX_K0 /= TK_STRING then T_IO_STRING
                           else if FX_WRITES_VALUE and not FX_WRITABLE1 then T_WRITE_VALUE
                           else if FX_IS_READ and not FX_READABLE then T_READ_TYPE
                           else if FX_BUILT0 or FX_BUILT1 then T_STRING_VALUE else 0)
                        else if FX_TYPE0 < 0 then T_TYPE_UNDECLARED_TEXT
                        else if TYPE_KIND[FX_TYPE0] /= TK_EXTERNAL then T_RESOURCE_EXTERNAL
                        else if (FX_IS_LOAD or FX_IS_STORE) and FX_TYPE1 < 0 then T_TYPE_UNDECLARED_TEXT
                        else if (FX_IS_LOAD or FX_IS_STORE) and TYPE_KIND[FX_TYPE1] /= TK_INT and TYPE_KIND[FX_TYPE1] /= TK_POINTER
                        then T_ACCESS_TYPE
                        else if FX_IS_INSTRUCTION and not FX_NUMBER1 and not FX_WORD_CONSTANT then T_WORD_CONSTANT
                        else if FX_IS_INSTRUCTION and FX_WORD_BIG then T_WORD_RANGE
                        else if FX_PAIR_AT >= 0 then T_PAIR_OPERAND
                        else if (FX_IS_LOAD or FX_IS_STORE) and FX_T0 /= BUILTIN_POINTER then T_INPUT_POINTER
                        else if FX_IS_STORE and not LUB_SUBTYPE then T_STORE_TYPE
                        else if FX_IS_SYSCALL and FX_SYSCALL_AT >= 0 then T_SYSCALL_INPUT
                        else if FX_IS_INSTRUCTION and not LUB_SUBTYPE then T_INSTRUCTION_INPUT else 0
        | FX_TOKEN := if FX_MESSAGE = T_PAIR_OPERAND then ROWS_TOKEN[?][FX_PAIR_AT]
                      else if FX_MESSAGE = T_TYPE_UNDECLARED_TEXT and FX_TYPE0 >= 0 or FX_MESSAGE = T_ACCESS_TYPE
                              or FX_MESSAGE = T_WORD_CONSTANT or FX_MESSAGE = T_WORD_RANGE then FX_P1
                      else if FX_MESSAGE = T_TYPE_UNDECLARED_TEXT or FX_MESSAGE = T_RESOURCE_EXTERNAL then FX_P0
                      else LW_ENTRY_TOKEN
        | FX_ARGUMENT0 := if FX_MESSAGE = T_TYPE_UNDECLARED_TEXT then FX_TOKEN else if FX_MESSAGE = T_STORE_TYPE then FX_TYPE1
                          else if FX_MESSAGE = T_WRITE_VALUE then FX_T1 else if FX_MESSAGE = T_READ_TYPE then OW_TYPE
                          else if FX_MESSAGE = T_SYSCALL_INPUT then FX_SYSCALL_AT + 1
                          else if FX_MESSAGE = T_INSTRUCTION_INPUT then FX_T0 else LW_NAME
        | FX_ARGUMENT1 := if FX_MESSAGE = T_STATIC_COUNT then FX_EXPECTED else if FX_MESSAGE = T_ACCESS_TYPE then FX_P1
                          else if FX_MESSAGE = T_IO_STRING then FX_T0
                          else if FX_MESSAGE = T_INPUT_POINTER then FX_T0 else if FX_MESSAGE = T_STORE_TYPE then FX_T1
                          else FX_SYSCALL_TYPE
        | FX_EMITS_ARG := LW_IS_EFFECT and FX_STEP > 0 and FX_STEP <= FX_COUNT
        | FX_EMITS_EFFECT := LW_IS_EFFECT and FX_STEP > FX_COUNT
        | FX_OPERAND := LW_STACK[?][LW_TOP_NOW - FX_STEP]
        | FX_PREVIOUS := LW_FX_PREVIOUS[?]
        | LW_LOOP_EXCLUDES := LW_OP = OP_WHEN or LW_OP = OP_UWHEN or LW_OP = OP_DEFAULT or LW_OP = OP_DELAY or LW_OP = OP_CLOCK
                             or LW_OP = OP_RANGE or LW_OP = OP_GDELAY or LW_OP = OP_WINDOW
        | LW_IN_FLAT_LOOP := LW_LOOP_NOW >= 0 and LW_LOOP_NOW < FLAT_LOOP_COUNT
        | LW_DELAY_OF_SIGNAL := LW_IN_FLAT_LOOP and (LW_OP = OP_DELAY or LW_OP = OP_GDELAY) and LW_LEFT >= 0
                                and ROWS_OWNER[?][LW_LEFT] = LW_LEFT
        | LW_DELAY_SELF := LW_DELAY_OF_SIGNAL and SIGNAL_LOOP_MARK[?][LW_LEFT] - 1 = LW_LOOP_NOW
        | LW_DELAY_FREE := LW_DELAY_OF_SIGNAL and not LW_DELAY_SELF
        | LW_NOT_IN_ITERATE := LW_IN_FLAT_LOOP and LW_LOOP_EXCLUDES and not LW_DELAY_OF_SIGNAL
        | LW_NOT_IN_EXTENSION := LW_LOOP_NOW >= FLAT_LOOP_COUNT and LW_LOOP_EXCLUDES
        | LW_BLOCK_CONSUMER := LW_OP = OP_WHEN or LW_OP = OP_DEFAULT or LW_OP = OP_BRANCH and (LT_KIND = TK_STRING or RT_KIND = TK_STRING)
        | LW_LEFT_BLOCK := ((LW_LEFT_OP = OP_WHEN or LW_LEFT_OP = OP_DEFAULT) and not LW_BLOCK_CONSUMER
                            or LW_LEFT_OP = OP_IF and LT_KIND = TK_STRING and LW_OP /= OP_BRANCH) and LT_BLOCK
        | LW_RIGHT_BLOCK := LW_RIGHT >= 0 and RT_BLOCK
                            and ((LW_RIGHT_OP = OP_WHEN or LW_RIGHT_OP = OP_DEFAULT) and not LW_BLOCK_CONSUMER
                                 or LW_RIGHT_OP = OP_IF and RT_KIND = TK_STRING and LW_OP /= OP_BRANCH)
        | LW_BRANCHES_BUILD := LW_OP = OP_BRANCH and LT_KIND = TK_STRING and RT_KIND = TK_STRING
                               and (LW_LEFT_OP = OP_IF or LW_LEFT_OP = OP_DEFAULT) and (LW_RIGHT_OP = OP_IF or LW_RIGHT_OP = OP_DEFAULT)
        | LW_LEFT_ARRAY_VALUE := LW_LEFT_OP = OP_GATHER or LW_LEFT_OP = OP_NEXT or LW_LEFT_OP = OP_RANGE or LW_LEFT_OP = OP_SLICE
                                 or LW_LEFT_OP = OP_PUT or LW_LEFT_OP = OP_RESTRUCTURE or LW_LEFT_OP = OP_CONCAT or LW_LEFT_BLOCK
                                 or LW_LEFT_OP = OP_TRANSPOSE or LW_LEFT_OP = OP_MATPROD and LT_KIND = TK_ARRAY
        | LW_RIGHT_ARRAY_VALUE := LW_RIGHT >= 0 and (LW_RIGHT_OP = OP_GATHER or LW_RIGHT_OP = OP_NEXT or LW_RIGHT_OP = OP_RANGE
                                                     or LW_RIGHT_OP = OP_SLICE or LW_RIGHT_OP = OP_PUT or LW_RIGHT_OP = OP_RESTRUCTURE or LW_RIGHT_OP = OP_CONCAT
                                                     or LW_RIGHT_OP = OP_TRANSPOSE or LW_RIGHT_OP = OP_MATPROD and RT_KIND = TK_ARRAY)
                                  or LW_RIGHT_BLOCK
        | LW_RIGHT_PAIR := LW_RIGHT >= 0 and LW_RIGHT_OP = OP_PAIR and LW_OP /= OP_NEXT
        | LW_PREV_MESSAGE := if LW_LEFT >= FLAT_SIGNAL_COUNT then T_PREV_SIGNAL
                             else if LW_LOOP_NOW < 0 or LW_LOOP_NOW >= FLAT_LOOP_COUNT then T_PREV_OUTSIDE
                             else if not LK_FOUND then T_PREV_UNDEFINED else 0
        | LW_INDICES_FAILS := LW_LEFT_OP /= OP_CONST or not LT_INT or LW_INDICES_COUNT <= long(0)
        | LW_INDEXES := LW_OP = OP_INDEX or LW_OP = OP_NEXT or LW_OP = OP_TARGET_INDEX
        | LW_INDEX_ROW := if LW_OP = OP_NEXT then ROWS_LEFT[?][LW_RIGHT] else LW_RIGHT
        | LW_INDEX_TYPE := ROWS_TYPE[?][LW_INDEX_ROW]
        | LW_INDEX_TOKEN := if LW_INDEX_ROW < FLAT_SIGNAL_COUNT then SIGNAL_DEF_TOKEN[?][LW_INDEX_ROW] - 1
                            else ROWS_TOKEN[?][LW_INDEX_ROW]
        | LW_INDEX_INT := LW_INDEX_TYPE < TYPE_COUNT and TYPE_KIND[LW_INDEX_TYPE] = TK_INT
        | LW_INDEX_VALUE := ROWS_VALUE[?][LW_INDEX_ROW]
        | LW_INDEX_OUTSIDE := ROWS_OP[?][LW_INDEX_ROW] = OP_CONST
                              and (LW_INDEX_TYPE /= BUILTIN_ULONG and LW_INDEX_VALUE < long(0) or ulong(LW_INDEX_VALUE) >= LT_SIZE)
        | LW_IS_NEXT := LW_OP = OP_NEXT
        | GI_RIGHT_TABLE := LW_RIGHT >= 0 and LW_RIGHT_OP = OP_TABLE
        | GI_RIGHT_NEW := GI_RIGHT_TABLE and ROWS_VALUE[?][LW_RIGHT] >= long(TABLE_COUNT)
        | GI_RIGHT_ID := if GI_RIGHT_TABLE then integer(ROWS_VALUE[?][LW_RIGHT]) else 0
        | GI_RIGHT_FIRST := if GI_RIGHT_NEW then NEW_TABLE_START[?][GI_RIGHT_ID - TABLE_COUNT] else TABLE_LOW[GI_RIGHT_ID]
        | GI_RIGHT_MOD := NEW_TABLE_MOD[?][if GI_RIGHT_NEW then GI_RIGHT_ID - TABLE_COUNT else 0]
        | GI_RIGHT_LAST := if GI_RIGHT_NEW then GI_RIGHT_FIRST + NEW_TABLE_STEP[?][GI_RIGHT_ID - TABLE_COUNT] * ((if GI_RIGHT_MOD > long(0) then GI_RIGHT_MOD else long(RT_SIZE)) - long(1))
                           else TABLE_HIGH[GI_RIGHT_ID]
        | GI_RIGHT_LOW := if GI_RIGHT_LAST < GI_RIGHT_FIRST then GI_RIGHT_LAST else GI_RIGHT_FIRST
        | GI_RIGHT_HIGH := if GI_RIGHT_LAST < GI_RIGHT_FIRST then GI_RIGHT_FIRST else GI_RIGHT_LAST
        | GI_LEFT_TABLE := LW_LEFT_OP = OP_TABLE
        | GI_LEFT_NEW := GI_LEFT_TABLE and ROWS_VALUE[?][LW_LEFT] >= long(TABLE_COUNT)
        | GI_LEFT_ID := if GI_LEFT_TABLE then integer(ROWS_VALUE[?][LW_LEFT]) else 0
        | GI_LEFT_FIRST := if GI_LEFT_NEW then NEW_TABLE_START[?][GI_LEFT_ID - TABLE_COUNT] else TABLE_LOW[GI_LEFT_ID]
        | GI_LEFT_MOD := NEW_TABLE_MOD[?][if GI_LEFT_NEW then GI_LEFT_ID - TABLE_COUNT else 0]
        | GI_LEFT_LAST := if GI_LEFT_NEW then GI_LEFT_FIRST + NEW_TABLE_STEP[?][GI_LEFT_ID - TABLE_COUNT] * ((if GI_LEFT_MOD > long(0) then GI_LEFT_MOD else long(LT_SIZE)) - long(1))
                          else TABLE_HIGH[GI_LEFT_ID]
        | GI_LEFT_LOW := if GI_LEFT_LAST < GI_LEFT_FIRST then GI_LEFT_LAST else GI_LEFT_FIRST
        | GI_LEFT_HIGH := if GI_LEFT_LAST < GI_LEFT_FIRST then GI_LEFT_FIRST else GI_LEFT_LAST
        | GI_RIGHT_BOUND := if LW_IS_FLATV then SB_LEVEL_SIZE else LT_SIZE
        | GI_LEFT_BOUND := if LW_IS_RESTRUCTURE then ulong(OW_TOTAL)
                           else if SB_NEW then NEW_TYPE_SIZE[?][LW_SUBJECT - TYPE_COUNT] else TYPE_SIZE[LW_SUBJECT]
        | GI_LEFT_OUT := (LW_IS_FLATV or LW_IS_RESTRUCTURE and RS_SCATTER) and GI_LEFT_TABLE and (GI_LEFT_LOW < long(0) or ulong(GI_LEFT_HIGH) >= GI_LEFT_BOUND)
        | GI_RIGHT_OUT := GI_RIGHT_TABLE and (GI_RIGHT_LOW < long(0) or ulong(GI_RIGHT_HIGH) >= GI_RIGHT_BOUND)
        | GI_OUTSIDE := GI_LEFT_OUT or GI_RIGHT_OUT
        | GI_VALUE := if GI_LEFT_OUT then (if GI_LEFT_LOW < long(0) then GI_LEFT_LOW else GI_LEFT_HIGH)
                      else if GI_RIGHT_LOW < long(0) then GI_RIGHT_LOW else GI_RIGHT_HIGH
        | GI_LIMIT := if GI_LEFT_OUT then GI_LEFT_BOUND else GI_RIGHT_BOUND
        | LW_FROM_REPEAT := integer(TOKEN_CODE[LW_ENTRY_TOKEN]) = C_BAR_STAR
        | LW_RANGE_SIZE := if LW_LOOP_NOW >= 0 and LW_LOOP_NOW < FLAT_LOOP_COUNT and LW_INDEX_SIGNAL_ROW >= 0
                           then LEVEL_SIZE[?][4 * LW_LOOP_NOW + integer(ROWS_VALUE[?][LW_INDEX_ROW])]
                           else if LW_LOOP_NOW >= 0 then LOOP_SIZE[?][LW_LOOP_NOW] else ulong(0)
        | LW_INDEX_SIGNAL_ROW := if ROWS_OP[?][LW_INDEX_ROW] = OP_ITER then ROWS_LEFT[?][LW_INDEX_ROW] else -1
        | LW_INDEX_DEF := if LW_INDEX_SIGNAL_ROW >= 0 then SIGNAL_TOP[?][LW_INDEX_SIGNAL_ROW] - 1 else -1
        | LW_INDEX_DEF_SAFE := if LW_INDEX_DEF >= 0 then LW_INDEX_DEF else 0
        | LW_INDEX_COUNTS := LW_INDEX_DEF >= 0
                             and (ROWS_OP[?][LW_INDEX_DEF_SAFE] = OP_RANGE
                                  and (integer(TOKEN_CODE[ROWS_TOKEN[?][LW_INDEX_DEF_SAFE]]) = C_BAR_STAR
                                       or integer(TOKEN_CODE[ROWS_TOKEN[?][LW_INDEX_DEF_SAFE] - 1]) = C_ARRAY)
                                  or ROWS_OP[?][LW_INDEX_DEF_SAFE] = OP_TABLE
                                     and long(LW_IOTA[?][ROWS_TYPE[?][LW_INDEX_DEF_SAFE]] - 1) = ROWS_VALUE[?][LW_INDEX_DEF_SAFE])
        | LW_RANGE_MISMATCH := LW_IS_NEXT and LW_LOOP_NOW >= 0 and LW_INDEX_COUNTS
                               and (if LW_FROM_REPEAT then LW_RANGE_SIZE /= LT_SIZE else LW_RANGE_SIZE > LT_SIZE)
        | LW_CALL_TYPE := if LW_NAME < BUILTIN_TYPE_COUNT then LW_NAME else if NAME_TYPE[LW_NAME] > 0 then NAME_TYPE[LW_NAME] - 1
                          else NAME_ALIAS[LW_NAME] - 1
        | LW_CALL_KIND := TYPE_KIND[LW_CALL_TYPE]
        | LW_CONVERTS := LT = LW_CALL_TYPE
                         or LW_CALL_KIND = TK_REAL and (LT_INT or LT_REAL or LT_KIND = TK_BOOLEAN or LT_KIND = TK_ENUM or LT_KIND = TK_CHAR)
                         or (LW_CALL_KIND = TK_INT or LW_CALL_KIND = TK_CHAR) and LT_REAL
                         or (LW_CALL_KIND = TK_REAL or LW_CALL_KIND = TK_INT or LW_CALL_KIND = TK_CHAR or LW_CALL_KIND = TK_COMPLEX) and LT_CX
                         or LW_CALL_KIND = TK_INT and (LT_INT or LT_KIND = TK_BOOLEAN or LT_KIND = TK_ENUM or LT_KIND = TK_CHAR)
                         or LW_CALL_KIND = TK_CHAR and (LT_INT or LT_KIND = TK_BOOLEAN)
                         or LW_CALL_TYPE = BUILTIN_POINTER and (LT = BUILTIN_ULONG or LT = BUILTIN_UINTEGER)
                         or LT = BUILTIN_POINTER and (LW_CALL_TYPE = BUILTIN_ULONG or LW_CALL_TYPE = BUILTIN_UINTEGER)
        | LW_INTEGER_OP := LW_OP = OP_ADD or LW_OP = OP_SUB or LW_OP = OP_MUL or LW_OP = OP_DIV or LW_OP = OP_MOD or LW_OP = OP_NEG
        | LW_COMPARE_OP := LW_OP = OP_EQ or LW_OP = OP_NE or LW_OP = OP_LT or LW_OP = OP_LE or LW_OP = OP_GT or LW_OP = OP_GE
        | LW_LOGIC_OP := LW_OP = OP_AND or LW_OP = OP_OR or LW_OP = OP_XOR or LW_OP = OP_NOT
        | LW_SHIFT_OP := LW_OP = OP_SHL or LW_OP = OP_SHR
        | LW_POINTER_ARITHMETIC := (LW_OP = OP_ADD or LW_OP = OP_SUB) and (LT = BUILTIN_POINTER or RT = BUILTIN_POINTER)
        | LW_IF_EFFECT := FIRST_EFFECT[?][LW_RIGHT] - 1
        | LW_INITIAL_TYPE := if LW_INITIAL = 1 then FINAL_TYPE[LW_SRC] else LW_ENUM_TYPE
        | LW_INITIAL_VALUE := if LW_INITIAL = 1 then FINAL_VALUE[LW_SRC] else long(LK_VALUE)
        | LW_STATEVAR_INIT_TYPE := if LW_STATEVAR_INIT_KIND = INIT_NAME then CONSTANT_TYPE[if LW_STATEVAR_CONSTANT >= 0 then LW_STATEVAR_CONSTANT else 0]
                                   else SIGNAL_INIT_TYPE[LW_STATEVAR_DECL]
        | IW_WIDENS := if AT_LS_STATEVAR then LW_STATEVAR_HOLDS and not LW_STATEVAR_ENUM and ROWS_TYPE[?][LW_I] = BUILTIN_DREAL
                                                and LW_STATEVAR_INIT_TYPE = BUILTIN_REAL
                       else LW_INITIAL = 1 and LT = BUILTIN_DREAL and LW_INITIAL_TYPE = BUILTIN_REAL
        | IW_RAW := if AT_LS_STATEVAR then LW_STATEVAR_INIT else LW_INITIAL_VALUE
        | IW_BITS := ulong(IW_RAW) and ulong(4294967295)
        | IW_SIGN := (IW_BITS shr 31) shl 63
        | IW_EXPONENT := integer((IW_BITS shr 23) and ulong(255))
        | IW_FRACTION := IW_BITS and ulong(8388607)
        | IW_A16 := IW_FRACTION >= ulong(65536)
        | IW_A1 := if IW_A16 then IW_FRACTION shr 16 else IW_FRACTION
        | IW_A8 := IW_A1 >= ulong(256)
        | IW_A2 := if IW_A8 then IW_A1 shr 8 else IW_A1
        | IW_A4 := IW_A2 >= ulong(16)
        | IW_A3 := if IW_A4 then IW_A2 shr 4 else IW_A2
        | IW_A2B := IW_A3 >= ulong(4)
        | IW_A5 := if IW_A2B then IW_A3 shr 2 else IW_A3
        | IW_LENGTH := 16 * integer(IW_A16) + 8 * integer(IW_A8) + 4 * integer(IW_A4) + 2 * integer(IW_A2B)
                       + integer(IW_A5 >= ulong(2)) + integer(IW_A5 >= ulong(1))
        | IW_SUBNORMAL := (IW_FRACTION shl (53 - IW_LENGTH)) and ulong(4503599627370495)
        | LW_INIT_VALUE := if not IW_WIDENS then IW_RAW
                           else long(IW_SIGN
                                     or (if IW_EXPONENT = 255 then (ulong(2047) shl 52) or (IW_FRACTION shl 29)
                                         else if IW_EXPONENT > 0 then (ulong(IW_EXPONENT + 896) shl 52) or (IW_FRACTION shl 29)
                                         else if IW_FRACTION = ulong(0) then ulong(0)
                                         else (ulong(IW_LENGTH + 873) shl 52) or IW_SUBNORMAL))
        | LW_OPERATOR_MESSAGE := if LW_DELAY_SELF then T_DELAY_IN_ITERATE else if LW_NOT_IN_ITERATE then T_NOT_IN_ITERATE
                                 else if LW_NOT_IN_EXTENSION then T_NOT_IN_EXTENSION
                                 else if LW_IS_TRANSPOSE then
                                   (if LW_LEFT_ARRAY_VALUE then T_ARRAY_VALUE else if MX_L_RANK /= 2 then T_RANK_TWO
                                    else if not MX_WHOLE then T_MATRIX_PLACED else if MX_TRANSPOSE_FAILS then T_MATRIX_SHAPE else 0)
                                 else if LW_IS_MATPROD then
                                   (if LW_LEFT_ARRAY_VALUE or LW_RIGHT_ARRAY_VALUE then T_ARRAY_VALUE
                                    else if MX_OPERANDS_FAIL then T_MATRIX_SHAPE
                                    else if TYPE_KIND[MX_L_LEAF] /= TK_INT then T_INTEGER_OPERANDS
                                    else if MX_DOT then (if LW_LOOP_NOW >= 0 then T_MATRIX_PLACED else 0)
                                    else if not MX_WHOLE then T_MATRIX_PLACED else if MX_PRODUCT_FAILS then T_MATRIX_SHAPE else 0)
                                 else if LW_OP = OP_SPAN then 0
                                 else if LW_IS_AXIS then (if AX_CONSTANT_FAILS then T_AXIS_CONSTANT else if AX_SHAPE_FAILS then T_AXIS_SHAPE else 0)
                                 else if LW_IS_STEP then (if LW_IS_RANGE_TABLE and (SP_FAILS or SP_EMPTY) then T_RANGE_TABLE_BOUNDS else if SP_FAILS then T_STEP_CONSTANT else if SP_EMPTY then T_STEP_EMPTY else 0)
                                 else if LW_OP = OP_PUT then
                                   (if LW_RIGHT_PAIR then T_PAIR_OPERAND else if LW_RIGHT_ARRAY_VALUE then T_ARRAY_VALUE
                                    else if PUT_SHAPE_FAILS then T_ENUM_SHAPE else if not LUB_SUBTYPE then T_ENUM_TYPE else 0)
                                 else if LW_IS_RESTRUCTURE then
                                   (if LW_LEFT_OP = OP_PAIR or LW_RIGHT_PAIR or not OW_ARRAY then T_PAIR_OPERAND
                                    else if LW_LEFT_ARRAY_VALUE or LW_RIGHT_ARRAY_VALUE then T_ARRAY_VALUE
                                    else if RS_SCATTER then (if not OW_RANK_ONE then T_SUBARRAY_TARGET else if RS_SHAPE_FAILS then T_RESTRUCTURE_SHAPE else if GI_LEFT_OUT then T_INDEX_RANGE else 0)
                                    else if not LT_INT then T_INDEX_INTEGER
                                    else if not OW_RANK_ONE and LW_LEFT_OP /= OP_FLAT then T_SUBARRAY_TARGET
                                    else if not LUB_SUBTYPE then T_RESTRUCTURE_TYPE else 0)
                                 else if LW_ARRAY_EQ then
                                   (if LW_LEFT_OP = OP_PAIR or LW_RIGHT_PAIR then T_PAIR_OPERAND
                                    else if LW_LEFT_ARRAY_VALUE or LW_RIGHT_ARRAY_VALUE then T_ARRAY_VALUE
                                    else if LT_KIND /= TK_ARRAY or RT_KIND /= TK_ARRAY or LT_SIZE /= RT_SIZE or LT_ELEMENT /= RT_ELEMENT
                                    then T_ONE_TYPE else 0)
                                 else if LW_IS_CONCAT then
                                   (if LW_LEFT_OP = OP_PAIR or LW_RIGHT_PAIR then T_PAIR_OPERAND
                                    else if LW_LEFT_ARRAY_VALUE or LW_RIGHT_ARRAY_VALUE then T_ARRAY_VALUE
                                    else if LT_KIND /= TK_ARRAY or RT_KIND /= TK_ARRAY or LT_ELEMENT /= RT_ELEMENT then T_CONCAT_TYPE else 0)
                                 else if LW_LEFT_OP = OP_PAIR then T_PAIR_OPERAND
                                 else if LW_BRANCHES_BUILD then T_STRING_BRANCHES
                                 else if LW_LEFT_ARRAY_VALUE then (if LT_KIND = TK_STRING then T_STRING_VALUE else T_ARRAY_VALUE)
                                 else if LW_RIGHT_PAIR then T_PAIR_OPERAND
                                 else if LW_RIGHT_ARRAY_VALUE then (if RT_KIND = TK_STRING then T_STRING_VALUE else T_ARRAY_VALUE)
                                 else if LW_IS_PREV and LW_PREV_MESSAGE /= 0 then LW_PREV_MESSAGE
                                 else if LW_STATE_NOT then T_STATEVAR_NOT
                                 else if LW_IS_INDICES and LW_INDICES_FAILS then T_INDICES_CONSTANT
                                 else if LW_IS_INDICES then 0
                                 else if LW_IS_DIM then 0
                                 else if LW_IS_DIM_SIZE then (if SB_AXIS_FAILS then T_SIZE_AXIS else 0)
                                 else if LW_IS_FLAT then
                                   (if SB_KIND /= TK_ARRAY then T_NOT_ARRAY
                                    else if LW_IS_FLATV then
                                      (if LW_LEFT_OP = OP_FLATV then T_EXTRACT_RANK
                                       else if LT_KIND /= TK_ARRAY or RT_KIND /= TK_ARRAY or LT_SIZE /= RT_SIZE or LT_ELEMENT /= RT_ELEMENT
                                               or TYPE_KIND[LT_ELEMENT] /= TK_INT then T_EXTRACT_INDEX
                                       else if SB_RANK < LW_FLAT_LEVEL then T_INDEX_COUNT
                                       else if GI_OUTSIDE then T_INDEX_RANGE else 0)
                                    else if not LT_INT or not RT_INT then T_INDEX_INTEGER
                                    else if SB_RANK < LW_FLAT_LEVEL then T_INDEX_COUNT else 0)
                                 else if LW_INDEXES and LT_KIND /= TK_ARRAY then T_NOT_ARRAY
                                 else if (LW_IS_NEXT or LW_IS_TARGET_INDEX) and SB_RANK > LW_INDEX_K then T_SUBARRAY_TARGET
                                 else if LW_IS_GATHER and SB_RANK > LW_INDEX_K then T_EXTRACT_SUBARRAY
                                 else if LW_OP = OP_RANGE then
                                   (if not RG_START_CONST or not LT_INT then T_RANGE_START
                                    else if not RT_INT then T_RANGE_BOUND
                                    else if not RG_END_CONST and RG_START_VALUE /= long(0) then T_RANGE_END
                                    else if not RG_END_CONST and SIGNAL_LEVEL[?][LW_SIGNAL_NOW] > 1 then T_LOOP_COUNT_INNER else 0)
                                 else if LW_OP = OP_PREV then 0
                                 else if LW_IS_GATHER then (if TYPE_KIND[RT_ELEMENT] /= TK_INT then T_INDEX_INTEGER else if GI_OUTSIDE then T_INDEX_RANGE else 0)
                                 else if LW_INDEXES then
                                   (if LW_IS_NEXT and LW_RIGHT_OP /= OP_PAIR then T_NEXT_PAIR
                                    else if not LW_INDEX_INT then T_INDEX_INTEGER
                                    else if LW_INDEX_OUTSIDE then T_INDEX_RANGE
                                    else if LW_RANGE_MISMATCH then (if LW_FROM_REPEAT then T_REPEAT_SIZE else T_RANGE_FIT)
                                    else if LW_IS_NEXT and not LUB_SUBTYPE then
                                      (if LW_FROM_REPEAT then T_REPEAT_TYPE else T_NEXT_TYPE)
                                    else 0)
                                 else if LW_OP = OP_GDELAY and not LW_COUNT_OK then T_DELAY_COUNT
                                 else if LW_IS_WINDOW and not LW_COUNT_OK then T_WINDOW_SIZE
                                 else if (LW_IS_LAG or LW_IS_WINDOW) and LW_INITIAL /= 0 and LW_INIT_SHAPE_FAILS then T_DELAY_INIT_SHAPE
                                 else if LW_IS_LAG or LW_IS_WINDOW then 0
                                 else if LW_OP = OP_WHEN and LT_BLOCK and not RT_BLOCK
                                 then (if RT_LOGICAL then 0 else T_WHEN_CONDITION)
                                 else if LW_OP = OP_DEFAULT and LT_BLOCK and RT_BLOCK
                                 then (if LT_KIND = RT_KIND and LT_SIZE = RT_SIZE and LT_ELEMENT = RT_ELEMENT then 0 else T_ONE_TYPE)
                                 else if LW_ARRAY_OPERAND and LW_OP /= OP_CALL then (if PW_POINTWISE then T_EXTENSION_WHOLE else T_SCALAR_OPERANDS)
                                 else if LW_OP = OP_PAIR then 0
                                 else if LW_OP = OP_BOUNDS_PAIR or LW_OP = OP_BOUNDS then (if LUB < 0 then T_BOUNDS_TYPES else 0)
                                 else if LW_OP = OP_BRANCH then (if LUB < 0 then T_IF_TYPES else 0)
                                 else if LW_OP = OP_IF then
                                   (if not LT_LOGICAL then T_IF_CONDITION else if LW_IF_EFFECT >= 0 then T_EFFECT_IN_IF else 0)
                                 else if LW_OP = OP_CALL then (if LW_CONVERTS then 0 else T_NO_CONVERSION)
                                 else if LW_POINTER_ARITHMETIC then
                                   (if LT /= BUILTIN_POINTER or not RT_INT then T_POINTER_OFFSET else 0)
                                 else if LW_FROM_ABS and not (LT_INT and TYPE_SIGNED[LT]) then T_ABS_SIGNED
                                 else if LW_OP = OP_CPAIR then (if LT_REAL and RT_REAL then 0 else T_REAL_OPERANDS)
                                 else if LW_CX_FUNCTION then (if LT_CX and (LW_CX_D or LT = BUILTIN_COMPLEX) then 0 else T_COMPLEX_ARGUMENT)
                                 else if LW_INTEGER_OP then
                                   (if LT_INT and RT_INT then (if LUB < 0 then T_COMPARABLE else 0)
                                    else if LW_OP = OP_MOD or not ((LT_INT or LT_REAL or LT_CX) and (RT_INT or RT_REAL or RT_CX)) then T_INTEGER_OPERANDS
                                    else if LUB < 0 then T_COMPARABLE else 0)
                                 else if LW_COMPARE_OP then
                                   (if LUB >= 0 then (if LT_CX and LW_OP /= OP_EQ and LW_OP /= OP_NE then T_ORDERED else 0)
                                    else if (LT_INT or LT_REAL or LT_CX) and (RT_INT or RT_REAL or RT_CX) then T_COMPARABLE else T_ONE_TYPE)
                                 else if LW_LOGIC_OP then
                                   (if LT_LOGICAL and RT_LOGICAL then 0 else if not (LT_INT and RT_INT) then T_BOOLEAN_OPERANDS
                                    else if TYPE_SIGNED[LT] or TYPE_SIGNED[RT] then T_UNSIGNED_OPERANDS else 0)
                                 else if LW_SHIFT_OP then
                                   (if LT_INT and not TYPE_SIGNED[LT] and RT_INT then 0 else T_UNSIGNED_OPERANDS)
                                 else if LW_OP = OP_WHEN then (if RT_LOGICAL then 0 else T_WHEN_CONDITION)
                                 else if LW_OP = OP_UWHEN then (if LT_LOGICAL then 0 else T_WHEN_CONDITION)
                                 else if LW_OP = OP_DEFAULT then (if LUB < 0 then T_ONE_TYPE else 0)
                                 else if LW_OP = OP_CLOCK then (if LW_COUNTER_OP >= 0 and LT /= BUILTIN_EVENT then T_COUNTER_EVENT else 0)
                                 else if LW_INITIAL = 2 and LW_ENUM_MESSAGE /= 0 then LW_ENUM_MESSAGE
                                 else if LW_INITIAL /= 0 and (LT = BUILTIN_EVENT or not LUB_SUBTYPE) then T_DELAY_MATCH else 0
        | LW_OPERATOR_TOKEN := if LW_OPERATOR_MESSAGE = T_PAIR_OPERAND then
                                 (if LW_LEFT_OP = OP_PAIR then ROWS_TOKEN[?][LW_LEFT] else ROWS_TOKEN[?][LW_RIGHT])
                               else if LW_OPERATOR_MESSAGE = T_EFFECT_IN_IF then ROWS_TOKEN[?][LW_IF_EFFECT]
                               else if LW_INDEXES and not LW_IS_GATHER and (LW_OPERATOR_MESSAGE = T_INDEX_INTEGER
                                                                         or LW_OPERATOR_MESSAGE = T_INDEX_RANGE)
                               then LW_INDEX_TOKEN
                               else if LW_OPERATOR_MESSAGE = LW_ENUM_MESSAGE then LW_ENUM_TOKEN
                               else LW_ENTRY_TOKEN
        | LW_OP_TEXT := if integer(TOKEN_CODE[LW_ENTRY_TOKEN]) = C_EQUAL_EQUAL or integer(TOKEN_CODE[LW_ENTRY_TOKEN]) = C_LESS_LESS_EQUAL
                      then SYMBOL_FRAGMENT[integer(TOKEN_CODE[LW_ENTRY_TOKEN]) - C_SYMBOL_BASE] else OP_TEXT_FRAGMENT[LW_OP]
        | LW_COUNTER_OP := if integer(TOKEN_CODE[LW_ENTRY_TOKEN]) = C_AFTER then OP_AFTER else if integer(TOKEN_CODE[LW_ENTRY_TOKEN]) = C_FROM then OP_FROM
                           else if integer(TOKEN_CODE[LW_ENTRY_TOKEN]) = C_COUNT then OP_COUNT else -1
        | LW_CX_FUNCTION := LW_OP = OP_CONJ or LW_OP = OP_RPART or LW_OP = OP_IPART or LW_OP = OP_MODU
        | LW_CX_NAME := TOKEN_NAME[LW_ENTRY_TOKEN] - 1
        | LW_CX_D := LW_CX_NAME = N_CONJD or LW_CX_NAME = N_RPARTD or LW_CX_NAME = N_IPARTD or LW_CX_NAME = N_MODUD
        | LW_FROM_ABS := LW_OP = OP_LT and integer(TOKEN_CODE[LW_ENTRY_TOKEN]) = C_NAME and TOKEN_NAME[LW_ENTRY_TOKEN] - 1 = N_ABS
        | LW_OPERATOR_ARGUMENT0 := if LW_OPERATOR_MESSAGE = T_ENUM_TYPE then SB_LEAF
                                   else if LW_OPERATOR_MESSAGE = T_PREV_OUTSIDE or LW_OPERATOR_MESSAGE = T_PREV_UNDEFINED
                                      or LW_OPERATOR_MESSAGE = T_STATEVAR_NOT or LW_OPERATOR_MESSAGE = T_DELAY_IN_ITERATE
                                   then LW_SIGNAL_KEY[?][LW_LEFT]
                                   else if LW_OPERATOR_MESSAGE = T_NEXT_TYPE or LW_OPERATOR_MESSAGE = T_REPEAT_TYPE then LT_ELEMENT
                                   else if LW_OPERATOR_MESSAGE = T_IF_TYPES or LW_OPERATOR_MESSAGE = T_NO_CONVERSION
                                           or LW_OPERATOR_MESSAGE = T_ABS_SIGNED then LT
                                   else if LW_OPERATOR_MESSAGE = T_EFFECT_IN_IF then EFFECT_KIND[?][integer(ROWS_VALUE[?][LW_IF_EFFECT])]
                                   else if LW_OPERATOR_MESSAGE = LW_ENUM_MESSAGE then LW_ENUM_ARGUMENT0
                                   else if LW_OPERATOR_MESSAGE = T_COUNTER_EVENT then OP_TEXT_FRAGMENT[LW_COUNTER_OP]
                                   else if LW_OPERATOR_MESSAGE = T_REPEAT_SIZE or LW_OPERATOR_MESSAGE = T_RANGE_FIT then integer(LW_RANGE_SIZE)
                                   else if LW_OPERATOR_MESSAGE = T_COMPLEX_ARGUMENT then LW_CX_NAME
                                   else LW_OP_TEXT
        | LW_OPERATOR_ARGUMENT1 := if LW_OPERATOR_MESSAGE = T_ENUM_TYPE or LW_OPERATOR_MESSAGE = T_RESTRUCTURE_TYPE or LW_OPERATOR_MESSAGE = T_NEXT_TYPE or LW_OPERATOR_MESSAGE = T_REPEAT_TYPE or LW_OPERATOR_MESSAGE = T_IF_TYPES then RT
                                   else if LW_OPERATOR_MESSAGE = T_NO_CONVERSION then LW_CALL_TYPE
                                   else if LW_OPERATOR_MESSAGE = T_COMPLEX_ARGUMENT then (if LW_CX_D then BUILTIN_DCOMPLEX else BUILTIN_COMPLEX)
                                   else if LW_OPERATOR_MESSAGE = T_REPEAT_SIZE or LW_OPERATOR_MESSAGE = T_RANGE_FIT then integer(LT_SIZE)
                                   else if LW_OPERATOR_MESSAGE = T_NO_VALUE then LW_ENUM_VALUE_KEY else LT
        | LUB_A := if LW_FINISHING then LW_END_TYPE
                   else if FX_CHECKS then (if FX_IS_STORE then FX_T1 else FX_T0)
                   else if LW_IS_NEXT or LW_OP = OP_PUT or LW_IS_RESTRUCTURE then RT
                   else if LW_IS_DELAY then LW_INITIAL_TYPE else LT
        | LUB_B := if LW_FINISHING then (if LW_SEED_FILL then OW_LEAF else LW_END_SIGNAL_TYPE)
                   else if FX_CHECKS then (if FX_IS_STORE then FX_TYPE1 else BUILTIN_ULONG)
                   else if LW_IS_NEXT then (if LW_INDEX_K > 1 then SB_LEAF else LT_ELEMENT) else if LW_OP = OP_PUT then SB_LEAF else if LW_IS_RESTRUCTURE then OW_LEAF
                   else if LW_IS_DELAY then LT else RT
        | LUB_A_KIND := if LUB_A >= TYPE_COUNT then TK_ARRAY else TYPE_KIND[LUB_A]
        | LUB_B_KIND := if LUB_B >= TYPE_COUNT then TK_ARRAY else TYPE_KIND[LUB_B]
        | LUB_A_BYTES := TYPE_BYTES[LUB_A]
        | LUB_B_BYTES := TYPE_BYTES[LUB_B]
        | LUB_A_SIGNED := TYPE_SIGNED[LUB_A]
        | LUB_B_SIGNED := TYPE_SIGNED[LUB_B]
        | LUB_UNSIGNED_BYTES := if LUB_A_SIGNED then LUB_B_BYTES else LUB_A_BYTES
        | LUB_SIGNED_BYTES := if LUB_A_SIGNED then LUB_A_BYTES else LUB_B_BYTES
        | LUB_SIGNED := if LUB_A_SIGNED then LUB_A else LUB_B
        | LUB_WIDENED := if LUB_UNSIGNED_BYTES = 1 then BUILTIN_SHORT else if LUB_UNSIGNED_BYTES = 2 then BUILTIN_INTEGER
                         else if LUB_UNSIGNED_BYTES = 4 then BUILTIN_LONG else -1
        | LUB := if LUB_A = LUB_B then LUB_A
                 else if (LUB_A_KIND = TK_EVENT or LUB_A_KIND = TK_BOOLEAN) and (LUB_B_KIND = TK_EVENT or LUB_B_KIND = TK_BOOLEAN)
                 then BUILTIN_BOOLEAN
                 else if LUB_A_KIND = TK_REAL and LUB_B_KIND = TK_REAL then BUILTIN_DREAL
                 else if LUB_A_KIND = TK_COMPLEX and LUB_B_KIND = TK_COMPLEX then BUILTIN_DCOMPLEX
                 else if LUB_A_KIND /= TK_INT or LUB_B_KIND /= TK_INT then -1
                 else if LUB_A_SIGNED = LUB_B_SIGNED then (if LUB_A_BYTES > LUB_B_BYTES then LUB_A else LUB_B)
                 else if LUB_SIGNED_BYTES > LUB_UNSIGNED_BYTES then LUB_SIGNED else LUB_WIDENED
        | LUB_SUBTYPE := LUB = LUB_B
        | LW_RESULT_OP := if LW_IS_ITER then OP_ITER else if LW_FROM_CONSTANT then
                            (if TYPE_KIND[CONSTANT_TYPE[LW_CONSTANT]] = TK_ARRAY or TYPE_KIND[CONSTANT_TYPE[LW_CONSTANT]] = TK_STRING then OP_TABLE else OP_CONST)
                          else if LW_IS_CONST and FINAL_TYPE[LW_SRC] = BUILTIN_STRING then OP_TABLE
                          else if LW_IS_CONST or LW_IS_ENUM then OP_CONST
                          else if LW_IS_DEFAULTS or LW_IS_STEP then OP_TABLE
                          else if LW_IS_RESTRUCTURE then OP_RESTRUCTURE
                          else if LW_IS_FLATV then OP_FLATV
                          else if LW_ARRAY_EQ then OP_ARRAY_EQ
                          else if LW_IS_GATHER then OP_GATHER
                          else if LW_IS_SLICE then OP_SLICE
                          else if LW_DIM_DETACHES then OP_CONST
                          else if LW_OP = OP_INDEX then OP_ELEMENT
                          else if LW_OP = OP_CALL then OP_CONVERT else if LW_GD_PLAIN then OP_DELAY else if LW_IS_LAG then OP_LAG else LW_OP
        | LW_RESULT_TYPE := if LW_IS_ITER then TYPE_ELEMENT[ROWS_TYPE[?][LW_ITER_ROW]]
                            else if LW_FROM_CONSTANT then CONSTANT_TYPE[LW_CONSTANT]
                            else if LW_IS_CONST then (if LW_IS_SLOT then BIND_TYPE[LW_BIND_ROW] else FINAL_TYPE[LW_SRC])
                            else if LW_IS_ENUM then LW_ENUM_TYPE
                            else if LW_IS_DEFAULTS or LW_IS_RESTRUCTURE or LW_IS_TRANSPOSE or LW_IS_MATPROD and not MX_DOT then OW_TYPE
                            else if LW_IS_MATPROD then MX_L_LEAF
                            else if LW_IS_STEP then LW_INTERNED
                            else if LW_OP = OP_SPAN then RT
                            else if LW_OP = OP_RANGE or LW_OP = OP_PREV or LW_IS_NEXT or LW_OP = OP_PUT or LW_SHIFT_OP or LW_IS_DELAY or LW_IS_LAG
                                    or LW_OP = OP_WHEN or LW_POINTER_ARITHMETIC or LW_OP = OP_DEFAULT and LT_BLOCK then LT
                            else if LW_IS_GATHER or LW_IS_CONCAT or LW_IS_WINDOW then LW_INTERNED
                            else if LW_IS_SLICE then SB_SLICE_TYPE
                            else if LW_FOLDS then BUILTIN_INTEGER
                            else if LW_OP = OP_INDEX then SB_LEAF
                            else if LW_IS_FLATV then LT
                            else if LW_OP = OP_FLAT then BUILTIN_LONG
                            else if LW_OP = OP_PAIR or LW_OP = OP_IF or LW_OP = OP_MOD then RT
                            else if LW_OP = OP_CALL then LW_CALL_TYPE
                            else if LW_COMPARE_OP then BUILTIN_BOOLEAN
                            else if LW_OP = OP_CPAIR then (if LUB = BUILTIN_REAL then BUILTIN_COMPLEX else BUILTIN_DCOMPLEX)
                            else if LW_OP = OP_CONJ then (if LW_CX_D then BUILTIN_DCOMPLEX else BUILTIN_COMPLEX)
                            else if LW_CX_FUNCTION then (if LW_CX_D then BUILTIN_DREAL else BUILTIN_REAL)
                            else if LW_LOGIC_OP and LT_LOGICAL and RT_LOGICAL then BUILTIN_BOOLEAN
                            else if LW_OP = OP_UWHEN or LW_OP = OP_CLOCK then BUILTIN_EVENT else LUB
        | LW_RESULT_VALUE := if LW_IS_ITER then long(LW_ITER_LEVEL) else if LW_FROM_CONSTANT then CONSTANT_VALUE[LW_CONSTANT]
                             else if LW_IS_CONST then (if LW_IS_SLOT then BIND_VALUE[LW_BIND_ROW] else FINAL_VALUE[LW_SRC])
                             else if LW_IS_ENUM then long(LK_VALUE)
                             else if LW_IS_DEFAULTS or LW_IS_STEP then long(LW_NEW_TABLE)
                             else if LW_OP = OP_PUT then PUT_OFFSET
                             else if LW_IS_TRANSPOSE then long(MX_L_COLS) else if LW_IS_MATPROD then long(MX_R_COLS)
                             else if LW_IS_GATHER and LW_RIGHT_OP = OP_FLATV then ROWS_VALUE[?][LW_RIGHT]
                             else if LW_IS_DELAY then
                               (if LT = BUILTIN_EVENT then long(1) else if LW_INITIAL /= 0 then LW_INIT_VALUE else long(0))
                             else if LW_IS_LAG then LW_LAG_COUNT
                             else if LW_IS_WINDOW then LW_COUNT
                             else if LW_OP = OP_FLAT then long(SB_LEVEL_SIZE)
                             else if LW_IS_SLICE then long(SB_BLOCKS)
                             else if LW_FOLDS then LW_FOLD_VALUE
                             else long(0)
        | LW_END_TOP := LW_STACK[?][LW_TOP_NOW - 1]
        | LW_END_TOP_OP := ROWS_OP[?][LW_END_TOP]
        | LW_END_TOP_TYPE := ROWS_TYPE[?][LW_END_TOP]
        | LW_MEMBER_NOW := LW_FL_MEMBER[?]
        | LW_SIGNAL_NOW := LW_FL_OWNER[?]
        | LW_END_SIGNAL_TYPE := ROWS_TYPE[?][if LW_IDENTITY_CHECKS then LW_IDENTITY_ROW else LW_SIGNAL_NOW]
        | LW_END_SEED := LW_FINISHING and not LW_MEMBER_NOW and LW_EQ_SEED
        | LW_END_DEFINES := LW_FINISHING and not LW_MEMBER_NOW and not LW_EQ_SEED and LW_SIGNAL_NOW >= 0
        | LW_END_RANGE := LW_END_DEFINES and LW_END_TOP_OP = OP_RANGE
        | LW_PARTIAL_ENDS := LW_END_DEFINES and LW_EQ_PARTIAL > 0
        | PT_X := LW_SIGNAL_NOW
        | PT_DEFAULT := LW_EQ_PARTIAL = 2
        | PT_HEAD := PARTIAL_HEAD[?][PT_X] - 1
        | PT_DV := PARTIAL_DV[?][PT_X] - 1
        | PT_LAST := PARTIAL_SEEN[?][PT_X] = PARTIAL_TOTAL[?][PT_X]
        | PT_W_CREATES := AT_LS_PARTIAL and LW_K = 0 and LW_FL_GUARD[?] >= 0
        | PT_CHAINS := AT_LS_PARTIAL and LW_K = 1 and not PT_DEFAULT
        | PT_H_CREATES := PT_CHAINS and PT_HEAD >= 0
        | PT_STATEVAR := STATE_ROW[?][PT_X] > 0
        | PT_Z_CREATES := AT_LS_PARTIAL and LW_K = 2 and PT_LAST and PT_DV < 0 and not PT_STATEVAR
        | PT_C_CREATES := AT_LS_PARTIAL and LW_K = 3 and PT_LAST and not PT_STATEVAR
        | PT_ARM_CREATES := AT_LS_PARTIAL and LW_K = 4 and PT_LAST and not PT_STATEVAR
        | PT_CLOSES := AT_LS_PARTIAL and LW_K = 5 and PT_LAST
        | PT_F_CREATES := PT_CLOSES and PT_HEAD >= 0 and not PT_STATEVAR
        | PT_CREATES := PT_W_CREATES or PT_H_CREATES or PT_Z_CREATES or PT_C_CREATES or PT_ARM_CREATES or PT_F_CREATES
        | PT_ROW_OP := if PT_Z_CREATES then OP_DELAY else if PT_C_CREATES then OP_CLOCK
                       else if PT_H_CREATES or PT_F_CREATES then OP_DEFAULT else OP_WHEN
        | PT_ROW_LEFT := if PT_W_CREATES then LW_END_TOP else if PT_Z_CREATES or PT_C_CREATES then PT_X
                         else if PT_ARM_CREATES then (if PT_DV >= 0 then PT_DV else PT_R[?]) else PT_HEAD
        | PT_ROW_RIGHT := if PT_W_CREATES then LW_FL_GUARD[?] else if PT_ARM_CREATES then PT_C[?]
                          else if PT_H_CREATES then PT_P[?] else if PT_F_CREATES then PT_A[?] else -1
        | PT_ROW_TYPE := if PT_W_CREATES then ROWS_TYPE[?][LW_END_TOP] else if PT_C_CREATES then BUILTIN_EVENT else ROWS_TYPE[?][PT_X]
        | PT_ROW_VALUE := if PT_Z_CREATES and HOLD_INITED[?][PT_X] then HOLD_INIT[?][PT_X]
                          else if PT_Z_CREATES and ROWS_TYPE[?][PT_X] = BUILTIN_EVENT then long(1) else long(0)
        | PT_P := if AT_LS_PARTIAL and LW_K = 0 then (if PT_W_CREATES then LW_ROW else LW_END_TOP) else PT_P[?]
        | PT_R := if PT_Z_CREATES then LW_ROW else PT_R[?]
        | PT_C := if PT_C_CREATES then LW_ROW else PT_C[?]
        | PT_A := if PT_ARM_CREATES then LW_ROW else PT_A[?]
        | PT_ENTERS := AT_LS_PARTIAL and LW_K = 0 and LW_GOES
        | PT_RECORDS := AT_LS_PARTIAL and LW_K = 1 and not PT_DEFAULT and LW_GOES
        | PD_SLOT := if PT_RECORDS then PD_COUNT[?] else -1
        | PD_ROW := PD_ROW[?] next PD_SLOT : PT_P[?]
        | PD_SIGNAL := PD_SIGNAL[?] next PD_SLOT : PT_X
        | PD_GUARD := PD_GUARD[?] next PD_SLOT : FLAT_EQUATION_GUARDS[LW_I]
        | PD_CONTEXT := PD_CONTEXT[?] next PD_SLOT : FLAT_EQUATION_CONTEXT[LW_I]
        | PD_COUNT := PD_COUNT[?] + integer(PD_SLOT >= 0)
        | SIGNAL_PARTIAL := SIGNAL_PARTIAL[?] next (if PT_ENTERS then PT_X else -1) : true
        | SIGNAL_DEFAULTED := SIGNAL_DEFAULTED[?] next (if PT_ENTERS and PT_DEFAULT then PT_X else -1) : true
        | PARTIAL_SEEN := PARTIAL_SEEN[?] next (if PT_ENTERS then PT_X else -1) : PARTIAL_SEEN[?][PT_X] + 1
        | PARTIAL_DV := PARTIAL_DV[?] next (if PT_ENTERS and PT_DEFAULT then PT_X else -1)
                        : (if PT_W_CREATES then LW_ROW + 1 else LW_END_TOP + 1)
        | PARTIAL_HEAD := PARTIAL_HEAD[?] next (if PT_CHAINS and LW_GOES then PT_X else -1)
                          : (if PT_H_CREATES then LW_ROW + 1 else PT_P[?] + 1)
        | LW_EQ_PARTIAL_TOTALS := LW_EQ_STEP = 0 and LW_EQ_PARTIAL > 0 and LK_VALUE >= 0
        | PARTIAL_TOTAL := PARTIAL_TOTAL[?] next (if LW_EQ_PARTIAL_TOTALS then LK_VALUE else -1) : PARTIAL_TOTAL[?][LK_VALUE] + 1
        | LW_END_TYPE := if LW_END_RANGE then LW_END_SIGNAL_TYPE else if LW_SEED_FILL then ROWS_TYPE[?][LW_SEED_VALUE] else LW_END_TOP_TYPE
        | LW_END_SIGNAL_ARRAY := TYPE_KIND[LW_END_SIGNAL_TYPE] = TK_ARRAY
        | LW_SEED_PAIR := LW_END_SEED and LW_END_TOP_OP = OP_PAIR
        | LW_SEED_INDEX := ROWS_LEFT[?][LW_END_TOP]
        | LW_SEED_INDEX_LEFT := ROWS_LEFT[?][LW_SEED_INDEX]
        | LW_SEED_BY_INDICES := if ROWS_OP[?][LW_SEED_INDEX] = OP_ITER then OW_RANK = 1
                                else ROWS_OP[?][LW_SEED_INDEX] = OP_FLAT and ROWS_OP[?][ROWS_RIGHT[?][LW_SEED_INDEX]] = OP_ITER
                                     and (if ROWS_OP[?][LW_SEED_INDEX_LEFT] = OP_ITER then OW_RANK = 2
                                          else ROWS_OP[?][LW_SEED_INDEX_LEFT] = OP_FLAT and OW_RANK = 3
                                               and ROWS_OP[?][ROWS_RIGHT[?][LW_SEED_INDEX_LEFT]] = OP_ITER
                                               and ROWS_OP[?][ROWS_LEFT[?][LW_SEED_INDEX_LEFT]] = OP_ITER)
        | LW_SEED_VALUE := if LW_SEED_PAIR then ROWS_RIGHT[?][LW_END_TOP] else LW_END_TOP
        | LW_SEED_FILL := LW_END_SEED and LW_END_SIGNAL_ARRAY and TYPE_KIND[ROWS_TYPE[?][LW_SEED_VALUE]] /= TK_ARRAY
        | LW_SEED_TWICE := LW_END_SEED and LW_SIGNAL_NOW >= 0 and SIGNAL_SEEDED[?][LW_SIGNAL_NOW]
        | SIGNAL_SEEDED := SIGNAL_SEEDED[?] next (if LW_END_SEED then LW_SIGNAL_NOW else -1) : true
        | LW_END_MESSAGE := if LW_SEED_TWICE then T_DEFINED_TWICE
                            else if LW_SEED_PAIR and not LW_SEED_BY_INDICES then T_SEED_ELEMENT
                            else if LW_END_TOP_OP = OP_PAIR and not LW_SEED_PAIR then T_PAIR_OPERAND
                            else if LW_END_SEED and LW_END_SIGNAL_ARRAY
                                    and (if LW_SEED_FILL then not LW_SEED_PAIR
                                         else not (LW_END_TOP_OP = OP_TABLE or LW_END_TOP < FLAT_SIGNAL_COUNT and LW_END_TOP_TYPE = LW_END_SIGNAL_TYPE))
                            then T_WITH_ARRAY
                            else if LW_END_RANGE and not (LW_END_SIGNAL_ARRAY and TYPE_KIND[TYPE_ELEMENT[LW_END_SIGNAL_TYPE]] = TK_INT)
                            then T_RANGE_DEFINES
                            else if (LW_END_SEED or LW_END_DEFINES or LW_IDENTITY_CHECKS) and not LUB_SUBTYPE then T_SIGNAL_TYPE
                            else if LW_END_DEFINES and LW_END_SIGNAL_ARRAY and LW_END_TOP_OP = OP_PREV then T_PREV_ARRAY
                            else if LW_END_DEFINES and LW_END_SIGNAL_ARRAY and LW_END_TOP_OP /= OP_TABLE and LW_END_TOP_OP /= OP_GATHER
                                    and LW_END_TOP_OP /= OP_NEXT and LW_END_TOP_OP /= OP_RANGE and LW_END_TOP_OP /= OP_SLICE
                                    and LW_END_TOP_OP /= OP_PUT and LW_END_TOP_OP /= OP_RESTRUCTURE and LW_END_TOP_OP /= OP_CONCAT
                                    and LW_END_TOP_OP /= OP_EACH_STORE and LW_END_TOP_OP /= OP_LAG and LW_END_TOP_OP /= OP_WINDOW
                                    and LW_END_TOP_OP /= OP_TRANSPOSE and LW_END_TOP_OP /= OP_MATPROD
                                    and LW_END_TOP_OP /= OP_WHEN and LW_END_TOP_OP /= OP_DEFAULT and not (LW_END_TOP < FLAT_SIGNAL_COUNT and LW_END_TOP_TYPE = LW_END_SIGNAL_TYPE)
                            then T_ARRAY_DEFINITION
                            else if LW_PARTIAL_ENDS and LW_EQ_PARTIAL = 1 and LW_FL_GUARD[?] < 0 and ROWS_CTX[?][LW_END_TOP]
                            then T_PARTIAL_CONSTANT else 0
        | LW_NEVER_LIVE := AT_LS_NEVER and LW_I < FLAT_SIGNAL_COUNT
        | LW_NEVER_FAILS := LW_NEVER_LIVE and SIGNAL_TOP[?][LW_I] = 0 and ROWS_OP[?][LW_I] /= OP_INPUT
        | LW_IDENTITY_ROW := GROUP_MEMBER_ROW[?][FLAT_GROUP_MEMBER_FIRST[LW_I]]
        | LW_IDENTITY_CHECKS := LW_FINISHING and LW_MEMBER_NOW and LW_K = 1 and FLAT_GROUP_RELATION[LW_I] = C_IDENTITY
                                and LW_IDENTITY_ROW < FLAT_SIGNAL_COUNT
        | LW_IDENTITY_DEFINES := LW_MEMBER_CLOSES and LW_IDENTITY_CHECKS and not FLAT_GROUP_ASSUMED[LW_I]
                                 and SIGNAL_TOP[?][LW_IDENTITY_ROW] = 0
                                 and ROWS_OP[?][LW_IDENTITY_ROW] /= OP_INPUT
        | LW_MEMBERS_LIVE := AT_LS_MEMBERS and LW_I < FLAT_GROUP_COUNT
        | LW_MEMBER_STARTS := LW_MEMBERS_LIVE and LW_K < FLAT_GROUP_MEMBER_TOTAL[LW_I]
        | LW_MEMBERS_CLOSE := LW_MEMBERS_LIVE and not LW_MEMBER_STARTS
        | LW_MEMBER_INDEX := FLAT_GROUP_MEMBER_FIRST[LW_I] + LW_K
        | LW_GROUP_FAILS := LW_MEMBERS_CLOSE and LW_GROUP_ARRAY[?]
        | LW_CREATES := LW_SIGNAL_LIVE or LW_LEVEL_ROW or LW_STATEVAR_CREATES or LW_IS_ITER or LW_FROM_CONSTANT or LW_IS_CONST or LW_IS_ENUM
                        or LW_IS_DEFAULTS
                        or LW_OPERATOR and not LW_TABLE_REWRITE and not LW_IS_TARGET_INDEX or FX_EMITS_ARG or FX_EMITS_EFFECT or LW_END_SEED or PT_CREATES
                        or PW_EACH or PW_STORES
        | LW_PUSHES := LW_IS_SIGNAL or LW_IS_CONST or LW_IS_ENUM or LW_IS_DEFAULTS
        | LW_ROW := ROW_COUNT[?]
        | LW_OVERFLOW := if LK_LIVE and LK_UNSURE or LK_FULL then F_CAP_LOOKUPS
                         else if LW_TYPE_FULL then F_CAP_TYPES
                         else if LW_TABLE_FULL then F_CAP_TABLES
                         else if PW_START and PW_LOOP_ID >= LOOP_CAP then F_CAP_LOOPS
                         else if LW_CREATES and LW_ROW >= ROWS_CAP or CXE_FULL then F_CAP_ROWS
                         else if LW_PUSHES and LW_TOP_NOW >= LOWER_STACK_CAP then F_CAP_STACK else 0
        | LW_MESSAGE_NOW := if CXE_FAILS then T_COMPLEX_EXPANSION
                            else if LW_LOOP_UNDECLARED then T_FLAT_UNDECLARED
                            else if LW_LOOP_NOT_INDEX then T_ITERATE_INDEX
                            else if LW_LOOP_PRODUCT_FAILS then T_LOOP_PRODUCT
                            else if LW_INDEX_DEFINED then T_INDEX_DEFINED
                            else if LW_TARGET_UNDECLARED then T_FLAT_UNDECLARED
                            else if LW_START_SEED_FAILS then T_WITH_UNDEFINED
                            else if LW_START_UNDECLARED then T_FLAT_UNDECLARED
                            else if LW_START_INPUT then T_INPUT_DEFINED
                            else if LW_START_ASSIGNED then T_STATEVAR_ASSIGNED
                            else if LW_START_STATE_DEFAULT then T_STATEVAR_DEFAULT
                            else if LW_START_OUTPUT then T_PARTIAL_OUTPUT
                            else if LW_START_MIXED then T_PARTIAL_MIXED
                            else if LW_START_TWICE then T_DEFINED_TWICE
                            else if LW_START_TWO_DEFAULTS then T_PARTIAL_TWO_DEFAULTS
                            else if LW_SCAN_FAILS then T_WITH_READS
                            else if LW_SIGNAL_UNDECLARED then T_FLAT_UNDECLARED
                            else if LW_STATE_DIRECT then T_STATEVAR_DIRECT
                            else if LW_IS_ENUM and LW_ENUM_MESSAGE /= 0 then LW_ENUM_MESSAGE
                            else if FX_CHECKS and FX_MESSAGE /= 0 then FX_MESSAGE
                            else if LW_IS_DEFAULTS and not OW_ARRAY then T_ENUM_SHAPE
                            else if PW_EACH and PW_MESSAGE /= 0 then PW_MESSAGE
                            else if LW_OPERATOR and LW_OPERATOR_MESSAGE /= 0 then LW_OPERATOR_MESSAGE
                            else if LW_FINISHING and LW_END_MESSAGE /= 0 then LW_END_MESSAGE
                            else if LW_NEVER_FAILS then T_NEVER_DEFINED
                            else if LW_GROUP_FAILS then T_ARRAY_VALUE
                            else if LW_OVERFLOW /= 0 then T_CAPACITY else 0
        | LW_FAILS := LW_MESSAGE_NOW /= 0
        | LW_START_TOKEN := LW_FL_TOKEN[?]
        | LW_TOKEN_NOW := if CXE_FAILS then ROWS_TOKEN[?][LW_I] else if LW_LOOP_LIVE then LW_LOOP_TOKEN
                          else if AT_LS_EQUATION or AT_LS_START or AT_LS_SCAN then LW_EQ_TOKEN
                          else if LW_IS_SIGNAL or LW_IS_ENUM then (if LW_IS_ENUM then LW_ENUM_TOKEN else LW_ENTRY_TOKEN)
                          else if LW_IS_DEFAULTS then LW_ENTRY_TOKEN
                          else if FX_CHECKS then FX_TOKEN
                          else if PW_EACH then LW_ENTRY_TOKEN
                          else if LW_OPERATOR then LW_OPERATOR_TOKEN
                          else if LW_FINISHING and LW_END_TOP_OP = OP_PAIR then ROWS_TOKEN[?][LW_END_TOP]
                          else if LW_FINISHING then LW_START_TOKEN
                          else if LW_NEVER_LIVE then -1
                          else if LW_MEMBERS_LIVE then FLAT_GROUP_TOKEN[LW_I] else 0
        | LW_FLAT_KEY := if LW_LOOP_LIVE then LW_LOOP_NAME
                         else if LW_IDENTITY_CHECKS then LW_SIGNAL_KEY[?][LW_IDENTITY_ROW]
                         else if AT_LS_EQUATION or AT_LS_START or AT_LS_SCAN or LW_FINISHING then LW_EQ_TARGET
                         else if LW_IS_SIGNAL then LW_NAME
                         else if LW_NEVER_LIVE then LW_SIGNAL_KEY[?][LW_I] else LW_SIGNAL_KEY[?][LW_LEFT]
        | LW_FLAT_INSTANCE := if LW_LOOP_LIVE then FLAT_LOOP_INSTANCE[LW_I]
                              else if LW_IDENTITY_CHECKS then FLAT_SIGNAL_INSTANCE[LW_IDENTITY_ROW]
                              else if AT_LS_EQUATION or AT_LS_START or AT_LS_SCAN or LW_FINISHING then LW_EQ_TARGET_INSTANCE
                              else if LW_IS_SIGNAL then LW_INST
                              else if LW_NEVER_LIVE then FLAT_SIGNAL_INSTANCE[LW_I] else LW_PREV_INSTANCE
        | LW_ARGUMENT0_NOW := if CXE_FAILS then OP_TEXT_FRAGMENT[CXE_OP] else if LW_MESSAGE_NOW = T_CAPACITY then LW_OVERFLOW
                              else if LW_IS_ENUM then LW_ENUM_ARGUMENT0
                              else if FX_CHECKS then FX_ARGUMENT0
                              else if PW_EACH then LW_OP_TEXT
                              else if LW_OPERATOR and LW_OPERATOR_MESSAGE /= T_INDEX_RANGE then LW_OPERATOR_ARGUMENT0
                              else LW_FLAT_KEY
        | LW_ARGUMENT1_NOW := if FX_CHECKS then FX_ARGUMENT1 else if LW_IS_ENUM then LW_ENUM_VALUE_KEY
                              else if LW_FINISHING then LW_END_SIGNAL_TYPE else LW_OPERATOR_ARGUMENT1
        | LW_ARGUMENT2_NOW := if FX_CHECKS then FX_PARAMS else if LW_FINISHING then LW_END_TYPE else RT
        | LW_MESSAGE := if LW_FAILS then LW_MESSAGE_NOW else LW_MESSAGE[?]
        | LW_TOKEN := if LW_FAILS then LW_TOKEN_NOW else LW_TOKEN[?]
        | LW_ARGUMENT0 := if LW_FAILS then LW_ARGUMENT0_NOW else LW_ARGUMENT0[?]
        | LW_ARGUMENT1 := if LW_FAILS then LW_ARGUMENT1_NOW else LW_ARGUMENT1[?]
        | LW_ARGUMENT2 := if LW_FAILS then LW_ARGUMENT2_NOW else LW_ARGUMENT2[?]
        | LW_INSTANCE := if LW_FAILS then LW_FLAT_INSTANCE else LW_INSTANCE[?]
        | LW_LONG0 := if LW_FAILS then (if LW_OPERATOR_MESSAGE = T_DELAY_INIT_SHAPE then LW_NEEDED else if LW_IS_GATHER or LW_IS_FLATV or LW_IS_RESTRUCTURE then GI_VALUE else LW_INDEX_VALUE) else LW_LONG0[?]
        | LW_LONG0_UNSIGNED := if LW_FAILS then not LW_IS_GATHER and not LW_IS_FLATV and not LW_IS_RESTRUCTURE and LW_INDEX_TYPE = BUILTIN_ULONG else LW_LONG0_UNSIGNED[?]
        | LW_LONG1 := if LW_FAILS then long((if LW_IS_GATHER or LW_IS_FLATV or LW_IS_RESTRUCTURE then GI_LIMIT else LT_SIZE) - ulong(1)) else LW_LONG1[?]
        | LW_GOES := not LW_FAILS
        | LW_ROW_SLOT := if LW_CREATES and LW_GOES then LW_ROW else -1
        | LW_ROW_OP := if LW_SIGNAL_LIVE then (if LW_SIGNAL_INPUT then OP_INPUT else OP_COPY) else if LW_LEVEL_ROW then OP_ITER else if LW_STATEVAR_CREATES then OP_DELAY
                       else if FX_EMITS_ARG then OP_ARG else if FX_EMITS_EFFECT then OP_EFFECT
                       else if LW_END_SEED then OP_SEED else if PT_CREATES then PT_ROW_OP else if PW_EACH then OP_EACH
                       else if PW_STORES then OP_EACH_STORE else LW_RESULT_OP
        | LW_ROW_LEFT := if LW_SIGNAL_LIVE or LW_IS_STATE then -1 else if LW_LEVEL_ROW then LW_LOOP_SIGNAL else if LW_STATEVAR_CREATES then LW_I
                         else if LW_IS_ITER then LW_ITER_ROW
                         else if LW_IS_LEAF then -1 else if FX_EMITS_ARG then FX_OPERAND else if FX_EMITS_EFFECT then FX_PREVIOUS
                         else if LW_END_SEED then LW_SEED_VALUE else if PW_STORES then LW_END_TOP else if PT_CREATES then PT_ROW_LEFT
                         else if PW_EACH then PW_SUBJECT
                         else if LW_DIM_DETACHES then -1 else if LW_FOLD_DETACHES or LW_IS_RESTRUCTURE then LW_RIGHT else LW_LEFT
        | LW_ROW_RIGHT := if LW_SIGNAL_LIVE or LW_LEVEL_ROW or LW_STATEVAR_CREATES or LW_IS_LEAF or FX_EMITS_EFFECT then -1 else if FX_EMITS_ARG then FX_PREVIOUS
                          else if LW_END_SEED then LW_SIGNAL_NOW else if PT_CREATES then PT_ROW_RIGHT
                          else if PW_EACH or PW_STORES then -1
                          else if LW_FOLD_DETACHES then -1 else if LW_IS_RESTRUCTURE then LW_LEFT else LW_RIGHT
        | LW_ROW_VALUE := if LW_LEVEL_ROW then long(LW_K) else if FX_EMITS_EFFECT then long(EFFECT_COUNT[?])
                          else if LW_SIGNAL_LIVE or FX_EMITS_ARG or LW_END_SEED or PW_EACH or PW_STORES then long(0)
                          else if PT_CREATES then PT_ROW_VALUE else if LW_STATEVAR_CREATES then LW_INIT_VALUE
                          else if LW_IS_STATE then long(LW_STATE_ROW) else LW_RESULT_VALUE
        | LW_ROW_TYPE := if LW_SIGNAL_LIVE then LW_SIGNAL_TYPE_NOW else if LW_LEVEL_ROW then TYPE_ELEMENT[LW_LOOP_TYPE] else if LW_STATEVAR_CREATES then ROWS_TYPE[?][LW_I] else if LW_IS_STATE then LT else if FX_EMITS_ARG then ROWS_TYPE[?][FX_OPERAND]
                         else if FX_EMITS_EFFECT then FX_ROW_TYPE else if LW_END_SEED then LW_END_SIGNAL_TYPE
                         else if PT_CREATES then PT_ROW_TYPE else if PW_EACH then PW_LEAF else if PW_STORES then OW_TYPE
                         else LW_RESULT_TYPE
        | LW_ROW_CTX := LW_ROW_OP = OP_CONST or LW_ROW_OP = OP_TABLE or LW_ROW_OP = OP_STATE
                        or OP_MONOCHRONOUS[LW_ROW_OP] = 1 and ROWS_CTX[?][LW_ROW_LEFT] and (LW_ROW_RIGHT < 0 or ROWS_CTX[?][LW_ROW_RIGHT])
                        or LW_ROW_OP = OP_DEFAULT and ROWS_CTX[?][LW_ROW_LEFT]
        | LW_CARRIED_TOKEN := LW_CUR_TOKEN[?]
        | LW_ROW_TOKEN := if LW_SIGNAL_LIVE then -1 else if LW_LEVEL_ROW then LW_LOOP_TOKEN
                          else if LW_STATEVAR_CREATES then SIGNAL_TOKEN[if LW_STATEVAR_SOURCE >= 0 then LW_STATEVAR_SOURCE else 0] else if LW_IS_CONST or LW_IS_ENUM then LW_CARRIED_TOKEN
                          else if LW_END_SEED or PT_CREATES or PW_STORES then LW_START_TOKEN else LW_ENTRY_TOKEN
        | LW_INDICES_REWRITES := LW_TABLE_REWRITE and LW_GOES
        | LW_AXIS_WRITES := LW_IS_AXIS and LW_GOES
        | LW_REWRITE_TABLE := if LW_IOTA_TABLE >= 0 and not LW_IS_AXIS then LW_IOTA_TABLE else LW_NEW_TABLE
        | LW_RANGE_REWRITES := LW_END_RANGE and LW_GOES
        | LW_NEVER_WRITES := LW_NEVER_LIVE and LW_GOES
        | ROWS_OP := ROWS_OP[?] next (if CXE_SLOT >= 0 then CXE_SLOT else if LW_INDICES_REWRITES then LW_LEFT else LW_ROW_SLOT)
                     : (if CXE_SLOT >= 0 then CXE_ROW_OP else if LW_INDICES_REWRITES then OP_TABLE else LW_ROW_OP)
        | ROWS_LEFT := ROWS_LEFT[?] next (if CXE_SLOT >= 0 then CXE_SLOT else if LW_NEVER_WRITES then LW_I else LW_ROW_SLOT)
                       : (if CXE_SLOT >= 0 then CXE_ROW_LEFT else if LW_NEVER_WRITES then SIGNAL_TOP[?][LW_I] - 1 else LW_ROW_LEFT)
        | ROWS_RIGHT := ROWS_RIGHT[?] next (if CXE_SLOT >= 0 then CXE_SLOT else LW_ROW_SLOT) : (if CXE_SLOT >= 0 then CXE_ROW_RIGHT else LW_ROW_RIGHT)
        | ROWS_INIT := ROWS_INIT[?] next (if CXE_APPENDS then CXE_SLOT else LW_ROW_SLOT)
                       : (if CXE_APPENDS then (if CXE_DEST = CXD_IM and CXE_INIT > 0 and CX_TABLE_IM[?][if CXE_INIT > 0 then CXE_INIT - 1 else 0] > 0 then CX_TABLE_IM[?][CXE_INIT - 1] else CXE_INIT) else if (LW_IS_LAG or LW_IS_WINDOW) and LW_INIT_TABLE and not PW_EACH then integer(FINAL_VALUE[LW_SRC]) + 1
                          else if LW_WINDOW_FILL_WRITES then LW_NEW_TABLE + 1 else 0)
        | ROWS_VALUE := ROWS_VALUE[?] next (if CXE_SLOT >= 0 then CXE_SLOT else if LW_INDICES_REWRITES then LW_LEFT else LW_ROW_SLOT)
                        : (if CXE_SLOT >= 0 then CXE_ROW_VALUE else if LW_INDICES_REWRITES then long(LW_REWRITE_TABLE) else LW_ROW_VALUE)
        | ROWS_TYPE := ROWS_TYPE[?] next (if CXE_SLOT >= 0 then CXE_SLOT else if LW_INDICES_REWRITES then LW_LEFT else if LW_RANGE_REWRITES then LW_END_TOP else LW_ROW_SLOT)
                       : (if CXE_SLOT >= 0 then CXE_ROW_TYPE else if LW_AXIS_WRITES then OW_TYPE else if LW_INDICES_REWRITES then LW_INTERNED else if LW_RANGE_REWRITES then LW_END_SIGNAL_TYPE else LW_ROW_TYPE)
        | ROWS_CTX := ROWS_CTX[?] next (if CXE_SLOT >= 0 then CXE_SLOT else if LW_INDICES_REWRITES then LW_LEFT else LW_ROW_SLOT)
                      : (if CXE_SLOT >= 0 then CXE_ROW_CTX else LW_INDICES_REWRITES or LW_ROW_CTX)
        | ROWS_TOKEN := ROWS_TOKEN[?] next (if CXE_APPENDS then CXE_SLOT else if LW_NEVER_WRITES then LW_I else LW_ROW_SLOT)
                        : (if CXE_APPENDS then ROWS_TOKEN[?][LW_I] else if LW_NEVER_WRITES then SIGNAL_DEF_TOKEN[?][LW_I] - 1 else LW_ROW_TOKEN)
        | ROWS_OWNER := ROWS_OWNER[?] next (if CXE_APPENDS then CXE_SLOT else LW_ROW_SLOT) : (if CXE_OWNER_IMAG then CX_IMAG[?][CXE_OWNER] - 1 else if CXE_APPENDS then CXE_OWNER else if LW_SIGNAL_LIVE or LW_STATEVAR_CREATES then LW_I else if LW_LEVEL_ROW then LW_LOOP_SIGNAL else LW_SIGNAL_NOW)
        | LW_LEFT_READ := if LW_ROW_LEFT >= 0 then ROWS_STATE_READ[?][LW_ROW_LEFT] else 0
        | LW_RIGHT_READ := if LW_ROW_RIGHT >= 0 then ROWS_STATE_READ[?][LW_ROW_RIGHT] else 0
        | ROWS_FIRST_WRITER := ROWS_FIRST_WRITER[?] next (if CXE_APPENDS then CXE_SLOT else LW_ROW_SLOT)
                               : (if CXE_APPENDS then (if ROWS_FIRST_WRITER[?][LW_I] = LW_I then CXE_SLOT else ROWS_FIRST_WRITER[?][LW_I])
                                  else if LW_OP = OP_PUT and LW_LEFT_OP = OP_PUT then ROWS_FIRST_WRITER[?][LW_LEFT] else LW_ROW)
        | ROWS_PARTIAL_OF := ROWS_PARTIAL_OF[?] next (if CXE_APPENDS then CXE_SLOT else if PT_CREATES then LW_ROW_SLOT else -1)
                             : (if CXE_APPENDS then ROWS_PARTIAL_OF[?][LW_I] else PT_X + 1)
        | ROWS_STATE_READ := ROWS_STATE_READ[?] next (if CXE_APPENDS then CXE_SLOT else LW_ROW_SLOT)
                             : (if CXE_APPENDS then ROWS_STATE_READ[?][LW_I] else if LW_IS_STATE then LW_LEFT + 1 else if LW_LEFT_READ > 0 then LW_LEFT_READ else LW_RIGHT_READ)
        | HOLD_INIT := HOLD_INIT[?] next (if LW_STATEVAR_HOLDS and LW_GOES then LW_I else -1) : LW_INIT_VALUE
        | HOLD_INITED := HOLD_INITED[?] next (if LW_STATEVAR_HOLDS and LW_GOES then LW_I else -1) : true
        | STATE_ROW := STATE_ROW[?] next (if LW_STATEVAR_CREATES and LW_GOES then LW_I else -1) : LW_ROW + 1
        | ROWS_LOOP := ROWS_LOOP[?] next (if CXE_APPENDS then CXE_SLOT else if LW_NEVER_WRITES then LW_I else LW_ROW_SLOT)
                       : (if CXE_APPENDS then ROWS_LOOP[?][LW_I] else if LW_NEVER_WRITES then SIGNAL_LOOP_MARK[?][LW_I] - 1 else if LW_LEVEL_ROW then LW_I else if LW_END_SEED then LW_EQ_LOOP else if LW_DELAY_FREE then -1 else LW_LOOP_NOW)
        | ROWS_GUARD := ROWS_GUARD[?] next (if CXE_APPENDS then CXE_SLOT else if LW_NEVER_WRITES then LW_I else LW_ROW_SLOT)
                        : (if CXE_APPENDS then ROWS_GUARD[?][LW_I] else if LW_NEVER_WRITES then SIGNAL_DEF_GUARD[?][LW_I] - 1
                           else if PT_CREATES and not PT_W_CREATES then -1 else LW_FL_GUARD[?])
        | FIRST_EFFECT := FIRST_EFFECT[?] next (if CXE_APPENDS then CXE_SLOT else LW_ROW_SLOT)
                          : (if CXE_APPENDS then FIRST_EFFECT[?][LW_I] else if FX_EMITS_EFFECT then LW_ROW + 1 else if LW_SIGNAL_LIVE or LW_IS_LEAF or LW_IS_STATE then 0
                             else if FIRST_EFFECT[?][LW_ROW_RIGHT] > 0 then FIRST_EFFECT[?][LW_ROW_RIGHT]
                             else FIRST_EFFECT[?][LW_ROW_LEFT])
        | ROW_COUNT := if CXM_ENDS then LW_ROW + CX_IMAG_COUNT[?] else LW_ROW + integer(LW_ROW_SLOT >= 0) + integer(CXE_SLOT >= 0 and CXE_DEST = CXD_TEMP)
        | LW_SIGNAL_KEY := LW_SIGNAL_KEY[?] next (if LW_SIGNAL_LIVE then LW_I else -1) : LW_SIGNAL_KEY_NOW
        | LW_EFFECT_SLOT := if FX_EMITS_EFFECT and LW_GOES then EFFECT_COUNT[?] else -1
        | EFFECT_KIND := EFFECT_KIND[?] next LW_EFFECT_SLOT : LW_NAME
        | EFFECT_RESOURCE := EFFECT_RESOURCE[?] next LW_EFFECT_SLOT : (if FX_IS_IO then BUILTIN_STRING else FX_TYPE0)
        | EFFECT_PARAM := EFFECT_PARAM[?] next LW_EFFECT_SLOT
                          : (if FX_WRITES_VALUE then long(FX_T1) else if FX_IS_SYSCALL or FX_IS_IO then long(-1) else if FX_IS_INSTRUCTION then FX_WORD else long(FX_TYPE1))
        | EFFECT_COUNT := EFFECT_COUNT[?] + integer(LW_EFFECT_SLOT >= 0)
        | LW_FX_PREVIOUS := if FX_EMITS_ARG then LW_ROW else if LW_IS_EFFECT then FX_PREVIOUS else -1
        | LW_FX_STEP := if LW_IS_EFFECT and not FX_EMITS_EFFECT then FX_STEP + 1 else 0
        | LW_DEFAULTS_WRITES := LW_IS_DEFAULTS and LW_GOES
        | LW_STEP_WRITES := LW_IS_STEP and LW_GOES
        | LW_WINDOW_FILL_WRITES := LW_IS_WINDOW and LI_SCALAR_OK and LW_GOES
        | LW_NEW_TABLE_SLOT := if LW_INDICES_REWRITES and (LW_IOTA_TABLE < 0 or LW_IS_AXIS) or LW_DEFAULTS_WRITES or LW_STEP_WRITES
                                 or LW_WINDOW_FILL_WRITES or CXB_CREATES then NEW_TABLE_COUNT[?]
                             else -1
        | NEW_TABLE_TYPE := NEW_TABLE_TYPE[?] next LW_NEW_TABLE_SLOT
                            : (if CXB_CREATES then CX_TWIN[?][CXB_TYPE] else if LW_DEFAULTS_WRITES or LW_AXIS_WRITES then OW_TYPE else if LW_WINDOW_FILL_WRITES then LW_ROW_TYPE else LW_INTERNED)
        | NEW_TABLE_SOURCE1 := NEW_TABLE_SOURCE1[?] next LW_NEW_TABLE_SLOT : (if CXB_CREATES then LW_I + 1 else 0)
        | NEW_TABLE_STEP := NEW_TABLE_STEP[?] next LW_NEW_TABLE_SLOT
                            : (if LW_DEFAULTS_WRITES or LW_WINDOW_FILL_WRITES or CXB_CREATES then long(0) else if LW_STEP_WRITES then SP_STEP else long(1))
        | NEW_TABLE_START := NEW_TABLE_START[?] next LW_NEW_TABLE_SLOT
                             : (if LW_STEP_WRITES then SP_START else if LW_AXIS_WRITES then AX_START else if LW_WINDOW_FILL_WRITES then FINAL_VALUE[LW_SRC] else long(0))
        | NEW_TABLE_DIV := NEW_TABLE_DIV[?] next LW_NEW_TABLE_SLOT : (if LW_AXIS_WRITES then AX_STRIDE else long(1))
        | NEW_TABLE_MOD := NEW_TABLE_MOD[?] next LW_NEW_TABLE_SLOT : (if LW_AXIS_WRITES then AX_SPAN else long(0))
        | NEW_TABLE_COUNT := NEW_TABLE_COUNT[?] + integer(LW_NEW_TABLE_SLOT >= 0)
        | NEW_TABLE_ELEMENTS := NEW_TABLE_ELEMENTS[?]
                                + (if LW_DEFAULTS_WRITES or LW_AXIS_WRITES then OW_TOTAL else if LW_STEP_WRITES then SP_COUNT
                                   else if LW_WINDOW_FILL_WRITES then LW_COUNT else if CXB_CREATES then CXB_LENGTH
                                   else if LW_NEW_TABLE_SLOT >= 0 then LW_LEFT_VALUE else long(0))
        | LW_IOTA := LW_IOTA[?] next (if LW_TABLE_IOTA then LW_TABLE_TYPE
                                      else if LW_NEW_TABLE_SLOT >= 0 and not LW_DEFAULTS_WRITES and not LW_STEP_WRITES and not LW_WINDOW_FILL_WRITES
                                      then LW_INTERNED else -1)
                     : (if LW_TABLE_IOTA then LW_I + 1 else LW_NEW_TABLE + 1)
        | PW_LOOP_WRITES := PW_STORES and LW_GOES
        | LOOP_INDEX := LOOP_INDEX[?] next (if LW_LOOP_LIVE and LW_K = 0 then LW_I else if PW_LOOP_WRITES then LW_LOOP_NOW else -1)
                        : (if LW_LOOP_LIVE then LW_LOOP_SIGNAL else LW_ROW)
        | LOOP_SIZE := LOOP_SIZE[?] next (if LW_LOOP_LIVE then LW_I else if PW_LOOP_WRITES then LW_LOOP_NOW else -1)
                       : (if LW_LOOP_LIVE then LW_LEVEL_PRODUCT else ulong(OW_TOTAL))
        | LW_LEVEL_SLOT := if LW_LOOP_LIVE then 4 * LW_I + LW_K else -1
        | LEVEL_SIGNAL := LEVEL_SIGNAL[?] next LW_LEVEL_SLOT : LW_LOOP_SIGNAL
        | LEVEL_SIZE := LEVEL_SIZE[?] next LW_LEVEL_SLOT : TYPE_SIZE[LW_LOOP_TYPE]
        | LEVEL_PREFIX := LEVEL_PREFIX[?] next LW_LEVEL_SLOT : LW_LEVEL_PRODUCT
        | LOOP_LEVELS := LOOP_LEVELS[?] next (if LW_LOOP_LIVE and LW_K = 0 then LW_I else -1) : LW_LOOP_RANK
        | PW_COUNT := PW_COUNT[?] + integer(PW_START and LW_GOES)
        | PW_SEEN := if LW_START_LIVE then false else PW_SEEN[?] or PW_EACH and LW_GOES
        | PW_STORED := if LW_START_LIVE then false else PW_STORED[?] or PW_LOOP_WRITES
        | LW_EQ_SIGNAL := LW_EQ_SIGNAL[?] next (if LW_EQ_STEP = 0 then LW_I else -1) : LK_VALUE + 1
        | SIGNAL_LEVEL := SIGNAL_LEVEL[?] next (if LW_LOOP_LIVE then LW_LOOP_SIGNAL else -1) : LW_K + 1
        | SIGNAL_LOOP_MARK := SIGNAL_LOOP_MARK[?] next (if LW_EQ_STEP = 0 and LW_LOOP_DEFINES and LK_FOUND then LK_VALUE else -1)
                              : LW_EQ_LOOP + 1
        | LW_GUARD_MARK := LW_GUARD_MARK[?] next (if LW_EQ_STEP = 2 then LW_I else -1) : LK_VALUE + 1
        | LW_GROUP_GUARD := LW_GROUP_GUARD[?] next (if LW_GROUP_LIVE then LW_I else -1) : (if LW_HAS_GUARD then LK_VALUE + 1 else 0)
        | LW_END_WRITES := LW_END_DEFINES and LW_GOES
        | LW_TOP_WRITES := LW_END_WRITES and not LW_PARTIAL_ENDS
        | PT_TOP_WRITES := PT_CLOSES and LW_GOES
        | SIGNAL_TOP := SIGNAL_TOP[?] next (if LW_TOP_WRITES or PT_TOP_WRITES then LW_SIGNAL_NOW else if LW_IDENTITY_DEFINES then LW_IDENTITY_ROW else -1)
                      : (if PT_F_CREATES then LW_ROW + 1 else if PT_CLOSES and PT_STATEVAR then PT_HEAD + 1
                         else if PT_CLOSES then PT_A[?] + 1 else LW_END_TOP + 1)
        | SIGNAL_DEF_TOKEN := SIGNAL_DEF_TOKEN[?] next (if LW_END_WRITES then LW_SIGNAL_NOW else -1) : LW_START_TOKEN + 1
        | SIGNAL_DEF_GUARD := SIGNAL_DEF_GUARD[?] next (if LW_TOP_WRITES then LW_SIGNAL_NOW else -1) : LW_FL_GUARD[?] + 1
        | DEF_START := DEF_START[?] next (if LW_END_WRITES then LW_SIGNAL_NOW else -1) : LW_FL_ROW_START[?]
        | DEF_END := DEF_END[?] next (if LW_END_WRITES then LW_SIGNAL_NOW else -1) : LW_ROW
        | LW_EQ_CLOSES := LW_FINISHING and not LW_MEMBER_NOW and LW_GOES
        | EQ_ROW_START := EQ_ROW_START[?] next (if LW_EQ_CLOSES then LW_I else -1) : LW_FL_ROW_START[?]
        | EQ_ROW_END := EQ_ROW_END[?] next (if LW_EQ_CLOSES then LW_I else -1) : ROW_COUNT
        | EQ_ROW_SIGNAL := EQ_ROW_SIGNAL[?] next (if LW_EQ_CLOSES then LW_I else -1) : LW_SIGNAL_NOW
        | LW_MEMBER_CLOSES := LW_FINISHING and LW_MEMBER_NOW and LW_GOES
        | GROUP_MEMBER_ROW := GROUP_MEMBER_ROW[?] next (if LW_MEMBER_CLOSES then LW_MEMBER_INDEX else -1) : LW_END_TOP
        | LW_GROUP_ARRAY := if LW_MEMBERS_CLOSE then false
                            else LW_GROUP_ARRAY[?] or LW_MEMBER_CLOSES
                                 and (LW_END_TOP_OP = OP_GATHER or LW_END_TOP_OP = OP_NEXT or LW_END_TOP_OP = OP_RANGE
                                      or LW_END_TOP_OP = OP_SLICE or LW_END_TOP_OP = OP_PUT or LW_END_TOP_OP = OP_RESTRUCTURE or LW_END_TOP_OP = OP_CONCAT)
        | LW_STACK_SLOT := if LW_PUSHES and LW_GOES then LW_TOP_NOW
                           else if LW_OPERATOR and not LW_TABLE_REWRITE and LW_GOES then LW_TOP_NOW - (if LW_UNARY then 1 else 2)
                           else if FX_EMITS_EFFECT and LW_GOES then FX_BASE
                           else if PW_EACH and LW_GOES then PW_SLOT
                           else if PW_STORES and LW_GOES then LW_TOP_NOW - 1 else -1
        | LW_STACK := LW_STACK[?] next LW_STACK_SLOT : (if LW_SIGNAL_FOUND then LK_VALUE else if LW_IS_TARGET_INDEX then LW_RIGHT else LW_ROW)
        | LW_TOP := if AT_LS_START or AT_LS_MEMBERS then 0 else if PW_EACH then LW_TOP_NOW
                    else if LW_STACK_SLOT >= 0 then LW_STACK_SLOT + 1 else LW_TOP_NOW
        | LW_CUR_TOKEN := if LW_START_LIVE then LW_EQ_TOKEN else if LW_MEMBER_STARTS then FLAT_GROUP_TOKEN[LW_I]
                          else if LW_ENTRY_LIVE and not LW_IS_CONST and not LW_IS_ENUM then LW_ENTRY_TOKEN else LW_CARRIED_TOKEN
        | LW_FL_TOKEN := if LW_START_LIVE then LW_EQ_TOKEN else if LW_MEMBER_STARTS then FLAT_GROUP_TOKEN[LW_I] else LW_START_TOKEN
        | LW_FL_START := if LW_START_LIVE then FLAT_EQUATION_START[LW_I] else LW_FL_START[?]
        | LW_FL_END := if LW_START_LIVE then FLAT_EQUATION_END[LW_I] else if LW_MEMBER_STARTS then FLAT_MEMBER_END[LW_MEMBER_INDEX]
                       else LW_END_NOW
        | LW_FL_LOOP := if LW_START_LIVE then (if LW_EQ_SEED then -1 else if PW_START then PW_LOOP_ID else LW_EQ_LOOP)
                        else if LW_MEMBER_STARTS then -1 else LW_LOOP_NOW
        | LW_FL_EW := if LW_START_LIVE then PW_START else if LW_MEMBER_STARTS then false else PW_NOW
        | LW_FL_OWNER := if LW_START_LIVE then (if LW_EQ_TARGET >= 0 then LW_START_SIGNAL else -1)
                         else if LW_MEMBER_STARTS then -1 else LW_SIGNAL_NOW
        | LW_FL_GUARD := if LW_START_LIVE then LW_GUARD_MARK[?][LW_I] - 1
                         else if LW_MEMBER_STARTS then LW_GROUP_GUARD[?][LW_I] - 1 else LW_FL_GUARD[?]
        | LW_FL_MEMBER := if LW_START_LIVE then false else if LW_MEMBER_STARTS then true else LW_MEMBER_NOW
        | LW_FL_ROW_START := if LW_START_LIVE or LW_MEMBER_STARTS then LW_ROW else LW_FL_ROW_START[?]
        | LW_ENTRY := if LW_START_LIVE then FLAT_EQUATION_START[LW_I]
                      else if LW_MEMBER_STARTS then FLAT_MEMBER_START[LW_MEMBER_INDEX]
                      else if LW_SCAN_LIVE then LW_E + 1
                      else if AT_LS_SCAN then LW_FL_START[?]
                      else if LW_IS_EFFECT and not FX_EMITS_EFFECT then LW_E
                      else if PW_EACH then LW_E
                      else if LW_ENTRY_LIVE then LW_E + 1 else LW_E
        | LW_STATE := if LW_FAILS then LS_FAILED
                      else if AT_LS_SIGNAL then (if LW_SIGNAL_LIVE then LS_SIGNAL else LS_LABEL)
                      else if AT_LS_STATEVAR then (if LW_STATEVAR_LIVE then LS_STATEVAR else LS_EQUATION)
                      else if AT_LS_LABEL then (if LW_LABEL_LIVE then LS_LABEL else LS_VALUE)
                      else if AT_LS_VALUE then (if LW_VALUE_TYPE_LIVE then LS_VALUE else LS_ARRAY)
                      else if AT_LS_ARRAY then (if LW_I < TYPE_COUNT then LS_ARRAY else LS_TABLE)
                      else if AT_LS_TABLE then (if LW_TABLE_LIVE then LS_TABLE else LS_LOOP)
                      else if AT_LS_LOOP then (if LW_LOOP_LIVE then LS_LOOP else LS_STATEVAR)
                      else if AT_LS_EQUATION then (if LW_EQUATION_LIVE then LS_EQUATION else LS_GROUP)
                      else if AT_LS_GROUP then (if LW_I < FLAT_GROUP_COUNT then LS_GROUP else LS_START)
                      else if AT_LS_START then (if not LW_START_LIVE then LS_MEMBERS else if LW_EQ_SEED then LS_SCAN else LS_ENTRY)
                      else if AT_LS_SCAN then (if LW_SCAN_LIVE then LS_SCAN else LS_ENTRY)
                      else if AT_LS_ENTRY then
                        (if not LW_FINISHING then LS_ENTRY else if LW_MEMBER_NOW then LS_MEMBERS else if LW_PARTIAL_ENDS then LS_PARTIAL else LS_START)
                      else if AT_LS_PARTIAL then (if LW_K < 5 then LS_PARTIAL else LS_START)
                      else if AT_LS_NEVER then (if LW_NEVER_LIVE then LS_NEVER else if USES_COMPLEX then LS_CXTYPE else LS_DONE)
                      else if AT_LS_CXTYPE then (if CXT_LIVE then LS_CXTYPE else LS_CXTABLE)
                      else if AT_LS_CXTABLE then (if CXB_LIVE then LS_CXTABLE else LS_CXMAP)
                      else if AT_LS_CXMAP then (if CXM_LIVE then LS_CXMAP else LS_CXEXPAND)
                      else if AT_LS_CXEXPAND then (if CXE_LIVE then LS_CXEXPAND else LS_DONE)
                      else if AT_LS_MEMBERS then
                        (if LW_MEMBER_STARTS then LS_ENTRY else if LW_MEMBERS_LIVE then LS_MEMBERS else LS_NEVER)
                      else LW_NOW
        | LW_CURSOR := if AT_LS_SIGNAL then (if LW_SIGNAL_LIVE then LW_I + 1 else 0)
                       else if AT_LS_STATEVAR then (if LW_STATEVAR_LIVE then LW_I + 1 else 0)
                       else if AT_LS_LABEL then (if LW_LABEL_LIVE then LW_I + 1 else 0)
                       else if AT_LS_VALUE then (if not LW_VALUE_TYPE_LIVE then 0 else LW_I + integer(not LW_VALUE_LIVE))
                       else if AT_LS_ARRAY then (if LW_I < TYPE_COUNT then LW_I + 1 else 0)
                       else if AT_LS_TABLE then (if not LW_TABLE_LIVE then 0 else LW_I + integer(not LW_TABLE_WALKS))
                       else if AT_LS_LOOP then (if LW_LOOP_LIVE then LW_I + integer(not LW_LOOP_MORE) else 0)
                       else if AT_LS_EQUATION then (if not LW_EQUATION_LIVE then 0 else LW_I + integer(not LW_EQ_MORE))
                       else if AT_LS_GROUP then (if LW_I < FLAT_GROUP_COUNT then LW_I + 1 else 0)
                       else if AT_LS_START then (if LW_START_LIVE then LW_I else 0)
                       else if AT_LS_ENTRY then LW_I + integer(LW_FINISHING and not LW_MEMBER_NOW and not LW_PARTIAL_ENDS)
                       else if AT_LS_PARTIAL then LW_I + integer(LW_K >= 5)
                       else if AT_LS_NEVER then (if LW_NEVER_LIVE then LW_I + 1 else 0)
                       else if AT_LS_CXTYPE then (if CXT_LIVE then LW_I + 1 else 0)
                       else if AT_LS_CXTABLE then (if CXB_LIVE then LW_I + 1 else 0)
                       else if AT_LS_CXMAP then (if CXM_LIVE then LW_I + 1 else 0)
                       else if AT_LS_CXEXPAND then LW_I + integer(CXE_ENDS)
                       else if AT_LS_MEMBERS then (if LW_MEMBERS_LIVE then LW_I + integer(LW_MEMBERS_CLOSE) else 0)
                       else LW_I
        | LW_SUB := if AT_LS_VALUE then (if LW_VALUE_LIVE then LW_K + 1 else 0)
                    else if AT_LS_LOOP then (if LW_LOOP_MORE then LW_K + 1 else 0)
                    else if AT_LS_TABLE then (if LW_TABLE_WALKS then LW_K + 1 else 0)
                    else if AT_LS_EQUATION then (if LW_EQ_MORE then LW_EQ_STEP + 1 else 0)
                    else if AT_LS_ENTRY then LW_K + integer(LW_FINISHING and LW_MEMBER_NOW)
                    else if AT_LS_MEMBERS then (if LW_MEMBERS_CLOSE then 0 else LW_K)
                    else if AT_LS_NEVER then 0
                    else if AT_LS_CXEXPAND then (if CXE_ENDS or not CXE_LIVE then 0 else LW_K + 1)
                    else if AT_LS_PARTIAL then (if LW_K < 5 then LW_K + 1 else 0)
                    else LW_K
        |)
     with (| LW_STATE := LS_SIGNAL | LW_CURSOR := 0 | LW_SUB := 0 | LW_ENTRY := 0 | LW_FL_END := 0 | LW_FL_START := 0
           | LW_FL_LOOP := -1 | LW_FL_OWNER := -1 | LW_FL_GUARD := -1 | LW_FL_MEMBER := false | LW_FL_ROW_START := 0
           | LW_FL_TOKEN := 0 | LW_TOP := 0 | LW_CUR_TOKEN := 0 | LW_TABLE_OK := false | LW_TABLE_LOW := long(0) | LW_TABLE_HIGH := long(0) | LW_GROUP_ARRAY := false
           | LW_FX_STEP := 0 | LW_FX_PREVIOUS := -1 | HN_COUNT := 0 | ROW_COUNT := 0 | EFFECT_COUNT := 0
           | NEW_TYPE_COUNT := 0 | NEW_TABLE_COUNT := 0 | NEW_TABLE_ELEMENTS := long(0) | LW_MESSAGE := 0 | LW_TOKEN := 0 | LW_ARGUMENT0 := 0
           | LW_ARGUMENT1 := 0 | LW_ARGUMENT2 := 0 | LW_INSTANCE := 0 | LW_LONG0 := long(0) | LW_LONG0_UNSIGNED := false
           | LW_LONG1 := long(0) | PT_P := -1 | PT_R := -1 | PT_C := -1 | PT_A := -1 | PD_COUNT := 0
           | LW_FL_EW := false | PW_COUNT := 0 | PW_SEEN := false | PW_STORED := false | CX_IMAG_COUNT := 0 | CX_BASE := 0
           | CXH_OP := 0 | CXH_L := -1 | CXH_R := -1 | CXH_TYPE := 0 | CXH_VALUE := long(0) |)
     end
   | LOOP_TOTAL := FLAT_LOOP_COUNT + PW_COUNT
   | LOWER_FAILED := LOWERS and LW_STATE = LS_FAILED
   | LOWER_INCOMPLETE := LOWERS and LW_STATE /= LS_DONE and LW_STATE /= LS_FAILED
   | LOWER_READY := LOWERS and LW_STATE = LS_DONE
   | POST_BOUND := long(64) + long(5) * long(FLAT_DEPENDENCE_COUNT) + long(ROW_COUNT) + long(2) * long(LOOP_TOTAL)
                   + long(FLAT_SIGNAL_COUNT) + long(FLAT_EQUATION_COUNT) + long(FLAT_LIST_TOTAL) + long(FLAT_LABEL_COUNT)
   | POST_INDEX := 0 .. (if LOWER_READY then POST_BOUND else long(-1))
   | iterate POST_INDEX of
       (| PO_NOW := PO_STATE[?]
        | PO_I := PO_CURSOR[?]
        | PO_K := PO_SUB[?]
        | AT_PS_DEPENDENCE := PO_NOW = PS_DEPENDENCE
        | AT_PS_ROWS := PO_NOW = PS_ROWS
        | AT_PS_PREFIX := PO_NOW = PS_PREFIX
        | AT_PS_PLACE := PO_NOW = PS_PLACE
        | AT_PS_WALK := PO_NOW = PS_WALK
        | AT_PS_LABELSUM := PO_NOW = PS_LABELSUM
        | AT_PS_SIZE := PO_NOW = PS_SIZE
        | PO_DEPENDENCE_LIVE := AT_PS_DEPENDENCE and PO_I < FLAT_DEPENDENCE_COUNT
        | PO_TO_END := PO_K >= 2
        | PO_END_KEY := if PO_TO_END then FLAT_DEPENDENCE_TO_KEY[PO_I] else FLAT_DEPENDENCE_FROM_KEY[PO_I]
        | PO_END_INSTANCE := FLAT_DEPENDENCE_INSTANCE[PO_I]
        | PO_END_SIGNAL := if PO_TO_END then PO_TO_SIGNAL[?][PO_I] else PO_FROM_SIGNAL[?][PO_I]
        | PO_LOOKS_LABEL := PO_K = 1 or PO_K = 3
        | PO_ROWS_LIVE := AT_PS_ROWS and PO_I < ROW_COUNT
        | PO_ROW_OP := ROWS_OP[PO_I]
        | PO_ROW_LEFT := ROWS_LEFT[PO_I]
        | PO_ROW_RIGHT := ROWS_RIGHT[PO_I]
        | PO_LEFT_RANGE := PO_ROW_LEFT >= 0 and PO_ROW_LEFT < FLAT_SIGNAL_COUNT and ROWS_LEFT[PO_ROW_LEFT] >= 0
                           and ROWS_OP[ROWS_LEFT[PO_ROW_LEFT]] = OP_RANGE
        | PO_RIGHT_RANGE := PO_ROW_RIGHT >= 0 and PO_ROW_RIGHT < FLAT_SIGNAL_COUNT and ROWS_LEFT[PO_ROW_RIGHT] >= 0
                            and ROWS_OP[ROWS_LEFT[PO_ROW_RIGHT]] = OP_RANGE
        | PO_OUTPUT_SOURCE := if PO_ROWS_LIVE and PO_I < FLAT_SIGNAL_COUNT then FLAT_SIGNAL_SOURCE[PO_I] else -1
        | PO_OUTPUT_RANGE := PO_OUTPUT_SOURCE >= 0 and FLAT_SIGNAL_INSTANCE[if PO_OUTPUT_SOURCE >= 0 then PO_I else 0] = 0
                             and SIGNAL_ROLE[if PO_OUTPUT_SOURCE >= 0 then PO_OUTPUT_SOURCE else 0] = ROLE_OUTPUT
                             and PO_ROW_LEFT >= 0 and ROWS_OP[if PO_ROW_LEFT >= 0 then PO_ROW_LEFT else 0] = OP_RANGE
        | PO_RANGE_FAILS := PO_ROWS_LIVE and (PO_ROW_OP /= OP_ITER and (PO_LEFT_RANGE or PO_RIGHT_RANGE) or PO_OUTPUT_RANGE)
        | PO_LEFT_PREV := PO_ROWS_LIVE and PO_ROW_LEFT >= 0 and ROWS_OP[PO_ROW_LEFT] = OP_PREV
        | PO_RIGHT_PREV := PO_ROWS_LIVE and PO_ROW_RIGHT >= 0 and PO_ROW_RIGHT /= PO_ROW_LEFT and ROWS_OP[PO_ROW_RIGHT] = OP_PREV
        | PO_LEFT_TAIL := LEFT_TAIL[?][PO_ROW_LEFT]
        | PO_RIGHT_TAIL := RIGHT_TAIL[?][PO_ROW_RIGHT]
        | LEFT_HEAD := LEFT_HEAD[?] next (if PO_LEFT_PREV and PO_LEFT_TAIL = 0 then PO_ROW_LEFT else -1) : PO_I + 1
        | LEFT_NEXT := LEFT_NEXT[?] next (if PO_LEFT_PREV and PO_LEFT_TAIL > 0 then PO_LEFT_TAIL - 1 else -1) : PO_I + 1
        | LEFT_TAIL := LEFT_TAIL[?] next (if PO_LEFT_PREV then PO_ROW_LEFT else -1) : PO_I + 1
        | RIGHT_HEAD := RIGHT_HEAD[?] next (if PO_RIGHT_PREV and PO_RIGHT_TAIL = 0 then PO_ROW_RIGHT else -1) : PO_I + 1
        | RIGHT_NEXT := RIGHT_NEXT[?] next (if PO_RIGHT_PREV and PO_RIGHT_TAIL > 0 then PO_RIGHT_TAIL - 1 else -1) : PO_I + 1
        | RIGHT_TAIL := RIGHT_TAIL[?] next (if PO_RIGHT_PREV then PO_ROW_RIGHT else -1) : PO_I + 1
        | PO_PREV_SLOT := if PO_ROWS_LIVE and PO_ROW_OP = OP_PREV then PREV_COUNT[?] else -1
        | PREV_LIST := PREV_LIST[?] next PO_PREV_SLOT : PO_I
        | PREV_COUNT := PREV_COUNT[?] + integer(PO_PREV_SLOT >= 0)
        | PO_SIGNAL_LOOP := ROWS_LOOP[PO_I]
        | PO_COUNTS := PO_ROWS_LIVE and PO_I < FLAT_SIGNAL_COUNT and PO_SIGNAL_LOOP >= 0
        | LOOP_DEF_TOTAL := LOOP_DEF_TOTAL[?] next (if PO_COUNTS then PO_SIGNAL_LOOP else -1) : LOOP_DEF_TOTAL[?][PO_SIGNAL_LOOP] + 1
        | PO_PREFIX_LIVE := AT_PS_PREFIX and PO_I < LOOP_TOTAL
        | LOOP_DEF_START := LOOP_DEF_START[?] next (if PO_PREFIX_LIVE then PO_I else -1) : PO_RUNNING[?]
        | PO_PLACE_LIVE := AT_PS_PLACE and PO_I < FLAT_SIGNAL_COUNT
        | PO_PLACES := PO_PLACE_LIVE and PO_SIGNAL_LOOP >= 0
        | PO_PLACE_FILL := LOOP_DEF_FILL[?][PO_SIGNAL_LOOP]
        | DEFINED_LIST := DEFINED_LIST[?] next (if PO_PLACES then LOOP_DEF_START[?][PO_SIGNAL_LOOP] + PO_PLACE_FILL else -1) : PO_I
        | LOOP_DEF_FILL := LOOP_DEF_FILL[?] next (if PO_PLACES then PO_SIGNAL_LOOP else -1) : PO_PLACE_FILL + 1
        | PO_WALK_LIVE := AT_PS_WALK and PO_I < FLAT_EQUATION_COUNT and PO_NEEDS_LABELS[?]
        | PO_WALK_CONTEXT := FLAT_EQUATION_CONTEXT[PO_I]
        | PO_WALK_NODE := FLAT_EQUATION_LABELS[PO_I]
        | PO_INHERITED := INSTANCE_LABEL_LENGTH[PO_WALK_CONTEXT]
        | PO_PATH_LENGTH := PO_INHERITED + (if PO_WALK_NODE < 0 then 0 else USE_PATH_LENGTH[PO_WALK_NODE])
        | PO_WALK_STEP := PO_WALK_LIVE and PO_K < PO_PATH_LENGTH
        | PO_WALK_AT := INSTANCE_LABEL_START[PO_WALK_CONTEXT] + PO_K
        | PO_FROM_INHERITED := PO_K < PO_INHERITED
        | PO_WALK_KEY := if PO_FROM_INHERITED then FLAT_PATH_KEY[PO_WALK_AT]
                         else PATH_VALUE[USE_PATH_START[PO_WALK_NODE] + PO_K - PO_INHERITED]
        | PO_WALK_INSTANCE := if PO_FROM_INHERITED then FLAT_PATH_INSTANCE[PO_WALK_AT] else PO_WALK_CONTEXT
        | PO_WALK_CALL := PO_FROM_INHERITED and FLAT_PATH_CALL[PO_WALK_AT]
        | PO_LIVE := PO_DEPENDENCE_LIVE or PO_WALK_STEP
        | PO_A := long(if PO_DEPENDENCE_LIVE then PO_END_KEY else PO_WALK_KEY)
        | PO_B := if PO_DEPENDENCE_LIVE then
                    long(PO_END_INSTANCE) * long(KEY_STRIDE)
                    + long(if not PO_LOOKS_LABEL then KEY_SIGNAL else if PO_END_SIGNAL >= 0 then KEY_CALL_LABEL else KEY_LABEL)
                  else long(PO_WALK_INSTANCE) * long(KEY_STRIDE) + long(if PO_WALK_CALL then KEY_CALL_LABEL else KEY_LABEL)
        | PO_HASH := integer((ulong(PO_A) * HASH_K1 + ulong(PO_B) * HASH_K2) shr HASH_SHIFT)
        | PO_N0 := HASH_HEAD[PO_HASH] - 1
        | PO_M0 := PO_N0 >= 0 and HN_A[PO_N0] = PO_A and HN_B[PO_N0] = PO_B
        | PO_N1 := if PO_N0 >= 0 then HN_NEXT[PO_N0] - 1 else -1
        | PO_M1 := PO_N1 >= 0 and HN_A[PO_N1] = PO_A and HN_B[PO_N1] = PO_B
        | PO_N2 := if PO_N1 >= 0 then HN_NEXT[PO_N1] - 1 else -1
        | PO_M2 := PO_N2 >= 0 and HN_A[PO_N2] = PO_A and HN_B[PO_N2] = PO_B
        | PO_N3 := if PO_N2 >= 0 then HN_NEXT[PO_N2] - 1 else -1
        | PO_M3 := PO_N3 >= 0 and HN_A[PO_N3] = PO_A and HN_B[PO_N3] = PO_B
        | PO_N4 := if PO_N3 >= 0 then HN_NEXT[PO_N3] - 1 else -1
        | PO_M4 := PO_N4 >= 0 and HN_A[PO_N4] = PO_A and HN_B[PO_N4] = PO_B
        | PO_N5 := if PO_N4 >= 0 then HN_NEXT[PO_N4] - 1 else -1
        | PO_M5 := PO_N5 >= 0 and HN_A[PO_N5] = PO_A and HN_B[PO_N5] = PO_B
        | PO_N6 := if PO_N5 >= 0 then HN_NEXT[PO_N5] - 1 else -1
        | PO_M6 := PO_N6 >= 0 and HN_A[PO_N6] = PO_A and HN_B[PO_N6] = PO_B
        | PO_N7 := if PO_N6 >= 0 then HN_NEXT[PO_N6] - 1 else -1
        | PO_M7 := PO_N7 >= 0 and HN_A[PO_N7] = PO_A and HN_B[PO_N7] = PO_B
        | PO_NODE := if PO_M0 then PO_N0 else if PO_M1 then PO_N1 else if PO_M2 then PO_N2 else if PO_M3 then PO_N3
                     else if PO_M4 then PO_N4 else if PO_M5 then PO_N5 else if PO_M6 then PO_N6 else if PO_M7 then PO_N7 else -1
        | PO_FOUND := PO_NODE >= 0
        | PO_VALUE := if PO_FOUND then HN_VALUE[PO_NODE] else -1
        | PO_UNSURE := PO_LIVE and not PO_FOUND and PO_N7 >= 0 and HN_NEXT[PO_N7] > 0
        | PO_END_FAILS := PO_DEPENDENCE_LIVE and PO_LOOKS_LABEL and PO_END_SIGNAL < 0 and not PO_FOUND
        | PO_END_TOKEN := if PO_TO_END then FLAT_DEPENDENCE_TO_TOKEN[PO_I] else FLAT_DEPENDENCE_FROM_TOKEN[PO_I]
        | PO_ELEMENT_FAILS := PO_DEPENDENCE_LIVE and PO_LOOKS_LABEL and PO_END_SIGNAL >= 0 and ELEMENT_SKIP[PO_END_TOKEN] > 0
                              and TYPE_KIND[ROWS_TYPE[PO_END_SIGNAL]] /= TK_ARRAY
        | PO_END_TYPE := ROWS_TYPE[if PO_END_SIGNAL >= 0 then PO_END_SIGNAL else 0]
        | PO_END_E1 := TYPE_ELEMENT[PO_END_TYPE]
        | PO_END_E2 := TYPE_ELEMENT[PO_END_E1]
        | PO_END_E3 := TYPE_ELEMENT[PO_END_E2]
        | PO_END_RANK := integer(TYPE_KIND[PO_END_TYPE] = TK_ARRAY) + integer(TYPE_KIND[PO_END_TYPE] = TK_ARRAY and TYPE_KIND[PO_END_E1] = TK_ARRAY)
                         + integer(TYPE_KIND[PO_END_TYPE] = TK_ARRAY and TYPE_KIND[PO_END_E1] = TK_ARRAY and TYPE_KIND[PO_END_E2] = TK_ARRAY)
                         + integer(TYPE_KIND[PO_END_TYPE] = TK_ARRAY and TYPE_KIND[PO_END_E1] = TK_ARRAY and TYPE_KIND[PO_END_E2] = TK_ARRAY
                                   and TYPE_KIND[PO_END_E3] = TK_ARRAY)
        | PO_RANK_FAILS := PO_DEPENDENCE_LIVE and PO_LOOKS_LABEL and PO_END_SIGNAL >= 0 and ELEMENT_SKIP[PO_END_TOKEN] > 0
                           and ELEMENT_INDICES[PO_END_TOKEN] > PO_END_RANK
        | PO_RANGE_ENDPOINT := PO_DEPENDENCE_LIVE and PO_LOOKS_LABEL and ELEMENT_SKIP[PO_END_TOKEN] > 0 and ELEMENT_RANGE[PO_END_TOKEN]
        | PO_ELEMENT_LABEL := PO_DEPENDENCE_LIVE and PO_LOOKS_LABEL and PO_END_SIGNAL < 0 and PO_FOUND and ELEMENT_SKIP[PO_END_TOKEN] > 0
        | PO_WALK_LABEL := if PO_WALK_STEP and PO_FOUND and LABEL_NEEDED[?][PO_VALUE] then PO_VALUE else -1
        | PO_WALK_EQUATION := PO_I
        | PO_SEGMENT_SIZE := EQ_ROW_END[PO_I] - EQ_ROW_START[PO_I] + integer(EQ_ROW_SIGNAL[PO_I] >= 0)
        | PO_SEGMENT_FULL := PO_WALK_LABEL >= 0 and SEGMENT_COUNT[?] >= SEGMENT_CAP
        | PO_LABELSUM_LIVE := AT_PS_LABELSUM and PO_I < FLAT_LABEL_COUNT
        | PO_SIZE_LIVE := AT_PS_SIZE and PO_I < FLAT_DEPENDENCE_COUNT
        | PO_FROM_SIGNAL_NOW := PO_FROM_SIGNAL[?][PO_I]
        | PO_TO_SIGNAL_NOW := PO_TO_SIGNAL[?][PO_I]
        | PO_FROM_LIST := (if PO_FROM_SIGNAL_NOW >= 0 then long(1) else long(0)) + long(LABEL_ROW_TOTAL[?][PO_FROM_LABEL[?][PO_I]])
        | PO_TO_LIST := (if PO_TO_SIGNAL_NOW >= 0 then long(1 + DEF_END[PO_TO_SIGNAL_NOW] - DEF_START[PO_TO_SIGNAL_NOW]) else long(0))
                        + long(LABEL_ROW_TOTAL[?][PO_TO_LABEL[?][PO_I]])
        | PO_PAIR_TOTAL := PO_PAIR_TOTAL[?] + (if PO_SIZE_LIVE then PO_FROM_LIST * PO_TO_LIST else long(0))
        | PO_SIZE_FAILS := PO_SIZE_LIVE and PO_PAIR_TOTAL > long(ROW_DEPENDENCE_CAP)
        | PO_LABELS_FULL := PO_LABELSUM_LIVE and PO_RUNNING[?] + LABEL_ROW_TOTAL[?][PO_I] > ROW_DEPENDENCE_CAP
        | PO_MESSAGE_NOW := if PO_END_FAILS then T_FLAT_UNDECLARED else if PO_RANGE_ENDPOINT then T_ELEMENT_RANGE else if PO_ELEMENT_FAILS then T_ELEMENT_ENDPOINT
                            else if PO_RANK_FAILS then T_INDEX_COUNT
                            else if PO_ELEMENT_LABEL then T_ELEMENT_LABEL else if PO_RANGE_FAILS then T_RANGE_INDEX
                            else if PO_UNSURE or PO_SEGMENT_FULL or PO_LABELS_FULL or PO_SIZE_FAILS then T_CAPACITY else 0
        | PO_FAILS := PO_MESSAGE_NOW /= 0
        | PO_MESSAGE := if PO_FAILS then PO_MESSAGE_NOW else PO_MESSAGE[?]
        | PO_TOKEN := if PO_FAILS then
                        (if PO_OUTPUT_RANGE then ROWS_TOKEN[PO_ROW_LEFT] else if PO_RANGE_FAILS then ROWS_TOKEN[PO_I]
                         else if PO_TO_END then FLAT_DEPENDENCE_TO_TOKEN[PO_I] else FLAT_DEPENDENCE_FROM_TOKEN[PO_I])
                      else PO_TOKEN[?]
        | PO_ARGUMENT0 := if PO_FAILS then
                            (if PO_UNSURE then F_CAP_LOOKUPS else if PO_SEGMENT_FULL or PO_LABELS_FULL then F_CAP_SEGMENTS
                             else if PO_SIZE_FAILS then F_CAP_ROW_DEPENDENCES else PO_END_KEY)
                          else PO_ARGUMENT0[?]
        | PO_INSTANCE := if PO_FAILS then PO_END_INSTANCE else PO_INSTANCE[?]
        | PO_GOES := not PO_FAILS
        | PO_FROM_SIGNAL := PO_FROM_SIGNAL[?] next (if PO_DEPENDENCE_LIVE and PO_K = 0 then PO_I else -1) : PO_VALUE
        | PO_FROM_LABEL := PO_FROM_LABEL[?] next (if PO_DEPENDENCE_LIVE and PO_K = 1 then PO_I else -1) : PO_VALUE
        | PO_TO_SIGNAL := PO_TO_SIGNAL[?] next (if PO_DEPENDENCE_LIVE and PO_K = 2 then PO_I else -1) : PO_VALUE
        | PO_TO_LABEL := PO_TO_LABEL[?] next (if PO_DEPENDENCE_LIVE and PO_K = 3 then PO_I else -1) : PO_VALUE
        | PO_MARKS := PO_DEPENDENCE_LIVE and PO_LOOKS_LABEL and PO_FOUND
        | LABEL_NEEDED := LABEL_NEEDED[?] next (if PO_MARKS then PO_VALUE else -1) : true
        | PO_NEEDS_LABELS := PO_NEEDS_LABELS[?] or PO_MARKS
        | PO_SEGMENT_SLOT := if PO_WALK_LABEL >= 0 and PO_GOES then SEGMENT_COUNT[?] else -1
        | SEGMENT_LABEL := SEGMENT_LABEL[?] next PO_SEGMENT_SLOT : PO_WALK_LABEL
        | SEGMENT_EQUATION := SEGMENT_EQUATION[?] next PO_SEGMENT_SLOT : PO_WALK_EQUATION
        | SEGMENT_COUNT := SEGMENT_COUNT[?] + integer(PO_SEGMENT_SLOT >= 0)
        | LABEL_ROW_TOTAL := LABEL_ROW_TOTAL[?] next (if PO_SEGMENT_SLOT >= 0 then PO_WALK_LABEL else -1)
                             : LABEL_ROW_TOTAL[?][PO_WALK_LABEL] + PO_SEGMENT_SIZE
        | LABEL_START := LABEL_START[?] next (if PO_LABELSUM_LIVE then PO_I else -1) : PO_RUNNING[?]
        | PO_RUNNING := if AT_PS_PREFIX then (if PO_PREFIX_LIVE then PO_RUNNING[?] + LOOP_DEF_TOTAL[?][PO_I] else 0)
                        else if AT_PS_LABELSUM then PO_RUNNING[?] + (if PO_LABELSUM_LIVE then LABEL_ROW_TOTAL[?][PO_I] else 0)
                        else PO_RUNNING[?]
        | PO_STATE := if PO_FAILS then PS_FAILED
                      else if AT_PS_DEPENDENCE then (if PO_DEPENDENCE_LIVE then PS_DEPENDENCE else PS_ROWS)
                      else if AT_PS_ROWS then (if PO_ROWS_LIVE then PS_ROWS else PS_PREFIX)
                      else if AT_PS_PREFIX then (if PO_PREFIX_LIVE then PS_PREFIX else PS_PLACE)
                      else if AT_PS_PLACE then (if PO_PLACE_LIVE then PS_PLACE else PS_WALK)
                      else if AT_PS_WALK then (if PO_WALK_LIVE then PS_WALK else PS_LABELSUM)
                      else if AT_PS_LABELSUM then (if PO_LABELSUM_LIVE then PS_LABELSUM else PS_SIZE)
                      else if AT_PS_SIZE then (if PO_SIZE_LIVE then PS_SIZE else PS_DONE)
                      else PO_NOW
        | PO_CURSOR := if AT_PS_DEPENDENCE then (if not PO_DEPENDENCE_LIVE then 0 else PO_I + integer(PO_K = 3))
                       else if AT_PS_WALK then (if not PO_WALK_LIVE then 0 else PO_I + integer(not PO_WALK_STEP))
                       else if AT_PS_ROWS then (if PO_ROWS_LIVE then PO_I + 1 else 0)
                       else if AT_PS_PREFIX then (if PO_PREFIX_LIVE then PO_I + 1 else 0)
                       else if AT_PS_PLACE then (if PO_PLACE_LIVE then PO_I + 1 else 0)
                       else if AT_PS_LABELSUM then (if PO_LABELSUM_LIVE then PO_I + 1 else 0)
                       else if AT_PS_SIZE then (if PO_SIZE_LIVE then PO_I + 1 else 0)
                       else PO_I
        | PO_SUB := if AT_PS_DEPENDENCE then (if PO_DEPENDENCE_LIVE and PO_K < 3 then PO_K + 1 else 0)
                    else if AT_PS_WALK then (if PO_WALK_STEP then PO_K + 1 else 0)
                    else 0
        |)
     with (| PO_STATE := PS_DEPENDENCE | PO_CURSOR := 0 | PO_SUB := 0 | PREV_COUNT := 0 | PO_RUNNING := 0
           | PO_NEEDS_LABELS := false | SEGMENT_COUNT := 0 | PO_PAIR_TOTAL := long(0) | PO_MESSAGE := 0 | PO_TOKEN := 0
           | PO_ARGUMENT0 := 0 | PO_INSTANCE := 0 |)
     end
   | POST_FAILED := LOWER_READY and PO_STATE = PS_FAILED
   | POST_INCOMPLETE := LOWER_READY and PO_STATE /= PS_DONE and PO_STATE /= PS_FAILED
   | POST_READY := LOWER_READY and PO_STATE = PS_DONE
   | EXPAND_BOUND := long(64) + long(PO_RUNNING) + long(SEGMENT_COUNT) + PO_PAIR_TOTAL + long(FLAT_DEPENDENCE_COUNT)
                     + long(PREV_COUNT) + long(2) * long(ROW_COUNT)
   | EXPAND_INDEX := 0 .. (if POST_READY then EXPAND_BOUND else long(-1))
   | iterate EXPAND_INDEX of
       (| XP_NOW := XP_STATE[?]
        | XP_I := XP_CURSOR[?]
        | XP_J := XP_INNER[?]
        | XP_K := XP_SUB[?]
        | AT_XS_PLACE := XP_NOW = XS_PLACE
        | AT_XS_PAIRS := XP_NOW = XS_PAIRS
        | AT_XS_PREV := XP_NOW = XS_PREV
        | XP_PLACE_LIVE := AT_XS_PLACE and XP_I < SEGMENT_COUNT
        | XP_LABEL := SEGMENT_LABEL[XP_I]
        | XP_EQUATION := SEGMENT_EQUATION[XP_I]
        | XP_RANGE_LENGTH := EQ_ROW_END[XP_EQUATION] - EQ_ROW_START[XP_EQUATION]
        | XP_SEGMENT_SIZE := XP_RANGE_LENGTH + integer(EQ_ROW_SIGNAL[XP_EQUATION] >= 0)
        | XP_PLACES := XP_PLACE_LIVE and XP_K < XP_SEGMENT_SIZE
        | XP_PLACE_FILL := LABEL_FILL[?][XP_LABEL]
        | LABEL_ROWS := LABEL_ROWS[?] next (if XP_PLACES then LABEL_START[XP_LABEL] + XP_PLACE_FILL else -1)
                        : (if XP_K < XP_RANGE_LENGTH then EQ_ROW_START[XP_EQUATION] + XP_K else EQ_ROW_SIGNAL[XP_EQUATION])
        | LABEL_FILL := LABEL_FILL[?] next (if XP_PLACES then XP_LABEL else -1) : XP_PLACE_FILL + 1
        | XP_PLACE_ENDS := XP_PLACE_LIVE and XP_K + 1 >= XP_SEGMENT_SIZE
        | XP_PAIRS_LIVE := AT_XS_PAIRS and XP_I < FLAT_DEPENDENCE_COUNT
        | XP_FROM_SIGNAL := PO_FROM_SIGNAL[XP_I]
        | XP_FROM_LABEL := PO_FROM_LABEL[XP_I]
        | XP_TO_SIGNAL := PO_TO_SIGNAL[XP_I]
        | XP_TO_LABEL := PO_TO_LABEL[XP_I]
        | XP_FROM_HEAD := integer(XP_FROM_SIGNAL >= 0)
        | XP_DEF_LENGTH := if XP_TO_SIGNAL >= 0 then DEF_END[XP_TO_SIGNAL] - DEF_START[XP_TO_SIGNAL] else 0
        | XP_TO_HEAD := integer(XP_TO_SIGNAL >= 0) + XP_DEF_LENGTH
        | XP_FROM_LENGTH := XP_FROM_HEAD + LABEL_ROW_TOTAL[XP_FROM_LABEL]
        | XP_TO_LENGTH := XP_TO_HEAD + LABEL_ROW_TOTAL[XP_TO_LABEL]
        | XP_EMITS_PAIR := XP_PAIRS_LIVE and XP_J < XP_FROM_LENGTH and XP_K < XP_TO_LENGTH
        | XP_FROM_ROW := if XP_J < XP_FROM_HEAD then XP_FROM_SIGNAL
                         else LABEL_ROWS[?][LABEL_START[XP_FROM_LABEL] + XP_J - XP_FROM_HEAD]
        | XP_TO_ROW := if XP_TO_SIGNAL >= 0 and XP_K = 0 then XP_TO_SIGNAL
                       else if XP_K < XP_TO_HEAD then DEF_START[XP_TO_SIGNAL] + XP_K - 1
                       else LABEL_ROWS[?][LABEL_START[XP_TO_LABEL] + XP_K - XP_TO_HEAD]
        | XP_PAIR_ROW_ENDS := XP_K + 1 >= XP_TO_LENGTH
        | XP_PAIR_ENDS := XP_PAIRS_LIVE and (not XP_EMITS_PAIR or XP_PAIR_ROW_ENDS and XP_J + 1 >= XP_FROM_LENGTH)
        | XP_PREV_LIVE := AT_XS_PREV and XP_I < PREV_COUNT
        | XP_PREVIOUS := PREV_LIST[XP_I]
        | XP_SIGNAL := ROWS_LEFT[XP_PREVIOUS]
        | XP_TOP := ROWS_LEFT[XP_SIGNAL]
        | XP_WRITER := if XP_TOP >= 0 and ROWS_OP[XP_TOP] = OP_PUT then ROWS_FIRST_WRITER[XP_TOP] else XP_TOP
        | XP_SCALAR := TYPE_KIND[ROWS_TYPE[XP_SIGNAL]] /= TK_ARRAY
        | XP_STARTED := XP_PREV_STARTED[?]
        | XP_A := if XP_STARTED then XP_LEFT_AT[?] else LEFT_HEAD[XP_PREVIOUS] - 1
        | XP_B := if XP_STARTED then XP_RIGHT_AT[?] else RIGHT_HEAD[XP_PREVIOUS] - 1
        | XP_TAKES_A := XP_A >= 0 and (XP_B < 0 or XP_A < XP_B)
        | XP_TAKES_B := XP_B >= 0 and not XP_TAKES_A
        | XP_READER := if XP_TAKES_A then XP_A else XP_B
        | XP_PREV_SCALAR := XP_PREV_LIVE and XP_SCALAR
        | XP_EMITS_WAR := XP_PREV_LIVE and not XP_SCALAR and (XP_TAKES_A or XP_TAKES_B) and XP_READER /= XP_WRITER
        | XP_PREV_ENDS := XP_PREV_SCALAR or XP_PREV_LIVE and not XP_TAKES_A and not XP_TAKES_B
        | XP_DEPENDENCE_WANTED := XP_EMITS_PAIR or XP_PREV_SCALAR
        | XP_FAILS := XP_DEPENDENCE_WANTED and DEPENDENCE_TOTAL[?] >= ROW_DEPENDENCE_CAP
                      or XP_EMITS_WAR and WAR_COUNT[?] >= ROW_DEPENDENCE_CAP
        | XP_DEPENDENCE_SLOT := if XP_DEPENDENCE_WANTED and not XP_FAILS then DEPENDENCE_TOTAL[?] else -1
        | DEPENDENCE_FROM_ROW := DEPENDENCE_FROM_ROW[?] next XP_DEPENDENCE_SLOT : (if XP_PREV_SCALAR then XP_PREVIOUS else XP_FROM_ROW)
        | DEPENDENCE_TO_ROW := DEPENDENCE_TO_ROW[?] next XP_DEPENDENCE_SLOT : (if XP_PREV_SCALAR then XP_SIGNAL else XP_TO_ROW)
        | DEPENDENCE_FLAT := DEPENDENCE_FLAT[?] next XP_DEPENDENCE_SLOT : (if XP_PREV_SCALAR then -1 else XP_I)
        | DEPENDENCE_TOTAL := DEPENDENCE_TOTAL[?] + integer(XP_DEPENDENCE_SLOT >= 0)
        | XP_WAR_SLOT := if XP_EMITS_WAR and not XP_FAILS then WAR_COUNT[?] else -1
        | WAR_READER := WAR_READER[?] next XP_WAR_SLOT : XP_READER
        | WAR_WRITER := WAR_WRITER[?] next XP_WAR_SLOT : XP_WRITER
        | WAR_SIGNAL := WAR_SIGNAL[?] next XP_WAR_SLOT : XP_SIGNAL
        | WAR_COUNT := WAR_COUNT[?] + integer(XP_WAR_SLOT >= 0)
        | XP_LEFT_AT := if XP_TAKES_A then LEFT_NEXT[XP_A] - 1 else XP_A
        | XP_RIGHT_AT := if XP_TAKES_B then RIGHT_NEXT[XP_B] - 1 else XP_B
        | XP_PREV_STARTED := XP_PREV_LIVE and not XP_PREV_ENDS
        | XP_STATE := if XP_FAILS then XS_FAILED
                      else if AT_XS_PLACE then (if XP_PLACE_LIVE then XS_PLACE else XS_PAIRS)
                      else if AT_XS_PAIRS then (if XP_PAIRS_LIVE then XS_PAIRS else XS_PREV)
                      else if AT_XS_PREV then (if XP_PREV_LIVE then XS_PREV else XS_DONE)
                      else XP_NOW
        | XP_CURSOR := if AT_XS_PLACE then (if not XP_PLACE_LIVE then 0 else XP_I + integer(XP_PLACE_ENDS))
                       else if AT_XS_PAIRS then (if not XP_PAIRS_LIVE then 0 else XP_I + integer(XP_PAIR_ENDS))
                       else XP_I + integer(XP_PREV_ENDS)
        | XP_INNER := if AT_XS_PAIRS and XP_EMITS_PAIR and not XP_PAIR_ENDS then XP_J + integer(XP_PAIR_ROW_ENDS) else 0
        | XP_SUB := if XP_PLACE_LIVE and not XP_PLACE_ENDS then XP_K + 1
                    else if XP_EMITS_PAIR and not XP_PAIR_ENDS then (if XP_PAIR_ROW_ENDS then 0 else XP_K + 1) else 0
        |)
     with (| XP_STATE := XS_PLACE | XP_CURSOR := 0 | XP_INNER := 0 | XP_SUB := 0 | XP_PREV_STARTED := false
           | XP_LEFT_AT := -1 | XP_RIGHT_AT := -1 | DEPENDENCE_TOTAL := 0 | WAR_COUNT := 0 |)
     end
   | EXPAND_FAILED := POST_READY and XP_STATE = XS_FAILED
   | EXPAND_INCOMPLETE := POST_READY and XP_STATE /= XS_DONE and XP_STATE /= XS_FAILED
   | ROWS_READY := POST_READY and XP_STATE = XS_DONE
   | CLOCKS_DUMP := DUMP_PASS = 5
   | CLOCKS_RUN := ROWS_READY and (DUMP_PASS = 0 or CLOCKS_DUMP or SCHEDULE_DUMP or CODE_DUMP)
   | CP_INDEX := 0 .. (if CLOCKS_RUN then long(ROW_COUNT) - long(1) else long(-1))
   | iterate CP_INDEX of
       (| CP_OP := ROWS_OP[CP_INDEX]
        | CP_LEFT_CTX := ROWS_CTX[ROWS_LEFT[CP_INDEX]]
        | CP_RIGHT_CTX := ROWS_CTX[ROWS_RIGHT[CP_INDEX]]
        | CP_SAMPLES := CP_OP = OP_WHEN or CP_OP = OP_UWHEN
        | CP_OP_UNIONS := if CP_OP = OP_COPY or CP_OP = OP_SEED or CP_OP = OP_EFFECT or OP_MONOCHRONOUS[CP_OP] = 1 then integer(ROWS_LEFT[CP_INDEX] >= 0) + integer(ROWS_RIGHT[CP_INDEX] >= 0)
                        else if CP_OP = OP_DELAY or CP_OP = OP_LAG then 1 + integer(ROWS_RIGHT[CP_INDEX] >= 0)
                        else if CP_OP = OP_CLOCK or CP_OP = OP_UWHEN then 1
                        else if CP_OP = OP_WHEN then (if CP_LEFT_CTX then 2 else 0)
                        else if CP_OP = OP_DEFAULT then (if CP_LEFT_CTX then 1 + integer(CP_RIGHT_CTX) else integer(CP_RIGHT_CTX))
                        else 0
        | CP_UNIONS := CP_OP_UNIONS + integer(ROWS_LOOP[CP_INDEX] >= 0)
        | CP_STEPS := CP_STEPS[?] + long(if CP_UNIONS > 1 then CP_UNIONS else 1)
        | CP_SAMPLE_BOUND := CP_SAMPLE_BOUND[?] + integer(CP_SAMPLES)
        | CP_DEF_BOUND := CP_DEF_BOUND[?] + integer(CP_SAMPLES or CP_OP = OP_DEFAULT)
        | CP_GUARDED := CP_GUARDED[?] + integer(ROWS_GUARD[CP_INDEX] >= 0)
        | CP_OBLIGE_BOUND := CP_OBLIGE_BOUND[?] + integer(CP_OP = OP_DEFAULT and not CP_LEFT_CTX and CP_RIGHT_CTX)
        | CP_ROW := integer(CP_INDEX)
        | CP_PARTIAL := CP_ROW < FLAT_SIGNAL_COUNT and SIGNAL_PARTIAL[if CP_ROW < FLAT_SIGNAL_COUNT then CP_ROW else 0]
        | ROW_PARTIAL := ROW_PARTIAL[?] next (if CP_PARTIAL then CP_ROW else -1) : CP_ROW + 1
        | ROW_SOURCE := ROW_SOURCE[?] next CP_INDEX
                      : not ROWS_CTX[CP_INDEX] and not ((CP_OP = OP_COPY or CP_OP = OP_CLOCK) and CP_LEFT_CTX)
        |)
     with (| CP_STEPS := long(0) | CP_SAMPLE_BOUND := 0 | CP_DEF_BOUND := 0 | CP_GUARDED := 0 | CP_OBLIGE_BOUND := 0 |)
     end
   | CK_TOTAL_BOUND := long(ROW_COUNT) + long(CP_SAMPLE_BOUND)
   | CK_DEF_BOUND := long(CP_DEF_BOUND) + long(CP_SAMPLE_BOUND) + long(FLAT_RELATION_STEPS)
   | CK_ROUND_BOUND := long(3) * CK_DEF_BOUND + long(2) * long(CP_GUARDED) + long(4)
   | PD_PAIRS := long(PD_COUNT) * long(PD_COUNT)
   | CK_CHECK_BOUND := long(CP_OBLIGE_BOUND) + CK_DEF_BOUND + long(FLAT_RELATION_STEPS) + long(CP_GUARDED) + PD_PAIRS
   | CK_TICK_BOUND := long(CP_GUARDED) * long(CP_GUARDED)
   | BD_JOBS := long(4) * CK_DEF_BOUND + long(2) * CK_CHECK_BOUND + long(3) * long(FLAT_ASSUMPTIONS) + CK_TICK_BOUND
   | BD_BUDGET := (CK_DEF_BOUND + long(CP_OBLIGE_BOUND) + long(FLAT_RELATION_STEPS) + long(3) * long(FLAT_ASSUMPTIONS) + CK_TICK_BOUND + PD_PAIRS)
                  * (long(4) * (long(CP_SAMPLE_BOUND) + long(1)) + long(JOB_BASE_STEPS)) + long(2) * CK_CHECK_BOUND
   | CK_BOUND := long(32) + CP_STEPS + long(CP_SAMPLE_BOUND) + long(FLAT_MEMBER_COUNT) + long(FLAT_GROUP_COUNT) + PD_PAIRS
                 + long(FLAT_RELATION_STEPS) + long(6) * CK_CHECK_BOUND + long(6) * long(FLAT_ASSUMPTIONS) + long(2) * CK_TICK_BOUND
                 + long(3) * CK_DEF_BOUND + long(2) * long(CP_GUARDED) + CK_TOTAL_BOUND
                 + long(CK_ROUND_LIMIT - 1) * CK_ROUND_BOUND + BD_BUDGET + long(2) * BD_JOBS + CK_TOTAL_BOUND
   | BDD_INTERIOR := CLOCK_CAP + 2
   | BDD_LIMIT := BDD_INTERIOR + BDD_NODE_CAP
   | CK_ROUND_LIMIT := integer(CK_DEF_BOUND + long(CP_GUARDED) + long(2))
   | CK_INDEX := 0 .. (if CLOCKS_RUN then CK_BOUND else long(-1))
   | iterate CK_INDEX of
       (| KS_NOW := CK_STATE[?]
        | AT_KS_ROWS := KS_NOW = KS_ROWS
        | AT_KS_SAMPLES := KS_NOW = KS_SAMPLES
        | AT_KS_GROUPS := KS_NOW = KS_GROUPS
        | AT_KS_PAIRS := KS_NOW = KS_PAIRS
        | AT_KS_REWRITE := KS_NOW = KS_REWRITE
        | AT_KS_TARGETS := KS_NOW = KS_TARGETS
        | AT_KS_GUARDS := KS_NOW = KS_GUARDS
        | AT_KS_SCAN := KS_NOW = KS_SCAN
        | AT_KS_DEFS := KS_NOW = KS_DEFS
        | AT_KS_APPLY := KS_NOW = KS_APPLY
        | AT_KS_WAIT := KS_NOW = KS_WAIT
        | AT_KS_CHECKS := KS_NOW = KS_CHECKS
        | KC := CK_CURSOR[?]
        | KK := CK_SUB[?]
        | KRN := CK_ROUND[?]
        | K_FIRST_ROUND := KRN = 1
        | K_SAMPLES_NOW := K_SAMPLE_COUNT[?]
        | K_DEFS_NOW := DEF_COUNT[?]
        | K_OBS_NOW := OB_COUNT[?]
        | KR_LIVE := AT_KS_ROWS and KC < ROW_COUNT
        | KR_TOO_MANY := AT_KS_ROWS and ROW_COUNT > CLOCK_CAP
        | KR_OP := ROWS_OP[KC]
        | KR_LEFT := ROWS_LEFT[KC]
        | KR_RIGHT := ROWS_RIGHT[KC]
        | KR_LEFT_CTX := ROWS_CTX[KR_LEFT]
        | KR_RIGHT_CTX := ROWS_CTX[KR_RIGHT]
        | KR_IS_WHEN := KR_OP = OP_WHEN
        | KR_SAMPLES := KR_IS_WHEN or KR_OP = OP_UWHEN
        | KR_CONDITION := if KR_IS_WHEN then KR_RIGHT else KR_LEFT
        | KR_FIRST := KR_LIVE and KK = 0
        | KR_NULL := KR_OP = OP_CLOCK and ROWS_OP[KR_LEFT] = OP_CONST and ROWS_VALUE[KR_LEFT] = long(0)
        | KR_NO_CLOCK := KR_FIRST and (KR_SAMPLES and ROWS_CTX[KR_CONDITION] or KR_OP = OP_CLOCK and KR_LEFT_CTX and not KR_NULL)
        | KR_DELAY_CONSTANT := KR_FIRST and (KR_OP = OP_DELAY or KR_OP = OP_LAG) and KR_LEFT_CTX
        | KR_EXISTING := SAMPLE_OF[?][KR_CONDITION] - 1
        | KR_EVENT := ROWS_TYPE[KR_CONDITION] = BUILTIN_EVENT
        | KR_NEW_SAMPLE := ROW_COUNT + K_SAMPLES_NOW
        | KR_CREATES := KR_FIRST and KR_SAMPLES and not KR_EVENT and KR_EXISTING < 0
        | KR_CLOCKS_FULL := KR_CREATES and KR_NEW_SAMPLE >= CLOCK_CAP
        | KR_SAMPLE := if KR_EVENT then KR_CONDITION else if KR_EXISTING >= 0 then KR_EXISTING else KR_NEW_SAMPLE
        | KR_MONO := KR_OP = OP_COPY or KR_OP = OP_SEED or KR_OP = OP_EFFECT or OP_MONOCHRONOUS[KR_OP] = 1
        | KR_ONE := KR_OP = OP_DELAY or KR_OP = OP_LAG or KR_OP = OP_CLOCK
        | KR_X0 := if KR_MONO or KR_ONE then KR_LEFT else if KR_OP = OP_UWHEN then KR_SAMPLE
                 else if KR_IS_WHEN or KR_LEFT_CTX then KR_LEFT else KR_RIGHT
        | KR_X1 := if KR_IS_WHEN then KR_SAMPLE else KR_RIGHT
        | KR_OP_UNIONS := if KR_MONO then integer(KR_LEFT >= 0) + integer(KR_RIGHT >= 0)
                        else if KR_OP = OP_DELAY or KR_OP = OP_LAG then 1 + integer(KR_RIGHT >= 0)
                        else if KR_ONE or KR_OP = OP_UWHEN then 1
                        else if KR_IS_WHEN then (if KR_LEFT_CTX then 2 else 0)
                        else if KR_OP = OP_DEFAULT then (if KR_LEFT_CTX then 1 + integer(KR_RIGHT_CTX) else integer(KR_RIGHT_CTX))
                        else 0
        | KR_LOOP := ROWS_LOOP[KC]
        | KR_HAS_LOOP := KR_LOOP >= 0
        | KR_UNIONS := KR_OP_UNIONS + integer(KR_HAS_LOOP)
        | KR_X := if KR_HAS_LOOP and KK = 0 then LOOP_INDEX[KR_LOOP] else if KK - integer(KR_HAS_LOOP) = 0 then KR_X0 else KR_X1
        | KR_UNITES := KR_LIVE and KK < KR_UNIONS
        | KR_ENDS := KK + 1 >= KR_UNIONS
        | KR_DEFINES := KR_FIRST and (KR_IS_WHEN and not KR_LEFT_CTX or KR_OP = OP_DEFAULT and not KR_LEFT_CTX and not KR_RIGHT_CTX or KR_NULL)
        | KR_OBLIGES := KR_FIRST and KR_OP = OP_DEFAULT and not KR_LEFT_CTX and KR_RIGHT_CTX
        | KR_GUARDED := KR_FIRST and ROWS_GUARD[KC] >= 0
        | KR_GUARD_CODE := integer(TOKEN_CODE[ROWS_TOKEN[ROWS_GUARD[KC]]])
        | KR_TICK_MEMBER := KR_GUARDED and (ROWS_OWNER[KC] = KC or ROWS_OWNER[KC] < 0 and ROWS_OP[KC] = OP_EFFECT) and not KR_OBLIGES and KR_GUARD_CODE /= C_OPEN_BRACE and KR_GUARD_CODE /= C_ELSE
        | KR_TICK_OBLIGES := KR_TICK_MEMBER and not GUARD_TICKED[?][ROWS_GUARD[KC]]
        | KM_LIVE := AT_KS_SAMPLES and KC < K_SAMPLES_NOW
        | KM_CONDITION := SAMPLE_ROW[?][KC]
        | KG_LIVE := AT_KS_GROUPS and KC < FLAT_GROUP_COUNT
        | KG_TOTAL := FLAT_GROUP_MEMBER_TOTAL[KC]
        | KG_AT := FLAT_GROUP_MEMBER_FIRST[KC]
        | KG_RELATION := FLAT_GROUP_RELATION[KC]
        | KG_ASSUMED := FLAT_GROUP_ASSUMED[KC]
        | KG_ASSERT := KG_RELATION = RELATION_ASSERT
        | KG_SYNCHRONOUS := KG_RELATION = C_CLOCK_EQUAL and not KG_ASSUMED
        | KG_STEP_TOTAL := if KG_SYNCHRONOUS then KG_TOTAL else KG_TOTAL * KG_TOTAL
        | KG_LEFT := if KG_SYNCHRONOUS then KK else KK / KG_TOTAL
        | KG_RIGHT := KK modulo KG_TOTAL
        | KG_MEMBER := GROUP_MEMBER_ROW[KG_AT + KG_LEFT]
        | KG_HEAD := GROUP_MEMBER_ROW[KG_AT]
        | KG_STEPS := KG_LIVE and KK < KG_STEP_TOTAL
        | KG_NO_CLOCK := KG_STEPS and ROWS_CTX[KG_MEMBER]
                       and not (ROWS_OP[KG_MEMBER] = OP_CLOCK and ROWS_OP[ROWS_LEFT[KG_MEMBER]] = OP_CONST
                                and ROWS_VALUE[ROWS_LEFT[KG_MEMBER]] = long(0))
        | KG_UNITES := KG_STEPS and KG_SYNCHRONOUS and KK > 0
        | KG_KIND := if KG_RELATION = C_CLOCK_LT then OB_LT else if KG_RELATION = C_CLOCK_GT then OB_GT
                     else if KG_RELATION = C_CLOCK_SHARP then OB_SHARP else if KG_ASSERT then OB_BOOLEAN
                     else if KG_RELATION = C_IDENTITY and not KG_ASSUMED then OB_IDENTITY else OB_EQUAL
        | KG_MIN := KG_RELATION = RELATION_MIN
        | KG_CONDITION := KG_RELATION = RELATION_CONDITION
        | KG_NOT_NAME := KG_STEPS and KG_MIN and ROWS_OWNER[KG_MEMBER] /= KG_MEMBER
        | KG_MARKS_MINIMAL := KG_STEPS and KG_MIN and not KG_NOT_NAME
        | KG_MINIMAL_DEF := KG_OBLIGES and (KG_KIND = OB_LT or KG_KIND = OB_GT) and not KG_ASSUMED
        | KG_NOT_BOOLEAN := KG_STEPS and (KG_ASSERT or KG_CONDITION) and ROWS_TYPE[KG_MEMBER] /= BUILTIN_BOOLEAN and ROWS_TYPE[KG_MEMBER] /= BUILTIN_EVENT
        | KG_OBLIGES := KG_STEPS and not KG_SYNCHRONOUS and (KG_LEFT < KG_RIGHT or KG_ASSERT) and not KG_NO_CLOCK and not KG_NOT_BOOLEAN and not KG_MIN
        | KG_ENDS := KK + 1 >= KG_STEP_TOTAL
        | KPD_LIVE := AT_KS_PAIRS and long(KC) < PD_PAIRS
        | KPD_I := KC / (if PD_COUNT > 0 then PD_COUNT else 1)
        | KPD_J := KC modulo (if PD_COUNT > 0 then PD_COUNT else 1)
        | KPD_GUARD_I := if PD_GUARD[KPD_I] >= 0 then GUARD_BRANCH[PD_GUARD[KPD_I]] else -1
        | KPD_GUARD_J := if PD_GUARD[KPD_J] >= 0 then GUARD_BRANCH[PD_GUARD[KPD_J]] else -1
        | KPD_CASE_I := if KPD_GUARD_I >= 0 then GUARD_CASE[KPD_GUARD_I] else 0
        | KPD_BRANCHES := KPD_CASE_I > 0 and KPD_GUARD_J >= 0 and KPD_GUARD_I /= KPD_GUARD_J
                          and GUARD_CASE[if KPD_GUARD_J >= 0 then KPD_GUARD_J else 0] = KPD_CASE_I
                          and PD_CONTEXT[KPD_I] = PD_CONTEXT[KPD_J]
        | KPD_OBLIGES := KPD_LIVE and KPD_I < KPD_J and PD_SIGNAL[KPD_I] = PD_SIGNAL[KPD_J] and not KPD_BRANCHES
        | KW_LIVE := AT_KS_REWRITE and KC < K_DEFS_NOW
        | KW_MERGED := DEF_TARGET[?][KC]
        | KW_A := ROWS_LEFT[KW_MERGED]
        | KW_B := ROWS_RIGHT[KW_MERGED]
        | KW_FIRST := ROWS_RIGHT[KW_A]
        | KW_SECOND := ROWS_RIGHT[KW_B]
        | KW_SECOND_NEGATES := ROWS_OP[KW_SECOND] = OP_NOT and ROWS_LEFT[KW_SECOND] = KW_FIRST
        | KW_FIRST_NEGATES := ROWS_OP[KW_FIRST] = OP_NOT and ROWS_LEFT[KW_FIRST] = KW_SECOND
        | KW_SHAPED := KW_LIVE and DEF_KIND[?][KC] = CLK_SUM and ROWS_OP[KW_A] = OP_WHEN and ROWS_OP[KW_B] = OP_WHEN
                     and (KW_SECOND_NEGATES or KW_FIRST_NEGATES)
        | KW_CONDITION := if KW_SECOND_NEGATES then KW_FIRST else KW_SECOND
        | KW_V0 := ROWS_LEFT[KW_A]
        | KW_V1 := ROWS_LEFT[KW_B]
        | KW_BOTH_CTX := ROWS_CTX[KW_V0] and ROWS_CTX[KW_V1]
        | KW_UNITES := KW_SHAPED and KW_BOTH_CTX
        | KW_PRODUCT := KW_SHAPED and not ROWS_CTX[KW_V0] and not ROWS_CTX[KW_V1] and KF1 = KF2
        | K_DEF_LIMIT := CK_DEF_LIMIT[?]
        | KT_LIVE := AT_KS_TARGETS and KC < K_DEF_LIMIT
        | K_LISTED_DEF := if K_FIRST_ROUND then KC else PEND[?][KC]
        | KT_MARKS := KT_LIVE and not DEF_DONE[?][K_LISTED_DEF] and DEF_KIND[?][K_LISTED_DEF] /= CLK_NULL
        | KU_LIVE := AT_KS_GUARDS and KC < GUARDED_COUNT[?]
        | KU_ROW := GUARDED[?][KC]
        | KU_SETS := KU_LIVE and CGSTAMP[?][KF1] /= KRN
        | KS_LIVE := AT_KS_SCAN and KC < CK_SCAN_LIMIT[?]
        | KS_CLOCK := if K_FIRST_ROUND then KC else CAND[?][KC]
        | KS_OPEN := KS_LIVE and KF1 = KS_CLOCK and NODE_KIND[?][KS_CLOCK] = CLK_NONE
        | KS_ELIGIBLE := KS_OPEN and TSTAMP[?][KS_CLOCK] /= KRN
        | KS_MINIMAL := MINIMAL_SOLUTION[?][KF1_ROOT]
        | KS_GUARD_SOURCE := if KS_MINIMAL > 0 then KS_MINIMAL - 1 else if CGSTAMP[?][KS_CLOCK] = KRN then CGUARD[?][KS_CLOCK] else KS_CLOCK
        | KS_MINIMAL_EMPTY := KS_ELIGIBLE and KS_MINIMAL < 0
        | KS_GUARDED := KF2 /= KS_CLOCK
        | KS_ATTACHES := KS_ELIGIBLE and KS_GUARDED and NODE_KIND[?][KF2] /= CLK_NONE
        | KS_ROOTS := KS_ELIGIBLE and not KS_GUARDED and (CLASS_HAS_SOURCE[?][KF1_ROOT] or ROW_SOURCE[KF1_ROOT])
        | KS_KEEPS := KS_OPEN and not KS_ATTACHES and not KS_ROOTS
        | KD_LIVE := AT_KS_DEFS and KC < K_DEF_LIMIT
        | KD_DEF := K_LISTED_DEF
        | KD_ACTS := KD_LIVE and not DEF_DONE[?][KD_DEF]
        | KD_OPENS := KD_ACTS and KK = 0
        | KD_KIND := DEF_KIND[?][KD_DEF]
        | KD_SAMPLE := KD_KIND = CLK_SAMPLE
        | KD_PRODUCT := KD_KIND = CLK_PRODUCT
        | KD_NULL := KD_KIND = CLK_NULL
        | KD_T := KF1
        | KD_L := KF2
        | KD_R := KF3
        | KD_HITS := KD_OPENS and not KD_SAMPLE and not KD_NULL and (KD_L = KD_T or KD_R = KD_T)
        | KD_OTHER := if KD_L = KD_T then KD_R else KD_L
        | KD_MINIMAL_ONLY := DEF_MINIMAL_ONLY[?][KD_DEF]
        | KD_MINIMAL_TARGET := CLASS_MINIMAL[?][KF1_ROOT]
        | KD_MINIMAL_RECORDS := KD_HITS and KD_OTHER /= KD_T and KD_MINIMAL_TARGET
        | KD_MINIMAL_VALUE := if KD_PRODUCT then -1 else KD_OTHER + 1
        | KD_MINIMAL_TWO := KD_MINIMAL_RECORDS and MINIMAL_SOLUTION[?][KF1_ROOT] /= 0 and MINIMAL_SOLUTION[?][KF1_ROOT] /= KD_MINIMAL_VALUE
        | KD_OBLIGES := KD_HITS and KD_OTHER /= KD_T and not KD_MINIMAL_ONLY
        | KD_TARGET_KIND := NODE_KIND[?][KD_T]
        | KD_EQUAL := KD_OPENS and not KD_HITS and not KD_SAMPLE and not KD_NULL and KD_L = KD_R and KD_TARGET_KIND = CLK_NONE
        | KD_WAITS := KD_OPENS and not KD_HITS and not KD_EQUAL
                   and (if KD_NULL then KD_TARGET_KIND = CLK_NONE
                        else NODE_KIND[?][KD_L] = CLK_NONE or not KD_SAMPLE and NODE_KIND[?][KD_R] = CLK_NONE)
        | KD_SETTLES := KD_OPENS and not KD_HITS and not KD_EQUAL and not KD_WAITS
        | KD_ROOT_L := NODE_ROOT1[?][KD_L] - 1
        | KD_ROOT_R := NODE_ROOT1[?][KD_R] - 1
        | KD_FITS_NO_TREE := KD_SETTLES and not KD_SAMPLE and not KD_NULL and KD_ROOT_L /= KD_ROOT_R
        | KD_PARTIAL := if CLASS_PARTIAL[?][KF1_ROOT] > 0 then CLASS_PARTIAL[?][KF1_ROOT] else ROW_PARTIAL[KF1_ROOT]
        | KD_NO_CLOCK := KD_FITS_NO_TREE and KD_PARTIAL > 0
        | KH_PARTIAL := if CLASS_PARTIAL[?][KF2_ROOT] > 0 then CLASS_PARTIAL[?][KF2_ROOT] else if ROW_PARTIAL[KF2_ROOT] > 0 then ROW_PARTIAL[KF2_ROOT]
                        else if CLASS_PARTIAL[?][KF1_ROOT] > 0 then CLASS_PARTIAL[?][KF1_ROOT] else ROW_PARTIAL[KF1_ROOT]
        | KH_NO_CLOCK := KH_FITS_NO_TREE and KH_PARTIAL > 0
        | KD_NULL_SETTLES := KD_SETTLES and KD_NULL
        | KD_FORMS := KD_SETTLES and not KD_FITS_NO_TREE and not KD_NULL
        | KD_BDD_L := CLOCK_BDD[?][KD_L]
        | KD_BDD_R := CLOCK_BDD[?][KD_R]
        | KD_MEASURES := KD_FORMS and not KD_SAMPLE
        | KV_ROW_0 := if AT_KS_CHECKS then OB_SMALL[?][KH_O] else if AT_KS_GROUPS then KG_MEMBER else DEF_LEFT[?][KD_DEF]
        | KV_NOT_0 := false
        | KV_ROW_1 := if ROWS_OP[KV_ROW_0] = OP_NOT or ROWS_OP[KV_ROW_0] = OP_COPY or ROWS_OP[KV_ROW_0] = OP_WHEN then ROWS_LEFT[KV_ROW_0] else KV_ROW_0
        | KV_NOT_1 := KV_NOT_0 /= (ROWS_OP[KV_ROW_0] = OP_NOT)
        | KV_ROW_2 := if ROWS_OP[KV_ROW_1] = OP_NOT or ROWS_OP[KV_ROW_1] = OP_COPY or ROWS_OP[KV_ROW_1] = OP_WHEN then ROWS_LEFT[KV_ROW_1] else KV_ROW_1
        | KV_NOT_2 := KV_NOT_1 /= (ROWS_OP[KV_ROW_1] = OP_NOT)
        | KV_ROW_3 := if ROWS_OP[KV_ROW_2] = OP_NOT or ROWS_OP[KV_ROW_2] = OP_COPY or ROWS_OP[KV_ROW_2] = OP_WHEN then ROWS_LEFT[KV_ROW_2] else KV_ROW_2
        | KV_NOT_3 := KV_NOT_2 /= (ROWS_OP[KV_ROW_2] = OP_NOT)
        | KV_ROW_4 := if ROWS_OP[KV_ROW_3] = OP_NOT or ROWS_OP[KV_ROW_3] = OP_COPY or ROWS_OP[KV_ROW_3] = OP_WHEN then ROWS_LEFT[KV_ROW_3] else KV_ROW_3
        | KV_NOT_4 := KV_NOT_3 /= (ROWS_OP[KV_ROW_3] = OP_NOT)
        | KV_ROW_5 := if ROWS_OP[KV_ROW_4] = OP_NOT or ROWS_OP[KV_ROW_4] = OP_COPY or ROWS_OP[KV_ROW_4] = OP_WHEN then ROWS_LEFT[KV_ROW_4] else KV_ROW_4
        | KV_NOT_5 := KV_NOT_4 /= (ROWS_OP[KV_ROW_4] = OP_NOT)
        | KV_ROW_6 := if ROWS_OP[KV_ROW_5] = OP_NOT or ROWS_OP[KV_ROW_5] = OP_COPY or ROWS_OP[KV_ROW_5] = OP_WHEN then ROWS_LEFT[KV_ROW_5] else KV_ROW_5
        | KV_NOT_6 := KV_NOT_5 /= (ROWS_OP[KV_ROW_5] = OP_NOT)
        | KV_ROW_7 := if ROWS_OP[KV_ROW_6] = OP_NOT or ROWS_OP[KV_ROW_6] = OP_COPY or ROWS_OP[KV_ROW_6] = OP_WHEN then ROWS_LEFT[KV_ROW_6] else KV_ROW_6
        | KV_NOT_7 := KV_NOT_6 /= (ROWS_OP[KV_ROW_6] = OP_NOT)
        | KV_ROW_8 := if ROWS_OP[KV_ROW_7] = OP_NOT or ROWS_OP[KV_ROW_7] = OP_COPY or ROWS_OP[KV_ROW_7] = OP_WHEN then ROWS_LEFT[KV_ROW_7] else KV_ROW_7
        | KV_NOT_8 := KV_NOT_7 /= (ROWS_OP[KV_ROW_7] = OP_NOT)
        | KV_ROW := KV_ROW_8
        | KV_NEGATED := KV_NOT_8
        | KH_VALUE_OP := ROWS_OP[KV_ROW]
        | KH_COMPOUND := AT_KS_CHECKS and ROWS_TYPE[KV_ROW] = BUILTIN_BOOLEAN
                         and (KH_VALUE_OP = OP_AND or KH_VALUE_OP = OP_OR or KH_VALUE_OP = OP_XOR)
        | KW_ROW_0 := if not KH_COMPOUND then KV_ROW else if KK = 0 then ROWS_LEFT[KV_ROW] else ROWS_RIGHT[KV_ROW]
        | KW_NOT_0 := false
        | KW_ROW_1 := if ROWS_OP[KW_ROW_0] = OP_NOT or ROWS_OP[KW_ROW_0] = OP_COPY or ROWS_OP[KW_ROW_0] = OP_WHEN then ROWS_LEFT[KW_ROW_0] else KW_ROW_0
        | KW_NOT_1 := KW_NOT_0 /= (ROWS_OP[KW_ROW_0] = OP_NOT)
        | KW_ROW_2 := if ROWS_OP[KW_ROW_1] = OP_NOT or ROWS_OP[KW_ROW_1] = OP_COPY or ROWS_OP[KW_ROW_1] = OP_WHEN then ROWS_LEFT[KW_ROW_1] else KW_ROW_1
        | KW_NOT_2 := KW_NOT_1 /= (ROWS_OP[KW_ROW_1] = OP_NOT)
        | KW_ROW_3 := if ROWS_OP[KW_ROW_2] = OP_NOT or ROWS_OP[KW_ROW_2] = OP_COPY or ROWS_OP[KW_ROW_2] = OP_WHEN then ROWS_LEFT[KW_ROW_2] else KW_ROW_2
        | KW_NOT_3 := KW_NOT_2 /= (ROWS_OP[KW_ROW_2] = OP_NOT)
        | KW_ROW_4 := if ROWS_OP[KW_ROW_3] = OP_NOT or ROWS_OP[KW_ROW_3] = OP_COPY or ROWS_OP[KW_ROW_3] = OP_WHEN then ROWS_LEFT[KW_ROW_3] else KW_ROW_3
        | KW_NOT_4 := KW_NOT_3 /= (ROWS_OP[KW_ROW_3] = OP_NOT)
        | KW_ROW_5 := if ROWS_OP[KW_ROW_4] = OP_NOT or ROWS_OP[KW_ROW_4] = OP_COPY or ROWS_OP[KW_ROW_4] = OP_WHEN then ROWS_LEFT[KW_ROW_4] else KW_ROW_4
        | KW_NOT_5 := KW_NOT_4 /= (ROWS_OP[KW_ROW_4] = OP_NOT)
        | KW_ROW_6 := if ROWS_OP[KW_ROW_5] = OP_NOT or ROWS_OP[KW_ROW_5] = OP_COPY or ROWS_OP[KW_ROW_5] = OP_WHEN then ROWS_LEFT[KW_ROW_5] else KW_ROW_5
        | KW_NOT_6 := KW_NOT_5 /= (ROWS_OP[KW_ROW_5] = OP_NOT)
        | KW_ROW_7 := if ROWS_OP[KW_ROW_6] = OP_NOT or ROWS_OP[KW_ROW_6] = OP_COPY or ROWS_OP[KW_ROW_6] = OP_WHEN then ROWS_LEFT[KW_ROW_6] else KW_ROW_6
        | KW_NOT_7 := KW_NOT_6 /= (ROWS_OP[KW_ROW_6] = OP_NOT)
        | KW_ROW_8 := if ROWS_OP[KW_ROW_7] = OP_NOT or ROWS_OP[KW_ROW_7] = OP_COPY or ROWS_OP[KW_ROW_7] = OP_WHEN then ROWS_LEFT[KW_ROW_7] else KW_ROW_7
        | KW_NOT_8 := KW_NOT_7 /= (ROWS_OP[KW_ROW_7] = OP_NOT)
        | VAR_ROW := if AT_KS_CHECKS then KW_ROW_8 else KV_ROW
        | KV_KNOWN := VAR_OF_ROW[?][VAR_ROW] - 1
        | KH_EVENT := ROWS_TYPE[OB_SMALL[?][KH_O]] = BUILTIN_EVENT
        | KG_CONDITION_VARIABLE := KG_STEPS and KG_CONDITION and ROWS_TYPE[KG_MEMBER] = BUILTIN_BOOLEAN
        | KV_ALLOCATES := (KD_FORMS and KD_SAMPLE or KH_LITERAL and not KH_EVENT or KG_CONDITION_VARIABLE) and KV_KNOWN < 0
        | KV_VAR := if KV_KNOWN >= 0 then KV_KNOWN else K_VARS_NOW
        | VAR_OF_ROW := VAR_OF_ROW[?] next (if KV_ALLOCATES then VAR_ROW else -1) : K_VARS_NOW + 1
        | KD_COMBINES := KD_ACTS and KK = 1 and not KD_SAMPLE
        | KD_DECIDES := KD_ACTS and (if KD_SAMPLE then KK = 1 else KK = 2)
        | KD_F := CK_RESULT[?]
        | DEFINED_BDD := DEFINED_BDD[?] next (if KD_DECIDES then DEF_TARGET[?][KD_DEF] else -1) : KD_F + 1
        | KD_COMMON := CK_COMMON[?]
        | KD_PLACED := KD_TARGET_KIND /= CLK_NONE
        | KD_CONFLICT := KD_DECIDES and KD_PLACED and KD_F /= CLOCK_BDD[?][KD_T] or KD_NULL_SETTLES and CLOCK_BDD[?][KD_T] /= 0
        | KD_TWO_DEFINITIONS := KD_CONFLICT and FLAT_ASSUMPTIONS = 0
        | KD_DEFERS := KD_CONFLICT and FLAT_ASSUMPTIONS > 0
        | KD_ALIAS := if KD_SAMPLE then -1
                   else if KD_PRODUCT then (if KD_COMMON = KD_L then KD_R else if KD_COMMON = KD_R then KD_L else -1)
                   else if KD_COMMON = KD_L then KD_L else if KD_COMMON = KD_R then KD_R else -1
        | KD_ALIASES := KD_DECIDES and not KD_PLACED and KD_ALIAS >= 0
        | KD_CREATES := KD_DECIDES and not KD_PLACED and KD_ALIAS < 0
        | KD_PARENT := if KD_SAMPLE then KD_L else if KD_PRODUCT then (if NODE_DEPTH[?][KD_R] > NODE_DEPTH[?][KD_L] then KD_R else KD_L)
                     else KD_COMMON
        | KD_NODE_LEFT := if KD_SAMPLE then DEF_LEFT[?][KD_DEF] else KD_L
        | KD_NODE_RIGHT := if KD_SAMPLE then -1 else KD_R
        | KD_DONE := KD_HITS or KD_EQUAL or KD_DECIDES and not KD_TWO_DEFINITIONS or KD_NULL_SETTLES and not KD_TWO_DEFINITIONS
        | KV_LIVE := AT_KS_WAIT and KC < GUARDED_COUNT[?]
        | KV_WAITS := KV_LIVE and NODE_KIND[?][KF1] = CLK_NONE
        | K_CLOCKS_NOW := ROW_COUNT + K_SAMPLES_NOW
        | K_STALLED_NOW := CK_STALLED[?]
        | KH_LIVE := AT_KS_CHECKS and KC < K_CLOCKS_NOW + (if K_STALLED_NOW then 0 else 2 * K_OBS_NOW)
        | KH_STALL_ENDS := AT_KS_CHECKS and K_STALLED_NOW and not KH_LIVE
        | KH_CLOCK := KH_LIVE and KC < K_CLOCKS_NOW
        | KH_SECOND := KC >= K_CLOCKS_NOW + K_OBS_NOW
        | KH_O := KC - K_CLOCKS_NOW - (if KH_SECOND then K_OBS_NOW else 0)
        | KH_KIND := OB_KIND[?][KH_O]
        | KH_ASSUMED := OB_ASSUMED[?][KH_O]
        | KH_ACTS := KH_LIVE and not KH_CLOCK and KH_ASSUMED /= KH_SECOND
        | KH_UNDEFINED := KH_CLOCK and NODE_KIND[?][KF1] = CLK_NONE and TSTAMP[?][KF1] /= KRN and CGSTAMP[?][KF1] /= KRN
                        and not (CLASS_HAS_SOURCE[?][KF1_ROOT] or ROW_SOURCE[KF1_ROOT])
        | KH_READ_ROW := if KC < ROW_COUNT and ROWS_OP[KC] = OP_COPY and ROWS_LEFT[KC] >= 0 then ROWS_LEFT[KC]
                         else if KC < ROW_COUNT then KC else 0
        | KH_STATE_READ := ROWS_STATE_READ[KH_READ_ROW]
        | KH_STATE_CONTEXT := KH_UNDEFINED and KH_STATE_READ > 0
        | KH_VALUE_STEPS := if KH_KIND = OB_BOOLEAN then 3 else if KH_KIND = OB_TICK then TICK_COUNT[?] else 0
        | KH_LITERAL := KH_ACTS and KK < 2 and KH_KIND = OB_BOOLEAN
        | KH_JOINS := KH_ACTS and KK = 2 and KH_KIND = OB_BOOLEAN
        | KH_GATHERS := KH_ACTS and KK < KH_VALUE_STEPS and KH_KIND = OB_TICK
        | KH_GATHERED := ROWS_GUARD[TICK_ROW[?][KK]] = OB_SMALL[?][KH_O]
        | KH_OPENS := KH_ACTS and KK = KH_VALUE_STEPS
        | KH_SMALL_ROOT := NODE_ROOT1[?][KF1] - 1
        | KH_BIG_ROOT := NODE_ROOT1[?][KF2] - 1
        | KH_FITS_NO_TREE := KH_OPENS and KH_KIND = OB_INSIDE and KH_SMALL_ROOT /= KH_BIG_ROOT
        | KH_FORMS := KH_OPENS and not KH_FITS_NO_TREE
        | KH_CARES := KH_ACTS and KK = KH_VALUE_STEPS + 1
        | KH_DECIDES := KH_ACTS and KK = KH_VALUE_STEPS + 2
        | KH_SMALL_DEFINED := DEFINED_BDD[?][if ROWS_OP[OB_SMALL[?][KH_O]] = OP_COPY then ROWS_LEFT[OB_SMALL[?][KH_O]] else OB_SMALL[?][KH_O]]
        | KH_BIG_DEFINED := DEFINED_BDD[?][if ROWS_OP[OB_BIG[?][KH_O]] = OP_COPY then ROWS_LEFT[OB_BIG[?][KH_O]] else OB_BIG[?][KH_O]]
        | KH_BDD_SMALL := if KH_ASSUMED and KH_SMALL_DEFINED > 0 then KH_SMALL_DEFINED - 1 else CLOCK_BDD[?][KF1]
        | KH_BDD_BIG := if OB_BIG[?][KH_O] < 0 then OB_BDD[?][KH_O]
                        else if KH_ASSUMED and KH_BIG_DEFINED > 0 then KH_BIG_DEFINED - 1 else CLOCK_BDD[?][KF2]
        | KH_REVERSED := KH_KIND = OB_GT
        | KH_PARTIAL_OF := OB_PARTIAL_OF[?][KH_O]
        | KH_PARTIAL_BIG := KH_KIND = OB_INSIDE and KH_PARTIAL_OF > 0
        | KH_FAILS := KH_DECIDES and not KH_ASSUMED and CK_RESULT[?] /= 0
        | KH_MESSAGE := if KH_KIND = OB_LT then T_RELATION_LT else if KH_KIND = OB_GT then T_RELATION_GT
                        else if KH_KIND = OB_SHARP then T_RELATION_SHARP else if KH_KIND = OB_PARTIAL then T_PARTIAL_OVERLAP
                        else if KH_KIND = OB_EQUAL then T_TWO_DEFINITIONS
                        else if KH_KIND = OB_TICK then T_GUARD_TICK else if KH_KIND = OB_IDENTITY then T_IDENTITY_CLOCKS
                        else if KH_PARTIAL_BIG then T_PARTIAL_INSIDE else T_NOT_INSIDE
        | K_VARS_NOW := K_VAR_COUNT[?]
        | K_JOB_STARTS := KD_FORMS or KD_COMBINES or KH_LITERAL or KH_JOINS or KH_GATHERS or KH_FORMS or KH_CARES
        | K_JOB_KIND := if KD_MEASURES then JOB_WALK
                        else if KH_LITERAL then JOB_XOR else if KH_GATHERS then JOB_OR
                        else if KH_JOINS then
                          (if not KH_COMPOUND or KH_VALUE_OP = OP_AND then JOB_AND else if KH_VALUE_OP = OP_OR then JOB_OR else JOB_XOR)
                           else if KH_FORMS then
                          (if KH_KIND = OB_SHARP or KH_KIND = OB_PARTIAL or KH_KIND = OB_BOOLEAN and KV_NEGATED then JOB_AND
                           else if KH_KIND = OB_EQUAL or KH_KIND = OB_IDENTITY then JOB_XOR else JOB_ANDNOT)
                        else if KH_CARES then (if KH_ASSUMED then JOB_ANDNOT else JOB_AND)
                        else if KD_KIND = CLK_SUM then JOB_OR else if KD_SAMPLE and KV_NEGATED then JOB_ANDNOT else JOB_AND
        | K_JOB_F := if KD_MEASURES then KD_L else if KH_LITERAL then (if KH_EVENT then 1 else 2 + KV_VAR)
                     else if KH_JOINS then CK_TEMP[?] else if KH_GATHERS then (if KK = 0 then 0 else CK_RESULT[?])
                     else if KH_FORMS then (if KH_REVERSED then KH_BDD_BIG else KH_BDD_SMALL)
                     else if KH_CARES then (if KH_ASSUMED then CK_CARE[?] else CK_RESULT[?]) else KD_BDD_L
        | K_JOB_G := if KD_MEASURES then KD_R
                     else if KH_LITERAL then integer(KW_NOT_8) else if KH_JOINS then CK_RESULT[?]
                     else if KH_GATHERS then (if KH_GATHERED then CLOCK_BDD[?][KF2] else 0)
                     else if KH_FORMS then
                       (if KH_KIND = OB_BOOLEAN or KH_KIND = OB_TICK then CK_RESULT[?] else if KH_REVERSED then KH_BDD_SMALL else KH_BDD_BIG)
                     else if KH_CARES then (if KH_ASSUMED then CK_RESULT[?] else CK_CARE[?])
                     else if KD_SAMPLE then 2 + KV_VAR else KD_BDD_R
        | K_VAR_COUNT := K_VARS_NOW + integer(KS_ROOTS or KV_ALLOCATES)
        | KA_JOB := CK_JOB[?]
        | KA_F := CK_F[?]
        | KA_G := CK_G[?]
        | KA_DEPTH := CK_DEPTH[?]
        | KA_RESULT := CK_RESULT[?]
        | KA_RETURNING := AT_KS_APPLY and CK_RETURNING[?]
        | KA_EVALUATES := AT_KS_APPLY and not CK_RETURNING[?]
        | KA_WALKS := KA_EVALUATES and KA_JOB = JOB_WALK
        | KA_COMBINES := KA_EVALUATES and KA_JOB /= JOB_WALK
        | KA_MEETS := KA_WALKS and KA_F = KA_G
        | KA_F_DEPTH := NODE_DEPTH[?][KA_F]
        | KA_G_DEPTH := NODE_DEPTH[?][KA_G]
        | KA_AND := KA_JOB = JOB_AND
        | KA_OR := KA_JOB = JOB_OR
        | KA_ANDNOT := KA_JOB = JOB_ANDNOT
        | KA_XOR := KA_JOB = JOB_XOR
        | KA_ZERO := KA_AND and (KA_F = 0 or KA_G = 0) or KA_ANDNOT and (KA_F = 0 or KA_G = 1 or KA_F = KA_G) or KA_XOR and KA_F = KA_G
        | KA_ONE := KA_OR and (KA_F = 1 or KA_G = 1)
        | KA_TAKES_G := (KA_AND and KA_F = 1 or KA_OR and KA_F = 0 or KA_XOR and KA_F = 0)
        | KA_TAKES_F := KA_AND and (KA_G = 1 or KA_F = KA_G) or KA_OR and (KA_G = 0 or KA_F = KA_G) or (KA_ANDNOT or KA_XOR) and KA_G = 0
        | KA_TERMINAL := KA_ZERO or KA_ONE or KA_TAKES_G or KA_TAKES_F
        | KA_TERMINAL_VALUE := if KA_ZERO then 0 else if KA_ONE then 1 else if KA_TAKES_G then KA_G else KA_F
        | KA_SETTLES := KA_COMBINES and KA_TERMINAL
        | KA_PUSHES := KA_COMBINES and not KA_TERMINAL
        | KA_F_INTERIOR := KA_F - BDD_INTERIOR
        | KA_G_INTERIOR := KA_G - BDD_INTERIOR
        | KA_F_VAR := if KA_F < 2 then CLOCK_CAP else if KA_F_INTERIOR < 0 then KA_F - 2 else BDD_VAR[?][KA_F_INTERIOR]
        | KA_G_VAR := if KA_G < 2 then CLOCK_CAP else if KA_G_INTERIOR < 0 then KA_G - 2 else BDD_VAR[?][KA_G_INTERIOR]
        | KA_V := if KA_F_VAR <= KA_G_VAR then KA_F_VAR else KA_G_VAR
        | KA_F_LOW := if KA_F_VAR /= KA_V then KA_F else if KA_F_INTERIOR < 0 then 0 else BDD_LOW[?][KA_F_INTERIOR]
        | KA_G_LOW := if KA_G_VAR /= KA_V then KA_G else if KA_G_INTERIOR < 0 then 0 else BDD_LOW[?][KA_G_INTERIOR]
        | KA_P := KA_DEPTH - 1
        | KA_SAVED_F := FR_F[?][KA_P]
        | KA_SAVED_G := FR_G[?][KA_P]
        | KA_SAVED_V := FR_VAR[?][KA_P]
        | KA_SAVED_STAGE := FR_STAGE[?][KA_P]
        | KA_FINISHES := KA_RETURNING and KA_DEPTH = 0
        | KA_RESUMES := KA_RETURNING and KA_DEPTH > 0 and KA_SAVED_STAGE = 1
        | KA_MAKES := KA_RETURNING and KA_DEPTH > 0 and KA_SAVED_STAGE = 2
        | KA_SAVED_F_INTERIOR := KA_SAVED_F - BDD_INTERIOR
        | KA_SAVED_G_INTERIOR := KA_SAVED_G - BDD_INTERIOR
        | KA_SAVED_F_VAR := if KA_SAVED_F < 2 then CLOCK_CAP else if KA_SAVED_F_INTERIOR < 0 then KA_SAVED_F - 2
                           else BDD_VAR[?][KA_SAVED_F_INTERIOR]
        | KA_SAVED_G_VAR := if KA_SAVED_G < 2 then CLOCK_CAP else if KA_SAVED_G_INTERIOR < 0 then KA_SAVED_G - 2
                           else BDD_VAR[?][KA_SAVED_G_INTERIOR]
        | KA_SAVED_F_HIGH := if KA_SAVED_F_VAR /= KA_SAVED_V then KA_SAVED_F
                           else if KA_SAVED_F_INTERIOR < 0 then 1 else BDD_HIGH[?][KA_SAVED_F_INTERIOR]
        | KA_SAVED_G_HIGH := if KA_SAVED_G_VAR /= KA_SAVED_V then KA_SAVED_G
                           else if KA_SAVED_G_INTERIOR < 0 then 1 else BDD_HIGH[?][KA_SAVED_G_INTERIOR]
        | KB_LOW := FR_LOW[?][KA_P]
        | KB_HIGH := KA_RESULT
        | KB_EQUAL := KB_LOW = KB_HIGH
        | KB_VARIABLE := KB_LOW = 0 and KB_HIGH = 1
        | KB_HASH := integer((ulong(KA_SAVED_V) * HASH_K1 + ulong(long(KB_LOW) * long(BDD_LIMIT) + long(KB_HIGH)) * HASH_K2) shr HASH_SHIFT)
        | KB_N0 := BDD_HEAD[?][KB_HASH] - 1
        | KB_M0 := KB_N0 >= 0 and BDD_VAR[?][KB_N0] = KA_SAVED_V and BDD_LOW[?][KB_N0] = KB_LOW and BDD_HIGH[?][KB_N0] = KB_HIGH
        | KB_N1 := if KB_N0 >= 0 then BDD_NEXT[?][KB_N0] - 1 else -1
        | KB_M1 := KB_N1 >= 0 and BDD_VAR[?][KB_N1] = KA_SAVED_V and BDD_LOW[?][KB_N1] = KB_LOW and BDD_HIGH[?][KB_N1] = KB_HIGH
        | KB_N2 := if KB_N1 >= 0 then BDD_NEXT[?][KB_N1] - 1 else -1
        | KB_M2 := KB_N2 >= 0 and BDD_VAR[?][KB_N2] = KA_SAVED_V and BDD_LOW[?][KB_N2] = KB_LOW and BDD_HIGH[?][KB_N2] = KB_HIGH
        | KB_N3 := if KB_N2 >= 0 then BDD_NEXT[?][KB_N2] - 1 else -1
        | KB_M3 := KB_N3 >= 0 and BDD_VAR[?][KB_N3] = KA_SAVED_V and BDD_LOW[?][KB_N3] = KB_LOW and BDD_HIGH[?][KB_N3] = KB_HIGH
        | KB_N4 := if KB_N3 >= 0 then BDD_NEXT[?][KB_N3] - 1 else -1
        | KB_M4 := KB_N4 >= 0 and BDD_VAR[?][KB_N4] = KA_SAVED_V and BDD_LOW[?][KB_N4] = KB_LOW and BDD_HIGH[?][KB_N4] = KB_HIGH
        | KB_N5 := if KB_N4 >= 0 then BDD_NEXT[?][KB_N4] - 1 else -1
        | KB_M5 := KB_N5 >= 0 and BDD_VAR[?][KB_N5] = KA_SAVED_V and BDD_LOW[?][KB_N5] = KB_LOW and BDD_HIGH[?][KB_N5] = KB_HIGH
        | KB_N6 := if KB_N5 >= 0 then BDD_NEXT[?][KB_N5] - 1 else -1
        | KB_M6 := KB_N6 >= 0 and BDD_VAR[?][KB_N6] = KA_SAVED_V and BDD_LOW[?][KB_N6] = KB_LOW and BDD_HIGH[?][KB_N6] = KB_HIGH
        | KB_N7 := if KB_N6 >= 0 then BDD_NEXT[?][KB_N6] - 1 else -1
        | KB_M7 := KB_N7 >= 0 and BDD_VAR[?][KB_N7] = KA_SAVED_V and BDD_LOW[?][KB_N7] = KB_LOW and BDD_HIGH[?][KB_N7] = KB_HIGH
        | KB_SLOT := if KB_M0 then KB_N0 else if KB_M1 then KB_N1 else if KB_M2 then KB_N2 else if KB_M3 then KB_N3
                     else if KB_M4 then KB_N4 else if KB_M5 then KB_N5 else if KB_M6 then KB_N6 else if KB_M7 then KB_N7 else -1
        | KB_FOUND := KB_SLOT >= 0
        | KB_LOOKS := KA_MAKES and not KB_EQUAL and not KB_VARIABLE
        | KB_UNSURE := not KB_FOUND and KB_N7 >= 0 and BDD_NEXT[?][KB_N7] > 0
        | KB_NEW := BDD_COUNT[?]
        | KB_FULL := KB_LOOKS and not KB_FOUND and (KB_UNSURE or KB_NEW >= BDD_NODE_CAP)
        | KB_INSERTS := KB_LOOKS and not KB_FOUND and not KB_FULL
        | KB_NODE := if KB_EQUAL then KB_LOW else if KB_VARIABLE then 2 + KA_SAVED_V
                     else if KB_FOUND then BDD_INTERIOR + KB_SLOT else BDD_INTERIOR + KB_NEW
        | KB_INSERT_SLOT := if KB_INSERTS then KB_NEW else -1
        | BDD_VAR := BDD_VAR[?] next KB_INSERT_SLOT : KA_SAVED_V
        | BDD_LOW := BDD_LOW[?] next KB_INSERT_SLOT : KB_LOW
        | BDD_HIGH := BDD_HIGH[?] next KB_INSERT_SLOT : KB_HIGH
        | BDD_NEXT := BDD_NEXT[?] next KB_INSERT_SLOT : KB_N0 + 1
        | BDD_HEAD := BDD_HEAD[?] next (if KB_INSERTS then KB_HASH else -1) : KB_NEW + 1
        | BDD_COUNT := KB_NEW + integer(KB_INSERTS)
        | KA_FRAME_FULL := KA_PUSHES and KA_DEPTH >= BDD_FRAME_CAP
        | KA_PUSH_SLOT := if KA_PUSHES and not KA_FRAME_FULL then KA_DEPTH else -1
        | FR_F := FR_F[?] next KA_PUSH_SLOT : KA_F
        | FR_G := FR_G[?] next KA_PUSH_SLOT : KA_G
        | FR_VAR := FR_VAR[?] next KA_PUSH_SLOT : KA_V
        | FR_STAGE := FR_STAGE[?] next (if KA_PUSH_SLOT >= 0 then KA_PUSH_SLOT else if KA_RESUMES then KA_P else -1)
                    : (if KA_RESUMES then 2 else 1)
        | FR_LOW := FR_LOW[?] next (if KA_RESUMES then KA_P else -1) : KA_RESULT
        | KA_OVER_BUDGET := AT_KS_APPLY and CK_APPLY_STEPS[?] >= BD_BUDGET
        | CK_JOB := if K_JOB_STARTS then K_JOB_KIND else KA_JOB
        | CK_F := if K_JOB_STARTS then K_JOB_F else if KA_PUSHES then KA_F_LOW else if KA_RESUMES then KA_SAVED_F_HIGH
                  else if KA_WALKS and not KA_MEETS and KA_F_DEPTH >= KA_G_DEPTH then NODE_PARENT1[?][KA_F] - 1 else KA_F
        | CK_G := if K_JOB_STARTS then K_JOB_G else if KA_PUSHES then KA_G_LOW else if KA_RESUMES then KA_SAVED_G_HIGH
                  else if KA_WALKS and not KA_MEETS and KA_G_DEPTH >= KA_F_DEPTH then NODE_PARENT1[?][KA_G] - 1 else KA_G
        | CK_RETURNING := if K_JOB_STARTS or KA_RESUMES then false else if KA_SETTLES or KA_MEETS then true else CK_RETURNING[?]
        | CK_RESULT := if KA_SETTLES then KA_TERMINAL_VALUE else if KA_MEETS then KA_F else if KA_MAKES then KB_NODE else KA_RESULT
        | CK_DEPTH := if K_JOB_STARTS then 0 else KA_DEPTH + integer(KA_PUSHES) - integer(KA_MAKES)
        | CK_APPLY_STEPS := CK_APPLY_STEPS[?] + long(integer(AT_KS_APPLY))
        | CK_COMMON := if KD_COMBINES then CK_RESULT[?] else CK_COMMON[?]
        | CK_RESUME := if K_JOB_STARTS then KS_NOW else CK_RESUME[?]
        | CK_JOB_TOKEN := if not K_JOB_STARTS then CK_JOB_TOKEN[?] else if AT_KS_CHECKS then OB_TOKEN[?][KH_O] else DEF_TOKEN[?][KD_DEF]
        | KF1_SOURCE := if AT_KS_ROWS then KC else if AT_KS_GROUPS then KG_HEAD
                     else if AT_KS_REWRITE then (if KW_BOTH_CTX then KW_MERGED else KW_V0)
                     else if AT_KS_TARGETS or AT_KS_DEFS then DEF_TARGET[?][K_LISTED_DEF]
                     else if AT_KS_GUARDS or AT_KS_WAIT then GUARDED[?][KC]
                     else if AT_KS_CHECKS then (if KH_CLOCK then KC else OB_SMALL[?][KH_O])
                     else KS_CLOCK
        | KF2_SOURCE := if AT_KS_ROWS then KR_X else if AT_KS_GROUPS then KG_MEMBER
                     else if AT_KS_REWRITE then (if KW_BOTH_CTX then KW_CONDITION else KW_V1)
                     else if AT_KS_DEFS then DEF_LEFT[?][KD_DEF]
                     else if AT_KS_CHECKS then
                       (if KH_GATHERS then TICK_ROW[?][KK] else if OB_BIG[?][KH_O] < 0 then OB_SMALL[?][KH_O] else OB_BIG[?][KH_O])
                     else KS_GUARD_SOURCE
        | KF3_SOURCE := if KD_SAMPLE then -1 else DEF_RIGHT[?][KD_DEF]
        | KF1_0 := KF1_SOURCE
        | KF1_1 := KF1_0 + CK_LINK[?][KF1_0]
        | KF1_2 := KF1_1 + CK_LINK[?][KF1_1]
        | KF1_3 := KF1_2 + CK_LINK[?][KF1_2]
        | KF1_4 := KF1_3 + CK_LINK[?][KF1_3]
        | KF1_5 := KF1_4 + CK_LINK[?][KF1_4]
        | KF1_6 := KF1_5 + CK_LINK[?][KF1_5]
        | KF1_7 := KF1_6 + CK_LINK[?][KF1_6]
        | KF1_8 := KF1_7 + CK_LINK[?][KF1_7]
        | KF1_9 := KF1_8 + CK_LINK[?][KF1_8]
        | KF1_10 := KF1_9 + CK_LINK[?][KF1_9]
        | KF1_11 := KF1_10 + CK_LINK[?][KF1_10]
        | KF1_12 := KF1_11 + CK_LINK[?][KF1_11]
        | KF1_13 := KF1_12 + CK_LINK[?][KF1_12]
        | KF1_14 := KF1_13 + CK_LINK[?][KF1_13]
        | KF1_15 := KF1_14 + CK_LINK[?][KF1_14]
        | KF1_16 := KF1_15 + CK_LINK[?][KF1_15]
        | KF1_17 := KF1_16 + CK_LINK[?][KF1_16]
        | KF1_18 := KF1_17 + CK_LINK[?][KF1_17]
        | KF1_19 := KF1_18 + CK_LINK[?][KF1_18]
        | KF1_20 := KF1_19 + CK_LINK[?][KF1_19]
        | KF1_ROOT := KF1_20
        | KF1 := KF1_ROOT + CK_OFFICIAL[?][KF1_ROOT]
        | KF2_0 := KF2_SOURCE
        | KF2_1 := KF2_0 + CK_LINK[?][KF2_0]
        | KF2_2 := KF2_1 + CK_LINK[?][KF2_1]
        | KF2_3 := KF2_2 + CK_LINK[?][KF2_2]
        | KF2_4 := KF2_3 + CK_LINK[?][KF2_3]
        | KF2_5 := KF2_4 + CK_LINK[?][KF2_4]
        | KF2_6 := KF2_5 + CK_LINK[?][KF2_5]
        | KF2_7 := KF2_6 + CK_LINK[?][KF2_6]
        | KF2_8 := KF2_7 + CK_LINK[?][KF2_7]
        | KF2_9 := KF2_8 + CK_LINK[?][KF2_8]
        | KF2_10 := KF2_9 + CK_LINK[?][KF2_9]
        | KF2_11 := KF2_10 + CK_LINK[?][KF2_10]
        | KF2_12 := KF2_11 + CK_LINK[?][KF2_11]
        | KF2_13 := KF2_12 + CK_LINK[?][KF2_12]
        | KF2_14 := KF2_13 + CK_LINK[?][KF2_13]
        | KF2_15 := KF2_14 + CK_LINK[?][KF2_14]
        | KF2_16 := KF2_15 + CK_LINK[?][KF2_15]
        | KF2_17 := KF2_16 + CK_LINK[?][KF2_16]
        | KF2_18 := KF2_17 + CK_LINK[?][KF2_17]
        | KF2_19 := KF2_18 + CK_LINK[?][KF2_18]
        | KF2_20 := KF2_19 + CK_LINK[?][KF2_19]
        | KF2_ROOT := KF2_20
        | KF2 := KF2_ROOT + CK_OFFICIAL[?][KF2_ROOT]
        | KF3_0 := KF3_SOURCE
        | KF3_1 := KF3_0 + CK_LINK[?][KF3_0]
        | KF3_2 := KF3_1 + CK_LINK[?][KF3_1]
        | KF3_3 := KF3_2 + CK_LINK[?][KF3_2]
        | KF3_4 := KF3_3 + CK_LINK[?][KF3_3]
        | KF3_5 := KF3_4 + CK_LINK[?][KF3_4]
        | KF3_6 := KF3_5 + CK_LINK[?][KF3_5]
        | KF3_7 := KF3_6 + CK_LINK[?][KF3_6]
        | KF3_8 := KF3_7 + CK_LINK[?][KF3_7]
        | KF3_9 := KF3_8 + CK_LINK[?][KF3_8]
        | KF3_10 := KF3_9 + CK_LINK[?][KF3_9]
        | KF3_11 := KF3_10 + CK_LINK[?][KF3_10]
        | KF3_12 := KF3_11 + CK_LINK[?][KF3_11]
        | KF3_13 := KF3_12 + CK_LINK[?][KF3_12]
        | KF3_14 := KF3_13 + CK_LINK[?][KF3_13]
        | KF3_15 := KF3_14 + CK_LINK[?][KF3_14]
        | KF3_16 := KF3_15 + CK_LINK[?][KF3_15]
        | KF3_17 := KF3_16 + CK_LINK[?][KF3_16]
        | KF3_18 := KF3_17 + CK_LINK[?][KF3_17]
        | KF3_19 := KF3_18 + CK_LINK[?][KF3_18]
        | KF3_20 := KF3_19 + CK_LINK[?][KF3_19]
        | KF3_ROOT := KF3_20
        | KF3 := KF3_ROOT + CK_OFFICIAL[?][KF3_ROOT]
        | KN_ALIAS_ROOT := if KD_ALIAS = KD_L then KF2_ROOT else KF3_ROOT
        | KN_UNITES := KR_UNITES or KG_UNITES or KW_UNITES or KS_ATTACHES or KD_EQUAL or KD_ALIASES
        | KN_A := KF1_ROOT
        | KN_B := if KD_ALIASES then KN_ALIAS_ROOT else KF2_ROOT
        | KN_OFFICIAL := if KD_ALIASES then KD_ALIAS else KF2
        | KN_LINKS := KN_UNITES and KN_A /= KN_B
        | KN_SIZE_A := CK_SIZE[?][KN_A]
        | KN_SIZE_B := CK_SIZE[?][KN_B]
        | KN_A_ON_TOP := KN_SIZE_A > KN_SIZE_B
        | KN_TOP := if KN_A_ON_TOP then KN_A else KN_B
        | KN_CHILD := if KN_A_ON_TOP then KN_B else KN_A
        | CK_LINK := CK_LINK[?] next (if KN_LINKS then KN_CHILD else -1) : KN_TOP - KN_CHILD
        | CK_SIZE := CK_SIZE[?] next (if KN_LINKS then KN_TOP else -1) : KN_SIZE_A + KN_SIZE_B + 1
        | CK_OFFICIAL := CK_OFFICIAL[?] next (if KN_LINKS then KN_TOP else -1) : KN_OFFICIAL - KN_TOP
        | CLASS_MINIMAL := CLASS_MINIMAL[?] next (if KN_LINKS then KN_TOP else if KG_MARKS_MINIMAL then KF2_ROOT else -1)
                         : KG_MARKS_MINIMAL or CLASS_MINIMAL[?][KN_A] or CLASS_MINIMAL[?][KN_B]
        | MINIMAL_SOLUTION := MINIMAL_SOLUTION[?] next (if KN_LINKS then KN_TOP else if KD_MINIMAL_RECORDS then KF1_ROOT else -1)
                            : (if KD_MINIMAL_RECORDS then KD_MINIMAL_VALUE
                               else if MINIMAL_SOLUTION[?][KN_A] /= 0 then MINIMAL_SOLUTION[?][KN_A] else MINIMAL_SOLUTION[?][KN_B])
        | CLASS_PARTIAL := CLASS_PARTIAL[?] next (if KN_LINKS then KN_TOP else -1)
                         : (if CLASS_PARTIAL[?][KN_A] > 0 then CLASS_PARTIAL[?][KN_A] else if ROW_PARTIAL[KN_A] > 0 then ROW_PARTIAL[KN_A]
                            else if CLASS_PARTIAL[?][KN_B] > 0 then CLASS_PARTIAL[?][KN_B] else ROW_PARTIAL[KN_B])
        | CLASS_HAS_SOURCE := CLASS_HAS_SOURCE[?] next (if KN_LINKS then KN_TOP else -1)
                            : CLASS_HAS_SOURCE[?][KN_A] or ROW_SOURCE[KN_A] or CLASS_HAS_SOURCE[?][KN_B] or ROW_SOURCE[KN_B]
        | SAMPLE_OF := SAMPLE_OF[?] next (if KR_CREATES then KR_CONDITION else -1) : KR_NEW_SAMPLE + 1
        | SAMPLE_ROW := SAMPLE_ROW[?] next (if KR_CREATES then K_SAMPLES_NOW else -1) : KR_CONDITION
        | K_SAMPLE_COUNT := K_SAMPLES_NOW + integer(KR_CREATES)
        | KQ_APPENDS := KR_DEFINES or KM_LIVE or KG_MINIMAL_DEF
        | KQ_DEFS_FULL := KQ_APPENDS and K_DEFS_NOW >= DEF_CAP
        | KQ_SLOT := if KQ_APPENDS and not KQ_DEFS_FULL then K_DEFS_NOW else -1
        | KQ_REWRITE_SLOT := if KQ_SLOT >= 0 then KQ_SLOT else if KW_PRODUCT then KC else -1
        | DEF_KIND := DEF_KIND[?] next KQ_REWRITE_SLOT
                    : (if KG_MINIMAL_DEF then (if KG_KIND = OB_LT then CLK_PRODUCT else CLK_SUM)
                       else if KW_PRODUCT or KR_IS_WHEN and not KM_LIVE then CLK_PRODUCT else if KM_LIVE then CLK_SAMPLE
                       else if KR_NULL and not KW_PRODUCT then CLK_NULL else CLK_SUM)
        | DEF_TARGET := DEF_TARGET[?] next KQ_SLOT : (if KG_MINIMAL_DEF then KG_MEMBER else if KM_LIVE then ROW_COUNT + KC else KC)
        | DEF_MINIMAL_ONLY := DEF_MINIMAL_ONLY[?] next KQ_SLOT : KG_MINIMAL_DEF
        | DEF_LEFT := DEF_LEFT[?] next KQ_REWRITE_SLOT : (if KG_MINIMAL_DEF then KG_MEMBER else if KW_PRODUCT then KW_V0 else if KM_LIVE then KM_CONDITION else KR_LEFT)
        | DEF_RIGHT := DEF_RIGHT[?] next KQ_REWRITE_SLOT
                     : (if KG_MINIMAL_DEF then GROUP_MEMBER_ROW[KG_AT + KG_RIGHT] else if KW_PRODUCT then KW_CONDITION else if KM_LIVE then -1 else if KR_IS_WHEN then KR_SAMPLE else KR_RIGHT)
        | DEF_TOKEN := DEF_TOKEN[?] next KQ_SLOT
                     : (if KG_MINIMAL_DEF then FLAT_GROUP_OPERATOR[KC] else ROWS_TOKEN[if KM_LIVE then KM_CONDITION else KC])
        | DEF_DONE := DEF_DONE[?] next (if KQ_SLOT >= 0 then KQ_SLOT else if KW_UNITES then KC else if KD_DONE then KD_DEF else -1)
                    : KQ_SLOT < 0
        | DEF_COUNT := K_DEFS_NOW + integer(KQ_SLOT >= 0)
        | KO_APPENDS := KR_OBLIGES or KR_TICK_OBLIGES or KD_OBLIGES or KG_OBLIGES or KD_DEFERS or KPD_OBLIGES
        | KO_FULL := KO_APPENDS and K_OBS_NOW >= OB_CAP
        | KO_SLOT := if KO_APPENDS and not KO_FULL then K_OBS_NOW else -1
        | OB_SMALL := OB_SMALL[?] next KO_SLOT
                      : (if KR_OBLIGES then KR_LEFT else if KR_TICK_OBLIGES then ROWS_GUARD[KC] else if KG_OBLIGES then KG_MEMBER
                         else if KPD_OBLIGES then PD_ROW[KPD_I]
                         else if KD_KIND = CLK_SUM and not KD_DEFERS then KD_OTHER else KD_T)
        | OB_BIG := OB_BIG[?] next KO_SLOT
                    : (if KR_OBLIGES then KC else if KR_TICK_OBLIGES then -1 else if KPD_OBLIGES then PD_ROW[KPD_J]
                       else if KG_ASSERT then -1 else if KG_OBLIGES then GROUP_MEMBER_ROW[KG_AT + KG_RIGHT]
                       else if KD_DEFERS then -1 else if KD_KIND = CLK_SUM then KD_T else KD_OTHER)
        | OB_TOKEN := OB_TOKEN[?] next KO_SLOT
                      : (if KR_OBLIGES or KR_TICK_OBLIGES then ROWS_TOKEN[KC] else if KG_OBLIGES then FLAT_GROUP_OPERATOR[KC]
                         else if KPD_OBLIGES then ROWS_TOKEN[PD_ROW[KPD_J]] else DEF_TOKEN[?][KD_DEF])
        | KO_DEF_ROW := DEF_TARGET[?][KD_DEF]
        | KO_DEF_SIGNAL := KO_DEF_ROW >= 0 and KO_DEF_ROW < FLAT_SIGNAL_COUNT
        | KO_PARTIAL_OF := if KO_DEF_ROW < 0 or KO_DEF_ROW >= ROW_COUNT then 0
                           else if ROWS_PARTIAL_OF[KO_DEF_ROW] > 0 then ROWS_PARTIAL_OF[KO_DEF_ROW]
                           else if KO_DEF_SIGNAL and SIGNAL_PARTIAL[if KO_DEF_SIGNAL then KO_DEF_ROW else 0] then KO_DEF_ROW + 1 else 0
        | OB_PARTIAL_OF := OB_PARTIAL_OF[?] next KO_SLOT
                           : (if KR_OBLIGES or KR_TICK_OBLIGES or KG_OBLIGES or KPD_OBLIGES then 0 else KO_PARTIAL_OF)
        | OB_KIND := OB_KIND[?] next KO_SLOT
                     : (if KG_OBLIGES then KG_KIND else if KPD_OBLIGES then OB_PARTIAL else if KD_DEFERS then OB_EQUAL else if KR_TICK_OBLIGES then OB_TICK else OB_INSIDE)
        | GUARD_TICKED := GUARD_TICKED[?] next (if KR_TICK_OBLIGES then ROWS_GUARD[KC] else -1) : true
        | TICK_ROW := TICK_ROW[?] next (if KR_TICK_MEMBER then TICK_COUNT[?] else -1) : KC
        | TICK_COUNT := TICK_COUNT[?] + integer(KR_TICK_MEMBER)
        | OB_ASSUMED := OB_ASSUMED[?] next KO_SLOT : KG_OBLIGES and KG_ASSUMED
        | OB_BDD := OB_BDD[?] next KO_SLOT : (if KPD_OBLIGES then PD_SIGNAL[KPD_I] else if KD_NULL then 0 else KD_F)
        | CK_CARE := if KH_DECIDES and KH_ASSUMED then CK_RESULT[?] else CK_CARE[?]
        | CK_TEMP := if KH_LITERAL and KK = 1 then CK_RESULT[?] else CK_TEMP[?]
        | OB_COUNT := K_OBS_NOW + integer(KO_SLOT >= 0)
        | GUARDED := GUARDED[?] next (if KR_GUARDED then GUARDED_COUNT[?] else -1) : KC
        | GUARDED_COUNT := GUARDED_COUNT[?] + integer(KR_GUARDED)
        | TSTAMP := TSTAMP[?] next (if KT_MARKS then KF1 else -1) : KRN
        | CGSTAMP := CGSTAMP[?] next (if KU_SETS then KF1 else -1) : KRN
        | CGUARD := CGUARD[?] next (if KU_SETS then KF1 else -1) : ROWS_GUARD[KU_ROW]
        | CAND := CAND[?] next (if KS_KEEPS then CK_CAND_W[?] else -1) : KS_CLOCK
        | PEND := PEND[?] next (if KD_WAITS then CK_PEND_W[?] else -1) : KD_DEF
        | KP_SLOT := if KS_ROOTS then KS_CLOCK else if KD_CREATES then KD_T else -1
        | NODE_KIND := NODE_KIND[?] next KP_SLOT : (if KS_ROOTS then CLK_ROOT else KD_KIND)
        | NODE_PARENT1 := NODE_PARENT1[?] next KP_SLOT : (if KS_ROOTS then 0 else KD_PARENT + 1)
        | NODE_DEPTH := NODE_DEPTH[?] next KP_SLOT : (if KS_ROOTS then 0 else NODE_DEPTH[?][KD_PARENT] + 1)
        | NODE_ROOT1 := NODE_ROOT1[?] next KP_SLOT : (if KS_ROOTS then KS_CLOCK + 1 else NODE_ROOT1[?][KD_PARENT])
        | NODE_LEFT1 := NODE_LEFT1[?] next KP_SLOT : (if KS_ROOTS then 0 else KD_NODE_LEFT + 1)
        | NODE_RIGHT1 := NODE_RIGHT1[?] next KP_SLOT : (if KS_ROOTS then 0 else KD_NODE_RIGHT + 1)
        | CLOCK_BDD := CLOCK_BDD[?] next KP_SLOT : (if KS_ROOTS then 2 + K_VARS_NOW else KD_F)
        | K_CAPACITY := if KR_TOO_MANY or KR_CLOCKS_FULL then F_CAP_CLOCKS else if KQ_DEFS_FULL then F_CAP_DEFINITIONS
                     else if KO_FULL then F_CAP_OBLIGATIONS else if KA_OVER_BUDGET or KA_FRAME_FULL or KB_FULL then F_CAP_BDD else 0
        | KD_ENDS_ROUND := AT_KS_DEFS and not KD_LIVE
        | K_PROGRESS_NOW := CK_PROGRESS[?] or KS_ATTACHES or KS_ROOTS or KD_DONE
        | K_STALLS := KD_ENDS_ROUND and not K_PROGRESS_NOW and CK_PEND_W[?] > 0
        | K_MESSAGE_NOW := if KR_NO_CLOCK or KG_NO_CLOCK then T_NO_CLOCK else if KG_NOT_BOOLEAN then (if KG_CONDITION then T_CONDITION_TYPE else T_ASSERT_TYPE)
                        else if KG_NOT_NAME then T_MIN_CLOCK_NAME else if KS_MINIMAL_EMPTY then T_MIN_CLOCK_EMPTY else if KR_DELAY_CONSTANT then T_DELAY_CONSTANT
                        else if K_CAPACITY /= 0 then T_CAPACITY
                        else if KD_NO_CLOCK or KH_NO_CLOCK then T_PARTIAL_NO_CLOCK
                        else if KD_FITS_NO_TREE or KH_FITS_NO_TREE then T_FITS_NO_TREE else if KD_TWO_DEFINITIONS then T_TWO_DEFINITIONS
                        else if KD_MINIMAL_TWO then T_MIN_CLOCK_TWO
                        else if KH_STALL_ENDS then T_CLOCK_CYCLE else if KV_WAITS then T_GUARD_CYCLE
                        else if KH_STATE_CONTEXT then T_STATEVAR_CONTEXT else if KH_UNDEFINED then T_CLOCK_UNDEFINED else if KH_FAILS then KH_MESSAGE else 0
        | K_FAILS := K_MESSAGE_NOW /= 0
        | CK_MESSAGE := if K_FAILS then K_MESSAGE_NOW else CK_MESSAGE[?]
        | CK_TOKEN := if not K_FAILS then CK_TOKEN[?] else if KG_NO_CLOCK then FLAT_GROUP_TOKEN[KC]
                     else if KG_NOT_BOOLEAN or KG_NOT_NAME then FLAT_GROUP_OPERATOR[KC]
                     else if KS_MINIMAL_EMPTY then ROWS_TOKEN[KS_CLOCK]
                     else if KH_STALL_ENDS then DEF_TOKEN[?][PEND[?][0]] else if KD_FITS_NO_TREE or KD_TWO_DEFINITIONS or KD_MINIMAL_TWO then DEF_TOKEN[?][KD_DEF]
                     else if AT_KS_APPLY then CK_JOB_TOKEN[?]
                     else if AT_KS_CHECKS then
                       (if not KH_CLOCK then OB_TOKEN[?][KH_O] else ROWS_TOKEN[if KC >= ROW_COUNT then SAMPLE_ROW[?][KC - ROW_COUNT] else KC])
                     else if AT_KS_ROWS and not KR_TOO_MANY then ROWS_TOKEN[KC] else -1
        | CK_ARGUMENT0 := if not K_FAILS then CK_ARGUMENT0[?] else K_CAPACITY
        | CK_CLOCK0 := if not K_FAILS then CK_CLOCK0[?] else if KD_NO_CLOCK then KD_PARTIAL - 1 else if KH_NO_CLOCK then KH_PARTIAL - 1
                     else if AT_KS_CHECKS and KH_KIND = OB_PARTIAL then OB_BDD[?][KH_O]
                     else if KH_STATE_CONTEXT then KH_STATE_READ - 1
                     else if KH_FITS_NO_TREE or AT_KS_GROUPS then KF2 else if AT_KS_CHECKS then KF1
                     else if AT_KS_SCAN then KS_CLOCK
                     else KD_T
        | CK_CLOCK1 := if not K_FAILS then CK_CLOCK1[?] else if KH_FITS_NO_TREE then KH_SMALL_ROOT
                     else if AT_KS_CHECKS then KF2
                     else KD_ROOT_L
        | CK_CLOCK2 := if not K_FAILS then CK_CLOCK2[?] else if AT_KS_CHECKS and KH_PARTIAL_BIG then KH_PARTIAL_OF - 1
                     else if AT_KS_CHECKS then KH_BIG_ROOT else KD_ROOT_R
        | KX_ROUND_START := AT_KS_REWRITE and not KW_LIVE or KD_ENDS_ROUND and K_PROGRESS_NOW
        | CK_STATE := if K_FAILS then KS_FAILED
                    else if AT_KS_ROWS then (if KR_LIVE then KS_ROWS else KS_SAMPLES)
                    else if AT_KS_SAMPLES then (if KM_LIVE then KS_SAMPLES else KS_GROUPS)
                    else if AT_KS_GROUPS then (if KG_LIVE then KS_GROUPS else KS_REWRITE)
                    else if AT_KS_PAIRS then (if KPD_LIVE then KS_PAIRS else KS_CHECKS)
                    else if AT_KS_REWRITE then (if KW_LIVE then KS_REWRITE else KS_TARGETS)
                    else if AT_KS_TARGETS then (if KT_LIVE then KS_TARGETS else KS_GUARDS)
                    else if AT_KS_GUARDS then (if KU_LIVE then KS_GUARDS else KS_SCAN)
                    else if AT_KS_SCAN then (if KS_LIVE then KS_SCAN else KS_DEFS)
                    else if AT_KS_DEFS then
                      (if K_JOB_STARTS then KS_APPLY else if KD_LIVE then KS_DEFS else if K_PROGRESS_NOW then KS_TARGETS else if K_STALLS then KS_PAIRS else KS_WAIT)
                    else if AT_KS_APPLY then (if KA_FINISHES then CK_RESUME[?] else KS_APPLY)
                    else if AT_KS_WAIT then (if KV_LIVE then KS_WAIT else KS_PAIRS)
                    else if AT_KS_CHECKS then (if K_JOB_STARTS then KS_APPLY else if KH_LIVE then KS_CHECKS else KS_DONE)
                    else KS_NOW
        | K_STEPS_ON := KR_LIVE and not KR_ENDS or KG_LIVE and not KG_ENDS
        | K_HOLDS := K_JOB_STARTS or AT_KS_APPLY
        | CK_SUB := if K_STEPS_ON then KK + 1 else if K_HOLDS then KK + integer(K_JOB_STARTS) else 0
        | CK_CURSOR := if K_HOLDS then KC else if CK_STATE /= KS_NOW then 0 else if K_STEPS_ON then KC else KC + 1
        | CK_ROUND := KRN + integer(KD_ENDS_ROUND and K_PROGRESS_NOW)
        | CK_PROGRESS := not KX_ROUND_START and K_PROGRESS_NOW
        | CK_DEF_LIMIT := if AT_KS_REWRITE and not KW_LIVE then K_DEFS_NOW else if KX_ROUND_START then CK_PEND_W[?] else K_DEF_LIMIT
        | CK_SCAN_LIMIT := if AT_KS_REWRITE and not KW_LIVE then ROW_COUNT + K_SAMPLES_NOW
                         else if KX_ROUND_START then CK_CAND_W[?] else CK_SCAN_LIMIT[?]
        | CK_CAND_W := if AT_KS_GUARDS then 0 else CK_CAND_W[?] + integer(KS_KEEPS)
        | CK_PEND_W := if AT_KS_SCAN then 0 else CK_PEND_W[?] + integer(KD_WAITS)
        | CK_STALLED := K_STALLED_NOW or K_STALLS
        |)
     with (| CK_STATE := KS_ROWS | CK_CURSOR := 0 | CK_SUB := 0 | CK_ROUND := 1 | CK_PROGRESS := false
           | CK_DEF_LIMIT := 0 | CK_SCAN_LIMIT := 0 | CK_CAND_W := 0 | CK_PEND_W := 0 | K_SAMPLE_COUNT := 0
           | DEF_COUNT := 0 | OB_COUNT := 0 | TICK_COUNT := 0 | GUARDED_COUNT := 0 | CK_MESSAGE := 0 | CK_TOKEN := -1
           | CK_ARGUMENT0 := 0 | CK_CLOCK0 := -1 | CK_CLOCK1 := -1 | CK_CLOCK2 := -1 | K_VAR_COUNT := 0 | BDD_COUNT := 0
           | CK_JOB := 0 | CK_F := 0 | CK_G := 0 | CK_RETURNING := false | CK_RESULT := 0 | CK_DEPTH := 0 | CK_APPLY_STEPS := long(0)
           | CK_COMMON := 0 | CK_RESUME := 0 | CK_JOB_TOKEN := -1 | CK_STALLED := false | CK_CARE := 1 | CK_TEMP := 0 |)
     end
   | CK_DONE := CLOCKS_RUN and CK_STATE = KS_DONE
   | CLOCK_TOTAL := ROW_COUNT + K_SAMPLE_COUNT
   | CF_INDEX := 0 .. (if CK_DONE then long(FLAT_SIGNAL_COUNT) + long(CLOCK_TOTAL) - long(1) else long(-1))
   | iterate CF_INDEX of
       (| CF_I := integer(CF_INDEX)
        | CF_SIGNALS := CF_I < FLAT_SIGNAL_COUNT
        | CF_CLOCK := if CF_SIGNALS then CF_I else CF_I - FLAT_SIGNAL_COUNT
        | FF_0 := CF_CLOCK
        | FF_1 := FF_0 + CK_LINK[FF_0]
        | FF_2 := FF_1 + CK_LINK[FF_1]
        | FF_3 := FF_2 + CK_LINK[FF_2]
        | FF_4 := FF_3 + CK_LINK[FF_3]
        | FF_5 := FF_4 + CK_LINK[FF_4]
        | FF_6 := FF_5 + CK_LINK[FF_5]
        | FF_7 := FF_6 + CK_LINK[FF_6]
        | FF_8 := FF_7 + CK_LINK[FF_7]
        | FF_9 := FF_8 + CK_LINK[FF_8]
        | FF_10 := FF_9 + CK_LINK[FF_9]
        | FF_11 := FF_10 + CK_LINK[FF_10]
        | FF_12 := FF_11 + CK_LINK[FF_11]
        | FF_13 := FF_12 + CK_LINK[FF_12]
        | FF_14 := FF_13 + CK_LINK[FF_13]
        | FF_15 := FF_14 + CK_LINK[FF_14]
        | FF_16 := FF_15 + CK_LINK[FF_15]
        | FF_17 := FF_16 + CK_LINK[FF_16]
        | FF_18 := FF_17 + CK_LINK[FF_17]
        | FF_19 := FF_18 + CK_LINK[FF_18]
        | FF_20 := FF_19 + CK_LINK[FF_19]
        | FF_ROOT := FF_20
        | FF := FF_ROOT + CK_OFFICIAL[FF_ROOT]
        | CF_GOING := not CF_FAILED[?]
        | CF_SOURCE := FLAT_SIGNAL_SOURCE[CF_CLOCK]
        | CF_INPUT := CF_SIGNALS and FLAT_SIGNAL_INSTANCE[CF_CLOCK] = 0
                      and (if CF_SOURCE >= 0 then SIGNAL_ROLE[CF_SOURCE] else FINISH_SIGNAL_ROLE[-CF_SOURCE - 1]) = ROLE_INPUT
        | CF_NOT_ROOT := CF_GOING and CF_INPUT and NODE_KIND[FF] /= CLK_ROOT
        | CF_ROOT := if CF_SIGNALS then NODE_ROOT1[FF] - 1 else CF_CLOCK
        | CF_LISTS := CF_GOING and (if CF_SIGNALS then NODE_KIND[FF] /= CLK_NONE else NODE_KIND[CF_CLOCK] = CLK_ROOT)
                 and not ROOT_LISTED[?][CF_ROOT]
        | ROOT_LISTED := ROOT_LISTED[?] next (if CF_LISTS then CF_ROOT else -1) : true
        | ROOT_LIST := ROOT_LIST[?] next (if CF_LISTS then ROOT_COUNT[?] else -1) : CF_ROOT
        | ROOT_COUNT := ROOT_COUNT[?] + integer(CF_LISTS)
        | CLOCK_REP := CLOCK_REP[?] next (if CF_SIGNALS then -1 else CF_CLOCK) : FF
        | CF_ROOT_IRQ1 := if PLATFORM /= PLATFORM_MACOS and CF_INPUT then SIGNAL_IRQ1[CF_SOURCE] else 0
        | CF_SHARED := CF_GOING and CF_ROOT_IRQ1 > 0 and ROOT_IRQ1[?][CF_ROOT] > 0
        | ROOT_IRQ1 := ROOT_IRQ1[?] next (if CF_GOING and CF_ROOT_IRQ1 > 0 then CF_ROOT else -1) : CF_ROOT_IRQ1
        | ROOT_INPUT1 := ROOT_INPUT1[?] next (if CF_GOING and CF_ROOT_IRQ1 > 0 then CF_ROOT else -1) : CF_CLOCK + 1
        | CF_PARTNER := if CF_SHARED then ROOT_INPUT1[?][CF_ROOT] - 1 else CF_PARTNER[?]
        | CF_SHARED_ROOT := CF_SHARED_ROOT[?] or CF_SHARED
        | CF_FREE := PLATFORM /= PLATFORM_MACOS and CF_GOING and not CF_SIGNALS and NODE_KIND[FF] = CLK_ROOT and ROOT_IRQ1[?][NODE_ROOT1[FF] - 1] = 0
        | CF_FAILED := not CF_GOING or CF_NOT_ROOT or CF_FREE or CF_SHARED
        | CF_SIGNAL := if CF_NOT_ROOT or CF_SHARED then CF_CLOCK else if CF_FREE then CF_CLOCK else CF_SIGNAL[?]
        | CF_VIRT_ROOT := CF_VIRT_ROOT[?] or CF_FREE
        |)
     with (| ROOT_COUNT := 0 | CF_FAILED := false | CF_SIGNAL := 0 | CF_VIRT_ROOT := false | CF_PARTNER := 0
           | CF_SHARED_ROOT := false |)
     end
   | RF_INDEX := 0 .. (if CE_ROOTS then CLOCK_TOTAL - 1 else -1)
   | iterate RF_INDEX of
       (| RF_CLOCK := CLOCK_TOTAL - 1 - RF_INDEX
        | RF_REP := CLOCK_REP[RF_CLOCK]
        | ROOT_FIRST := ROOT_FIRST[?] next (if NODE_KIND[RF_REP] = CLK_ROOT then RF_REP else -1) : RF_CLOCK
        |)
     end
   | CLOCK_MESSAGE_RAW := if CLOCKS_RUN and CK_STATE = KS_FAILED then CK_MESSAGE
                          else if CK_DONE and CF_FAILED then
                            (if CF_SHARED_ROOT then T_INPUT_SHARED else if CF_VIRT_ROOT then T_VIRT_ROOT else T_INPUT_ROOT)
                          else if CLOCK_INCOMPLETE then T_CAPACITY else 0
   | CE_STALL := CLOCK_MESSAGE_RAW = T_CLOCK_CYCLE
   | CE_GUARDS := CLOCK_MESSAGE_RAW = T_GUARD_CYCLE
   | SCHED_LIST := CLOCK_MESSAGE_RAW = 0 and (SCHEDULE_MESSAGE = T_SIGNAL_CYCLE or SCHEDULE_MESSAGE = T_EFFECT_CYCLE
                                             or SCHEDULE_MESSAGE = T_CYCLE_SPLIT or SCHEDULE_MESSAGE = T_CYCLE_INSIDE)
   | SCHED_PAIR := CLOCK_MESSAGE_RAW = 0 and SCHEDULE_MESSAGE = T_EFFECTS_UNORDERED
   | CE_ROOTS := DUMP_PASS = 0 and EMIT_READY and EMIT_MESSAGE = 0 and ROOT_COUNT >= 2
   | CE_LIST := CE_STALL or CE_GUARDS or SCHED_LIST or CE_ROOTS
   | CE_PARTIAL := CLOCK_MESSAGE_RAW = T_PARTIAL_OVERLAP or CLOCK_MESSAGE_RAW = T_PARTIAL_NO_CLOCK or CLOCK_MESSAGE_RAW = T_STATEVAR_CONTEXT
   | TX_ARGS := if SCHED_PAIR then 2 else if CLOCK_MESSAGE_RAW = T_VIRT_ROOT or CLOCK_MESSAGE_RAW = T_PARTIAL_OVERLAP then 1
                else if CLOCK_MESSAGE_RAW = T_PARTIAL_NO_CLOCK then 3 else CE_ARGS
   | CE_FITS := CLOCK_MESSAGE_RAW = T_FITS_NO_TREE
   | CE_ARGS := if CE_FITS then 3
                else if CLOCK_MESSAGE_RAW = T_NOT_INSIDE or CLOCK_MESSAGE_RAW = T_PARTIAL_INSIDE or CLOCK_MESSAGE_RAW = T_GUARD_TICK or CLOCK_MESSAGE_RAW = T_RELATION_LT or CLOCK_MESSAGE_RAW = T_RELATION_GT
                        or CLOCK_MESSAGE_RAW = T_RELATION_SHARP then 2
                else if CLOCK_MESSAGE_RAW = T_TWO_DEFINITIONS or CLOCK_MESSAGE_RAW = T_CLOCK_UNDEFINED or CLOCK_MESSAGE_RAW = T_STATEVAR_CONTEXT
                        or CLOCK_MESSAGE_RAW = T_ASSERT_TYPE or CLOCK_MESSAGE_RAW = T_MIN_CLOCK_EMPTY or CLOCK_MESSAGE_RAW = T_MIN_CLOCK_TWO then 1 else 0
   | CE_Q0 := CK_CLOCK0
   | CE_Q1 := CK_CLOCK1
   | CE_Q2 := CK_CLOCK2
   | CE0_INDEX := 0 .. (if CE_STALL then CK_PEND_W - 1 else -1)
   | iterate CE0_INDEX of
       (| E0_0 := DEF_TARGET[PEND[CE0_INDEX]]
        | E0_1 := E0_0 + CK_LINK[E0_0]
        | E0_2 := E0_1 + CK_LINK[E0_1]
        | E0_3 := E0_2 + CK_LINK[E0_2]
        | E0_4 := E0_3 + CK_LINK[E0_3]
        | E0_5 := E0_4 + CK_LINK[E0_4]
        | E0_6 := E0_5 + CK_LINK[E0_5]
        | E0_7 := E0_6 + CK_LINK[E0_6]
        | E0_8 := E0_7 + CK_LINK[E0_7]
        | E0_9 := E0_8 + CK_LINK[E0_8]
        | E0_10 := E0_9 + CK_LINK[E0_9]
        | E0_11 := E0_10 + CK_LINK[E0_10]
        | E0_12 := E0_11 + CK_LINK[E0_11]
        | E0_13 := E0_12 + CK_LINK[E0_12]
        | E0_14 := E0_13 + CK_LINK[E0_13]
        | E0_15 := E0_14 + CK_LINK[E0_14]
        | E0_16 := E0_15 + CK_LINK[E0_15]
        | E0_17 := E0_16 + CK_LINK[E0_16]
        | E0_18 := E0_17 + CK_LINK[E0_17]
        | E0_19 := E0_18 + CK_LINK[E0_18]
        | E0_20 := E0_19 + CK_LINK[E0_19]
        | E0 := E0_20 + CK_OFFICIAL[E0_20]
        | CE_STALLED := CE_STALLED[?] next E0 : true
        |)
     end
   | CE1_INDEX := 0 .. (if CE_GUARDS then GUARDED_COUNT - 1 else if CE_STALL or CE_ARGS > 0 then CLOCK_TOTAL - 1 else -1)
   | iterate CE1_INDEX of
       (| E1_X := if CE_GUARDS then GUARDED[CE1_INDEX] else CE1_INDEX
        | E1_0 := E1_X
        | E1_1 := E1_0 + CK_LINK[E1_0]
        | E1_2 := E1_1 + CK_LINK[E1_1]
        | E1_3 := E1_2 + CK_LINK[E1_2]
        | E1_4 := E1_3 + CK_LINK[E1_3]
        | E1_5 := E1_4 + CK_LINK[E1_4]
        | E1_6 := E1_5 + CK_LINK[E1_5]
        | E1_7 := E1_6 + CK_LINK[E1_6]
        | E1_8 := E1_7 + CK_LINK[E1_7]
        | E1_9 := E1_8 + CK_LINK[E1_8]
        | E1_10 := E1_9 + CK_LINK[E1_9]
        | E1_11 := E1_10 + CK_LINK[E1_10]
        | E1_12 := E1_11 + CK_LINK[E1_11]
        | E1_13 := E1_12 + CK_LINK[E1_12]
        | E1_14 := E1_13 + CK_LINK[E1_13]
        | E1_15 := E1_14 + CK_LINK[E1_14]
        | E1_16 := E1_15 + CK_LINK[E1_15]
        | E1_17 := E1_16 + CK_LINK[E1_16]
        | E1_18 := E1_17 + CK_LINK[E1_17]
        | E1_19 := E1_18 + CK_LINK[E1_18]
        | E1_20 := E1_19 + CK_LINK[E1_19]
        | E1 := E1_20 + CK_OFFICIAL[E1_20]
        | E1_SIGNAL := E1_X < FLAT_SIGNAL_COUNT
        | E1_GUARD := ROWS_GUARD[E1_X]
        | E1_WAITS := CE_GUARDS and NODE_KIND[E1] = CLK_NONE and E1_GUARD >= 0
        | E1_STALLED := CE_STALL and CE_STALLED[E1]
        | E1_MARK := if E1_WAITS then E1_GUARD else if E1_STALLED then E1 else -1
        | E1_NEW := E1_MARK >= 0 and not CE_SEEN[?][E1_MARK]
        | CE_SEEN := CE_SEEN[?] next E1_MARK : true
        | E1_APPENDS := E1_WAITS and E1_NEW or E1_STALLED and E1_SIGNAL
        | E1_OTHER := E1_STALLED and not E1_SIGNAL and E1_NEW
        | E1_SLOT := if E1_APPENDS and CE_COUNT[?] < CLOCK_NAME_CAP then CE_COUNT[?] else -1
        | E1_OTHER_SLOT := if E1_OTHER and CE_OTHER_COUNT[?] < CLOCK_NAME_CAP then CE_OTHER_COUNT[?] else -1
        | E1_MEMBER := if CE_GUARDS then E1_GUARD else E1_X
        | E1_TOKEN := ROWS_TOKEN[E1_GUARD]
        | E1_KEY := if not CE_GUARDS then long(0) else if E1_TOKEN < 0 then long(16777217)
                  else long(TOKEN_LINE[E1_TOKEN]) * long(16777216) + long(TOKEN_COLUMN[E1_TOKEN])
        | CE_ITEM_MEMBER := CE_ITEM_MEMBER[?] next E1_SLOT : E1_MEMBER
        | CE_ITEM_KEY := CE_ITEM_KEY[?] next E1_SLOT : E1_KEY
        | CE_OTHER_MEMBER := CE_OTHER_MEMBER[?] next E1_OTHER_SLOT : E1_X
        | CE_COUNT := CE_COUNT[?] + integer(E1_APPENDS)
        | CE_OTHER_COUNT := CE_OTHER_COUNT[?] + integer(E1_OTHER)
        | CE_MIN0 := if CE_MIN0[?] < 0 and E1 = CE_Q0 then E1_X else CE_MIN0[?]
        | CE_MIN1 := if CE_MIN1[?] < 0 and E1 = CE_Q1 then E1_X else CE_MIN1[?]
        | CE_MIN2 := if CE_MIN2[?] < 0 and E1 = CE_Q2 then E1_X else CE_MIN2[?]
        | E1_PLACED := E1_SIGNAL and NODE_KIND[E1] /= CLK_NONE
        | E1_ROOT := NODE_ROOT1[E1] - 1
        | CE_FS1 := if CE_FS1[?] < 0 and E1_PLACED and E1_ROOT = CE_Q1 then E1_X else CE_FS1[?]
        | CE_FS2 := if CE_FS2[?] < 0 and E1_PLACED and E1_ROOT = CE_Q2 then E1_X else CE_FS2[?]
        |)
     with (| CE_COUNT := 0 | CE_OTHER_COUNT := 0 | CE_MIN0 := -1 | CE_MIN1 := -1 | CE_MIN2 := -1 | CE_FS1 := -1 | CE_FS2 := -1 |)
     end
   | CE_KEY1 := if CE_FS1 >= 0 then CE_FS1 else FLAT_SIGNAL_COUNT + CE_Q1
   | CE_KEY2 := if CE_FS2 >= 0 then CE_FS2 else FLAT_SIGNAL_COUNT + CE_Q2
   | CE_SWAP := CE_FITS and CE_KEY2 < CE_KEY1
   | CE_OTHERS := CE_COUNT = 0
   | SM_OWNED := SM_OWNERS > 0
   | CE_ITEMS_WANTED := if CE_ROOTS then ROOT_COUNT else if TX_ARGS > 0 then TX_ARGS else if SCHED_LIST then (if SM_OWNED then SM_OWNERS else SM_EFFECTS)
                        else if CE_OTHERS then CE_OTHER_COUNT else CE_COUNT
   | CE_ITEMS := if CE_ITEMS_WANTED > CLOCK_NAME_CAP then CLOCK_NAME_CAP else CE_ITEMS_WANTED
   | CL_INDEX := 0 .. CE_ITEMS - 1
   | iterate CL_INDEX of
       (| L_EFFECT := SCHED_PAIR
        | L_POSITION := SCHED_LIST and not SM_OWNED
        | L_PLAIN := L_EFFECT or L_POSITION
        | L_M := if CE_ROOTS then ROOT_FIRST[ROOT_LIST[CL_INDEX]] else if SCHED_LIST then (if SM_OWNED then SM_OWNER_ITEM_ROW[CL_INDEX] else SM_EFFECT_ITEM_ROW[CL_INDEX])
                 else if SCHED_PAIR then (if CL_INDEX = 0 then EF_FIRST_ROW else EF_SECOND_ROW)
                 else if CLOCK_MESSAGE_RAW = T_VIRT_ROOT then CF_SIGNAL
                 else if CE_PARTIAL then CK_CLOCK0
                 else if CLOCK_MESSAGE_RAW = T_PARTIAL_INSIDE and CL_INDEX = 1 then CK_CLOCK2
                 else if CE_ARGS = 0 then (if CE_OTHERS then CE_OTHER_MEMBER[CL_INDEX] else CE_ITEM_MEMBER[CL_INDEX])
                 else if CL_INDEX = 0 then CE_MIN0
                 else if CL_INDEX = 1 and not CE_SWAP or CL_INDEX = 2 and CE_SWAP then CE_MIN1 else CE_MIN2
        | L_SIGNAL := not L_PLAIN and L_M < FLAT_SIGNAL_COUNT
        | L_SAMPLE := not L_PLAIN and L_M >= ROW_COUNT
        | L_ROW := if L_SAMPLE then SAMPLE_ROW[L_M - ROW_COUNT] else L_M
        | L_FRESH := L_BASE >= N_FRESH_FIRST and L_BASE <= N_FRESH_LAST and L_BASE /= N_AFFINE_CLOCK
        | L_FLAT := (L_SIGNAL or L_SAMPLE and L_ROW < FLAT_SIGNAL_COUNT) and not L_FRESH
        | L_BRACKET := L_FLAT and not L_SIGNAL
        | L_SOURCE := FLAT_SIGNAL_SOURCE[L_ROW]
        | L_NAME_KEY := if L_SOURCE < 0 then FINISH_SIGNAL_NAME[-L_SOURCE - 1] else SIGNAL_NAME[L_SOURCE]
        | L_INSTANCE := FLAT_SIGNAL_INSTANCE[L_ROW]
        | L_PREFIXED := L_FLAT and L_INSTANCE > 0
        | L_BASE := L_NAME_KEY modulo NAME_CAP
        | L_SUFFIX := L_NAME_KEY / NAME_CAP
        | L_TOKEN := ROWS_TOKEN[L_ROW]
        | L_P := if L_PLAIN then 0 else if L_BRACKET then F_OPEN else if L_FLAT then 0 else F_EXPRESSION_AT
        | L_A := if L_EFFECT then EFFECT_KIND[integer(ROWS_VALUE[L_M])] modulo NAME_CAP
                 else if L_PREFIXED then MODEL_NAME[INSTANCE_MODEL[L_INSTANCE]] else -1
        | L_F1 := if L_EFFECT then F_AT else if L_PREFIXED then F_HASH else 0
        | L_N1 := if L_PREFIXED then INSTANCE_ORDINAL[L_INSTANCE] else if L_TOKEN < 0 then 1 else TOKEN_LINE[L_TOKEN]
        | L_F2 := if L_PREFIXED then F_DOT else if L_FLAT then 0 else F_COLON
        | L_B := if L_FLAT then L_BASE else -1
        | L_F3 := if L_FLAT and L_SUFFIX > 0 and L_BASE /= N_ON_MARK and (L_BASE < N_FRESH_FIRST or L_BASE > N_FRESH_LAST) then F_QUOTE else 0
        | L_N2 := if L_FLAT then L_SUFFIX else if L_TOKEN < 0 then 1 else TOKEN_COLUMN[L_TOKEN]
        | L_S := if L_PLAIN or L_FLAT and not L_BRACKET then 0 else F_CLOSE
        | L_D1_ALL := 1 + integer(L_N1 >= 10) + integer(L_N1 >= 100) + integer(L_N1 >= 1000) + integer(L_N1 >= 10000) + integer(L_N1 >= 100000) + integer(L_N1 >= 1000000) + integer(L_N1 >= 10000000) + integer(L_N1 >= 100000000) + integer(L_N1 >= 1000000000)
        | L_D2_ALL := 1 + integer(L_N2 >= 10) + integer(L_N2 >= 100) + integer(L_N2 >= 1000) + integer(L_N2 >= 10000) + integer(L_N2 >= 100000) + integer(L_N2 >= 1000000) + integer(L_N2 >= 10000000) + integer(L_N2 >= 100000000) + integer(L_N2 >= 1000000000)
        | L_D1 := if L_PREFIXED or not L_FLAT then L_D1_ALL else 0
        | L_D2 := if not L_FLAT or L_SUFFIX > 0 then L_D2_ALL else 0
        | L_A_LENGTH := if L_A >= NAME_COUNT then UH_LENGTH[L_A - NAME_COUNT] else if L_A >= 0 then NAME_LENGTH[L_A] else 0
        | L_B_LENGTH := if L_B >= NAME_COUNT then UH_LENGTH[L_B - NAME_COUNT] else if L_B >= 0 then NAME_LENGTH[L_B] else 0
        | L_LENGTH := FRAGMENT_LENGTH[L_P] + L_A_LENGTH + FRAGMENT_LENGTH[L_F1] + L_D1 + FRAGMENT_LENGTH[L_F2] + L_B_LENGTH
                    + FRAGMENT_LENGTH[L_F3] + L_D2 + FRAGMENT_LENGTH[L_S]
        | CL_TOTAL := CL_TOTAL[?] + L_LENGTH
        | CL_LONGEST := if L_LENGTH > CL_LONGEST[?] then L_LENGTH else CL_LONGEST[?]
        | CI_P := CI_P[?] next CL_INDEX : L_P
        | CI_A_AT := CI_A_AT[?] next CL_INDEX : if L_A >= NAME_COUNT then U_HIDDEN_AT + UH_AT[L_A - NAME_COUNT] else if L_A >= 0 then NAME_AT[L_A] else 0
        | CI_A_LENGTH := CI_A_LENGTH[?] next CL_INDEX : L_A_LENGTH
        | CI_F1 := CI_F1[?] next CL_INDEX : L_F1
        | CI_N1 := CI_N1[?] next CL_INDEX : L_N1
        | CI_D1 := CI_D1[?] next CL_INDEX : L_D1
        | CI_F2 := CI_F2[?] next CL_INDEX : L_F2
        | CI_B_AT := CI_B_AT[?] next CL_INDEX : if L_B >= NAME_COUNT then U_HIDDEN_AT + UH_AT[L_B - NAME_COUNT] else if L_B >= 0 then NAME_AT[L_B] else 0
        | CI_B_LENGTH := CI_B_LENGTH[?] next CL_INDEX : L_B_LENGTH
        | CI_F3 := CI_F3[?] next CL_INDEX : L_F3
        | CI_N2 := CI_N2[?] next CL_INDEX : L_N2
        | CI_D2 := CI_D2[?] next CL_INDEX : L_D2
        | CI_S := CI_S[?] next CL_INDEX : L_S
        | CI_END := CI_END[?] next CL_INDEX : CL_TOTAL
        | CI_KEY := CI_KEY[?] next CL_INDEX : if TX_ARGS > 0 then long(CL_INDEX)
                                            else if SCHED_LIST then (if SM_OWNED then long(0) else SM_EFFECT_ITEM_KEY[CL_INDEX])
                                            else if CE_OTHERS then long(0) else CE_ITEM_KEY[CL_INDEX]
        |)
     with (| CL_TOTAL := 0 | CL_LONGEST := 0 |)
     end
   | CE_OVERFLOW := CE_ITEMS_WANTED > CLOCK_NAME_CAP
                  or CL_TOTAL + (if CE_LIST and CE_ITEMS > 0 then 2 * (CE_ITEMS - 1) else 0) > CLOCK_TEXT_CAP
   | CR_INDEX := 0 .. (if CE_OVERFLOW then -1 else CL_TOTAL - 1)
   | iterate CR_INDEX of
       (| CR_ITEM := if CR_INDEX >= CI_END[CR_ITEM[?]] then CR_ITEM[?] + 1 else CR_ITEM[?]
        | CR_OFFSET := CR_INDEX - (if CR_ITEM = 0 then 0 else CI_END[CR_ITEM - 1])
        | CR_P_END := FRAGMENT_LENGTH[CI_P[CR_ITEM]]
        | CR_A_END := CR_P_END + CI_A_LENGTH[CR_ITEM]
        | CR_F1_END := CR_A_END + FRAGMENT_LENGTH[CI_F1[CR_ITEM]]
        | CR_N1_END := CR_F1_END + CI_D1[CR_ITEM]
        | CR_F2_END := CR_N1_END + FRAGMENT_LENGTH[CI_F2[CR_ITEM]]
        | CR_B_END := CR_F2_END + CI_B_LENGTH[CR_ITEM]
        | CR_F3_END := CR_B_END + FRAGMENT_LENGTH[CI_F3[CR_ITEM]]
        | CR_N2_END := CR_F3_END + CI_D2[CR_ITEM]
        | CR_NAME_AT := if CR_OFFSET < CR_A_END then CI_A_AT[CR_ITEM] + CR_OFFSET - CR_P_END
                      else CI_B_AT[CR_ITEM] + CR_OFFSET - CR_F2_END
        | CR_NAME_BYTE := if CR_NAME_AT >= U_HIDDEN_AT then U_HIDDEN_TEXT[CR_NAME_AT - U_HIDDEN_AT]
                        else if CR_NAME_AT < SEED_LENGTH then SEED[CR_NAME_AT] else SRC[CR_NAME_AT - SEED_LENGTH]
        | CR_FRAGMENT := if CR_OFFSET < CR_P_END then FRAGMENT_START[CI_P[CR_ITEM]] + CR_OFFSET
                       else if CR_OFFSET < CR_F1_END then FRAGMENT_START[CI_F1[CR_ITEM]] + CR_OFFSET - CR_A_END
                       else if CR_OFFSET < CR_F2_END then FRAGMENT_START[CI_F2[CR_ITEM]] + CR_OFFSET - CR_N1_END
                       else if CR_OFFSET < CR_F3_END then FRAGMENT_START[CI_F3[CR_ITEM]] + CR_OFFSET - CR_B_END
                       else FRAGMENT_START[CI_S[CR_ITEM]] + CR_OFFSET - CR_N2_END
        | CR_DIGIT := if CR_OFFSET < CR_N1_END then ulong(CI_N1[CR_ITEM]) / POWERS_OF_TEN[CR_N1_END - 1 - CR_OFFSET] modulo ulong(10)
                    else ulong(CI_N2[CR_ITEM]) / POWERS_OF_TEN[CR_N2_END - 1 - CR_OFFSET] modulo ulong(10)
        | CR_BYTE := if CR_OFFSET < CR_P_END then FRAGMENTS[CR_FRAGMENT]
                   else if CR_OFFSET < CR_A_END then CR_NAME_BYTE
                   else if CR_OFFSET < CR_F1_END then FRAGMENTS[CR_FRAGMENT]
                   else if CR_OFFSET < CR_N1_END then ubyte(CR_DIGIT + ulong(48))
                   else if CR_OFFSET < CR_F2_END then FRAGMENTS[CR_FRAGMENT]
                   else if CR_OFFSET < CR_B_END then CR_NAME_BYTE
                   else if CR_OFFSET < CR_F3_END then FRAGMENTS[CR_FRAGMENT]
                   else if CR_OFFSET < CR_N2_END then ubyte(CR_DIGIT + ulong(48))
                   else FRAGMENTS[CR_FRAGMENT]
        | CE_TEXT := CE_TEXT[?] next CR_INDEX : CR_BYTE
        |)
     with CR_ITEM := 0
     end
   | CS_INDEX := 0 .. (if CE_OVERFLOW or CE_ROOTS or CE_ITEMS = 0 then long(-1)
                      else long(CE_ITEMS) * long(CE_ITEMS) * long(CL_LONGEST + 1) - long(1))
   | iterate CS_INDEX of
       (| S_I := CS_I[?]
        | S_J := CS_J[?]
        | S_K := CS_K[?]
        | S_LIVE := S_I < CE_ITEMS
        | S_SKIPS := S_I = S_J
        | S_I_START := if S_I = 0 then 0 else CI_END[S_I - 1]
        | S_J_START := if S_J = 0 then 0 else CI_END[S_J - 1]
        | S_I_BYTE := if S_K < CI_END[S_I] - S_I_START then integer(CE_TEXT[S_I_START + S_K]) else -1
        | S_J_BYTE := if S_K < CI_END[S_J] - S_J_START then integer(CE_TEXT[S_J_START + S_K]) else -1
        | S_KEYS_DIFFER := CI_KEY[S_I] /= CI_KEY[S_J]
        | S_EQUAL := not S_KEYS_DIFFER and S_I_BYTE < 0 and S_J_BYTE < 0
        | S_DECIDED := S_LIVE and (S_SKIPS or S_KEYS_DIFFER or S_I_BYTE /= S_J_BYTE or S_EQUAL)
        | S_LESS := not S_SKIPS and (if S_KEYS_DIFFER then CI_KEY[S_J] < CI_KEY[S_I]
                                    else if S_EQUAL then S_J < S_I else S_J_BYTE < S_I_BYTE)
        | S_ROW_ENDS := S_DECIDED and S_J = CE_ITEMS - 1
        | S_RANK := CS_LESS[?] + integer(S_DECIDED and S_LESS)
        | S_DUPLICATE := CS_DUPLICATE[?] or S_DECIDED and not S_SKIPS and S_EQUAL and S_J < S_I
        | CE_ORDER := CE_ORDER[?] next (if S_ROW_ENDS then S_RANK else -1) : S_I
        | CE_DUPLICATE := CE_DUPLICATE[?] next (if S_ROW_ENDS then S_I else -1) : S_DUPLICATE
        | CS_LESS := if S_ROW_ENDS then 0 else S_RANK
        | CS_DUPLICATE := not S_ROW_ENDS and S_DUPLICATE
        | CS_I := S_I + integer(S_ROW_ENDS)
        | CS_J := if S_ROW_ENDS then 0 else S_J + integer(S_DECIDED)
        | CS_K := if S_DECIDED then 0 else S_K + 1
        |)
     with (| CS_I := 0 | CS_J := 0 | CS_K := 0 | CS_LESS := 0 | CS_DUPLICATE := false |)
     end
   | CS_UNFINISHED := not CE_OVERFLOW and not CE_ROOTS and CS_I < CE_ITEMS
   | CE_FAILS := CE_OVERFLOW or CS_UNFINISHED
   | CJ_INDEX := 0 .. (if CE_FAILS then -1 else CL_TOTAL + 3 * CE_ITEMS)
   | iterate CJ_INDEX of
       (| J_R := CJ_R[?]
        | J_O := CJ_O[?]
        | J_LIVE := J_R < CE_ITEMS
        | J_ITEM := if CE_ROOTS then J_R else CE_ORDER[J_R]
        | J_SKIPS := CE_DUPLICATE[J_ITEM] and not SCHED_LIST and not CE_ROOTS
        | J_START := if J_ITEM = 0 then 0 else CI_END[J_ITEM - 1]
        | J_SEPARATOR := if CE_LIST and CJ_EMITTED[?] > 0 then 2 else 0
        | J_EMITS := J_LIVE and not J_SKIPS and J_O < J_SEPARATOR + CI_END[J_ITEM] - J_START
        | J_ADVANCES := J_LIVE and not J_EMITS
        | J_BYTE := if J_O >= J_SEPARATOR then CE_TEXT[J_START + J_O - J_SEPARATOR] else if J_O = 0 then ubyte(44) else ubyte(32)
        | CLOCK_TEXT := CLOCK_TEXT[?] next (if J_EMITS then CJ_POSITION[?] else -1) : J_BYTE
        | CJ_POSITION := CJ_POSITION[?] + integer(J_EMITS)
        | CJ_EMITTED := CJ_EMITTED[?] + integer(J_ADVANCES and not J_SKIPS)
        | CJ_R := J_R + integer(J_ADVANCES)
        | CJ_O := if J_ADVANCES then 0 else J_O + integer(J_EMITS)
        |)
     with (| CJ_R := 0 | CJ_O := 0 | CJ_POSITION := 0 | CJ_EMITTED := 0 |)
     end
   | CE_GUARD_TOKEN := ROWS_TOKEN[CE_ITEM_MEMBER[CE_ORDER[0]]]
   | CLOCK_FAILED := CLOCKS_RUN and CK_STATE = KS_FAILED or CK_DONE and CF_FAILED
   | CLOCK_INCOMPLETE := CLOCKS_RUN and CK_STATE /= KS_DONE and CK_STATE /= KS_FAILED
   | CLOCKS_READY := CK_DONE and not CF_FAILED
   | CF_SIGNAL_SOURCE := FLAT_SIGNAL_SOURCE[CF_SIGNAL]
   | SCHEDULE_ARGUMENT2 := if SCHED_PAIR then EFFECT_RESOURCE[integer(ROWS_VALUE[EF_FIRST_ROW])] else 0
   | CLOCK_MESSAGE := if CE_FAILS then T_CAPACITY else if CLOCK_MESSAGE_RAW /= 0 then CLOCK_MESSAGE_RAW
                    else if SCHEDULE_MESSAGE /= 0 then SCHEDULE_MESSAGE else EMIT_MESSAGE
   | CLOCK_TOKEN := if CE_GUARDS then CE_GUARD_TOKEN else if CLOCKS_RUN and CK_STATE = KS_FAILED then CK_TOKEN
                    else if CLOCK_MESSAGE_RAW = T_VIRT_ROOT and CF_SIGNAL >= FLAT_SIGNAL_COUNT then
                      ROWS_TOKEN[if CF_SIGNAL >= ROW_COUNT then SAMPLE_ROW[CF_SIGNAL - ROW_COUNT] else CF_SIGNAL]
                    else if CK_DONE and CF_FAILED then
                      (if CF_SIGNAL_SOURCE < 0 then FINISH_SIGNAL_TOKEN[-CF_SIGNAL_SOURCE - 1] else SIGNAL_TOKEN[CF_SIGNAL_SOURCE])
                    else if SCHEDULE_MESSAGE /= 0 then SCHEDULE_TOKEN else EMIT_ERROR_TOKEN
   | CLOCK_ARGUMENT0 := if CE_ITEMS_WANTED > CLOCK_NAME_CAP then F_CAP_CLOCK_NAMES else if CE_OVERFLOW then F_CAP_CLOCK_TEXT
                        else if CS_UNFINISHED then F_CAP_CLOCK_SORT else if CLOCKS_RUN and CK_STATE = KS_FAILED then CK_ARGUMENT0
                        else if CK_DONE and CF_FAILED and CF_SHARED_ROOT then SIGNAL_NAME[FLAT_SIGNAL_SOURCE[CF_PARTNER]]
                        else if CK_DONE and CF_FAILED then
                          (if CF_SIGNAL_SOURCE < 0 then FINISH_SIGNAL_NAME[-CF_SIGNAL_SOURCE - 1] else SIGNAL_NAME[CF_SIGNAL_SOURCE])
                        else if CLOCK_MESSAGE_RAW = 0 and SCHEDULE_MESSAGE /= 0 then SCHEDULE_ARGUMENT0
                        else if CLOCK_MESSAGE_RAW = 0 and EMIT_MESSAGE /= 0 then EMIT_CAPACITY else F_CAP_CLOCKS
   | SCHEDULE_DUMP := DUMP_PASS = 6
   | SCHEDULE_RUN := CLOCKS_READY and (DUMP_PASS = 0 or SCHEDULE_DUMP or CODE_DUMP)
   | SCHED_LOOP_BASE := ROW_COUNT + CLOCK_TOTAL
   | SCHED_NODES := SCHED_LOOP_BASE + LOOP_TOTAL
   | SE_CLOCK_END := 3 * ROW_COUNT + 2 * CLOCK_TOTAL
   | SE_DEP_END := SE_CLOCK_END + DEPENDENCE_TOTAL
   | SE_INDEX := 0 .. (if SCHEDULE_RUN and SCHED_NODES < SCHED_NODE_CAP then SE_DEP_END + LOOP_TOTAL - 1 else -1)
   | iterate SE_INDEX of
       (| E_IN_ROWS := SE_INDEX < 3 * ROW_COUNT
        | E_IN_CLOCKS := not E_IN_ROWS and SE_INDEX < SE_CLOCK_END
        | E_IN_DEPS := SE_INDEX >= SE_CLOCK_END and SE_INDEX < SE_DEP_END
        | E_IN_LOOPS := SE_INDEX >= SE_DEP_END
        | E_ROW := SE_INDEX / 3
        | E_SUB := SE_INDEX modulo 3
        | E_CLOCK := (SE_INDEX - 3 * ROW_COUNT) / 2
        | E_CSUB := (SE_INDEX - 3 * ROW_COUNT) modulo 2
        | E_D := SE_INDEX - SE_CLOCK_END
        | E_L := SE_INDEX - SE_DEP_END
        | E_ROW_OP := ROWS_OP[E_ROW]
        | E_LEFT := ROWS_LEFT[E_ROW]
        | E_RIGHT := ROWS_RIGHT[E_ROW]
        | E_SEED := E_ROW_OP = OP_SEED
        | E_MONO := OP_MONOCHRONOUS[E_ROW_OP] = 1
        | E_LEFT_EDGE := E_SEED or E_LEFT >= 0 and E_ROW_OP /= OP_PREV and (E_ROW_OP = OP_COPY or E_ROW_OP = OP_EFFECT or E_MONO or E_ROW_OP = OP_WHEN or E_ROW_OP = OP_DEFAULT)
        | E_RIGHT_EDGE := E_SEED or E_RIGHT >= 0 and (E_MONO or E_ROW_OP = OP_DEFAULT and not ROWS_CTX[E_LEFT])
        | E_KIND := NODE_KIND[E_CLOCK]
        | E_SAMPLE := E_KIND = CLK_SAMPLE
        | E_BINARY := E_KIND = CLK_PRODUCT or E_KIND = CLK_SUM
        | E_HAS := if E_IN_ROWS then E_SUB = 0 or E_SUB = 1 and E_LEFT_EDGE or E_SUB = 2 and E_RIGHT_EDGE
                 else if E_IN_CLOCKS then E_SAMPLE or E_BINARY else E_IN_DEPS
        | E_FROM := if E_IN_ROWS then (if E_SUB = 0 then ROW_COUNT + CLOCK_REP[E_ROW] else if E_SUB = 1 then E_LEFT
                                      else if E_SEED then E_ROW else E_RIGHT)
                  else if E_IN_CLOCKS then
                    (if E_CSUB = 0 then ROW_COUNT + (if E_SAMPLE then NODE_PARENT1[E_CLOCK] else NODE_LEFT1[E_CLOCK]) - 1
                     else if E_SAMPLE then NODE_LEFT1[E_CLOCK] - 1 else ROW_COUNT + NODE_RIGHT1[E_CLOCK] - 1)
                  else if E_IN_DEPS then DEPENDENCE_FROM_ROW[E_D] else LOOP_INDEX[E_L]
        | E_TO := if E_IN_ROWS then (if E_SUB = 2 and E_SEED then E_RIGHT else E_ROW)
                else if E_IN_CLOCKS then ROW_COUNT + E_CLOCK else if E_IN_DEPS then DEPENDENCE_TO_ROW[E_D]
                else SCHED_LOOP_BASE + E_L
        | E_GLOBAL := E_HAS and not E_IN_LOOPS
        | E_SFROM := (if E_FROM < ROW_COUNT and ROWS_LOOP[E_FROM] >= 0 then SCHED_LOOP_BASE + ROWS_LOOP[E_FROM] else E_FROM)
        | E_STO := (if E_TO < ROW_COUNT and ROWS_LOOP[E_TO] >= 0 then SCHED_LOOP_BASE + ROWS_LOOP[E_TO] else E_TO)
        | E_OUTER := E_GLOBAL and (E_FROM = E_TO or E_SFROM /= E_STO)
                   or E_IN_LOOPS and ROWS_OP[ROWS_LEFT[LOOP_INDEX[E_L]]] = OP_RANGE
        | E_OFROM := if E_IN_LOOPS then E_FROM else E_SFROM
        | E_OTO := if E_IN_LOOPS then E_TO else E_STO
        | E_INNER := E_GLOBAL and (E_FROM < ROW_COUNT and ROWS_LOOP[E_FROM] >= 0 and ROWS_OP[E_FROM] /= OP_SEED) and (E_TO < ROW_COUNT and ROWS_LOOP[E_TO] >= 0 and ROWS_OP[E_TO] /= OP_SEED) and ROWS_LOOP[E_FROM] = ROWS_LOOP[E_TO]
        | E_GSLOT := if E_GLOBAL and SG_COUNT[?] < EDGE_CAP then SG_COUNT[?] else -1
        | E_OSLOT := if E_OUTER and SO_COUNT[?] < EDGE_CAP then SO_COUNT[?] else -1
        | SG_FROM := SG_FROM[?] next E_GSLOT : E_FROM
        | SG_TO := SG_TO[?] next E_GSLOT : E_TO
        | SG_COUNT := SG_COUNT[?] + integer(E_GLOBAL)
        | SO_FROM := SO_FROM[?] next E_OSLOT : E_OFROM
        | SO_TO := SO_TO[?] next E_OSLOT : E_OTO
        | SO_ORIGIN := SO_ORIGIN[?] next E_OSLOT : SE_INDEX
        | SO_COUNT := SO_COUNT[?] + integer(E_OUTER)
        | SG_OUT := SG_OUT[?] next (if E_GLOBAL then E_FROM else -1) : SG_OUT[?][E_FROM] + 1
        | SG_IN := SG_IN[?] next (if E_GLOBAL then E_TO else -1) : SG_IN[?][E_TO] + 1
        | SO_OUT := SO_OUT[?] next (if E_OUTER then E_OFROM else -1) : SO_OUT[?][E_OFROM] + 1
        | SO_IN := SO_IN[?] next (if E_OUTER then E_OTO else -1) : SO_IN[?][E_OTO] + 1
        | SI_IN := SI_IN[?] next (if E_INNER then E_TO else -1) : SI_IN[?][E_TO] + 1
        | E_ROW0 := E_IN_ROWS and E_SUB = 0
        | E_MEMBER := (E_ROW < ROW_COUNT and ROWS_LOOP[E_ROW] >= 0 and ROWS_OP[E_ROW] /= OP_SEED)
        | E_LOOP := ROWS_LOOP[E_ROW]
        | LOOP_MEMBERS := LOOP_MEMBERS[?] next (if E_ROW0 and E_MEMBER then E_LOOP else -1) : LOOP_MEMBERS[?][E_LOOP] + 1
        | E_GATHERS := E_ROW0 and E_MEMBER and E_ROW_OP = OP_GATHER and ROWS_OP[E_LEFT] = OP_PREV and ROWS_LEFT[E_LEFT] = ROWS_OWNER[E_ROW]
        | SNAP_GATHER1 := SNAP_GATHER1[?] next (if E_GATHERS then ROWS_OWNER[E_ROW] else -1) : E_LOOP + 1
        | E_EFFECT := E_ROW0 and E_ROW_OP = OP_EFFECT
        | E_RESOURCE := EFFECT_RESOURCE[integer(ROWS_VALUE[E_ROW])]
        | SE_EROW := SE_EROW[?] next (if E_EFFECT and SE_ECOUNT[?] < EFFECT_ORDER_CAP then SE_ECOUNT[?] else -1) : E_ROW
        | SE_ECOUNT := SE_ECOUNT[?] + integer(E_EFFECT)
        | RES_COUNT := RES_COUNT[?] next (if E_EFFECT then E_RESOURCE else -1) : RES_COUNT[?][E_RESOURCE] + 1
        |)
     with (| SG_COUNT := 0 | SO_COUNT := 0 | SE_ECOUNT := 0 |)
     end
   | SCHED_OVERFLOW := SCHEDULE_RUN and (SCHED_NODES >= SCHED_NODE_CAP or SG_COUNT > EDGE_CAP or SO_COUNT > EDGE_CAP
                                       or SE_ECOUNT > EFFECT_ORDER_CAP)
   | SCHED_GO := SCHEDULE_RUN and not SCHED_OVERFLOW
   | SWC_INDEX := 0 .. (if SCHED_GO then WAR_COUNT - 1 else -1)
   | iterate SWC_INDEX of
       (| W_READER := WAR_READER[SWC_INDEX]
        | W_WRITER := WAR_WRITER[SWC_INDEX]
        | W_KEPT := (W_READER < ROW_COUNT and ROWS_LOOP[W_READER] >= 0 and ROWS_OP[W_READER] /= OP_SEED) and SNAP_GATHER1[WAR_SIGNAL[SWC_INDEX]] /= ROWS_LOOP[W_READER] + 1
        | SW_OUT := SW_OUT[?] next (if W_KEPT then W_READER else -1) : SW_OUT[?][W_READER] + 1
        | SW_IN := SW_IN[?] next (if W_KEPT then W_WRITER else -1) : SW_IN[?][W_WRITER] + 1
        |)
     end
   | SN_INDEX := 0 .. (if SCHED_GO then SCHED_NODES else -1)
   | iterate SN_INDEX of
       (| SG_START := SG_START[?] next SN_INDEX : SN_G[?]
        | SN_G := SN_G[?] + SG_OUT[SN_INDEX]
        | SG_PSTART := SG_PSTART[?] next SN_INDEX : SN_GP[?]
        | SN_GP := SN_GP[?] + SG_IN[SN_INDEX]
        | SO_START := SO_START[?] next SN_INDEX : SN_O[?]
        | SN_O := SN_O[?] + SO_OUT[SN_INDEX]
        | SO_PSTART := SO_PSTART[?] next SN_INDEX : SN_OP[?]
        | SN_OP := SN_OP[?] + SO_IN[SN_INDEX]
        | SW_START := SW_START[?] next SN_INDEX : SN_W[?]
        | SN_W := SN_W[?] + SW_OUT[SN_INDEX]
        |)
     with (| SN_G := 0 | SN_GP := 0 | SN_O := 0 | SN_OP := 0 | SN_W := 0 |)
     end
   | SPL_MAX := if SG_COUNT > WAR_COUNT then SG_COUNT else WAR_COUNT
   | SPL_INDEX := 0 .. (if SCHED_GO then SPL_MAX - 1 else -1)
   | iterate SPL_INDEX of
       (| P_G := SPL_INDEX < SG_COUNT
        | P_GF := SG_FROM[SPL_INDEX]
        | P_GT := SG_TO[SPL_INDEX]
        | SG_SUCC := SG_SUCC[?] next (if P_G then SG_START[P_GF] + SG_SFILL[?][P_GF] else -1) : P_GT
        | SG_SFILL := SG_SFILL[?] next (if P_G then P_GF else -1) : SG_SFILL[?][P_GF] + 1
        | SG_PRED := SG_PRED[?] next (if P_G then SG_PSTART[P_GT] + SG_PFILL[?][P_GT] else -1) : P_GF
        | SG_PFILL := SG_PFILL[?] next (if P_G then P_GT else -1) : SG_PFILL[?][P_GT] + 1
        | P_O := SPL_INDEX < SO_COUNT
        | P_OF := SO_FROM[SPL_INDEX]
        | P_OT := SO_TO[SPL_INDEX]
        | SO_SUCC := SO_SUCC[?] next (if P_O then SO_START[P_OF] + SO_SFILL[?][P_OF] else -1) : P_OT
        | SO_SFILL := SO_SFILL[?] next (if P_O then P_OF else -1) : SO_SFILL[?][P_OF] + 1
        | SO_PRED := SO_PRED[?] next (if P_O then SO_PSTART[P_OT] + SO_PFILL[?][P_OT] else -1) : P_OF
        | SO_PFILL := SO_PFILL[?] next (if P_O then P_OT else -1) : SO_PFILL[?][P_OT] + 1
        | P_WR := WAR_READER[SPL_INDEX]
        | P_W := SPL_INDEX < WAR_COUNT and (P_WR < ROW_COUNT and ROWS_LOOP[P_WR] >= 0 and ROWS_OP[P_WR] /= OP_SEED) and SNAP_GATHER1[WAR_SIGNAL[SPL_INDEX]] /= ROWS_LOOP[P_WR] + 1
        | SW_SUCC := SW_SUCC[?] next (if P_W then SW_START[P_WR] + SW_FILL[?][P_WR] else -1) : WAR_WRITER[SPL_INDEX]
        | SW_FILL := SW_FILL[?] next (if P_W then P_WR else -1) : SW_FILL[?][P_WR] + 1
        |)
     end
   | SKO_INDEX := 0 .. (if SCHED_GO then 2 * (SCHED_NODES) + (SO_COUNT) + 1 else -1)
   | iterate SKO_INDEX of
       (| SKO_IN_INIT := SKO_CURSOR[?] < SCHED_NODES
        | SKO_INIT_NODE := SKO_CURSOR[?]
        | SKO_INIT_PRESENT := SKO_IN_INIT and (if SKO_INIT_NODE < ROW_COUNT then ROWS_LOOP[SKO_INIT_NODE] < 0 else if SKO_INIT_NODE < SCHED_LOOP_BASE then NODE_KIND[SKO_INIT_NODE - ROW_COUNT] /= CLK_NONE else true)
        | SKO_INIT_PUSH := SKO_INIT_PRESENT and SO_IN[SKO_INIT_NODE] = 0
        | SKO_NODE_NOW := SKO_NODE[?]
        | SKO_K := SKO_STEP[?]
        | SKO_LEN0 := if SKO_NODE_NOW >= 0 then SO_START[SKO_NODE_NOW + 1] - SO_START[SKO_NODE_NOW] else 0
        | SKO_EXPANDING := not SKO_IN_INIT and SKO_K < SKO_LEN0
        | SKO_S := SO_SUCC[SO_START[SKO_NODE_NOW] + SKO_K]
        | SKO_COUNTS := SKO_EXPANDING and true
        | SKO_NEW_DEC := SKO_DEC[?][SKO_S] + 1
        | SKO_DEC := SKO_DEC[?] next (if SKO_COUNTS then SKO_S else -1) : SKO_NEW_DEC
        | SKO_SUCC_PUSH := SKO_COUNTS and SO_IN[SKO_S] = SKO_NEW_DEC
        | SKO_POPS := not SKO_IN_INIT and not SKO_EXPANDING and SKO_TOP[?] > 0
        | SKO_POPPED := SKO_STACK[?][SKO_TOP[?] - 1]
        | SKO_PUSH := SKO_INIT_PUSH or SKO_SUCC_PUSH
        | SKO_STACK := SKO_STACK[?] next (if SKO_PUSH then SKO_TOP[?] else -1) : (if SKO_IN_INIT then SKO_INIT_NODE else SKO_S)
        | SKO_TOP := SKO_TOP[?] + integer(SKO_PUSH) - integer(SKO_POPS)
        | SKO_ORDER := SKO_ORDER[?] next (if SKO_POPS then SKO_COUNT[?] else -1) : SKO_POPPED
        | SKO_COUNT := SKO_COUNT[?] + integer(SKO_POPS)
        | SKO_PRESENT := SKO_PRESENT[?] + integer(SKO_INIT_PRESENT)
        | SKO_MARK := SKO_MARK[?] next (if SKO_POPS then SKO_POPPED else -1) : true
        | SKO_NODE := if SKO_POPS then SKO_POPPED else SKO_NODE_NOW
        | SKO_STEP := if SKO_POPS then 0 else SKO_K + integer(SKO_EXPANDING)
        | SKO_CURSOR := SKO_CURSOR[?] + integer(SKO_IN_INIT)
        |)
     with (| SKO_CURSOR := 0 | SKO_NODE := -1 | SKO_STEP := 0 | SKO_TOP := 0 | SKO_COUNT := 0 | SKO_PRESENT := 0 |)
     end
   | SKO_FAILED := SCHED_GO and SKO_COUNT < SKO_PRESENT
   | SKA_RUN := SCHED_GO and LOOP_TOTAL > 0
   | SKA_INDEX := 0 .. (if SKA_RUN then 2 * (ROW_COUNT) + (SG_COUNT + WAR_COUNT) + 1 else -1)
   | iterate SKA_INDEX of
       (| SKA_IN_INIT := SKA_CURSOR[?] < ROW_COUNT
        | SKA_INIT_NODE := SKA_CURSOR[?]
        | SKA_INIT_PRESENT := SKA_IN_INIT and (SKA_INIT_NODE < ROW_COUNT and ROWS_LOOP[SKA_INIT_NODE] >= 0 and ROWS_OP[SKA_INIT_NODE] /= OP_SEED)
        | SKA_INIT_PUSH := SKA_INIT_PRESENT and (SI_IN[SKA_INIT_NODE] + SW_IN[SKA_INIT_NODE]) = 0
        | SKA_NODE_NOW := SKA_NODE[?]
        | SKA_K := SKA_STEP[?]
        | SKA_LEN0 := if SKA_NODE_NOW >= 0 then SG_START[SKA_NODE_NOW + 1] - SG_START[SKA_NODE_NOW] else 0
        | SKA_LEN1 := if SKA_NODE_NOW >= 0 then (if SKA_NODE_NOW < ROW_COUNT then SW_START[SKA_NODE_NOW + 1] - SW_START[SKA_NODE_NOW] else 0) else 0
        | SKA_EXPANDING := not SKA_IN_INIT and SKA_K < SKA_LEN0 + SKA_LEN1
        | SKA_IN_SEG0 := SKA_K < SKA_LEN0
        | SKA_S := if SKA_IN_SEG0 then SG_SUCC[SG_START[SKA_NODE_NOW] + SKA_K]
                  else SW_SUCC[SW_START[SKA_NODE_NOW] + SKA_K - SKA_LEN0]
        | SKA_COUNTS := SKA_EXPANDING and (if SKA_IN_SEG0 then ((SKA_NODE_NOW < ROW_COUNT and ROWS_LOOP[SKA_NODE_NOW] >= 0 and ROWS_OP[SKA_NODE_NOW] /= OP_SEED) and (SKA_S < ROW_COUNT and ROWS_LOOP[SKA_S] >= 0 and ROWS_OP[SKA_S] /= OP_SEED) and ROWS_LOOP[SKA_S] = ROWS_LOOP[SKA_NODE_NOW]) else true)
        | SKA_NEW_DEC := SKA_DEC[?][SKA_S] + 1
        | SKA_DEC := SKA_DEC[?] next (if SKA_COUNTS then SKA_S else -1) : SKA_NEW_DEC
        | SKA_SUCC_PUSH := SKA_COUNTS and (SI_IN[SKA_S] + SW_IN[SKA_S]) = SKA_NEW_DEC
        | SKA_POPS := not SKA_IN_INIT and not SKA_EXPANDING and SKA_TOP[?] > 0
        | SKA_POPPED := SKA_STACK[?][SKA_TOP[?] - 1]
        | SKA_PUSH := SKA_INIT_PUSH or SKA_SUCC_PUSH
        | SKA_STACK := SKA_STACK[?] next (if SKA_PUSH then SKA_TOP[?] else -1) : (if SKA_IN_INIT then SKA_INIT_NODE else SKA_S)
        | SKA_TOP := SKA_TOP[?] + integer(SKA_PUSH) - integer(SKA_POPS)
        | SKA_ORDER := SKA_ORDER[?] next (if SKA_POPS then SKA_COUNT[?] else -1) : SKA_POPPED
        | SKA_COUNT := SKA_COUNT[?] + integer(SKA_POPS)
        | SKA_PRESENT := SKA_PRESENT[?] + integer(SKA_INIT_PRESENT)
        | SKA_POP_LOOP := if SKA_POPS and SKA_POPPED < ROW_COUNT then ROWS_LOOP[SKA_POPPED] else -1
        | SKA_LOOP_POPS := SKA_LOOP_POPS[?] next SKA_POP_LOOP : SKA_LOOP_POPS[?][SKA_POP_LOOP] + 1
        | SKA_NODE := if SKA_POPS then SKA_POPPED else SKA_NODE_NOW
        | SKA_STEP := if SKA_POPS then 0 else SKA_K + integer(SKA_EXPANDING)
        | SKA_CURSOR := SKA_CURSOR[?] + integer(SKA_IN_INIT)
        |)
     with (| SKA_CURSOR := 0 | SKA_NODE := -1 | SKA_STEP := 0 | SKA_TOP := 0 | SKA_COUNT := 0 | SKA_PRESENT := 0 |)
     end
   | SKB_RUN := SKA_RUN and SKA_COUNT < SKA_PRESENT
   | SKB_INDEX := 0 .. (if SKB_RUN then 2 * (ROW_COUNT) + (SG_COUNT) + 1 else -1)
   | iterate SKB_INDEX of
       (| SKB_IN_INIT := SKB_CURSOR[?] < ROW_COUNT
        | SKB_INIT_NODE := SKB_CURSOR[?]
        | SKB_INIT_PRESENT := SKB_IN_INIT and ((SKB_INIT_NODE < ROW_COUNT and ROWS_LOOP[SKB_INIT_NODE] >= 0 and ROWS_OP[SKB_INIT_NODE] /= OP_SEED) and (SKA_LOOP_POPS[ROWS_LOOP[SKB_INIT_NODE]] < LOOP_MEMBERS[ROWS_LOOP[SKB_INIT_NODE]]))
        | SKB_INIT_PUSH := SKB_INIT_PRESENT and SI_IN[SKB_INIT_NODE] = 0
        | SKB_NODE_NOW := SKB_NODE[?]
        | SKB_K := SKB_STEP[?]
        | SKB_LEN0 := if SKB_NODE_NOW >= 0 then SG_START[SKB_NODE_NOW + 1] - SG_START[SKB_NODE_NOW] else 0
        | SKB_EXPANDING := not SKB_IN_INIT and SKB_K < SKB_LEN0
        | SKB_S := SG_SUCC[SG_START[SKB_NODE_NOW] + SKB_K]
        | SKB_COUNTS := SKB_EXPANDING and ((SKB_NODE_NOW < ROW_COUNT and ROWS_LOOP[SKB_NODE_NOW] >= 0 and ROWS_OP[SKB_NODE_NOW] /= OP_SEED) and (SKB_S < ROW_COUNT and ROWS_LOOP[SKB_S] >= 0 and ROWS_OP[SKB_S] /= OP_SEED) and ROWS_LOOP[SKB_S] = ROWS_LOOP[SKB_NODE_NOW])
        | SKB_NEW_DEC := SKB_DEC[?][SKB_S] + 1
        | SKB_DEC := SKB_DEC[?] next (if SKB_COUNTS then SKB_S else -1) : SKB_NEW_DEC
        | SKB_SUCC_PUSH := SKB_COUNTS and SI_IN[SKB_S] = SKB_NEW_DEC
        | SKB_POPS := not SKB_IN_INIT and not SKB_EXPANDING and SKB_TOP[?] > 0
        | SKB_POPPED := SKB_STACK[?][SKB_TOP[?] - 1]
        | SKB_PUSH := SKB_INIT_PUSH or SKB_SUCC_PUSH
        | SKB_STACK := SKB_STACK[?] next (if SKB_PUSH then SKB_TOP[?] else -1) : (if SKB_IN_INIT then SKB_INIT_NODE else SKB_S)
        | SKB_TOP := SKB_TOP[?] + integer(SKB_PUSH) - integer(SKB_POPS)
        | SKB_ORDER := SKB_ORDER[?] next (if SKB_POPS then SKB_COUNT[?] else -1) : SKB_POPPED
        | SKB_COUNT := SKB_COUNT[?] + integer(SKB_POPS)
        | SKB_PRESENT := SKB_PRESENT[?] + integer(SKB_INIT_PRESENT)
        | SKB_MARK := SKB_MARK[?] next (if SKB_POPS then SKB_POPPED else -1) : true
        | SKB_POP_LOOP := if SKB_POPS and SKB_POPPED < ROW_COUNT then ROWS_LOOP[SKB_POPPED] else -1
        | SKB_LOOP_POPS := SKB_LOOP_POPS[?] next SKB_POP_LOOP : SKB_LOOP_POPS[?][SKB_POP_LOOP] + 1
        | SKB_NODE := if SKB_POPS then SKB_POPPED else SKB_NODE_NOW
        | SKB_STEP := if SKB_POPS then 0 else SKB_K + integer(SKB_EXPANDING)
        | SKB_CURSOR := SKB_CURSOR[?] + integer(SKB_IN_INIT)
        |)
     with (| SKB_CURSOR := 0 | SKB_NODE := -1 | SKB_STEP := 0 | SKB_TOP := 0 | SKB_COUNT := 0 | SKB_PRESENT := 0 |)
     end
   | SKB_FAILED := SKB_RUN and SKB_COUNT < SKB_PRESENT
   | SL_INDEX := 0 .. (if SKA_RUN then LOOP_TOTAL - 1 else -1)
   | iterate SL_INDEX of
       (| L_FAILED1 := (SKA_LOOP_POPS[SL_INDEX] < LOOP_MEMBERS[SL_INDEX])
        | L_FAILED2 := L_FAILED1 and SKB_LOOP_POPS[SL_INDEX] < LOOP_MEMBERS[SL_INDEX]
        | SL_ERROR_LOOP := if SL_ERROR_LOOP[?] < 0 and L_FAILED2 then SL_INDEX else SL_ERROR_LOOP[?]
        | L_POPS := if L_FAILED1 then SKB_LOOP_POPS[SL_INDEX] else SKA_LOOP_POPS[SL_INDEX]
        | LO_START := LO_START[?] next SL_INDEX : LO_SUM[?]
        | LO_LENGTH := LO_LENGTH[?] next SL_INDEX : L_POPS
        | LO_SUM := LO_SUM[?] + L_POPS
        |)
     with (| SL_ERROR_LOOP := -1 | LO_SUM := 0 |)
     end
   | SC_OUTER := SKO_FAILED
   | SC_INNER := SKB_FAILED
   | SC_RUN := SC_OUTER or SC_INNER
   | SC_N := if SC_OUTER then SCHED_NODES else ROW_COUNT
   | SCA_INDEX := 0 .. (if SC_RUN then SC_N + (if SC_OUTER then SO_COUNT else SG_COUNT) - 1 else -1)
   | iterate SCA_INDEX of
       (| A_NODE := SCA_NODE[?]
        | A_K := SCA_K[?]
        | A_LEN := if SC_OUTER then SO_START[A_NODE + 1] - SO_START[A_NODE] else SG_START[A_NODE + 1] - SG_START[A_NODE]
        | A_EXPANDING := A_K < A_LEN
        | A_S := if SC_OUTER then SO_SUCC[SO_START[A_NODE] + A_K] else SG_SUCC[SG_START[A_NODE] + A_K]
        | A_HIT := A_EXPANDING and (SC_OUTER or ((A_NODE < ROW_COUNT and ROWS_LOOP[A_NODE] >= 0 and ROWS_OP[A_NODE] /= OP_SEED) and (A_S < ROW_COUNT and ROWS_LOOP[A_S] >= 0 and ROWS_OP[A_S] /= OP_SEED) and ROWS_LOOP[A_S] = ROWS_LOOP[A_NODE])) and (if SC_OUTER then ((if A_S < ROW_COUNT then ROWS_LOOP[A_S] < 0 else if A_S < SCHED_LOOP_BASE then NODE_KIND[A_S - ROW_COUNT] /= CLK_NONE else true) and not SKO_MARK[A_S]) else (((A_S < ROW_COUNT and ROWS_LOOP[A_S] >= 0 and ROWS_OP[A_S] /= OP_SEED) and (SKA_LOOP_POPS[ROWS_LOOP[A_S]] < LOOP_MEMBERS[ROWS_LOOP[A_S]])) and not SKB_MARK[A_S]))
        | A_ACC := SCA_ACC[?] + integer(A_HIT)
        | SC_OUTC := SC_OUTC[?] next (if A_EXPANDING then -1 else A_NODE) : A_ACC
        | SCA_NODE := A_NODE + integer(not A_EXPANDING)
        | SCA_K := if A_EXPANDING then A_K + 1 else 0
        | SCA_ACC := if A_EXPANDING then A_ACC else 0
        |)
     with (| SCA_NODE := 0 | SCA_K := 0 | SCA_ACC := 0 |)
     end
   | SCB_INDEX := 0 .. (if SC_RUN then 2 * (SC_N) + ((if SC_OUTER then SO_COUNT else SG_COUNT)) + 1 else -1)
   | iterate SCB_INDEX of
       (| SCB_IN_INIT := SCB_CURSOR[?] < SC_N
        | SCB_INIT_NODE := SCB_CURSOR[?]
        | SCB_INIT_PRESENT := SCB_IN_INIT and (if SC_OUTER then ((if SCB_INIT_NODE < ROW_COUNT then ROWS_LOOP[SCB_INIT_NODE] < 0 else if SCB_INIT_NODE < SCHED_LOOP_BASE then NODE_KIND[SCB_INIT_NODE - ROW_COUNT] /= CLK_NONE else true) and not SKO_MARK[SCB_INIT_NODE]) else (((SCB_INIT_NODE < ROW_COUNT and ROWS_LOOP[SCB_INIT_NODE] >= 0 and ROWS_OP[SCB_INIT_NODE] /= OP_SEED) and (SKA_LOOP_POPS[ROWS_LOOP[SCB_INIT_NODE]] < LOOP_MEMBERS[ROWS_LOOP[SCB_INIT_NODE]])) and not SKB_MARK[SCB_INIT_NODE]))
        | SCB_INIT_PUSH := SCB_INIT_PRESENT and SC_OUTC[SCB_INIT_NODE] = 0
        | SCB_NODE_NOW := SCB_NODE[?]
        | SCB_K := SCB_STEP[?]
        | SCB_LEN0 := if SCB_NODE_NOW >= 0 then (if SC_OUTER then SO_PSTART[SCB_NODE_NOW + 1] - SO_PSTART[SCB_NODE_NOW] else SG_PSTART[SCB_NODE_NOW + 1] - SG_PSTART[SCB_NODE_NOW]) else 0
        | SCB_EXPANDING := not SCB_IN_INIT and SCB_K < SCB_LEN0
        | SCB_S := (if SC_OUTER then SO_PRED[SO_PSTART[SCB_NODE_NOW] + SCB_K] else SG_PRED[SG_PSTART[SCB_NODE_NOW] + SCB_K])
        | SCB_COUNTS := SCB_EXPANDING and ((SC_OUTER or ((SCB_NODE_NOW < ROW_COUNT and ROWS_LOOP[SCB_NODE_NOW] >= 0 and ROWS_OP[SCB_NODE_NOW] /= OP_SEED) and (SCB_S < ROW_COUNT and ROWS_LOOP[SCB_S] >= 0 and ROWS_OP[SCB_S] /= OP_SEED) and ROWS_LOOP[SCB_S] = ROWS_LOOP[SCB_NODE_NOW])) and (if SC_OUTER then ((if SCB_S < ROW_COUNT then ROWS_LOOP[SCB_S] < 0 else if SCB_S < SCHED_LOOP_BASE then NODE_KIND[SCB_S - ROW_COUNT] /= CLK_NONE else true) and not SKO_MARK[SCB_S]) else (((SCB_S < ROW_COUNT and ROWS_LOOP[SCB_S] >= 0 and ROWS_OP[SCB_S] /= OP_SEED) and (SKA_LOOP_POPS[ROWS_LOOP[SCB_S]] < LOOP_MEMBERS[ROWS_LOOP[SCB_S]])) and not SKB_MARK[SCB_S])))
        | SCB_NEW_DEC := SCB_DEC[?][SCB_S] + 1
        | SCB_DEC := SCB_DEC[?] next (if SCB_COUNTS then SCB_S else -1) : SCB_NEW_DEC
        | SCB_SUCC_PUSH := SCB_COUNTS and SC_OUTC[SCB_S] = SCB_NEW_DEC
        | SCB_POPS := not SCB_IN_INIT and not SCB_EXPANDING and SCB_TOP[?] > 0
        | SCB_POPPED := SCB_STACK[?][SCB_TOP[?] - 1]
        | SCB_PUSH := SCB_INIT_PUSH or SCB_SUCC_PUSH
        | SCB_STACK := SCB_STACK[?] next (if SCB_PUSH then SCB_TOP[?] else -1) : (if SCB_IN_INIT then SCB_INIT_NODE else SCB_S)
        | SCB_TOP := SCB_TOP[?] + integer(SCB_PUSH) - integer(SCB_POPS)
        | SCB_ORDER := SCB_ORDER[?] next (if SCB_POPS then SCB_COUNT[?] else -1) : SCB_POPPED
        | SCB_COUNT := SCB_COUNT[?] + integer(SCB_POPS)
        | SCB_PRESENT := SCB_PRESENT[?] + integer(SCB_INIT_PRESENT)
        | SCB_MARK := SCB_MARK[?] next (if SCB_POPS then SCB_POPPED else -1) : true
        | SCB_NODE := if SCB_POPS then SCB_POPPED else SCB_NODE_NOW
        | SCB_STEP := if SCB_POPS then 0 else SCB_K + integer(SCB_EXPANDING)
        | SCB_CURSOR := SCB_CURSOR[?] + integer(SCB_IN_INIT)
        |)
     with (| SCB_CURSOR := 0 | SCB_NODE := -1 | SCB_STEP := 0 | SCB_TOP := 0 | SCB_COUNT := 0 | SCB_PRESENT := 0 |)
     end
   | SM_INDEX := 0 .. (if SC_RUN then ROW_COUNT - 1 else -1)
   | iterate SM_INDEX of
       (| M_NODE := if SC_OUTER then (if SM_INDEX < ROW_COUNT and ROWS_LOOP[SM_INDEX] >= 0 then SCHED_LOOP_BASE + ROWS_LOOP[SM_INDEX] else SM_INDEX) else SM_INDEX
        | M_IN := (if SC_OUTER then ((if M_NODE < ROW_COUNT then ROWS_LOOP[M_NODE] < 0 else if M_NODE < SCHED_LOOP_BASE then NODE_KIND[M_NODE - ROW_COUNT] /= CLK_NONE else true) and not SKO_MARK[M_NODE]) else (((M_NODE < ROW_COUNT and ROWS_LOOP[M_NODE] >= 0 and ROWS_OP[M_NODE] /= OP_SEED) and (SKA_LOOP_POPS[ROWS_LOOP[M_NODE]] < LOOP_MEMBERS[ROWS_LOOP[M_NODE]])) and not SKB_MARK[M_NODE])) and not SCB_MARK[M_NODE] and (SC_OUTER or ROWS_LOOP[SM_INDEX] = SL_ERROR_LOOP)
        | M_OWNER := ROWS_OWNER[SM_INDEX]
        | M_OWNS := M_IN and M_OWNER >= 0
        | M_NEW := M_OWNS and not SM_SEEN[?][M_OWNER]
        | SM_SEEN := SM_SEEN[?] next (if M_OWNS then M_OWNER else -1) : true
        | M_EFFECT := M_IN and not M_OWNS and ROWS_OP[SM_INDEX] = OP_EFFECT
        | M_OWNER_SLOT := if M_NEW and SM_OWNERS[?] < CLOCK_NAME_CAP then SM_OWNERS[?] else -1
        | M_EFFECT_SLOT := if M_EFFECT and SM_EFFECTS[?] < CLOCK_NAME_CAP then SM_EFFECTS[?] else -1
        | M_ROW := if M_NEW then M_OWNER else SM_INDEX
        | M_KEY := (if ROWS_TOKEN[M_ROW] < 0 then long(16777217) else long(TOKEN_LINE[ROWS_TOKEN[M_ROW]]) * long(16777216) + long(TOKEN_COLUMN[ROWS_TOKEN[M_ROW]]))
        | SM_OWNER_ITEM_ROW := SM_OWNER_ITEM_ROW[?] next M_OWNER_SLOT : M_OWNER
        | SM_EFFECT_ITEM_ROW := SM_EFFECT_ITEM_ROW[?] next M_EFFECT_SLOT : SM_INDEX
        | SM_EFFECT_ITEM_KEY := SM_EFFECT_ITEM_KEY[?] next M_EFFECT_SLOT : M_KEY
        | SM_EFFECTS := SM_EFFECTS[?] + integer(M_EFFECT)
        | SM_OWNERS := SM_OWNERS[?] + integer(M_NEW)
        | M_SELF_KEY := (if ROWS_TOKEN[SM_INDEX] < 0 then long(16777217) else long(TOKEN_LINE[ROWS_TOKEN[SM_INDEX]]) * long(16777216) + long(TOKEN_COLUMN[ROWS_TOKEN[SM_INDEX]]))
        | M_OWNER_BETTER := M_NEW and M_KEY < SM_OWNER_KEY[?]
        | SM_OWNER_KEY := if M_OWNER_BETTER then M_KEY else SM_OWNER_KEY[?]
        | SM_OWNER_TOKEN := if M_OWNER_BETTER then ROWS_TOKEN[M_ROW] else SM_OWNER_TOKEN[?]
        | M_EFFECT_BETTER := M_EFFECT and M_KEY < SM_EFFECT_KEY[?]
        | SM_EFFECT_KEY := if M_EFFECT_BETTER then M_KEY else SM_EFFECT_KEY[?]
        | SM_EFFECT_TOKEN := if M_EFFECT_BETTER then ROWS_TOKEN[M_ROW] else SM_EFFECT_TOKEN[?]
        | M_ROW_BETTER := M_IN and M_SELF_KEY < SM_ROW_KEY[?]
        | SM_ROW_KEY := if M_ROW_BETTER then M_SELF_KEY else SM_ROW_KEY[?]
        | SM_ROW_TOKEN := if M_ROW_BETTER then ROWS_TOKEN[SM_INDEX] else SM_ROW_TOKEN[?]
        |)
     with (| SM_EFFECTS := 0 | SM_OWNERS := 0 | SM_OWNER_KEY := long(9223372036854775807) | SM_OWNER_TOKEN := -1
           | SM_EFFECT_KEY := long(9223372036854775807) | SM_EFFECT_TOKEN := -1
           | SM_ROW_KEY := long(9223372036854775807) | SM_ROW_TOKEN := -1 |)
     end
   | SX_RUN := SC_OUTER
   | SXV_INDEX := 0 .. (if SX_RUN then (if ROW_COUNT < CLOCK_CAP then ROW_COUNT else CLOCK_CAP) - 1 else -1)
   | iterate SXV_INDEX of
       (| SPLIT_VARIABLE_ROW := SPLIT_VARIABLE_ROW[?] next VAR_OF_ROW[SXV_INDEX] - 1 : SXV_INDEX + 1
        |)
     end
   | SXN_INDEX := 0 .. (if SX_RUN then SCHED_NODES - 1 else -1)
   | iterate SXN_INDEX of
       (| XN_CORE := (if SXN_INDEX < ROW_COUNT then ROWS_LOOP[SXN_INDEX] < 0
                      else if SXN_INDEX < SCHED_LOOP_BASE then NODE_KIND[SXN_INDEX - ROW_COUNT] /= CLK_NONE else true)
                     and not SKO_MARK[SXN_INDEX] and not SCB_MARK[SXN_INDEX]
        | XN_SLOT := if XN_CORE and CORE_COUNT[?] < CORE_CAP then CORE_COUNT[?] else -1
        | CORE_NODE := CORE_NODE[?] next XN_SLOT : SXN_INDEX
        | CORE_OF1 := CORE_OF1[?] next (if XN_CORE then SXN_INDEX else -1) : CORE_COUNT[?] + 1
        | CORE_COUNT := CORE_COUNT[?] + integer(XN_CORE)
        | CORE_LOOPS := CORE_LOOPS[?] or XN_CORE and SXN_INDEX >= SCHED_LOOP_BASE
        |)
     with (| CORE_COUNT := 0 | CORE_LOOPS := false |)
     end
   | SDC_BOUND := long(FLAT_DEPENDENCE_COUNT) * long(FLAT_GROUP_COUNT)
   | SDC_INDEX := 0 .. (if SX_RUN then SDC_BOUND - long(1) else long(-1))
   | iterate SDC_INDEX of
       (| DC_D := SDC_INDEX / FLAT_GROUP_COUNT
        | DC_G := SDC_INDEX modulo FLAT_GROUP_COUNT
        | DC_MATCHES := FLAT_DEPENDENCE_CONDITION[DC_D] >= 0 and FLAT_GROUP_PARSE[DC_G] = FLAT_DEPENDENCE_CONDITION[DC_D]
                        and FLAT_GROUP_INSTANCE[DC_G] = FLAT_DEPENDENCE_INSTANCE[DC_D]
        | DEPENDENCE_CONDITION_ROW := DEPENDENCE_CONDITION_ROW[?] next (if DC_MATCHES then DC_D else -1)
                                      : GROUP_MEMBER_ROW[FLAT_GROUP_MEMBER_FIRST[DC_G]] + 1
        |)
     end
   | SPLIT_FITS := SX_RUN and not CORE_LOOPS and CORE_COUNT <= CORE_CAP
   | SXE_INDEX := 0 .. (if SPLIT_FITS then SO_COUNT - 1 else -1)
   | iterate SXE_INDEX of
       (| XE_A := CORE_OF1[SO_FROM[SXE_INDEX]] - 1
        | XE_B := CORE_OF1[SO_TO[SXE_INDEX]] - 1
        | XE_KEEPS := XE_A >= 0 and XE_B >= 0
        | XE_ORIGIN := SO_ORIGIN[SXE_INDEX]
        | XE_IN_ROWS := XE_ORIGIN < 3 * ROW_COUNT
        | XE_IN_DEPS := XE_ORIGIN >= SE_CLOCK_END and XE_ORIGIN < SE_DEP_END
        | XE_ROW := if XE_IN_ROWS then XE_ORIGIN / 3 else 0
        | XE_SUB := XE_ORIGIN modulo 3
        | XE_OP := ROWS_OP[XE_ROW]
        | XE_LEFT := ROWS_LEFT[XE_ROW]
        | XE_ROW_CLOCK := CLOCK_REP[XE_ROW]
        | XE_LEFT_CLOCK := CLOCK_REP[if XE_LEFT >= 0 then XE_LEFT else 0]
        | XE_ARM := XE_IN_ROWS and XE_SUB > 0 and XE_OP /= OP_SEED
        | XE_RIGHT_ARM := XE_ARM and XE_SUB = 2 and XE_OP = OP_DEFAULT and NODE_KIND[XE_LEFT_CLOCK] /= CLK_NONE
        | XE_FLAT := DEPENDENCE_FLAT[if XE_IN_DEPS then XE_ORIGIN - SE_CLOCK_END else 0]
        | XC_ROW_0 := (if XE_IN_DEPS and XE_FLAT >= 0 then DEPENDENCE_CONDITION_ROW[if XE_FLAT >= 0 then XE_FLAT else 0] else 0) - 1
        | XC_FROM := if XC_ROW_0 >= 0 then XC_ROW_0 else 0
        | XC_ROW_1 := if ROWS_OP[XC_FROM] = OP_NOT or ROWS_OP[XC_FROM] = OP_COPY or ROWS_OP[XC_FROM] = OP_WHEN then ROWS_LEFT[XC_FROM] else XC_FROM
        | XC_NOT_1 := ROWS_OP[XC_FROM] = OP_NOT
        | XC_ROW_2 := if ROWS_OP[XC_ROW_1] = OP_NOT or ROWS_OP[XC_ROW_1] = OP_COPY or ROWS_OP[XC_ROW_1] = OP_WHEN then ROWS_LEFT[XC_ROW_1] else XC_ROW_1
        | XC_NOT_2 := XC_NOT_1 /= (ROWS_OP[XC_ROW_1] = OP_NOT)
        | XC_ROW_3 := if ROWS_OP[XC_ROW_2] = OP_NOT or ROWS_OP[XC_ROW_2] = OP_COPY or ROWS_OP[XC_ROW_2] = OP_WHEN then ROWS_LEFT[XC_ROW_2] else XC_ROW_2
        | XC_NOT_3 := XC_NOT_2 /= (ROWS_OP[XC_ROW_2] = OP_NOT)
        | XC_ROW_4 := if ROWS_OP[XC_ROW_3] = OP_NOT or ROWS_OP[XC_ROW_3] = OP_COPY or ROWS_OP[XC_ROW_3] = OP_WHEN then ROWS_LEFT[XC_ROW_3] else XC_ROW_3
        | XC_NOT_4 := XC_NOT_3 /= (ROWS_OP[XC_ROW_3] = OP_NOT)
        | XC_ROW_5 := if ROWS_OP[XC_ROW_4] = OP_NOT or ROWS_OP[XC_ROW_4] = OP_COPY or ROWS_OP[XC_ROW_4] = OP_WHEN then ROWS_LEFT[XC_ROW_4] else XC_ROW_4
        | XC_NOT_5 := XC_NOT_4 /= (ROWS_OP[XC_ROW_4] = OP_NOT)
        | XC_ROW_6 := if ROWS_OP[XC_ROW_5] = OP_NOT or ROWS_OP[XC_ROW_5] = OP_COPY or ROWS_OP[XC_ROW_5] = OP_WHEN then ROWS_LEFT[XC_ROW_5] else XC_ROW_5
        | XC_NOT_6 := XC_NOT_5 /= (ROWS_OP[XC_ROW_5] = OP_NOT)
        | XC_ROW_7 := if ROWS_OP[XC_ROW_6] = OP_NOT or ROWS_OP[XC_ROW_6] = OP_COPY or ROWS_OP[XC_ROW_6] = OP_WHEN then ROWS_LEFT[XC_ROW_6] else XC_ROW_6
        | XC_NOT_7 := XC_NOT_6 /= (ROWS_OP[XC_ROW_6] = OP_NOT)
        | XC_ROW_8 := if ROWS_OP[XC_ROW_7] = OP_NOT or ROWS_OP[XC_ROW_7] = OP_COPY or ROWS_OP[XC_ROW_7] = OP_WHEN then ROWS_LEFT[XC_ROW_7] else XC_ROW_7
        | XC_NOT_8 := XC_NOT_7 /= (ROWS_OP[XC_ROW_7] = OP_NOT)
        | XC_VAR := VAR_OF_ROW[XC_ROW_8] - 1
        | XE_LITERAL := XC_ROW_0 >= 0 and XC_VAR >= 0
        | XE_SLOT := if XE_KEEPS and CORE_EDGES[?] < CORE_EDGE_CAP then CORE_EDGES[?] else -1
        | CORE_EDGE_FROM := CORE_EDGE_FROM[?] next XE_SLOT : XE_A
        | CORE_EDGE_TO := CORE_EDGE_TO[?] next XE_SLOT : XE_B
        | CORE_EDGE_F := CORE_EDGE_F[?] next XE_SLOT
                         : (if XE_ARM then (if NODE_KIND[XE_ROW_CLOCK] = CLK_NONE then 1 else CLOCK_BDD[XE_ROW_CLOCK])
                            else if XE_LITERAL and not XC_NOT_8 then 2 + XC_VAR else 1)
        | CORE_EDGE_G := CORE_EDGE_G[?] next XE_SLOT
                         : (if XE_RIGHT_ARM then CLOCK_BDD[XE_LEFT_CLOCK] else if XE_LITERAL and XC_NOT_8 then 2 + XC_VAR else 0)
        | CORE_EDGES := CORE_EDGES[?] + integer(XE_KEEPS)
        |)
     with CORE_EDGES := 0
     end
   | SPLIT_RUN := SPLIT_FITS and CORE_EDGES <= CORE_EDGE_CAP and not SKB_FAILED
   | SPLIT_BOUND := long(SPLIT_FRAMES) * (long(CORE_EDGES) * long(SAT_CAP + 2 * WALK_CAP + 9)
                    + long(CORE_COUNT + 1) * long(CORE_EDGES + CORE_COUNT + 3) + long(2 * SPLIT_CAP + 8)) + long(8)
   | SPLIT_INDEX := 0 .. (if SPLIT_RUN then SPLIT_BOUND else long(-1))
   | iterate SPLIT_INDEX of
       (| SP_NOW := SP_PH[?]
        | SP_FRAME_NOW := SP_FRAME[?]
        | SP_ROUND_NOW := SP_ROUND[?]
        | SP_DEPTH_NOW := SP_DEPTH[?]
        | SP_E_NOW := SP_E[?]
        | SP_J_NOW := SP_J[?]
        | SP_PLACED_NOW := SP_PLACED[?]
        | SP_BEST := BEST_OUT[?]
        | SP_BEST_IN := BEST_IN[?]
        | SP_PICK := if SP_BEST >= 0 then SP_BEST else SP_BEST_IN
        | SP_EDGES_END := SP_E_NOW >= CORE_EDGES
        | SP_EDGE := if SP_EDGES_END then 0 else SP_E_NOW
        | SP_EF := CORE_EDGE_F[SP_EDGE]
        | SP_EG := CORE_EDGE_G[SP_EDGE]
        | SP_EA := CORE_EDGE_FROM[SP_EDGE]
        | SP_EB := CORE_EDGE_TO[SP_EDGE]
        | SP_EDGE_LIVE := LIVE_STAMP[?][SP_EDGE] = SP_FRAME_NOW
        | SP_A_PLACED := PLACED_STAMP[?][SP_EA] = SP_FRAME_NOW
        | SP_B_PLACED := PLACED_STAMP[?][SP_EB] = SP_FRAME_NOW
        | AT_SP_START := SP_NOW = SPH_START
        | AT_SP_LIVE := SP_NOW = SPH_LIVE
        | AT_SP_BLOCK := SP_NOW = SPH_BLOCK
        | AT_SP_PLACE := SP_NOW = SPH_PLACE
        | AT_SP_PICK := SP_NOW = SPH_PICK
        | AT_SP_RECORD := SP_NOW = SPH_RECORD
        | AT_SP_UNWIND := SP_NOW = SPH_UNWIND
        | LV_BEGINS := AT_SP_LIVE and not SP_EDGES_END and not SP_STARTED[?]
        | LV_EVALUATES := AT_SP_LIVE and not SP_EDGES_END and SP_STARTED[?]
        | LV_TOP := SAT_TOP[?]
        | LV_A := CUR_A[?]
        | LV_B := CUR_B[?]
        | LV_C := CUR_C[?]
        | LV_A_INTERIOR := LV_A - BDD_INTERIOR
        | LV_B_INTERIOR := LV_B - BDD_INTERIOR
        | LV_C_INTERIOR := LV_C - BDD_INTERIOR
        | LV_A_VAR := if LV_A < 2 then CLOCK_CAP else if LV_A_INTERIOR < 0 then LV_A - 2 else BDD_VAR[if LV_A_INTERIOR >= 0 then LV_A_INTERIOR else 0]
        | LV_B_VAR := if LV_B < 2 then CLOCK_CAP else if LV_B_INTERIOR < 0 then LV_B - 2 else BDD_VAR[if LV_B_INTERIOR >= 0 then LV_B_INTERIOR else 0]
        | LV_C_VAR := if LV_C < 2 then CLOCK_CAP else if LV_C_INTERIOR < 0 then LV_C - 2 else BDD_VAR[if LV_C_INTERIOR >= 0 then LV_C_INTERIOR else 0]
        | LV_AB_VAR := if LV_A_VAR < LV_B_VAR then LV_A_VAR else LV_B_VAR
        | LV_V := if LV_C_VAR < LV_AB_VAR then LV_C_VAR else LV_AB_VAR
        | LV_A_LOW := if LV_A_VAR /= LV_V then LV_A else if LV_A_INTERIOR < 0 then 0 else BDD_LOW[if LV_A_INTERIOR >= 0 then LV_A_INTERIOR else 0]
        | LV_A_HIGH := if LV_A_VAR /= LV_V then LV_A else if LV_A_INTERIOR < 0 then 1 else BDD_HIGH[if LV_A_INTERIOR >= 0 then LV_A_INTERIOR else 0]
        | LV_B_LOW := if LV_B_VAR /= LV_V then LV_B else if LV_B_INTERIOR < 0 then 0 else BDD_LOW[if LV_B_INTERIOR >= 0 then LV_B_INTERIOR else 0]
        | LV_B_HIGH := if LV_B_VAR /= LV_V then LV_B else if LV_B_INTERIOR < 0 then 1 else BDD_HIGH[if LV_B_INTERIOR >= 0 then LV_B_INTERIOR else 0]
        | LV_C_LOW := if LV_C_VAR /= LV_V then LV_C else if LV_C_INTERIOR < 0 then 0 else BDD_LOW[if LV_C_INTERIOR >= 0 then LV_C_INTERIOR else 0]
        | LV_C_HIGH := if LV_C_VAR /= LV_V then LV_C else if LV_C_INTERIOR < 0 then 1 else BDD_HIGH[if LV_C_INTERIOR >= 0 then LV_C_INTERIOR else 0]
        | LV_VALUE := if LV_V < CLOCK_CAP then VAR_VALUE[?][if LV_V < CLOCK_CAP then LV_V else 0] else 0
        | LV_DEAD := LV_A = 0 or LV_B = 1 or LV_C = 0
        | LV_SAT := LV_A = 1 and LV_B = 0 and LV_C = 1
        | LV_SPLITS := not LV_DEAD and not LV_SAT and LV_VALUE = 0
        | LV_LIVE := LV_EVALUATES and (LV_SAT or not LV_DEAD and (SAT_STEPS[?] >= SAT_CAP or LV_SPLITS and LV_TOP >= SAT_CAP))
        | LV_EDGE_ENDS := LV_LIVE or LV_EVALUATES and LV_DEAD and LV_TOP = 0
        | LV_POPS := LV_EVALUATES and not LV_EDGE_ENDS and LV_DEAD
        | LV_PUSHES := LV_EVALUATES and not LV_EDGE_ENDS and LV_SPLITS
        | LV_FOLLOWS := LV_EVALUATES and not LV_EDGE_ENDS and not LV_DEAD and LV_VALUE /= 0
        | LV_POP_AT := if LV_TOP > 0 then LV_TOP - 1 else 0
        | SAT_A := SAT_A[?] next (if LV_PUSHES then LV_TOP else -1) : LV_A_HIGH
        | SAT_B := SAT_B[?] next (if LV_PUSHES then LV_TOP else -1) : LV_B_HIGH
        | SAT_C := SAT_C[?] next (if LV_PUSHES then LV_TOP else -1) : LV_C_HIGH
        | CUR_A := if LV_BEGINS then SP_EF else if LV_POPS then SAT_A[?][LV_POP_AT] else if LV_PUSHES then LV_A_LOW
                   else if LV_FOLLOWS then (if LV_VALUE = 2 then LV_A_HIGH else LV_A_LOW) else LV_A
        | CUR_B := if LV_BEGINS then SP_EG else if LV_POPS then SAT_B[?][LV_POP_AT] else if LV_PUSHES then LV_B_LOW
                   else if LV_FOLLOWS then (if LV_VALUE = 2 then LV_B_HIGH else LV_B_LOW) else LV_B
        | CUR_C := if LV_BEGINS then CK_CARE else if LV_POPS then SAT_C[?][LV_POP_AT] else if LV_PUSHES then LV_C_LOW
                   else if LV_FOLLOWS then (if LV_VALUE = 2 then LV_C_HIGH else LV_C_LOW) else LV_C
        | SAT_TOP := if LV_BEGINS then 0 else LV_TOP + integer(LV_PUSHES) - integer(LV_POPS)
        | SAT_STEPS := if LV_BEGINS then 0 else SAT_STEPS[?] + integer(LV_EVALUATES)
        | SP_STARTED := if LV_BEGINS then true else if LV_EDGE_ENDS or AT_SP_START then false else SP_STARTED[?]
        | LIVE_STAMP := LIVE_STAMP[?] next (if LV_LIVE then SP_EDGE else -1) : SP_FRAME_NOW
        | BK_BLOCKS := AT_SP_BLOCK and not SP_EDGES_END and SP_EDGE_LIVE and not SP_A_PLACED
        | BLOCK_STAMP := BLOCK_STAMP[?] next (if BK_BLOCKS then SP_EB else -1) : SP_ROUND_NOW
        | PC_NODES_END := SP_J_NOW >= CORE_COUNT
        | PC_J := if PC_NODES_END then 0 else SP_J_NOW
        | PC_PLACES := AT_SP_PLACE and not PC_NODES_END and PLACED_STAMP[?][PC_J] /= SP_FRAME_NOW
                       and BLOCK_STAMP[?][PC_J] /= SP_ROUND_NOW
        | PLACED_STAMP := PLACED_STAMP[?] next (if PC_PLACES then PC_J else -1) : SP_FRAME_NOW
        | COPY_NODES := COPY_NODES[?] next (if PC_PLACES then SPLIT_COPIES[?] * CORE_COUNT + SP_PLACED_NOW else -1) : PC_J
        | SP_PLACED := if AT_SP_START then 0 else SP_PLACED_NOW + integer(PC_PLACES)
        | ROUND_PLACED := if AT_SP_BLOCK then 0 else ROUND_PLACED[?] + integer(PC_PLACES)
        | PC_ENDS := AT_SP_PLACE and PC_NODES_END
        | PC_COMPLETE := PC_ENDS and SP_PLACED_NOW = CORE_COUNT
        | PC_STUCK := PC_ENDS and not PC_COMPLETE and ROUND_PLACED[?] = 0
        | PC_AGAIN := PC_ENDS and not PC_COMPLETE and not PC_STUCK
        | PK_BLOCKED := SP_EDGE_LIVE and not SP_A_PLACED and not SP_B_PLACED
        | PK_SKIPS := AT_SP_PICK and not SP_EDGES_END and not PK_BLOCKED
        | PK_BEGINS := AT_SP_PICK and not SP_EDGES_END and PK_BLOCKED and not WK_STARTED[?]
        | PK_WALKS := AT_SP_PICK and not SP_EDGES_END and PK_BLOCKED and WK_STARTED[?]
        | WK_NOW := WK_NODE[?]
        | WK_SIDE := WK_ON_G[?]
        | WK_INTERIOR := WK_NOW - BDD_INTERIOR
        | WK_AT := if WK_INTERIOR >= 0 then WK_INTERIOR else 0
        | WK_VAR := if WK_NOW < 2 then CLOCK_CAP else if WK_INTERIOR < 0 then WK_NOW - 2 else BDD_VAR[WK_AT]
        | WK_LOW := if WK_INTERIOR < 0 then 0 else BDD_LOW[WK_AT]
        | WK_HIGH := if WK_INTERIOR < 0 then 1 else BDD_HIGH[WK_AT]
        | WK_VAR_AT := if WK_VAR < CLOCK_CAP then WK_VAR else 0
        | WK_VALUE := if WK_VAR < CLOCK_CAP then VAR_VALUE[?][WK_VAR_AT] else 0
        | WK_ROW := (if WK_VAR < CLOCK_CAP then SPLIT_VARIABLE_ROW[WK_VAR_AT] else 0) - 1
        | WK_STOPS := WK_NOW < 2 or WK_STEPS[?] >= WALK_CAP
        | WK_CANDIDATE := PK_WALKS and not WK_STOPS and WK_VALUE = 0 and WK_ROW >= 0
        | WK_OUTSIDE := ROWS_LOOP[if WK_ROW >= 0 then WK_ROW else 0] < 0 and SKO_MARK[if WK_ROW >= 0 then WK_ROW else 0]
        | WK_FINISHES := PK_WALKS and (WK_STOPS or WK_CANDIDATE)
        | PK_EDGE_ENDS := PK_SKIPS or WK_FINISHES and WK_SIDE
        | WK_NODE := if PK_BEGINS then (if WK_SIDE then SP_EG else SP_EF)
                     else if PK_WALKS and not WK_FINISHES then
                       (if WK_VALUE = 2 then WK_HIGH else if WK_VALUE = 1 then WK_LOW
                        else if WK_SIDE then (if WK_HIGH /= 1 then WK_HIGH else WK_LOW)
                        else if WK_HIGH /= 0 then WK_HIGH else WK_LOW)
                     else WK_NOW
        | WK_STARTED := if PK_BEGINS then true else if WK_FINISHES or PC_STUCK then false else WK_STARTED[?]
        | WK_ON_G := if PC_STUCK then false else if WK_FINISHES then not WK_SIDE else WK_SIDE
        | WK_STEPS := if PK_BEGINS then 0 else WK_STEPS[?] + integer(PK_WALKS)
        | BEST_OUT := if PC_STUCK then -1 else if WK_CANDIDATE and WK_OUTSIDE and (SP_BEST < 0 or WK_VAR < SP_BEST) then WK_VAR
                      else SP_BEST
        | BEST_IN := if PC_STUCK then -1 else if WK_CANDIDATE and not WK_OUTSIDE and (SP_BEST_IN < 0 or WK_VAR < SP_BEST_IN)
                     then WK_VAR else SP_BEST_IN
        | PK_DECIDES := AT_SP_PICK and SP_EDGES_END
        | PK_PUSHES := PK_DECIDES and SP_PICK >= 0 and SP_DEPTH_NOW < SPLIT_CAP
        | PK_CAPS := PK_DECIDES and SP_PICK >= 0 and SP_DEPTH_NOW >= SPLIT_CAP
        | PK_INSIDE_ONLY := PK_PUSHES and SP_BEST < 0
        | PK_GENUINE := PK_DECIDES and SP_PICK < 0
        | RC_I := SP_I[?]
        | RC_WRITES := AT_SP_RECORD and RC_I < SP_DEPTH_NOW
        | RC_ENDS := AT_SP_RECORD and RC_I >= SP_DEPTH_NOW
        | RC_VAR := DEC_VAR[?][if RC_WRITES then RC_I else 0]
        | COPY_LIT_VAR := COPY_LIT_VAR[?] next (if RC_WRITES then SPLIT_COPIES[?] * SPLIT_CAP + RC_I else -1) : RC_VAR
        | COPY_LIT_TRUE := COPY_LIT_TRUE[?] next (if RC_WRITES then SPLIT_COPIES[?] * SPLIT_CAP + RC_I else -1)
                           : VAR_VALUE[?][RC_VAR] = 2
        | COPY_DEPTH := COPY_DEPTH[?] next (if RC_ENDS then SPLIT_COPIES[?] else -1) : SP_DEPTH_NOW
        | SPLIT_COPIES := SPLIT_COPIES[?] + integer(RC_ENDS)
        | SP_I := if AT_SP_RECORD then RC_I + 1 else 0
        | UW_D := if SP_DEPTH_NOW > 0 then SP_DEPTH_NOW - 1 else 0
        | UW_VAR := DEC_VAR[?][UW_D]
        | UW_ENDS := AT_SP_UNWIND and SP_DEPTH_NOW = 0
        | UW_FLIPS := AT_SP_UNWIND and SP_DEPTH_NOW > 0 and not DEC_SECOND[?][UW_D]
        | UW_POPS := AT_SP_UNWIND and SP_DEPTH_NOW > 0 and DEC_SECOND[?][UW_D]
        | DEC_VAR := DEC_VAR[?] next (if PK_PUSHES then SP_DEPTH_NOW else -1) : SP_PICK
        | DEC_SECOND := DEC_SECOND[?] next (if PK_PUSHES then SP_DEPTH_NOW else if UW_FLIPS then UW_D else -1) : UW_FLIPS
        | VAR_VALUE := VAR_VALUE[?] next (if PK_PUSHES then SP_PICK else if UW_FLIPS or UW_POPS then UW_VAR else -1)
                       : (if PK_PUSHES then 2 else if UW_FLIPS then 1 else 0)
        | SP_DEPTH := SP_DEPTH_NOW + integer(PK_PUSHES) - integer(UW_POPS)
        | SPLIT_CAPPED := SPLIT_CAPPED[?] or PK_CAPS
        | SPLIT_INSIDE := SPLIT_INSIDE[?] or PK_INSIDE_ONLY
        | SPLIT_GENUINE := SPLIT_GENUINE[?] or PK_GENUINE
        | SP_PH := if AT_SP_START then SPH_LIVE
                   else if AT_SP_LIVE and SP_EDGES_END then SPH_BLOCK
                   else if AT_SP_BLOCK and SP_EDGES_END then SPH_PLACE
                   else if PC_COMPLETE then SPH_RECORD
                   else if PC_STUCK then SPH_PICK
                   else if PC_AGAIN then SPH_BLOCK
                   else if PK_PUSHES or UW_FLIPS then SPH_START
                   else if PK_CAPS or RC_ENDS then SPH_UNWIND
                   else if PK_GENUINE or UW_ENDS then SPH_DONE
                   else SP_NOW
        | SP_FRAME := SP_FRAME_NOW + integer(AT_SP_START)
        | SP_ROUND := SP_ROUND_NOW + integer(AT_SP_LIVE and SP_EDGES_END or PC_AGAIN)
        | SP_E := if AT_SP_START or AT_SP_LIVE and SP_EDGES_END or AT_SP_BLOCK and SP_EDGES_END or PC_ENDS then 0
                  else if LV_EDGE_ENDS or AT_SP_BLOCK or PK_EDGE_ENDS then SP_E_NOW + 1 else SP_E_NOW
        | SP_J := if AT_SP_PLACE and not PC_NODES_END then SP_J_NOW + 1 else 0
        |)
     with (| SP_PH := SPH_START | SP_FRAME := 0 | SP_ROUND := 0 | SP_DEPTH := 0 | SP_E := 0 | SP_J := 0 | SP_PLACED := 0
           | ROUND_PLACED := 0 | SP_STARTED := false | SAT_TOP := 0 | SAT_STEPS := 0 | CUR_A := 0 | CUR_B := 0 | CUR_C := 0
           | WK_NODE := 0 | WK_STARTED := false | WK_ON_G := false | WK_STEPS := 0 | BEST_OUT := -1 | BEST_IN := -1
           | SP_I := 0 | SPLIT_COPIES := 0 | SPLIT_CAPPED := false | SPLIT_INSIDE := false | SPLIT_GENUINE := false |)
     end
   | SPLIT_FINISHED := SP_PH = SPH_DONE
   | SPLIT_UNFINISHED := SPLIT_RUN and not SPLIT_FINISHED or SPLIT_ACCEPTED and FO_COUNT > SCHED_NODE_CAP
   | SPLIT_ACCEPTED := SPLIT_RUN and SPLIT_FINISHED and not SPLIT_GENUINE and not SPLIT_CAPPED and not SPLIT_INSIDE
   | SPLIT_MESSAGE := if not SPLIT_RUN or not SPLIT_FINISHED or SPLIT_GENUINE then 0 else if SPLIT_CAPPED then T_CYCLE_SPLIT
                      else if SPLIT_INSIDE then T_CYCLE_INSIDE else 0
   | FO_BOUND := SKO_COUNT + SPLIT_COPIES * (2 * SPLIT_CAP + CORE_COUNT + 1) + SCB_COUNT + 8
   | FO_INDEX := 0 .. (if SPLIT_ACCEPTED then FO_BOUND - 1 else -1)
   | iterate FO_INDEX of
       (| FO_NOW := FO_PH[?]
        | FO_A_NOW := FO_A[?]
        | FO_K_NOW := FO_K[?]
        | FO_Q_NOW := FO_Q[?]
        | FO_DEPTH := COPY_DEPTH[if FO_K_NOW < SPLIT_COPIES then FO_K_NOW else 0]
        | FO_PREFIX := FO_NOW = 0 and FO_A_NOW < SKO_COUNT
        | FO_IN_COPIES := FO_NOW = 1 and FO_K_NOW < SPLIT_COPIES
        | FO_LITERAL := FO_IN_COPIES and FO_Q_NOW < 2 * FO_DEPTH
        | FO_LIT := if FO_LITERAL then FO_K_NOW * SPLIT_CAP + FO_Q_NOW / 2 else 0
        | FO_NODE := FO_IN_COPIES and not FO_LITERAL and FO_Q_NOW < 2 * FO_DEPTH + CORE_COUNT
        | FO_NODE_AT := if FO_NODE then FO_K_NOW * CORE_COUNT + FO_Q_NOW - 2 * FO_DEPTH else 0
        | FO_CLOSE := FO_IN_COPIES and FO_Q_NOW >= 2 * FO_DEPTH + CORE_COUNT
        | FO_DONE := FO_NOW = 2
        | FO_DOWN := FO_NOW = 3 and FO_A_NOW < SCB_COUNT
        | FO_EMITS := FO_PREFIX or FO_IN_COPIES or FO_DONE or FO_DOWN
        | FO_VALUE := if FO_PREFIX then SKO_ORDER[if FO_PREFIX then FO_A_NOW else 0]
                      else if FO_LITERAL then
                        (if FO_Q_NOW modulo 2 = 0 then -1 - (ET_CYCLE_VALUE + ET_COUNT * (SPLIT_VARIABLE_ROW[if FO_LITERAL then COPY_LIT_VAR[FO_LIT] else 0] - 1))
                         else -1 - ((if COPY_LIT_TRUE[FO_LIT] then ET_CYCLE_JUMP_TRUE else ET_CYCLE_JUMP_FALSE) + ET_COUNT * FO_K_NOW))
                      else if FO_NODE then CORE_NODE[COPY_NODES[FO_NODE_AT]]
                      else if FO_CLOSE then -1 - (ET_CYCLE_CLOSE + ET_COUNT * FO_K_NOW)
                      else if FO_DONE then -1 - ET_CYCLE_DONE
                      else SCB_ORDER[if FO_DOWN then SCB_COUNT - 1 - FO_A_NOW else 0]
        | FINAL_ORDER := FINAL_ORDER[?] next (if FO_EMITS and FO_COUNT[?] < SCHED_NODE_CAP then FO_COUNT[?] else -1) : FO_VALUE
        | FO_COUNT := FO_COUNT[?] + integer(FO_EMITS)
        | FO_PH := if FO_NOW = 0 and not FO_PREFIX or FO_NOW = 1 and not FO_IN_COPIES or FO_DONE or FO_NOW = 3 and not FO_DOWN
                   then FO_NOW + 1 else FO_NOW
        | FO_A := if FO_PREFIX or FO_DOWN then FO_A_NOW + 1 else if FO_DONE then 0 else FO_A_NOW
        | FO_K := FO_K_NOW + integer(FO_CLOSE)
        | FO_Q := if FO_CLOSE then 0 else FO_Q_NOW + integer(FO_IN_COPIES)
        |)
     with (| FO_PH := 0 | FO_A := 0 | FO_K := 0 | FO_Q := 0 | FO_COUNT := 0 |)
     end
   | ORDER_COUNT := if SPLIT_ACCEPTED then FO_COUNT else SKO_COUNT
   | EF_E := SE_ECOUNT
   | EF_RUN := SCHED_GO and (not SKO_FAILED or SPLIT_ACCEPTED) and not SKB_FAILED and EF_E >= 2
   | EF_BOUND := long(EF_E) * long(SCHED_LOOP_BASE + SG_COUNT + SCHED_NODES + SO_COUNT + EF_E + 8) + long(EF_E) * long(EF_E) + long(2)
   | EF_INDEX := 0 .. (if EF_RUN then EF_BOUND else long(-1))
   | iterate EF_INDEX of
       (| F_I := EF_I[?]
        | F_PH := EF_PH[?]
        | F_ROW := SE_EROW[F_I]
        | F_RES := EFFECT_RESOURCE[integer(ROWS_VALUE[F_ROW])]
        | F_ACTIVE := RES_COUNT[F_RES] >= 2
        | F_STAMP := F_I + 1
        | F_SUP := (if F_ROW < ROW_COUNT and ROWS_LOOP[F_ROW] >= 0 then SCHED_LOOP_BASE + ROWS_LOOP[F_ROW] else F_ROW)
        | F_START1 := F_PH = 0 and F_I < EF_E and F_ACTIVE
        | F_SKIP := F_PH = 0 and F_I < EF_E and not F_ACTIVE
        | F_TO_PAIRS := F_PH = 0 and F_I >= EF_E
        | F_START2 := F_PH = 2
        | F_DFS := F_PH = 1 or F_PH = 3
        | F_NODE := EF_NODE[?]
        | F_K := EF_K[?]
        | F_LEN := if F_NODE < 0 then 0 else if F_PH = 1 then SG_START[F_NODE + 1] - SG_START[F_NODE]
                 else SO_START[F_NODE + 1] - SO_START[F_NODE]
        | F_EXPANDING := F_DFS and F_K < F_LEN
        | F_S := if F_PH = 1 then SG_SUCC[SG_START[F_NODE] + F_K] else SO_SUCC[SO_START[F_NODE] + F_K]
        | F_VISITS := F_EXPANDING and (if F_PH = 1 then VIS1[?][F_S] else VIS2[?][F_S]) /= F_STAMP
        | F_POPS := F_DFS and not F_EXPANDING and EF_TOP[?] > 0
        | F_DFS_ENDS := F_DFS and not F_EXPANDING and EF_TOP[?] = 0
        | F_PUSH := F_START1 or F_START2 or F_VISITS
        | F_PUSHED := if F_START1 then F_ROW else if F_START2 then F_SUP else F_S
        | VIS1 := VIS1[?] next (if F_START1 or F_VISITS and F_PH = 1 then F_PUSHED else -1) : F_STAMP
        | VIS2 := VIS2[?] next (if F_START2 or F_VISITS and F_PH = 3 then F_PUSHED else -1) : F_STAMP
        | EF_STACK := EF_STACK[?] next (if F_PUSH then EF_TOP[?] else -1) : F_PUSHED
        | EF_TOP := EF_TOP[?] + integer(F_PUSH) - integer(F_POPS)
        | F_SCAN := F_PH = 4
        | F_J := EF_J[?]
        | F_JROW := SE_EROW[F_J]
        | F_JSUP := (if F_JROW < ROW_COUNT and ROWS_LOOP[F_JROW] >= 0 then SCHED_LOOP_BASE + ROWS_LOOP[F_JROW] else F_JROW)
        | F_REACHED := VIS1[?][F_JROW] = F_STAMP or F_JSUP /= F_SUP and VIS2[?][F_JSUP] = F_STAMP
        | EF_ORDERED := EF_ORDERED[?] next (if F_SCAN then F_I * EF_E + F_J else -1) : F_REACHED
        | F_SCAN_ENDS := F_SCAN and F_J = EF_E - 1
        | F_PAIRS := F_PH = 5
        | F_PI := F_J / EF_E
        | F_PJ := F_J modulo EF_E
        | F_PAIR_FAILS := F_PAIRS and F_PI < F_PJ
                        and EFFECT_RESOURCE[integer(ROWS_VALUE[SE_EROW[F_PI]])] = EFFECT_RESOURCE[integer(ROWS_VALUE[SE_EROW[F_PJ]])]
                        and not EF_ORDERED[?][F_PI * EF_E + F_PJ] and not EF_ORDERED[?][F_PJ * EF_E + F_PI]
        | F_PAIRS_END := F_PAIRS and (F_PAIR_FAILS or F_J = EF_E * EF_E - 1)
        | EF_FIRST := if F_PAIR_FAILS then F_PI else EF_FIRST[?]
        | EF_SECOND := if F_PAIR_FAILS then F_PJ else EF_SECOND[?]
        | EF_PH := if F_START1 then 1 else if F_SKIP then 0 else if F_TO_PAIRS then 5 else if F_START2 then 3
                 else if F_DFS_ENDS then F_PH + 1 else if F_SCAN_ENDS then 0 else if F_PAIRS_END then 6 else F_PH
        | EF_I := F_I + integer(F_SKIP or F_SCAN_ENDS)
        | EF_J := if F_SCAN or F_PAIRS then F_J + 1 else 0
        | EF_NODE := if F_POPS then EF_STACK[?][EF_TOP[?] - 1] else if F_DFS_ENDS or F_START1 or F_START2 then -1 else F_NODE
        | EF_K := if F_POPS then 0 else F_K + integer(F_EXPANDING)
        |)
     with (| EF_I := 0 | EF_PH := 0 | EF_J := 0 | EF_NODE := -1 | EF_K := 0 | EF_TOP := 0 | EF_FIRST := -1 | EF_SECOND := -1 |)
     end
   | EF_FAILED := EF_RUN and EF_FIRST >= 0
   | EF_UNFINISHED := EF_RUN and EF_PH /= 6
   | EF_FIRST_ROW := SE_EROW[EF_FIRST]
   | EF_SECOND_ROW := SE_EROW[EF_SECOND]
   | SCHEDULE_MESSAGE := if not SCHEDULE_RUN then 0 else if SCHED_OVERFLOW or SPLIT_UNFINISHED then T_CAPACITY
                       else if SC_RUN and not SPLIT_ACCEPTED then
                         (if SM_OWNERS > 0 then (if SPLIT_MESSAGE /= 0 then SPLIT_MESSAGE else T_SIGNAL_CYCLE)
                          else if SM_EFFECTS > 0 then T_EFFECT_CYCLE
                                            else T_CLOCK_CAUSALITY)
                       else if EF_FAILED then T_EFFECTS_UNORDERED else if EF_UNFINISHED then T_CAPACITY else 0
   | SCHEDULE_TOKEN := if SCHEDULE_MESSAGE = T_SIGNAL_CYCLE or SCHEDULE_MESSAGE = T_CYCLE_SPLIT or SCHEDULE_MESSAGE = T_CYCLE_INSIDE
                       then SM_OWNER_TOKEN
                     else if SCHEDULE_MESSAGE = T_EFFECT_CYCLE then SM_EFFECT_TOKEN
                     else if SCHEDULE_MESSAGE = T_CLOCK_CAUSALITY then SM_ROW_TOKEN
                     else if SCHEDULE_MESSAGE = T_EFFECTS_UNORDERED then ROWS_TOKEN[EF_SECOND_ROW] else -1
   | SCHEDULE_ARGUMENT0 := if SCHED_NODES >= SCHED_NODE_CAP then F_CAP_SCHEDULE_NODES
                         else if SE_ECOUNT > EFFECT_ORDER_CAP then F_CAP_EFFECTS
                         else if not SCHED_OVERFLOW and SPLIT_UNFINISHED then F_CAP_SPLIT
                         else if EF_UNFINISHED then F_CAP_EFFECT_ORDER else F_CAP_EDGES
   | SCHEDULE_READY := SCHEDULE_RUN and SCHEDULE_MESSAGE = 0
   | SWS_INDEX := 0 .. (if SCHEDULE_READY and SKB_RUN then WAR_COUNT - 1 else -1)
   | iterate SWS_INDEX of
       (| WS_READER := WAR_READER[SWS_INDEX]
        | WS_MARKS := (WS_READER < ROW_COUNT and ROWS_LOOP[WS_READER] >= 0 and ROWS_OP[WS_READER] /= OP_SEED) and (SKA_LOOP_POPS[ROWS_LOOP[WS_READER]] < LOOP_MEMBERS[ROWS_LOOP[WS_READER]])
        | WAR_SNAP1 := WAR_SNAP1[?] next (if WS_MARKS then WAR_SIGNAL[SWS_INDEX] else -1) : ROWS_LOOP[WS_READER] + 1
        |)
     end
   | SSC_INDEX := 0 .. (if SCHEDULE_READY then FLAT_SIGNAL_COUNT - 1 else -1)
   | iterate SSC_INDEX of
       (| C_L1 := if SNAP_GATHER1[SSC_INDEX] > 0 then SNAP_GATHER1[SSC_INDEX] else WAR_SNAP1[SSC_INDEX]
        | SNAP_LOOP_COUNT := SNAP_LOOP_COUNT[?] next C_L1 - 1 : SNAP_LOOP_COUNT[?][C_L1 - 1] + 1
        | SNAPPED_ALL := SNAPPED_ALL[?] next (if C_L1 > 0 then SNAP_TOTAL[?] else -1) : SSC_INDEX
        | SNAP_TOTAL := SNAP_TOTAL[?] + integer(C_L1 > 0)
        |)
     with SNAP_TOTAL := 0
     end
   | SNS_INDEX := 0 .. (if SCHEDULE_READY then LOOP_TOTAL - 1 else -1)
   | iterate SNS_INDEX of
       (| SNAP_START := SNAP_START[?] next SNS_INDEX : SNS_SUM[?]
        | SNS_SUM := SNS_SUM[?] + SNAP_LOOP_COUNT[SNS_INDEX]
        |)
     with SNS_SUM := 0
     end
   | SNP_INDEX := 0 .. (if SCHEDULE_READY then FLAT_SIGNAL_COUNT - 1 else -1)
   | iterate SNP_INDEX of
       (| N_L := (if SNAP_GATHER1[SNP_INDEX] > 0 then SNAP_GATHER1[SNP_INDEX] else WAR_SNAP1[SNP_INDEX]) - 1
        | SNAP_LIST := SNAP_LIST[?] next (if N_L >= 0 then SNAP_START[N_L] + SNAP_FILL[?][N_L] else -1) : SNP_INDEX
        | SNAP_FILL := SNAP_FILL[?] next N_L : SNAP_FILL[?][N_L] + 1
        |)
     end
   | LOP_INDEX := 0 .. (if SCHEDULE_READY and SKA_RUN then SKA_COUNT + SKB_COUNT - 1 else -1)
   | iterate LOP_INDEX of
       (| O_FIRST_RUN := LOP_INDEX < SKA_COUNT
        | O_NODE := if O_FIRST_RUN then SKA_ORDER[LOP_INDEX] else SKB_ORDER[LOP_INDEX - SKA_COUNT]
        | O_LOOP := ROWS_LOOP[O_NODE]
        | O_TAKES := O_LOOP >= 0 and (not O_FIRST_RUN or not (SKA_LOOP_POPS[O_LOOP] < LOOP_MEMBERS[O_LOOP]))
        | LO_LIST := LO_LIST[?] next (if O_TAKES then LO_START[O_LOOP] + LO_FILL[?][O_LOOP] else -1) : O_NODE
        | LO_FILL := LO_FILL[?] next (if O_TAKES then O_LOOP else -1) : LO_FILL[?][O_LOOP] + 1
        |)
     end
   | CODE_DUMP := DUMP_PASS = 7
   | EMIT_RUN := SCHEDULE_READY and (DUMP_PASS = 0 or CODE_DUMP)
   | XT_TOTAL := TYPE_COUNT + NEW_TYPE_COUNT
   | XT_INDEX := 0 .. (if EMIT_RUN then XT_TOTAL - 1 else -1)
   | iterate XT_INDEX of
       (| XT_NEW := XT_INDEX >= TYPE_COUNT
        | XT_NEW_SLOT := if XT_NEW then XT_INDEX - TYPE_COUNT else 0
        | XT_OLD_SLOT := if XT_NEW then 0 else XT_INDEX
        | XT_ELEMENT_NOW := if XT_NEW then NEW_TYPE_ELEMENT[XT_NEW_SLOT] else TYPE_ELEMENT[XT_OLD_SLOT]
        | XT_INNER := XT_ELEMENT_NOW >= 0 and (XT_ELEMENT_NOW < TYPE_COUNT and TYPE_KIND[XT_ELEMENT_NOW] = TK_ARRAY
                                                or XT_ELEMENT_NOW >= TYPE_COUNT and XT_ELEMENT_NOW < XT_INDEX)
        | XT_LEAF_NOW := if XT_INNER then XT_ELEMENT[?][XT_ELEMENT_NOW] else XT_ELEMENT_NOW
        | XT_EB_NOW := if XT_LEAF_NOW >= 0 and XT_LEAF_NOW < TYPE_COUNT then TYPE_BYTES[XT_LEAF_NOW] else 8
        | XT_SIZE_NOW := (if XT_NEW then NEW_TYPE_SIZE[XT_NEW_SLOT] else TYPE_SIZE[XT_OLD_SLOT])
                         * (if XT_INNER then XT_SIZE[?][XT_ELEMENT_NOW] else ulong(1))
        | XT_PER := ulong(if XT_EB_NOW > 0 and XT_EB_NOW <= 8 then 8 / XT_EB_NOW else 1)
        | XT_KIND := XT_KIND[?] next XT_INDEX : (if XT_NEW then TK_ARRAY else TYPE_KIND[XT_OLD_SLOT])
        | XT_BLOCK := XT_BLOCK[?] next XT_INDEX : XT_NEW or TYPE_KIND[XT_OLD_SLOT] = TK_ARRAY or TYPE_KIND[XT_OLD_SLOT] = TK_STRING
        | XT_BYTES := XT_BYTES[?] next XT_INDEX : (if XT_NEW then 8 else TYPE_BYTES[XT_OLD_SLOT])
        | XT_SIGNED := XT_SIGNED[?] next XT_INDEX : not XT_NEW and TYPE_SIGNED[XT_OLD_SLOT]
        | XT_ELEMENT := XT_ELEMENT[?] next XT_INDEX : (if XT_LEAF_NOW >= 0 then XT_LEAF_NOW else 0)
        | XT_EB := XT_EB[?] next XT_INDEX : XT_EB_NOW
        | XT_SIZE := XT_SIZE[?] next XT_INDEX : XT_SIZE_NOW
        | XT_WORDS := XT_WORDS[?] next XT_INDEX : XT_SIZE_NOW / XT_PER + ulong(integer(XT_SIZE_NOW modulo XT_PER /= ulong(0)))
        |)
     end
   | XT_LAST_SIGNED := XT_SIGNED[XT_TOTAL - 1]
   | FW_INDEX := 0 .. (if EMIT_RUN then ROW_COUNT - 1 else -1)
   | iterate FW_INDEX of
       (| FW_OP := ROWS_OP[FW_INDEX]
        | FW_OWNER := ROWS_OWNER[FW_INDEX]
        | FW_FILLS := FW_OWNER >= 0 and (FW_OP = OP_GATHER or FW_OP = OP_NEXT or FW_OP = OP_SLICE or FW_OP = OP_PUT
                                         or FW_OP = OP_RESTRUCTURE or FW_OP = OP_CONCAT or FW_OP = OP_EACH_STORE or FW_OP = OP_TRANSPOSE
                                         or FW_OP = OP_MATPROD and XT_KIND[ROWS_TYPE[FW_INDEX]] = TK_ARRAY
                                         or (FW_OP = OP_DEFAULT or FW_OP = OP_IF or FW_OP = OP_EFFECT) and XT_BLOCK[ROWS_TYPE[FW_INDEX]])
        | FW_EFFECT_KIND := if FW_OP = OP_EFFECT then EFFECT_KIND[integer(ROWS_VALUE[FW_INDEX])] else -1
        | IO_COUNT := IO_COUNT[?] + integer(FW_EFFECT_KIND = N_READ or FW_EFFECT_KIND = N_WRITE or FW_EFFECT_KIND = N_WRITE_STRING)
        | READ_COUNT := READ_COUNT[?] + integer(FW_EFFECT_KIND = N_READ)
        | OWNER_FILLED := OWNER_FILLED[?] next (if FW_FILLS then FW_OWNER else -1) : true
        | FW_LAGS := FW_OP = OP_LAG or FW_OP = OP_WINDOW
        | FW_VALUED := FW_OP = OP_WINDOW or FW_OP = OP_LAG and XT_BLOCK[ROWS_TYPE[FW_INDEX]]
        | FW_SEEDS := FW_LAGS and ROWS_INIT[FW_INDEX] > 0
        | LAG_LIST := LAG_LIST[?] next (if FW_LAGS then LAG_COUNT[?] else -1) : FW_INDEX
        | LAG_COUNT := LAG_COUNT[?] + integer(FW_LAGS)
        | LAG_VLIST := LAG_VLIST[?] next (if FW_VALUED then LAG_VCOUNT[?] else -1) : FW_INDEX
        | LAG_VCOUNT := LAG_VCOUNT[?] + integer(FW_VALUED)
        | LAG_SEED_LIST := LAG_SEED_LIST[?] next (if FW_SEEDS then LAG_SEED_COUNT[?] else -1) : FW_INDEX
        | LAG_SEED_COUNT := LAG_SEED_COUNT[?] + integer(FW_SEEDS)
        |)
     with (| LAG_COUNT := 0 | LAG_VCOUNT := 0 | LAG_SEED_COUNT := 0 | IO_COUNT := 0 | READ_COUNT := 0 |)
     end
   | EA_INDEX := 0 .. (if EMIT_RUN then 2 * FLAT_SIGNAL_COUNT - 1 else -1)
   | iterate EA_INDEX of
       (| EA_SIGNAL := EA_INDEX / 2
        | EA_PRIMARY := EA_INDEX modulo 2 = 0
        | EA_ROW := if EA_PRIMARY then EA_SIGNAL else CX_IMAG[EA_SIGNAL] - 1
        | EA_LISTS := EA_PRIMARY or EA_ROW >= 0
        | EA_SOURCE := FLAT_SIGNAL_SOURCE[EA_SIGNAL]
        | EA_ROLE := if FLAT_SIGNAL_INSTANCE[EA_SIGNAL] > 0 then ROLE_LOCAL
                     else if EA_SOURCE < 0 then FINISH_SIGNAL_ROLE[-EA_SOURCE - 1] else SIGNAL_ROLE[EA_SOURCE]
        | EA_EVENT := XT_KIND[ROWS_TYPE[EA_SIGNAL]] = TK_EVENT
        | EA_LEFT := ROWS_LEFT[EA_SIGNAL]
        | EA_WINDOW := EA_LISTS and (ROWS_OP[EA_SIGNAL] = OP_COPY and EA_LEFT >= 0 and OWNER_FILLED[EA_ROW_SAFE]
                                     or ROWS_OP[EA_SIGNAL] = OP_INPUT and XT_KIND[ROWS_TYPE[EA_ROW_SAFE]] = TK_ARRAY)
        | EA_ROW_SAFE := if EA_ROW >= 0 then EA_ROW else 0
        | EA_INPUT := EA_ROLE = ROLE_INPUT
        | EA_VALUE_INPUT := EA_LISTS and EA_INPUT and not EA_EVENT
        | EA_OUTPUT := EA_LISTS and EA_ROLE = ROLE_OUTPUT
        | WIN_A1 := WIN_A1[?] next (if EA_WINDOW then EA_ROW else -1) : WIN_A_COUNT[?] + 1
        | WIN_SIGNAL := WIN_SIGNAL[?] next (if EA_WINDOW then WIN_A_COUNT[?] else -1) : EA_ROW
        | WIN_A_COUNT := WIN_A_COUNT[?] + integer(EA_WINDOW)
        | VI_LIST := VI_LIST[?] next (if EA_VALUE_INPUT then VI_COUNT[?] else -1) : EA_ROW
        | VI_COUNT := VI_COUNT[?] + integer(EA_VALUE_INPUT)
        | VI_ELEMENTS := VI_ELEMENTS[?]
                         + (if not EA_VALUE_INPUT then long(0) else if XT_KIND[ROWS_TYPE[EA_SIGNAL]] = TK_ARRAY then long(XT_SIZE[ROWS_TYPE[EA_SIGNAL]]) else long(1))
        | EMIT_INPUT_COUNT := EMIT_INPUT_COUNT[?] + integer(EA_PRIMARY and EA_INPUT)
        | OUT_LIST := OUT_LIST[?] next (if EA_OUTPUT then OUT_COUNT[?] else -1) : EA_ROW
        | OUT_COUNT := OUT_COUNT[?] + integer(EA_OUTPUT)
        | OUT_ELEMENTS := OUT_ELEMENTS[?]
                          + (if not EA_OUTPUT then 0 else if XT_KIND[ROWS_TYPE[EA_SIGNAL]] = TK_ARRAY then integer(XT_SIZE[ROWS_TYPE[EA_SIGNAL]]) else 1)
        | SIG_ONE := SIG_ONE[?] next (if EA_PRIMARY and EA_INPUT and EA_EVENT then EA_SIGNAL else -1) : true
        |)
     with (| WIN_A_COUNT := 0 | VI_COUNT := 0 | VI_ELEMENTS := long(0) | EMIT_INPUT_COUNT := 0 | OUT_COUNT := 0 | OUT_ELEMENTS := 0 |)
     end
   | EMIT_WINDOWS := WIN_A_COUNT + SNAP_TOTAL + LAG_COUNT + LAG_VCOUNT
   | EW_INDEX := 0 .. (if EMIT_RUN then EMIT_WINDOWS - 1 else -1)
   | iterate EW_INDEX of
       (| EW_LAG_AT := EW_INDEX - WIN_A_COUNT - SNAP_TOTAL
        | EW_LAG_MEM := EW_LAG_AT >= 0 and EW_LAG_AT < LAG_COUNT
        | EW_LAG_VALUE := EW_LAG_AT >= LAG_COUNT
        | EW_SNAPPED := EW_INDEX >= WIN_A_COUNT and EW_LAG_AT < 0
        | EW_SIGNAL := if EW_LAG_MEM then LAG_LIST[EW_LAG_AT] else if EW_LAG_VALUE then LAG_VLIST[EW_LAG_AT - LAG_COUNT]
                       else if EW_SNAPPED then SNAPPED_ALL[EW_INDEX - WIN_A_COUNT] else WIN_SIGNAL[EW_INDEX]
        | EW_LEFT_TYPE := ROWS_TYPE[if ROWS_LEFT[EW_SIGNAL] >= 0 then ROWS_LEFT[EW_SIGNAL] else 0]
        | EW_LEFT_ARRAY := XT_BLOCK[EW_LEFT_TYPE]
        | EW_SPAN := if EW_LEFT_ARRAY then XT_SIZE[EW_LEFT_TYPE] else ulong(1)
        | EW_ELEMENT_BYTES := ulong(if EW_LEFT_ARRAY then XT_EB[EW_LEFT_TYPE] else XT_BYTES[EW_LEFT_TYPE])
        | EW_MEM_ELEMENTS := ulong(ROWS_VALUE[EW_SIGNAL] - long(integer(ROWS_OP[EW_SIGNAL] = OP_WINDOW))) * EW_SPAN
        | EW_MEM_WORDS := (EW_MEM_ELEMENTS * EW_ELEMENT_BYTES + ulong(7)) / ulong(8)
        | EW_WORDS := if EW_LAG_MEM then (if EW_MEM_WORDS > ulong(0) then EW_MEM_WORDS else ulong(1)) else XT_WORDS[ROWS_TYPE[EW_SIGNAL]]
        | LAG_MEM1 := LAG_MEM1[?] next (if EW_LAG_MEM then EW_SIGNAL else -1) : EW_INDEX + 1
        | LAG_VALUE1 := LAG_VALUE1[?] next (if EW_LAG_VALUE then EW_SIGNAL else -1) : EW_INDEX + 1
        | EW_PAGES := long(EW_WORDS / ulong(2048) + ulong(integer(EW_WORDS modulo ulong(2048) /= ulong(0))))
        | EW_FAILS := not EW_FAILED[?] and EW_PAGES_TOTAL[?] + EW_PAGES + long(1) >= EMIT_PAGE_LIMIT
        | PAGES_BEFORE := PAGES_BEFORE[?] next EW_INDEX : EW_PAGES_TOTAL[?]
        | PAGES_OF := PAGES_OF[?] next EW_INDEX : EW_PAGES
        | EW_PAGES_TOTAL := if EW_FAILED[?] then EW_PAGES_TOTAL[?] else EW_PAGES_TOTAL[?] + EW_PAGES + long(1)
        | EW_FAILED := EW_FAILED[?] or EW_FAILS
        | EW_FAIL_SIGNAL := if EW_FAILS then EW_SIGNAL else EW_FAIL_SIGNAL[?]
        | WIN_P1 := WIN_P1[?] next (if EW_SNAPPED then EW_SIGNAL else -1) : EW_INDEX + 1
        |)
     with (| EW_PAGES_TOTAL := long(0) | EW_FAILED := false | EW_FAIL_SIGNAL := 0 |)
     end
   | ER_INDEX := 0 .. (if EMIT_RUN then ROW_COUNT - 1 else -1)
   | iterate ER_INDEX of
       (| ER_DELAY := ROWS_OP[ER_INDEX] = OP_DELAY
        | ER_SEED := ROWS_OP[ER_INDEX] = OP_SEED
        | ER_LOOP := if ER_SEED then ROWS_LOOP[ER_INDEX] else 0
        | ER_TAIL := SEED_TAIL1[?][ER_LOOP]
        | DELAY_INDEX := DELAY_INDEX[?] next (if ER_DELAY then ER_INDEX else -1) : DELAY_COUNT[?]
        | DELAY_LIST := DELAY_LIST[?] next (if ER_DELAY then DELAY_COUNT[?] else -1) : ER_INDEX
        | DELAY_COUNT := DELAY_COUNT[?] + integer(ER_DELAY)
        | SEED_HEAD1 := SEED_HEAD1[?] next (if ER_SEED and ER_TAIL = 0 then ER_LOOP else -1) : ER_INDEX + 1
        | SEED_NEXT1 := SEED_NEXT1[?] next (if ER_SEED and ER_TAIL > 0 then ER_TAIL - 1 else -1) : ER_INDEX + 1
        | SEED_TAIL1 := SEED_TAIL1[?] next (if ER_SEED then ER_LOOP else -1) : ER_INDEX + 1
        | SEED_TOTAL := SEED_TOTAL[?] + integer(ER_SEED)
        |)
     with (| DELAY_COUNT := 0 | SEED_TOTAL := 0 |)
     end
   | EC_INDEX := 0 .. (if EMIT_RUN then CLOCK_TOTAL - 1 else -1)
   | iterate EC_INDEX of
       (| EC_LIVE := NODE_KIND[EC_INDEX] /= CLK_NONE
        | CLK_INDEX := CLK_INDEX[?] next (if EC_LIVE then EC_INDEX else -1) : CLK_COUNT[?]
        | CLK_COUNT := CLK_COUNT[?] + integer(EC_LIVE)
        | ROOT_POSITION := ROOT_POSITION[?] next (if EC_INDEX < ROOT_COUNT then ROOT_LIST[EC_INDEX] else -1) : EC_INDEX
        |)
     with CLK_COUNT := 0
     end
   | EMIT_TABLE_COUNT := TABLE_COUNT + NEW_TABLE_COUNT
   | ETB_INDEX := 0 .. (if EMIT_RUN then EMIT_TABLE_COUNT - 1 else -1)
   | iterate ETB_INDEX of
       (| ETB_NEW := ETB_INDEX >= TABLE_COUNT
        | ETB_SOURCE1 := if ETB_NEW then NEW_TABLE_SOURCE1[ETB_INDEX - TABLE_COUNT] else 0
        | ETB_TYPE := if CX_TABLE_IM[ETB_INDEX] > 0 then NEW_TABLE_TYPE[CX_TABLE_IM[ETB_INDEX] - 1 - TABLE_COUNT]
                      else if ETB_NEW then NEW_TABLE_TYPE[ETB_INDEX - TABLE_COUNT] else TABLE_TYPE[ETB_INDEX]
        | ETB_LENGTH := if ETB_SOURCE1 > 0 and ETB_SOURCE1 <= TABLE_COUNT then long(TABLE_LENGTH[ETB_SOURCE1 - 1])
                        else if ETB_NEW or XT_KIND[ETB_TYPE] = TK_STRING then long(XT_SIZE[ETB_TYPE]) else long(TABLE_LENGTH[ETB_INDEX])
        | ETB_EB := XT_EB[ETB_TYPE]
        | ETB_OFFSET := (ETB_END[?] + long(7)) / long(8) * long(8)
        | TABLE_OFFSET := TABLE_OFFSET[?] next ETB_INDEX : ETB_OFFSET
        | TABLE_EB := TABLE_EB[?] next ETB_INDEX : ETB_EB
        | TABLE_EMIT_TYPE := TABLE_EMIT_TYPE[?] next ETB_INDEX : ETB_TYPE
        | TABLE_BYTES := TABLE_BYTES[?] next ETB_INDEX : ETB_LENGTH * long(ETB_EB)
        | TABLE_LIVE := TABLE_LIVE[?] next (if ETB_LENGTH > long(0) then TABLE_LIVE_COUNT[?] else -1) : ETB_INDEX
        | TABLE_LIVE_COUNT := TABLE_LIVE_COUNT[?] + integer(ETB_LENGTH > long(0))
        | ETB_END := ETB_OFFSET + ETB_LENGTH * long(ETB_EB)
        |)
     with (| ETB_END := long(0) | TABLE_LIVE_COUNT := 0 |)
     end
   | WIN_BASE := (ETB_END + long(7)) / long(8) * long(8)
   | SIG_BASE := WIN_BASE + long(8) * long(EMIT_WINDOWS)
   | MEM_BASE := SIG_BASE + long(8) * long(ROW_COUNT)
   | CLK_BASE := MEM_BASE + long(8) * long(DELAY_COUNT)
   | IN_BASE := CLK_BASE + long(4) * long(CLK_COUNT)
   | READS_LINE := PLATFORM = PLATFORM_MACOS and (ROOT_COUNT >= 2 or EMIT_INPUT_COUNT > 0)
   | RESERVES := EMIT_WINDOWS > 0 and PLATFORM = PLATFORM_MACOS
   | LINE_CAPACITY := long(ROOT_COUNT) + long(if FIRST_REAL_TOKEN >= 0 then 2048 else 22) * VI_ELEMENTS
   | OUT_BASE := IN_BASE + LINE_CAPACITY + long(1)
   | MAL_BASE := OUT_BASE + long(if FIRST_REAL_TOKEN >= 0 then 32 else 24) * (long(OUT_ELEMENTS) + long(1))
   | RES_BASE := MAL_BASE + long(MALFORMED_TEXT_LENGTH * integer(READS_LINE))
   | DATA_END := RES_BASE + long(26 * integer(RESERVES))
   | ITEM_TOTAL := EMIT_TABLE_COUNT + EMIT_WINDOWS + ROW_COUNT + DELAY_COUNT + CLK_COUNT + 2 + integer(READS_LINE)
                   + integer(RESERVES)
   | SK_INDEX := 0 .. (if EMIT_RUN then 3 * ROW_COUNT - 1 else -1)
   | iterate SK_INDEX of
       (| SK_STARTS := SK_TOP[?] = 0
        | SK_X := if SK_STARTS then SK_CURSOR[?] else SK_STACK[?][if SK_STARTS then 0 else SK_TOP[?] - 1]
        | SK_LIVE := SK_X < ROW_COUNT
        | SK_ROW := if SK_LIVE then SK_X else 0
        | SK_OP := ROWS_OP[SK_ROW]
        | SK_LEFT := if SK_OP = OP_IMAG then ROWS_RIGHT[SK_ROW] else ROWS_LEFT[SK_ROW]
        | SK_LEFT_ROW := if SK_LEFT >= 0 then SK_LEFT else 0
        | SK_SNAPSHOT := SK_OP = OP_PREV and WIN_P1[SK_LEFT_ROW] > 0
        | SK_CHAINS := (SK_OP = OP_COPY or SK_OP = OP_PREV or (SK_OP = OP_WHEN or SK_OP = OP_IMAG) and XT_BLOCK[ROWS_TYPE[SK_ROW]])
                       and not SK_SNAPSHOT and SK_LEFT >= 0
        | SK_ALREADY := SK_DONE[?][SK_ROW]
        | SK_READY := not SK_CHAINS or SK_DONE[?][SK_LEFT_ROW]
        | SK_RESOLVES := SK_LIVE and not SK_ALREADY and SK_READY
        | SK_PUSHES := SK_LIVE and not SK_ALREADY and not SK_READY and SK_TOP[?] < ROW_COUNT
        | SK_OWNER := if SK_OP = OP_IMAG then SK_ROW else ROWS_OWNER[SK_ROW]
        | SK_VALUE := if SK_CHAINS then SK_KEY[?][SK_LEFT_ROW] else if SK_SNAPSHOT then WIN_P1[SK_LEFT_ROW] - 1
                      else if LAG_VALUE1[SK_ROW] > 0 then LAG_VALUE1[SK_ROW] - 1
                      else if SK_OP = OP_TABLE then -1 - integer(ROWS_VALUE[SK_ROW])
                      else if SK_OWNER >= 0 then WIN_A1[SK_OWNER] - 1 else -1
        | SK_KEY := SK_KEY[?] next (if SK_RESOLVES then SK_ROW else -1) : SK_VALUE
        | SK_DONE := SK_DONE[?] next (if SK_RESOLVES then SK_ROW else -1) : true
        | SK_STACK := SK_STACK[?] next (if SK_PUSHES then SK_TOP[?] else -1) : (if SK_STARTS then SK_ROW else SK_LEFT_ROW)
        | SK_TOP := if SK_PUSHES then SK_TOP[?] + 1 else if SK_RESOLVES and not SK_STARTS then SK_TOP[?] - 1 else SK_TOP[?]
        | SK_CURSOR := if SK_STARTS and SK_LIVE and (SK_ALREADY or SK_RESOLVES) then SK_CURSOR[?] + 1 else SK_CURSOR[?]
        |)
     with (| SK_TOP := 0 | SK_CURSOR := 0 |)
     end
   | EMIT_PREPARED := EMIT_RUN and not EW_FAILED
   | UNIT_BOUND := long(2 * UPH_DONE) + long(EMIT_WINDOWS) + long(VI_COUNT) + long(DELAY_COUNT) + long(OUT_COUNT) + long(ORDER_COUNT)
                   + long(LAG_COUNT) + long(LAG_SEED_COUNT)
                   + long(2) * long(LOOP_TOTAL) + long(SEED_TOTAL) + long(SNAP_TOTAL) + long(LO_SUM) + long(PRAGMA_COUNT)
   | UNIT_RUN := EMIT_PREPARED and UNIT_BOUND < long(PARSE_CAP)
   | UN_INDEX := 0 .. (if UNIT_RUN then integer(UNIT_BOUND) - 1 else -1)
   | iterate UN_INDEX of
       (| UN_PH := UN_NEXT_PH[?]
        | UN_J := UN_NEXT_J[?]
        | UN_LS := UN_NEXT_LS[?]
        | UN_K := UN_NEXT_K[?]
        | UN_ORDER := UN_PH = UPH_ORDER
        | UN_PHASE_LENGTH := if UN_PH = UPH_PROLOGUE or UN_PH = UPH_STEP or UN_PH = UPH_FINISH then 1
                             else if UN_PH = UPH_RESERVE or UN_PH = UPH_RESERVE_FAILED then integer(RESERVES)
                             else if UN_PH = UPH_WINDOW then EMIT_WINDOWS
                             else if UN_PH = UPH_JUMP_STEP then integer(PLATFORM = PLATFORM_MACOS and (EMIT_WINDOWS > 0 or VI_COUNT > 0))
                             else if UN_PH = UPH_BOOT then integer(PRAGMA_HAS_BOOT)
                             else if UN_PH = UPH_WAIT or UN_PH = UPH_WAIT_TAIL then integer(PLATFORM /= PLATFORM_MACOS)
                             else if UN_PH = UPH_DISPATCH then PRAGMA_COUNT
                             else if UN_PH = UPH_READ_VALUE then integer(VI_COUNT > 0)
                             else if UN_PH = UPH_READ_LINE or UN_PH = UPH_READ_TAIL then integer(READS_LINE)
                             else if UN_PH = UPH_VALUE_INPUT then (if READS_LINE then VI_COUNT else 0)
                             else if UN_PH = UPH_ORDER then ORDER_COUNT
                             else if UN_PH = UPH_DELAY then DELAY_COUNT
                             else if UN_PH = UPH_LAG then LAG_COUNT
                             else if UN_PH = UPH_SEED_MEMORY then LAG_SEED_COUNT
                             else if UN_PH = UPH_OUTPUT_HEAD or UN_PH = UPH_OUTPUT_TAIL then integer(OUT_COUNT > 0)
                             else if UN_PH = UPH_OUTPUT then OUT_COUNT
                             else if UN_PH = UPH_PUT_TEXT then integer(IO_COUNT > 0)
                             else if UN_PH = UPH_READ_INPUT or UN_PH = UPH_READ_NUMBER then integer(READ_COUNT > 0 and PLATFORM = PLATFORM_MACOS)
                             else if UN_PH = UPH_REAL_RUNTIME then integer(FIRST_REAL_TOKEN >= 0 and PLATFORM /= PLATFORM_MPS2)
                             else if UN_PH = UPH_REAL_PARSE then integer(FIRST_REAL_TOKEN >= 0 and (READS_LINE or READ_COUNT > 0 and PLATFORM = PLATFORM_MACOS)) else 0
        | UN_IN_PHASE := UN_PH < UPH_DONE and UN_J < UN_PHASE_LENGTH
        | UN_ORDER_AT := if UN_ORDER and UN_IN_PHASE then UN_J else 0
        | UN_RAW := if SPLIT_ACCEPTED then FINAL_ORDER[UN_ORDER_AT] else SKO_ORDER[UN_ORDER_AT]
        | UN_SPECIAL := UN_ORDER and UN_RAW < 0
        | UN_SPECIAL_TEMPLATE := (-1 - UN_RAW) modulo ET_COUNT
        | UN_SPECIAL_ARG := (-1 - UN_RAW) / ET_COUNT
        | UN_NODE := if UN_SPECIAL then 0 else UN_RAW
        | UN_LOOP_NODE := UN_ORDER and UN_NODE >= SCHED_LOOP_BASE
        | UN_CLOCK_NODE := UN_ORDER and UN_NODE >= ROW_COUNT and UN_NODE < SCHED_LOOP_BASE
        | UN_L := if UN_LOOP_NODE then UN_NODE - SCHED_LOOP_BASE else 0
        | UN_C := if UN_CLOCK_NODE then UN_NODE - ROW_COUNT else 0
        | UN_SNAP_COUNT := SNAP_LOOP_COUNT[UN_L]
        | UN_LO_LENGTH := LO_LENGTH[UN_L]
        | UN_LOOP_ROW := if UN_LS = 1 then UN_K - 1 else LO_LIST[LO_START[UN_L] + (if UN_LS = 4 then UN_K else 0)]
        | UN_ROW_LIKE := UN_ORDER and (if UN_LOOP_NODE then UN_LS = 1 or UN_LS = 4 else not UN_CLOCK_NODE)
        | UN_X := if UN_LOOP_NODE then UN_LOOP_ROW else UN_NODE
        | TP_ROW := if UN_ROW_LIKE and UN_X >= 0 and UN_X < ROW_COUNT then UN_X else 0
        | TP_OP := ROWS_OP[TP_ROW]
        | TP_TYPE := ROWS_TYPE[TP_ROW]
        | TP_KIND := XT_KIND[TP_TYPE]
        | TP_LEFT := ROWS_LEFT[TP_ROW]
        | TP_RIGHT := ROWS_RIGHT[TP_ROW]
        | TP_LEFT_ROW := if TP_LEFT >= 0 then TP_LEFT else 0
        | TP_RIGHT_ROW := if TP_RIGHT >= 0 then TP_RIGHT else 0
        | TP_LEFT_LEFT := ROWS_LEFT[TP_LEFT_ROW]
        | TP_EFFECT := EFFECT_KIND[if TP_OP = OP_EFFECT then integer(ROWS_VALUE[TP_ROW]) else 0] modulo NAME_CAP
        | TP_LT := ROWS_TYPE[TP_LEFT_ROW]
        | TP_RT := ROWS_TYPE[TP_RIGHT_ROW]
        | TP_L_LOGICAL := XT_KIND[TP_LT] = TK_EVENT or XT_KIND[TP_LT] = TK_BOOLEAN
        | TP_R_LOGICAL := XT_KIND[TP_RT] = TK_EVENT or XT_KIND[TP_RT] = TK_BOOLEAN
        | TP_BOTH_INT := XT_KIND[TP_LT] = TK_INT and XT_KIND[TP_RT] = TK_INT
        | TP_L_SIGNED := XT_SIGNED[TP_LT]
        | TP_R_SIGNED := XT_SIGNED[TP_RT]
        | TP_SIGNED_BYTES := if TP_L_SIGNED then XT_BYTES[TP_LT] else XT_BYTES[TP_RT]
        | TP_UNSIGNED_BYTES := if TP_L_SIGNED then XT_BYTES[TP_RT] else XT_BYTES[TP_LT]
        | TP_SIGNED := TP_RIGHT >= 0
                       and (if TP_LT = TP_RT then TP_L_SIGNED else if TP_L_LOGICAL and TP_R_LOGICAL then false
                            else if not TP_BOTH_INT then XT_LAST_SIGNED else if TP_L_SIGNED = TP_R_SIGNED then TP_L_SIGNED
                            else TP_SIGNED_BYTES > TP_UNSIGNED_BYTES or TP_UNSIGNED_BYTES <= 4 or XT_LAST_SIGNED)
        | TP_SKIPS := TP_OP = OP_TABLE or TP_OP = OP_SPAN or TP_OP = OP_FLATV or TP_OP = OP_PAIR or TP_OP = OP_BOUNDS_PAIR or TP_OP = OP_BRANCH or TP_OP = OP_INPUT or TP_OP = OP_ARG or TP_OP = OP_IMAG and TP_RIGHT < 0
                      or TP_OP = OP_RANGE or (TP_OP = OP_COPY or TP_OP = OP_PREV or TP_OP = OP_WHEN or TP_OP = OP_IMAG) and XT_BLOCK[TP_TYPE]
                      or TP_OP = OP_ITER and ROWS_LOOP[TP_ROW] < 0
        | TP_TEMPLATE := if TP_SKIPS then -1
                         else if TP_OP = OP_SEED then
                           (if not XT_BLOCK[TP_TYPE] then ET_ROW_SEED
                            else if XT_BLOCK[ROWS_TYPE[if TP_LEFT >= 0 then TP_LEFT else 0]] then ET_ROW_SEED_ARRAY else ET_ROW_SEED_FILL)
                         else if TP_OP = OP_EFFECT then
                           (if TP_EFFECT = N_LOAD then ET_ROW_LOAD else if TP_EFFECT = N_STORE then ET_ROW_STORE
                            else if TP_EFFECT = N_SYSCALL then ET_ROW_SYSCALL else if TP_EFFECT = N_READ then ET_ROW_READ
                            else if TP_EFFECT = N_WRITE or TP_EFFECT = N_WRITE_STRING then ET_ROW_WRITE else ET_ROW_INSTRUCTION)
                         else if TP_OP = OP_ITER then
                           (if ROWS_OP[if TP_LEFT_LEFT >= 0 then TP_LEFT_LEFT else 0] = OP_RANGE then ET_ROW_ITER_RANGE else ET_ROW_ITER)
                         else if TP_OP = OP_EACH then ET_ROW_ITER else if TP_OP = OP_EACH_STORE then ET_ROW_EACH_STORE
                         else if TP_OP = OP_DEFAULT and XT_BLOCK[TP_TYPE] then ET_ROW_DEFAULT_ARRAY
                         else if TP_OP = OP_IF and XT_BLOCK[TP_TYPE] then ET_ROW_IF_BLOCK
                         else if TP_OP = OP_PREV then ET_ROW_PREV else if TP_OP = OP_ELEMENT then ET_ROW_ELEMENT
                         else if TP_OP = OP_FLAT then ET_ROW_FLAT
                         else if TP_OP = OP_GATHER then
                           (if ROWS_OP[if TP_RIGHT >= 0 then TP_RIGHT else 0] = OP_FLATV then ET_ROW_GATHER2 else ET_ROW_GATHER) else if TP_OP = OP_NEXT then ET_ROW_NEXT
                         else if TP_OP = OP_PUT then ET_ROW_PUT
                         else if TP_OP = OP_CONCAT then ET_ROW_CONCAT else if TP_OP = OP_ARRAY_EQ then ET_ROW_ARRAY_EQ
                         else if TP_OP = OP_TRANSPOSE then ET_ROW_TRANSPOSE
                         else if TP_OP = OP_MATPROD then (if TP_KIND = TK_ARRAY then ET_ROW_MATPROD else ET_ROW_DOT)
                         else if TP_OP = OP_RESTRUCTURE then
                           (if XT_KIND[ROWS_TYPE[if TP_RIGHT >= 0 then TP_RIGHT else 0]] = TK_ARRAY then ET_ROW_SCATTER else ET_ROW_RESTRUCTURE)
                         else if TP_OP = OP_SLICE then ET_ROW_SLICE
                         else if TP_OP = OP_DIM or TP_OP = OP_DIM_SIZE then ET_ROW_FOLD
                         else if TP_OP = OP_BOUNDS then
                           (if XT_BYTES[TP_TYPE] = 8 and not XT_SIGNED[TP_TYPE] then ET_ROW_BOUNDS else ET_ROW_BOUNDS_SIGNED)
                         else if TP_OP = OP_CONST then ET_ROW_CONST else if TP_OP = OP_DELAY then ET_ROW_DELAY
                         else if TP_OP = OP_LAG then (if XT_BLOCK[TP_TYPE] then ET_ROW_LAG_ARRAY else ET_ROW_LAG)
                         else if TP_OP = OP_WINDOW then
                           (if XT_KIND[ROWS_TYPE[TP_LEFT_ROW]] = TK_ARRAY then ET_ROW_WINDOW_ARRAY else ET_ROW_WINDOW)
                         else if TP_OP = OP_STATE then ET_ROW_STATE
                         else if TP_OP = OP_UWHEN or TP_OP = OP_CLOCK then ET_ROW_ONE else if TP_OP = OP_IF then ET_ROW_IF
                         else if TP_OP = OP_DEFAULT and not ROWS_CTX[TP_LEFT_ROW] then ET_ROW_DEFAULT
                         else if TP_OP = OP_CONVERT and (TP_KIND = TK_REAL or XT_KIND[TP_LT] = TK_REAL) then
                           (if TP_KIND /= TK_REAL then ET_ROW_REAL_TO_INT else if XT_KIND[TP_LT] /= TK_REAL then ET_ROW_REAL_FROM_INT
                            else if XT_BYTES[TP_TYPE] < XT_BYTES[TP_LT] then ET_ROW_REAL_NARROW else ET_ROW_PLAIN)
                         else if TP_OP = OP_NEG then (if TP_KIND = TK_REAL then ET_ROW_REAL_NEG else ET_ROW_NEG)
                         else if TP_OP = OP_IMAG then ET_ROW_REAL_IMAG
                         else if TP_OP = OP_FMA then (if XT_BYTES[TP_TYPE] = 8 then ET_ROW_REAL_FMA_D else ET_ROW_REAL_FMA_S)
                         else if TP_OP = OP_COPYSIGN then (if XT_BYTES[TP_TYPE] = 8 then ET_ROW_REAL_COPYSIGN_D else ET_ROW_REAL_COPYSIGN_S)
                         else if TP_OP = OP_MODU then (if XT_BYTES[TP_TYPE] = 8 then ET_ROW_REAL_MODU_D else ET_ROW_REAL_MODU_S)
                         else if TP_KIND = TK_REAL and OP_REAL_FORM[TP_OP] >= 0 then ET_ROW_REAL_BINARY
                         else if OP_REAL_CONDITION[TP_OP] >= 0 and (XT_KIND[TP_LT] = TK_REAL or XT_KIND[TP_RT] = TK_REAL) then ET_ROW_REAL_COMPARE
                         else if TP_OP = OP_NOT then
                           (if TP_KIND = TK_EVENT or TP_KIND = TK_BOOLEAN then ET_ROW_NOT_LOGICAL else ET_ROW_NOT)
                         else if OP_INSTRUCTION_FORM[TP_OP] >= 0 then ET_ROW_BINARY
                         else if TP_OP = OP_DIV then (if TP_SIGNED then ET_ROW_DIV_SIGNED else ET_ROW_DIV)
                         else if OP_SIGNED_CONDITION[TP_OP] >= 0 and XT_KIND[TP_LT] = TK_STRING then
                           (if TP_OP = OP_EQ or TP_OP = OP_NE then ET_ROW_ARRAY_EQ else ET_ROW_ARRAY_LT)
                         else if OP_SIGNED_CONDITION[TP_OP] >= 0 then (if TP_SIGNED then ET_ROW_COMPARE_SIGNED else ET_ROW_COMPARE)
                         else if TP_OP = OP_MOD then (if TP_SIGNED then ET_ROW_MOD_SIGNED else ET_ROW_MOD)
                         else if OP_SHIFT_FORM[TP_OP] >= 0 then ET_ROW_SHIFT else ET_ROW_PLAIN
        | UN_CLOCK_KIND := NODE_KIND[UN_C]
        | UN_BASE_TEMPLATE := if not UN_IN_PHASE then -1
                         else if not UN_ORDER then
                           (if UN_PH = UPH_OUTPUT and XT_KIND[ROWS_TYPE[OUT_LIST[UN_J]]] = TK_ARRAY then ET_OUTPUT_ARRAY
                            else if UN_PH = UPH_VALUE_INPUT and XT_KIND[ROWS_TYPE[VI_LIST[UN_J]]] = TK_ARRAY then ET_VALUE_INPUT_ARRAY
                            else if UN_PH = UPH_VALUE_INPUT and XT_KIND[ROWS_TYPE[VI_LIST[UN_J]]] = TK_REAL then ET_VALUE_INPUT_REAL
                            else if UN_PH = UPH_LAG then
                              (if ROWS_OP[LAG_LIST[UN_J]] = OP_WINDOW then ET_WINDOW_STEP
                               else if XT_BLOCK[ROWS_TYPE[LAG_LIST[UN_J]]] then ET_LAG_ARRAY else ET_LAG)
                            else if PLATFORM /= PLATFORM_MACOS then UNIT_PHASE_TEMPLATE_VIRT[UN_PH] else UNIT_PHASE_TEMPLATE[UN_PH])
                         else if UN_SPECIAL then UN_SPECIAL_TEMPLATE
                         else if UN_LOOP_NODE then
                           (if UN_LS = 0 then ET_LOOP_HEAD else if UN_LS = 2 then ET_LOOP_MID else if UN_LS = 3 then ET_SNAPSHOT
                            else if UN_LS = 5 then ET_LOOP_TAIL else TP_TEMPLATE)
                         else if UN_CLOCK_NODE then
                           (if UN_CLOCK_KIND = CLK_ROOT then
                              (if PLATFORM /= PLATFORM_MACOS then ET_CLOCK_ROOT_VIRT else if READS_LINE then ET_CLOCK_ROOT_READ
                               else ET_CLOCK_ROOT)
                            else if UN_CLOCK_KIND = CLK_SAMPLE then ET_CLOCK_SAMPLE else ET_CLOCK_PAIR)
                         else TP_TEMPLATE
        | UN_TEMPLATE := if PLATFORM = PLATFORM_MPS2 and UN_BASE_TEMPLATE >= 0 then THUMB_TEMPLATE[UN_BASE_TEMPLATE]
                         else UN_BASE_TEMPLATE
        | UN_P := if not UN_ORDER then
                    (if UN_PH = UPH_WINDOW then UN_J else if UN_PH = UPH_VALUE_INPUT then VI_LIST[UN_J]
                     else if UN_PH = UPH_DELAY then DELAY_LIST[UN_J] else if UN_PH = UPH_OUTPUT then OUT_LIST[UN_J]
                     else if UN_PH = UPH_LAG then LAG_LIST[UN_J] else if UN_PH = UPH_SEED_MEMORY then LAG_SEED_LIST[UN_J]
                     else if UN_PH = UPH_DISPATCH then PRAGMA_IRQ[UN_J] else 0)
                  else if UN_SPECIAL then UN_SPECIAL_ARG
                  else if UN_LOOP_NODE then
                    (if UN_LS = 3 then SNAP_LIST[SNAP_START[UN_L] + UN_K] else if UN_LS = 1 or UN_LS = 4 then UN_LOOP_ROW else UN_L)
                  else if UN_CLOCK_NODE then UN_C else UN_NODE
        | UN_FLAG := if UN_ORDER then not UN_LOOP_NODE and not UN_CLOCK_NODE
                     else if UN_PH = UPH_DISPATCH then PRAGMA_IRQ[UN_J] < BOOT_ID else UN_PH = UPH_OUTPUT and UN_J > 0
        | UN_STEPS_LOOP := UN_LOOP_NODE and UN_IN_PHASE
        | UN_SEED_NEXT := if UN_LS = 0 then SEED_HEAD1[UN_L] else SEED_NEXT1[if UN_K > 0 then UN_K - 1 else 0]
        | UN_AFTER_SNAPS := if UN_LO_LENGTH > 0 then 4 else 5
        | UN_LS_AFTER := if UN_LS <= 1 then (if UN_SEED_NEXT > 0 then 1 else 2)
                         else if UN_LS = 2 then (if UN_SNAP_COUNT > 0 then 3 else UN_AFTER_SNAPS)
                         else if UN_LS = 3 then (if UN_K + 1 < UN_SNAP_COUNT then 3 else UN_AFTER_SNAPS)
                         else if UN_LS = 4 then (if UN_K + 1 < UN_LO_LENGTH then 4 else 5)
                         else 0
        | UN_K_AFTER := if UN_LS_AFTER = 1 then UN_SEED_NEXT else if UN_LS_AFTER = UN_LS and UN_LS >= 3 then UN_K + 1 else 0
        | UN_ADVANCES := UN_IN_PHASE and (not UN_LOOP_NODE or UN_LS = 5)
        | UN_NEXT_PH := if UN_PH < UPH_DONE and not UN_IN_PHASE then UN_PH + 1 else UN_PH
        | UN_NEXT_J := if not UN_IN_PHASE then 0 else if UN_ADVANCES then UN_J + 1 else UN_J
        | UN_NEXT_LS := if UN_STEPS_LOOP then UN_LS_AFTER else 0
        | UN_NEXT_K := if UN_STEPS_LOOP then UN_K_AFTER else 0
        | UN_EMITS := UN_TEMPLATE >= 0
        | UN_SLOT := if UN_EMITS and UNIT_COUNT[?] < UNIT_CAP then UNIT_COUNT[?] else -1
        | UN_TEMPLATE_ROW := if UN_EMITS then UN_TEMPLATE else 0
        | UNIT_TEMPLATE := UNIT_TEMPLATE[?] next UN_SLOT : UN_TEMPLATE
        | UNIT_P := UNIT_P[?] next UN_SLOT : UN_P
        | UNIT_FLAG := UNIT_FLAG[?] next UN_SLOT : UN_FLAG
        | UNIT_LABEL := UNIT_LABEL[?] next UN_SLOT : UNIT_LABEL_TOTAL[?]
        | UNIT_COUNT := UNIT_COUNT[?] + integer(UN_EMITS)
        | UNIT_LABEL_TOTAL := UNIT_LABEL_TOTAL[?] + (if UN_EMITS then ET_LABELS[UN_TEMPLATE_ROW] else 0)
        | UNIT_STEP_TOTAL := UNIT_STEP_TOTAL[?] + long(if UN_EMITS then ET_LENGTH[UN_TEMPLATE_ROW] else 0)
        |)
     with (| UN_NEXT_PH := 0 | UN_NEXT_J := 0 | UN_NEXT_LS := 0 | UN_NEXT_K := 0 | UNIT_COUNT := 0
           | UNIT_LABEL_TOTAL := GLOBAL_LABEL_COUNT + 2 * LOOP_TOTAL + (if SPLIT_ACCEPTED then COPY_CAP + 1 else 0)
           | UNIT_STEP_TOTAL := long(0) |)
     end
   | UNIT_READY := UNIT_RUN and UN_NEXT_PH = UPH_DONE and UNIT_COUNT <= UNIT_CAP
   | PLAN_RUN := UNIT_READY and UNIT_STEP_TOTAL < long(PARSE_CAP)
   | PL_INDEX := 0 .. (if PLAN_RUN then integer(UNIT_STEP_TOTAL) - 1 else -1)
   | iterate PL_INDEX of
       (| PL_U := PL_NEXT_U[?]
        | PL_K := PL_NEXT_K[?]
        | PL_T := UNIT_TEMPLATE[PL_U]
        | PL_P := UNIT_P[PL_U]
        | PL_FLAG := UNIT_FLAG[PL_U]
        | PL_LOCAL := UNIT_LABEL[PL_U]
        | PL_STEP := ET_START[PL_T] + PL_K
        | PL_LAST := PL_K + 1 >= ET_LENGTH[PL_T]
        | PL_NEXT_U := if PL_LAST then PL_U + 1 else PL_U
        | PL_NEXT_K := if PL_LAST then 0 else PL_K + 1
        | PL_KIND := STEP_KIND[PL_STEP]
        | PL_WHEN := STEP_WHEN[PL_STEP]
        | PL_SOURCE0 := STEP_SOURCE0[PL_STEP]
        | PL_SOURCE1 := STEP_SOURCE1[PL_STEP]
        | PL_ROW := if PL_P >= 0 and PL_P < ROW_COUNT then PL_P else 0
        | PL_CLOCK := if PL_P >= 0 and PL_P < CLOCK_TOTAL then PL_P else 0
        | PL_LOOP := if PL_P >= 0 and PL_P < LOOP_TOTAL then PL_P else 0
        | PL_WINDOW := if PL_P >= 0 and PL_P < EMIT_WINDOWS then PL_P else 0
        | PL_OP := ROWS_OP[PL_ROW]
        | PL_TYPE := ROWS_TYPE[PL_ROW]
        | PL_LEFT := ROWS_LEFT[PL_ROW]
        | PL_RIGHT := ROWS_RIGHT[PL_ROW]
        | PL_LEFT_ROW := if PL_LEFT >= 0 then PL_LEFT else 0
        | PL_RIGHT_ROW := if PL_RIGHT >= 0 then PL_RIGHT else 0
        | PL_OWNER := ROWS_OWNER[PL_ROW]
        | PL_OWNER_KEY := WIN_A1[if PL_OWNER >= 0 then PL_OWNER else 0] - 1
        | PL_C1 := if PL_LEFT >= 0 then ROWS_RIGHT[PL_LEFT] else -1
        | PL_C2 := if PL_C1 >= 0 then ROWS_RIGHT[PL_C1] else -1
        | PL_C3 := if PL_C2 >= 0 then ROWS_RIGHT[PL_C2] else -1
        | PL_C4 := if PL_C3 >= 0 then ROWS_RIGHT[PL_C3] else -1
        | PL_C5 := if PL_C4 >= 0 then ROWS_RIGHT[PL_C4] else -1
        | PL_C6 := if PL_C5 >= 0 then ROWS_RIGHT[PL_C5] else -1
        | PL_PARAM := EFFECT_PARAM[if PL_OP = OP_EFFECT then integer(ROWS_VALUE[PL_ROW]) else 0]
        | PL_PARAM_TYPE := if PL_PARAM >= long(0) and PL_PARAM < long(XT_TOTAL) then integer(PL_PARAM) else 0
        | PL_ELEMENT := XT_ELEMENT[PL_TYPE]
        | PL_SCALAR_TYPE := if XT_BLOCK[PL_TYPE] then PL_ELEMENT else PL_TYPE
        | PL_LEFT_TYPE := ROWS_TYPE[PL_LEFT_ROW]
        | PL_RIGHT_TYPE := ROWS_TYPE[PL_RIGHT_ROW]
        | PL_REAL_WIDE := if XT_KIND[PL_SCALAR_TYPE] = TK_REAL then XT_BYTES[PL_SCALAR_TYPE] = 8
                          else XT_KIND[PL_LEFT_TYPE] = TK_REAL and XT_BYTES[PL_LEFT_TYPE] = 8
                               or PL_RIGHT >= 0 and XT_KIND[PL_RIGHT_TYPE] = TK_REAL and XT_BYTES[PL_RIGHT_TYPE] = 8
                               or PL_RIGHT >= 0 and XT_KIND[PL_INDEX_ELEMENT] = TK_REAL and XT_BYTES[PL_INDEX_ELEMENT] = 8
        | PL_REAL_W := integer(PL_REAL_WIDE)
        | PL_SPAN := if XT_BLOCK[PL_LEFT_TYPE] then long(XT_SIZE[PL_LEFT_TYPE]) else long(1)
        | PL_INIT_TABLE := if ROWS_INIT[PL_ROW] > 0 then ROWS_INIT[PL_ROW] - 1 else 0
        | PL_INIT_LEAF := XT_ELEMENT[TABLE_EMIT_TYPE[PL_INIT_TABLE]]
        | PL_COUNT_MEM := (ROWS_VALUE[PL_ROW] - long(integer(PL_OP = OP_WINDOW))) * PL_SPAN
        | PL_COUNT_SHIFT := (ROWS_VALUE[PL_ROW] - long(1)) * PL_SPAN
        | PL_INDEX_ELEMENT := XT_ELEMENT[ROWS_TYPE[PL_RIGHT_ROW]]
        | PL_LOOP_LEFT := ROWS_LEFT[LOOP_INDEX[PL_LOOP]]
        | PL_LOOP_LEFT_ROW := if PL_LOOP_LEFT >= 0 then PL_LOOP_LEFT else 0
        | PL_COUNT_ROW := if PL_LOOP_LEFT >= 0 and ROWS_OP[PL_LOOP_LEFT_ROW] = OP_RANGE and PL_START0 = long(0) then ROWS_RIGHT[PL_LOOP_LEFT_ROW] else -1
        | PL_ITER_TEMPLATE := PL_T = ET_ROW_ITER or PL_T = ET_ROW_ITER_RANGE or PL_T = ET_ROW_ITER_THUMB or PL_T = ET_ROW_ITER_RANGE_THUMB
        | PL_LL1 := if PL_ITER_TEMPLATE then ROWS_LOOP[PL_ROW] else PL_LOOP
        | PL_LL := if PL_LL1 >= 0 and PL_LL1 < FLAT_LOOP_COUNT then PL_LL1 else 0
        | PL_FLAT := PL_LL1 >= 0 and PL_LL1 < FLAT_LOOP_COUNT
        | PL_RANK := if PL_FLAT then LOOP_LEVELS[PL_LL] else 0
        | PL_LEVEL := if PL_ITER_TEMPLATE and PL_OP = OP_ITER then integer(ROWS_VALUE[PL_ROW]) else 0
        | PL_S0 := if PL_RANK > 0 then LEVEL_SIGNAL[4 * PL_LL + 0] else 0
        | PL_D0 := ROWS_LEFT[PL_S0]
        | PL_RANGE0 := PL_RANK > 0 and PL_D0 >= 0 and ROWS_OP[if PL_D0 >= 0 then PL_D0 else 0] = OP_RANGE
        | PL_RANGE_START0 := if PL_RANGE0 then ROWS_LEFT[PL_D0] else 0
        | PL_START0 := if not PL_RANGE0 then long(0) else if ROWS_OP[PL_RANGE_START0] = OP_NEG then -ROWS_VALUE[ROWS_LEFT[PL_RANGE_START0]] else ROWS_VALUE[PL_RANGE_START0]
        | PL_END0 := if PL_RANGE0 then ROWS_RIGHT[PL_D0] else 0
        | PL_END_SAFE0 := if PL_END0 >= 0 then PL_END0 else 0
        | PL_END_NEG0 := ROWS_OP[PL_END_SAFE0] = OP_NEG and ROWS_OP[ROWS_LEFT[PL_END_SAFE0]] = OP_CONST
        | PL_END_CONST0 := ROWS_OP[PL_END_SAFE0] = OP_CONST or PL_END_NEG0
        | PL_END_VALUE0 := if PL_END_NEG0 then -ROWS_VALUE[ROWS_LEFT[PL_END_SAFE0]] else ROWS_VALUE[PL_END_SAFE0]
        | PL_LAST0 := PL_END_VALUE0 - PL_START0 + long(1)
        | PL_SPAN0 := if PL_RANK <= 0 then long(1)
                       else if PL_RANGE0 and PL_END0 >= 0 and PL_END_CONST0 then
                         (if PL_LAST0 < long(0) then long(0) else if PL_LAST0 > long(LEVEL_SIZE[4 * PL_LL + 0]) then long(LEVEL_SIZE[4 * PL_LL + 0]) else PL_LAST0)
                       else long(LEVEL_SIZE[4 * PL_LL + 0])
        | PL_S1 := if PL_RANK > 1 then LEVEL_SIGNAL[4 * PL_LL + 1] else 0
        | PL_D1 := ROWS_LEFT[PL_S1]
        | PL_RANGE1 := PL_RANK > 1 and PL_D1 >= 0 and ROWS_OP[if PL_D1 >= 0 then PL_D1 else 0] = OP_RANGE
        | PL_RANGE_START1 := if PL_RANGE1 then ROWS_LEFT[PL_D1] else 0
        | PL_START1 := if not PL_RANGE1 then long(0) else if ROWS_OP[PL_RANGE_START1] = OP_NEG then -ROWS_VALUE[ROWS_LEFT[PL_RANGE_START1]] else ROWS_VALUE[PL_RANGE_START1]
        | PL_END1 := if PL_RANGE1 then ROWS_RIGHT[PL_D1] else 0
        | PL_END_SAFE1 := if PL_END1 >= 0 then PL_END1 else 0
        | PL_END_NEG1 := ROWS_OP[PL_END_SAFE1] = OP_NEG and ROWS_OP[ROWS_LEFT[PL_END_SAFE1]] = OP_CONST
        | PL_END_CONST1 := ROWS_OP[PL_END_SAFE1] = OP_CONST or PL_END_NEG1
        | PL_END_VALUE1 := if PL_END_NEG1 then -ROWS_VALUE[ROWS_LEFT[PL_END_SAFE1]] else ROWS_VALUE[PL_END_SAFE1]
        | PL_LAST1 := PL_END_VALUE1 - PL_START1 + long(1)
        | PL_SPAN1 := if PL_RANK <= 1 then long(1)
                       else if PL_RANGE1 and PL_END1 >= 0 and PL_END_CONST1 then
                         (if PL_LAST1 < long(0) then long(0) else if PL_LAST1 > long(LEVEL_SIZE[4 * PL_LL + 1]) then long(LEVEL_SIZE[4 * PL_LL + 1]) else PL_LAST1)
                       else long(LEVEL_SIZE[4 * PL_LL + 1])
        | PL_S2 := if PL_RANK > 2 then LEVEL_SIGNAL[4 * PL_LL + 2] else 0
        | PL_D2 := ROWS_LEFT[PL_S2]
        | PL_RANGE2 := PL_RANK > 2 and PL_D2 >= 0 and ROWS_OP[if PL_D2 >= 0 then PL_D2 else 0] = OP_RANGE
        | PL_RANGE_START2 := if PL_RANGE2 then ROWS_LEFT[PL_D2] else 0
        | PL_START2 := if not PL_RANGE2 then long(0) else if ROWS_OP[PL_RANGE_START2] = OP_NEG then -ROWS_VALUE[ROWS_LEFT[PL_RANGE_START2]] else ROWS_VALUE[PL_RANGE_START2]
        | PL_END2 := if PL_RANGE2 then ROWS_RIGHT[PL_D2] else 0
        | PL_END_SAFE2 := if PL_END2 >= 0 then PL_END2 else 0
        | PL_END_NEG2 := ROWS_OP[PL_END_SAFE2] = OP_NEG and ROWS_OP[ROWS_LEFT[PL_END_SAFE2]] = OP_CONST
        | PL_END_CONST2 := ROWS_OP[PL_END_SAFE2] = OP_CONST or PL_END_NEG2
        | PL_END_VALUE2 := if PL_END_NEG2 then -ROWS_VALUE[ROWS_LEFT[PL_END_SAFE2]] else ROWS_VALUE[PL_END_SAFE2]
        | PL_LAST2 := PL_END_VALUE2 - PL_START2 + long(1)
        | PL_SPAN2 := if PL_RANK <= 2 then long(1)
                       else if PL_RANGE2 and PL_END2 >= 0 and PL_END_CONST2 then
                         (if PL_LAST2 < long(0) then long(0) else if PL_LAST2 > long(LEVEL_SIZE[4 * PL_LL + 2]) then long(LEVEL_SIZE[4 * PL_LL + 2]) else PL_LAST2)
                       else long(LEVEL_SIZE[4 * PL_LL + 2])
        | PL_S3 := if PL_RANK > 3 then LEVEL_SIGNAL[4 * PL_LL + 3] else 0
        | PL_D3 := ROWS_LEFT[PL_S3]
        | PL_RANGE3 := PL_RANK > 3 and PL_D3 >= 0 and ROWS_OP[if PL_D3 >= 0 then PL_D3 else 0] = OP_RANGE
        | PL_RANGE_START3 := if PL_RANGE3 then ROWS_LEFT[PL_D3] else 0
        | PL_START3 := if not PL_RANGE3 then long(0) else if ROWS_OP[PL_RANGE_START3] = OP_NEG then -ROWS_VALUE[ROWS_LEFT[PL_RANGE_START3]] else ROWS_VALUE[PL_RANGE_START3]
        | PL_END3 := if PL_RANGE3 then ROWS_RIGHT[PL_D3] else 0
        | PL_END_SAFE3 := if PL_END3 >= 0 then PL_END3 else 0
        | PL_END_NEG3 := ROWS_OP[PL_END_SAFE3] = OP_NEG and ROWS_OP[ROWS_LEFT[PL_END_SAFE3]] = OP_CONST
        | PL_END_CONST3 := ROWS_OP[PL_END_SAFE3] = OP_CONST or PL_END_NEG3
        | PL_END_VALUE3 := if PL_END_NEG3 then -ROWS_VALUE[ROWS_LEFT[PL_END_SAFE3]] else ROWS_VALUE[PL_END_SAFE3]
        | PL_LAST3 := PL_END_VALUE3 - PL_START3 + long(1)
        | PL_SPAN3 := if PL_RANK <= 3 then long(1)
                       else if PL_RANGE3 and PL_END3 >= 0 and PL_END_CONST3 then
                         (if PL_LAST3 < long(0) then long(0) else if PL_LAST3 > long(LEVEL_SIZE[4 * PL_LL + 3]) then long(LEVEL_SIZE[4 * PL_LL + 3]) else PL_LAST3)
                       else long(LEVEL_SIZE[4 * PL_LL + 3])
        | PL_INNER := PL_SPAN1 * PL_SPAN2 * PL_SPAN3
        | PL_STRIDE := (if PL_LEVEL < 1 then PL_SPAN1 else long(1)) * (if PL_LEVEL < 2 then PL_SPAN2 else long(1)) * (if PL_LEVEL < 3 then PL_SPAN3 else long(1))
        | PL_LEVEL_SPAN := if PL_LEVEL = 0 then PL_SPAN0 else if PL_LEVEL = 1 then PL_SPAN1 else if PL_LEVEL = 2 then PL_SPAN2 else PL_SPAN3
        | PL_LEVEL_START := if PL_LEVEL = 0 then PL_START0 else if PL_LEVEL = 1 then PL_START1 else if PL_LEVEL = 2 then PL_START2 else PL_START3
        | PL_DERIVED := PL_RANK > 1
        | PL_DIVIDES := PL_DERIVED and PL_LEVEL < PL_RANK - 1
        | PL_INPUT_ROOT1 := NODE_ROOT1[CLOCK_REP[PL_ROW]]
        | PL_INPUT_ROOT := if PL_INPUT_ROOT1 > 0 then PL_INPUT_ROOT1 - 1 else 0
        | PL_ROOT_IRQ := ROOT_IRQ1[PL_CLOCK] - 1
        | PL_V0 := if PL_SOURCE0 = ES_ROW then long(PL_P)
                      else if PL_SOURCE0 = ES_LEFT then long(PL_LEFT)
                      else if PL_SOURCE0 = ES_RIGHT then long(PL_RIGHT)
                      else if PL_SOURCE0 = ES_RIGHT_LEFT then long(ROWS_LEFT[PL_RIGHT_ROW])
                      else if PL_SOURCE0 = ES_RIGHT_RIGHT then long(ROWS_RIGHT[PL_RIGHT_ROW])
                      else if PL_SOURCE0 = ES_PARAM then PL_PARAM
                      else if PL_SOURCE0 = ES_VALUE_ROW then ROWS_VALUE[PL_ROW]
                      else if PL_SOURCE0 = ES_ARG0 then long(ROWS_LEFT[PL_LEFT_ROW])
                      else if PL_SOURCE0 = ES_ARG1 then long(if PL_C1 >= 0 then ROWS_LEFT[PL_C1] else -1)
                      else if PL_SOURCE0 = ES_ARG2 then long(if PL_C2 >= 0 then ROWS_LEFT[PL_C2] else -1)
