                      else if PL_SOURCE1 = ES_SIGNED_CONDITION_THUMB then long(THUMB_SIGNED_SKIP[PL_OP])
                      else if PL_SOURCE1 = ES_UNSIGNED_CONDITION_THUMB then long(THUMB_UNSIGNED_SKIP[PL_OP])
